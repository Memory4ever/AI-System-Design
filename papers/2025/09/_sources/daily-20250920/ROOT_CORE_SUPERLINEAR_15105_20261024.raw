<td id="A3.T11.2.1.56.9" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.9.1" class="ltx_text" style="font-size:50%;">540,570</span></td>
<td id="A3.T11.2.1.56.10" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.10.1" class="ltx_text" style="font-size:50%;">1</span></td>
<td id="A3.T11.2.1.56.11" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.11.1" class="ltx_text" style="font-size:50%;">30</span></td>
<td id="A3.T11.2.1.56.12" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.12.1" class="ltx_text" style="font-size:50%;">5</span></td>
<td id="A3.T11.2.1.56.13" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.13.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.56.14" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.14.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.56.15" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.15.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.56.16" class="ltx_td ltx_align_right"><span id="A3.T11.2.1.56.16.1" class="ltx_text" style="font-size:50%;">-</span></td></tr>
<tr id="A3.T11.2.1.57" class="ltx_tr">
<td id="A3.T11.2.1.57.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T11.2.1.57.1.1" class="ltx_text" style="font-size:50%;">Electricity</span></td>
<td id="A3.T11.2.1.57.2" class="ltx_td ltx_align_left ltx_border_bb"><cite class="ltx_cite ltx_citemacro_citep"><span id="A3.T11.2.1.57.2.1" class="ltx_text" style="font-size:50%;">(</span><a href="#bib.bib3" title="" class="ltx_ref">Asuncion et al., 2007</a><span id="A3.T11.2.1.57.2.3" class="ltx_text" style="font-size:50%;">)</span></cite></td>
<td id="A3.T11.2.1.57.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T11.2.1.57.3.1" class="ltx_text" style="font-size:50%;">Energy</span></td>
<td id="A3.T11.2.1.57.4" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T11.2.1.57.4.1" class="ltx_text" style="font-size:50%;">weekly-FRI</span></td>
<td id="A3.T11.2.1.57.5" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.5.1" class="ltx_text" style="font-size:50%;">370</span></td>
<td id="A3.T11.2.1.57.6" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.6.1" class="ltx_text" style="font-size:50%;">208</span></td>
<td id="A3.T11.2.1.57.7" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.7.1" class="ltx_text" style="font-size:50%;">208</span></td>
<td id="A3.T11.2.1.57.8" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.8.1" class="ltx_text" style="font-size:50%;">208</span></td>
<td id="A3.T11.2.1.57.9" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.9.1" class="ltx_text" style="font-size:50%;">76,960</span></td>
<td id="A3.T11.2.1.57.10" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.10.1" class="ltx_text" style="font-size:50%;">1</span></td>
<td id="A3.T11.2.1.57.11" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.11.1" class="ltx_text" style="font-size:50%;">8</span></td>
<td id="A3.T11.2.1.57.12" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.12.1" class="ltx_text" style="font-size:50%;">3</span></td>
<td id="A3.T11.2.1.57.13" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.13.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.57.14" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.14.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.57.15" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.15.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="A3.T11.2.1.57.16" class="ltx_td ltx_align_right ltx_border_bb"><span id="A3.T11.2.1.57.16.1" class="ltx_text" style="font-size:50%;">-</span></td></tr>
