<td id="A6.T12.2.1.15.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m17" class="ltx_Math" alttext="96" display="inline" intent=":literal"><semantics><mn>96</mn><annotation encoding="application/x-tex">96</annotation></semantics></math></td></tr>
