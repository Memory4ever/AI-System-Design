<td id="A6.T12.2.1.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Batch Size</td>
<td id="A6.T12.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Number of training examples used in one iteration</td>
<td id="A6.T12.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m2" class="ltx_Math" alttext="512" display="inline" intent=":literal"><semantics><mn>512</mn><annotation encoding="application/x-tex">512</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.4" class="ltx_tr">
<td id="A6.T12.2.1.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Channel Organization</td>
<td id="A6.T12.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Processing input data as either univariate (channel independent) or multivariate during training</td>
<td id="A6.T12.2.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Channel Independent</td></tr>
