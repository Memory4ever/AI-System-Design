</span></span><span id="S4.T1.2.1.6.3" class="ltx_text"></span></td>
<td id="S4.T1.2.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.1.7.1" class="ltx_text"></span> <span id="S4.T1.2.1.7.2" class="ltx_text">
<span id="S4.T1.2.1.7.2.1" class="ltx_tabular ltx_align_middle">
