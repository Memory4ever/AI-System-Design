<td id="A2.T6.2.1.4" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T6.2.1.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Provider</span></td></tr>
