<tr id="S5.T2.2.5" class="ltx_tr">
<td id="S5.T2.2.5.1" class="ltx_td ltx_align_left" style="padding:0.5pt 2.2pt;">Hallucination</td>
<td id="S5.T2.2.5.2" class="ltx_td ltx_align_center" style="padding:0.5pt 2.2pt;"><math id="S5.T2.m7" class="ltx_Math" alttext="3_{\textit{1.22}}" display="inline" intent=":literal"><semantics><msub><mn>3</mn><mtext class="ltx_mathvariant_italic">1.22</mtext></msub><annotation encoding="application/x-tex">3_{\textit{1.22}}</annotation></semantics></math></td>
