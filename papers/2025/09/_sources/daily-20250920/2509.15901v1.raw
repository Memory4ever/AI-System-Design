<td id="S5.T3.2.19.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:0.5pt 1.5pt;"><math id="S5.T3.m113" class="ltx_Math" alttext="3_{\textit{1.67}}" display="inline" intent=":literal"><semantics><msub><mn>3</mn><mtext class="ltx_mathvariant_italic">1.67</mtext></msub><annotation encoding="application/x-tex">3_{\textit{1.67}}</annotation></semantics></math></td>
<td id="S5.T3.2.19.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="--ltx-bg-color:#D4F4E9;padding:0.5pt 1.5pt;"><math id="S5.T3.m114" class="ltx_Math" style="--ltx-bg-color:#D4F4E9;" alttext="1_{\textit{1.42}}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-bg-color:#D4F4E9;" mathbackground="#D4F4E9">1</mn><mtext style="--ltx-bg-color:#D4F4E9;" class="ltx_mathvariant_italic" mathbackground="#D4F4E9">1.42</mtext></msub><annotation encoding="application/x-tex">1_{\textit{1.42}}</annotation></semantics></math></td>
