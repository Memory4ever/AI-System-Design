<td id="S5.T3.2.18.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#D4F4E9;padding:0.5pt 1.5pt;"><math id="S5.T3.m112" class="ltx_Math" style="--ltx-bg-color:#D4F4E9;" alttext="2_{\textit{0.43}}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-bg-color:#D4F4E9;" mathbackground="#D4F4E9">2</mn><mtext style="--ltx-bg-color:#D4F4E9;" class="ltx_mathvariant_italic" mathbackground="#D4F4E9">0.43</mtext></msub><annotation encoding="application/x-tex">2_{\textit{0.43}}</annotation></semantics></math></td></tr>
