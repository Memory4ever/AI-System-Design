<span id="S4.T1.2.1.7.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.1.7.2.1.1.1.1" class="ltx_text ltx_font_bold">Personal</span></span></span>
<span id="S4.T1.2.1.7.2.1.2" class="ltx_tr">
<span id="S4.T1.2.1.7.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.1.7.2.1.2.1.1" class="ltx_text ltx_font_bold">Preferences</span></span></span>
</span></span><span id="S4.T1.2.1.7.3" class="ltx_text"></span></td>
<td id="S4.T1.2.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.1.8.1" class="ltx_text"></span> <span id="S4.T1.2.1.8.2" class="ltx_text">
<span id="S4.T1.2.1.8.2.1" class="ltx_tabular ltx_align_middle">
