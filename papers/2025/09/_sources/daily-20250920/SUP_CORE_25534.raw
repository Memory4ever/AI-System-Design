</span></span>
<span id="A1.SS5.SSSx38.p27.1.3.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_t"><span id="A1.SS5.SSSx38.p27.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">-3</span></span>
<span id="A1.SS5.SSSx38.p27.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.SS5.SSSx38.p27.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Context Awareness</span></span>
<span id="A1.SS5.SSSx38.p27.1.3.4" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.SS5.SSSx38.p27.1.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">True</span></span>
