<span id="S3.T7.4.1.1.3.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Reranker</span></span>
</span></span></td></tr>
<tr id="S3.T7.4.1.2" class="ltx_tr">
<td id="S3.T7.4.1.2.1" class="ltx_td ltx_align_center">Sparse</td>
