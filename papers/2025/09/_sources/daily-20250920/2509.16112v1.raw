<div id="S3.T7.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:226.2pt;height:31.6pt;vertical-align:-13.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-20.0pt,2.8pt) scale(0.8,0.8) ;">
<table id="S3.T7.4.1" class="ltx_tabular ltx_align_middle">
