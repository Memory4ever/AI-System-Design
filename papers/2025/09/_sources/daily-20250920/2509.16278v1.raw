<th id="A4.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r"><math id="A4.T6.m1" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> (Num. categories)</th>
