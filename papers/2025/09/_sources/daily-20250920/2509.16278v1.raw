<td id="A4.T6.2.4.2" class="ltx_td ltx_align_center ltx_border_r">Uniform <math id="A4.T6.m9" class="ltx_Math" alttext="12\text{--}19" display="inline" intent=":literal"><semantics><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>19</mn></mrow><annotation encoding="application/x-tex">12\text{--}19</annotation></semantics></math></td>
<td id="A4.T6.2.4.3" class="ltx_td ltx_align_center ltx_border_r">Mixture <math id="A4.T6.m10" class="ltx_Math" alttext="\{3\text{--}8,9\text{--}16,17\text{--}25\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>8</mn></mrow><mo>,</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>16</mn></mrow><mo>,</mo><mrow><mn>17</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>25</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{3\text{--}8,9\text{--}16,17\text{--}25\}</annotation></semantics></math></td>
