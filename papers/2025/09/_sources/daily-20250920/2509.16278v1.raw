<td id="A4.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_r">Uniform <math id="A4.T6.m6" class="ltx_Math" alttext="8\text{--}12" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">8\text{--}12</annotation></semantics></math></td>
<td id="A4.T6.2.3.3" class="ltx_td ltx_align_center ltx_border_r">Uniform <math id="A4.T6.m7" class="ltx_Math" alttext="3\text{--}16" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">3\text{--}16</annotation></semantics></math> (bimodal)</td>
<td id="A4.T6.2.3.4" class="ltx_td ltx_align_center">Mid-range (<math id="A4.T6.m8" class="ltx_Math" alttext="\approx 200\text{--}300" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mn>200</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>300</mn></mrow></mrow><annotation encoding="application/x-tex">\approx 200\text{--}300</annotation></semantics></math> tokens)</td></tr>
<tr id="A4.T6.2.4" class="ltx_tr">
