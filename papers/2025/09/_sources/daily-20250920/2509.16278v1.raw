<th id="A6.T7.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.3.1" class="ltx_text ltx_font_bold">256</span></th>
<th id="A6.T7.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.4.1" class="ltx_text ltx_font_bold">512</span></th>
<th id="A6.T7.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.5.1" class="ltx_text ltx_font_bold">1024</span></th>
<th id="A6.T7.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.6.1" class="ltx_text ltx_font_bold">2048</span></th>
<td id="A6.T7.2.1.7" class="ltx_td ltx_border_tt"></td></tr>
<tr id="A6.T7.2.2" class="ltx_tr">
