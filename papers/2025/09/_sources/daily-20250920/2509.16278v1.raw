<th id="S4.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.2.1.3.1" class="ltx_text ltx_font_bold">No Pos</span></th>
<th id="S4.T2.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S4.T2.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S4.T2.2.1.4.1" class="ltx_text ltx_font_bold">(pp)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.2.2" class="ltx_tr">
<td id="S4.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Meta + APE (medium, 128)</td>
<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t">77.8%</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t">88.9%</td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">+11.1</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<td id="S4.T2.2.3.1" class="ltx_td ltx_align_left">Meta + APE (hard, 128)</td>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center">11.1%</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center">22.2%</td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center">+11.1</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<td id="S4.T2.2.4.1" class="ltx_td ltx_align_left">Meta + APE (extra-hard, 512)</td>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center">11.1%</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center">50.0%</td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center">+38.9</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<td id="S4.T2.2.5.1" class="ltx_td ltx_align_left">Meta + RoPE (medium, 128)</td>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_center">44.4%</td>
<td id="S4.T2.2.5.3" class="ltx_td ltx_align_center">55.6%</td>
<td id="S4.T2.2.5.4" class="ltx_td ltx_align_center">+11.1</td></tr>
