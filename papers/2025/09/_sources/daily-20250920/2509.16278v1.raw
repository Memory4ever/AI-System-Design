<td id="A6.T7.2.2.7" class="ltx_td ltx_border_t"></td></tr>
<tr id="A6.T7.2.3" class="ltx_tr">
<th id="A6.T7.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-2 APE (256)</th>
<td id="A6.T7.2.3.2" class="ltx_td ltx_align_center">6.8</td>
