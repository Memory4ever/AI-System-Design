<td id="S4.T1.4.8.4" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.4.1" class="ltx_text" style="font-size:80%;">14.3</span></td>
<td id="S4.T1.4.8.5" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.5.1" class="ltx_text" style="font-size:80%;">11.1</span></td>
<td id="S4.T1.4.8.6" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.6.1" class="ltx_text" style="font-size:80%;">20.6</span></td>
<td id="S4.T1.4.8.7" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.7.1" class="ltx_text" style="font-size:80%;">12.7</span></td>
<td id="S4.T1.4.8.8" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.8.1" class="ltx_text" style="font-size:80%;">12.7</span></td>
<td id="S4.T1.4.8.9" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.9.1" class="ltx_text" style="font-size:80%;">14.0</span></td>
<td id="S4.T1.4.8.10" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.10.1" class="ltx_text" style="font-size:80%;">16.0</span></td>
<td id="S4.T1.4.8.11" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.11.1" class="ltx_text" style="font-size:80%;">14.0</span></td>
<td id="S4.T1.4.8.12" class="ltx_td ltx_align_center" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.8.12.1" class="ltx_text" style="font-size:80%;">12.0</span></td></tr>
<tr id="S4.T1.4.9" class="ltx_tr">
<th id="S4.T1.4.9.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.1.1" class="ltx_text" style="font-size:80%;">8k / 8k</span></th>
<td id="S4.T1.4.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.2.1" class="ltx_text" style="font-size:80%;">27.0</span></td>
<td id="S4.T1.4.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.3.1" class="ltx_text" style="font-size:80%;">33.3</span></td>
<td id="S4.T1.4.9.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.4.1" class="ltx_text" style="font-size:80%;">15.9</span></td>
<td id="S4.T1.4.9.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.5.1" class="ltx_text" style="font-size:80%;">19.1</span></td>
<td id="S4.T1.4.9.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.6.1" class="ltx_text" style="font-size:80%;">27.0</span></td>
<td id="S4.T1.4.9.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.7.1" class="ltx_text" style="font-size:80%;">19.1</span></td>
<td id="S4.T1.4.9.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.8.1" class="ltx_text" style="font-size:80%;">23.8</span></td>
<td id="S4.T1.4.9.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.9.1" class="ltx_text" style="font-size:80%;">22.0</span></td>
<td id="S4.T1.4.9.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.10.1" class="ltx_text" style="font-size:80%;">18.0</span></td>
<td id="S4.T1.4.9.11" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.11.1" class="ltx_text" style="font-size:80%;">18.0</span></td>
<td id="S4.T1.4.9.12" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.9.12.1" class="ltx_text" style="font-size:80%;">18.0</span></td></tr>
