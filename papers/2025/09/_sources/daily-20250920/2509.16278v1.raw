<th id="A6.T17.2.30.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   extra-hard</th>
<td id="A6.T17.2.30.2" class="ltx_td ltx_align_center">44.4%</td>
<td id="A6.T17.2.30.3" class="ltx_td ltx_align_center">55.6%</td>
<td id="A6.T17.2.30.4" class="ltx_td ltx_align_center">+11.1</td></tr>
<tr id="A6.T17.2.31" class="ltx_tr">
<th id="A6.T17.2.31.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">   long</th>
<td id="A6.T17.2.31.2" class="ltx_td ltx_align_center ltx_border_bb">0.0%</td>
<td id="A6.T17.2.31.3" class="ltx_td ltx_align_center ltx_border_bb">0.0%</td>
<td id="A6.T17.2.31.4" class="ltx_td ltx_align_center ltx_border_bb">0.0</td></tr>
</tbody>
</table>
</figure>
