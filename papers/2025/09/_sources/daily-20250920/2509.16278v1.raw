<td id="A4.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Uniform <math id="A4.T6.m4" class="ltx_Math" alttext="3\text{--}10" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">3\text{--}10</annotation></semantics></math></td>
<td id="A4.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">Short (<math id="A4.T6.m5" class="ltx_Math" alttext="\approx 100\text{--}200" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mtext>–</mtext><mo lspace="0em" rspace="0em">​</mo><mn>200</mn></mrow></mrow><annotation encoding="application/x-tex">\approx 100\text{--}200</annotation></semantics></math> tokens)</td></tr>
