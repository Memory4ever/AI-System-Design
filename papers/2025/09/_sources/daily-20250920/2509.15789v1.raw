<td id="S2.T2.2.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">772,312,812</td></tr>
