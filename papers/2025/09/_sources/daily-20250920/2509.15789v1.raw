<td id="S2.T4.2.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S2.T4.2.1.2.1" class="ltx_text ltx_font_bold">Paragraphs</span></td>
<td id="S2.T4.2.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S2.T4.2.1.3.1" class="ltx_text ltx_font_bold">English Tokens</span></td></tr>
