<td id="S2.T2.2.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_l ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">de</td>
<td id="S2.T2.2.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">8,035</td>
<td id="S2.T2.2.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">18,826,292</td></tr>
