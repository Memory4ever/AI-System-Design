<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Slang generation psudocode</h2>

<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Uncontrolled generation</h3>

<figure id="algorithm1" class="ltx_float ltx_algorithm">
<div id="algorithm1.3" class="ltx_listing ltx_lst_numbers_left ltx_listing">
<div id="algorithm1.3.1" class="ltx_listingline"><span id="algorithm1.3.1.1" class="ltx_text"><span id="algorithm1.3.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>
</div>
<div id="algorithm1.3.2" class="ltx_listingline">Target number of slang entries <math id="algorithm1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>;
</div>
<div id="algorithm1.3.3" class="ltx_listingline">Existing slang entry set <math id="algorithm1.m2" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>, where each entry is a unique tuple <math id="algorithm1.m3" class="ltx_Math" alttext="(w,\text{senses})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext>senses</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(w,\text{senses})</annotation></semantics></math>;
</div>
<div id="algorithm1.3.4" class="ltx_listingline">Generation mode <math id="algorithm1.m4" class="ltx_Math" alttext="m\in\{\texttt{Freeform},\texttt{reuse},\texttt{coinage}\}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_mathvariant_monospace">Freeform</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">reuse</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">coinage</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">m\in\{\texttt{Freeform},\texttt{reuse},\texttt{coinage}\}</annotation></semantics></math>;

</div>
<div id="algorithm1.3.5" class="ltx_listingline"><span id="algorithm1.3.5.1" class="ltx_text"><span id="algorithm1.3.5.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>
</div>
<div id="algorithm1.3.6" class="ltx_listingline">An expanded slang set <math id="algorithm1.m5" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> with <math id="algorithm1.m6" class="ltx_Math" alttext="|\mathcal{E}|=N" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">|\mathcal{E}|=N</annotation></semantics></math> unique entries
</div>
<div id="algorithm1.3.7" class="ltx_listingline"><span id="algorithm1.3.7.1" class="ltx_text ltx_font_bold">while</span> <em id="algorithm1.3.7.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m7" class="ltx_Math" alttext="|\mathcal{E}|&lt;N" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">|\mathcal{E}|&lt;N</annotation></semantics></math></em> <span id="algorithm1.3.7.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.3.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Construct a prompt based on mode <math id="algorithm1.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and query the language model to generate candidate entries <math id="algorithm1.m9" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>;
</div>
<div id="algorithm1.3.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.3.9.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.3.9.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m10" class="ltx_Math" alttext="(w,\text{sense},\text{cxt})\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">sense</mtext><mo>,</mo><mtext class="ltx_mathvariant_italic">cxt</mtext><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">(w,\text{sense},\text{cxt})\in\mathcal{C}</annotation></semantics></math></em> <span id="algorithm1.3.9.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.3.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Classify <math id="algorithm1.m11" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as either <span id="algorithm1.3.10.1" class="ltx_text ltx_font_typewriter">coinage</span> or <span id="algorithm1.3.10.2" class="ltx_text ltx_font_typewriter">reuse</span> using Wiktionary;
</div>
<div id="algorithm1.3.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.3.11.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.3.11.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m12" class="ltx_Math" alttext="m\neq\texttt{Freeform}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≠</mo><mtext class="ltx_mathvariant_monospace">Freeform</mtext></mrow><annotation encoding="application/x-tex">m\neq\texttt{Freeform}</annotation></semantics></math> <span id="algorithm1.3.11.2.1" class="ltx_text ltx_font_bold">and</span> the classification does not match <math id="algorithm1.m13" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math></em> <span id="algorithm1.3.11.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.3.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.3.12.1" class="ltx_text ltx_font_bold">continue</span>

</div>
<div id="algorithm1.3.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm1.3.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.3.14.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.3.14.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m14" class="ltx_Math" alttext="(w,\text{sense})\notin\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">sense</mtext><mo stretchy="false">)</mo></mrow><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">(w,\text{sense})\notin\mathcal{E}</annotation></semantics></math></em> <span id="algorithm1.3.14.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.3.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Add <math id="algorithm1.m15" class="ltx_Math" alttext="(w,\text{sense},\text{cxt})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext>sense</mtext><mo>,</mo><mtext>cxt</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(w,\text{sense},\text{cxt})</annotation></semantics></math> to <math id="algorithm1.m16" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>;
</div>
<div id="algorithm1.3.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm1.3.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm1.3.18" class="ltx_listingline">end while
</div>
<div id="algorithm1.3.19" class="ltx_listingline"><span id="algorithm1.3.19.1" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.3.19.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m17" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math></em>

</div>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.4" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Algorithm for uncontrolled slang generation</figcaption>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Controlled generation</h3>

<figure id="algorithm2" class="ltx_float ltx_algorithm">
<div id="algorithm2.3" class="ltx_listing ltx_lst_numbers_left ltx_listing">
<div id="algorithm2.3.1" class="ltx_listingline"><span id="algorithm2.3.1.1" class="ltx_text"><span id="algorithm2.3.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>
</div>
<div id="algorithm2.3.2" class="ltx_listingline">Existing slang dictionary <math id="algorithm2.m1" class="ltx_Math" alttext="D=\{(w,\text{sense},\text{cxt})\}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext>sense</mtext><mo>,</mo><mtext>cxt</mtext><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D=\{(w,\text{sense},\text{cxt})\}</annotation></semantics></math> grouped by word sense;
</div>
<div id="algorithm2.3.3" class="ltx_listingline">Generation mode <math id="algorithm2.m2" class="ltx_Math" alttext="m\in\{\texttt{Freeform},\texttt{reuse},\texttt{coinage}\}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_mathvariant_monospace">Freeform</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">reuse</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">coinage</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">m\in\{\texttt{Freeform},\texttt{reuse},\texttt{coinage}\}</annotation></semantics></math>;
</div>
<div id="algorithm2.3.4" class="ltx_listingline">Initial slang set <math id="algorithm2.m3" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> containing previously generated entries.

</div>
<div id="algorithm2.3.5" class="ltx_listingline"><span id="algorithm2.3.5.1" class="ltx_text"><span id="algorithm2.3.5.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>
A language model-generated dictionary <math id="algorithm2.m4" class="ltx_Math" alttext="D^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mo>′</mo></msup><annotation encoding="application/x-tex">D^{\prime}</annotation></semantics></math> with <math id="algorithm2.m5" class="ltx_Math" alttext="|D^{\prime}|=|D|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msup><mi>D</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|D^{\prime}|=|D|</annotation></semantics></math>

</div>
<div id="algorithm2.3.6" class="ltx_listingline">Initialize <math id="algorithm2.m6" class="ltx_Math" alttext="D^{\prime}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">D^{\prime}\leftarrow\emptyset</annotation></semantics></math>;
</div>
<div id="algorithm2.3.7" class="ltx_listingline"><span id="algorithm2.3.7.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.3.7.2" class="ltx_emph ltx_font_italic">group <math id="algorithm2.m7" class="ltx_Math" alttext="d\subseteq D" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⊆</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">d\subseteq D</annotation></semantics></math> corresponding to a unique word sense</em> <span id="algorithm2.3.7.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.3.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Initialize local slang set <math id="algorithm2.m8" class="ltx_Math" alttext="\mathcal{E}_{\text{group}}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext>group</mtext></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\text{group}}\leftarrow\emptyset</annotation></semantics></math>;
</div>
<div id="algorithm2.3.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.3.9.1" class="ltx_text ltx_font_bold">while</span> <em id="algorithm2.3.9.2" class="ltx_emph ltx_font_italic"><math id="algorithm2.m9" class="ltx_Math" alttext="|\mathcal{E}_{\text{group}}|&lt;|d|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext class="ltx_mathvariant_italic">group</mtext></msub><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mi>d</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|\mathcal{E}_{\text{group}}|&lt;|d|</annotation></semantics></math></em> <span id="algorithm2.3.9.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.3.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Construct a prompt using word sense metadata of <math id="algorithm2.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and generation mode <math id="algorithm2.m11" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>;
</div>
<div id="algorithm2.3.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Query the language model to generate candidate entries <math id="algorithm2.m12" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>;
</div>
<div id="algorithm2.3.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.3.12.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm2.3.12.2" class="ltx_emph ltx_font_italic"><math id="algorithm2.m13" class="ltx_Math" alttext="(w,\text{sense},\text{cxt})\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">sense</mtext><mo>,</mo><mtext class="ltx_mathvariant_italic">cxt</mtext><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">(w,\text{sense},\text{cxt})\in\mathcal{C}</annotation></semantics></math></em> <span id="algorithm2.3.12.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.3.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Classify <math id="algorithm2.m14" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as either <span id="algorithm2.3.13.1" class="ltx_text ltx_font_typewriter">coinage</span> or <span id="algorithm2.3.13.2" class="ltx_text ltx_font_typewriter">reuse</span> using Wiktionary;
</div>
<div id="algorithm2.3.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.3.14.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.3.14.2" class="ltx_emph ltx_font_italic"><math id="algorithm2.m15" class="ltx_Math" alttext="m\neq\texttt{Freeform}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≠</mo><mtext class="ltx_mathvariant_monospace">Freeform</mtext></mrow><annotation encoding="application/x-tex">m\neq\texttt{Freeform}</annotation></semantics></math> <span id="algorithm2.3.14.2.1" class="ltx_text ltx_font_bold">and</span> classification <math id="algorithm2.m16" class="ltx_Math" alttext="\neq m" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≠</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\neq m</annotation></semantics></math></em> <span id="algorithm2.3.14.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm2.3.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.3.15.1" class="ltx_text ltx_font_bold">continue</span> ;  <span id="algorithm2.3.15.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm2.3.15.3" class="ltx_text ltx_font_typewriter">Reject mismatched mode</span>
</div>
<div id="algorithm2.3.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm2.3.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.3.17.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.3.17.2" class="ltx_emph ltx_font_italic"><math id="algorithm2.m17" class="ltx_Math" alttext="(w,\text{sense})\notin\mathcal{E}_{\text{group}}\cup d" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">sense</mtext><mo stretchy="false">)</mo></mrow><mo>∉</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext class="ltx_mathvariant_italic">group</mtext></msub><mo>∪</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">(w,\text{sense})\notin\mathcal{E}_{\text{group}}\cup d</annotation></semantics></math></em> <span id="algorithm2.3.17.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm2.3.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Add <math id="algorithm2.m18" class="ltx_Math" alttext="(w,\text{sense},\text{cxt})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mtext>sense</mtext><mo>,</mo><mtext>cxt</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(w,\text{sense},\text{cxt})</annotation></semantics></math> to <math id="algorithm2.m19" class="ltx_Math" alttext="\mathcal{E}_{\text{group}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext>group</mtext></msub><annotation encoding="application/x-tex">\mathcal{E}_{\text{group}}</annotation></semantics></math>;
</div>
<div id="algorithm2.3.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm2.3.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm2.3.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end while
</div>
<div id="algorithm2.3.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Append <math id="algorithm2.m20" class="ltx_Math" alttext="\mathcal{E}_{\text{group}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext>group</mtext></msub><annotation encoding="application/x-tex">\mathcal{E}_{\text{group}}</annotation></semantics></math> to <math id="algorithm2.m21" class="ltx_Math" alttext="D^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mo>′</mo></msup><annotation encoding="application/x-tex">D^{\prime}</annotation></semantics></math>;
</div>
<div id="algorithm2.3.23" class="ltx_listingline">end foreach
</div>
<div id="algorithm2.3.24" class="ltx_listingline"><span id="algorithm2.3.24.1" class="ltx_text ltx_font_bold">return</span> <em id="algorithm2.3.24.2" class="ltx_emph ltx_font_italic"><math id="algorithm2.m22" class="ltx_Math" alttext="D^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mo>′</mo></msup><annotation encoding="application/x-tex">D^{\prime}</annotation></semantics></math></em>

</div>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Algorithm for controlled slang generation</figcaption>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Coinage category classification psudocode</h2>

<figure id="algorithm3" class="ltx_float ltx_algorithm">
<div id="algorithm3.3" class="ltx_listing ltx_lst_numbers_left ltx_listing">
<div id="algorithm3.3.1" class="ltx_listingline"><span id="algorithm3.3.1.1" class="ltx_text"><span id="algorithm3.3.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>
</div>
<div id="algorithm3.3.2" class="ltx_listingline">A dataset of slang words <math id="algorithm3.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, where each word <math id="algorithm3.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is a candidate coinage;
</div>
<div id="algorithm3.3.3" class="ltx_listingline">Wiktionary index <math id="algorithm3.m3" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math> mapping known words to definitions;
</div>
<div id="algorithm3.3.4" class="ltx_listingline">A trained Morfessor segmentation model <math id="algorithm3.m4" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>;

</div>
<div id="algorithm3.3.5" class="ltx_listingline"><span id="algorithm3.3.5.1" class="ltx_text"><span id="algorithm3.3.5.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>
</div>
<div id="algorithm3.3.6" class="ltx_listingline">A labeled dataframe <math id="algorithm3.m5" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> where each word is assigned a category label in <span id="algorithm3.3.6.1" class="ltx_text ltx_font_typewriter">{Compound, Blend, Other}</span>
</div>
<div id="algorithm3.3.7" class="ltx_listingline">Initialize empty record list <math id="algorithm3.m6" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>;
</div>
<div id="algorithm3.3.8" class="ltx_listingline"><span id="algorithm3.3.8.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm3.3.8.2" class="ltx_emph ltx_font_italic">source group <math id="algorithm3.m7" class="ltx_Math" alttext="(s,W_{s})\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>W</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">(s,W_{s})\in\mathcal{D}</annotation></semantics></math></em> <span id="algorithm3.3.8.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm3.3.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.9.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm3.3.9.2" class="ltx_emph ltx_font_italic">word <math id="algorithm3.m8" class="ltx_Math" alttext="w\in W_{s}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msub><mi>W</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">w\in W_{s}</annotation></semantics></math></em> <span id="algorithm3.3.9.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm3.3.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Segment <math id="algorithm3.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> into subword units <math id="algorithm3.m10" class="ltx_Math" alttext="S=\mathcal{M}.\texttt{segment}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_mathvariant_monospace">segment</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S=\mathcal{M}.\texttt{segment}(w)</annotation></semantics></math>;
</div>
<div id="algorithm3.3.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.11.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm3.3.11.2" class="ltx_emph ltx_font_italic"><math id="algorithm3.m11" class="ltx_Math" alttext="|S|\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|S|\geq 2</annotation></semantics></math> </em> <span id="algorithm3.3.11.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm3.3.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.12.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm3.3.12.2" class="ltx_emph ltx_font_italic">all <math id="algorithm3.m12" class="ltx_Math" alttext="s_{i}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s_{i}\in S</annotation></semantics></math> are exact matches in <math id="algorithm3.m13" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math></em> <span id="algorithm3.3.12.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm3.3.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Label <math id="algorithm3.m14" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as <span id="algorithm3.3.13.1" class="ltx_text ltx_font_typewriter">Compound</span>

</div>
<div id="algorithm3.3.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.14.1" class="ltx_text ltx_font_bold">else if</span> <em id="algorithm3.3.14.2" class="ltx_emph ltx_font_italic"><math id="algorithm3.m15" class="ltx_Math" alttext="s_{1}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s_{1}\in S</annotation></semantics></math> is a preffix of some <math id="algorithm3.m16" class="ltx_Math" alttext="w^{\prime}\in\mathcal{W}" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">w^{\prime}\in\mathcal{W}</annotation></semantics></math> and <math id="algorithm3.m17" class="ltx_Math" alttext="s_{-1}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s_{-1}\in S</annotation></semantics></math> is a suffix of some <math id="algorithm3.m18" class="ltx_Math" alttext="w^{\prime}\in\mathcal{W}" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">w^{\prime}\in\mathcal{W}</annotation></semantics></math> </em> <span id="algorithm3.3.14.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm3.3.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Label <math id="algorithm3.m19" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as <span id="algorithm3.3.15.1" class="ltx_text ltx_font_typewriter">Blend</span>

</div>
<div id="algorithm3.3.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm3.3.16.1" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algorithm3.3.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Label <math id="algorithm3.m20" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as <span id="algorithm3.3.17.1" class="ltx_text ltx_font_typewriter">Other</span>

</div>
<div id="algorithm3.3.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm3.3.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Append <math id="algorithm3.m21" class="ltx_Math" alttext="(s,w,|S|,\text{label})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>w</mi><mo>,</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>,</mo><mtext>label</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,w,|S|,\text{label})</annotation></semantics></math> to <math id="algorithm3.m22" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>

</div>
<div id="algorithm3.3.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm3.3.21" class="ltx_listingline">end foreach
</div>
<div id="algorithm3.3.22" class="ltx_listingline"><span id="algorithm3.3.22.1" class="ltx_text ltx_font_bold">return</span> <em id="algorithm3.3.22.2" class="ltx_emph ltx_font_italic"><math id="algorithm3.m23" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math></em>

</div>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span>Algorithm for classifying coinage types using Morfessor and Wiktionary</figcaption>
</figure>
