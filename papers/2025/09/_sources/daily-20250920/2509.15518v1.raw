<figure id="A10.T12" class="ltx_table">
<table id="A10.T12.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A10.T12.2.1" class="ltx_tr">
<td id="A10.T12.2.1.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A10.T12.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="A10.T12.2.1.1.1.1" class="ltx_p"><span id="A10.T12.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Complexity</span></span>
