<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex128.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}\lambda^{2}\sigma_{00}^{2}}{2q_{00}}+\frac{\lambda^{2}\sigma_{01}^{2}}{2q_{01}}+\frac{\gamma^{2}\lambda^{2}\sigma_{10}^{2}}{2q_{10}}+\frac{\lambda^{2}\sigma_{11}^{2}}{2q_{11}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>10</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>11</mn></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}\lambda^{2}\sigma_{00}^{2}}{2q_{00}}+\frac{\lambda^{2}\sigma_{01}^{2}}{2q_{01}}+\frac{\gamma^{2}\lambda^{2}\sigma_{10}^{2}}{2q_{10}}+\frac{\lambda^{2}\sigma_{11}^{2}}{2q_{11}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex129.m1" class="ltx_Math" alttext="\displaystyle=\frac{\lambda^{2}}{2}\left(\frac{\sigma_{01}^{2}}{q_{01}}+\frac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\lambda^{2}}{2}\left(\frac{\sigma_{01}^{2}}{q_{01}}+\frac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex130.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\right)^{2}\left(\frac{\sigma_{01}^{2}}{q_{01}}+\frac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\right)^{2}\left(\frac{\sigma_{01}^{2}}{q_{01}}+\frac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
