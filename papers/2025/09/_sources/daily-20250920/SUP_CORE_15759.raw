<p id="A2.p8.13" class="ltx_p"><span id="A2.p8.13.1" class="ltx_text">The second part evaluates to</span></p>
<table id="A2.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex132.m1" class="ltx_Math" alttext="\displaystyle\sum_{(i,a)}q_{ia}\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{(i,a)}q_{ia}\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex132.m2" class="ltx_Math" alttext="\displaystyle=\sum_{(i,a)}\frac{q_{ia}}{2}\left(\frac{\sigma^{*}_{ia}(\gamma)^{2}}{\sigma_{ia}^{2}}-1\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}\frac{q_{ia}}{2}\left(\frac{\sigma^{*}_{ia}(\gamma)^{2}}{\sigma_{ia}^{2}}-1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
