<tbody id="A2.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex56.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{2}~\mathrm{E}\left[(\tilde{X}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{X}-\mu_{ia})\;\big|\;Y=i,A=a\right]-\frac{d}{2}-\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>E</mi><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}~\mathrm{E}\left[(\tilde{X}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{X}-\mu_{ia})\;\big|\;Y=i,A=a\right]-\frac{d}{2}-\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell">        <span id="A2.Ex57.3.1" class="ltx_text ltx_markedasmath">using <math id="A2.Ex57.m1.m1" class="ltx_math_unparsed" alttext="\mathrm{E}\left[(\tilde{X}-\tilde{\mu}_{ia})^{T}\tilde{\Sigma}_{ia}^{-1}(\tilde{X}-\tilde{\mu}_{ia})\;\big|\;Y=i,A=a\right]=\tilde{\Sigma}_{ia}^{-1}\bullet\tilde{\Sigma}_{ia}=\mathrm{tr}\left(I_{d\times d}\right)=d" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow><mo>=</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>=</mo><mi>tr</mi><mrow><mo>(</mo><msub><mi>I</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msub><mo>)</mo></mrow><mo>=</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\mathrm{E}\left[(\tilde{X}-\tilde{\mu}_{ia})^{T}\tilde{\Sigma}_{ia}^{-1}(\tilde{X}-\tilde{\mu}_{ia})\;\big|\;Y=i,A=a\right]=\tilde{\Sigma}_{ia}^{-1}\bullet\tilde{\Sigma}_{ia}=\mathrm{tr}\left(I_{d\times d}\right)=d</annotation></semantics></math></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex58.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{2}~\mathrm{E}\left[(\tilde{X}-\tilde{\mu}_{ia}+\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{X}-\tilde{\mu}_{ia}+\tilde{\mu}_{ia}-\mu_{ia})\;\big|\;Y=i,A=a\right]-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>E</mi><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}~\mathrm{E}\left[(\tilde{X}-\tilde{\mu}_{ia}+\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{X}-\tilde{\mu}_{ia}+\tilde{\mu}_{ia}-\mu_{ia})\;\big|\;Y=i,A=a\right]-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\frac{1}{2}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>tr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\frac{1}{2}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.3" class="ltx_p"><span id="A2.p2.3.1" class="ltx_text">The Kullback-Leibler divergence between <math id="A2.p2.m7" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> and <math id="A2.p2.m8" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> can now be written as</span></p>
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow><mspace style="width:24em;" width="24em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{1}{2}\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\frac{1}{2}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>tr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{1}{2}\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\frac{1}{2}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})-\frac{d}{2}+\frac{1}{2}\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})\right)\qquad" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mspace style="width:2em;" width="2em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\log\det(\Sigma_{ia}^{1/2}\tilde{\Sigma}_{ia}^{-1}\Sigma_{ia}^{1/2})\right)\qquad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\log\det(\Sigma_{ia}\tilde{\Sigma}_{ia}^{-1})\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow><mo>+</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)+\log\det(\Sigma_{ia}\tilde{\Sigma}_{ia}^{-1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex64.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)-\log\det(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia})\right)." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)-\log\det(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.4" class="ltx_p"><span id="A2.p2.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">(Theorem 4.1 in the main text)
Let <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="(X,Y,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,Y,A)</annotation></semantics></math> denote the features, binary class label, and binary group membership, respectively, of a random data point from any data distribution <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with <math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>=</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)</annotation></semantics></math>, for <math id="A2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>, such that <math id="A2.Thmtheorem2.p1.m6" class="ltx_Math" alttext="q_{10}/q_{00}=q_{11}/q_{01}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>/</mo><msub><mi>q</mi><mn>00</mn></msub></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>/</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mrow><annotation encoding="application/x-tex">q_{10}/q_{00}=q_{11}/q_{01}</annotation></semantics></math>. Let <math id="A2.Thmtheorem2.p1.m7" class="ltx_math_unparsed" alttext="X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\Sigma_{ia})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\Sigma_{ia})</annotation></semantics></math> be multivariate Normal distributions, with mean <math id="A2.Thmtheorem2.p1.m8" class="ltx_Math" alttext="\mu_{ia}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mu_{ia}\in\mathbb{R}^{d}</annotation></semantics></math> and covariance matrix <math id="A2.Thmtheorem2.p1.m9" class="ltx_Math" alttext="\Sigma_{ia}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Sigma_{ia}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, for <math id="A2.Thmtheorem2.p1.m10" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem2.p1.m11" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>. Let <math id="A2.Thmtheorem2.p1.m12" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> denote a distribution obtained by keeping <math id="A2.Thmtheorem2.p1.m13" class="ltx_Math" alttext="(Y,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Y,A)</annotation></semantics></math> unchanged and only changing <math id="A2.Thmtheorem2.p1.m14" class="ltx_math_unparsed" alttext="X|Y=i,A=a" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">X|Y=i,A=a</annotation></semantics></math> to <math id="A2.Thmtheorem2.p1.m15" class="ltx_math_unparsed" alttext="\tilde{X}|Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\Sigma}_{ia})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{X}|Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\Sigma}_{ia})</annotation></semantics></math>. Then in the case of Affirmative action (changing only <math id="A2.Thmtheorem2.p1.m16" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.Thmtheorem2.p1.m17" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}</annotation></semantics></math>), we can efficiently minimize <math id="A2.Thmtheorem2.p1.m18" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math> as a function of the variables <math id="A2.Thmtheorem2.p1.m19" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.Thmtheorem2.p1.m20" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}</annotation></semantics></math> subject to the constraints in Proposition 1.2, so that the Bayes optimal classifier on the optimal <math id="A2.Thmtheorem2.p1.m21" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> is guaranteed to be EO-fair.</span></p>
</div>
</div>
<div id="A2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p"><span id="A2.p3.1.1" class="ltx_text">Using Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1. ‣ Appendix B Proofs for Section 4 ‣ On Optimal Steering to Achieve Exact Fairness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> and Proposition 1.2, our objective is to minimize</span></p>
<table id="A2.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex65.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\left(\tilde{D}||D\right)=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)-\log\det(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia})\right)," display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\left(\tilde{D}||D\right)=-\frac{d}{2}+\frac{1}{2}\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})+\frac{1}{2}\sum_{(i,a)}q_{ia}\left(\mathrm{tr}\left(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia}\right)-\log\det(\Sigma_{ia}^{-1}\tilde{\Sigma}_{ia})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.2" class="ltx_p"><span id="A2.p3.2.1" class="ltx_text">subject to the constraints</span></p>
<table id="A2.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex66.m1" class="ltx_math_unparsed" alttext="\tilde{\Sigma}_{10}^{-1/2}(\tilde{\mu}_{10}-\tilde{\mu}_{00})=\tilde{\Sigma}_{11}^{-1/2}(\tilde{\mu}_{11}-\tilde{\mu}_{01})\quad\text{and}\quad\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{00}^{-1}\tilde{\Sigma}_{10}^{1/2}=\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{01}^{-1}\tilde{\Sigma}_{11}^{1/2}." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo stretchy="false">)</mo></mrow><mtext>and</mtext><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>01</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{10}^{-1/2}(\tilde{\mu}_{10}-\tilde{\mu}_{00})=\tilde{\Sigma}_{11}^{-1/2}(\tilde{\mu}_{11}-\tilde{\mu}_{01})\quad\text{and}\quad\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{00}^{-1}\tilde{\Sigma}_{10}^{1/2}=\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{01}^{-1}\tilde{\Sigma}_{11}^{1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p"><span id="A2.p4.1.1" class="ltx_text">Suppose <math id="A2.p4.m1" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}</annotation></semantics></math> and <math id="A2.p4.m2" class="ltx_Math" alttext="\tilde{\Sigma}_{i1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i1}</annotation></semantics></math> do not commute. The constraints can be equivalently rewritten as follows.</span></p>
<table id="A2.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex67.m1" class="ltx_math_unparsed" alttext="\tilde{\mu}_{10}-\tilde{\mu}_{00}=\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{11}^{-1/2}(\tilde{\mu}_{11}-\tilde{\mu}_{01})\quad\text{and}\quad\tilde{\Sigma}_{11}^{-1/2}\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{00}^{-1}\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{11}^{-1/2}=\tilde{\Sigma}_{01}^{-1}." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>=</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo stretchy="false">)</mo></mrow><mtext>and</mtext><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>01</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{10}-\tilde{\mu}_{00}=\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{11}^{-1/2}(\tilde{\mu}_{11}-\tilde{\mu}_{01})\quad\text{and}\quad\tilde{\Sigma}_{11}^{-1/2}\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{00}^{-1}\tilde{\Sigma}_{10}^{1/2}\tilde{\Sigma}_{11}^{-1/2}=\tilde{\Sigma}_{01}^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.2" class="ltx_p"><span id="A2.p4.2.1" class="ltx_text">Let <math id="A2.p4.m3" class="ltx_math_unparsed" alttext="\Gamma=\tilde{\Sigma}_{i0}^{1/2}\tilde{\Sigma}_{i1}^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>=</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\Gamma=\tilde{\Sigma}_{i0}^{1/2}\tilde{\Sigma}_{i1}^{-1/2}</annotation></semantics></math>. For any fixed positive semidefinite matrix <math id="A2.p4.m4" class="ltx_Math" alttext="\Gamma\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Gamma\in\mathbb{R}^{d\times d}</annotation></semantics></math>, our optimization problem can be divided into two separate parts that minimize</span></p>
<table id="A2.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})\quad\text{subject to}\quad\tilde{\mu}_{10}-\tilde{\mu}_{00}=\Gamma(\tilde{\mu}_{11}-\tilde{\mu}_{01})" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>subject to</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow><mo>=</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{(i,a)}q_{ia}(\tilde{\mu}_{ia}-\mu_{ia})^{T}\Sigma_{ia}^{-1}(\tilde{\mu}_{ia}-\mu_{ia})\quad\text{subject to}\quad\tilde{\mu}_{10}-\tilde{\mu}_{00}=\Gamma(\tilde{\mu}_{11}-\tilde{\mu}_{01})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.3" class="ltx_p"><span id="A2.p4.3.1" class="ltx_text">over <math id="A2.p4.m5" class="ltx_Math" alttext="\tilde{\mu}_{ia}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{ia}\in\mathbb{R}^{d}</annotation></semantics></math>, for <math id="A2.p4.m6" class="ltx_Math" alttext="i,a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>a</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i,a\in\{0,1\}</annotation></semantics></math>, and minimize (after substituting <math id="A2.p4.m7" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}^{1/2}=\Gamma\tilde{\Sigma}_{i1}^{1/2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}^{1/2}=\Gamma\tilde{\Sigma}_{i1}^{1/2}</annotation></semantics></math>)</span></p>
<table id="A2.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=0}^{1}q_{i0}\left(\mathrm{tr}\left(\Sigma_{i0}^{-1}\left(\Gamma\tilde{\Sigma}_{i0}^{1/2}\right)^{2}\right)-\log\det(\Sigma_{i0}^{-1}\left(\Gamma\tilde{\Sigma}_{i0}^{1/2}\right)^{2}\right)+q_{i1}\left(\mathrm{tr}\left(\Sigma_{i1}^{-1}\tilde{\Sigma}_{i1}\right)-\log\det(\Sigma_{i1}^{-1}\tilde{\Sigma}_{i1})\right)," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo>(</mo><mi mathvariant="normal">Γ</mi><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow><mo>−</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo>(</mo><mi mathvariant="normal">Γ</mi><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>(</mo><mi>tr</mi><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{1}q_{i0}\left(\mathrm{tr}\left(\Sigma_{i0}^{-1}\left(\Gamma\tilde{\Sigma}_{i0}^{1/2}\right)^{2}\right)-\log\det(\Sigma_{i0}^{-1}\left(\Gamma\tilde{\Sigma}_{i0}^{1/2}\right)^{2}\right)+q_{i1}\left(\mathrm{tr}\left(\Sigma_{i1}^{-1}\tilde{\Sigma}_{i1}\right)-\log\det(\Sigma_{i1}^{-1}\tilde{\Sigma}_{i1})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\displaystyle\text{subject to }\Gamma\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{00}^{-1}\Gamma=\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{01}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>subject to </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Γ</mi></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>01</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{subject to }\Gamma\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{00}^{-1}\Gamma=\tilde{\Sigma}_{11}^{1/2}\tilde{\Sigma}_{01}^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.4" class="ltx_p"><span id="A2.p4.4.1" class="ltx_text">over symmetric, positive semidefinite matrix-valued variable <math id="A2.p4.m8" class="ltx_Math" alttext="\tilde{\Sigma}_{i1}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{i1}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, for <math id="A2.p4.m9" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math>. The first optimization in <math id="A2.p4.m10" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> is a constrained eigenvalue problem with linear constraints, i.e., minimize <math id="A2.p4.m11" class="ltx_Math" alttext="x^{T}Ax+x^{T}b" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">x^{T}Ax+x^{T}b</annotation></semantics></math> subject to <math id="A2.p4.m12" class="ltx_Math" alttext="x^{T}c=e" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">x^{T}c=e</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>.</span></p>
</div>
<div id="A2.p5" class="ltx_para">
<p id="A2.p5.1" class="ltx_p"><span id="A2.p5.1.1" class="ltx_text">Let’s consider the case of <em id="A2.p5.1.1.1" class="ltx_emph ltx_font_italic">Affirmative Action</em>, where we only change the means <math id="A2.p5.m1" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and the covariance matrices <math id="A2.p5.m2" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}</annotation></semantics></math> for the underprivileged group but keep those for the privileged group unchanged, i.e., <math id="A2.p5.m3" class="ltx_Math" alttext="\tilde{\mu}_{i1}=\mu_{i1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{i1}=\mu_{i1}</annotation></semantics></math> and <math id="A2.p5.m4" class="ltx_Math" alttext="\tilde{\Sigma}_{i1}=\Sigma_{i1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{i1}=\Sigma_{i1}</annotation></semantics></math>. In that case, <math id="A2.p5.m5" class="ltx_Math" alttext="\tilde{\Sigma}_{00}^{1/2}=\Gamma\Sigma_{01}^{1/2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>00</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>01</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{00}^{1/2}=\Gamma\Sigma_{01}^{1/2}</annotation></semantics></math> and <math id="A2.p5.m6" class="ltx_Math" alttext="\tilde{\Sigma}_{10}^{1/2}=\Gamma\Sigma_{11}^{1/2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mn>10</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}_{10}^{1/2}=\Gamma\Sigma_{11}^{1/2}</annotation></semantics></math> get fixed. By substituting <math id="A2.p5.m7" class="ltx_Math" alttext="\tilde{\mu}_{10}=\tilde{\mu}_{00}+\Gamma(\tilde{\mu}_{11}-\tilde{\mu}_{01})=\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>+</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>+</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{10}=\tilde{\mu}_{00}+\Gamma(\tilde{\mu}_{11}-\tilde{\mu}_{01})=\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})</annotation></semantics></math>, we only need to optimize</span></p>
<table id="A2.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex71.m1" class="ltx_Math" alttext="q_{00}(\tilde{\mu}_{00}-\mu_{00})^{T}\Sigma_{00}^{-1}(\tilde{\mu}_{00}-\mu_{00})+q_{10}(\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})-\mu_{10})^{T}\Sigma_{10}^{-1}(\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})-\mu_{10})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>+</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>+</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q_{00}(\tilde{\mu}_{00}-\mu_{00})^{T}\Sigma_{00}^{-1}(\tilde{\mu}_{00}-\mu_{00})+q_{10}(\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})-\mu_{10})^{T}\Sigma_{10}^{-1}(\tilde{\mu}_{00}+\Gamma(\mu_{11}-\mu_{01})-\mu_{10}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p5.2" class="ltx_p"><span id="A2.p5.2.1" class="ltx_text">or equivalently (ignoring the terms independent of <math id="A2.p5.m8" class="ltx_Math" alttext="\tilde{\mu}_{00}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{00}</annotation></semantics></math>),</span></p>
<table id="A2.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex72.m1" class="ltx_Math" alttext="\tilde{\mu}_{00}^{T}\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)\tilde{\mu}_{00}-2\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)^{T}\tilde{\mu}_{00}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow></mrow><mo>−</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{00}^{T}\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)\tilde{\mu}_{00}-2\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)^{T}\tilde{\mu}_{00}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p5.3" class="ltx_p"><span id="A2.p5.3.1" class="ltx_text">This is a convex objective in <math id="A2.p5.m9" class="ltx_Math" alttext="\tilde{\mu}_{00}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{00}</annotation></semantics></math> because its Hessian is positive semidefinite, i.e., <math id="A2.p5.m10" class="ltx_Math" alttext="q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\succcurlyeq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>≽</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\succcurlyeq 0</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">15</a>]</cite>. By equating the gradient to zero, we get the optimal solution for <math id="A2.p5.m11" class="ltx_Math" alttext="\tilde{\mu}_{00}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{00}</annotation></semantics></math>, and we denote it by <math id="A2.p5.m12" class="ltx_Math" alttext="\mu^{*}_{00}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{00}(\Gamma)</annotation></semantics></math>. Thus, the optimal solutions <math id="A2.p5.m13" class="ltx_Math" alttext="\mu^{*}_{00}(\Gamma),\mu^{*}_{10}(\Gamma),\Sigma^{*}_{00}(\Gamma),\Sigma^{*}_{10}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{00}(\Gamma),\mu^{*}_{10}(\Gamma),\Sigma^{*}_{00}(\Gamma),\Sigma^{*}_{10}(\Gamma)</annotation></semantics></math> for a fixed positive semidefinite <math id="A2.p5.m14" class="ltx_Math" alttext="\Gamma\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Gamma\in\mathbb{R}^{d\times d}</annotation></semantics></math> are given by</span></p>
<table id="A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{00}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{00}(\Gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)^{-1}\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)\quad\text{and}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msup><mrow><mo>(</mo><msub><mi>q</mi><mn>00</mn></msub><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>μ</mi><mn>00</mn></msub><mo>+</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>μ</mi><mn>10</mn></msub><mo>−</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mi mathvariant="normal">Γ</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mtext>and</mtext></mrow><annotation encoding="application/x-tex">\displaystyle=\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)^{-1}\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)\quad\text{and}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{10}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{10}(\Gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex74.m2" class="ltx_Math" alttext="\displaystyle=\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)^{-1}\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)+\Gamma(\mu_{11}-\mu_{01})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow></mrow><mo>−</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>11</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(q_{00}\Sigma_{00}^{-1}+q_{10}\Sigma_{10}^{-1}\right)^{-1}\left(\Sigma_{00}^{-1}\mu_{00}+\Sigma_{10}^{-1}\mu_{10}-\Sigma_{10}^{-1}\Gamma(\mu_{11}-\mu_{01})\right)+\Gamma(\mu_{11}-\mu_{01})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex75.m1" class="ltx_Math" alttext="\displaystyle\Sigma^{*}_{00}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma^{*}_{00}(\Gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex75.m2" class="ltx_Math" alttext="\displaystyle=(\Gamma\Sigma_{01}^{1/2})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>01</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=(\Gamma\Sigma_{01}^{1/2})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_Math" alttext="\displaystyle\Sigma^{*}_{10}(\Gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma^{*}_{10}(\Gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m2" class="ltx_Math" alttext="\displaystyle=(\Gamma\Sigma_{11}^{1/2})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mn>11</mn><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\Gamma\Sigma_{11}^{1/2})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p5.4" class="ltx_p"><span id="A2.p5.4.1" class="ltx_text">By substituting these, when we look at the objective as a function of a positive semidefinite matrix-valued variable <math id="A2.p5.m15" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>, it turns out to be convex. This requires rewriting the expressions using the identities <math id="A2.p5.m16" class="ltx_Math" alttext="\mathrm{tr}\left(AB\right)=\mathrm{tr}\left(BA\right),\det(AB)=\det(A)\det(B)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mo lspace="0em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">det</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{tr}\left(AB\right)=\mathrm{tr}\left(BA\right),\det(AB)=\det(A)\det(B)</annotation></semantics></math>, and most importantly, <math id="A2.p5.m17" class="ltx_Math" alttext="\mathrm{tr}\left(AXBX\right)=\mathrm{tr}\left((A^{1/2}XB^{1/2})(A^{1/2}XB^{1/2})^{T}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>A</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>A</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{tr}\left(AXBX\right)=\mathrm{tr}\left((A^{1/2}XB^{1/2})(A^{1/2}XB^{1/2})^{T}\right)</annotation></semantics></math> and <math id="A2.p5.m18" class="ltx_math_unparsed" alttext="\log\det(AXBX)=\log\det\left(A^{1/2}XB^{1/2})(A^{1/2}XB^{1/2})^{T}\right)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mi>X</mi><mi>B</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">det</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>X</mi><msup><mi>B</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>X</mi><msup><mi>B</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo>)</mo></mrow><annotation encoding="application/x-tex">\log\det(AXBX)=\log\det\left(A^{1/2}XB^{1/2})(A^{1/2}XB^{1/2})^{T}\right)</annotation></semantics></math>, for symmetric, positive semidefinite matrices <math id="A2.p5.m19" class="ltx_Math" alttext="A,B,X" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">A,B,X</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib54" title="" class="ltx_ref">54</a>]</cite>. The convexity of the objective in <math id="A2.p5.m20" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> follows from the convexity of <math id="A2.p5.m21" class="ltx_Math" alttext="\mathrm{tr}\left(AXBX\right)" display="inline" intent=":literal"><semantics><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{tr}\left(AXBX\right)</annotation></semantics></math> and <math id="A2.p5.m22" class="ltx_math_unparsed" alttext="-\log\det(X)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">-\log\det(X)</annotation></semantics></math> for matrix-valued variable <math id="A2.p5.m23" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Finally, we can solve it efficiently to get the optimal <math id="A2.p5.m24" class="ltx_Math" alttext="\Gamma^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Γ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Gamma^{*}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Corollary B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">(Corollary 4.2 in the main text) For the case where <math id="A2.Thmtheorem3.p1.m1" class="ltx_math_unparsed" alttext="X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})</annotation></semantics></math> are univariate normal distributions, for <math id="A2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="i,a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>a</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i,a\in\{0,1\}</annotation></semantics></math> , the optimal distribution <math id="A2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> from Theorem 4.1, with <math id="A2.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\gamma^{*}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\gamma^{*}</annotation></semantics></math> being a function of the original distribution parameters, can be written down as:</span></p>
<table id="A2.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle\tilde{\sigma}_{i0}=\gamma^{*}\sigma_{i1},\quad\tilde{\mu}_{00}=\tilde{\mu}_{10}+\gamma^{*}(\mu_{01}-\mu_{11}),\text{ and }~\tilde{\mu}_{10}=\dfrac{\left(q_{00}\dfrac{\mu_{00}-\gamma^{*}(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\dfrac{\mu_{10}}{\sigma_{10}^{2}}\right)}{\left(\dfrac{q_{00}}{\sigma_{00}^{2}}+\dfrac{q_{10}}{\sigma_{10}^{2}}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>=</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>+</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic"> and </mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>μ</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\sigma}_{i0}=\gamma^{*}\sigma_{i1},\quad\tilde{\mu}_{00}=\tilde{\mu}_{10}+\gamma^{*}(\mu_{01}-\mu_{11}),\text{ and }~\tilde{\mu}_{10}=\dfrac{\left(q_{00}\dfrac{\mu_{00}-\gamma^{*}(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\dfrac{\mu_{10}}{\sigma_{10}^{2}}\right)}{\left(\dfrac{q_{00}}{\sigma_{00}^{2}}+\dfrac{q_{10}}{\sigma_{10}^{2}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p6" class="ltx_para">
<table id="A2.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(\tilde{X}=x,\tilde{Y}=i,\tilde{A}=a\right)\log\frac{\mathrm{Pr}\left(\tilde{X}=x,\tilde{Y}=i,\tilde{A}=a\right)}{\mathrm{Pr}\left(X=x,Y=i,A=a\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo>,</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(\tilde{X}=x,\tilde{Y}=i,\tilde{A}=a\right)\log\frac{\mathrm{Pr}\left(\tilde{X}=x,\tilde{Y}=i,\tilde{A}=a\right)}{\mathrm{Pr}\left(X=x,Y=i,A=a\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(\tilde{Y}=i,\tilde{A}=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;\tilde{Y}=i,\tilde{A}=a\right)\log\frac{\mathrm{Pr}\left(\tilde{Y}=i,\tilde{A}=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;\tilde{Y}=i,\tilde{A}=a\right)}{\mathrm{Pr}\left(Y=y,A=a\right)\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>y</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(\tilde{Y}=i,\tilde{A}=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;\tilde{Y}=i,\tilde{A}=a\right)\log\frac{\mathrm{Pr}\left(\tilde{Y}=i,\tilde{A}=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;\tilde{Y}=i,\tilde{A}=a\right)}{\mathrm{Pr}\left(Y=y,A=a\right)\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)\log\frac{\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)}{\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(x,i,a)}\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)\log\frac{\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)}{\mathrm{Pr}\left(Y=i,A=a\right)\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(i,a)}q_{ia}\sum_{x}\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)\log\frac{\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)}{\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>x</mi></munder></mstyle><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo mathsize="1.200em">|</mo><mrow><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}\sum_{x}\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)\log\frac{\mathrm{Pr}\left(\tilde{X}=x\;\big|\;Y=i,A=a\right)}{\mathrm{Pr}\left(X=x\;\big|\;Y=i,A=a\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.1" class="ltx_p"><math id="A2.p6.m1" class="ltx_Math" alttext="P_{ia}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">P_{ia}</annotation></semantics></math><span id="A2.p6.1.1" class="ltx_text"> denotes the distribution of <math id="A2.p6.m2" class="ltx_math_unparsed" alttext="X\;\big|\;Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" lspace="0.280em" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X\;\big|\;Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})</annotation></semantics></math> and <math id="A2.p6.m3" class="ltx_Math" alttext="\tilde{P}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{P}_{ia}</annotation></semantics></math> denotes the distribution of <math id="A2.p6.m4" class="ltx_math_unparsed" alttext="\tilde{X}\;\big|\;Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\sigma}_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo fence="false" lspace="0.280em" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{X}\;\big|\;Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\sigma}_{ia}^{2})</annotation></semantics></math>. Their probability densities are</span></p>
<table id="A2.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex84.m1" class="ltx_Math" alttext="p_{ia}(x)=\frac{1}{x\sigma_{ia}\sqrt{2\pi}}\exp\left(-\frac{\left(x-\mu_{ia}\right)^{2}}{2\sigma_{ia}^{2}}\right)\quad\text{and}\quad\tilde{p}_{ia}(x)=\frac{1}{x\tilde{\sigma}_{ia}\sqrt{2\pi}}\exp\left(-\frac{\left(x-\tilde{\mu}_{ia}\right)^{2}}{2\tilde{\sigma}_{ia}^{2}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><msup><mrow><mo>(</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><msup><mrow><mo>(</mo><mrow><mi>x</mi><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p_{ia}(x)=\frac{1}{x\sigma_{ia}\sqrt{2\pi}}\exp\left(-\frac{\left(x-\mu_{ia}\right)^{2}}{2\sigma_{ia}^{2}}\right)\quad\text{and}\quad\tilde{p}_{ia}(x)=\frac{1}{x\tilde{\sigma}_{ia}\sqrt{2\pi}}\exp\left(-\frac{\left(x-\tilde{\mu}_{ia}\right)^{2}}{2\tilde{\sigma}_{ia}^{2}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.2" class="ltx_p"><span id="A2.p6.2.1" class="ltx_text">respectively. Hence,</span></p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathrm{E}\left[\log\frac{\tilde{p}_{ia}(\tilde{X})}{p_{ia}(\tilde{X})}\;\big|\;Y=i,A=a\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>E</mi><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" lspace="0.280em" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{E}\left[\log\frac{\tilde{p}_{ia}(\tilde{X})}{p_{ia}(\tilde{X})}\;\big|\;Y=i,A=a\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathrm{E}\left[\frac{(\tilde{X}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}-\frac{(\tilde{X}-\tilde{\mu}_{ia})^{2}}{2\tilde{\sigma}_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\;\big|\;Y=i,A=a\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>E</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mstyle><mo fence="false" lspace="0.280em" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{E}\left[\frac{(\tilde{X}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}-\frac{(\tilde{X}-\tilde{\mu}_{ia})^{2}}{2\tilde{\sigma}_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\;\big|\;Y=i,A=a\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathrm{E}\left[\left(\frac{1}{2\sigma_{ia}^{2}}-\frac{1}{\tilde{2\sigma}_{ia}^{2}}\right)\tilde{X}^{2}+\left(\frac{\tilde{\mu}_{ia}}{\tilde{\sigma}_{ia}^{2}}-\frac{\mu_{ia}}{\sigma_{ia}^{2}}\right)\tilde{X}+\left(\frac{\mu_{ia}^{2}}{2\sigma_{ia}^{2}}-\frac{\tilde{\mu}_{ia}^{2}}{2\tilde{\sigma}_{ia}^{2}}\right)+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\;\big|\;Y=i,A=a\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>E</mi><mrow><mo>[</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mover accent="true"><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>)</mo></mrow><msup><mover accent="true"><mi>X</mi><mo>~</mo></mover><mn>2</mn></msup><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>)</mo></mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mstyle><mo fence="false" lspace="0.280em" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{E}\left[\left(\frac{1}{2\sigma_{ia}^{2}}-\frac{1}{\tilde{2\sigma}_{ia}^{2}}\right)\tilde{X}^{2}+\left(\frac{\tilde{\mu}_{ia}}{\tilde{\sigma}_{ia}^{2}}-\frac{\mu_{ia}}{\sigma_{ia}^{2}}\right)\tilde{X}+\left(\frac{\mu_{ia}^{2}}{2\sigma_{ia}^{2}}-\frac{\tilde{\mu}_{ia}^{2}}{2\tilde{\sigma}_{ia}^{2}}\right)+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\;\big|\;Y=i,A=a\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
