<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex139.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}}{\dfrac{q_{i0}}{q_{i1}}+1}+\frac{q_{i1}}{2}\log\frac{\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}}{\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\left(\dfrac{q_{i0}}{q_{i1}}+1\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}}{\dfrac{q_{i0}}{q_{i1}}+1}+\frac{q_{i1}}{2}\log\frac{\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}}{\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\left(\dfrac{q_{i0}}{q_{i1}}+1\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex140.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}+q_{i1}}{2}\log\left(\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\right)-\frac{q_{i0}+q_{i1}}{2}\log\left(\frac{q_{i0}}{q_{i1}}+1\right)-q_{i1}\log\gamma-q_{i1}\log\frac{\sigma_{i0}}{\sigma_{i1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}+q_{i1}}{2}\log\left(\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\right)-\frac{q_{i0}+q_{i1}}{2}\log\left(\frac{q_{i0}}{q_{i1}}+1\right)-q_{i1}\log\gamma-q_{i1}\log\frac{\sigma_{i0}}{\sigma_{i1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.15" class="ltx_p"><span id="A2.p8.15.1" class="ltx_text">Putting it all together</span></p>
<table id="A2.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex141.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}^{*}_{\gamma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\displaystyle\mathcal{L}^{*}_{\gamma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex141.m2" class="ltx_Math" alttext="\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex142.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\frac{\left(\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})\right)^{2}}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}+\sum_{i=0}^{1}\frac{q_{i0}+q_{i1}}{2}\log\left(\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\frac{\left(\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})\right)^{2}}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}+\sum_{i=0}^{1}\frac{q_{i0}+q_{i1}}{2}\log\left(\dfrac{q_{i0}}{q_{i1}}+\gamma^{2}\dfrac{\sigma_{i0}^{2}}{\sigma_{i1}^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex143.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\qquad-\frac{q_{i0}+q_{i1}}{2}\log\left(\frac{q_{i0}}{q_{i1}}+1\right)-q_{i1}\log\gamma-q_{i1}\log\frac{\sigma_{i0}}{\sigma_{i1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\qquad-\frac{q_{i0}+q_{i1}}{2}\log\left(\frac{q_{i0}}{q_{i1}}+1\right)-q_{i1}\log\gamma-q_{i1}\log\frac{\sigma_{i0}}{\sigma_{i1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p9" class="ltx_para">
<p id="A2.p9.1" class="ltx_p"><span id="A2.p9.1.1" class="ltx_text">Minimizing <math id="A2.p9.m1" class="ltx_Math" alttext="\mathcal{L}^{*}_{\gamma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathcal{L}^{*}_{\gamma}</annotation></semantics></math> leads to a non convex program. Since <math id="A2.p9.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is the ratio between variances of the new subgroup distribution, for a practical solution, we can do a line search over <math id="A2.p9.m3" class="ltx_Math" alttext="\gamma\in(0,B)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in(0,B)</annotation></semantics></math> for some <math id="A2.p9.m4" class="ltx_Math" alttext="B&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">B&lt;\infty</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.p10" class="ltx_para">
<p id="A2.p10.1" class="ltx_p"><span id="A2.p10.1.1" class="ltx_text ltx_font_bold">Bound on Unfairness and Error Rate</span> For completeness, we now derive upper bounds on the error rate and the unfairness gap <math id="A2.p10.m1" class="ltx_Math" alttext="\Delta_{\text{EO}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mtext>EO</mtext></msub><annotation encoding="application/x-tex">\Delta_{\text{EO}}</annotation></semantics></math> of the Bayes optimal classifier <math id="A2.p10.m2" class="ltx_Math" alttext="\tilde{h}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>h</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{h}</annotation></semantics></math> on <math id="A2.p10.m3" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> with respect to the original distribution <math id="A2.p10.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. These bounds show that both the accuracy loss and the fairness gap depend only on the KL divergence between <math id="A2.p10.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> and <math id="A2.p10.m6" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>. It also shows that the optimal value of our optimization problem can be used to approximately translate the accuracy guarantee of <math id="A2.p10.m7" class="ltx_Math" alttext="\tilde{h}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>h</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{h}</annotation></semantics></math> from <math id="A2.p10.m8" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> to <math id="A2.p10.m9" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmtheorem5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Proposition B.5</span></span><span id="A2.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem5.p1" class="ltx_para">
<p id="A2.Thmtheorem5.p1.1" class="ltx_p"><span id="A2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">(Proposition 4.4 in the main text) Let <math id="A2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\text{err}(h,D)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{err}(h,D)</annotation></semantics></math> denote the error rate (expected 0-1 loss) of a classifier <math id="A2.Thmtheorem5.p1.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> on the distribution <math id="A2.Thmtheorem5.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. Let <math id="A2.Thmtheorem5.p1.m4" class="ltx_Math" alttext="d_{TV}(\tilde{D},D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{TV}(\tilde{D},D)</annotation></semantics></math> denote the total variation distance between two distributions <math id="A2.Thmtheorem5.p1.m5" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> and <math id="A2.Thmtheorem5.p1.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, while <math id="A2.Thmtheorem5.p1.m7" class="ltx_Math" alttext="D_{KL}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><annotation encoding="application/x-tex">D_{KL}</annotation></semantics></math> denotes the KL-Divergence between them. Denote the Bayes optimal classifier on the ideal distribution <math id="A2.Thmtheorem5.p1.m8" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> as <math id="A2.Thmtheorem5.p1.m9" class="ltx_Math" alttext="\tilde{h}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>h</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{h}</annotation></semantics></math> (and similarly the Bayes optimal classifier <math id="A2.Thmtheorem5.p1.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>. Then, we can bound the error rate and Equal opportunity of <math id="A2.Thmtheorem5.p1.m11" class="ltx_Math" alttext="\tilde{h}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>h</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{h}</annotation></semantics></math> on the original distribution <math id="A2.Thmtheorem5.p1.m12" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> as follows:</span></p>
<table id="A2.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex144.m1" class="ltx_Math" alttext="\displaystyle|\text{err}(\tilde{h},D)-\text{err}(\tilde{h},\tilde{D})|\leq\sqrt{2D_{KL}(\tilde{D},D)}\quad\text{ and }\quad\Delta_{EO}(\tilde{h},D)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mtext class="ltx_mathvariant_italic">err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mtext class="ltx_mathvariant_italic">err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic"> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|\text{err}(\tilde{h},D)-\text{err}(\tilde{h},\tilde{D})|\leq\sqrt{2D_{KL}(\tilde{D},D)}\quad\text{ and }\quad\Delta_{EO}(\tilde{h},D)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex144.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{8D_{\mathrm{KL}}\left(\tilde{D}||D\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mn>8</mn><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{8D_{\mathrm{KL}}\left(\tilde{D}||D\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p11" class="ltx_para">
<p id="A2.p11.1" class="ltx_p"><span id="A2.p11.1.1" class="ltx_text">For the sake of this proof, we assume a countable data domain. Using the definition of the expected <math id="A2.p11.m1" class="ltx_Math" alttext="0-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0-1</annotation></semantics></math> loss, we can write:</span></p>
<table id="A2.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex145.m1" class="ltx_Math" alttext="\displaystyle\text{err}(\tilde{h},D)-\text{err}(\tilde{h},\tilde{D})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{err}(\tilde{h},D)-\text{err}(\tilde{h},\tilde{D})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex146.m1" class="ltx_Math" alttext="\displaystyle=\underset{(x,y,a)}{\sum}\mathbb{I}\left(\tilde{h}(x,a)\neq y\right)\cdot(p(x,y,a)-\tilde{p}(x,y,a))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder accentunder="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo>,</mo><mi mathsize="0.700em">y</mi><mo>,</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>y</mi></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>p</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{(x,y,a)}{\sum}\mathbb{I}\left(\tilde{h}(x,a)\neq y\right)\cdot(p(x,y,a)-\tilde{p}(x,y,a))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex147.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2d_{TV}(\tilde{D},D)\leq\sqrt{2D_{KL}(\tilde{D},D)}~~~~~~~~~\text{(Pinsker's Inequality \cite[cite]{[\@@bibref{Number}{canonne2023short}{}{}]}).}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><msub><mi>d</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mrow><mtext>(Pinsker’s Inequality </mtext><mtext class="ltx_citemacro_cite"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite></mtext><mtext>).</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2d_{TV}(\tilde{D},D)\leq\sqrt{2D_{KL}(\tilde{D},D)}~~~~~~~~~\text{(Pinsker's Inequality \cite[cite]{[\@@bibref{Number}{canonne2023short}{}{}]}).}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p12" class="ltx_para">
<p id="A2.p12.1" class="ltx_p"><span id="A2.p12.1.1" class="ltx_text">The first inequality follows from writing the error as expected 0-1 loss and using the definition of total variation distance. The last line follows from Pinsker’s inequality <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>. We can similarly prove the other direction to obtain the first inequality. Similarly, for the true positive rate of group <math id="A2.p12.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, <math id="A2.p12.m2" class="ltx_Math" alttext="TPR_{a}(\tilde{h},D)-TPR_{a}(\tilde{h},\tilde{D})\leq 2D_{TV}(\tilde{D},D)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">TPR_{a}(\tilde{h},D)-TPR_{a}(\tilde{h},\tilde{D})\leq 2D_{TV}(\tilde{D},D)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.p13" class="ltx_para">
<p id="A2.p13.1" class="ltx_p"><span id="A2.p13.1.1" class="ltx_text">We can also write for the other group <math id="A2.p13.m1" class="ltx_Math" alttext="A=a^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">A=a^{\prime}</annotation></semantics></math>, <math id="A2.p13.m2" class="ltx_Math" alttext="TPR_{a^{\prime}}(\tilde{h},\tilde{D})-TPR_{a^{\prime}}(\tilde{h},D)\leq 2D_{TV}(\tilde{D},D)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><msup><mi>a</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><msup><mi>a</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">TPR_{a^{\prime}}(\tilde{h},\tilde{D})-TPR_{a^{\prime}}(\tilde{h},D)\leq 2D_{TV}(\tilde{D},D)</annotation></semantics></math>. Adding both LHS and RHS and repeating the exercise in the other direction, noting that the TPR difference of <math id="A2.p13.m3" class="ltx_Math" alttext="\tilde{h}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>h</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{h}</annotation></semantics></math> in <math id="A2.p13.m4" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> is zero (since in the ideal distribution we have exact fairness), we can bound the absolute value of the TPR difference, which is our definition of <math id="A2.p13.m5" class="ltx_Math" alttext="\Delta_{EO}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><annotation encoding="application/x-tex">\Delta_{EO}</annotation></semantics></math>, we get:</span></p>
<table id="A2.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex148.m1" class="ltx_Math" alttext="\displaystyle\Delta_{EO}(\tilde{h},D)\leq\sqrt{8D_{\mathrm{KL}}\left(\tilde{D}||D\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msqrt><mrow><mn>8</mn><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{EO}(\tilde{h},D)\leq\sqrt{8D_{\mathrm{KL}}\left(\tilde{D}||D\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p13.2" class="ltx_p"><span id="A2.p13.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.p14" class="ltx_para">
<p id="A2.p14.1" class="ltx_p"><span id="A2.p14.1.1" class="ltx_text ltx_font_bold">Equalizing the first moment</span> A popular intervention in the fairness literature is to equalize the first moment of the two sensitive groups or the mean outcomes of two groups, also known as the Calders-Verwer gap <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>, <a href="#bib.bib43" title="" class="ltx_ref">43</a>, <a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite>. We, therefore, also study an intervention where we only change the mean of the under-privileged group and try to match it with the mean of the privileged group. We can show that the resulting optimization program is convex. We leverage this intervention in Section 5 of the main text.</p>
</div>
<div id="A2.Thmtheorem6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem6.2" class="ltx_text ltx_font_bold">Proposition B.6</span></span><span id="A2.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem6.p1" class="ltx_para">
<p id="A2.Thmtheorem6.p1.1" class="ltx_p"><span id="A2.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">(Affirmative Action by Equalizing First Moments) 
Let <math id="A2.Thmtheorem6.p1.m1" class="ltx_Math" alttext="(X,Y,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,Y,A)</annotation></semantics></math> denote the features, binary class label, and binary group membership, respectively, of a random data point from any data distribution <math id="A2.Thmtheorem6.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with <math id="A2.Thmtheorem6.p1.m3" class="ltx_Math" alttext="q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>=</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)</annotation></semantics></math>, for <math id="A2.Thmtheorem6.p1.m4" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem6.p1.m5" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>. Let <math id="A2.Thmtheorem6.p1.m6" class="ltx_math_unparsed" alttext="X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})</annotation></semantics></math> be a univariate Normal distribution, for <math id="A2.Thmtheorem6.p1.m7" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem6.p1.m8" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>. Then in the case of Affirmative mean change, where we impose the following constraints:</span></p>
<table id="A2.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex149.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{10}~\tilde{\mu}_{10}}{q_{10}+q_{00}}+\frac{q_{00}~\tilde{\mu}_{00}}{q_{10}+q_{00}}=\frac{q_{11}~\mu_{11}}{q_{11}+q_{01}}+\frac{q_{01}~\mu_{01}}{q_{11}+q_{01}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0.330em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>+</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0.330em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>+</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>11</mn></msub><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>+</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>01</mn></msub><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>+</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{10}~\tilde{\mu}_{10}}{q_{10}+q_{00}}+\frac{q_{00}~\tilde{\mu}_{00}}{q_{10}+q_{00}}=\frac{q_{11}~\mu_{11}}{q_{11}+q_{01}}+\frac{q_{01}~\mu_{01}}{q_{11}+q_{01}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem6.p1.2" class="ltx_p"><span id="A2.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">we can efficiently minimize <math id="A2.Thmtheorem6.p1.m9" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math> as a function of the variables <math id="A2.Thmtheorem6.p1.m10" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.Thmtheorem6.p1.m11" class="ltx_Math" alttext="\tilde{\Sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\Sigma}_{i0}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p15" class="ltx_para">
<p id="A2.p15.1" class="ltx_p"><span id="A2.p15.1.1" class="ltx_text">We are dealing with the following optimization problem:</span></p>
<table id="A2.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex150.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex150.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{i=0}^{1}q_{i0}D_{\mathrm{KL}}\left(\tilde{P}_{i0}||P_{i0}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}q_{i0}D_{\mathrm{KL}}\left(\tilde{P}_{i0}||P_{i0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex151.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p15.2" class="ltx_p"><span id="A2.p15.2.1" class="ltx_text">as a function of the variables <math id="A2.p15.m1" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.p15.m2" class="ltx_Math" alttext="\tilde{\sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i0}</annotation></semantics></math> subject to the constraints</span></p>
<table id="A2.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex152.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{10}}{q_{10}+q_{00}}\tilde{\mu}_{10}+\frac{q_{00}}{q_{10}+q_{00}}\tilde{\mu}_{00}=\frac{q_{11}}{q_{11}+q_{01}}\mu_{11}+\frac{q_{01}}{q_{11}+q_{01}}\mu_{01}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>10</mn></msub><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>+</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>+</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>11</mn></msub><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>+</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>01</mn></msub><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>+</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{10}}{q_{10}+q_{00}}\tilde{\mu}_{10}+\frac{q_{00}}{q_{10}+q_{00}}\tilde{\mu}_{00}=\frac{q_{11}}{q_{11}+q_{01}}\mu_{11}+\frac{q_{01}}{q_{11}+q_{01}}\mu_{01}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p15.3" class="ltx_p"><span id="A2.p15.3.1" class="ltx_text">Since we are only changing the means and keeping the variances the same, the objective only depends on <math id="A2.p15.m3" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math>. Furthermore, let <math id="A2.p15.m4" class="ltx_Math" alttext="K=\nicefrac{{(q_{10}+q_{00})}}{{(q_{11}+q_{01})}}\cdot(q_{11}\mu_{11}+q_{01}\mu_{01})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mrow><mpadded voffset="0.3em"><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">q</mi><mn mathsize="0.710em">10</mn></msub><mo mathsize="0.700em">+</mo><msub><mi mathsize="0.700em">q</mi><mn mathsize="0.710em">00</mn></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mrow><mo lspace="0.222em" maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">q</mi><mn mathsize="0.710em">11</mn></msub><mo mathsize="0.700em">+</mo><msub><mi mathsize="0.700em">q</mi><mn mathsize="0.710em">01</mn></msub></mrow><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>q</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>01</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\nicefrac{{(q_{10}+q_{00})}}{{(q_{11}+q_{01})}}\cdot(q_{11}\mu_{11}+q_{01}\mu_{01})</annotation></semantics></math> so that</span></p>
<table id="A2.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex153.m1" class="ltx_Math" alttext="\mathcal{L}=\sum_{i=0}^{1}q_{i0}\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}},\quad\text{ subject to }\tilde{\mu}_{00}=\frac{K-\tilde{\mu}_{10}}{q_{00}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext> subject to </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub></mrow><mo>=</mo><mfrac><mrow><mi>K</mi><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><msub><mi>q</mi><mn>00</mn></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}=\sum_{i=0}^{1}q_{i0}\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}},\quad\text{ subject to }\tilde{\mu}_{00}=\frac{K-\tilde{\mu}_{10}}{q_{00}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p16" class="ltx_para">
<p id="A2.p16.1" class="ltx_p"><span id="A2.p16.1.1" class="ltx_text">Substituting the constraint on <math id="A2.p16.m1" class="ltx_Math" alttext="\tilde{\mu}_{00}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{00}</annotation></semantics></math> in the objective <math id="A2.p16.m2" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> gives us a convex quadratic in <math id="A2.p16.m3" class="ltx_Math" alttext="\tilde{\mu}_{10}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{10}</annotation></semantics></math>, and the solution is obtained by setting the derivative to zero:</span></p>
</div>
<div id="A2.p17" class="ltx_para">
<table id="A2.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex154.m1" class="ltx_math_unparsed" alttext="\displaystyle\tilde{\mu}_{00}=\frac{\frac{K}{\sigma_{10}^{2}\cdot q_{10}}-\frac{\mu_{10}}{\sigma_{10}^{2}}+\frac{\mu_{00}}{\sigma_{00}^{2}}}{\frac{q_{00}}{\sigma_{10}^{2}\cdot q_{10}}+\frac{1}{\sigma_{00}^{2}}},\quad\tilde{\mu}_{10}=\frac{\frac{K}{\sigma_{00}^{2}\cdot q_{00}}-\frac{\mu_{00}}{\sigma_{00}^{2}}+\frac{\mu_{10}}{\sigma_{10}^{2}}}{\frac{q_{10}}{\sigma_{00}^{2}\cdot q_{00}}+\frac{1}{\sigma_{10}^{2}}},\quad\tilde{\mu}_{01}=\mu_{01},\quad\text{ and }\qquad\tilde{\mu}_{11}=\mu_{11}." display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>μ</mi><mo>~</mo></mover><msub><mrow></mrow><mn>00</mn></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mi>K</mi><mrow><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mn>10</mn></msub></mrow></mfrac><mo>−</mo><mfrac><msub><mi>μ</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow><mo>+</mo><mfrac><msub><mi>μ</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mrow><mrow><mfrac><msub><mi>q</mi><mn>00</mn></msub><mrow><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mn>10</mn></msub></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mrow></mfrac></mstyle><mo rspace="1.167em">,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><msub><mrow></mrow><mn>10</mn></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mi>K</mi><mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac><mo>−</mo><mfrac><msub><mi>μ</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mrow><mo>+</mo><mfrac><msub><mi>μ</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow><mrow><mfrac><msub><mi>q</mi><mn>10</mn></msub><mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mn>00</mn></msub></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow></mfrac></mstyle><mo rspace="1.167em">,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><msub><mrow></mrow><mn>01</mn></msub><mo>=</mo><mi>μ</mi><msub><mrow></mrow><mn>01</mn></msub><mo rspace="1.167em">,</mo><mtext> and </mtext><mover accent="true"><mi>μ</mi><mo>~</mo></mover><msub><mrow></mrow><mn>11</mn></msub><mo>=</mo><mi>μ</mi><msub><mrow></mrow><mn>11</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mu}_{00}=\frac{\frac{K}{\sigma_{10}^{2}\cdot q_{10}}-\frac{\mu_{10}}{\sigma_{10}^{2}}+\frac{\mu_{00}}{\sigma_{00}^{2}}}{\frac{q_{00}}{\sigma_{10}^{2}\cdot q_{10}}+\frac{1}{\sigma_{00}^{2}}},\quad\tilde{\mu}_{10}=\frac{\frac{K}{\sigma_{00}^{2}\cdot q_{00}}-\frac{\mu_{00}}{\sigma_{00}^{2}}+\frac{\mu_{10}}{\sigma_{10}^{2}}}{\frac{q_{10}}{\sigma_{00}^{2}\cdot q_{00}}+\frac{1}{\sigma_{10}^{2}}},\quad\tilde{\mu}_{01}=\mu_{01},\quad\text{ and }\qquad\tilde{\mu}_{11}=\mu_{11}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p17.1" class="ltx_p"><span id="A2.p17.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A3" class="ltx_appendix">
