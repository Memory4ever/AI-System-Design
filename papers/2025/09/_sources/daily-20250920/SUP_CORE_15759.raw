<p id="A2.p8.14" class="ltx_p"><span id="A2.p8.14.1" class="ltx_text">and the third part evaluates to</span></p>
<table id="A2.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex137.m1" class="ltx_Math" alttext="\displaystyle\sum_{(i,a)}q_{ia}\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{(i,a)}q_{ia}\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex137.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\sigma_{i0}^{2}}{\sigma^{*}_{i0}(\gamma)^{2}}+\frac{q_{i1}}{2}\log\frac{\sigma_{i1}^{2}}{\sigma^{*}_{i1}(\gamma)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\sigma_{i0}^{2}}{\sigma^{*}_{i0}(\gamma)^{2}}+\frac{q_{i1}}{2}\log\frac{\sigma_{i1}^{2}}{\sigma^{*}_{i1}(\gamma)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex138.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\sigma_{i0}^{2}\left(\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}\right)}{q_{i0}+q_{i1}}+\frac{q_{i1}}{2}\log\frac{\sigma_{i1}^{2}\left(\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}\right)}{\gamma^{2}(q_{i0}+q_{i1})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}\frac{q_{i0}}{2}\log\frac{\sigma_{i0}^{2}\left(\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}\right)}{q_{i0}+q_{i1}}+\frac{q_{i1}}{2}\log\frac{\sigma_{i1}^{2}\left(\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}\right)}{\gamma^{2}(q_{i0}+q_{i1})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
