<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex131.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\frac{\left(\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})\right)^{2}}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\frac{\left(\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})\right)^{2}}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}.</annotation></semantics></math></td>
