<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle=\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.3" class="ltx_p"><span id="A2.p6.3.1" class="ltx_text">using <math id="A2.p6.m5" class="ltx_math_unparsed" alttext="\mathrm{E}\left[\log\tilde{X}\;\big|\;Y=i,A=a\right]=\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo>[</mo><mi>log</mi><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{E}\left[\log\tilde{X}\;\big|\;Y=i,A=a\right]=\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.p6.m6" class="ltx_math_unparsed" alttext="\mathrm{E}\left[(\log\tilde{X})^{2}\;\big|\;Y=i,A=a\right]=\tilde{\mu}_{ia}^{2}+\tilde{\sigma}_{ia}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mi>log</mi><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>]</mo></mrow><mo>=</mo><msubsup><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathrm{E}\left[(\log\tilde{X})^{2}\;\big|\;Y=i,A=a\right]=\tilde{\mu}_{ia}^{2}+\tilde{\sigma}_{ia}^{2}</annotation></semantics></math>. Since we only change group <math id="A2.p6.m7" class="ltx_Math" alttext="A=0" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A=0</annotation></semantics></math>, we want to minimize</span></p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex90.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{i=0}^{1}q_{i0}D_{\mathrm{KL}}\left(\tilde{P}_{i0}||P_{i0}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}q_{i0}D_{\mathrm{KL}}\left(\tilde{P}_{i0}||P_{i0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex91.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.4" class="ltx_p"><span id="A2.p6.4.1" class="ltx_text">as a function of the variables <math id="A2.p6.m8" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.p6.m9" class="ltx_Math" alttext="\tilde{\sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i0}</annotation></semantics></math> subject to the constraints</span></p>
<table id="A2.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex92.m1" class="ltx_Math" alttext="\frac{\mu_{01}-\mu_{11}}{\sigma_{11}}=\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\tilde{\sigma}_{10}}\quad\text{and}\quad\frac{\sigma_{11}}{\sigma_{01}}=\frac{\tilde{\sigma}_{10}}{\tilde{\sigma}_{00}}\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><msub><mi>σ</mi><mn>11</mn></msub></mfrac><mo>=</mo><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mfrac><msub><mi>σ</mi><mn>11</mn></msub><msub><mi>σ</mi><mn>01</mn></msub></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>00</mn></msub></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.497em">,</mo><mrow><mtext>for all </mtext><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mu_{01}-\mu_{11}}{\sigma_{11}}=\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\tilde{\sigma}_{10}}\quad\text{and}\quad\frac{\sigma_{11}}{\sigma_{01}}=\frac{\tilde{\sigma}_{10}}{\tilde{\sigma}_{00}}\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.5" class="ltx_p"><span id="A2.p6.5.1" class="ltx_text">Let’s fix <math id="A2.p6.m10" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> and minimize</span></p>
<table id="A2.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex93.m1" class="ltx_Math" alttext="\mathcal{L}_{\gamma}=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}=\sum_{i=0}^{1}q_{i0}\left(\frac{(\tilde{\mu}_{i0}-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\tilde{\sigma}_{i0}^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\tilde{\sigma}_{i0}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.6" class="ltx_p"><span id="A2.p6.6.1" class="ltx_text">as a function of the variables <math id="A2.p6.m11" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.p6.m12" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math> subject to the following constraints</span></p>
<table id="A2.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex94.m1" class="ltx_Math" alttext="\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\mu_{01}-\mu_{11}}=\frac{\tilde{\sigma}_{10}}{\sigma_{11}}=\frac{\tilde{\sigma}_{00}}{\sigma_{01}}=\gamma\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub><msub><mi>σ</mi><mn>11</mn></msub></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>00</mn></msub><msub><mi>σ</mi><mn>01</mn></msub></mfrac><mo>=</mo><mi>γ</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.497em">,</mo><mrow><mtext>for all </mtext><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\mu_{01}-\mu_{11}}=\frac{\tilde{\sigma}_{10}}{\sigma_{11}}=\frac{\tilde{\sigma}_{00}}{\sigma_{01}}=\gamma\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.7" class="ltx_p"><span id="A2.p6.7.1" class="ltx_text">The objective <math id="A2.p6.m13" class="ltx_Math" alttext="\mathcal{L}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}</annotation></semantics></math> is convex and for a fixed <math id="A2.p6.m14" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math>, the constraints on are linear in <math id="A2.p6.m15" class="ltx_Math" alttext="\tilde{\mu}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{i0}</annotation></semantics></math> and <math id="A2.p6.m16" class="ltx_Math" alttext="\tilde{\sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i0}</annotation></semantics></math>. Let’s denote the optimal solution for a fixed <math id="A2.p6.m17" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> by <math id="A2.p6.m18" class="ltx_Math" alttext="\mu^{*}_{i0}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{i0}(\gamma)</annotation></semantics></math> and <math id="A2.p6.m19" class="ltx_Math" alttext="\sigma^{*}_{i0}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma^{*}_{i0}(\gamma)</annotation></semantics></math>, for <math id="A2.p6.m20" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math>.
For a fixed <math id="A2.p6.m21" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math>, the above constraints fix <math id="A2.p6.m22" class="ltx_Math" alttext="\sigma^{*}_{i0}(\gamma)=\gamma\sigma_{i1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\sigma^{*}_{i0}(\gamma)=\gamma\sigma_{i1}</annotation></semantics></math>, for <math id="A2.p6.m23" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math>, and by plugging in <math id="A2.p6.m24" class="ltx_Math" alttext="\tilde{\mu}_{00}=\tilde{\mu}_{10}+\gamma(\mu_{01}-\mu_{11})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{00}=\tilde{\mu}_{10}+\gamma(\mu_{01}-\mu_{11})</annotation></semantics></math>, we only need to minimize the following convex, quadratic objective in a single variable <math id="A2.p6.m25" class="ltx_Math" alttext="\tilde{\mu}_{10}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><annotation encoding="application/x-tex">\tilde{\mu}_{10}</annotation></semantics></math>,</span></p>
<table id="A2.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex95.m1" class="ltx_Math" alttext="\text{minimize}\quad q_{00}\frac{(\tilde{\mu}_{10}+\gamma(\mu_{01}-\mu_{11})-\mu_{00})^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{(\tilde{\mu}_{10}-\mu_{10})^{2}}{2\sigma_{10}^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mtext>minimize</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{minimize}\quad q_{00}\frac{(\tilde{\mu}_{10}+\gamma(\mu_{01}-\mu_{11})-\mu_{00})^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{(\tilde{\mu}_{10}-\mu_{10})^{2}}{2\sigma_{10}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.8" class="ltx_p"><span id="A2.p6.8.1" class="ltx_text">By equating the derivative to zero, we get the optimal solution as</span></p>
<table id="A2.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex96.m1" class="ltx_Math" alttext="\mu^{*}_{10}(\gamma)=\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\left(q_{00}\frac{\mu_{00}-\gamma(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}}{\sigma_{10}^{2}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mfrac><msub><mi>q</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac><mo>+</mo><mfrac><msub><mi>q</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>μ</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu^{*}_{10}(\gamma)=\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\left(q_{00}\frac{\mu_{00}-\gamma(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}}{\sigma_{10}^{2}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.9" class="ltx_p"><span id="A2.p6.9.1" class="ltx_text">and the optimal value at <math id="A2.p6.m26" class="ltx_Math" alttext="\mu^{*}_{10}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{10}(\gamma)</annotation></semantics></math> is (The min of <math id="A2.p6.m27" class="ltx_Math" alttext="ax^{2}+bx+c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">ax^{2}+bx+c</annotation></semantics></math> occurs at <math id="A2.p6.m28" class="ltx_Math" alttext="x=\dfrac{-b}{2a}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mi>b</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">x=\dfrac{-b}{2a}</annotation></semantics></math> and has value <math id="A2.p6.m29" class="ltx_Math" alttext="c-\dfrac{b^{2}}{4a}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>b</mi><mn>2</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">c-\dfrac{b^{2}}{4a}</annotation></semantics></math>)</span></p>
<table id="A2.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex97.m1" class="ltx_Math" alttext="\displaystyle q_{00}\frac{(\gamma(\mu_{01}-\mu_{11})-\mu_{00})^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}^{2}}{2\sigma_{10}^{2}}-\frac{1}{2}\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\left(q_{00}\frac{\mu_{00}-\gamma(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}}{\sigma_{10}^{2}}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>μ</mi><mn>10</mn><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>μ</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{00}\frac{(\gamma(\mu_{01}-\mu_{11})-\mu_{00})^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}^{2}}{2\sigma_{10}^{2}}-\frac{1}{2}\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\left(q_{00}\frac{\mu_{00}-\gamma(\mu_{01}-\mu_{11})}{\sigma_{00}^{2}}+q_{10}\frac{\mu_{10}}{\sigma_{10}^{2}}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex98.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\frac{q_{00}q_{10}}{\sigma_{00}^{2}\sigma_{10}^{2}}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>10</mn></msub><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(\frac{q_{00}}{\sigma_{00}^{2}}+\frac{q_{10}}{\sigma_{10}^{2}}\right)^{-1}\frac{q_{00}q_{10}}{\sigma_{00}^{2}\sigma_{10}^{2}}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex99.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.10" class="ltx_p"><span id="A2.p6.10.1" class="ltx_text">By plugging in the optimal solution, the minimum value of <math id="A2.p6.m30" class="ltx_Math" alttext="\mathcal{L}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}</annotation></semantics></math> for a fixed <math id="A2.p6.m31" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> is given by</span></p>
<table id="A2.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex100.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}^{*}_{\gamma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\displaystyle\mathcal{L}^{*}_{\gamma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex100.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\mu^{*}_{i0}(\gamma)-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\sigma^{*}_{i0}(\gamma)^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\sigma^{*}_{i0}(\gamma)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>1</mn></munderover></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{1}q_{i0}\left(\frac{(\mu^{*}_{i0}(\gamma)-\mu_{i0})^{2}}{2\sigma_{i0}^{2}}+\frac{\sigma^{*}_{i0}(\gamma)^{2}-\sigma_{i0}^{2}}{2\sigma_{i0}^{2}}+\log\frac{\sigma_{i0}}{\sigma^{*}_{i0}(\gamma)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex101.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex102.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad+q_{00}\frac{\gamma^{2}\sigma_{01}^{2}-\sigma_{00}^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{\gamma^{2}\sigma_{11}^{2}-\sigma_{10}^{2}}{2\sigma_{10}^{2}}+(q_{00}+q_{10})\log\frac{1}{\gamma}+q_{00}\log\frac{\sigma_{00}}{\sigma_{01}}+q_{10}\log\frac{\sigma_{10}}{\sigma_{11}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mrow><mo>−</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo>−</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>γ</mi></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mn>00</mn></msub><msub><mi>σ</mi><mn>01</mn></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mn>10</mn></msub><msub><mi>σ</mi><mn>11</mn></msub></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+q_{00}\frac{\gamma^{2}\sigma_{01}^{2}-\sigma_{00}^{2}}{2\sigma_{00}^{2}}+q_{10}\frac{\gamma^{2}\sigma_{11}^{2}-\sigma_{10}^{2}}{2\sigma_{10}^{2}}+(q_{00}+q_{10})\log\frac{1}{\gamma}+q_{00}\log\frac{\sigma_{00}}{\sigma_{01}}+q_{10}\log\frac{\sigma_{10}}{\sigma_{11}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex103.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}+\frac{q_{00}}{2}\left(\gamma^{2}\frac{\sigma_{01}^{2}}{\sigma_{00}^{2}}-1\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}\left((\mu_{00}-\mu_{10})-\gamma(\mu_{01}-\mu_{11})\right)^{2}+\frac{q_{00}}{2}\left(\gamma^{2}\frac{\sigma_{01}^{2}}{\sigma_{00}^{2}}-1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex104.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+(q_{00}+q_{10})\log\frac{1}{\gamma}+q_{00}\log\frac{\sigma_{00}}{\sigma_{01}}+q_{10}\log\frac{\sigma_{10}}{\sigma_{11}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>γ</mi></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mn>00</mn></msub><msub><mi>σ</mi><mn>01</mn></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mn>10</mn></msub><msub><mi>σ</mi><mn>11</mn></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+(q_{00}+q_{10})\log\frac{1}{\gamma}+q_{00}\log\frac{\sigma_{00}}{\sigma_{01}}+q_{10}\log\frac{\sigma_{10}}{\sigma_{11}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.11" class="ltx_p"><span id="A2.p6.11.1" class="ltx_text">This is a convex objective in <math id="A2.p6.m32" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> (because the second derivative is non-negative) and by equating the derivative to zero, we have that the optimal <math id="A2.p6.m33" class="ltx_Math" alttext="\gamma^{*}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\gamma^{*}</annotation></semantics></math> must satisfy</span></p>
<table id="A2.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex105.m1" class="ltx_Math" alttext="\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}(\mu_{01}-\mu_{11})\left(\gamma^{*}(\mu_{01}-\mu_{11})-(\mu_{00}-\mu_{10})\right)+\gamma^{*}\left(q_{00}\frac{\sigma_{01}^{2}}{\sigma_{00}^{2}}+q_{10}\frac{\sigma_{11}^{2}}{\sigma_{10}^{2}}\right)-\frac{q_{00}+q_{10}}{\gamma^{*}}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msup><mrow><mo>(</mo><mrow><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac><mo>+</mo><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><msup><mi>γ</mi><mo>∗</mo></msup></mfrac></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)^{-1}(\mu_{01}-\mu_{11})\left(\gamma^{*}(\mu_{01}-\mu_{11})-(\mu_{00}-\mu_{10})\right)+\gamma^{*}\left(q_{00}\frac{\sigma_{01}^{2}}{\sigma_{00}^{2}}+q_{10}\frac{\sigma_{11}^{2}}{\sigma_{10}^{2}}\right)-\frac{q_{00}+q_{10}}{\gamma^{*}}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.12" class="ltx_p"><span id="A2.p6.12.1" class="ltx_text">Multiplying with <math id="A2.p6.m34" class="ltx_Math" alttext="\gamma^{*}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma^{*}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)</annotation></semantics></math>, we can write it as a quadratic equation as follows.</span></p>
<table id="A2.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex106.m1" class="ltx_math_unparsed" alttext="\displaystyle\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)\gamma^{*^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><mo>)</mo></mrow><msup><mi>γ</mi><mrow><mo>∗</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)\gamma^{*^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex107.m1" class="ltx_Math" alttext="\displaystyle-(\mu_{01}-\mu_{11})(\mu_{00}-\mu_{10})\gamma^{*}-(q_{00}+q_{10})\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mo>∗</mo></msup></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle-(\mu_{01}-\mu_{11})(\mu_{00}-\mu_{10})\gamma^{*}-(q_{00}+q_{10})\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p6.13" class="ltx_p"><span id="A2.p6.13.1" class="ltx_text">The discriminant of the above quadratic polynomial is non-negative because the leading coefficient is positive and the constant term is negative. So this polynomial has two real roots. Moreover, since the constant term is negative, it cannot have both positive or both negative roots. Its only non-negative root is the optimal solution <math id="A2.p6.m35" class="ltx_Math" alttext="\gamma^{*}\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma^{*}\in\mathbb{R}_{\geq 0}</annotation></semantics></math> we want.</span></p>
<table id="A2.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex108.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad\gamma^{*}=\frac{(\mu_{01}-\mu_{11})(\mu_{00}-\mu_{10})+\sqrt{\Delta}}{2\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)},\text{ where }" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msqrt><mi mathvariant="normal">Δ</mi></msqrt></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo><mtext> where</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad\gamma^{*}=\frac{(\mu_{01}-\mu_{11})(\mu_{00}-\mu_{10})+\sqrt{\Delta}}{2\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)},\text{ where }</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex109.m1" class="ltx_Math" alttext="\displaystyle\Delta=(\mu_{01}-\mu_{11})^{2}(\mu_{00}-\mu_{10})^{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta=(\mu_{01}-\mu_{11})^{2}(\mu_{00}-\mu_{10})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex110.m1" class="ltx_Math" alttext="\displaystyle+4\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)(q_{00}+q_{10})\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mn>00</mn></msub><mo>+</mo><msub><mi>q</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+4\left((\mu_{01}-\mu_{11})^{2}+\sigma_{01}^{2}+\sigma_{11}^{2}+\frac{q_{10}\sigma_{00}^{2}}{q_{00}\sigma_{10}^{2}}\sigma_{11}^{2}+\frac{q_{00}\sigma_{10}^{2}}{q_{10}\sigma_{00}^{2}}\sigma_{01}^{2}\right)(q_{00}+q_{10})\left(\frac{\sigma_{00}^{2}}{q_{00}}+\frac{\sigma_{10}^{2}}{q_{10}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p7" class="ltx_para">
<p id="A2.p7.1" class="ltx_p"><span id="A2.p7.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Proposition B.4</span></span><span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">(Proof of Proposition 4.3 in the main text)
Let <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="(X,Y,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,Y,A)</annotation></semantics></math> denote the features, binary class label, and binary group membership, respectively, of a random data point from any data distribution <math id="A2.Thmtheorem4.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with <math id="A2.Thmtheorem4.p1.m3" class="ltx_Math" alttext="q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>=</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Y</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{ia}=\mathrm{Pr}\left(Y=i,A=a\right)</annotation></semantics></math>, for <math id="A2.Thmtheorem4.p1.m4" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m5" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>, such that <math id="A2.Thmtheorem4.p1.m6" class="ltx_Math" alttext="q_{10}/q_{00}=q_{11}/q_{01}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mn>10</mn></msub><mo>/</mo><msub><mi>q</mi><mn>00</mn></msub></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>11</mn></msub><mo>/</mo><msub><mi>q</mi><mn>01</mn></msub></mrow></mrow><annotation encoding="application/x-tex">q_{10}/q_{00}=q_{11}/q_{01}</annotation></semantics></math>, and let <math id="A2.Thmtheorem4.p1.m7" class="ltx_math_unparsed" alttext="X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X|Y=i,A=a\sim\mathcal{N}(\mu_{ia},\sigma_{ia}^{2})</annotation></semantics></math> be univariate normal distributions, for <math id="A2.Thmtheorem4.p1.m8" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m9" class="ltx_Math" alttext="a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{0,1\}</annotation></semantics></math>. Let <math id="A2.Thmtheorem4.p1.m10" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> denote a distribution obtained by keeping <math id="A2.Thmtheorem4.p1.m11" class="ltx_Math" alttext="(Y,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Y,A)</annotation></semantics></math> unchanged and only changing <math id="A2.Thmtheorem4.p1.m12" class="ltx_math_unparsed" alttext="X|Y=i,A=a" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">X|Y=i,A=a</annotation></semantics></math> to <math id="A2.Thmtheorem4.p1.m13" class="ltx_math_unparsed" alttext="\tilde{X}|Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\sigma}_{ia}^{2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo>=</mo><mi>i</mi><mo>,</mo><mi>A</mi><mo>=</mo><mi>a</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>,</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{X}|Y=i,A=a\sim\mathcal{N}(\tilde{\mu}_{ia},\tilde{\sigma}_{ia}^{2})</annotation></semantics></math>. Then minimizing <math id="A2.Thmtheorem4.p1.m14" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math> as a function of the variables <math id="A2.Thmtheorem4.p1.m15" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m16" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math> subject to the constraints in Proposition 3.2
leads to a non-convex program. Furthermore, let <math id="A2.Thmtheorem4.p1.m17" class="ltx_Math" alttext="\gamma^{*}=\underset{\gamma\in(0,\infty)}{\arg\min}~\mathcal{L}^{*}_{\gamma}" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mo>∗</mo></msup><mo>=</mo><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mrow><mi mathsize="0.700em">γ</mi><mo mathsize="0.700em">∈</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">0</mn><mo>,</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\gamma^{*}=\underset{\gamma\in(0,\infty)}{\arg\min}~\mathcal{L}^{*}_{\gamma}</annotation></semantics></math> for some non-convex function of <math id="A2.Thmtheorem4.p1.m18" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> that is only dependent on the original distribution parameters. Then, all the new distribution parameters <math id="A2.Thmtheorem4.p1.m19" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m20" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math> can be expressed as a function of <math id="A2.Thmtheorem4.p1.m21" class="ltx_Math" alttext="\gamma^{*}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\gamma^{*}</annotation></semantics></math> and the original distribution parameters <math id="A2.Thmtheorem4.p1.m22" class="ltx_Math" alttext="\mu_{ia}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\mu_{ia}</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m23" class="ltx_Math" alttext="\sigma_{ia}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\sigma_{ia}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p8" class="ltx_para">
<p id="A2.p8.1" class="ltx_p"><span id="A2.p8.1.1" class="ltx_text">We consider the following optimization program</span></p>
<table id="A2.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex111.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\left(\tilde{D}||D\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex111.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}D_{\mathrm{KL}}\left(\tilde{P}_{ia}||P_{ia}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex112.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(i,a)}q_{ia}\left(\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.2" class="ltx_p"><span id="A2.p8.2.1" class="ltx_text">as a function of the variables <math id="A2.p8.m1" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.p8.m2" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math> subject to the constraints</span></p>
<table id="A2.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex113.m1" class="ltx_Math" alttext="\frac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\sigma}_{11}}=\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\tilde{\sigma}_{10}}\quad\text{and}\quad\frac{\tilde{\sigma}_{11}}{\tilde{\sigma}_{01}}=\frac{\tilde{\sigma}_{10}}{\tilde{\sigma}_{00}}\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub></mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>11</mn></msub></mfrac><mo>=</mo><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>11</mn></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>01</mn></msub></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>00</mn></msub></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.497em">,</mo><mrow><mtext>for all </mtext><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\sigma}_{11}}=\frac{\tilde{\mu}_{00}-\tilde{\mu}_{10}}{\tilde{\sigma}_{10}}\quad\text{and}\quad\frac{\tilde{\sigma}_{11}}{\tilde{\sigma}_{01}}=\frac{\tilde{\sigma}_{10}}{\tilde{\sigma}_{00}}\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.3" class="ltx_p"><span id="A2.p8.3.1" class="ltx_text">Let’s fix <math id="A2.p8.m3" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> and minimize</span></p>
<table id="A2.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex114.m1" class="ltx_Math" alttext="\mathcal{L}_{\gamma}=\sum_{(i,a)}q_{ia}\left(\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}=\sum_{(i,a)}q_{ia}\left(\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.4" class="ltx_p"><span id="A2.p8.4.1" class="ltx_text">as a function of the variables <math id="A2.p8.m4" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.p8.m5" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math> subject to the following constraints</span></p>
<table id="A2.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex115.m1" class="ltx_Math" alttext="\frac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\mu}_{00}-\tilde{\mu}_{10}}=\frac{\tilde{\sigma}_{11}}{\tilde{\sigma}_{10}}=\frac{\tilde{\sigma}_{01}}{\tilde{\sigma}_{00}}=\gamma\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub></mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>11</mn></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>10</mn></msub></mfrac><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>01</mn></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>00</mn></msub></mfrac><mo>=</mo><mi>γ</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.497em">,</mo><mrow><mtext>for all </mtext><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\mu}_{00}-\tilde{\mu}_{10}}=\frac{\tilde{\sigma}_{11}}{\tilde{\sigma}_{10}}=\frac{\tilde{\sigma}_{01}}{\tilde{\sigma}_{00}}=\gamma\quad\text{and}\quad\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.5" class="ltx_p"><span id="A2.p8.5.1" class="ltx_text">Now the objective <math id="A2.p8.m6" class="ltx_Math" alttext="\mathcal{L}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}</annotation></semantics></math> is convex and for a fixed <math id="A2.p8.m7" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math>, the constraints on are linear in <math id="A2.p8.m8" class="ltx_Math" alttext="\tilde{\mu}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\mu}_{ia}</annotation></semantics></math> and <math id="A2.p8.m9" class="ltx_Math" alttext="\tilde{\sigma}_{ia}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{ia}</annotation></semantics></math>. Let’s denote the optimal solution for a fixed <math id="A2.p8.m10" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> by <math id="A2.p8.m11" class="ltx_Math" alttext="\mu^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{ia}(\gamma)</annotation></semantics></math> and <math id="A2.p8.m12" class="ltx_Math" alttext="\sigma^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma^{*}_{ia}(\gamma)</annotation></semantics></math>, for <math id="A2.p8.m13" class="ltx_Math" alttext="i,a\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>a</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i,a\in\{0,1\}</annotation></semantics></math>. To find this, we can split the above objective into parts that can be optimized separately as follows.</span></p>
<table id="A2.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A2.Ex116.1.1" class="ltx_text ltx_markedasmath">minimize</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex116.m2" class="ltx_Math" alttext="\displaystyle\quad\sum_{(i,a)}q_{ia}\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}\quad\text{subject to}\quad\tilde{\mu}_{01}-\tilde{\mu}_{11}=\gamma(\tilde{\mu}_{00}-\tilde{\mu}_{10}),\quad\text{and}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>subject to</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub></mrow><mo>=</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sum_{(i,a)}q_{ia}\frac{(\tilde{\mu}_{ia}-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}\quad\text{subject to}\quad\tilde{\mu}_{01}-\tilde{\mu}_{11}=\gamma(\tilde{\mu}_{00}-\tilde{\mu}_{10}),\quad\text{and}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A2.Ex117.1.1" class="ltx_text ltx_markedasmath">minimize</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex117.m2" class="ltx_Math" alttext="\displaystyle\quad\sum_{(i,a)}q_{ia}\left(\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)\quad\text{subject to}\quad\tilde{\sigma}_{i1}=\gamma\tilde{\sigma}_{i0},\text{and}~\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>subject to</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow></mrow><mo>,</mo><mrow><mrow><mtext>and</mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.497em">,</mo><mrow><mtext>for all </mtext><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sum_{(i,a)}q_{ia}\left(\frac{\tilde{\sigma}_{ia}^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\tilde{\sigma}_{ia}}\right)\quad\text{subject to}\quad\tilde{\sigma}_{i1}=\gamma\tilde{\sigma}_{i0},\text{and}~\tilde{\sigma}_{ia}\geq 0,~\text{for all $(i,a)$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.6" class="ltx_p"><span id="A2.p8.6.1" class="ltx_text">For each <math id="A2.p8.m14" class="ltx_Math" alttext="i\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1\}</annotation></semantics></math>, by substituting <math id="A2.p8.m15" class="ltx_Math" alttext="\tilde{\sigma}_{i1}=\gamma\tilde{\sigma}_{i0}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\sigma}_{i1}=\gamma\tilde{\sigma}_{i0}</annotation></semantics></math>, we need to optimize a function in only one variable <math id="A2.p8.m16" class="ltx_Math" alttext="\tilde{\sigma}_{i0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i0}</annotation></semantics></math>. The optimal solutions <math id="A2.p8.m17" class="ltx_Math" alttext="\sigma^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma^{*}_{ia}(\gamma)</annotation></semantics></math> turn out to be</span></p>
<table id="A2.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex118.m1" class="ltx_Math" alttext="\sigma^{*}_{i0}(\gamma)=\sqrt{\frac{q_{i0}+q_{i1}}{\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}}}\quad\text{and}\quad\sigma^{*}_{i1}(\gamma)=\gamma\sqrt{\frac{q_{i0}+q_{i1}}{\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}}},\quad\text{for $i\in\{0,1\}$}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mfrac></msqrt></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo>+</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow></mfrac></msqrt></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>for </mtext><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sigma^{*}_{i0}(\gamma)=\sqrt{\frac{q_{i0}+q_{i1}}{\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}}}\quad\text{and}\quad\sigma^{*}_{i1}(\gamma)=\gamma\sqrt{\frac{q_{i0}+q_{i1}}{\dfrac{q_{i0}}{\sigma_{i0}^{2}}+\dfrac{q_{i1}\gamma^{2}}{\sigma_{i1}^{2}}}},\quad\text{for $i\in\{0,1\}$},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.7" class="ltx_p"><span id="A2.p8.7.1" class="ltx_text">Now let’s find the optimal solutions <math id="A2.p8.m18" class="ltx_Math" alttext="\mu^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{ia}(\gamma)</annotation></semantics></math>. The gradient of the objective must be parallel to the linear constraint, so</span></p>
<table id="A2.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex119.m1" class="ltx_Math" alttext="\frac{q_{00}(\mu^{*}_{00}(\gamma)-\mu_{00})}{\sigma_{00}^{2}}=-\gamma\lambda,~\frac{q_{01}(\mu^{*}_{01}(\gamma)-\mu_{01})}{\sigma_{01}^{2}}=\lambda,~\frac{q_{10}(\mu^{*}_{10}(\gamma)-\mu_{10})}{\sigma_{10}^{2}}=\gamma\lambda,~\frac{q_{11}(\mu^{*}_{11}(\gamma)-\mu_{11})}{\sigma_{11}^{2}}=-\lambda," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mi>q</mi><mn>00</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mfrac><mo>=</mo><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mfrac><mrow><msub><mi>q</mi><mn>01</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mn>01</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mfrac><mo>=</mo><mi>λ</mi></mrow><mo rspace="0.497em">,</mo><mrow><mfrac><mrow><msub><mi>q</mi><mn>10</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mfrac><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mfrac><mrow><msub><mi>q</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mn>11</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mfrac><mo>=</mo><mrow><mo>−</mo><mi>λ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{q_{00}(\mu^{*}_{00}(\gamma)-\mu_{00})}{\sigma_{00}^{2}}=-\gamma\lambda,~\frac{q_{01}(\mu^{*}_{01}(\gamma)-\mu_{01})}{\sigma_{01}^{2}}=\lambda,~\frac{q_{10}(\mu^{*}_{10}(\gamma)-\mu_{10})}{\sigma_{10}^{2}}=\gamma\lambda,~\frac{q_{11}(\mu^{*}_{11}(\gamma)-\mu_{11})}{\sigma_{11}^{2}}=-\lambda,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.8" class="ltx_p"><span id="A2.p8.8.1" class="ltx_text">for some <math id="A2.p8.m19" class="ltx_Math" alttext="\lambda\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{R}</annotation></semantics></math>, which gives</span></p>
<table id="A2.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex120.m1" class="ltx_Math" alttext="\mu^{*}_{00}(\gamma)=-\gamma\lambda\frac{\sigma_{00}^{2}}{q_{00}}+\mu_{00},\quad\mu^{*}_{01}(\gamma)=\lambda\frac{\sigma_{01}^{2}}{q_{01}}+\mu_{01},\quad\mu^{*}_{10}(\gamma)=\gamma\lambda\frac{\sigma_{10}^{2}}{q_{10}}+\mu_{10},\quad\mu^{*}_{11}(\gamma)=-\lambda\frac{\sigma_{11}^{2}}{q_{11}}+\mu_{11}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mrow></mrow><mo>+</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>μ</mi><mn>01</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mrow><mo>+</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mrow><mo>+</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>μ</mi><mn>11</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mrow></mrow><mo>+</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mu^{*}_{00}(\gamma)=-\gamma\lambda\frac{\sigma_{00}^{2}}{q_{00}}+\mu_{00},\quad\mu^{*}_{01}(\gamma)=\lambda\frac{\sigma_{01}^{2}}{q_{01}}+\mu_{01},\quad\mu^{*}_{10}(\gamma)=\gamma\lambda\frac{\sigma_{10}^{2}}{q_{10}}+\mu_{10},\quad\mu^{*}_{11}(\gamma)=-\lambda\frac{\sigma_{11}^{2}}{q_{11}}+\mu_{11}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.9" class="ltx_p"><span id="A2.p8.9.1" class="ltx_text">Since <math id="A2.p8.m20" class="ltx_Math" alttext="\mu^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{ia}(\gamma)</annotation></semantics></math> satisfies the constraint <math id="A2.p8.m21" class="ltx_Math" alttext="\dfrac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\mu}_{00}-\tilde{\mu}_{10}}=\gamma" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>01</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>11</mn></msub></mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>00</mn></msub><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mn>10</mn></msub></mrow></mfrac></mstyle><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\dfrac{\tilde{\mu}_{01}-\tilde{\mu}_{11}}{\tilde{\mu}_{00}-\tilde{\mu}_{10}}=\gamma</annotation></semantics></math>, we have</span></p>
<table id="A2.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex121.m1" class="ltx_Math" alttext="\frac{\lambda\dfrac{\sigma_{01}^{2}}{q_{01}}+\mu_{01}+\lambda\dfrac{\sigma_{11}^{2}}{q_{11}}-\mu_{11}}{-\gamma\lambda\dfrac{\sigma_{00}^{2}}{q_{00}}+\mu_{00}-\gamma\lambda\dfrac{\sigma_{10}^{2}}{q_{10}}-\mu_{10}}=\gamma,\quad\text{and hence},\quad\lambda=\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle></mrow><mo>+</mo><msub><mi>μ</mi><mn>01</mn></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow></mfrac><mo>=</mo><mi>γ</mi></mrow><mo rspace="1.167em">,</mo><mtext>and hence</mtext><mo rspace="1.167em">,</mo><mrow><mi>λ</mi><mo>=</mo><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\lambda\dfrac{\sigma_{01}^{2}}{q_{01}}+\mu_{01}+\lambda\dfrac{\sigma_{11}^{2}}{q_{11}}-\mu_{11}}{-\gamma\lambda\dfrac{\sigma_{00}^{2}}{q_{00}}+\mu_{00}-\gamma\lambda\dfrac{\sigma_{10}^{2}}{q_{10}}-\mu_{10}}=\gamma,\quad\text{and hence},\quad\lambda=\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.10" class="ltx_p"><span id="A2.p8.10.1" class="ltx_text">Thus, we can express <math id="A2.p8.m22" class="ltx_Math" alttext="\mu^{*}_{ia}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{*}_{ia}(\gamma)</annotation></semantics></math> as</span></p>
<table id="A2.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex122.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{00}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>00</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{00}(\gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex122.m2" class="ltx_Math" alttext="\displaystyle=-\gamma\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{00}^{2}}{q_{00}}+\mu_{00}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><msub><mi>μ</mi><mn>00</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\gamma\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{00}^{2}}{q_{00}}+\mu_{00}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex123.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{01}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>01</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{01}(\gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex123.m2" class="ltx_Math" alttext="\displaystyle=\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{01}^{2}}{q_{01}}+\mu_{01}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle></mrow><mo>+</mo><msub><mi>μ</mi><mn>01</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{01}^{2}}{q_{01}}+\mu_{01}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex124.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{10}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>10</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{10}(\gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex124.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{10}^{2}}{q_{10}}+\mu_{10}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>+</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{10}^{2}}{q_{10}}+\mu_{10}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex125.m1" class="ltx_Math" alttext="\displaystyle\mu^{*}_{11}(\gamma)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mn>11</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{*}_{11}(\gamma)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex125.m2" class="ltx_Math" alttext="\displaystyle=-\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{11}^{2}}{q_{11}}+\mu_{11}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>00</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>10</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>01</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>01</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>00</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>10</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup><msub><mi>q</mi><mn>11</mn></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><msub><mi>μ</mi><mn>11</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{\gamma(\mu_{00}-\mu_{10})-(\mu_{01}-\mu_{11})}{\dfrac{\sigma_{01}^{2}}{q_{01}}+\dfrac{\sigma_{11}^{2}}{q_{11}}+\gamma^{2}\left(\dfrac{\sigma_{00}^{2}}{q_{00}}+\dfrac{\sigma_{10}^{2}}{q_{10}}\right)}\frac{\sigma_{11}^{2}}{q_{11}}+\mu_{11}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.11" class="ltx_p"><span id="A2.p8.11.1" class="ltx_text">Thus, the optimal value of <math id="A2.p8.m23" class="ltx_Math" alttext="\mathcal{L}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}</annotation></semantics></math> for a fixed <math id="A2.p8.m24" class="ltx_Math" alttext="\gamma\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}_{\geq 0}</annotation></semantics></math> is given by</span></p>
<table id="A2.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex126.m1" class="ltx_Math" alttext="\mathcal{L}^{*}_{\gamma}=\sum_{(i,a)}q_{ia}\left(\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi><mo>∗</mo></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msub><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mrow><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}^{*}_{\gamma}=\sum_{(i,a)}q_{ia}\left(\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}+\frac{\sigma^{*}_{ia}(\gamma)^{2}-\sigma_{ia}^{2}}{2\sigma_{ia}^{2}}+\log\frac{\sigma_{ia}}{\sigma^{*}_{ia}(\gamma)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p8.12" class="ltx_p"><span id="A2.p8.12.1" class="ltx_text">Dividing the above expression into three parts, the first part evaluates to</span></p>
<table id="A2.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex127.m1" class="ltx_Math" alttext="\displaystyle\sum_{(i,a)}q_{ia}\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{(i,a)}q_{ia}\frac{(\mu^{*}_{ia}(\gamma)-\mu_{ia})^{2}}{2\sigma_{ia}^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex127.m2" class="ltx_Math" alttext="\displaystyle=\frac{q_{00}}{2\sigma_{00}^{2}}\frac{\gamma^{2}\lambda^{2}\sigma_{00}^{4}}{q_{00}^{2}}+\frac{q_{01}}{2\sigma_{01}^{2}}\frac{\lambda^{2}\sigma_{01}^{4}}{q_{01}^{2}}+\frac{q_{10}}{2\sigma_{10}^{2}}\frac{\gamma^{2}\lambda^{2}\sigma_{10}^{4}}{q_{10}^{2}}+\frac{q_{11}}{2\sigma_{11}^{2}}\frac{\lambda^{2}\sigma_{11}^{4}}{q_{11}^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>00</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>00</mn><mn>4</mn></msubsup></mrow><msubsup><mi>q</mi><mn>00</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>01</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>01</mn><mn>4</mn></msubsup></mrow><msubsup><mi>q</mi><mn>01</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>10</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>10</mn><mn>4</mn></msubsup></mrow><msubsup><mi>q</mi><mn>10</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mn>11</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mn>11</mn><mn>4</mn></msubsup></mrow><msubsup><mi>q</mi><mn>11</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{q_{00}}{2\sigma_{00}^{2}}\frac{\gamma^{2}\lambda^{2}\sigma_{00}^{4}}{q_{00}^{2}}+\frac{q_{01}}{2\sigma_{01}^{2}}\frac{\lambda^{2}\sigma_{01}^{4}}{q_{01}^{2}}+\frac{q_{10}}{2\sigma_{10}^{2}}\frac{\gamma^{2}\lambda^{2}\sigma_{10}^{4}}{q_{10}^{2}}+\frac{q_{11}}{2\sigma_{11}^{2}}\frac{\lambda^{2}\sigma_{11}^{4}}{q_{11}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
