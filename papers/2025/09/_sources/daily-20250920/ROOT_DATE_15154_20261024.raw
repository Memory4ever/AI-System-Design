{"data":{"id":"10.48550/arxiv.2509.15154","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.15154","prefix":"10.48550","suffix":"arxiv.2509.15154","identifiers":[{"identifier":"2509.15154","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.15154"}],"creators":[{"name":"Li, Gengliang","nameType":"Personal","givenName":"Gengliang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Rongyu","nameType":"Personal","givenName":"Rongyu","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Bin","nameType":"Personal","givenName":"Bin","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Linlin","nameType":"Personal","givenName":"Linlin","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Guodong","nameType":"Personal","givenName":"Guodong","familyName":"Ding","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedFact-R1: Towards Factual Medical Reasoning via Pseudo-Label Augmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T16:59:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:51:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Ensuring factual consistency and reliable reasoning remains a critical challenge for medical vision-language models. We introduce MEDFACT-R1, a two-stage framework that integrates external knowledge grounding with reinforcement learning to improve the factual medical reasoning. The first stage uses pseudo-label supervised fine-tuning (SFT) to incorporate external factual expertise; while the second stage applies Group Relative Policy Optimization (GRPO) with four tailored factual reward signals to encourage self-consistent reasoning. Across three public medical QA benchmarks, MEDFACT-R1 delivers up to 22.5% absolute improvement in factual accuracy over previous state-of-the-art methods. Ablation studies highlight the necessity of pseudo-label SFT cold start and validate the contribution of each GRPO reward, underscoring the synergy between knowledge grounding and RL-driven reasoning for trustworthy medical AI. Codes are released at https://github.com/Garfieldgengliang/MEDFACT-R1.","descriptionType":"Abstract"},{"description":"Tech report","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.15154","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:49:03.000Z","registered":"2025-09-19T01:49:04.000Z","published":"2025","updated":"2025-09-19T01:49:04.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.15154","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}