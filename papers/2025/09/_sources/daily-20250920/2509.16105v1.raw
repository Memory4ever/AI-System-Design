<td id="S5.F4.5.1.9.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.F4.5.1.9.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#BFBFBF;">64.9<span id="S5.F4.5.1.9.2.1.1" class="ltx_text ltx_font_medium">/</span>57.9</span></td>
