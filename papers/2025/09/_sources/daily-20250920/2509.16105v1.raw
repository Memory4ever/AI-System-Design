<td id="S5.F7.fig2.3.1.4.6" class="ltx_td ltx_align_center ltx_border_t">0.76 <math id="S5.F7.m15" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
