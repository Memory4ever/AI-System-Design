<td id="A1.T3.5.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">348.4</td>
<td id="A1.T3.5.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.31</td>
<td id="A1.T3.5.1.3.4" class="ltx_td ltx_align_center ltx_border_t">108.00</td></tr>
