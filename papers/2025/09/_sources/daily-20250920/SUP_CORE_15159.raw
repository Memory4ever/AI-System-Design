<tr id="A1.T8.2.1.1" class="ltx_tr">
<td id="A1.T8.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt">Similarity Scores</td>
<td id="A1.T8.2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt">
<table id="A1.T8.2.1.1.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T8.2.1.1.2.1.1" class="ltx_tr">
<td id="A1.T8.2.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_right">ASR (%) <math id="A1.T8.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
</table></td>
<td id="A1.T8.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt">
<table id="A1.T8.2.1.1.3.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T8.2.1.1.3.1.1" class="ltx_tr">
<td id="A1.T8.2.1.1.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_right">ACA (%) <math id="A1.T8.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
</table></td></tr>
<tr id="A1.T8.2.1.2" class="ltx_tr">
<td id="A1.T8.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">cosine</td>
<td id="A1.T8.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">100.0</td>
<td id="A1.T8.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">33.3</td></tr>
<tr id="A1.T8.2.1.3" class="ltx_tr">
<td id="A1.T8.2.1.3.1" class="ltx_td ltx_align_left ltx_border_bb">dot product</td>
