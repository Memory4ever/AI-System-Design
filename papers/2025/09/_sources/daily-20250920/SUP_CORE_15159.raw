</table></td></tr>
<tr id="S5.T3.2.1.2" class="ltx_tr">
<td id="S5.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Corpus Poisoning</td>
<td id="S5.T3.2.1.2.2" class="ltx_td ltx_align_right ltx_border_t">0</td>
<td id="S5.T3.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">0.446</td>
<td id="S5.T3.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t">12.69</td></tr>
<tr id="S5.T3.2.1.3" class="ltx_tr">
<td id="S5.T3.2.1.3.1" class="ltx_td ltx_align_left">Prompt Injection Attack</td>
<td id="S5.T3.2.1.3.2" class="ltx_td ltx_align_right">0</td>
<td id="S5.T3.2.1.3.3" class="ltx_td ltx_align_right">0.446</td>
<td id="S5.T3.2.1.3.4" class="ltx_td ltx_nopad_r ltx_align_right">57.13</td></tr>
<tr id="S5.T3.2.1.4" class="ltx_tr">
