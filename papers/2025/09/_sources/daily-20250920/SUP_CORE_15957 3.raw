</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T1.5.2" class="ltx_tr">
<td id="S2.T1.5.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S2.T1.5.2.1.1" class="ltx_text ltx_font_typewriter">patient_basic_info</span></td>
<td id="S2.T1.5.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S2.T1.5.2.2.1" class="ltx_text ltx_font_typewriter">patient_id</span></td>
<td id="S2.T1.5.2.3" class="ltx_td ltx_align_left ltx_border_t">
