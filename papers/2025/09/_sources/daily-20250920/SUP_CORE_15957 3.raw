<tr id="S2.T1.5.3" class="ltx_tr">
<td id="S2.T1.5.3.1" class="ltx_td ltx_align_left"><span id="S2.T1.5.3.1.1" class="ltx_text ltx_font_typewriter">lab_results</span></td>
<td id="S2.T1.5.3.2" class="ltx_td ltx_align_left"><span id="S2.T1.5.3.2.1" class="ltx_text ltx_font_typewriter">patient_id</span>, <span id="S2.T1.5.3.2.2" class="ltx_text ltx_font_typewriter">start_date</span>, <span id="S2.T1.5.3.2.3" class="ltx_text ltx_font_typewriter">end_date</span></td>
<td id="S2.T1.5.3.3" class="ltx_td ltx_align_left">
