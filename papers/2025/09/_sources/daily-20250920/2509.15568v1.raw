<td id="S4.T1.3.4.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.4.9.1" class="ltx_text" style="font-size:90%;">0</span></td>
<td id="S4.T1.3.4.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.4.10.1" class="ltx_text" style="font-size:90%;">0</span></td></tr>
