<span id="id2.1.2.1.2" class="ltx_tr">
<span id="id2.1.2.1.2.1" class="ltx_td ltx_align_center"><span id="id2.1.2.1.2.1.1" class="ltx_text ltx_font_italic">Sapienza University of Rome</span></span></span>
