<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.4.2.1" class="ltx_text" style="font-size:90%;">46.64</span></td>
<td id="S4.T1.4.1.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.4.3.1" class="ltx_text" style="font-size:90%;">30.87</span></td>
<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.4.4.1" class="ltx_text" style="font-size:90%;">0.75</span></td>
