<td id="S4.T1.4.1.3.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.3.2.1" class="ltx_text" style="font-size:90%;">39.23</span></td>
<td id="S4.T1.4.1.3.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.3.3.1" class="ltx_text" style="font-size:90%;">24.69</span></td>
<td id="S4.T1.4.1.3.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T1.4.1.3.4.1" class="ltx_text" style="font-size:90%;">0.76</span></td>
