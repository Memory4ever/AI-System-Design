<td id="S4.T2.4.1.28.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:-0.45pt 4.0pt;"><span id="S4.T2.4.1.28.4.1" class="ltx_text" style="font-size:90%;">0.51</span></td>
