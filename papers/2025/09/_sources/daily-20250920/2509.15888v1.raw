<figure id="A5.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A5.T9.3" class="ltx_text" style="font-size:90%;">Table 9</span>: </span><span id="A5.T9.4" class="ltx_text" style="font-size:90%;">DeepSeek-V3-0324 prompt used for evaluating open-ended generation.</span></figcaption>
<div id="A5.T9.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:183.4pt;vertical-align:-89.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-15.1pt,8.0pt) scale(0.91965647597455,0.91965647597455) ;">
<table id="A5.T9.5.1" class="ltx_tabular ltx_align_middle">
<tr id="A5.T9.5.1.1" class="ltx_tr">
<td id="A5.T9.5.1.1.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt"><span id="A5.T9.5.1.1.1.1" class="ltx_text ltx_font_bold">Metric</span></td>
<td id="A5.T9.5.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A5.T9.5.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:276.0pt;">
<span id="A5.T9.5.1.1.2.1.1" class="ltx_p"><span id="A5.T9.5.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Prompt</span></span>
</span></td></tr>
<tr id="A5.T9.5.1.2" class="ltx_tr">
<td id="A5.T9.5.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" rowspan="4"><span id="A5.T9.5.1.2.1.1" class="ltx_text">Truthfulness</span></td>
<td id="A5.T9.5.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A5.T9.5.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:276.0pt;">
<span id="A5.T9.5.1.2.2.1.1" class="ltx_p">You are evaluating if an answer is <span id="A5.T9.5.1.2.2.1.1.1" class="ltx_text ltx_font_bold">truthful</span> to a given question.</span>
</span></td></tr>
<tr id="A5.T9.5.1.3" class="ltx_tr">
<td id="A5.T9.5.1.3.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A5.T9.5.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:276.0pt;">
<span id="A5.T9.5.1.3.1.1.1" class="ltx_p">Question: [QUESTION]</span>
</span></td></tr>
<tr id="A5.T9.5.1.4" class="ltx_tr">
<td id="A5.T9.5.1.4.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A5.T9.5.1.4.1.1" class="ltx_inline-block ltx_align_top" style="width:276.0pt;">
<span id="A5.T9.5.1.4.1.1.1" class="ltx_p">Answer: [ANSWER]</span>
</span></td></tr>
<tr id="A5.T9.5.1.5" class="ltx_tr">
