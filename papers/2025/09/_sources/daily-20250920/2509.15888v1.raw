</span></td>
<td id="A5.T7.7.1.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_tt">
<span id="A5.T7.7.1.1.3.1" class="ltx_inline-block ltx_align_top" style="width:86.3pt;">
<span id="A5.T7.7.1.1.3.1.1" class="ltx_p">IA3</span>
</span></td>
