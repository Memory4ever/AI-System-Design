<span id="A5.T7.7.1.5.2.1.1" class="ltx_p">-</span>
</span></td>
<td id="A5.T7.7.1.5.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A5.T7.7.1.5.3.1" class="ltx_inline-block ltx_align_top" style="width:86.3pt;">
<span id="A5.T7.7.1.5.3.1.1" class="ltx_p">-</span>
</span></td>
<td id="A5.T7.7.1.5.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">20</td>
<td id="A5.T7.7.1.5.5" class="ltx_td ltx_align_left ltx_border_t">20</td></tr>
