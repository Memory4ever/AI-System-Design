<th id="A6.T6.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="A6.T6.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">XSum</span></th>
