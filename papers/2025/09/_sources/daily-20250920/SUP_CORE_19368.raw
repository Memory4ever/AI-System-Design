<th id="A6.T6.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">SR</span></th>
<th id="A6.T6.5.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">AR</span></th>
<th id="A6.T6.5.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GS</span></th>
<th id="A6.T6.5.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">SR</span></th>
<th id="A6.T6.5.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">AR</span></th>
<th id="A6.T6.5.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A6.T6.5.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GS</span></th>
