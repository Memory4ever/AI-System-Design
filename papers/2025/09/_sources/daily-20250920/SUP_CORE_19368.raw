</thead>
<tbody class="ltx_tbody">
<tr id="A6.T6.5.3" class="ltx_tr">
<th id="A6.T6.5.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="A6.T6.5.3.1.1" class="ltx_text" style="font-size:90%;">V 7B Norm</span></th>
