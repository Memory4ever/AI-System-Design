          <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="i\leftarrow 0,1,2,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\leftarrow 0,1,2,\dots,T-1</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            Recv_check_token_from_last_pipeline(<math id="alg1.l3.m1" class="ltx_Math" alttext="\text{GPU}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{0}</annotation></semantics></math>, <math id="alg1.l3.m2" class="ltx_Math" alttext="\text{GPU}_{N-1}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\text{GPU}_{N-1}</annotation></semantics></math>, <math id="alg1.l3.m3" class="ltx_Math" alttext="t_{y}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>y</mi></msub><annotation encoding="application/x-tex">t_{y}</annotation></semantics></math>)

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <span id="alg1.l4.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="t_{y}\neq t^{\prime}_{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>y</mi></msub><mo>≠</mo><msubsup><mi>t</mi><mi>y</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">t_{y}\neq t^{\prime}_{y}</annotation></semantics></math> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
             <math id="alg1.l5.m1" class="ltx_Math" alttext="i\leftarrow y+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\leftarrow y+1</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            <span id="alg1.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            prev_has_early_exited <math id="alg1.l7.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> False

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
            Run <math id="alg1.l8.m1" class="ltx_Math" alttext="M_{0}(x|x_{0,1,2,\dots,i-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{0}(x|x_{0,1,2,\dots,i-1})</annotation></semantics></math> in <math id="alg1.l8.m2" class="ltx_Math" alttext="\text{GPU}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{0}</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
            Send_Activation_to_next_pipeline(<math id="alg1.l9.m1" class="ltx_Math" alttext="\text{GPU}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{0}</annotation></semantics></math>, <math id="alg1.l9.m2" class="ltx_Math" alttext="\text{GPU}_{1}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>1</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{1}</annotation></semantics></math>, <math id="alg1.l9.m3" class="ltx_Math" alttext="A_{i}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>i</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">A_{i}^{0}</annotation></semantics></math>)

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
            wait_until_send_token()

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
            <span id="alg1.l11.3" class="ltx_text ltx_font_bold">if</span> reach_early_exit_point(<math id="alg1.l11.m1" class="ltx_Math" alttext="\text{GPU}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{0}</annotation></semantics></math>) <span id="alg1.l11.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l12" class="ltx_listingline">
