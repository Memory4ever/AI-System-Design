</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
             Sample <math id="alg1.l13.m1" class="ltx_Math" alttext="t^{\prime}_{i+1}" display="inline" intent=":literal"><semantics><msubsup><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">t^{\prime}_{i+1}</annotation></semantics></math> from <math id="alg1.l13.m2" class="ltx_Math" alttext="M_{0}(x|x_{0,1,2,\dots,i-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{0}(x|x_{0,1,2,\dots,i-1})</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
             Continue

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
            <span id="alg1.l15.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
            <span id="alg1.l16.3" class="ltx_text ltx_font_bold">if</span> not has_early_exited <span id="alg1.l16.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
             Recv_token_from_other_pipeline(<math id="alg1.l17.m1" class="ltx_Math" alttext="\text{GPU}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\text{GPU}_{0}</annotation></semantics></math>, <math id="alg1.l17.m2" class="ltx_Math" alttext="\text{GPU}_{x}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mi>x</mi></msub><annotation encoding="application/x-tex">\text{GPU}_{x}</annotation></semantics></math>, <math id="alg1.l17.m3" class="ltx_Math" alttext="t^{\prime}_{i+1}" display="inline" intent=":literal"><semantics><msubsup><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">t^{\prime}_{i+1}</annotation></semantics></math>)

</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
             wait_until_recv_token()

</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
             Continue

</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
            <span id="alg1.l20.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
            <span id="alg1.l21.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l21.m1" class="ltx_Math" alttext="j\leftarrow 1,2,3,\dots,N-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j\leftarrow 1,2,3,\dots,N-1</annotation></semantics></math> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
             Recv_Activation_from_prev_pipeline(<math id="alg1.l22.m1" class="ltx_Math" alttext="\text{GPU}_{j}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mi>j</mi></msub><annotation encoding="application/x-tex">\text{GPU}_{j}</annotation></semantics></math>, <math id="alg1.l22.m2" class="ltx_Math" alttext="\text{GPU}_{j-1}" display="inline" intent=":literal"><semantics><msub><mtext>GPU</mtext><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\text{GPU}_{j-1}</annotation></semantics></math>, <math id="alg1.l22.m3" class="ltx_Math" alttext="A_{i}^{j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>i</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">A_{i}^{j-1}</annotation></semantics></math>)

