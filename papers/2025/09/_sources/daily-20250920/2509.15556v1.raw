<td id="A6.T4.4.1.1.11" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T4.4.1.1.11.1" class="ltx_text ltx_font_bold">TE</span></td>
<td id="A6.T4.4.1.1.12" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt"><span id="A6.T4.4.1.1.12.1" class="ltx_text ltx_font_bold">ZH</span></td></tr>
<tr id="A6.T4.4.1.2" class="ltx_tr">
<td id="A6.T4.4.1.2.1" class="ltx_td ltx_align_left ltx_border_t" colspan="12"><span id="A6.T4.4.1.2.1.1" class="ltx_text ltx_font_bold">Open Source Multilingual LLMs</span></td></tr>
<tr id="A6.T4.4.1.3" class="ltx_tr">
<td id="A6.T4.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t">LLaMA-3.2</td>
<td id="A6.T4.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t">52.99</td>
<td id="A6.T4.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t">73.18</td>
<td id="A6.T4.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">63.20</td>
<td id="A6.T4.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">51.77</td>
