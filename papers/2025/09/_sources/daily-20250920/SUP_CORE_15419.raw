<td id="S4.T1.2.4.3" class="ltx_td ltx_align_center">12</td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.4.4.1" class="ltx_text ltx_font_bold">0.36</span>25</td>
<td id="S4.T1.2.4.5" class="ltx_td ltx_align_center">0.7315</td>
