<td id="S4.T1.2.3.5" class="ltx_td ltx_align_center">0.7238</td>
<td id="S4.T1.2.3.6" class="ltx_td ltx_align_center">0.3429</td>
<td id="S4.T1.2.3.7" class="ltx_td ltx_align_center">0.1029</td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
