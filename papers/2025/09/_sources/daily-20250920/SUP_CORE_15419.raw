<tr id="S4.T1.2.5" class="ltx_tr">
<td id="S4.T1.2.5.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.5.1.1" class="ltx_text ltx_font_italic">xsum</span></td>
