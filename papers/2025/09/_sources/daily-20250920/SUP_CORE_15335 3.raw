<span id="S5.T2.2.1.1.1.1.1.6.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-1pt 2.0pt;"><math id="S5.T2.m10" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></span></span>
