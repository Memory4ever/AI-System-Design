<span id="S5.T2.2.1.1.1.1.1.26.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-1pt 2.0pt;"><math id="S5.T2.m50" class="ltx_Math" alttext="\ast" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">∗</mo><annotation encoding="application/x-tex">\ast</annotation></semantics></math></span></span>
