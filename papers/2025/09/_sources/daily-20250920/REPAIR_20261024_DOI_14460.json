{"data":{"id":"10.48550/arxiv.2509.14460","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14460","prefix":"10.48550","suffix":"arxiv.2509.14460","identifiers":[{"identifier":"2509.14460","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14460"}],"creators":[{"name":"Ajith, Abhiroop","nameType":"Personal","givenName":"Abhiroop","familyName":"Ajith","affiliation":[],"nameIdentifiers":[]},{"name":"Chamzas, Constantinos","nameType":"Personal","givenName":"Constantinos","familyName":"Chamzas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Discrete Abstractions for Visual Rearrangement Tasks Using Vision-Guided Graph Coloring"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T22:25:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:09:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-20T11:10:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-23T00:45:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Learning abstractions directly from data is a core challenge in robotics. Humans naturally operate at an abstract level, reasoning over high-level subgoals while delegating execution to low-level motor skills -- an ability that enables efficient problem solving in complex environments. In robotics, abstractions and hierarchical reasoning have long been central to planning, yet they are typically hand-engineered, demanding significant human effort and limiting scalability. Automating the discovery of useful abstractions directly from visual data would make planning frameworks more scalable and more applicable to real-world robotic domains. In this work, we focus on rearrangement tasks where the state is represented with raw images, and propose a method to induce discrete, graph-structured abstractions by combining structural constraints with an attention-guided visual distance. Our approach leverages the inherent bipartite structure of rearrangement problems, integrating structural constraints and visual embeddings into a unified framework. This enables the autonomous discovery of abstractions from vision alone, which can subsequently support high-level planning. We evaluate our method on two rearrangement tasks in simulation and show that it consistently identifies meaningful abstractions that facilitate effective planning and outperform existing approaches.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14460","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:32:38.000Z","registered":"2025-09-19T01:32:39.000Z","published":"2025","updated":"2026-03-23T02:13:31.000Z"},"relationships":{"