<td id="S5.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m2" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="c_{\text{pos}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">c</mi><mtext style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">pos</mtext></msub><annotation encoding="application/x-tex">c_{\text{pos}}</annotation></semantics></math></td>
