<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span>PA-MPPI</figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 8: </span>Habitat Scene 1, top-down view of the floorplan, with NoMaD trajectory in blue.</figcaption>
</figure>
<figure id="S5.F9" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S5.F9.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.14978v1/figures/nomad/pingpong_nomad.png" id="S5.F9.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:262/171;" width="262" height="171" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>NoMaD proposed trajectory</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.F9.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.14978v1/figures/nomad/pingpoing_baseline.png" id="S5.F9.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:215/118;" width="215" height="118" alt="Refer to caption">
