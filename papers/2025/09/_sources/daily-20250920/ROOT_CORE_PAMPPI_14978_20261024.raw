<td id="S5.T1.2.6.5" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m15" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="R_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">R</mi><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">R_{\Delta}</annotation></semantics></math></td>
