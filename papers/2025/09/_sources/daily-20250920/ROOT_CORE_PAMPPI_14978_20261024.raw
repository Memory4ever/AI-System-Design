<td id="S5.T1.2.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m3" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="c_{\text{free}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">c</mi><mtext style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">free</mtext></msub><annotation encoding="application/x-tex">c_{\text{free}}</annotation></semantics></math></td>
