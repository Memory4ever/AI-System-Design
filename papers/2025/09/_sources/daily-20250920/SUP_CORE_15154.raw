<td id="S2.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.8.1" class="ltx_text ltx_font_smallcaps">92.13</span></td>
<td id="S2.T1.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.9.1" class="ltx_text ltx_font_smallcaps">61.46</span></td>
<td id="S2.T1.2.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.10.1" class="ltx_text ltx_font_smallcaps">74.11</span></td>
<td id="S2.T1.2.1.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.11.1" class="ltx_text ltx_font_smallcaps">75.79</span></td>
<td id="S2.T1.2.1.3.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.12.1" class="ltx_text ltx_font_smallcaps">81.01</span></td>
<td id="S2.T1.2.1.3.13" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.13.1" class="ltx_text ltx_font_smallcaps">79.38</span></td>
<td id="S2.T1.2.1.3.14" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.3.14.1" class="ltx_text ltx_font_smallcaps">80.49</span></td></tr>
