<span class="ltx_thead">
<span id="alg4.5.8.1" class="ltx_tr">
<span id="alg4.5.8.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column"><math id="alg4.m14" class="ltx_Math" alttext="\sum_{(u,\cdot)\in E}x_{u,v}^{(i)}==1,\quad\text{if }u=\text{src}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">src</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(u,\cdot)\in E}x_{u,v}^{(i)}==1,\quad\text{if }u=\text{src}_{i}</annotation></semantics></math></span></span>
<span id="alg4.5.8.2" class="ltx_tr">
<span id="alg4.5.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column"><math id="alg4.m15" class="ltx_Math" alttext="\sum_{(\cdot,u)\in E}x_{v,u}^{(i)}==0,\quad\text{if }u=\text{src}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">src</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(\cdot,u)\in E}x_{v,u}^{(i)}==0,\quad\text{if }u=\text{src}_{i}</annotation></semantics></math></span></span>
<span id="alg4.5.8.3" class="ltx_tr">
<span id="alg4.5.8.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column"><math id="alg4.m16" class="ltx_Math" alttext="\sum_{(\cdot,v)\in E}x_{u,v}^{(i)}==1,\quad\text{if }v=\text{dst}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">dst</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(\cdot,v)\in E}x_{u,v}^{(i)}==1,\quad\text{if }v=\text{dst}_{i}</annotation></semantics></math></span></span>
<span id="alg4.5.8.4" class="ltx_tr">
<span id="alg4.5.8.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_column"><math id="alg4.m17" class="ltx_Math" alttext="\sum_{(v,\cdot)\in E}x_{v,u}^{(i)}==0,\quad\text{if }v=\text{dst}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">dst</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(v,\cdot)\in E}x_{v,u}^{(i)}==0,\quad\text{if }v=\text{dst}_{i}</annotation></semantics></math></span></span>
</span>
<span class="ltx_tbody">
<span id="alg4.5.8.5" class="ltx_tr">
<span id="alg4.5.8.5.1" class="ltx_td ltx_align_left"><span id="alg4.5.8.5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Flow Conservation Constraint:</span></span></span>
<span id="alg4.5.8.6" class="ltx_tr">
<span id="alg4.5.8.6.1" class="ltx_td ltx_align_left"><math id="alg4.m18" class="ltx_Math" alttext="\forall" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∀</mo><annotation encoding="application/x-tex">\forall</annotation></semantics></math><span id="alg4.5.8.6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> intermediate nodes </span><math id="alg4.m19" class="ltx_Math" alttext="v\notin\{\text{src}_{i},\text{dst}_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">src</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">dst</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">v\notin\{\text{src}_{i},\text{dst}_{i}\}</annotation></semantics></math></span></span>
<span id="alg4.5.8.7" class="ltx_tr">
<span id="alg4.5.8.7.1" class="ltx_td ltx_align_left"><math id="alg4.m20" class="ltx_Math" alttext="\sum_{(\cdot,v)\in E}x_{u,v}^{(i)}-\sum_{(v,\cdot)\in E}x_{u,v}^{(i)}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\sum_{(\cdot,v)\in E}x_{u,v}^{(i)}-\sum_{(v,\cdot)\in E}x_{u,v}^{(i)}=0</annotation></semantics></math></span></span>
<span id="alg4.5.8.8" class="ltx_tr">
<span id="alg4.5.8.8.1" class="ltx_td ltx_align_left"><math id="alg4.m21" class="ltx_Math" alttext="z\geq\sum_{i=1}^{n}x_{u,v}^{(i)}+\text{edge\_count}(u,v),\quad\forall(u,v)\in E" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≥</mo><mrow><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">edge_count</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∀</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></mrow><annotation encoding="application/x-tex">z\geq\sum_{i=1}^{n}x_{u,v}^{(i)}+\text{edge\_count}(u,v),\quad\forall(u,v)\in E</annotation></semantics></math></span></span>
</span>
</span></p></div></div>
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_float"><span id="alg4.8" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Path finding with flow conservation.</figcaption>
</figure>
<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Algorithm </span><a href="#alg4" title="Algorithm 4 ‣ B.1. Routing to minimize fiber requirement ‣ Appendix B Circuits without overlaps ‣ PCCL: Photonic circuit-switched collective communication for distributed ML" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">4</span></a><span id="A2.SS1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> describes the flow conserving algorithm used to minimize the number of required fibers.It models the scale-up server grid as a graph where nodes are servers and edges are links between the servers. The goal of the algorithm is to find paths for all the input requests while minimizing the overlaps on edges between servers. The value of the objective variable after the optimization is the lowest number of fibers required that can support all the circuit requests.</span></p>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p"><span id="A2.SS1.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Note that we can maintain different sets of variables for different wavelengths to accommodate multiple different wavelengths on the same fiber.</span></p>
</div>
<div id="A2.SS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.p3.1" class="ltx_p"><span id="A2.SS1.p3.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Inputs.</span><span id="A2.SS1.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 
We represent the hardware network as a graph </span><math id="A2.SS1.p3.m1" class="ltx_Math" alttext="G=\langle V,E\rangle" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">G=\langle V,E\rangle</annotation></semantics></math><span id="A2.SS1.p3.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, where </span><math id="A2.SS1.p3.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math><span id="A2.SS1.p3.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> denotes the set of servers and </span><math id="A2.SS1.p3.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="A2.SS1.p3.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> denotes the fiber links between them. For each connection demand </span><math id="A2.SS1.p3.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A2.SS1.p3.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, we define a source-destination pair </span><math id="A2.SS1.p3.m5" class="ltx_Math" alttext="\text{route}_{i}=(\text{src}_{i},\text{dst}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">route</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">src</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">dst</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{route}_{i}=(\text{src}_{i},\text{dst}_{i})</annotation></semantics></math><span id="A2.SS1.p3.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">. Each edge </span><math id="A2.SS1.p3.m6" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math><span id="A2.SS1.p3.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> has an associated value </span><math id="A2.SS1.p3.m7" class="ltx_Math" alttext="\text{edge\_count}(u,v)" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">edge_count</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{edge\_count}(u,v)</annotation></semantics></math><span id="A2.SS1.p3.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">, which gives the number of existing connections already occupying that link.</span></p>
</div>
<div id="A2.SS1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS1.p4.1" class="ltx_p"><span id="A2.SS1.p4.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Decision variables.</span><span id="A2.SS1.p4.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 
We define </span><math id="A2.SS1.p4.m1" class="ltx_Math" alttext="x_{u,v}^{i}\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">x_{u,v}^{i}\in\{0,1\}</annotation></semantics></math><span id="A2.SS1.p4.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> to indicate whether the path for route </span><math id="A2.SS1.p4.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A2.SS1.p4.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> includes edge </span><math id="A2.SS1.p4.m3" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math><span id="A2.SS1.p4.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">. We also define an integer variable </span><math id="A2.SS1.p4.m4" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math><span id="A2.SS1.p4.1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> that represents the maximum number of connections present on any edge after including the new routes.</span></p>
</div>
<div id="A2.SS1.p5" class="ltx_para ltx_noindent">
<p id="A2.SS1.p5.1" class="ltx_p"><span id="A2.SS1.p5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Constraints.</span><span id="A2.SS1.p5.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 
The ILP enforces routing through valid paths using the following constraints.</span></p>
</div>
<div id="A2.SS1.p6" class="ltx_para">
<p id="A2.SS1.p6.1" class="ltx_p"><span id="A2.SS1.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For each route </span><math id="A2.SS1.p6.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A2.SS1.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, we ensure that the source node sends exactly one outgoing flow and receives none:</span></p>
<table id="A2.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex1.m1" class="ltx_Math" alttext="\sum_{(u,\cdot)\in E}x_{u,v}^{i}=1,\quad\sum_{(\cdot,u)\in E}x_{v,u}^{i}=0\quad\text{if }u=\text{src}_{i}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.000em">,</mo><mrow><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">src</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(u,\cdot)\in E}x_{u,v}^{i}=1,\quad\sum_{(\cdot,u)\in E}x_{v,u}^{i}=0\quad\text{if }u=\text{src}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p7" class="ltx_para">
<p id="A2.SS1.p7.1" class="ltx_p"><span id="A2.SS1.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">At the destination, we enforce that the node receives one incoming flow and does not send any further:</span></p>
<table id="A2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex2.m1" class="ltx_Math" alttext="\sum_{(\cdot,v)\in E}x_{u,v}^{i}=1,\quad\sum_{(v,\cdot)\in E}x_{v,u}^{i}=0\quad\text{if }v=\text{dst}_{i}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.000em">,</mo><mrow><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">dst</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{(\cdot,v)\in E}x_{u,v}^{i}=1,\quad\sum_{(v,\cdot)\in E}x_{v,u}^{i}=0\quad\text{if }v=\text{dst}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p8" class="ltx_para">
<p id="A2.SS1.p8.1" class="ltx_p"><span id="A2.SS1.p8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For all intermediate nodes, we conserve flow by balancing incoming and outgoing edges:</span></p>
<table id="A2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex3.m1" class="ltx_Math" alttext="\sum_{(\cdot,v)\in E}x_{u,v}^{i}-\sum_{(v,\cdot)\in E}x_{v,u}^{i}=0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">−</mo><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\sum_{(\cdot,v)\in E}x_{u,v}^{i}-\sum_{(v,\cdot)\in E}x_{v,u}^{i}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p9" class="ltx_para">
<p id="A2.SS1.p9.1" class="ltx_p"><span id="A2.SS1.p9.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We bound the total congestion on the rack by the variable </span><math id="A2.SS1.p9.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math><span id="A2.SS1.p9.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></p>
<table id="A2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex4.m1" class="ltx_Math" alttext="z\geq\sum_{(u,v)\in E}\left(\sum_{i=1}^{n}x_{u,v}^{i}\right)" display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≥</mo><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></munder><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></munderover><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\geq\sum_{(u,v)\in E}\left(\sum_{i=1}^{n}x_{u,v}^{i}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p10" class="ltx_para ltx_noindent">
<p id="A2.SS1.p10.1" class="ltx_p"><span id="A2.SS1.p10.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Objective.</span><span id="A2.SS1.p10.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 
We minimize </span><math id="A2.SS1.p10.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math><span id="A2.SS1.p10.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, the maximum number of edges used by connections present across the rack. The main intuition here is the only way to minimize the sum is to minimize every element in the sum. This objective helps avoid having a high number of optical connections on any one edge and minimizes the total additional fibers required for each rack.</span></p>
</div>
<figure id="A2.F19" class="ltx_figure">
<figure id="A2.F19.sf1" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.15450v1/mesh_route_generation.svg" id="A2.F19.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/327;" width="476" height="327"></object>
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_figure"><span id="A2.F19.sf1.5" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A2.F19.sf1.6" class="ltx_text" style="font-size:90%;">Routes vs time taken.</span></figcaption>
</figure>
<figcaption class="ltx_caption ltx_centering" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_figure"><span id="A2.F19.5" class="ltx_text" style="font-size:90%;">Figure 19</span>. </span><span id="A2.F19.6" class="ltx_text" style="font-size:90%;">Figure <a href="#A2.F19.sf1" title="In Figure 19 ‣ B.1. Routing to minimize fiber requirement ‣ Appendix B Circuits without overlaps ‣ PCCL: Photonic circuit-switched collective communication for distributed ML" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19(a)</span></a> shows the average time taken to compute routes using Algorithm <a href="#alg3" title="Algorithm 3 ‣ Appendix B Circuits without overlaps ‣ PCCL: Photonic circuit-switched collective communication for distributed ML" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> on different mesh sizes.</span></figcaption>
</figure>
</section>
</section>
