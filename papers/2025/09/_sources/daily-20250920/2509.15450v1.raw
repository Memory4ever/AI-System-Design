<span id="alg4.4.1.1.2.2" class="ltx_td ltx_align_left"><math id="alg4.m10" class="ltx_Math" alttext="(u,v)\in E" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow><annotation encoding="application/x-tex">(u,v)\in E</annotation></semantics></math><span id="alg4.4.1.1.2.2.1" class="ltx_text ltx_font_medium"> is used in a route <math id="alg4.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></span></span>
<span id="alg4.4.1.1.3" class="ltx_tr">
<span id="alg4.4.1.1.3.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><math id="alg4.m12" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math><span id="alg4.4.1.1.3.1.1" class="ltx_text ltx_font_medium">:</span></span>
