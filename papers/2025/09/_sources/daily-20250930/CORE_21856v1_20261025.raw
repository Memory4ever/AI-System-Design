<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">I.1 </span>Build Questions List Prompts</h3>

<div id="A9.SS1.p1" class="ltx_para"><code id="A9.SS1.p1.1" class="ltx_verbatim"><span class="ltx_inline-block"><svg id="A9.SS1.p1.pic1" class="ltx_picture" height="63.54" overflow="visible" version="1.1" viewBox="0 0 550 63.54" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,63.54) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 57.63 C 0 60.89 2.64 63.54 5.91 63.54 L 544.09 63.54 C 547.36 63.54 550 60.89 550 57.63 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 37.89 L 548.03 37.89 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 39.86 L 1.97 57.63 C 1.97 59.81 3.73 61.57 5.91 61.57 L 544.09 61.57 C 546.27 61.57 548.03 59.81 548.03 57.63 L 548.03 39.86 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 47.25)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A9.SS1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
<span id="A9.SS1.p1.pic1.1.1" class="ltx_p"><span id="A9.SS1.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Seed Question Expansion Prompt (2-Turn)</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A9.SS1.p1.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
<span id="A9.SS1.p1.pic1.tab1" class="ltx_float ltx_lstlisting">
