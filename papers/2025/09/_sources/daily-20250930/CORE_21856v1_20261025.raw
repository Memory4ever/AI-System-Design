<tr id="S3.T1.6.1.3" class="ltx_tr">
<th id="S3.T1.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">QASA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Lee et al., 2023</a>)</cite></th>
<td id="S3.T1.6.1.3.2" class="ltx_td ltx_align_center">1</td>
