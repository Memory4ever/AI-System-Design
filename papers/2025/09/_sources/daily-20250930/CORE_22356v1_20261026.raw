</div>
<div id="lstnumberx52" class="ltx_listingline"><span id="lstnumberx52.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx52.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx52.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx52.4" class="ltx_text ltx_lst_string ltx_font_typewriter">"state"</span><span id="lstnumberx52.5" class="ltx_text ltx_font_typewriter">**:</span><span id="lstnumberx52.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx52.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx52.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx52.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">object</span><span id="lstnumberx52.10" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic">’s<span id="lstnumberx52.10.1" class="ltx_text ltx_lst_space"> </span>physical<span id="lstnumberx52.10.2" class="ltx_text ltx_lst_space"> </span>structure,<span id="lstnumberx52.10.3" class="ltx_text ltx_lst_space"> </span>must<span id="lstnumberx52.10.4" class="ltx_text ltx_lst_space"> </span>be<span id="lstnumberx52.10.5" class="ltx_text ltx_lst_space"> </span>one<span id="lstnumberx52.10.6" class="ltx_text ltx_lst_space"> </span>of:<span id="lstnumberx52.10.7" class="ltx_text ltx_lst_space"> </span>‘’solid’‘<span id="lstnumberx52.10.8" class="ltx_text ltx_lst_space"> </span>or<span id="lstnumberx52.10.9" class="ltx_text ltx_lst_space"> </span>‘’hollow’‘.</span>
