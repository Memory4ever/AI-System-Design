<div id="lstnumberx50" class="ltx_listingline"><span id="lstnumberx50.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx50.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx50.4" class="ltx_text ltx_lst_string ltx_font_typewriter">"size"</span><span id="lstnumberx50.5" class="ltx_text ltx_font_typewriter">**:</span><span id="lstnumberx50.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">A</span><span id="lstnumberx50.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.9" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">string</span><span id="lstnumberx50.10" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx50.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx50.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx50.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">one</span><span id="lstnumberx50.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx50.19" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx50.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.21" class="ltx_text ltx_font_typewriter">‘</span><span id="lstnumberx50.22" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic">’small’‘,<span id="lstnumberx50.22.1" class="ltx_text ltx_lst_space"> </span>‘’normal’‘,<span id="lstnumberx50.22.2" class="ltx_text ltx_lst_space"> </span>or<span id="lstnumberx50.22.3" class="ltx_text ltx_lst_space"> </span>‘’big’‘,<span id="lstnumberx50.22.4" class="ltx_text ltx_lst_space"> </span>judged<span id="lstnumberx50.22.5" class="ltx_text ltx_lst_space"> </span>relative<span id="lstnumberx50.22.6" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx50.22.7" class="ltx_text ltx_lst_space"> </span>other<span id="lstnumberx50.22.8" class="ltx_text ltx_lst_space"> </span>objects<span id="lstnumberx50.22.9" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx50.22.10" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx50.22.11" class="ltx_text ltx_lst_space"> </span>scene.</span>
