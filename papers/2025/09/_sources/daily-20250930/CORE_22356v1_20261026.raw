<div id="lstnumberx49" class="ltx_listingline"><span id="lstnumberx49.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx49.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx49.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx49.4" class="ltx_text ltx_lst_string ltx_font_typewriter">"color"</span><span id="lstnumberx49.5" class="ltx_text ltx_font_typewriter">**:</span><span id="lstnumberx49.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx49.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx49.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx49.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">object</span><span id="lstnumberx49.10" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic">’s<span id="lstnumberx49.10.1" class="ltx_text ltx_lst_space"> </span>color.<span id="lstnumberx49.10.2" class="ltx_text ltx_lst_space"> </span>For<span id="lstnumberx49.10.3" class="ltx_text ltx_lst_space"> </span>ambiguous<span id="lstnumberx49.10.4" class="ltx_text ltx_lst_space"> </span>colors,<span id="lstnumberx49.10.5" class="ltx_text ltx_lst_space"> </span>combine<span id="lstnumberx49.10.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx49.10.7" class="ltx_text ltx_lst_space"> </span>names<span id="lstnumberx49.10.8" class="ltx_text ltx_lst_space"> </span>(e.g.,<span id="lstnumberx49.10.9" class="ltx_text ltx_lst_space"> </span>"purple<span id="lstnumberx49.10.10" class="ltx_text ltx_lst_space"> </span>blue",<span id="lstnumberx49.10.11" class="ltx_text ltx_lst_space"> </span>"gray<span id="lstnumberx49.10.12" class="ltx_text ltx_lst_space"> </span>white").</span>
