<span id="A11.F14.pic1.2.2" class="ltx_p"><span id="A11.F14.pic1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">[User]<span id="A11.F14.pic1.2.2.1.1" class="ltx_text ltx_font_medium">: {USER}</span></span></span>
