<tr id="A12.SS4.p4.pic1.2.10" class="ltx_tr">
<td id="A12.SS4.p4.pic1.2.10.1" class="ltx_td ltx_align_left ltx_align_top"><span class="ltx_rule ltx_align_top" style="width:366.2pt;height:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
