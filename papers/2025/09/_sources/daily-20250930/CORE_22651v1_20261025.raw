<td id="A12.SS5.p3.pic1.2.4.1" class="ltx_td ltx_align_left ltx_align_top"><span class="ltx_rule ltx_align_top" style="width:366.2pt;height:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="A12.SS5.p3.pic1.2.4.2" class="ltx_td ltx_align_left ltx_align_top"></td></tr>
