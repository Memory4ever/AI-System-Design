<span id="S1.T1.2.1.1.1.1.1.1.11.9" class="ltx_td ltx_align_center"><span id="S1.T1.2.1.1.1.1.1.1.11.9.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✓</span></span></span>
<span id="S1.T1.2.1.1.1.1.1.1.12" class="ltx_tr">
<span id="S1.T1.2.1.1.1.1.1.1.12.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.2.1.1.1.1.1.1.12.1.1" class="ltx_text ltx_font_typewriter">VoiceAssistant-Eval</span> (Ours)</span>
<span id="S1.T1.2.1.1.1.1.1.1.12.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.2.1.1.1.1.1.1.12.2.1" class="ltx_text" style="--ltx-fg-color:#00FF00;">✓</span></span>
