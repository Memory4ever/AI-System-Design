</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 384.86)"><foreignObject style="--ltx-fo-width:56.73em;--ltx-fo-height:27.32em;--ltx-fo-depth:26.82em;font-size:10pt;" class="ltx_minipage" height="749.08" overflow="visible" transform="matrix(1 0 0 -1 0 378)" width="36.62em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
