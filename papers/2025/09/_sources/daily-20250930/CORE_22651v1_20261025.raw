<table id="A12.SS8.p1.pic1.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A12.SS8.p1.pic1.2.1" class="ltx_tr">
<td id="A12.SS8.p1.pic1.2.1.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A12.SS8.p1.pic1.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS8.p1.pic1.2.1.1.1.1" class="ltx_p"><span id="A12.SS8.p1.pic1.2.1.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Question:</span></span>
