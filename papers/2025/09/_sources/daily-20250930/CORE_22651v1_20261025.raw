<span id="A12.SS1.p1.pic1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Listening/General/377</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 389.28)"><foreignObject style="--ltx-fo-width:56.73em;--ltx-fo-height:27.64em;--ltx-fo-depth:27.14em;font-size:10pt;" class="ltx_minipage" height="757.94" overflow="visible" transform="matrix(1 0 0 -1 0 382.43)" width="36.62em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<table id="A12.SS1.p1.pic1.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A12.SS1.p1.pic1.2.1" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.1.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A12.SS1.p1.pic1.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS1.p1.pic1.2.1.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.1.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Question:</span></span>
</span></td>
<td id="A12.SS1.p1.pic1.2.1.2" class="ltx_td ltx_align_top"></td></tr>
<tr id="A12.SS1.p1.pic1.2.2" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.2.1" class="ltx_td ltx_align_left ltx_align_top" colspan="2">
<span id="A12.SS1.p1.pic1.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;"><img src="2509.22651v1/appendix/error_examples/Listening_General_377/sound_audio_waveform.png" id="A12.SS1.p1.pic1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:505/139;" width="505" height="139" alt="[Uncaptioned image]">
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.3" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.3.1" class="ltx_td ltx_align_left ltx_align_top" colspan="2">
<span id="A12.SS1.p1.pic1.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;"><img src="2509.22651v1/appendix/error_examples/Listening_General_377/user_audio_0_waveform.png" id="A12.SS1.p1.pic1.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:505/139;" width="505" height="139" alt="[Uncaptioned image]">
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.4" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.4.1" class="ltx_td ltx_align_left ltx_align_top" style="--ltx-bg-color:#F2F2EB;">
<span id="A12.SS1.p1.pic1.2.4.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS1.p1.pic1.2.4.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.4.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Transcript: </span><span id="A12.SS1.p1.pic1.2.4.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F2EB;">What does one speaker frequently do at Ybor City?</span></span>
</span></td>
<td id="A12.SS1.p1.pic1.2.4.2" class="ltx_td ltx_align_left ltx_align_top"></td></tr>
<tr id="A12.SS1.p1.pic1.2.5" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.5.1" class="ltx_td ltx_align_left ltx_align_top" style="--ltx-bg-color:#DCF4E5;">
<span id="A12.SS1.p1.pic1.2.5.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS1.p1.pic1.2.5.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.5.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Ref Answer:</span><span id="A12.SS1.p1.pic1.2.5.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A12.SS1.p1.pic1.2.5.1.1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#DCF4E5;">They go to Ybor all the time.</span></span>
</span></td>
<td id="A12.SS1.p1.pic1.2.5.2" class="ltx_td ltx_align_top"></td></tr>
<tr id="A12.SS1.p1.pic1.2.6" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.6.1" class="ltx_td ltx_align_left ltx_align_top"><span class="ltx_rule ltx_align_top" style="width:366.2pt;height:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="A12.SS1.p1.pic1.2.6.2" class="ltx_td ltx_align_left ltx_align_top"></td></tr>
<tr id="A12.SS1.p1.pic1.2.7" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.7.1" class="ltx_td ltx_align_left ltx_align_top" colspan="2">
<span id="A12.SS1.p1.pic1.2.7.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS1.p1.pic1.2.7.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.7.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Qwen Answer:</span></span>
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.8" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.8.1" class="ltx_td ltx_align_left ltx_align_top" colspan="2">
<span id="A12.SS1.p1.pic1.2.8.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;"><img src="2509.22651v1/appendix/error_examples/Listening_General_377/assistant_audio_0_waveform.png" id="A12.SS1.p1.pic1.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:505/139;" width="505" height="139" alt="[Uncaptioned image]">
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.9" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.9.1" class="ltx_td ltx_align_left ltx_align_top" style="--ltx-bg-color:#D2E6FA;" colspan="2">
<span id="A12.SS1.p1.pic1.2.9.1.1" class="ltx_inline-block ltx_align_top" style="width:355.9pt;">
<span id="A12.SS1.p1.pic1.2.9.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.9.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#D2E6FA;">Well, one of the speakers often goes to Ebor all the time. And they also mention that they’ve been to Ebor so many times. So, it seems like they really like Ebor. What about you? Have you ever been to Ebor?</span></span>
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.10" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.10.1" class="ltx_td ltx_align_left ltx_align_top"><span class="ltx_rule ltx_align_top" style="width:366.2pt;height:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="A12.SS1.p1.pic1.2.10.2" class="ltx_td ltx_align_left ltx_align_top"></td></tr>
<tr id="A12.SS1.p1.pic1.2.11" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.11.1" class="ltx_td ltx_align_left ltx_align_top" colspan="2">
<span id="A12.SS1.p1.pic1.2.11.1.1" class="ltx_inline-block ltx_align_top" style="width:366.2pt;">
<span id="A12.SS1.p1.pic1.2.11.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.11.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Model Judegement:</span></span>
</span></td></tr>
<tr id="A12.SS1.p1.pic1.2.12" class="ltx_tr">
<td id="A12.SS1.p1.pic1.2.12.1" class="ltx_td ltx_align_left ltx_align_top" style="--ltx-bg-color:#FFC8C8;" colspan="2">
<span id="A12.SS1.p1.pic1.2.12.1.1" class="ltx_inline-block ltx_align_top" style="width:355.9pt;">
<span id="A12.SS1.p1.pic1.2.12.1.1.1" class="ltx_p"><span id="A12.SS1.p1.pic1.2.12.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#FFC8C8;">&lt;analysis&gt; … There’s a typo: "Ebor" vs "Ybor" – is that a mistake? The model answer repeatedly says "Ebor," not "Ybor." The question: "What is something that one of the speakers often does when they are in Ybor City?" The answer: "They go to Ybor all the time." The model says they go to Ebor all the time. That is incorrect because of misspelling? The meaning: It says "goes to Ebor all the time." The reference: "go to Ybor all the time." It might be considered wrong because they used the wrong location "Ebor" instead of "Ybor City." So model answer is incorrect. Also includes irrelevant conversation. So overall incorrect.</span></span>
<span id="A12.SS1.p1.pic1.2.12.1.1.2" class="ltx_p"><span id="A12.SS1.p1.pic1.2.12.1.1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#FFC8C8;">&lt;assistantfinal&gt; [Incorrect]</span></span>
</span></td></tr>
</table></span></span></foreignObject></g></g></svg></span>
</div>
        
<figure id="A12.F23" class="ltx_figure ltx_align_center">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 23: </span>Knowledge error example on Listening General. The question asks what a speaker frequently does at Ybor City and the model response repeatedly says “Ebor”. The evaluation judges the answer incorrect due to the location error and irrelevant content.</figcaption>
</figure>
      
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A12.SS1.3" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:397.5pt;">
        
<div id="A12.SS1.p2" class="ltx_para ltx_noindent ltx_align_center"><span class="ltx_inline-block"><svg id="A12.SS1.p2.pic1" class="ltx_picture" height="939.71" overflow="visible" version="1.1" viewBox="0 0 550 939.71" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,939.71) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 933.81 C 0 937.07 2.64 939.71 5.91 939.71 L 544.09 939.71 C 547.36 939.71 550 937.07 550 933.81 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FCFCFC;" fill="#FCFCFC" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 914.06 L 548.03 914.06 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 916.03 L 1.97 933.81 C 1.97 935.98 3.73 937.74 5.91 937.74 L 544.09 937.74 C 546.27 937.74 548.03 935.98 548.03 933.81 L 548.03 916.03 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 923.43)"><foreignObject style="--ltx-fo-width:31.84em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="440.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
