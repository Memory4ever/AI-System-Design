</div>
<div id="alg1.3.24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.24.1" class="ltx_text ltx_font_bold" style="font-size:90%;">13</span></span>
            <math id="alg1.m24" class="ltx_Math" alttext="a_{t}\leftarrow\alpha\cdot a_{t}^{\text{VLA}}+(1-\alpha)\cdot a_{t}^{\text{Reasoner}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><mi mathsize="0.900em">α</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msubsup><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">VLA</mtext></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">)</mo></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><msubsup><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">Reasoner</mtext></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}\leftarrow\alpha\cdot a_{t}^{\text{VLA}}+(1-\alpha)\cdot a_{t}^{\text{Reasoner}}</annotation></semantics></math>
</div>
