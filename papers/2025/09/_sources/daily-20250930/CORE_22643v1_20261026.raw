            <math id="alg1.m22" class="ltx_Math" alttext="a_{t}^{\text{Reasoner}}\leftarrow\operatorname*{arg\,max}_{a_{i},i\in children}\;\mathcal{Q}\big(o_{i}\big)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">Reasoner</mtext></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mrow><munder><mrow><mi mathsize="0.900em">arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">max</mi></mrow><mrow><msub><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">∈</mo><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></mrow></mrow></munder><mo>⁡</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒬</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi mathsize="0.900em">o</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}^{\text{Reasoner}}\leftarrow\operatorname*{arg\,max}_{a_{i},i\in children}\;\mathcal{Q}\big(o_{i}\big)</annotation></semantics></math>
</div>
