            <span id="alg1.3.6.2" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg1.3.6.3" class="ltx_text" style="font-size:90%;"> </span><em id="alg1.3.6.4" class="ltx_emph ltx_font_italic" style="font-size:90%;">depth <math id="alg1.m8" class="ltx_Math" alttext="d=0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d=0</annotation></semantics></math> <span id="alg1.3.6.4.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="alg1.m9" class="ltx_Math" alttext="MaxDepth" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">MaxDepth</annotation></semantics></math></em><span id="alg1.3.6.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.3.6.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
