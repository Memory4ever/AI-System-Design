              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
            <span id="alg1.3.5.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Init:</span><span id="alg1.3.5.3" class="ltx_text" style="font-size:90%;"> Create root node </span><math id="alg1.m7" class="ltx_Math" alttext="o^{(0)}\leftarrow o_{t},a^{(0)}\leftarrow a_{t}^{\text{VLA}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.900em">o</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><msub><mi mathsize="0.900em">o</mi><mi mathsize="0.900em">t</mi></msub></mrow><mo mathsize="0.900em">,</mo><mrow><msup><mi mathsize="0.900em">a</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em" stretchy="false">←</mo><msubsup><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">VLA</mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">o^{(0)}\leftarrow o_{t},a^{(0)}\leftarrow a_{t}^{\text{VLA}}</annotation></semantics></math><span id="alg1.3.5.4" class="ltx_text" style="font-size:90%;">. ;
</span>
</div>
