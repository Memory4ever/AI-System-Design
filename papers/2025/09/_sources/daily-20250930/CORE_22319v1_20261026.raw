<span id="Pt0.A1.T7.2.2.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="Pt0.A1.T7.2.2.4.2.1.1" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Three-layer MLP</span></span>
<span id="Pt0.A1.T7.2.2.4.2.1.2" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">with non-linearities</span></span>
