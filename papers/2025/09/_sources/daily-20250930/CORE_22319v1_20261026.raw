<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Yonsei University, Seoul, South Korea
</span>
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">E-mail </span><a href="mailto:%7Bjunha4304,charmfe,hwan1997,cjs823%7D@yonsei.ac.kr">{junha4304,charmfe,hwan1997,cjs823}@yonsei.ac.kr</a>
</span></span></span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Mincheol Choi
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Yonsei University, Seoul, South Korea
</span>
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">E-mail </span><a href="mailto:%7Bjunha4304,charmfe,hwan1997,cjs823%7D@yonsei.ac.kr">{junha4304,charmfe,hwan1997,cjs823}@yonsei.ac.kr</a>
</span></span></span></span>
