<section id="Pt0.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 0.A </span>Feature Converter Capacity Study</h2>

<figure id="Pt0.A1.T7" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 7: </span>Different size of feature converters.</figcaption>
<table id="Pt0.A1.T7.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="Pt0.A1.T7.2.1" class="ltx_tr">
<td id="Pt0.A1.T7.2.1.1" class="ltx_td ltx_border_tt"></td>
<td id="Pt0.A1.T7.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="Pt0.A1.T7.2.1.2.1" class="ltx_text ltx_font_bold">Tiny</span></td>
<td id="Pt0.A1.T7.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="Pt0.A1.T7.2.1.3.1" class="ltx_text ltx_font_bold">Medium</span></td>
<td id="Pt0.A1.T7.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="Pt0.A1.T7.2.1.4.1" class="ltx_text ltx_font_bold">Heavy</span></td></tr>
<tr id="Pt0.A1.T7.2.2" class="ltx_tr">
<td id="Pt0.A1.T7.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="Pt0.A1.T7.2.2.1.1" class="ltx_text ltx_font_bold">Architecture</span></td>
<td id="Pt0.A1.T7.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Pt0.A1.T7.2.2.2.1" class="ltx_text"></span> <span id="Pt0.A1.T7.2.2.2.2" class="ltx_text">
<span id="Pt0.A1.T7.2.2.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="Pt0.A1.T7.2.2.2.2.1.1" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Single</span></span>
<span id="Pt0.A1.T7.2.2.2.2.1.2" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Linear</span></span>
</span></span><span id="Pt0.A1.T7.2.2.2.3" class="ltx_text"></span></td>
<td id="Pt0.A1.T7.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Pt0.A1.T7.2.2.3.1" class="ltx_text"></span> <span id="Pt0.A1.T7.2.2.3.2" class="ltx_text">
<span id="Pt0.A1.T7.2.2.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="Pt0.A1.T7.2.2.3.2.1.1" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Two-layer MLP</span></span>
<span id="Pt0.A1.T7.2.2.3.2.1.2" class="ltx_tr">
<span id="Pt0.A1.T7.2.2.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">with bottleneck</span></span>
</span></span><span id="Pt0.A1.T7.2.2.3.3" class="ltx_text"></span></td>
