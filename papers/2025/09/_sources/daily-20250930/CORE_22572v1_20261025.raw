<td id="S4.T5.8.1.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T5.8.1.4.5.1" class="ltx_text ltx_font_bold">29.60</span></td>
<td id="S4.T5.8.1.4.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T5.8.1.4.6.1" class="ltx_text ltx_font_bold">31.00</span></td></tr>
