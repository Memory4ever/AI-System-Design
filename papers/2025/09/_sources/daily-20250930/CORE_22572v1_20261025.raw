<span id="A1.T6.8.1.1.7.2.1" class="ltx_tabular ltx_align_middle">
<span id="A1.T6.8.1.1.7.2.1.1" class="ltx_tr">
<span id="A1.T6.8.1.1.7.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T6.8.1.1.7.2.1.1.1.1" class="ltx_text ltx_font_bold">LiveCodeBench</span></span></span>
<span id="A1.T6.8.1.1.7.2.1.2" class="ltx_tr">
<span id="A1.T6.8.1.1.7.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">(v6-lite)</span></span>
</span></span><span id="A1.T6.8.1.1.7.3" class="ltx_text"></span></td>
