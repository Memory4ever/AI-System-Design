<td id="A1.T6.8.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T6.8.1.1.5.1" class="ltx_text ltx_font_bold">MATH500</span></td>
<td id="A1.T6.8.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T6.8.1.1.6.1" class="ltx_text ltx_font_bold">HumanEval</span></td>
