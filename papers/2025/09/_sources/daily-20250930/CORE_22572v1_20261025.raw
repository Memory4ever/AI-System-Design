<td id="A1.T6.8.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T6.8.1.1.2.1" class="ltx_text ltx_font_bold">Metric</span></td>
<td id="A1.T6.8.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T6.8.1.1.3.1" class="ltx_text ltx_font_bold">SVAMP</span></td>
