<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49Xc.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot{\left[-v_{t,{\bm{y}}}({\bm{y}}^{\prime})+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+v_{t,{\bm{y}}}({\bm{y}}^{\prime})\ln\frac{v_{t,{\bm{y}}}({\bm{y}}^{\prime})}{\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></munder></mstyle><mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot{\left[-v_{t,{\bm{y}}}({\bm{y}}^{\prime})+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+v_{t,{\bm{y}}}({\bm{y}}^{\prime})\ln\frac{v_{t,{\bm{y}}}({\bm{y}}^{\prime})}{\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E49Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\underbrace{\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left[-v_{t,{\bm{y}}}({\bm{y}}^{\prime})+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+v_{t,{\bm{y}}}({\bm{y}}^{\prime})\ln\frac{v_{t,{\bm{y}}}({\bm{y}}^{\prime})}{\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]}_{\textrm{Term 2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.280em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mi>𝒚</mi><mrow><mi>DiffIdx</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></msub></mrow><mo>=</mo><mi>K</mi></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 2</mtext></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\underbrace{\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left[-v_{t,{\bm{y}}}({\bm{y}}^{\prime})+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+v_{t,{\bm{y}}}({\bm{y}}^{\prime})\ln\frac{v_{t,{\bm{y}}}({\bm{y}}^{\prime})}{\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]}_{\textrm{Term 2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p5" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p5.1" class="ltx_p">For <math id="A3.SS1.SSS0.Px2.p5.m1" class="ltx_math_unparsed" alttext="{\bm{y}}^{\prime}={\bm{y}}[{\bm{y}}_{i}\rightarrow k]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>=</mo><mi>𝒚</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}^{\prime}={\bm{y}}[{\bm{y}}_{i}\rightarrow k]</annotation></semantics></math>, by Eq. (<a href="#A4.E54" title="In The proof of Lemma . ‣ D.1 The Proof of Lemma ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a>) we have <math id="A3.SS1.SSS0.Px2.p5.m2" class="ltx_Math" alttext="v_{t,{\bm{y}}}({\bm{y}}^{\prime})=\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\rightarrow k])}{q^{\leftarrow}_{t}({\bm{y}})}\leq\frac{1}{e^{(T-t)}-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">v_{t,{\bm{y}}}({\bm{y}}^{\prime})=\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\rightarrow k])}{q^{\leftarrow}_{t}({\bm{y}})}\leq\frac{1}{e^{(T-t)}-1}</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">Liang et al., 2025</a>, Lemma 2]</cite>, there exist <math id="A3.SS1.SSS0.Px2.p5.m3" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> such that <math id="A3.SS1.SSS0.Px2.p5.m4" class="ltx_Math" alttext="v_{t,{\bm{y}}}({\bm{y}}^{\prime})\geq\frac{1}{c}e^{-(T-t)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">v_{t,{\bm{y}}}({\bm{y}}^{\prime})\geq\frac{1}{c}e^{-(T-t)}</annotation></semantics></math>. Therefore, by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">Zhang et al., 2024</a>, Proposition 3]</cite>, letting <math id="A3.SS1.SSS0.Px2.p5.m5" class="ltx_Math" alttext="C=\max\{M,ce^{T}\}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>M</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>T</mi></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C=\max\{M,ce^{T}\}</annotation></semantics></math>, Term 2 satisfies</p>
</div>
<div id="A3.SS1.SSS0.Px2.p6" class="ltx_para">
<table id="A3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_math_unparsed" alttext="\displaystyle\textrm{Term 2}\leq\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(C\left\|v_{t,{\bm{y}}}({\bm{y}}^{\prime})-v_{kh,{\bm{y}}}({\bm{y}}^{\prime})\right\|^{2}+2C^{2}D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)" display="inline" intent=":literal"><semantics><mrow><mtext>Term 2</mtext><mo>≤</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.280em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mi>𝒚</mi><mrow><mi>DiffIdx</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></msub></mrow><mo>=</mo><mi>K</mi></mrow></munder></mstyle><mrow><mo>(</mo><mi>C</mi><msup><mrow><mo>‖</mo><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>v</mi><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mi>C</mi><mn>2</mn></msup><msub><mi>D</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\textrm{Term 2}\leq\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(C\left\|v_{t,{\bm{y}}}({\bm{y}}^{\prime})-v_{kh,{\bm{y}}}({\bm{y}}^{\prime})\right\|^{2}+2C^{2}D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p6.1" class="ltx_p">where <math id="A3.SS1.SSS0.Px2.p6.m1" class="ltx_Math" alttext="D_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">D_{\phi}</annotation></semantics></math> is the Bregman divergence with <math id="A3.SS1.SSS0.Px2.p6.m2" class="ltx_Math" alttext="\phi(x)=x\ln x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(x)=x\ln x</annotation></semantics></math> (as Eq. (<a href="#S2.E6" title="In The reverse process notations. ‣ 2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)), i.e.,</p>
<table id="A3.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex96.m1" class="ltx_math_unparsed" alttext="D_{\phi}(u\|v)=\phi(u)-\phi(v)-\langle\nabla\phi(v),u-v\rangle=u\ln\frac{u}{v}-u+v." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>u</mi><mo>−</mo><mi>v</mi><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mi>u</mi><mi>ln</mi><mfrac><mi>u</mi><mi>v</mi></mfrac><mo>−</mo><mi>u</mi><mo>+</mo><mi>v</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\phi}(u\|v)=\phi(u)-\phi(v)-\langle\nabla\phi(v),u-v\rangle=u\ln\frac{u}{v}-u+v.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p7" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p7.1" class="ltx_p">By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">Liang et al., 2025</a>, Lemma 7]</cite>, we have <math id="A3.SS1.SSS0.Px2.p7.m1" class="ltx_Math" alttext="\left\|v_{t,{\bm{y}}}({\bm{y}}^{\prime})-v_{kh,{\bm{y}}}({\bm{y}}^{\prime})\right\|\lesssim\gamma^{-1}(t-kh)\lesssim h" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>≲</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">\left\|v_{t,{\bm{y}}}({\bm{y}}^{\prime})-v_{kh,{\bm{y}}}({\bm{y}}^{\prime})\right\|\lesssim\gamma^{-1}(t-kh)\lesssim h</annotation></semantics></math>, where <math id="A3.SS1.SSS0.Px2.p7.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is defined in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">Liang et al., 2025</a>, Assumption 4]</cite>. We therefore have</p>
</div>
<div id="A3.SS1.SSS0.Px2.p8" class="ltx_para">
<table id="A3.E50" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E50X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E50X.m2" class="ltx_Math" alttext="\displaystyle\textrm{Term 2}" display="inline" intent=":literal"><semantics><mtext>Term 2</mtext><annotation encoding="application/x-tex">\displaystyle\textrm{Term 2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E50X.m3" class="ltx_Math" alttext="\displaystyle\lesssim CK\mathrm{numK}\left({\bm{y}}\right)h^{2}+C^{2}\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mi>C</mi><mi>K</mi><mi>numK</mi><mo>(</mo><mi>𝒚</mi><mo>)</mo><mi>h</mi><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mi>C</mi><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.280em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mi>𝒚</mi><mrow><mi>DiffIdx</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></msub></mrow><mo>=</mo><mi>K</mi></mrow></msub><mo>(</mo><mi>D</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim CK\mathrm{numK}\left({\bm{y}}\right)h^{2}+C^{2}\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(50)</span></td></tr>
<tr id="A3.E50Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E50Xa.m2" class="ltx_Math" alttext="\displaystyle\lesssim CKdh^{2}+C^{2}\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mi>C</mi><mi>K</mi><mi>d</mi><mi>h</mi><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mi>C</mi><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.280em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mi>𝒚</mi><mrow><mi>DiffIdx</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></msub></mrow><mo>=</mo><mi>K</mi></mrow></msub><mo>(</mo><mi>D</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim CKdh^{2}+C^{2}\sum_{\mathrm{Ham}({\bm{y}},{\bm{y}}^{\prime})=1\;\text{and}\;{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}=K}\left(D_{\phi}(v_{kh,{\bm{y}}}({\bm{y}}^{\prime})||\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime}))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p9" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p9.1" class="ltx_p">Since by Eq. (<a href="#A3.Ex97" title="Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>), we have</p>
<table id="A3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathrm{KL}\left(q^{\leftarrow}_{nh}\big\|q^{EI}_{nh}\right)=\mathrm{KL}\left(q^{\leftarrow}_{0}\big\|q^{EI}_{0}\right)+\sum_{k=0}^{n-1}\int_{kh}^{(k+1)h}\frac{{\textnormal{d}}\mathrm{KL}\left(q^{\leftarrow}_{t}\big\|q^{EI}_{t}\right)}{{\textnormal{d}}t}{\textnormal{d}}t." display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>q</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow><mo>=</mo><mi>KL</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mn>0</mn><mo stretchy="false">←</mo></msubsup><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>q</mi><mn>0</mn><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mrow><mtext>d</mtext><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mi>q</mi><msup><mrow></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msup><msub><mrow></mrow><mi>t</mi></msub><mo>)</mo></mrow><mrow><mtext>d</mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mtext>d</mtext><mi>t</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{KL}\left(q^{\leftarrow}_{nh}\big\|q^{EI}_{nh}\right)=\mathrm{KL}\left(q^{\leftarrow}_{0}\big\|q^{EI}_{0}\right)+\sum_{k=0}^{n-1}\int_{kh}^{(k+1)h}\frac{{\textnormal{d}}\mathrm{KL}\left(q^{\leftarrow}_{t}\big\|q^{EI}_{t}\right)}{{\textnormal{d}}t}{\textnormal{d}}t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p9.2" class="ltx_p">Then, by Eq. (<a href="#A3.E49" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>), Eq. (<a href="#A3.E50" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>), Eq. (<a href="#S2.E6" title="In The reverse process notations. ‣ 2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) and Assumption <a href="#A3.I1.i1" title="item [A1]- ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">[A1]-</span></a>, we have</p>
<table id="A3.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex98.m1" class="ltx_math_unparsed" alttext="\mathrm{KL}\left(q^{\leftarrow}_{T-\delta}\big\|q^{EI}_{T-\delta}\right)\lesssim(T-\delta)C^{2}\epsilon^{2}_{\text{score}}+C(T-\delta)Kdh^{2}." display="block" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo>(</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow><mo>≲</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><msup><mi>C</mi><mn>2</mn></msup><msubsup><mi>ϵ</mi><mtext>score</mtext><mn>2</mn></msubsup><mo>+</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mi>K</mi><mi>d</mi><msup><mi>h</mi><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{KL}\left(q^{\leftarrow}_{T-\delta}\big\|q^{EI}_{T-\delta}\right)\lesssim(T-\delta)C^{2}\epsilon^{2}_{\text{score}}+C(T-\delta)Kdh^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p9.3" class="ltx_p">By Pinsker’s inequality, we have</p>
<table id="A3.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex99.m1" class="ltx_Math" alttext="\mathrm{TV}\left(q^{\leftarrow}_{T-\delta},q^{EI}_{T-\delta}\right)\leq\sqrt{\frac{1}{2}\mathrm{KL}\left(q^{\leftarrow}_{T-\delta}\big\|q^{EI}_{T-\delta}\right)}\lesssim\sqrt{\frac{1}{2}}\sqrt{(T-\delta)C^{2}\epsilon^{2}_{\text{score}}+C(T-\delta)Kdh^{2}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">←</mo></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow></mrow><mo>≤</mo><msqrt><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mi>q</mi><msup><mrow></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msup><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo>)</mo></mrow></msqrt><mo>≲</mo><mrow><msqrt><mfrac><mn>1</mn><mn>2</mn></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ϵ</mi><mtext>score</mtext><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\mathrm{TV}\left(q^{\leftarrow}_{T-\delta},q^{EI}_{T-\delta}\right)\leq\sqrt{\frac{1}{2}\mathrm{KL}\left(q^{\leftarrow}_{T-\delta}\big\|q^{EI}_{T-\delta}\right)}\lesssim\sqrt{\frac{1}{2}}\sqrt{(T-\delta)C^{2}\epsilon^{2}_{\text{score}}+C(T-\delta)Kdh^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p10" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p10.1" class="ltx_p">By taking <math id="A3.SS1.SSS0.Px2.p10.m1" class="ltx_Math" alttext="\epsilon_{\text{score}}\lesssim\varepsilon/(\sqrt{T}C)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mtext>score</mtext></msub><mo>≲</mo><mrow><mi>ε</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>T</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{\text{score}}\lesssim\varepsilon/(\sqrt{T}C)</annotation></semantics></math>, and <math id="A3.SS1.SSS0.Px2.p10.m2" class="ltx_Math" alttext="h\lesssim\varepsilon/\sqrt{CdT}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≲</mo><mrow><mi>ε</mi><mo>/</mo><msqrt><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">h\lesssim\varepsilon/\sqrt{CdT}</annotation></semantics></math>, we have <math id="A3.SS1.SSS0.Px2.p10.m3" class="ltx_Math" alttext="\mathrm{TV}\left(q^{\leftarrow}_{T-\delta},q^{EI}_{T-\delta}\right)\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">←</mo></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\mathrm{TV}\left(q^{\leftarrow}_{T-\delta},q^{EI}_{T-\delta}\right)\leq\varepsilon</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.SSS0.Px2.p11" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p11.1" class="ltx_p">Therefore, taking <math id="A3.SS1.SSS0.Px2.p11.m1" class="ltx_Math" alttext="h\lesssim\min\{\frac{\varepsilon}{K^{2}d^{2}M^{2}\log(d/\varepsilon)},\frac{\varepsilon}{\sqrt{Cd\log(d/\varepsilon)}}\}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mfrac><mi>ε</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>,</mo><mfrac><mi>ε</mi><msqrt><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h\lesssim\min\{\frac{\varepsilon}{K^{2}d^{2}M^{2}\log(d/\varepsilon)},\frac{\varepsilon}{\sqrt{Cd\log(d/\varepsilon)}}\}</annotation></semantics></math>, by the triangle inequality, we have</p>
<table id="A3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_Math" alttext="\displaystyle\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{Eu}_{T-\delta}\right)" display="inline" intent=":literal"><semantics><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mi>δ</mi><mo stretchy="false">←</mo></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{Eu}_{T-\delta}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m2" class="ltx_Math" alttext="\displaystyle\leq\mathrm{TV}\left(q^{Eu}_{T-\delta},q^{EI}_{T-\delta}\right)+\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{EI}_{T-\delta}\right)\lesssim\varepsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mi>δ</mi><mo stretchy="false">←</mo></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo>)</mo></mrow></mrow></mrow><mo>≲</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathrm{TV}\left(q^{Eu}_{T-\delta},q^{EI}_{T-\delta}\right)+\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{EI}_{T-\delta}\right)\lesssim\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p12" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p12.1" class="ltx_p">Plugging in <math id="A3.SS1.SSS0.Px2.p12.m1" class="ltx_Math" alttext="C=\Theta(d/\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C=\Theta(d/\varepsilon)</annotation></semantics></math>, we have for <math id="A3.SS1.SSS0.Px2.p12.m2" class="ltx_Math" alttext="h\lesssim\min\{\frac{\varepsilon}{K^{2}d^{2}M^{2}\log(d/\varepsilon)},\frac{\varepsilon^{\frac{3}{2}}}{d\sqrt{\log(d/\varepsilon)}}\}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>≲</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mfrac><mi>ε</mi><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>,</mo><mfrac><msup><mi>ε</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mfrac><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h\lesssim\min\{\frac{\varepsilon}{K^{2}d^{2}M^{2}\log(d/\varepsilon)},\frac{\varepsilon^{\frac{3}{2}}}{d\sqrt{\log(d/\varepsilon)}}\}</annotation></semantics></math>, we have <math id="A3.SS1.SSS0.Px2.p12.m3" class="ltx_Math" alttext="\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{Eu}_{T-\delta}\right)\lesssim\varepsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>q</mi><mi>δ</mi><mo stretchy="false">←</mo></msubsup><mo>,</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msubsup><mo>)</mo></mrow></mrow><mo>≲</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{TV}\left(q^{\leftarrow}_{\delta},q^{Eu}_{T-\delta}\right)\lesssim\varepsilon.</annotation></semantics></math></p>
</div>
<div id="A3.SS1.SSS0.Px2.p13" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p13.1" class="ltx_p">Hence, the proof is completed.</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Following the notations shown in Section <a href="#S2" title="2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, for <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="t\in[kh,(k+1)h]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[kh,(k+1)h]</annotation></semantics></math>, we have</span></p>
<table id="A3.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.SSS0.Px2.p14" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p14.1" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.1.1" class="ltx_text">Since we have required <math id="A3.SS1.SSS0.Px2.p14.m1" class="ltx_Math" alttext="\Delta t\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta t\rightarrow 0</annotation></semantics></math>, that is to say</span></p>
<table id="A3.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex102.m1" class="ltx_Math" alttext="q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{EI}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0\quad\text{and}\quad q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{\leftarrow}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0\quad\forall{\bm{y}}^{\prime}\not={\bm{y}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo>≠</mo><mi>𝒚</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{EI}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0\quad\text{and}\quad q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{\leftarrow}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0\quad\forall{\bm{y}}^{\prime}\not={\bm{y}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.2" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.2.1" class="ltx_text">which automatically makes</span></p>
<table id="A3.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex103.m1" class="ltx_Math" alttext="\left|\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right|\leq\frac{1}{2}&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac><mo>|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right|\leq\frac{1}{2}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.3" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.3.1" class="ltx_text">Under this condition, we have</span></p>
<table id="A3.Ex104" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex104X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex104X.m2" class="ltx_Math" alttext="\displaystyle\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}=\ln\left[1+\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}=\ln\left[1+\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex104Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex104Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\left[\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]^{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>i</mi></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow><mi>i</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\left[\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]^{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.4" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.4.1" class="ltx_text">which implies (with the dominated convergence theorem)</span></p>
<table id="A3.Ex105" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex105X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex105X.m2" class="ltx_Math" alttext="\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex105Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex105Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{\Delta t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>i</mi></mfrac></mstyle></mrow><mo lspace="0.222em">⋅</mo><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{\Delta t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex105Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex105Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}." display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.222em">⋅</mo><mrow><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo>(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mi>i</mi></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.5" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.5.1" class="ltx_text">Only when <math id="A3.SS1.SSS0.Px2.p14.m2" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>, we have</span></p>
<table id="A3.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex106.m1" class="ltx_Math" alttext="\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mfrac><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo>(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mi>i</mi></msup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.6" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.6.1" class="ltx_text">otherwise it will be equivalent to <math id="A3.SS1.SSS0.Px2.p14.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
Therefore, we have</span></p>
<table id="A3.Ex107" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex107X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex107X.m2" class="ltx_Math" alttext="\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]=\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{\Delta t}" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]=\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{\Delta t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex107Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex107Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p14.7" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p14.7.1" class="ltx_text">Hence, the proof is completed.
∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Truncated Uniformization Inference Analysis</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>The Proof of Lemma <a href="#S5.Thmtheorem1" title="Lemma 5.1 (Bound of the outgoing rate). ‣ The comparison of computational complexity and outgoing rate. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a></h3>

<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">The proof of Lemma <a href="#S5.Thmtheorem1" title="Lemma 5.1 (Bound of the outgoing rate). ‣ The comparison of computational complexity and outgoing rate. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.</h6>
<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.4" class="ltx_p"><span id="A4.SS1.p1.4.1" class="ltx_text">According to the definition, we have</span></p>
<table id="A4.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex108.m1" class="ltx_Math" alttext="R^{\leftarrow}_{t}({\bm{y}})=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot\frac{q^{\leftarrow}_{t}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mfrac><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">R^{\leftarrow}_{t}({\bm{y}})=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot\frac{q^{\leftarrow}_{t}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.5" class="ltx_p"><span id="A4.SS1.p1.5.1" class="ltx_text">Since the definition of the transition rate matrix, i.e., Eq. (<a href="#S3.E7" title="In Masked discrete diffusion instantiation and approximation. ‣ 3 The Forward Process of Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), for any <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="{\bm{y}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝒚</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{y}}^{\prime}</annotation></semantics></math> with <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="\mathrm{Ham}({\bm{y}}^{\prime},{\bm{y}})&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathrm{Ham}({\bm{y}}^{\prime},{\bm{y}})&gt;1</annotation></semantics></math>, it has <math id="A4.SS1.p1.m3" class="ltx_Math" alttext="R^{\to}({\bm{y}},{\bm{y}}^{\prime})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R^{\to}({\bm{y}},{\bm{y}}^{\prime})=0</annotation></semantics></math>.
Moreover, even when <math id="A4.SS1.p1.m4" class="ltx_Math" alttext="\mathrm{Ham}({\bm{y}}^{\prime},{\bm{y}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Ham</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathrm{Ham}({\bm{y}}^{\prime},{\bm{y}})=1</annotation></semantics></math>, it has</span></p>
<table id="A4.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex109.m1" class="ltx_Math" alttext="R^{\to}({\bm{y}},{\bm{y}}^{\prime})=0\quad\text{when}\quad{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}\not=K." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>when</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>𝒚</mi><mrow><mi>DiffIdx</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>)</mo></mrow></mrow></msub><mo>≠</mo><mi>K</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{\to}({\bm{y}},{\bm{y}}^{\prime})=0\quad\text{when}\quad{\bm{y}}_{\mathrm{DiffIdx}\left({\bm{y}},{\bm{y}}^{\prime}\right)}\not=K.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.6" class="ltx_p"><span id="A4.SS1.p1.6.1" class="ltx_text">Define the function to transfer the <math id="A4.SS1.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>–th element of <math id="A4.SS1.p1.m6" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math> (<math id="A4.SS1.p1.m7" class="ltx_Math" alttext="{\bm{y}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{y}}_{i}</annotation></semantics></math>) from <math id="A4.SS1.p1.m8" class="ltx_Math" alttext="k^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>′</mo></msup><annotation encoding="application/x-tex">k^{\prime}</annotation></semantics></math> to <math id="A4.SS1.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> as</span></p>
<table id="A4.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex110.m1" class="ltx_math_unparsed" alttext="{\bm{y}}[{\bm{y}}_{i}\colon k^{\prime}\to k]=\left[{\bm{y}}_{1},{\bm{y}}_{2},\ldots,{\bm{y}}_{i-1},k,{\bm{y}}_{i+1},\ldots,{\bm{y}}_{d}\right]." display="block" intent=":literal"><semantics><mrow><mi>𝒚</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo>[</mo><msub><mi>𝒚</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒚</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>k</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝒚</mi><mi>d</mi></msub><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{y}}[{\bm{y}}_{i}\colon k^{\prime}\to k]=\left[{\bm{y}}_{1},{\bm{y}}_{2},\ldots,{\bm{y}}_{i-1},k,{\bm{y}}_{i+1},\ldots,{\bm{y}}_{d}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.7" class="ltx_p"><span id="A4.SS1.p1.7.1" class="ltx_text">That means <math id="A4.SS1.p1.m10" class="ltx_Math" alttext="R^{\leftarrow}_{t}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\leftarrow}_{t}({\bm{y}})</annotation></semantics></math> can be rewritten as</span></p>
<table id="A4.E51" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E51X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E51X.m2" class="ltx_Math" alttext="\displaystyle R^{\leftarrow}_{t}({\bm{y}})=\sum_{i,{\bm{y}}_{i}=K}\left[\sum_{k=1}^{K-1}R^{\to}({\bm{y}},{\bm{y}}[{\bm{y}}_{i}\colon K\to k])\cdot\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}\right]." display="inline" intent=":literal"><semantics><mrow><mi>R</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>,</mo><msub><mi>𝒚</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>K</mi></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>R</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R^{\leftarrow}_{t}({\bm{y}})=\sum_{i,{\bm{y}}_{i}=K}\left[\sum_{k=1}^{K-1}R^{\to}({\bm{y}},{\bm{y}}[{\bm{y}}_{i}\colon K\to k])\cdot\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.8" class="ltx_p"><span id="A4.SS1.p1.8.1" class="ltx_text">To upper bound the RHS of the above equation, we consider controlling</span></p>
<table id="A4.E52" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E52X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E52X.m2" class="ltx_Math" alttext="\displaystyle\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}=\frac{q^{\to}_{T-t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\to}_{T-t}({\bm{y}})}=\frac{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q^{\to}_{0}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mrow><msub><mo>∑</mo><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msubsup><mi>q</mi><mn>0</mn><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}=\frac{q^{\to}_{T-t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\to}_{T-t}({\bm{y}})}=\frac{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q^{\to}_{0}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(52)</span></td></tr>
<tr id="A4.E52Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E52Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})\cdot\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}}{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}=\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\to}_{0|T-t}(\cdot|{\bm{y}})}\left[\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}\right]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mi>q</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mo stretchy="false">→</mo></msup><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mrow><mrow><mrow><msub><mo>∑</mo><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msubsup><mi>q</mi><mn>0</mn><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mn>0</mn><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})\cdot\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}}{\sum_{{\bm{y}}_{0}\in{\mathcal{Y}}}q_{0}^{\to}({\bm{y}}_{0})\cdot q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}=\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\to}_{0|T-t}(\cdot|{\bm{y}})}\left[\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.9" class="ltx_p"><span id="A4.SS1.p1.9.1" class="ltx_text">where the last equation follows from Bayes’ Theorem, i.e.,</span></p>
<table id="A4.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex111.m1" class="ltx_math_unparsed" alttext="q^{\to}_{0|T-t}({\bm{y}}_{0}|{\bm{y}})\cdot q^{\to}_{T-t}({\bm{y}})=q_{T-t|0}^{\to}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\to}_{0}({\bm{y}}_{0})\quad\Leftrightarrow\quad q^{\to}_{0|T-t}({\bm{y}}_{0}|{\bm{y}})\propto q_{T-t|0}^{\to}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\to}_{0}({\bm{y}}_{0})." display="block" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mrow><mn>0</mn><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mn>0</mn><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⇔</mo><msubsup><mi>q</mi><mrow><mn>0</mn><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>∝</mo><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mn>0</mn><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q^{\to}_{0|T-t}({\bm{y}}_{0}|{\bm{y}})\cdot q^{\to}_{T-t}({\bm{y}})=q_{T-t|0}^{\to}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\to}_{0}({\bm{y}}_{0})\quad\Leftrightarrow\quad q^{\to}_{0|T-t}({\bm{y}}_{0}|{\bm{y}})\propto q_{T-t|0}^{\to}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\to}_{0}({\bm{y}}_{0}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.10" class="ltx_p"><span id="A4.SS1.p1.10.1" class="ltx_text">Then, we only need to control <math id="A4.SS1.p1.m11" class="ltx_math_unparsed" alttext="q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\rightarrow k]|{\bm{y}}_{0})/q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>/</mo><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\rightarrow k]|{\bm{y}}_{0})/q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})</annotation></semantics></math> where both the denominator and the numerator can be calculated accurately by Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5 (Forward transition kernel). ‣ B.3 The Proof of Lemma ‣ Appendix B The Markov Processes of Discrete Diffusion Models ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>.
Specifically, we have</span></p>
<table id="A4.Ex112" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex112X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex112X.m2" class="ltx_Math" alttext="\displaystyle q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})=\prod_{j\in\{1,\ldots,i-1,i+1,\ldots,d\}}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})=\prod_{j\in\{1,\ldots,i-1,i+1,\ldots,d\}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex112X.m3" class="ltx_Math" alttext="\displaystyle\left[{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{0}({\bm{y}}_{j}-{\bm{y}}_{0,j})\cdot e^{-(T-t)}\right." display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo rspace="0.055em">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟏</mn><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>−</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\left[{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{0}({\bm{y}}_{j}-{\bm{y}}_{0,j})\cdot e^{-(T-t)}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex112Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex112Xa.m2" class="ltx_Math" alttext="\displaystyle\left.+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{K}({\bm{y}}_{j})\cdot(1-e^{-(T-t)})\right]\cdot" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo rspace="0.055em">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟏</mn><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo rspace="0.055em">]</mo><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{K}({\bm{y}}_{j})\cdot(1-e^{-(T-t)})\right]\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex112Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex112Xb.m2" class="ltx_Math" alttext="\displaystyle\left[{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})+\left(1-{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})\right)\cdot(1-e^{-(T-t)})\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})+\left(1-{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})\right)\cdot(1-e^{-(T-t)})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.11" class="ltx_p"><span id="A4.SS1.p1.11.1" class="ltx_text">and</span></p>
<table id="A4.Ex113" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex113X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex113X.m2" class="ltx_Math" alttext="\displaystyle q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})=\prod_{j\in\{1,\ldots,i-1,i+1,\ldots,d\}}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})=\prod_{j\in\{1,\ldots,i-1,i+1,\ldots,d\}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex113X.m3" class="ltx_Math" alttext="\displaystyle\left[{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{0}({\bm{y}}_{j}-{\bm{y}}_{0,j})\cdot e^{-(T-t)}\right." display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo rspace="0.055em">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟏</mn><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>−</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\left[{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{0}({\bm{y}}_{j}-{\bm{y}}_{0,j})\cdot e^{-(T-t)}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex113Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex113Xa.m2" class="ltx_Math" alttext="\displaystyle\left.+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{K}({\bm{y}}_{j})\cdot(1-e^{-(T-t)})\right]\cdot" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo rspace="0.055em">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟏</mn><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo rspace="0.055em">]</mo><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\left(1-{\bm{1}}_{(K,K)}({\bm{y}}_{j},{\bm{y}}_{0,j})\right)\cdot{\bm{1}}_{K}({\bm{y}}_{j})\cdot(1-e^{-(T-t)})\right]\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex113Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex113Xb.m2" class="ltx_Math" alttext="\displaystyle\left[\left(1-{\bm{1}}_{(K,K)}(k,{\bm{y}}_{0,i})\right)\cdot{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\left(1-{\bm{1}}_{(K,K)}(k,{\bm{y}}_{0,i})\right)\cdot{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.12" class="ltx_p"><span id="A4.SS1.p1.12.1" class="ltx_text">Since the factor except for the <math id="A4.SS1.p1.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>–th term will be canceled, we have</span></p>
<table id="A4.E53" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E53X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E53X.m2" class="ltx_Math" alttext="\displaystyle\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\rightarrow k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}=\frac{\left(1-{\bm{1}}_{(K,K)}(k,{\bm{y}}_{0,i})\right)\cdot{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}}{{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})+\left(1-{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})\right)\cdot(1-e^{-(T-t)})}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mrow><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\rightarrow k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}=\frac{\left(1-{\bm{1}}_{(K,K)}(k,{\bm{y}}_{0,i})\right)\cdot{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}}{{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})+\left(1-{\bm{1}}_{(K,K)}(K,{\bm{y}}_{0,i})\right)\cdot(1-e^{-(T-t)})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(53)</span></td></tr>
<tr id="A4.E53Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E53Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}}{1-e^{-(T-t)}}\leq\frac{e^{-(T-t)}}{1-e^{-(T-t)}}=\frac{1}{e^{(T-t)}-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mn>𝟏</mn><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{{\bm{1}}_{0}(k-{\bm{y}}_{0,i})\cdot e^{-(T-t)}}{1-e^{-(T-t)}}\leq\frac{e^{-(T-t)}}{1-e^{-(T-t)}}=\frac{1}{e^{(T-t)}-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.13" class="ltx_p"><span id="A4.SS1.p1.13.1" class="ltx_text">Plugging this result into Eq. (<a href="#A4.E52" title="In The proof of Lemma . ‣ D.1 The Proof of Lemma ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>), the density ratio of the reverse process will have</span></p>
<table id="A4.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E54.m1" class="ltx_math_unparsed" alttext="\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\rightarrow k])}{q^{\leftarrow}_{t}({\bm{y}})}=\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\to}_{0|T-t}(\cdot|{\bm{y}})}\left[\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}\right]\leq\frac{1}{e^{(T-t)}-1}." display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mn>0</mn><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">→</mo></msup><msub><mrow></mrow><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo fence="false">|</mo><mn>0</mn></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\rightarrow k])}{q^{\leftarrow}_{t}({\bm{y}})}=\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\to}_{0|T-t}(\cdot|{\bm{y}})}\left[\frac{q^{\to}_{T-t|0}({\bm{y}}[{\bm{y}}_{i}\colon K\to k]|{\bm{y}}_{0})}{q^{\to}_{T-t|0}({\bm{y}}|{\bm{y}}_{0})}\right]\leq\frac{1}{e^{(T-t)}-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p1.14" class="ltx_p"><span id="A4.SS1.p1.14.1" class="ltx_text">Combining with the fact, i.e.,</span></p>
<table id="A4.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex114.m1" class="ltx_math_unparsed" alttext="R^{\to}({\bm{y}},{\bm{y}}[{\bm{y}}_{i}\colon K\to k])=1" display="block" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒚</mi><mrow><mo stretchy="false">[</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R^{\to}({\bm{y}},{\bm{y}}[{\bm{y}}_{i}\colon K\to k])=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.15" class="ltx_p"><span id="A4.SS1.p1.15.1" class="ltx_text">from Eq. (<a href="#S3.E7" title="In Masked discrete diffusion instantiation and approximation. ‣ 3 The Forward Process of Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), Eq. (<a href="#A4.E51" title="In The proof of Lemma . ‣ D.1 The Proof of Lemma ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) can be upper bounded as</span></p>
<table id="A4.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex115.m1" class="ltx_math_unparsed" alttext="R^{\leftarrow}_{t}({\bm{y}})=\sum_{i,{\bm{y}}_{i}=K}\left[\sum_{k=1}^{K-1}\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}\right]\leq\frac{\mathrm{numK}({\bm{y}})\cdot K}{e^{(T-t)}-1}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><msub><mi>𝒚</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>K</mi></mrow></munder><mrow><mo>[</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mrow><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">[</mo><mi>𝒚</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi><mo stretchy="false">→</mo><mi>k</mi><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow><mo>≤</mo><mfrac><mrow><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>K</mi></mrow><mrow><msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{\leftarrow}_{t}({\bm{y}})=\sum_{i,{\bm{y}}_{i}=K}\left[\sum_{k=1}^{K-1}\frac{q^{\leftarrow}_{t}({\bm{y}}[{\bm{y}}_{i}\colon K\to k])}{q^{\leftarrow}_{t}({\bm{y}})}\right]\leq\frac{\mathrm{numK}({\bm{y}})\cdot K}{e^{(T-t)}-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.16" class="ltx_p"><span id="A4.SS1.p1.16.1" class="ltx_text">Hence, the proof is completed.
∎</span></p>
</div>
</div>
<div id="A4.Thmtheorem1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem1.2" class="ltx_text ltx_font_italic">Remark D.1</span></span><span id="A4.Thmtheorem1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A4.Thmtheorem1.p1" class="ltx_para">
<p id="A4.Thmtheorem1.p1.1" class="ltx_p">Here, an interesting property is that compared with the upper bound of <math id="A4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\beta_{t}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}({\bm{y}})</annotation></semantics></math> in the <em id="A4.Thmtheorem1.p1.1.1" class="ltx_emph ltx_font_italic">uniform forward process</em> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib5" title="" class="ltx_ref">Chen and Ying [2024]</a></cite>, i.e.,</p>
<table id="A4.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex116.m1" class="ltx_Math" alttext="\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\leq K\cdot d\cdot\frac{1+e^{-2(T-t)}}{1-e^{-2(T-t)}}\leq K\cdot d\cdot(1+(T-t)^{-1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mfrac></mrow><mo>≤</mo><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\leq K\cdot d\cdot\frac{1+e^{-2(T-t)}}{1-e^{-2(T-t)}}\leq K\cdot d\cdot(1+(T-t)^{-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmtheorem1.p1.2" class="ltx_p">the upper bound of <math id="A4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\beta_{t}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}({\bm{y}})</annotation></semantics></math> in <em id="A4.Thmtheorem1.p1.2.1" class="ltx_emph ltx_font_italic">absorbing forward process</em> will only be</p>
<table id="A4.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex117.m1" class="ltx_Math" alttext="\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\leq{\color[rgb]{1,0,0}K\cdot\mathrm{numK}({\bm{y}})}\cdot\frac{e^{-(T-t)}}{1-e^{-(T-t)}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">K</mi><mo style="--ltx-fg-color:#FF0000;" lspace="0.222em" mathcolor="#FF0000" rspace="0.222em">⋅</mo><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">numK</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝒚</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.222em">⋅</mo><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\leq{\color[rgb]{1,0,0}K\cdot\mathrm{numK}({\bm{y}})}\cdot\frac{e^{-(T-t)}}{1-e^{-(T-t)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmtheorem1.p1.3" class="ltx_p">The latter upper bound is strictly better compared with the former one, since the number of mask tokens, i.e., <math id="A4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathrm{numK}({\bm{y}})\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\mathrm{numK}({\bm{y}})\leq d</annotation></semantics></math>.
Besides, with the time growth (from <math id="A4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>), <math id="A4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\mathrm{numK}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{numK}({\bm{y}})</annotation></semantics></math> will be monotonic decrease for <math id="A4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="R^{\leftarrow}_{t}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\leftarrow}_{t}({\bm{y}})</annotation></semantics></math> (from <math id="A4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> to <math id="A4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>).
Since the dominating term in the complexity analysis of truncated uniformization is <math id="A4.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\beta_{t}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\beta_{t}</annotation></semantics></math>, the discrete diffusion models with absorbing forward process are expected to have a better result.
The mechanism of the acceleration can be explained in one sentence, i.e.,</p>
<p id="A4.Thmtheorem1.p1.4" class="ltx_p ltx_align_center ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:9.0pt;"><em id="A4.Thmtheorem1.p1.4.1" class="ltx_emph ltx_font_italic">At each uniformization step, absorbing the discrete diffusion model knows the token needs (masked token)/ or does not need (unmasked token) to denoise, and an unmasked token will not be denoised twice.</em></p>
<p id="A4.Thmtheorem1.p1.5" class="ltx_p">Rigorously, this property can be summarized by Lemma <a href="#A4.Thmtheorem2" title="Lemma D.2. ‣ D.1 The Proof of Lemma ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>.</p>
</div>
</div>
<div id="A4.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma D.2</span></span><span id="A4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem2.p1" class="ltx_para">
<p id="A4.Thmtheorem2.p1.1" class="ltx_p"><span id="A4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumption <a href="#S3.I1.i2" title="item [A2] ‣ Additional settings. ‣ 3 The Forward Process of Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">[A2]</span></a> hold, and <math id="A4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="0&lt;t_{0}\leq t" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>t</mi><mn>0</mn></msub><mo>≤</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">0&lt;t_{0}\leq t</annotation></semantics></math>, we have <math id="A4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\not=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐲</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\not=0</annotation></semantics></math> if and only if</span></p>
<table id="A4.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex118.m1" class="ltx_math_unparsed" alttext="{\bm{y}}\in{\mathcal{Y}}^{\leftarrow}({\bm{y}}_{0})=\left\{{\bm{y}}^{\prime}|\forall i,\quad{\bm{y}}_{0,i}=K\ \text{or}\ {\bm{y}}^{\prime}_{i}={\bm{y}}_{0,i}\right\}." display="block" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">←</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo rspace="1.167em">,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>K</mi><mtext class="ltx_mathvariant_italic">or</mtext><msubsup><mi>𝒚</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{y}}\in{\mathcal{Y}}^{\leftarrow}({\bm{y}}_{0})=\left\{{\bm{y}}^{\prime}|\forall i,\quad{\bm{y}}_{0,i}=K\ \text{or}\ {\bm{y}}^{\prime}_{i}={\bm{y}}_{0,i}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.3" class="ltx_p"><span id="A4.SS1.p2.3.1" class="ltx_text">According to the Bayes’ theorem, for any <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="t\geq t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t\geq t_{0}</annotation></semantics></math>, it has</span></p>
<table id="A4.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E55X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55X.m2" class="ltx_Math" alttext="\displaystyle q^{\leftarrow}_{t,t_{0}}({\bm{y}},{\bm{y}}_{0})=q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\leftarrow}_{t_{0}}({\bm{y}}_{0})=q^{\to}_{T-t,T-t_{0}}({\bm{y}},{\bm{y}}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">←</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q^{\leftarrow}_{t,t_{0}}({\bm{y}},{\bm{y}}_{0})=q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\cdot q^{\leftarrow}_{t_{0}}({\bm{y}}_{0})=q^{\to}_{T-t,T-t_{0}}({\bm{y}},{\bm{y}}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(55)</span></td></tr>
<tr id="A4.E55Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55Xa.m2" class="ltx_Math" alttext="\displaystyle=q^{\to}_{T-t_{0},T-t}({\bm{y}}_{0},{\bm{y}})=q^{\to}_{T-t_{0}|T-t}({\bm{y}}_{0}|{\bm{y}})\cdot q^{\to}_{T-t}({\bm{y}})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">→</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q^{\to}_{T-t_{0},T-t}({\bm{y}}_{0},{\bm{y}})=q^{\to}_{T-t_{0}|T-t}({\bm{y}}_{0}|{\bm{y}})\cdot q^{\to}_{T-t}({\bm{y}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p2.4" class="ltx_p"><span id="A4.SS1.p2.4.1" class="ltx_text">where the third equation follows from the reversibility of the absorbing forward process shown in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Campbell et al. [2022]</a></cite>.
Following from the forward transition kernel shown in Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5 (Forward transition kernel). ‣ B.3 The Proof of Lemma ‣ Appendix B The Markov Processes of Discrete Diffusion Models ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>, we know that</span></p>
<table id="A4.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E56.m1" class="ltx_math_unparsed" alttext="q^{\to}_{T-t_{0}|T-t}({\bm{y}}_{0}|{\bm{y}})\not=0\quad\Leftrightarrow\quad{\bm{y}}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})=\left\{{\bm{y}}^{\prime}|\ \forall i,\quad{\bm{y}}^{\prime}_{i}={\bm{y}}_{i}\ \text{or}\ {\bm{y}}^{\prime}_{i}=K\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo fence="false">|</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow><mo stretchy="false">→</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mn>0</mn><mo stretchy="false">⇔</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">→</mo></msup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo rspace="1.167em">,</mo><msubsup><mi>𝒚</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>𝒚</mi><mi>i</mi></msub><mtext>or</mtext><msubsup><mi>𝒚</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><mi>K</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q^{\to}_{T-t_{0}|T-t}({\bm{y}}_{0}|{\bm{y}})\not=0\quad\Leftrightarrow\quad{\bm{y}}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})=\left\{{\bm{y}}^{\prime}|\ \forall i,\quad{\bm{y}}^{\prime}_{i}={\bm{y}}_{i}\ \text{or}\ {\bm{y}}^{\prime}_{i}=K\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.5" class="ltx_p"><span id="A4.SS1.p2.5.1" class="ltx_text">Combining Assumption <a href="#S3.I1.i2" title="item [A2] ‣ Additional settings. ‣ 3 The Forward Process of Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">[A2]</span></a> and Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5 (Forward transition kernel). ‣ B.3 The Proof of Lemma ‣ Appendix B The Markov Processes of Discrete Diffusion Models ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>, we have <math id="A4.SS1.p2.m2" class="ltx_Math" alttext="q^{\to}_{\tau}({\bm{y}})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mi>τ</mi><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q^{\to}_{\tau}({\bm{y}})&gt;0</annotation></semantics></math> for all <math id="A4.SS1.p2.m3" class="ltx_Math" alttext="{\bm{y}}\in{\mathcal{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><annotation encoding="application/x-tex">{\bm{y}}\in{\mathcal{Y}}</annotation></semantics></math>, which implies</span></p>
<table id="A4.E57" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E57X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E57X.m2" class="ltx_Math" alttext="\displaystyle q^{\leftarrow}_{t_{0}}({\bm{y}}_{0})=q^{\to}_{T-t_{0}}({\bm{y}}_{0})&gt;0\quad\text{and}\quad q^{\to}_{t}({\bm{y}})&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>q</mi><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">→</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle q^{\leftarrow}_{t_{0}}({\bm{y}}_{0})=q^{\to}_{T-t_{0}}({\bm{y}}_{0})&gt;0\quad\text{and}\quad q^{\to}_{t}({\bm{y}})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.6" class="ltx_p"><span id="A4.SS1.p2.6.1" class="ltx_text">Then, we can summarize</span></p>
<table id="A4.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex119.m1" class="ltx_math_unparsed" alttext="q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\not=0\quad\Leftrightarrow\quad{\bm{y}}\in{\mathcal{Y}}^{\leftarrow}({\bm{y}}_{0})=\left\{{\bm{y}}^{\prime}|\forall i,\quad{\bm{y}}_{0,i}=K\ \text{or}\ {\bm{y}}^{\prime}_{i}={\bm{y}}_{0,i}\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo stretchy="false">←</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>≠</mo><mn>0</mn><mo stretchy="false">⇔</mo><mi>𝒚</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">←</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo rspace="1.167em">,</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>K</mi><mtext>or</mtext><msubsup><mi>𝒚</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>𝒚</mi><mrow><mn>0</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q^{\leftarrow}_{t|t_{0}}({\bm{y}}|{\bm{y}}_{0})\not=0\quad\Leftrightarrow\quad{\bm{y}}\in{\mathcal{Y}}^{\leftarrow}({\bm{y}}_{0})=\left\{{\bm{y}}^{\prime}|\forall i,\quad{\bm{y}}_{0,i}=K\ \text{or}\ {\bm{y}}^{\prime}_{i}={\bm{y}}_{0,i}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p2.7" class="ltx_p"><span id="A4.SS1.p2.7.1" class="ltx_text">Hence, the proof is completed.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>The convergence of Alg. <a href="#alg1" title="Algorithm 1 ‣ Mask-aware truncation and algorithm proposal. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.2" class="ltx_p">Suppose, with the infinitesimal reverse transition rate, the particles in Alg. <a href="#alg1" title="Algorithm 1 ‣ Mask-aware truncation and algorithm proposal. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> during the reverse process are denotes as random variables <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="\{\hat{{\mathbf{y}}}_{t}\}_{t=0}^{T-\delta}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msubsup><annotation encoding="application/x-tex">\{\hat{{\mathbf{y}}}_{t}\}_{t=0}^{T-\delta}</annotation></semantics></math>, whose underlying distributions are <math id="A4.SS2.p1.m2" class="ltx_Math" alttext="\hat{q}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{q}_{t}</annotation></semantics></math>.
Then, the implementation will be equivalent to the following Poisson process.
For <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="t\in(t_{w-1},t_{w}]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>t</mi><mi>w</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(t_{w-1},t_{w}]</annotation></semantics></math>, <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="\hat{{\mathbf{y}}}_{t_{w-1}}={\bm{y}}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>=</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{y}}}_{t_{w-1}}={\bm{y}}_{0}</annotation></semantics></math> and <math id="A4.SS2.p1.m5" class="ltx_Math" alttext="\hat{{\mathbf{y}}}_{t}={\bm{y}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mi>𝒚</mi></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{y}}}_{t}={\bm{y}}</annotation></semantics></math>,</p>
<ol id="A4.I1" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p">With probability <math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})</annotation></semantics></math>, allow a state transition.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p">Conditioning on an allowed transition, move from <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math> to <math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="{\bm{y}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝒚</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{y}}^{\prime}</annotation></semantics></math> with probability</p>
<table id="A4.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex120.m1" class="ltx_math_unparsed" alttext="\hat{{\bm{M}}}_{t|t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=\left\{\begin{aligned} &amp;\beta_{t_{w}}^{-1}({\bm{y}}_{0})\cdot\hat{R}_{t}({\bm{y}}^{\prime},{\bm{y}})&amp;&{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\beta_{t_{w}}^{-1}({\bm{y}}_{0})\hat{R}_{t}({\bm{y}})&amp;&amp;\text{otherwise}\end{aligned}\right.." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑴</mi><mo>^</mo></mover><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msubsup><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\bm{M}}}_{t|t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=\left\{\begin{aligned} &amp;\beta_{t_{w}}^{-1}({\bm{y}}_{0})\cdot\hat{R}_{t}({\bm{y}}^{\prime},{\bm{y}})&amp;&amp;{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\beta_{t_{w}}^{-1}({\bm{y}}_{0})\hat{R}_{t}({\bm{y}})&amp;&amp;\text{otherwise}\end{aligned}\right..</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A4.SS2.p1.3" class="ltx_p">Here we should note that</p>
<table id="A4.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex121.m1" class="ltx_Math" alttext="\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})\leq\beta_{t}({\bm{y}})=K\cdot\mathrm{numK}\left({\bm{y}}\right)\cdot\frac{1}{e^{T-t}-1}\leq K\cdot\mathrm{numK}\left({\bm{y}}_{0}\right)\cdot\frac{1}{e^{T-t_{w}}-1}=\beta_{t_{w}}({\bm{y}}_{0})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo>(</mo><mi>𝒚</mi><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>≤</mo><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>w</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>=</mo><mrow><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})\leq\beta_{t}({\bm{y}})=K\cdot\mathrm{numK}\left({\bm{y}}\right)\cdot\frac{1}{e^{T-t}-1}\leq K\cdot\mathrm{numK}\left({\bm{y}}_{0}\right)\cdot\frac{1}{e^{T-t_{w}}-1}=\beta_{t_{w}}({\bm{y}}_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p1.4" class="ltx_p">where the second inequality established since <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="\mathrm{numK}\left(\hat{{\mathbf{y}}}_{t}\right)\leq\mathrm{numK}\left(\hat{{\mathbf{y}}}_{t_{w-1}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><mi>t</mi></msub><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>numK</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{numK}\left(\hat{{\mathbf{y}}}_{t}\right)\leq\mathrm{numK}\left(\hat{{\mathbf{y}}}_{t_{w-1}}\right)</annotation></semantics></math> and <math id="A4.SS2.p1.m7" class="ltx_Math" alttext="(e^{T-t}-1)^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">(e^{T-t}-1)^{-1}</annotation></semantics></math> is monotonic increasing.
Under these two steps, the practical conditional probability satisfies</p>
<table id="A4.E58" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E58X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E58X.m2" class="ltx_Math" alttext="\displaystyle\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E58X.m3" class="ltx_Math" alttext="\displaystyle\left\{\begin{aligned} &amp;\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})\cdot\beta^{-1}_{t_{w}}({\bm{y}}_{0})&amp;&{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})+\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})\cdot(1-\beta_{t_{w}}({\bm{y}}_{0})^{-1}\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}))&amp;&{\bm{y}}^{\prime}={\bm{y}},\end{aligned}\right." display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><msub><mi>β</mi><msub><mi>t</mi><mi>w</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>=</mo><mi>𝒚</mi></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\begin{aligned} &amp;\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})\cdot\beta^{-1}_{t_{w}}({\bm{y}}_{0})&amp;&amp;{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})+\Delta t\cdot\beta_{t_{w}}({\bm{y}}_{0})\cdot(1-\beta_{t_{w}}({\bm{y}}_{0})^{-1}\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}))&amp;&amp;{\bm{y}}^{\prime}={\bm{y}},\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(58)</span></td></tr>
<tr id="A4.E58Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E58Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E58Xa.m3" class="ltx_Math" alttext="\displaystyle\left\{\begin{aligned} &amp;\Delta t\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})&amp;&{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\Delta t\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})&amp;&{\bm{y}}^{\prime}={\bm{y}}\end{aligned}\right.." display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>=</mo><mi>𝒚</mi></mrow></mtd></mtr></mtable><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\begin{aligned} &amp;\Delta t\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})&amp;&amp;{\bm{y}}^{\prime}\not={\bm{y}}\\
&amp;1-\Delta t\cdot\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})&amp;&amp;{\bm{y}}^{\prime}={\bm{y}}\end{aligned}\right..</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma D.3</span></span><span id="A4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem3.p1" class="ltx_para">
<p id="A4.Thmtheorem3.p1.1" class="ltx_p"><span id="A4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Following the notations shown in Section <a href="#A1" title="Appendix A Notation Summary ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>, we have</span></p>
<table id="A4.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex122.m1" class="ltx_Math" alttext="\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]=\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]=\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p"><span id="A4.SS2.p2.1.1" class="ltx_text">Since we have required <math id="A4.SS2.p2.m1" class="ltx_Math" alttext="\Delta t\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta t\rightarrow 0</annotation></semantics></math>, for any <math id="A4.SS2.p2.m2" class="ltx_Math" alttext="{\bm{y}}^{\prime}\not={\bm{y}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow><annotation encoding="application/x-tex">{\bm{y}}^{\prime}\not={\bm{y}}</annotation></semantics></math>, it has</span></p>
<table id="A4.Ex123" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex123X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex123X.m2" class="ltx_Math" alttext="\displaystyle\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\rightarrow\hat{q}_{t|t}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mi>t</mi><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\rightarrow\hat{q}_{t|t}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex123Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex123Xa.m2" class="ltx_Math" alttext="\displaystyle\text{and}\quad q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{\leftarrow}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0," display="inline" intent=":literal"><semantics><mrow><mrow><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{and}\quad q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})=q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\rightarrow q^{\leftarrow}_{t|t}({\bm{y}}^{\prime}|{\bm{y}})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p2.2" class="ltx_p"><span id="A4.SS2.p2.2.1" class="ltx_text">where the first row follows from Eq. (<a href="#A4.E58" title="In D.2 The convergence of Alg. ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">58</span></a>) and the second row follows from Lemma. <a href="#S2.Thmtheorem1" title="Lemma 2.1 (Adapted from Eqs. (3) and (4) of ( ) ). ‣ The reverse process notations. ‣ 2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>.
This automatically makes</span></p>
<table id="A4.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex124.m1" class="ltx_Math" alttext="\left|\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right|\leq\frac{1}{2}&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac><mo>|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right|\leq\frac{1}{2}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p2.3" class="ltx_p"><span id="A4.SS2.p2.3.1" class="ltx_text">Under this condition, we have</span></p>
<table id="A4.Ex125" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex125X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex125X.m2" class="ltx_Math" alttext="\displaystyle\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}=\ln\left[1+\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}=\ln\left[1+\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex125Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
