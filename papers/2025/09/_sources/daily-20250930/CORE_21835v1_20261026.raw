<tr id="A3.E47Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E47Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47Xb.m3" class="ltx_Math" alttext="\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\frac{R_{t}^{\leftarrow}({\bm{y}}^{\prime},{\bm{y}})}{\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\frac{R_{t}^{\leftarrow}({\bm{y}}^{\prime},{\bm{y}})}{\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.7" class="ltx_p">where the second equation follows from the composition rule of the limit calculation.
For Term 1.2, we have</p>
<table id="A3.E48" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E48X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E48X.m2" class="ltx_Math" alttext="\displaystyle" display="inline" intent=":literal"><semantics><mphantom></mphantom><annotation encoding="application/x-tex">\displaystyle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E48X.m3" class="ltx_Math" alttext="\displaystyle\text{Term 1.2}=\lim_{\Delta t\rightarrow 0}\left[1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right]\cdot\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]" display="inline" intent=":literal"><semantics><mrow><mtext>Term 1.2</mtext><mo rspace="0.1389em">=</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">]</mo></mrow></mrow><mo>⋅</mo><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Term 1.2}=\lim_{\Delta t\rightarrow 0}\left[1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right]\cdot\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(48)</span></td></tr>
<tr id="A3.E48Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E48Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\tilde{R}_{kh}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.8" class="ltx_p">where the first inequality follows from Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>.
Plugging Eq. (<a href="#A3.E47" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">47</span></a>), Eq. (<a href="#A3.E48" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>) and Eq. (<a href="#A3.E46" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>), into Eq. (<a href="#A3.E45" title="In Bound for TV(𝑞^{𝐸⁢𝐼}_{𝑇-𝛿},𝑞^←_{𝑇-𝛿}). ‣ C.1 Proof of Theorem ‣ Appendix C Euler Discretization Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>) we have</p>
<table id="A3.E49" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E49X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
