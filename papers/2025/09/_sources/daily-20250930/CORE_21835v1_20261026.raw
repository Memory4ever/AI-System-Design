<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\frac{R_{t}^{\leftarrow}({\bm{y}}^{\prime},{\bm{y}})}{\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})}+\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\frac{R_{t}^{\leftarrow}({\bm{y}}^{\prime},{\bm{y}})}{\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})}+\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}\tilde{R}_{kh}({\bm{y}}^{\prime},{\bm{y}})-\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)</annotation></semantics></math></td>
