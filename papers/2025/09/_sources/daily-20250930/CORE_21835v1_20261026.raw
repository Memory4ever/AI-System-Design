<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex126X.m2" class="ltx_Math" alttext="\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]</annotation></semantics></math></td>
