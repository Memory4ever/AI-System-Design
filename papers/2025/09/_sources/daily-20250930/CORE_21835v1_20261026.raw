<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot\left[-\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}\ln\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></munder></mstyle><mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msup><mi>R</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>𝒚</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}\in{\mathcal{Y}}}q^{\leftarrow}_{t}({\bm{y}})\cdot\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R^{\to}({\bm{y}},{\bm{y}}^{\prime})\cdot\left[-\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}+\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})+\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})}\ln\frac{q_{t}^{\leftarrow}({\bm{y}}^{\prime})}{q^{\leftarrow}_{t}({\bm{y}})\tilde{v}_{kh,{\bm{y}}}({\bm{y}}^{\prime})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E49Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
