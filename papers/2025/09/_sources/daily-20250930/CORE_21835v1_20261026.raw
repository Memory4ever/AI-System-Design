<tr id="A3.E46Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E46Xb.m2" class="ltx_Math" alttext="\displaystyle\underbrace{\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]}_{\text{Term 1.2}}." display="inline" intent=":literal"><semantics><mrow><munder><munder accentunder="true"><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 1.2</mtext></munder><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]}_{\text{Term 1.2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.6" class="ltx_p">For Term 1.1, we have</p>
<table id="A3.E47" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E47X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
