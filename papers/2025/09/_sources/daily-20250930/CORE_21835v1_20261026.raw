<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E62X.m3" class="ltx_Math" alttext="\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\lim_{\Delta t\rightarrow 0}\left[\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\Delta t}\right]\cdot\lim_{\Delta t\rightarrow 0}\left[\ln\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow></mrow></mrow><mo>⋅</mo><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mst