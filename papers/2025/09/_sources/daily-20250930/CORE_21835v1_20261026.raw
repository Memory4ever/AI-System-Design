<span id="A1.T2.4.19.2.1" class="ltx_inline-block ltx_align_top" style="width:258.8pt;">
<span id="A1.T2.4.19.2.1.1" class="ltx_p"><span id="A1.T2.4.19.2.1.1.1" class="ltx_text" style="font-size:90%;">Total reverse transition rate out of state </span><math id="A1.T2.m42" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math><span id="A1.T2.4.19.2.1.1.2" class="ltx_text" style="font-size:90%;"> for each rate type, defined as </span><math id="A1.T2.m43" class="ltx_Math" alttext="R({\bm{y}})\coloneqq\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R({\bm{y}}^{\prime},{\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">R</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.111em">≔</mo><mrow><msub><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∑</mo><mrow><msup><mi mathsize="0.900em">𝒚</mi><mo mathsize="0.900em">′</mo></msup><mo mathsize="0.900em">≠</mo><mi mathsize="0.900em">𝒚</mi></mrow></msub><mrow><mi mathsize="0.900em">R</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">𝒚</mi><mo mathsize="0.900em">′</mo></msup><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R({\bm{y}})\coloneqq\sum_{{\bm{y}}^{\prime}\neq{\bm{y}}}R({\bm{y}}^{\prime},{\bm{y}})</annotation></semantics></math><span id="A1.T2.4.19.2.1.1.3" class="ltx_text" style="font-size:90%;"> with </span><math id="A1.T2.m44" class="ltx_Math" alttext="R\in\{R^{\leftarrow}_{t},\ \tilde{R}_{t},\ \hat{R}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">R</mi><mo mathsize="0.900em">∈</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.900em">R</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em" stretchy="false">←</mo></msubsup><mo mathsize="0.900em" rspace="0.627em">,</mo><msub><mover accent="true"><mi mathsize="0.900em">R</mi><mo>~</mo></mover><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em" rspace="0.627em">,</mo><msub><mover accent="true"><mi mathsize="0.900em">R</mi><mo>^</mo></mover><mi mathsize="0.900em">t</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R\in\{R^{\leftarrow}_{t},\ \tilde{R}_{t},\ \hat{R}_{t}\}</annotation></semantics></math></span>
</span></td></tr>
