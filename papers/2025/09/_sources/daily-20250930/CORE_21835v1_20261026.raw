<span id="A1.T2.4.1.2.1.1" class="ltx_p"><span id="A1.T2.4.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Description</span></span>
</span></td></tr>
<tr id="A1.T2.4.2" class="ltx_tr">
<td id="A1.T2.4.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T2.m1" class="ltx_Math" alttext="q_{*}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">q</mi><mo mathsize="0.900em">∗</mo></msub><annotation encoding="application/x-tex">q_{*}</annotation></semantics></math></td>
