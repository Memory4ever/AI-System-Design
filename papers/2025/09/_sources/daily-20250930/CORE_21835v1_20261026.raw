<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex125Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\left[\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]^{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>i</mi></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow><mi>i</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{\infty}\frac{(-1)^{i+1}}{i}\cdot\left[\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]^{i},</annotation></semantics></math></td>
