<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex126Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)^{i}}." display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.222em">⋅</mo><mrow><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mi>i</mi></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)^{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p2.5" class="ltx_p"><span id="A4.SS2.p2.5.1" class="ltx_text">Only when <math id="A4.SS2.p2.m3" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>, we have</span></p>
<table id="A4.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex127.m1" class="ltx_Math" alttext="\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mfrac><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mi>i</mi></msup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lim_{\Delta t\rightarrow 0}\frac{\left(\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)\right)^{i-1}}{\left(1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})\right)^{i}}=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p2.6" class="ltx_p"><span id="A4.SS2.p2.6.1" class="ltx_text">otherwise it will be equivalent to <math id="A4.SS2.p2.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
Therefore, we have</span></p>
<table id="A4.Ex128" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex128X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex128X.m2" class="ltx_Math" alttext="\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\ln\frac{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{1-\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex128Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex128Xa.m2" class="ltx_Math" alttext="\displaystyle=\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{\Delta t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></msub><mrow><mo lspace="0em">(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\Delta t\rightarrow 0}\frac{\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})-q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\right)}{\Delta t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex128Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex128Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\left(\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}}^{\prime},{\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\right)=\hat{R}_{t,{\bm{y}}_{0}}({\bm{y}})-R^{\leftarrow}_{t}({\bm{y}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p2.7" class="ltx_p"><span id="A4.SS2.p2.7.1" class="ltx_text">where the second equation follows from Eq. (<a href="#A4.E58" title="In D.2 The convergence of Alg. ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">58</span></a>) and the second row follows from Lemma. <a href="#S2.Thmtheorem1" title="Lemma 2.1 (Adapted from Eqs. (3) and (4) of ( ) ). ‣ The reverse process notations. ‣ 2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>.
Hence, the proof is completed.
∎</span></p>
</div>
</div>
<div id="A4.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem D.4</span></span><span id="A4.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(The convergence of Alg. <a href="#alg1" title="Algorithm 1 ‣ Mask-aware truncation and algorithm proposal. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)<span id="A4.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem4.p1" class="ltx_para">
<p id="A4.Thmtheorem4.p1.1" class="ltx_p"><span id="A4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumption <a href="#S2.I1.i1" title="item [A1] ‣ General Assumptions. ‣ 2 Preliminaries ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">[A1]</span></a> and <a href="#S3.I1.i2" title="item [A2] ‣ Additional settings. ‣ 3 The Forward Process of Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">[A2]</span></a> hold, if
Alg. <a href="#alg1" title="Algorithm 1 ‣ Mask-aware truncation and algorithm proposal. ‣ 5 Truncated Uniformization in Masked Discrete Diffusion ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> has</span></p>
<table id="A4.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex129.m1" class="ltx_math_unparsed" alttext="t_{0}=0,\quad t_{W}=T-\delta,\quad\text{and}\quad\epsilon_{\text{score}}\leq T^{-1/2}\cdot\epsilon\quad\text{where}\quad T=\ln(4d/\epsilon^{2})\quad\text{and}\quad\delta\leq d^{-1}\epsilon," display="block" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn><mo rspace="1.167em">,</mo><msub><mi>t</mi><mi>W</mi></msub><mo>=</mo><mi>T</mi><mo>−</mo><mi>δ</mi><mo rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">and</mtext><msub><mi>ϵ</mi><mtext class="ltx_mathvariant_italic">score</mtext></msub><mo>≤</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ϵ</mi><mtext class="ltx_mathvariant_italic">where</mtext><mi>T</mi><mo>=</mo><mi>ln</mi><mrow><mo stretchy="false">(</mo><mn>4</mn><mi>d</mi><mo>/</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mtext class="ltx_mathvariant_italic">and</mtext><mi>δ</mi><mo>≤</mo><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>ϵ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">t_{0}=0,\quad t_{W}=T-\delta,\quad\text{and}\quad\epsilon_{\text{score}}\leq T^{-1/2}\cdot\epsilon\quad\text{where}\quad T=\ln(4d/\epsilon^{2})\quad\text{and}\quad\delta\leq d^{-1}\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmtheorem4.p1.2" class="ltx_p"><span id="A4.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">the TV distance between the target discrete distribution <math id="A4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="q_{*}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">q_{*}</annotation></semantics></math> and the underlying distribution of the output particle <math id="A4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\hat{q}_{T-\delta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><annotation encoding="application/x-tex">\hat{q}_{T-\delta}</annotation></semantics></math> will satisfy <math id="A4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathrm{TV}\left(q_{*},\hat{q}_{T-\delta}\right)\leq 2\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>q</mi><mo>∗</mo></msub><mo>,</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>δ</mi></mrow></msub><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{TV}\left(q_{*},\hat{q}_{T-\delta}\right)\leq 2\epsilon</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS2.p3" class="ltx_para">
<p id="A4.SS2.p3.9" class="ltx_p"><span id="A4.SS2.p3.9.1" class="ltx_text">Here we provide the upper bound of TV distance accumulation in a specific segment, e.g., from <math id="A4.SS2.p3.m1" class="ltx_Math" alttext="t_{w-1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">t_{w-1}</annotation></semantics></math> to <math id="A4.SS2.p3.m2" class="ltx_Math" alttext="t_{w}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>w</mi></msub><annotation encoding="application/x-tex">t_{w}</annotation></semantics></math>.
According to the chain rule of KL divergence, i.e., Lemma <a href="#A5.Thmtheorem4" title="Lemma E.4 (The chain rule of KL divergence). ‣ Appendix E Technical Lemmas ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.4</span></a>, we have</span></p>
<table id="A4.E59" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E59X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E59X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{KL}\left(q^{\leftarrow}_{t_{w}}\big\|\hat{q}_{t_{w}}\right)\leq\mathrm{KL}\left(q^{\leftarrow}_{t_{w-1}}\big\|\hat{q}_{t_{w-1}}\right)+\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t_{w}|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t_{w}|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><msub><mi>t</mi><mi>w</mi></msub></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><msub><mi>t</mi><mi>w</mi></msub></msub><mo>)</mo><mo>≤</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>)</mo><mo>+</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><msub><mi>t</mi><mi>w</mi></msub><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><msub><mi>t</mi><mi>w</mi></msub><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{KL}\left(q^{\leftarrow}_{t_{w}}\big\|\hat{q}_{t_{w}}\right)\leq\mathrm{KL}\left(q^{\leftarrow}_{t_{w-1}}\big\|\hat{q}_{t_{w-1}}\right)+\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t_{w}|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t_{w}|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(59)</span></td></tr>
<tr id="A4.E59Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E59Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{KL}\left(q^{\leftarrow}_{t_{w-1}}\big\|\hat{q}_{t_{w-1}}\right)+\int_{t_{w-1}}^{t_{w}}\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>)</mo><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><msup><mrow></mrow><msub><mi>t</mi><mi>w</mi></msub></msup><mi>d</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{KL}\left(q^{\leftarrow}_{t_{w-1}}\big\|\hat{q}_{t_{w-1}}\right)+\int_{t_{w-1}}^{t_{w}}\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p3.10" class="ltx_p"><span id="A4.SS2.p3.10.1" class="ltx_text">Then, it has</span></p>
<table id="A4.Ex130" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex130X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex130X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}^{\leftarrow}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}^{\leftarrow}_{0})\right)\right]/\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo><mo>/</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}^{\leftarrow}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}^{\leftarrow}_{0})\right)\right]/\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex130Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex130Xa.m2" class="ltx_Math" alttext="\displaystyle=\lim_{\Delta\rightarrow 0}\ (\Delta t)^{-1}\cdot\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t+\Delta t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)-\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><msub><mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\Delta\rightarrow 0}\ (\Delta t)^{-1}\cdot\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t+\Delta t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)-\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex130Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex130Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\lim_{\Delta\rightarrow 0}\ (\Delta t)^{-1}\cdot\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathbb{E}_{{\mathbf{y}}\sim q^{\leftarrow}_{t|{t_{w-1}}}(\cdot|{\mathbf{y}}_{0})}\left(\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}(\cdot|{\mathbf{y}},{\mathbf{y}}_{0})\big\|\hat{q}_{t+\Delta t|t,t_{w-1}}(\cdot|{\mathbf{y}},{\mathbf{y}}_{0})\right)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><msub><mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></msub><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝐲</mi><mo>∼</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>(</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><mo>,</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><mo>,</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\lim_{\Delta\rightarrow 0}\ (\Delta t)^{-1}\cdot\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathbb{E}_{{\mathbf{y}}\sim q^{\leftarrow}_{t|{t_{w-1}}}(\cdot|{\mathbf{y}}_{0})}\left(\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}(\cdot|{\mathbf{y}},{\mathbf{y}}_{0})\big\|\hat{q}_{t+\Delta t|t,t_{w-1}}(\cdot|{\mathbf{y}},{\mathbf{y}}_{0})\right)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p3.11" class="ltx_p"><span id="A4.SS2.p3.11.1" class="ltx_text">where the inequality follows from the chain rule of the KL divergence, i.e., Lemma <a href="#A5.Thmtheorem4" title="Lemma E.4 (The chain rule of KL divergence). ‣ Appendix E Technical Lemmas ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.4</span></a>. Then, it has</span></p>
<table id="A4.E60" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E60X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]/\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>𝐲</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>q</mi><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo></msubsup></mrow></msub><mo>[</mo><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo fence="false">|</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐲</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo><mo>/</mo><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{d}\mathbb{E}_{{\mathbf{y}}_{0}\sim q^{\leftarrow}_{t_{w-1}}}\left[\mathrm{KL}\left(q^{\leftarrow}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\big\|\hat{q}_{t|t_{w-1}}(\cdot|{\mathbf{y}}_{0})\right)\right]/\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(60)</span></td></tr>
<tr id="A4.E60Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{{\bm{y}}\in{\mathcal{Y}},{\bm{y}}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})}q^{\leftarrow}_{t,t_{w-1}}({\bm{y}},{\bm{y}}_{0})\cdot\underbrace{\lim_{\Delta t\to 0}\left[\frac{\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}(\cdot|{\bm{y}},{\bm{y}}_{0})\big\|\hat{q}_{t+\Delta t|t,t_{w-1}}(\cdot|{\bm{y}},{\bm{y}}_{0})\right)}{\Delta t}\right]}_{\text{Term 1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>𝒚</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><mo>,</mo><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo mathsize="0.700em">,</mo><msub><mi>𝒚</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo>⋅</mo><munder><munder accentunder="true"><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>KL</mi><mo>(</mo><mi>q</mi><msup><mrow></mrow><mo stretchy="false">←</mo></msup><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒚</mi><mo>,</mo><mi>𝒚</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 1</mtext></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{{\bm{y}}\in{\mathcal{Y}},{\bm{y}}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})}q^{\leftarrow}_{t,t_{w-1}}({\bm{y}},{\bm{y}}_{0})\cdot\underbrace{\lim_{\Delta t\to 0}\left[\frac{\mathrm{KL}\left(q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}(\cdot|{\bm{y}},{\bm{y}}_{0})\big\|\hat{q}_{t+\Delta t|t,t_{w-1}}(\cdot|{\bm{y}},{\bm{y}}_{0})\right)}{\Delta t}\right]}_{\text{Term 1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p3.12" class="ltx_p"><span id="A4.SS2.p3.12.1" class="ltx_text">where the inequality and the notation <math id="A4.SS2.p3.m3" class="ltx_Math" alttext="{\mathcal{Y}}^{\to}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{Y}}^{\to}(\cdot)</annotation></semantics></math> follows from Lemma <a href="#A4.Thmtheorem2" title="Lemma D.2. ‣ D.1 The Proof of Lemma ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>.
For each <math id="A4.SS2.p3.m4" class="ltx_Math" alttext="{\bm{y}}^{\leftarrow}\in{\mathcal{Y}},{\bm{y}}^{\leftarrow}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒚</mi><mo stretchy="false">←</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><mo>,</mo><mrow><msubsup><mi>𝒚</mi><mn>0</mn><mo stretchy="false">←</mo></msubsup><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">→</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}^{\leftarrow}\in{\mathcal{Y}},{\bm{y}}^{\leftarrow}_{0}\in{\mathcal{Y}}^{\to}({\bm{y}})</annotation></semantics></math>, we focus on Term 1 of Eq. (<a href="#A4.E60" title="In Proof. ‣ D.2 The convergence of Alg. ‣ Appendix D Truncated Uniformization Inference Analysis ‣ On the Complexity Theory of Masked Discrete Diffusion: From poly(1/ϵ) to Nearly ϵ-Free" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>), and have</span></p>
<table id="A4.E61" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E61X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61X.m2" class="ltx_Math" alttext="\displaystyle\text{Term 1}" display="inline" intent=":literal"><semantics><mtext>Term 1</mtext><annotation encoding="application/x-tex">\displaystyle\text{Term 1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61X.m3" class="ltx_Math" alttext="\displaystyle=\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\sum_{{\bm{y}}^{\prime}\in{\mathcal{Y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\cdot\ln\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\Delta t\rightarrow 0}\left[\Delta t^{-1}\cdot\sum_{{\bm{y}}^{\prime}\in{\mathcal{Y}}}q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})\cdot\ln\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(61)</span></td></tr>
<tr id="A4.E61Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61Xa.m2" class="ltx_Math" alttext="\displaystyle=\underbrace{\lim_{\Delta t\rightarrow 0}\left[\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\Delta t}\cdot\ln\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]}_{\text{Term 1.1}}+" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><munder accentunder="true"><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>t</mi><mo>,</mo><msub><mi>t</mi><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mi>𝒚</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Term 1.1</mtext></munder><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\lim_{\Delta t\rightarrow 0}\left[\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\Delta t}\cdot\ln\frac{q^{\leftarrow}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}{\hat{q}_{t+\Delta t|t,t_{w-1}}({\bm{y}}^{\prime}|{\bm{y}},{\bm{y}}_{0})}\right]}_{\text{Term 1.1}}+</annotation></semantics></math></td>
