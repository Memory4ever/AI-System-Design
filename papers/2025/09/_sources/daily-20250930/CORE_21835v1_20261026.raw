<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47X.m3" class="ltx_Math" alttext="\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\lim_{\Delta t\rightarrow 0}\left[\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{\Delta t}\right]\cdot\lim_{\Delta t\rightarrow 0}\left[\ln\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo rspace="0.055em">]</mo></mrow></mrow></mrow><mo>⋅</mo><mrow><munder><mo lspace="0.055em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}\lim_{\Delta t\rightarrow 0}\left[\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{\Delta t}\right]\cdot\lim_{\Delta t\rightarrow 0}\left[\ln\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(47)</span></td></tr>
<tr id="A3.E47Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E47Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47Xa.m3" class="ltx_Math" alttext="\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\left[\lim_{\Delta t\rightarrow 0}\left(\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{\Delta t}\cdot\frac{\Delta t}{q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝒚</mi><mo>′</mo></msup><mo>≠</mo><mi>𝒚</mi></mrow></munder></mstyle><mrow><msubsup><mi>R</mi><mi>t</mi><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mo stretchy="false">←</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><msubsup><mi>q</mi><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{{\bm{y}}^{\prime}\not={\bm{y}}}R^{\leftarrow}_{t}({\bm{y}}^{\prime},{\bm{y}})\cdot\ln\left[\lim_{\Delta t\rightarrow 0}\left(\frac{q^{\leftarrow}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}{\Delta t}\cdot\frac{\Delta t}{q^{EI}_{t+\Delta t|t}({\bm{y}}^{\prime}|{\bm{y}})}\right)\right]</annotation></semantics></math></td>
