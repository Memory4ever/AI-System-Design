<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex11.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad\cdot\min\left\{|r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})|,\big[r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})\big]^{2}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="4.222em" rspace="0.222em">⋅</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\cdot\min\left\{|r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})|,\big[r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})\big]^{2}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E1.m1" class="ltx_Math" alttext="\displaystyle\qquad\geq\frac{1}{16r_{\max}}\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\sigma(r^{\star}(a_{2}^{i})-r^{\star}(a_{1}^{i}))\big[r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})\big]^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\geq\frac{1}{16r_{\max}}\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\sigma(r^{\star}(a_{2}^{i})-r^{\star}(a_{1}^{i}))\big[r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})\big]^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.1)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.6" class="ltx_p">where the last step follows from <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="|r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})|\leq 4r_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|r(a_{1}^{i})-r(a_{2}^{i})-r^{\star}(a_{1}^{i})+r^{\star}(a_{2}^{i})|\leq 4r_{\max}</annotation></semantics></math>.
Therefore we have</p>
<table id="A3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex12.m1" class="ltx_math_unparsed" alttext="\mathsf{Var}\left(X_{i}\big|a_{1}^{i},a_{2}^{i}\right)\leq 16r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{+}^{i})-r^{\star}(a_{-}^{i}))\parallel\sigma(r(a_{+}^{i})-r(a_{-}^{i}))\big)." display="block" intent=":literal"><semantics><mrow><mi>𝖵𝖺𝗋</mi><mrow><mo>(</mo><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo>)</mo></mrow><mo>≤</mo><mn>16</mn><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{Var}\left(X_{i}\big|a_{1}^{i},a_{2}^{i}\right)\leq 16r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{+}^{i})-r^{\star}(a_{-}^{i}))\parallel\sigma(r(a_{+}^{i})-r(a_{-}^{i}))\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.7" class="ltx_p">In addition, we have the following deterministic bound</p>
<table id="A3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex13.m1" class="ltx_Math" alttext="\sum_{i=1}^{t}\mathsf{Var}\left(X_{i}\big|a_{1}^{i},a_{2}^{i}\right)\leq 16tr_{\max}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mi>𝖵𝖺𝗋</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0em" mathsize="1.200em" rspace="0em">|</mo><mrow><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{t}\mathsf{Var}\left(X_{i}\big|a_{1}^{i},a_{2}^{i}\right)\leq 16tr_{\max}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.8" class="ltx_p">By the Freedman’s inequality (cf. Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix F Technical lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>),
for any fixed <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, with probability exceeding <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</p>
<table id="A3.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex14.m1" class="ltx_Math" alttext="\displaystyle|\Delta_{t}(r)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\Delta_{t}(r)|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex14.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left|\sum_{i=1}^{t}\left(X_{i}-\mathbb{E}\left[X_{i}\big|a_{1}^{i},a_{2}^{i}\right]\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo>]</mo></mrow><mo>)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\sum_{i=1}^{t}\left(X_{i}-\mathbb{E}\left[X_{i}\big|a_{1}^{i},a_{2}^{i}\right]\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq C_{2}\sqrt{\sum_{i=1}^{t}r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)\log\frac{\log t}{\delta}}+C_{2}r_{\mathsf{max}}\log\frac{\log t}{\delta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>r</mi><msub><mrow></mrow><mi>𝗆𝖺𝗑</mi></msub><mi>𝖪𝖫</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>r</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mi>r</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mi>r</mi><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em" rspace="0.167em">)</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow><mi>δ</mi></mfrac></mstyle></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow><mi>δ</mi></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{2}\sqrt{\sum_{i=1}^{t}r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)\log\frac{\log t}{\delta}}+C_{2}r_{\mathsf{max}}\log\frac{\log t}{\delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.9" class="ltx_p">for some sufficiently large constant <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="C_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{2}&gt;0</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Proof of Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ 5.2 Step 2: bounding likelihood ratios ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">For any fixed <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="r:\mathcal{A}\to[\pm r_{\max}]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mo>±</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r:\mathcal{A}\to[\pm r_{\max}]</annotation></semantics></math>, with probability
exceeding <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</p>
<table id="A3.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex16.m1" class="ltx_Math" alttext="\displaystyle|\Delta_{t}(r)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\Delta_{t}(r)|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex16.m2" class="ltx_Math" alttext="\displaystyle\overset{\text{(i)}}{\leq}C_{2}\sqrt{\sum_{i=1}^{t}r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)\log\frac{\log T}{\delta}}+C_{2}r_{\mathsf{max}}\log\frac{\log T}{\delta}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>r</mi><msub><mrow></mrow><mi>𝗆𝖺𝗑</mi></msub><mi>𝖪𝖫</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>r</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mi>r</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mi>r</mi><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em" rspace="0.167em">)</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mi>δ</mi></mfrac></mstyle></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mi>δ</mi></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(i)}}{\leq}C_{2}\sqrt{\sum_{i=1}^{t}r_{\mathsf{max}}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)\log\frac{\log T}{\delta}}+C_{2}r_{\mathsf{max}}\log\frac{\log T}{\delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\text{(ii)}}{\leq}\frac{1}{2}\sum_{i}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{\log T}{\delta}." display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mn>2</mn><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(ii)}}{\leq}\frac{1}{2}\sum_{i}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{\log T}{\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p">Here step (i) follows from Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 5.2 Step 2: bounding likelihood ratios ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and step
(ii) utilizes the AM-GM inequality. This immediately implies that</p>
<table id="A3.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex18.m1" class="ltx_Math" alttext="\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex18.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{t}\log\frac{\sigma(r(a_{+}^{i})-r(a_{-}^{i}))}{\sigma(r^{\star}(a_{+}^{i})-r^{\star}(a_{-}^{i}))}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{t}\log\frac{\sigma(r(a_{+}^{i})-r(a_{-}^{i}))}{\sigma(r^{\star}(a_{+}^{i})-r^{\star}(a_{-}^{i}))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex19.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)-\Delta_{t}(r)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)-\Delta_{t}(r)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E2.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{\log T}{\delta}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mn>2</mn><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mi>δ</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{\log T}{\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.2)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p">Then we explore the Lipschitzness continuity of the above functionals
of <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. For any two fixed reward functions <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="r,r^{\prime}:\mathcal{A}\to[\pm r_{\max}]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mo>±</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r,r^{\prime}:\mathcal{A}\to[\pm r_{\max}]</annotation></semantics></math>,
we have</p>
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex20.m1" class="ltx_Math" alttext="\displaystyle\left|\ell(r,\mathcal{D}^{(t)})-\ell(r^{\prime},\mathcal{D}^{(t)})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\ell(r,\mathcal{D}^{(t)})-\ell(r^{\prime},\mathcal{D}^{(t)})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex20.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{t}\left|\log[\sigma(r(a_{+}^{i})-r(a_{-}^{i}))]-\log[\sigma(r^{\prime}(a_{+}^{i})-r^{\prime}(a_{-}^{i}))]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{t}\left|\log[\sigma(r(a_{+}^{i})-r(a_{-}^{i}))]-\log[\sigma(r^{\prime}(a_{+}^{i})-r^{\prime}(a_{-}^{i}))]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E3.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i=1}^{t}|r(a_{+}^{i})-r(a_{-}^{i})-r^{\prime}(a_{+}^{i})+r^{\prime}(a_{-}^{i})|\leq 2T\|r-r^{\prime}\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>+</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mo>−</mo><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>r</mi><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i=1}^{t}|r(a_{+}^{i})-r(a_{-}^{i})-r^{\prime}(a_{+}^{i})+r^{\prime}(a_{-}^{i})|\leq 2T\|r-r^{\prime}\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.3)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p">where the penultimate step follows from <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="\mathrm{d}\log(\sigma(x))/\mathrm{d}x=\sigma(-x)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>/</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathrm{d}\log(\sigma(x))/\mathrm{d}x=\sigma(-x)\leq 1</annotation></semantics></math>.
Similarly, for any <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="x,y,\delta\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mrow><mi>δ</mi><mo>∈</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">x,y,\delta\in\mathbb{R}</annotation></semantics></math>, we have</p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex21.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\mathsf{KL}\big(\sigma(x)\parallel\sigma(y)\big)-\mathsf{KL}\big(\sigma(x)\parallel\sigma(y+\delta)\big)\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>−</mo><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>+</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathsf{KL}\big(\sigma(x)\parallel\sigma(y)\big)-\mathsf{KL}\big(\sigma(x)\parallel\sigma(y+\delta)\big)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\left|\sigma(x)\log\frac{\sigma(y+\delta)}{\sigma(y)}+(1-\sigma(x))\log\frac{1-\sigma(y+\delta)}{1-\sigma(y)}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\sigma(x)\log\frac{\sigma(y+\delta)}{\sigma(y)}+(1-\sigma(x))\log\frac{1-\sigma(y+\delta)}{1-\sigma(y)}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex22.m1" class="ltx_Math" alttext="\displaystyle\leq\sigma(x)|\delta|+(1-\sigma(x))|\delta|=|\delta|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>δ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mi>δ</mi><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>δ</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sigma(x)|\delta|+(1-\sigma(x))|\delta|=|\delta|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p">This implies that</p>
<table id="A3.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle\bigg|\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bigg|\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r^{\prime}(a_{1}^{i})-r^{\prime}(a_{2}^{i}))\big)\bigg|\leq 2\|r-r^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mn>2</mn><mo lspace="0em" rspace="0.167em">∥</mo><mi>r</mi><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r^{\prime}(a_{1}^{i})-r^{\prime}(a_{2}^{i}))\big)\bigg|\leq 2\|r-r^{\prime}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.4)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p3" class="ltx_para">
<p id="A3.SS2.p3.1" class="ltx_p">Let <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{N}_{\varepsilon}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub><annotation encoding="application/x-tex">\mathcal{N}_{\varepsilon}</annotation></semantics></math> be an <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>-net of <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="[-r_{\max},r_{\max}]^{A}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mi>A</mi></msup><annotation encoding="application/x-tex">[-r_{\max},r_{\max}]^{A}</annotation></semantics></math>
(or equivalently, the function space of <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="r:\mathcal{A}\to[\pm r_{\max}]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mo>±</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r:\mathcal{A}\to[\pm r_{\max}]</annotation></semantics></math>)
under the <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> norm such that <math id="A3.SS2.p3.m6" class="ltx_Math" alttext="|\mathcal{N}_{\varepsilon}|\leq(2r_{\max}/\varepsilon)^{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo>/</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mi>A</mi></msup></mrow><annotation encoding="application/x-tex">|\mathcal{N}_{\varepsilon}|\leq(2r_{\max}/\varepsilon)^{A}</annotation></semantics></math>.
By standard union bound argument and (<a href="#A3.E2" title="In C.2 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>), with probability
exceeding <math id="A3.SS2.p3.m7" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</p>
<table id="A3.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E5.m1" class="ltx_Math" alttext="\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E5.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mn>2</mn><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mi>δ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.5)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p">holds for any <math id="A3.SS2.p3.m8" class="ltx_Math" alttext="r\in\mathcal{N}_{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub></mrow><annotation encoding="application/x-tex">r\in\mathcal{N}_{\varepsilon}</annotation></semantics></math>. This implies that
for any <math id="A3.SS2.p3.m9" class="ltx_Math" alttext="r:\mathcal{A}\to[\pm r_{\max}]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mo>±</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r:\mathcal{A}\to[\pm r_{\max}]</annotation></semantics></math>, there exists <math id="A3.SS2.p3.m10" class="ltx_Math" alttext="r_{0}\in\mathcal{N}_{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub></mrow><annotation encoding="application/x-tex">r_{0}\in\mathcal{N}_{\varepsilon}</annotation></semantics></math>
such that <math id="A3.SS2.p3.m11" class="ltx_Math" alttext="\|r-r^{\prime}\|\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>r</mi><mo>−</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\|r-r^{\prime}\|\leq\varepsilon</annotation></semantics></math>, hence</p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})\overset{\text{(i)}}{\leq}\ell(r_{0},\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})+2T\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(r,\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})\overset{\text{(i)}}{\leq}\ell(r_{0},\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})+2T\varepsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex25.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\overset{\text{(ii)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r_{0}(a_{1}^{i})-r_{0}(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}+2T\varepsilon" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>r</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mn>2</mn><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mn>2</mn><mi>T</mi><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\overset{\text{(ii)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r_{0}(a_{1}^{i})-r_{0}(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}+2T\varepsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\overset{\text{(iii)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}+4T\varepsilon" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(iii)</mtext></mover><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mn>2</mn><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo>+</mo><mn>4</mn><mi>T</mi><mi>ε</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\overset{\text{(iii)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+2C_{2}^{2}r_{\max}\log\frac{|\mathcal{N}_{\varepsilon}|\log T}{\delta}+4T\varepsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\overset{\text{(iv)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+C_{3}Ar_{\max}\log T." display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(iv)</mtext></mover><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><msub><mi>C</mi><mn>3</mn></msub><mi>A</mi><msub><mi>r</mi><mi>max</mi></msub><mi>log</mi><mi>T</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\overset{\text{(iv)}}{\leq}-\frac{1}{2}\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r(a_{1}^{i})-r(a_{2}^{i}))\big)+C_{3}Ar_{\max}\log T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p3.3" class="ltx_p">Here step (i) utilizes (<a href="#A3.E3" title="In C.2 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>); step (ii) follows from <math id="A3.SS2.p3.m12" class="ltx_Math" alttext="r_{0}\in\mathcal{N}_{\varepsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ε</mi></msub></mrow><annotation encoding="application/x-tex">r_{0}\in\mathcal{N}_{\varepsilon}</annotation></semantics></math>
and the uniform concentration bound (<a href="#A3.E5" title="In C.2 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.5</span></a>); step (iii)
uses (<a href="#A3.E4" title="In C.2 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4</span></a>); step (iv) holds as long as <math id="A3.SS2.p3.m13" class="ltx_Math" alttext="C_{3}\gg 2C_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>≫</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">C_{3}\gg 2C_{2}^{2}</annotation></semantics></math>,
where we let <math id="A3.SS2.p3.m14" class="ltx_Math" alttext="\varepsilon=Ar_{\max}/T" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo>/</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">\varepsilon=Ar_{\max}/T</annotation></semantics></math> and <math id="A3.SS2.p3.m15" class="ltx_Math" alttext="\delta=T^{-10}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>10</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\delta=T^{-10}</annotation></semantics></math>. This
completes the proof.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Proof of Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">When <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="N_{t}(a_{+},a_{-})\geq 100C_{4}\alpha_{t}r_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">N_{t}(a_{+},a_{-})\geq 100C_{4}\alpha_{t}r_{\max}</annotation></semantics></math>, we have</p>
<table id="A3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E6.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{1}{100}." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>100</mn></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{1}{100}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.6)</span></td></tr></tbody>
</table>
<p id="A3.SS3.p1.2" class="ltx_p">Now we assert that <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="r^{(t)}(a_{-})-r^{(t)}(a_{+})&lt;0.5" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">r^{(t)}(a_{-})-r^{(t)}(a_{+})&lt;0.5</annotation></semantics></math> for any <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="t\geq t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t\geq t_{0}</annotation></semantics></math>.
This is because, if <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="r^{(t)}(a_{-})-r^{(t)}(a_{+})\geq 0.5" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">r^{(t)}(a_{-})-r^{(t)}(a_{+})\geq 0.5</annotation></semantics></math>, we have</p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)" display="inline" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathsf{KL}\big(\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\parallel\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))\big)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathsf{KL}\big(\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\parallel\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_math_unparsed" alttext="\displaystyle\geq\mathsf{KL}\big(\sigma(0)\parallel\sigma(0.5)\big)&gt;\frac{1}{100}." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathsf{KL}\big(\sigma(0)\parallel\sigma(0.5)\big)&gt;\frac{1}{100}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.3" class="ltx_p">Here we use the fact that <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="r^{\star}(a_{-})-r^{\star}(a_{+})\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r^{\star}(a_{-})-r^{\star}(a_{+})\leq 0</annotation></semantics></math>.
This contradicts with (<a href="#A3.E6" title="In C.3 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.6</span></a>). Hence we have</p>
<table id="A3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E7.m1" class="ltx_Math" alttext="r^{(t)}(a_{-})-r^{(t)}(a_{+})&lt;0.5." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0.5</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r^{(t)}(a_{-})-r^{(t)}(a_{+})&lt;0.5.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.7)</span></td></tr></tbody>
</table>
<p id="A3.SS3.p1.4" class="ltx_p">Let <math id="A3.SS3.p1.m6" class="ltx_Math" alttext="p\coloneqq\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≔</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\coloneqq\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))</annotation></semantics></math> and <math id="A3.SS3.p1.m7" class="ltx_Math" alttext="q\coloneqq\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≔</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q\coloneqq\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))</annotation></semantics></math>.
We have</p>
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E8.m1" class="ltx_Math" alttext="\displaystyle\exp(r^{(t)}(a_{-})-r^{(t)}(a_{+}))" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp(r^{(t)}(a_{-})-r^{(t)}(a_{+}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E8.m2" class="ltx_math_unparsed" alttext="\displaystyle\overset{\text{(i)}}{\leq}3\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))=3q\overset{\text{(ii)}}{\leq}6p+\mathsf{KL}(p\parallel q)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mn>3</mn><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>3</mn><mi>q</mi><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mn>6</mn><mi>p</mi><mo>+</mo><mi>𝖪𝖫</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(i)}}{\leq}3\sigma(r^{(t)}(a_{-})-r^{(t)}(a_{+}))=3q\overset{\text{(ii)}}{\leq}6p+\mathsf{KL}(p\parallel q)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.8)</span></td></tr></tbody>
<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle=6\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))+24\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>6</mn><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>24</mn><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=6\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))+24\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.5" class="ltx_p">Here step (i) follows from (<a href="#A3.E7" title="In C.3 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a>), while step (ii)
holds trivially when <math id="A3.SS3.p1.m8" class="ltx_Math" alttext="q\leq 2p" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">q\leq 2p</annotation></semantics></math>, and when <math id="A3.SS3.p1.m9" class="ltx_Math" alttext="q&gt;2p" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">q&gt;2p</annotation></semantics></math> we have</p>
<table id="A3.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex31.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}(p\parallel q)=p\log\frac{p}{q}+(1-p)\log\frac{1-p}{1-q}\geq\frac{(q-p)^{2}}{2q}\geq\frac{1}{8}q." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mi>log</mi><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mfrac><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow></mfrac><mo>≥</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mfrac><mo>≥</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mi>q</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}(p\parallel q)=p\log\frac{p}{q}+(1-p)\log\frac{1-p}{1-q}\geq\frac{(q-p)^{2}}{2q}\geq\frac{1}{8}q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">Finally, for any <math id="A3.SS3.p2.m1" class="ltx_Math" alttext="t_{0}\leq t_{1}&lt;t_{2}\leq T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>≤</mo><msub><mi>t</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>t</mi><mn>2</mn></msub><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{0}\leq t_{1}&lt;t_{2}\leq T</annotation></semantics></math>, we can upper bound</p>
<table id="A3.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex32.m1" class="ltx_Math" alttext="N_{t_{2}}(a_{+},a_{-})-N_{t_{1}}(a_{+},a_{-})\leq\sum_{i=t_{1}+1}^{t_{2}}X_{i}\quad\text{where}\quad X_{i}\coloneqq\ind\{a_{-}\text{ is sampled in the }i\text{-th iteration}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>t</mi><mn>2</mn></msub></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>≔</mo><mrow><mi>𝟙</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>a</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mtext> is sampled in the </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-th iteration</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{t_{2}}(a_{+},a_{-})-N_{t_{1}}(a_{+},a_{-})\leq\sum_{i=t_{1}+1}^{t_{2}}X_{i}\quad\text{where}\quad X_{i}\coloneqq\ind\{a_{-}\text{ is sampled in the }i\text{-th iteration}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.2" class="ltx_p">It is straightforward to check that <math id="A3.SS3.p2.m2" class="ltx_Math" alttext="X_{i}-\mathbb{E}[X_{i}|\mathcal{F}_{i-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{i}-\mathbb{E}[X_{i}|\mathcal{F}_{i-1}]</annotation></semantics></math>
is a martingale difference sequence, and by the Azuma-Hoeffding inequality,
with probability exceeding <math id="A3.SS3.p2.m3" class="ltx_Math" alttext="1-O(T^{-100})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>100</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-O(T^{-100})</annotation></semantics></math> we have</p>
<table id="A3.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex33.m1" class="ltx_math_unparsed" alttext="\sum_{i=t_{1}+1}^{t_{2}}\left(X_{i}-\mathbb{E}[X_{i}|\pi^{(i)},\pi^{(i-1)}]\right)\leq\widetilde{C}\sqrt{T\log T}" display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>t</mi><mn>2</mn></msub></munderover><mrow><mo lspace="0em">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>≤</mo><mover accent="true"><mi>C</mi><mo>~</mo></mover><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sum_{i=t_{1}+1}^{t_{2}}\left(X_{i}-\mathbb{E}[X_{i}|\pi^{(i)},\pi^{(i-1)}]\right)\leq\widetilde{C}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.3" class="ltx_p">for some universal constant <math id="A3.SS3.p2.m4" class="ltx_Math" alttext="\widetilde{C}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{C}&gt;0</annotation></semantics></math>. In addition, we have</p>
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[X_{i}|\pi^{(i)},\pi^{(i-1)}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[X_{i}|\pi^{(i)},\pi^{(i-1)}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\pi^{(i)}(a_{-})}{\pi^{(i)}(a_{-})+\pi^{(i)}(a_{+})}+\frac{\pi^{(i-1)}(a_{-})}{\pi^{(i-1)}(a_{-})+\pi^{(i-1)}(a_{+})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\pi^{(i)}(a_{-})}{\pi^{(i)}(a_{-})+\pi^{(i)}(a_{+})}+\frac{\pi^{(i-1)}(a_{-})}{\pi^{(i-1)}(a_{-})+\pi^{(i-1)}(a_{+})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.4" class="ltx_p">For each <math id="A3.SS3.p2.m5" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>, we have</p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_Math" alttext="\displaystyle\frac{\pi^{(t)}(a_{-})}{\pi^{(t)}(a_{-})+\pi^{(t)}(a_{+})}\overset{\text{(i)}}{=}\frac{\pi_{\mathsf{ref}}(a_{-})\exp(r^{(t)}(a_{-})/\beta)}{\pi_{\mathsf{ref}}(a_{-})\exp(r^{(t)}(a_{-})/\beta)+\pi_{\mathsf{ref}}(a_{+})\exp(r^{(t)}(a_{+})/\beta)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>=</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\pi^{(t)}(a_{-})}{\pi^{(t)}(a_{-})+\pi^{(t)}(a_{+})}\overset{\text{(i)}}{=}\frac{\pi_{\mathsf{ref}}(a_{-})\exp(r^{(t)}(a_{-})/\beta)}{\pi_{\mathsf{ref}}(a_{-})\exp(r^{(t)}(a_{-})/\beta)+\pi_{\mathsf{ref}}(a_{+})\exp(r^{(t)}(a_{+})/\beta)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\exp\left(\big(r^{(t)}(a_{-})-r^{(t)}(a_{+})\big)/\beta\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>/</mo><mi>β</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\exp\left(\big(r^{(t)}(a_{-})-r^{(t)}(a_{+})\big)/\beta\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\leq\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\left[6\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))+24\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\right]^{1/\beta}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><msup><mrow><mo>[</mo><mn>6</mn><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>24</mn><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\left[6\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))+24\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\right]^{1/\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.5" class="ltx_p">Here step (i) utilizes (<a href="#S2.E4" title="In RL fine-tuning. ‣ 2 Model set-up ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a>), while step
(ii) follows from (<a href="#A3.E8" title="In C.3 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.8</span></a>). Hence we have</p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle N_{t_{2}}(a_{+},a_{-})-N_{t_{1}}(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{t_{2}}(a_{+},a_{-})-N_{t_{1}}(a_{+},a_{-})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m2" class="ltx_Math" alttext="\displaystyle\leq 2\sum_{t=t_{1}+1}^{t_{2}}\frac{\pi^{(t)}(a_{-})}{\pi^{(t)}(a_{-})+\pi^{(t)}(a_{+})}+2\widetilde{C}\sqrt{T\log T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>t</mi><mn>2</mn></msub></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sum_{t=t_{1}+1}^{t_{2}}\frac{\pi^{(t)}(a_{-})}{\pi^{(t)}(a_{-})+\pi^{(t)}(a_{+})}+2\widetilde{C}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq C_{5}^{1/\beta}\sum_{t=t_{1}+1}^{t_{2}}\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big[\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)^{\frac{1}{\beta}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msubsup><mi>C</mi><mn>5</mn><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msubsup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>t</mi><mn>2</mn></msub></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>𝖪𝖫</mi><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mfrac><mn>1</mn><mi>β</mi></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{5}^{1/\beta}\sum_{t=t_{1}+1}^{t_{2}}\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big[\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)^{\frac{1}{\beta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad\qquad\qquad+\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))^{\frac{1}{\beta}}\Big]+C_{5}\sqrt{T\log T}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>σ</mi><msup><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>β</mi></mfrac></msup><mo maxsize="1.600em" minsize="1.600em">]</mo><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad\qquad\qquad+\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))^{\frac{1}{\beta}}\Big]+C_{5}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.6" class="ltx_p">for some sufficiently large constant <math id="A3.SS3.p2.m6" class="ltx_Math" alttext="C_{5}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>5</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{5}&gt;0</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Proof of Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="A3.SS4.p1" class="ltx_para">
<p id="A3.SS4.p1.1" class="ltx_p">Let <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math> be the first iteration such that</p>
<table id="A3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E9.m1" class="ltx_Math" alttext="N_{t_{0}}(a_{+},a_{-})\geq\min\left\{\frac{1}{2}N_{T}(a_{+},a_{-}),100C_{4}\alpha_{T}r_{\mathsf{max}}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{t_{0}}(a_{+},a_{-})\geq\min\left\{\frac{1}{2}N_{T}(a_{+},a_{-}),100C_{4}\alpha_{T}r_{\mathsf{max}}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.9)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p1.2" class="ltx_p">In what follows, we establish the desired result under two different
cases: <math id="A3.SS4.p1.m2" class="ltx_Math" alttext="N_{T}(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{T}(a_{+},a_{-})</annotation></semantics></math> being larger or smaller than <math id="A3.SS4.p1.m3" class="ltx_Math" alttext="c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><annotation encoding="application/x-tex">c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}</annotation></semantics></math>
for some sufficiently large constant <math id="A3.SS4.p1.m4" class="ltx_Math" alttext="c_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{0}&gt;0</annotation></semantics></math>.</p>
</div>
<section id="A3.SS4.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 1.</h4>

<div id="A3.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS4.SSS0.Px1.p1.1" class="ltx_p">When <math id="A3.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="N_{T}(a_{+},a_{-})\leq c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mrow><annotation encoding="application/x-tex">N_{T}(a_{+},a_{-})\leq c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}</annotation></semantics></math>,
it is straightforward to show that</p>
<table id="A3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E10.m1" class="ltx_Math" alttext="\zeta(a_{+},a_{-})\leq N_{T}(a_{+},a_{-})r_{\max}\leq C_{6}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}^{2}=C_{6}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>6</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msub><mi>C</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta(a_{+},a_{-})\leq N_{T}(a_{+},a_{-})r_{\max}\leq C_{6}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}^{2}=C_{6}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.10)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px1.p1.2" class="ltx_p">In addition, we have</p>
<table id="A3.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex41.m1" class="ltx_Math" alttext="\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\frac{c_{0}\alpha_{T}r_{\mathsf{max}}}{N_{T}(a_{+},a_{-})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\frac{c_{0}\alpha_{T}r_{\mathsf{max}}}{N_{T}(a_{+},a_{-})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px1.p1.3" class="ltx_p">In addition, for any <math id="A3.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="t_{0}\leq t\leq T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{0}\leq t\leq T</annotation></semantics></math>, we can use (<a href="#S5.E8" title="In 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>)
to show that</p>
<table id="A3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E11.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{C_{4}\alpha_{t}r_{\max}}{N_{t}(a_{+},a_{-})}\leq\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>≤</mo><mfrac><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{C_{4}\alpha_{t}r_{\max}}{N_{t}(a_{+},a_{-})}\leq\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.11)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px1.p1.4" class="ltx_p">By taking <math id="A3.SS4.SSS0.Px1.p1.m3" class="ltx_Math" alttext="t_{1}=t_{0}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t_{1}=t_{0}-1</annotation></semantics></math> and <math id="A3.SS4.SSS0.Px1.p1.m4" class="ltx_Math" alttext="t_{2}=T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{2}=T</annotation></semantics></math> in Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>,
we have</p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex42.m1" class="ltx_Math" alttext="\displaystyle N_{T}(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N_{T}(a_{+},a_{-})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex42.m2" class="ltx_Math" alttext="\displaystyle\overset{\text{(i)}}{\leq}2[N_{T}(a_{+},a_{-})-N_{t_{0}-1}(a_{+},a_{-})]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>N</mi><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(i)}}{\leq}2[N_{T}(a_{+},a_{-})-N_{t_{0}-1}(a_{+},a_{-})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle\overset{\text{(ii)}}{\leq}4T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big(\frac{C_{5}\max\{c_{0},2C_{4}\}\alpha_{T}r_{\mathsf{max}}}{N_{T}(a_{+},a_{-})}\Big)^{1/\beta}+2C_{5}\sqrt{T\log T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>C</mi><mn>5</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(ii)}}{\leq}4T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big(\frac{C_{5}\max\{c_{0},2C_{4}\}\alpha_{T}r_{\mathsf{max}}}{N_{T}(a_{+},a_{-})}\Big)^{1/\beta}+2C_{5}\sqrt{T\log T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px1.p1.5" class="ltx_p">Here step (i) follows from the definition of <math id="A3.SS4.SSS0.Px1.p1.m5" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math> (cf. (<a href="#A3.E9" title="In C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.9</span></a>)),
while step (ii) uses the above two bounds and Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>
with <math id="A3.SS4.SSS0.Px1.p1.m6" class="ltx_Math" alttext="t_{1}=t_{0}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t_{1}=t_{0}-1</annotation></semantics></math> and <math id="A3.SS4.SSS0.Px1.p1.m7" class="ltx_Math" alttext="t_{2}=T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{2}=T</annotation></semantics></math>. This immediately implies that</p>
<table id="A3.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex44.m1" class="ltx_Math" alttext="N_{T}(a_{+},a_{-})\leq C_{7}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}(\alpha_{T}r_{\max})^{\frac{1}{\beta+1}}+C_{7}\sqrt{T\log T}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{T}(a_{+},a_{-})\leq C_{7}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}(\alpha_{T}r_{\max})^{\frac{1}{\beta+1}}+C_{7}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px1.p1.6" class="ltx_p">for some sufficiently large constant <math id="A3.SS4.SSS0.Px1.p1.m8" class="ltx_Math" alttext="C_{7}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>7</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{7}&gt;0</annotation></semantics></math>. This leads to</p>
<table id="A3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E12.m1" class="ltx_Math" alttext="\zeta(a_{+},a_{-})\leq N_{T}(a_{+},a_{-})r_{\max}\leq C_{7}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{\beta+2}{\beta+1}}+C_{7}\sqrt{T\log T}r_{\max}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta(a_{+},a_{-})\leq N_{T}(a_{+},a_{-})r_{\max}\leq C_{7}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{\beta+2}{\beta+1}}+C_{7}\sqrt{T\log T}r_{\max}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.12)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS4.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Case 2.</h4>

<div id="A3.SS4.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS4.SSS0.Px2.p1.1" class="ltx_p">When <math id="A3.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="N_{T}(a_{+},a_{-})&gt;c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mrow><annotation encoding="application/x-tex">N_{T}(a_{+},a_{-})&gt;c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}</annotation></semantics></math>,
we have</p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}\leq\frac{1}{c_{0}}N_{T}(a_{+},a_{-})\overset{\text{(i)}}{\leq}\frac{2}{c_{0}}[N_{T}(a_{+},a_{-})-N_{t_{0}-1}(a_{+},a_{-})]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>N</mi><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}\leq\frac{1}{c_{0}}N_{T}(a_{+},a_{-})\overset{\text{(i)}}{\leq}\frac{2}{c_{0}}[N_{T}(a_{+},a_{-})-N_{t_{0}-1}(a_{+},a_{-})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex46.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(ii)}}{\leq}\frac{2C_{5}^{1/\beta}}{c_{0}}T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big[\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))^{1/\beta}+\Big(\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}\Big)^{1/\beta}\Big]+\frac{2C_{5}}{c_{0}}\sqrt{T\log T}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mn>5</mn><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msubsup></mrow><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup></mrow><mo>+</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(ii)}}{\leq}\frac{2C_{5}^{1/\beta}}{c_{0}}T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\Big[\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))^{1/\beta}+\Big(\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}\Big)^{1/\beta}\Big]+\frac{2C_{5}}{c_{0}}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex47.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(iii)}}{\leq}\frac{4}{c_{0}}\max\{C_{5},2C_{4}C_{5}/c_{0}\}^{1/\beta}T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))^{1/\beta}+\frac{2C_{5}}{c_{0}}\sqrt{T\log T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(iii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><msup><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mn>5</mn></msub><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo>/</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><mo stretchy="false">}</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>exp</mi></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><msub><mi>c</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(iii)}}{\leq}\frac{4}{c_{0}}\max\{C_{5},2C_{4}C_{5}/c_{0}\}^{1/\beta}T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))^{1/\beta}+\frac{2C_{5}}{c_{0}}\sqrt{T\log T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.2" class="ltx_p">Here step (i) follows from the definition of <math id="A3.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math> (cf. (<a href="#A3.E9" title="In C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.9</span></a>));
step (ii) utilizes Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> with <math id="A3.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="t_{1}=t_{0}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t_{1}=t_{0}-1</annotation></semantics></math>
and <math id="A3.SS4.SSS0.Px2.p1.m4" class="ltx_Math" alttext="t_{2}=T" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t_{2}=T</annotation></semantics></math>, as well as (<a href="#A3.E11" title="In Case 1. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.11</span></a>); step (iii)
holds since <math id="A3.SS4.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\leq\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))</annotation></semantics></math>
and</p>
<table id="A3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex48.m1" class="ltx_Math" alttext="\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}\leq\frac{2C_{4}\alpha_{T}r_{\max}}{c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}}\leq\frac{2C_{4}}{c_{0}}\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mfrac><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub></mrow><msub><mi>c</mi><mn>0</mn></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{2C_{4}\alpha_{T}r_{\max}}{N_{T}(a_{+},a_{-})}\leq\frac{2C_{4}\alpha_{T}r_{\max}}{c_{0}\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\alpha_{T}r_{\mathsf{max}}}\leq\frac{2C_{4}}{c_{0}}\exp(r^{\star}(a_{-})-r^{\star}(a_{+})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.3" class="ltx_p">This immediately implies that for some sufficiently large constant
<math id="A3.SS4.SSS0.Px2.p1.m6" class="ltx_Math" alttext="C_{8}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>8</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{8}&gt;0</annotation></semantics></math>, we have</p>
<table id="A3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E13.m1" class="ltx_Math" alttext="\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}=\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\leq C_{8}\Big(\frac{\pi_{\mathsf{ref}}(a_{-})T}{\pi_{\mathsf{ref}}(a_{+})\alpha_{T}r_{\mathsf{max}}}\Big)^{\frac{\beta}{\beta+1}}+C_{8}\frac{\sqrt{T\log T}}{\alpha_{T}r_{\mathsf{max}}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>8</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>8</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}=\exp(r^{\star}(a_{+})-r^{\star}(a_{-}))\leq C_{8}\Big(\frac{\pi_{\mathsf{ref}}(a_{-})T}{\pi_{\mathsf{ref}}(a_{+})\alpha_{T}r_{\mathsf{max}}}\Big)^{\frac{\beta}{\beta+1}}+C_{8}\frac{\sqrt{T\log T}}{\alpha_{T}r_{\mathsf{max}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.13)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.4" class="ltx_p">Similar to (<a href="#A3.E1" title="In C.1 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>), we can show that</p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex49.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r(a_{+})-r(a_{-}))\big)=\mathsf{KL}\big(\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\|\sigma(r(a_{-})-r(a_{+}))\big)" display="inline" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\|\sigma(r(a_{+})-r(a_{-}))\big)=\mathsf{KL}\big(\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))\|\sigma(r(a_{-})-r(a_{+}))\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(a)}}{\geq}\frac{1}{16r_{\max}}\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))[1-\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))][r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≥</mo><mtext mathsize="0.700em">(a)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(a)}}{\geq}\frac{1}{16r_{\max}}\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))[1-\sigma(r^{\star}(a_{-})-r^{\star}(a_{+}))][r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(b)}}{\geq}\frac{1}{64r_{\max}}\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))[r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≥</mo><mtext mathsize="0.700em">(b)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>64</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(b)}}{\geq}\frac{1}{64r_{\max}}\exp(r^{\star}(a_{-})-r^{\star}(a_{+}))[r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.5" class="ltx_p">Here step (a) follows from Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ Appendix F Technical lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>; step
(b) makes use of the fact that <math id="A3.SS4.SSS0.Px2.p1.m7" class="ltx_Math" alttext="r^{\star}(a_{-})\leq r^{\star}(a_{+})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r^{\star}(a_{-})\leq r^{\star}(a_{+})</annotation></semantics></math>.
Hence we have</p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_Math" alttext="\displaystyle[r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle[r(a_{+})-r(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\leq 64r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r(a_{+})-r(a_{-}))\big)." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>64</mn><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq 64r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r(a_{+})-r(a_{-}))\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.14)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.6" class="ltx_p">In addition, we have</p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r^{(t)}(a_{1}^{i})-r^{(t)}(a_{2}^{i}))\big)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>2</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\mathsf{KL}\big(\sigma(r^{\star}(a_{1}^{i})-r^{\star}(a_{2}^{i}))\parallel\sigma(r^{(t)}(a_{1}^{i})-r^{(t)}(a_{2}^{i}))\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m2" class="ltx_Math" alttext="\displaystyle\overset{\text{(i)}}{\leq}-2\big[\ell(r^{(t)},\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})\big]+2C_{3}Ar_{\mathsf{max}}\log T" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em">−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(i)}}{\leq}-2\big[\ell(r^{(t)},\mathcal{D}^{(t)})-\ell(r^{\star},\mathcal{D}^{(t)})\big]+2C_{3}Ar_{\mathsf{max}}\log T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54.m1" class="ltx_Math" alttext="\displaystyle\overset{\text{(ii)}}{\leq}2\alpha_{t}\gamma_{t}+2C_{3}Ar_{\mathsf{max}}\log T" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(ii)}}{\leq}2\alpha_{t}\gamma_{t}+2C_{3}Ar_{\mathsf{max}}\log T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.7" class="ltx_p">Here step (i) follows from Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ 5.2 Step 2: bounding likelihood ratios ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, while step
(ii) utilizes (<a href="#S5.E6" title="In 5.3 Step 3: bounding reward errors ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a>) and the definition of
<math id="A3.SS4.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> (cf. (<a href="#S5.E2" title="In 5.1 Step 1: regret decomposition ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>)). This immediately
implies that</p>
<table id="A3.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E15.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{2\alpha_{t}\gamma_{t}+2C_{3}Ar_{\mathsf{max}}\log T}{N_{t}(a_{+},a_{-})}." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>≤</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t)}(a_{+})-r^{(t)}(a_{-}))\big)\leq\frac{2\alpha_{t}\gamma_{t}+2C_{3}Ar_{\mathsf{max}}\log T}{N_{t}(a_{+},a_{-})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.15)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.8" class="ltx_p">Therefore for any <math id="A3.SS4.SSS0.Px2.p1.m9" class="ltx_Math" alttext="1\leq n_{1}&lt;n_{2}\leq N_{T}(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><msub><mi>n</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>n</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\leq n_{1}&lt;n_{2}\leq N_{T}(a_{+},a_{-})</annotation></semantics></math>, we
have</p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex55.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n_{2}-n_{1}}\bigg(\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\bigg)^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n_{2}-n_{1}}\bigg(\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\bigg)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(i)}}{\leq}\sum_{n=n_{1}}^{n_{2}}[r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(i)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(i)}}{\leq}\sum_{n=n_{1}}^{n_{2}}[r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\overset{\text{(ii)}}{\leq}64r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{n_{2}}\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-}))\big)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(ii)</mtext></mover><mn>64</mn><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><mi>𝖪𝖫</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>⋆</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(ii)}}{\leq}64r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{n_{2}}\mathsf{KL}\big(\sigma(r^{\star}(a_{+})-r^{\star}(a_{-}))\parallel\sigma(r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-}))\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E16.m1" class="ltx_Math" alttext="\displaystyle\qquad\overset{\text{(iii)}}{\leq}\frac{128r_{\mathsf{max}}\alpha_{T}}{n_{1}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{n_{2}}\gamma_{t_{n}}+128C_{3}Ar_{\mathsf{max}}^{2}\log T\frac{n_{2}-n_{1}}{n_{1}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(iii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub></mrow><msub><mi>n</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><msub><mi>γ</mi><msub><mi>t</mi><mi>n</mi></msub></msub></mrow></mrow><mo>+</mo><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\overset{\text{(iii)}}{\leq}\frac{128r_{\mathsf{max}}\alpha_{T}}{n_{1}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{n_{2}}\gamma_{t_{n}}+128C_{3}Ar_{\mathsf{max}}^{2}\log T\frac{n_{2}-n_{1}}{n_{1}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.16)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.9" class="ltx_p">Here step (i) uses the Cauchy-Schwarz inequality; step (ii) follows
from (<a href="#A3.E14" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.14</span></a>); step (iii) utilizes (<a href="#A3.E15" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.15</span></a>)
and the fact that <math id="A3.SS4.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\{\alpha_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\alpha_{t}\}</annotation></semantics></math> is monotonically increasing. Following
the same analysis as in (<a href="#S5.E3" title="In 5.1 Step 1: regret decomposition ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>) and (<a href="#S5.E4" title="In 5.1 Step 1: regret decomposition ‣ 5 Proof of Theorem ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>),
we know that</p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_Math" alttext="\displaystyle\sum_{n=n_{1}}^{n_{2}}\gamma_{t_{n}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><msub><mi>γ</mi><msub><mi>t</mi><mi>n</mi></msub></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{n=n_{1}}^{n_{2}}\gamma_{t_{n}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex58.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{n=n_{1}}^{n_{2}}\xi_{t_{n}}+\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><msub><mi>ξ</mi><msub><mi>t</mi><mi>n</mi></msub></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{n=n_{1}}^{n_{2}}\xi_{t_{n}}+\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E17.m1" class="ltx_Math" alttext="\displaystyle\leq C_{1}r_{\mathsf{max}}\sqrt{(n_{2}-n_{1})\log T}+\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><msub><mi>n</mi><mn>2</mn></msub></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{1}r_{\mathsf{max}}\sqrt{(n_{2}-n_{1})\log T}+\sum_{n=n_{1}}^{n_{2}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.17)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.10" class="ltx_p">Taking (<a href="#A3.E16" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.16</span></a>) and (<a href="#A3.E17" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.17</span></a>)
collectively and let <math id="A3.SS4.SSS0.Px2.p1.m11" class="ltx_Math" alttext="n_{2}=2n_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">n_{2}=2n_{1}</annotation></semantics></math>, we know that for any <math id="A3.SS4.SSS0.Px2.p1.m12" class="ltx_Math" alttext="n_{1}\leq N_{T}(a_{+},a_{-})/2" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>≤</mo><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">n_{1}\leq N_{T}(a_{+},a_{-})/2</annotation></semantics></math>,</p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59.m1" class="ltx_Math" alttext="\displaystyle\bigg(\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\bigg)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\bigg(\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\bigg)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60.m1" class="ltx_Math" alttext="\displaystyle\quad\overset{\text{(iii)}}{\leq}128r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(iii)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\overset{\text{(iii)}}{\leq}128r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\displaystyle\quad\qquad+128r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}n_{1}\left(\alpha_{T}C_{1}r_{\mathsf{max}}\sqrt{\frac{\log T}{n_{1}}}+C_{3}Ar_{\mathsf{max}}\log T\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>128</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msub><mi>n</mi><mn>1</mn></msub></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\qquad+128r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}n_{1}\left(\alpha_{T}C_{1}r_{\mathsf{max}}\sqrt{\frac{\log T}{n_{1}}}+C_{3}Ar_{\mathsf{max}}\log T\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.11" class="ltx_p">This self-bounding relation implies that</p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\displaystyle\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\leq 256r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{n=n_{1}}^{2n_{1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|\leq 256r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad+\sqrt{256r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}n_{1}\left(\alpha_{T}C_{1}r_{\mathsf{max}}\sqrt{\frac{\log T}{n_{1}}}+C_{3}Ar_{\mathsf{max}}\log T\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><msqrt><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msub><mi>n</mi><mn>1</mn></msub></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+\sqrt{256r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}n_{1}\left(\alpha_{T}C_{1}r_{\mathsf{max}}\sqrt{\frac{\log T}{n_{1}}}+C_{3}Ar_{\mathsf{max}}\log T\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq 400r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}+C_{1}r_{\mathsf{max}}\sqrt{n_{1}\log T}+C_{3}n_{1}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{T}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mrow><mn>400</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>n</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>T</mi></msub></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq 400r_{\mathsf{max}}\alpha_{T}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}+C_{1}r_{\mathsf{max}}\sqrt{n_{1}\log T}+C_{3}n_{1}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{T}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.12" class="ltx_p">where the last relation follows from the AM-GM inequality. By using
the above relation recursively, we have</p>
<table id="A3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\zeta(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\zeta(a_{+},a_{-})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=1}^{\lceil\log T\rceil}\sum_{n=N_{T}(a_{+},a_{-})/2^{k}}^{N_{T}(a_{+},a_{-})/2^{k-1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">⌈</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">⌉</mo></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mn>2</mn><mi>k</mi></msup></mrow></mrow><mrow><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mn>2</mn><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>r</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=1}^{\lceil\log T\rceil}\sum_{n=N_{T}(a_{+},a_{-})/2^{k}}^{N_{T}(a_{+},a_{-})/2^{k-1}}\big|r^{(t_{n})}(a_{+})-r^{(t_{n})}(a_{-})-r^{\star}(a_{+})+r^{\star}(a_{-})\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E18.m1" class="ltx_Math" alttext="\displaystyle\leq C_{9}r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}\log T+C_{9}r_{\max}\sqrt{N_{T}(a_{+},a_{-})\log T}+C_{9}N_{T}(a_{+},a_{-})\frac{Ar_{\max}\log T}{\alpha_{T}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>T</mi></msub></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{9}r_{\mathsf{max}}\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}\log T+C_{9}r_{\max}\sqrt{N_{T}(a_{+},a_{-})\log T}+C_{9}N_{T}(a_{+},a_{-})\frac{Ar_{\max}\log T}{\alpha_{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.18)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p1.13" class="ltx_p">for some sufficiently large constant <math id="A3.SS4.SSS0.Px2.p1.m13" class="ltx_Math" alttext="C_{9}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>9</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{9}&gt;0</annotation></semantics></math>. On the other hand,
taking (<a href="#A3.E18" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.18</span></a>) and (<a href="#A3.E13" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.13</span></a>) collectively
yields</p>
<table id="A3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\displaystyle\zeta(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\zeta(a_{+},a_{-})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66.m2" class="ltx_Math" alttext="\displaystyle\leq C_{8}C_{9}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\log T+C_{9}r_{\max}\sqrt{N_{T}(a_{+},a_{-})\log T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>8</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{8}C_{9}\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\log T+C_{9}r_{\max}\sqrt{N_{T}(a_{+},a_{-})\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E19.m1" class="ltx_Math" alttext="\displaystyle\qquad+C_{9}N_{T}(a_{+},a_{-})\frac{Ar_{\max}\log T}{\alpha_{T}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>9</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>T</mi></msub></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+C_{9}N_{T}(a_{+},a_{-})\frac{Ar_{\max}\log T}{\alpha_{T}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.19)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS4.SSS0.Px2.p2.1" class="ltx_p">By putting (<a href="#A3.E10" title="In Case 1. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.10</span></a>), (<a href="#A3.E12" title="In Case 1. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.12</span></a>), (<a href="#A3.E18" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.18</span></a>)
and (<a href="#A3.E19" title="In Case 2. ‣ C.4 Proof of Lemma ‣ Appendix C Proof of auxiliary lemmas ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.19</span></a>) together, we have</p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\displaystyle\zeta(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\zeta(a_{+},a_{-})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m2" class="ltx_Math" alttext="\displaystyle\leq C_{6}(r_{\max}+\log T)\min\left\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{6}(r_{\max}+\log T)\min\left\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\displaystyle\qquad+C_{6}\left(\frac{AN_{T}(a_{+},a_{-})\log T}{\alpha_{T}}+\sqrt{T\log T}\right)r_{\max}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>T</mi></msub></mfrac></mstyle><mo>+</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+C_{6}\left(\frac{AN_{T}(a_{+},a_{-})\log T}{\alpha_{T}}+\sqrt{T\log T}\right)r_{\max}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.SSS0.Px2.p2.2" class="ltx_p">always holds for some universal constant <math id="A3.SS4.SSS0.Px2.p2.m1" class="ltx_Math" alttext="C_{6}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>6</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{6}&gt;0</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of Proposition <a href="#Thmprop3" title="Proposition 3. ‣ 4 Theoretical results ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> </h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">Under Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ 4 Theoretical results ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we know that for any action
pair <math id="A4.p1.m1" class="ltx_Math" alttext="(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{+},a_{-})</annotation></semantics></math>,</p>
<table id="A4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex1.m1" class="ltx_Math" alttext="\min\bigg\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}\leq\max\big\{\tau\alpha_{T}r_{\mathsf{max}},\left(\kappa T\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min\bigg\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}\leq\max\big\{\tau\alpha_{T}r_{\mathsf{max}},\left(\kappa T\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">Therefore we have</p>
<table id="A4.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex2.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}(T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex2.m2" class="ltx_Math" alttext="\displaystyle\leq Cr_{\mathsf{max}}A^{2}\sqrt{T\log T}+C\sum_{t=1}^{T}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{t}}+2C(r_{\mathsf{max}}+\log T)A^{2}\tau\alpha_{T}r_{\mathsf{max}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq Cr_{\mathsf{max}}A^{2}\sqrt{T\log T}+C\sum_{t=1}^{T}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{t}}+2C(r_{\mathsf{max}}+\log T)A^{2}\tau\alpha_{T}r_{\mathsf{max}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex3.m1" class="ltx_Math" alttext="\displaystyle\qquad+C(r_{\mathsf{max}}+\log T)A^{2}\left(\kappa T\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+C(r_{\mathsf{max}}+\log T)A^{2}\left(\kappa T\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.3" class="ltx_p">By taking</p>
<table id="A4.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex4.m1" class="ltx_Math" alttext="\alpha_{t}=A\log T+t^{\frac{1}{\beta+2}}\Big(\frac{r_{\max}}{\kappa}\Big)^{\frac{\beta}{\beta+2}}\Big(\frac{\log T}{A(r_{\max}+\log T)}\Big)^{\frac{\beta+1}{\beta+2}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>A</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>t</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msub><mi>r</mi><mi>max</mi></msub><mi>κ</mi></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha_{t}=A\log T+t^{\frac{1}{\beta+2}}\Big(\frac{r_{\max}}{\kappa}\Big)^{\frac{\beta}{\beta+2}}\Big(\frac{\log T}{A(r_{\max}+\log T)}\Big)^{\frac{\beta+1}{\beta+2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.4" class="ltx_p">we can achieve</p>
<table id="A4.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex5.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}(T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex5.m2" class="ltx_Math" alttext="\displaystyle\lesssim(r_{\mathsf{max}}+\log T)A^{3}\tau r_{\mathsf{max}}\log T+r_{\mathsf{max}}A^{2}\sqrt{T\log T}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(r_{\mathsf{max}}+\log T)A^{3}\tau r_{\mathsf{max}}\log T+r_{\mathsf{max}}A^{2}\sqrt{T\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex6.m1" class="ltx_Math" alttext="\displaystyle\qquad+(r_{\max}+\log T)^{\frac{\beta+1}{\beta+2}}r_{\max}^{\frac{2}{\beta+2}}\kappa^{\frac{\beta}{\beta+2}}A^{\frac{2\beta+3}{\beta+2}}T^{\frac{\beta+1}{\beta+2}}(\log T)^{\frac{1}{\beta+2}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>2</mn><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>3</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(r_{\max}+\log T)^{\frac{\beta+1}{\beta+2}}r_{\max}^{\frac{2}{\beta+2}}\kappa^{\frac{\beta}{\beta+2}}A^{\frac{2\beta+3}{\beta+2}}T^{\frac{\beta+1}{\beta+2}}(\log T)^{\frac{1}{\beta+2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex7.m1" class="ltx_Math" alttext="\displaystyle\qquad+(r_{\mathsf{max}}+\log T)^{\frac{1}{\beta+2}}A^{\frac{\beta+3}{\beta+2}}\tau r_{\mathsf{max}}^{\frac{2\beta+2}{\beta+2}}\kappa^{-\frac{\beta}{\beta+2}}(\log T)^{\frac{\beta+1}{\beta+2}}T^{\frac{1}{\beta+2}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mfrac><mrow><mi>β</mi><mo>+</mo><mn>3</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mrow><mo>−</mo><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(r_{\mathsf{max}}+\log T)^{\frac{1}{\beta+2}}A^{\frac{\beta+3}{\beta+2}}\tau r_{\mathsf{max}}^{\frac{2\beta+2}{\beta+2}}\kappa^{-\frac{\beta}{\beta+2}}(\log T)^{\frac{\beta+1}{\beta+2}}T^{\frac{1}{\beta+2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex8.m1" class="ltx_Math" alttext="\displaystyle\qquad+(r_{\mathsf{max}}+\log T)A^{\frac{2\beta+3}{\beta+1}}\kappa^{\frac{\beta}{\beta+1}}(\log T)^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}T^{\frac{\beta}{\beta+1}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>3</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(r_{\mathsf{max}}+\log T)A^{\frac{2\beta+3}{\beta+1}}\kappa^{\frac{\beta}{\beta+1}}(\log T)^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}T^{\frac{\beta}{\beta+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex9.m1" class="ltx_Math" alttext="\displaystyle\lesssim\tau A^{3}r_{\mathsf{max}}^{2}\log^{2}T+T^{\frac{\beta+1}{\beta+2}}\kappa^{\beta}r_{\max}^{2}A^{3}\tau\log^{2}T." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><msup><mi>T</mi><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>β</mi><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau A^{3}r_{\mathsf{max}}^{2}\log^{2}T+T^{\frac{\beta+1}{\beta+2}}\kappa^{\beta}r_{\max}^{2}A^{3}\tau\log^{2}T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Another assumption and the regret bound </h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">As an alternaive to Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ 4 Theoretical results ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we can also impose
the following assumption to capture the relation between human preference
<math id="A5.p1.m1" class="ltx_Math" alttext="\pi_{\mathsf{HF}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><annotation encoding="application/x-tex">\pi_{\mathsf{HF}}</annotation></semantics></math> and the reference policy <math id="A5.p1.m2" class="ltx_Math" alttext="\pi_{\mathsf{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><annotation encoding="application/x-tex">\pi_{\mathsf{ref}}</annotation></semantics></math>.</p>
</div>
<div id="Thmassumption2" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption2.4" class="ltx_text ltx_font_bold">Assumption 2</span></span><span id="Thmassumption2.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption2.p1" class="ltx_para">
<p id="Thmassumption2.p1.1" class="ltx_p"><span id="Thmassumption2.p1.1.1" class="ltx_text ltx_font_italic">There exists some quantity
<math id="Thmassumption2.p1.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> such that, for any action pair <math id="Thmassumption2.p1.m2" class="ltx_Math" alttext="(a_{+},a_{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo>,</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{+},a_{-})</annotation></semantics></math>,</span></p>
<table id="A5.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex1.m1" class="ltx_Math" alttext="\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\leq\mu\frac{\pi_{\mathsf{ref}}(a_{+})}{\pi_{\mathsf{ref}}(a_{-})}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≤</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\leq\mu\frac{\pi_{\mathsf{ref}}(a_{+})}{\pi_{\mathsf{ref}}(a_{-})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p">The quantity <math id="A5.p2.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> measures the deviation of human preference from
the reference policy. Under Assumption <a href="#Thmassumption2" title="Assumption 2. ‣ Appendix E Another assumption and the regret bound ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we have</p>
<table id="A5.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex2.m1" class="ltx_Math" alttext="\displaystyle\min\bigg\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝖧𝖥</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\min\bigg\{\frac{\pi_{\mathsf{HF}}(a_{+})}{\pi_{\mathsf{HF}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex3.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq\min\bigg\{\mu\frac{\pi_{\mathsf{ref}}(a_{+})}{\pi_{\mathsf{ref}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub></mrow><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>𝗋𝖾𝖿</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mi>β</mi><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>T</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mfrac><mn>1</mn><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\min\bigg\{\mu\frac{\pi_{\mathsf{ref}}(a_{+})}{\pi_{\mathsf{ref}}(a_{-})}\alpha_{T}r_{\mathsf{max}},\left(T\frac{\pi_{\mathsf{ref}}(a_{-})}{\pi_{\mathsf{ref}}(a_{+})}\right)^{\frac{\beta}{\beta+1}}\alpha_{T}^{\frac{1}{\beta+1}}r_{\max}^{\frac{1}{\beta+1}}\bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex4.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq(\mu T)^{\frac{\beta}{2\beta+1}}(\alpha_{T}r_{\max})^{\frac{\beta+1}{2\beta+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq(\mu T)^{\frac{\beta}{2\beta+1}}(\alpha_{T}r_{\max})^{\frac{\beta+1}{2\beta+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.2" class="ltx_p">Putting the above relation with (<a href="#S4.E1" title="In Theorem 1. ‣ 4 Theoretical results ‣ Towards Efficient Online Exploration for Reinforcement Learning with Human Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), we have</p>
<table id="A5.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex5.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}(T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex5.m2" class="ltx_Math" alttext="\displaystyle\lesssim r_{\mathsf{max}}A^{2}\sqrt{T\log T}+\sum_{t=1}^{T}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{t}}+A^{2}\alpha_{T}r_{\mathsf{max}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mstyle></mrow><mo>+</mo><mrow><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>𝗆𝖺𝗑</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim r_{\mathsf{max}}A^{2}\sqrt{T\log T}+\sum_{t=1}^{T}\frac{Ar_{\mathsf{max}}\log T}{\alpha_{t}}+A^{2}\alpha_{T}r_{\mathsf{max}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex6.m1" class="ltx_Math" alttext="\displaystyle\qquad+(r_{\mathsf{max}}+\log T)A^{2}(\mu T)^{\frac{\beta}{2\beta+1}}(\alpha_{T}r_{\max})^{\frac{\beta+1}{2\beta+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>𝗆𝖺𝗑</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(r_{\mathsf{max}}+\log T)A^{2}(\mu T)^{\frac{\beta}{2\beta+1}}(\alpha_{T}r_{\max})^{\frac{\beta+1}{2\beta+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.3" class="ltx_p">By taking</p>
<table id="A5.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex7.m1" class="ltx_Math" alttext="\alpha_{t}=A+t^{\frac{\beta+1}{3\beta+2}}\big(\frac{r_{\max}}{\mu}\big)^{\frac{\beta}{3\beta+2}}\big(\frac{\log T}{A(r_{\max}+\log T)}\big)^{\frac{2\beta+1}{3\beta+2}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mrow><msup><mi>t</mi><mfrac><mrow><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac><msub><mi>r</mi><mi>max</mi></msub><mi>μ</mi></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mfrac><mi>β</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha_{t}=A+t^{\frac{\beta+1}{3\beta+2}}\big(\frac{r_{\max}}{\mu}\big)^{\frac{\beta}{3\beta+2}}\big(\frac{\log T}{A(r_{\max}+\log T)}\big)^{\frac{2\beta+1}{3\beta+2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.4" class="ltx_p">we have</p>
<table id="A5.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}(T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex8.m2" class="ltx_Math" alttext="\displaystyle\lesssim T^{\frac{2\beta+1}{3\beta+2}}\mu^{\frac{\beta}{3\beta+2}}\mathsf{poly}(A,r_{\max},\log T)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mi>T</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mfrac><mi>β</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mn>2</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝗉𝗈𝗅𝗒</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub><mo>,</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim T^{\frac{2\beta+1}{3\beta+2}}\mu^{\frac{\beta}{3\beta+2}}\mathsf{poly}(A,r_{\max},\log T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Technical lemmas</h2>

<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.4" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="x,\delta\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>δ</mi></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">x,\delta\in\mathbb{R}</annotation></semantics></math>,
we have</span></p>
<table id="A6.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex1.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}(\sigma(x)\|\sigma(x+\delta))\geq\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{|\delta|,\delta^{2}\}." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em">)</mo></mrow><mi>min</mi><mrow><mo stretchy="false">{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>δ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>,</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}(\sigma(x)\|\sigma(x+\delta))\geq\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{|\delta|,\delta^{2}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.p1" class="ltx_para">
<p id="A6.p1.1" class="ltx_p"><span id="A6.p1.1.1" class="ltx_text">Let <math id="A6.p1.m1" class="ltx_math_unparsed" alttext="f_{x}(t)\coloneqq\mathsf{KL}(\sigma(x)\|\sigma(x+t))" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>x</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><mi>𝖪𝖫</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{x}(t)\coloneqq\mathsf{KL}(\sigma(x)\|\sigma(x+t))</annotation></semantics></math>. We
have</span></p>
<table id="A6.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex2.m1" class="ltx_Math" alttext="\displaystyle f_{x}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{x}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex2.m2" class="ltx_Math" alttext="\displaystyle=\sigma(x)\log\frac{\sigma(x)}{\sigma(x+t)}+(1-\sigma(x))\log\frac{1-\sigma(x)}{1-\sigma(x+t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma(x)\log\frac{\sigma(x)}{\sigma(x+t)}+(1-\sigma(x))\log\frac{1-\sigma(x)}{1-\sigma(x+t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex3.m1" class="ltx_Math" alttext="\displaystyle=\sigma(x)\log\left(\frac{\sigma(x)}{1-\sigma(x)}\cdot\frac{1-\sigma(x+t)}{\sigma(x+t)}\right)+\log\frac{1-\sigma(x)}{1-\sigma(x+t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma(x)\log\left(\frac{\sigma(x)}{1-\sigma(x)}\cdot\frac{1-\sigma(x+t)}{\sigma(x+t)}\right)+\log\frac{1-\sigma(x)}{1-\sigma(x+t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex4.m1" class="ltx_Math" alttext="\displaystyle=\log\frac{1+\exp(x+t)}{1+\exp(x)}-\sigma(x)t=\log\left(1+\sigma(x)(e^{t}-1)\right)-\sigma(x)t." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{1+\exp(x+t)}{1+\exp(x)}-\sigma(x)t=\log\left(1+\sigma(x)(e^{t}-1)\right)-\sigma(x)t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.2" class="ltx_p"><span id="A6.p1.2.1" class="ltx_text">Then we have</span></p>
<table id="A6.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex5.m1" class="ltx_Math" alttext="f_{x}^{\prime}(t)=\frac{\sigma(x)e^{t}}{1+\sigma(x)(e^{t}-1)}-\sigma(x)=\frac{\sigma(x)\left(1-\sigma(x)\right)(e^{t}-1)}{1+\sigma(x)(e^{t}-1)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{x}^{\prime}(t)=\frac{\sigma(x)e^{t}}{1+\sigma(x)(e^{t}-1)}-\sigma(x)=\frac{\sigma(x)\left(1-\sigma(x)\right)(e^{t}-1)}{1+\sigma(x)(e^{t}-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.3" class="ltx_p"><span id="A6.p1.3.1" class="ltx_text">For any <math id="A6.p1.m2" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>, we can check that</span></p>
<table id="A6.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex6.m1" class="ltx_Math" alttext="\displaystyle f_{x}^{\prime}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{x}^{\prime}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex6.m2" class="ltx_Math" alttext="\displaystyle&gt;\sigma(x)\left(1-\sigma(x)\right)\left(1-e^{-t}\right)\geq\frac{1}{2}\sigma(x)\left(1-\sigma(x)\right)\min\left\{t,1\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>min</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\sigma(x)\left(1-\sigma(x)\right)\left(1-e^{-t}\right)\geq\frac{1}{2}\sigma(x)\left(1-\sigma(x)\right)\min\left\{t,1\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.4" class="ltx_p"><span id="A6.p1.4.1" class="ltx_text">and for any <math id="A6.p1.m3" class="ltx_Math" alttext="t\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(0,1)</annotation></semantics></math> we have</span></p>
<table id="A6.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex7.m1" class="ltx_Math" alttext="\displaystyle f_{x}^{\prime}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{x}^{\prime}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex7.m2" class="ltx_Math" alttext="\displaystyle&lt;\sigma(x)\left(1-\sigma(x)\right)\left(e^{t}-1\right)\leq 2\sigma(x)\left(1-\sigma(x)\right)t." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>e</mi><mi>t</mi></msup><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\sigma(x)\left(1-\sigma(x)\right)\left(e^{t}-1\right)\leq 2\sigma(x)\left(1-\sigma(x)\right)t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.5" class="ltx_p"><span id="A6.p1.5.1" class="ltx_text">This immediately implies that for <math id="A6.p1.m4" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>,</span></p>
<table id="A6.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex8.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathsf{KL}\left(\sigma(x)\|\sigma(x+\delta)\right)" display="inline" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo>(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{KL}\left(\sigma(x)\|\sigma(x+\delta)\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex8.m2" class="ltx_Math" alttext="\displaystyle=f_{x}(\delta)-f_{x}(0)=\int_{0}^{\delta}f_{x}^{\prime}(t)\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>f</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><msubsup><mi>f</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=f_{x}(\delta)-f_{x}(0)=\int_{0}^{\delta}f_{x}^{\prime}(t)\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex9.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\sigma(x)\left(1-\sigma(x)\right)\int_{0}^{\delta}\min\left\{t,1\right\}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup></mstyle><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo>}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\sigma(x)\left(1-\sigma(x)\right)\int_{0}^{\delta}\min\left\{t,1\right\}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex10.m1" class="ltx_Math" alttext="\displaystyle\overset{\text{(a)}}{\geq}\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{\delta,\delta^{2}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>≥</mo><mtext mathsize="0.700em">(a)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\text{(a)}}{\geq}\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{\delta,\delta^{2}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.6" class="ltx_p"><span id="A6.p1.6.1" class="ltx_text">Here step (a) holds since <math id="A6.p1.m5" class="ltx_Math" alttext="\int_{0}^{\delta}\min\{t,1\}\mathrm{d}t=\delta^{2}/2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>δ</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\int_{0}^{\delta}\min\{t,1\}\mathrm{d}t=\delta^{2}/2</annotation></semantics></math>
for <math id="A6.p1.m6" class="ltx_Math" alttext="\delta\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta\leq 1</annotation></semantics></math>, and <math id="A6.p1.m7" class="ltx_Math" alttext="\int_{0}^{\delta}\min\{t,1\}\mathrm{d}t=\delta-1/2\geq\delta/2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>δ</mi></msubsup><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><mrow><mi>δ</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><mo>≥</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\int_{0}^{\delta}\min\{t,1\}\mathrm{d}t=\delta-1/2\geq\delta/2</annotation></semantics></math>
for <math id="A6.p1.m8" class="ltx_Math" alttext="\delta&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta&gt;1</annotation></semantics></math>.</span></p>
</div>
<div id="A6.p2" class="ltx_para">
<p id="A6.p2.1" class="ltx_p"><span id="A6.p2.1.1" class="ltx_text">For <math id="A6.p2.m1" class="ltx_Math" alttext="\delta&lt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&lt;0</annotation></semantics></math>, we can use the same argument to show that</span></p>
<table id="A6.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex11.m1" class="ltx_math_unparsed" alttext="\mathsf{KL}\left(\sigma(x)\|\sigma(x+\delta)\right)\geq\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{-\delta,\delta^{2}\}." display="block" intent=":literal"><semantics><mrow><mi>𝖪𝖫</mi><mrow><mo>(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.167em">)</mo></mrow><mi>min</mi><mrow><mo stretchy="false">{</mo><mo lspace="0em">−</mo><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{KL}\left(\sigma(x)\|\sigma(x+\delta)\right)\geq\frac{1}{4}\sigma(x)\left(1-\sigma(x)\right)\min\{-\delta,\delta^{2}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p2.2" class="ltx_p"><span id="A6.p2.2.1" class="ltx_text">This completes the proof. ∎</span></p>
</div>
</div>
<div id="A6.p3" class="ltx_para">
<p id="A6.p3.1" class="ltx_p">The following lemma provides a user-friendly version of Freedman’s
inequality (the Bernstein inequality for martingale differences) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Freedman,, 1975</a>; <a href="#bib.bib23" title="" class="ltx_ref">Tropp,, 2011</a>)</cite>.</p>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.4" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">Consider a filtration <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="\{\mathcal{F}_{i}\}_{i\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\{\mathcal{F}_{i}\}_{i\geq 0}</annotation></semantics></math>
and random variables <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="\{X_{i}\}_{i\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\{X_{i}\}_{i\geq 1}</annotation></semantics></math> obeying</span></p>
<table id="A6.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex12.m1" class="ltx_Math" alttext="|X_{i}|\leq R\qquad\text{and}\qquad\mathbb{E}[X_{i}|\mathcal{F}_{i-1}]=0\qquad\text{for all }i\geq 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>R</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≥</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|X_{i}|\leq R\qquad\text{and}\qquad\mathbb{E}[X_{i}|\mathcal{F}_{i-1}]=0\qquad\text{for all }i\geq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma6.p1.2" class="ltx_p"><span id="Thmlemma6.p1.2.1" class="ltx_text ltx_font_italic">Define <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="W_{n}=\sum_{i=1}^{n}\mathbb{E}[X_{i}^{2}|\mathcal{F}_{i-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>X</mi><mi>i</mi><mn>2</mn></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{n}=\sum_{i=1}^{n}\mathbb{E}[X_{i}^{2}|\mathcal{F}_{i-1}]</annotation></semantics></math>,
and suppose that <math id="Thmlemma6.p1.m4" class="ltx_Math" alttext="W_{n}\leq\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>n</mi></msub><mo>≤</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">W_{n}\leq\sigma^{2}</annotation></semantics></math> holds deterministically for
some given quantity <math id="Thmlemma6.p1.m5" class="ltx_Math" alttext="\sigma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma&gt;0</annotation></semantics></math>. Then for any positive integer <math id="Thmlemma6.p1.m6" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>,
with probability exceeding <math id="Thmlemma6.p1.m7" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</span></p>
<table id="A6.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex13.m1" class="ltx_Math" alttext="\left|\sum_{i=1}^{n}X_{i}\right|\leq\sqrt{8\max\left\{W_{n},\frac{\sigma^{2}}{2^{m}}\right\}\log\frac{2m}{\delta}}+\frac{4}{3}R\log\frac{2m}{\delta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msqrt><mrow><mn>8</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><msub><mi>W</mi><mi>n</mi></msub><mo>,</mo><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mn>2</mn><mi>m</mi></msup></mfrac><mo>}</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>δ</mi></mfrac></mrow></msqrt><mo>+</mo><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>δ</mi></mfrac></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\sum_{i=1}^{n}X_{i}\right|\leq\sqrt{8\max\left\{W_{n},\frac{\sigma^{2}}{2^{m}}\right\}\log\frac{2m}{\delta}}+\frac{4}{3}R\log\frac{2m}{\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A6.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.p4" class="ltx_para">
<p id="A6.p4.1" class="ltx_p"><span id="A6.p4.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib16" title="" class="ltx_ref">Li et al., (2021, Section A)</a></cite>.∎</span></p>
</div>
</div>
</section>
