<th id="A1.T5.2.1.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">3958</th>
<td id="A1.T5.2.1.8.3" class="ltx_td ltx_align_center">7.8</td>
<td id="A1.T5.2.1.8.4" class="ltx_td ltx_align_center">507.4</td></tr>
<tr id="A1.T5.2.1.9" class="ltx_tr">
<th id="A1.T5.2.1.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">H800 SXM</th>
<th id="A1.T5.2.1.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">1979</th>
<td id="A1.T5.2.1.9.3" class="ltx_td ltx_align_center">3.35</td>
<td id="A1.T5.2.1.9.4" class="ltx_td ltx_align_center">590.7</td></tr>
<tr id="A1.T5.2.1.10" class="ltx_tr">
<th id="A1.T5.2.1.10.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">H800 PCIe</th>
<th id="A1.T5.2.1.10.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">1513</th>
<td id="A1.T5.2.1.10.3" class="ltx_td ltx_align_center">2</td>
<td id="A1.T5.2.1.10.4" class="ltx_td ltx_align_center">756.5</td></tr>
<tr id="A1.T5.2.1.11" class="ltx_tr">
<th id="A1.T5.2.1.11.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">H200 SXM</th>
<th id="A1.T5.2.1.11.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">1979</th>
<td id="A1.T5.2.1.11.3" class="ltx_td ltx_align_center">4.8</td>
<td id="A1.T5.2.1.11.4" class="ltx_td ltx_align_center">412.3</td></tr>
<tr id="A1.T5.2.1.12" class="ltx_tr">
<th id="A1.T5.2.1.12.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">B100</th>
<th id="A1.T5.2.1.12.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">3500</th>
<td id="A1.T5.2.1.12.3" class="ltx_td ltx_align_center">8</td>
<td id="A1.T5.2.1.12.4" class="ltx_td ltx_align_center">437.5</td></tr>
<tr id="A1.T5.2.1.13" class="ltx_tr">
<th id="A1.T5.2.1.13.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">B200</th>
<th id="A1.T5.2.1.13.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">2250</th>
<td id="A1.T5.2.1.13.3" class="ltx_td ltx_align_center ltx_border_bb">8</td>
