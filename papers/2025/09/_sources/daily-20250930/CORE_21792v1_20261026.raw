<td id="S5.T2.2.1.4.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.4.6.1" class="ltx_text ltx_font_bold">2.45</span></td>
<td id="S5.T2.2.1.4.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.4.7.1" class="ltx_text ltx_font_bold">4.55</span></td>
<td id="S5.T2.2.1.4.8" class="ltx_td ltx_align_center ltx_border_bb">2.07</td>
