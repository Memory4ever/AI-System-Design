<td id="S4.T4.4.1.5.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 4.0pt;"><span id="S4.T4.4.1.5.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DAEFF9;">68.5</span></td>
<td id="S4.T4.4.1.5.10" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;padding:0.75pt 4.0pt;"><span id="S4.T4.4.1.5.10.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;"><span id="S4.T4.4.1.5.10.1.1" class="ltx_text ltx_font_bold">75.8</span></span></td></tr>
<tr id="S4.T4.4.1.6" class="ltx_tr">
