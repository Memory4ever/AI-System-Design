<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Detailed derivations</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">In this section, we provide detailed derivations of the conclusions presented in the main text, along with some additional results.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Derivation for Eq. (<a href="#S2.E4" title="In 2.1 Evidence lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">The ELBO objective induced from Eq. (<a href="#S2.E2" title="In 2.1 Evidence lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) can be rewritten as</p>
<table id="A1.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E13.m1" class="ltx_Math" alttext="\begin{split}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;\triangleq\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\right]-\textrm{KL}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||\pi_{\theta}({\bm{z}}|{\bm{x}})\right)\\
&amp;=\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]+\mathcal{H}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right)\\
&amp;=\log P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})-{\color[rgb]{0,0,1}\textrm{KL}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})\right)}\textrm{,}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>≜</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>[</mo><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mtext>KL</mtext><mo>(</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒛</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>log</mi><mi>P</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo>−</mo><mtext style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">KL</mtext><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">q</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ϕ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒛</mi><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒙</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒚</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">′</mo></msup><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">P</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">θ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒛</mi><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒙</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒴</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝒙</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo><mtext>,</mtext></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;\triangleq\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\right]-\textrm{KL}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||\pi_{\theta}({\bm{z}}|{\bm{x}})\right)\\
&amp;=\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]+\mathcal{H}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right)\\
&amp;=\log P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})-{\color[rgb]{0,0,1}\textrm{KL}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})\right)}\textrm{,}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p1.2" class="ltx_p">where <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{H}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\cdot)</annotation></semantics></math> is entropy function and <math id="A1.SS1.p1.m2" class="ltx_Math" alttext="P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})=\frac{\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\pi_{\theta}({\bm{z}}|{\bm{x}})}{P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})=\frac{\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\pi_{\theta}({\bm{z}}|{\bm{x}})}{P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}</annotation></semantics></math> is the true posterior distribution.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Derivation for Eq. (<a href="#S2.E6" title="In 2.2 Extension to IWAE-style lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">Given the IWAE-style lower bound <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})</annotation></semantics></math> in Eq. (<a href="#S2.E5" title="In 2.2 Extension to IWAE-style lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), we can derive its gradient w.r.t. model parameters <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> as:</p>
<table id="A1.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E14.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})\\
={}&amp;\nabla_{\theta}\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\right]\\
={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\frac{\frac{1}{K}\sum_{k=1}^{K}\frac{\nabla_{\theta}\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}}{\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}}\right]\\
={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\sum_{k=1}^{K}\widetilde{\rho}_{k}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\\
&amp;\textrm{where}\quad\widetilde{\rho}_{k}=\frac{\rho_{k}}{\sum_{j=1}^{K}\rho_{j}}\quad\text{and}\quad\rho_{k}=\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\textrm{.}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext><mi>K</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>log</mi><mfrac><mn>1</mn><mi>K</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mi>k</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mfrac><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mi>k</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mi>k</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mfrac><mo>]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><mfrac><msub><mi>ρ</mi><mi>k</mi></msub><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><msub><mi>ρ</mi><mi>j</mi></msub></mrow></mfrac></mrow><mspace style="width:2.000em;" width="2.000em"></mspace><mtext>and</mtext><mspace style="width:2.000em;" width="2.000em"></mspace><mrow><msub><mi>ρ</mi><mi>k</mi></msub><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mi>k</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})\\
={}&amp;\nabla_{\theta}\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\right]\\
={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\frac{\frac{1}{K}\sum_{k=1}^{K}\frac{\nabla_{\theta}\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}}{\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}}\right]\\
={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\sum_{k=1}^{K}\widetilde{\rho}_{k}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\\
&amp;\textrm{where}\quad\widetilde{\rho}_{k}=\frac{\rho_{k}}{\sum_{j=1}^{K}\rho_{j}}\quad\text{and}\quad\rho_{k}=\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\textrm{.}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p1.2" class="ltx_p">Using the notations of <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="\rho_{k}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\rho_{k}</annotation></semantics></math> and <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="\widetilde{\rho}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\widetilde{\rho}_{k}</annotation></semantics></math>, we can further derive the gradient w.r.t. <math id="A1.SS2.p1.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> as:</p>
<table id="A1.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex1.m1" class="ltx_Math" alttext="\begin{split}\!\!\!\!\!&amp;\nabla_{\phi}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})\!\!\\
\!\!\!\!\!={}&amp;\nabla_{\phi}\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\right]\!\!\\
\!\!\!\!\!={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\left(\log\frac{1}{K}\sum_{k=1}^{K}\rho_{k}\right)\cdot\sum_{k=1}^{K}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})-\sum_{k=1}^{K}\widetilde{\rho}_{k}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})\right]\!\!\\
\!\!\!\!\!={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\sum_{k=1}^{K}\left(-\widetilde{\rho}_{k}+\log\frac{1}{K}\sum_{k=1}^{K}\rho_{k}\right)\cdot\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})\right]\textrm{.}\!\!\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext><mi>K</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>log</mi><mfrac><mn>1</mn><mi>K</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mi>k</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>(</mo><mi>log</mi><mfrac><mn>1</mn><mi>K</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mi>ρ</mi><msub><mrow></mrow><mi>k</mi></msub><mo rspace="0.055em">)</mo><mo rspace="0.055em">⋅</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>log</mi><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo rspace="0.055em">−</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>log</mi><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mo>(</mo><mo lspace="0em">−</mo><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo>+</mo><mi>log</mi><mfrac><mn>1</mn><mi>K</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mi>ρ</mi><msub><mrow></mrow><mi>k</mi></msub><mo rspace="0.055em">)</mo><mo rspace="0.222em">⋅</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>log</mi><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>k</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>]</mo><mtext>.</mtext></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\!\!\!\!\!&amp;\nabla_{\phi}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})\!\!\\
\!\!\!\!\!={}&amp;\nabla_{\phi}\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\log\frac{1}{K}\sum_{k=1}^{K}\frac{\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})}\right]\!\!\\
\!\!\!\!\!={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\left(\log\frac{1}{K}\sum_{k=1}^{K}\rho_{k}\right)\cdot\sum_{k=1}^{K}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})-\sum_{k=1}^{K}\widetilde{\rho}_{k}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})\right]\!\!\\
\!\!\!\!\!={}&amp;\mathbb{E}_{{\bm{z}}_{1:K}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\sum_{k=1}^{K}\left(-\widetilde{\rho}_{k}+\log\frac{1}{K}\sum_{k=1}^{K}\rho_{k}\right)\cdot\nabla_{\phi}\log q_{\phi}({\bm{z}}_{k}|{\bm{x}},{\bm{y}}^{\prime})\right]\textrm{.}\!\!\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ 2.2 Extension to IWAE-style lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p">As to the computation of <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})</annotation></semantics></math>, there are two unbiased estimators:</p>
<table id="A1.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E15.m1" class="ltx_Math" alttext="\begin{split}\textbf{Likelihood-based estimator:}&amp;\quad\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})=|\mathcal{Y}_{\bm{x}}|\cdot\mathbb{E}_{{\bm{y}}\sim\mathcal{U}(\mathcal{Y}_{\bm{x}})}\left[\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\textrm{;}\\
\textbf{Accuracy-based estimator:}&amp;\quad\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})=\mathbb{E}_{{\bm{y}}\sim\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\right]\textrm{,}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mtext class="ltx_mathvariant_bold">Likelihood-based estimator:</mtext></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>𝒚</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mtext class="ltx_mathvariant_bold">Accuracy-based estimator:</mtext></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝒚</mi><mo>∼</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>,</mtext></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\textbf{Likelihood-based estimator:}&amp;\quad\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})=|\mathcal{Y}_{\bm{x}}|\cdot\mathbb{E}_{{\bm{y}}\sim\mathcal{U}(\mathcal{Y}_{\bm{x}})}\left[\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\textrm{;}\\
\textbf{Accuracy-based estimator:}&amp;\quad\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})=\mathbb{E}_{{\bm{y}}\sim\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\right]\textrm{,}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p">where <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="|\mathcal{Y}_{\bm{x}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Y}_{\bm{x}}|</annotation></semantics></math> is the cardinal (number of elements) of <math id="A1.SS3.p1.m3" class="ltx_Math" alttext="\mathcal{Y}_{\bm{x}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><annotation encoding="application/x-tex">\mathcal{Y}_{\bm{x}}</annotation></semantics></math>, <math id="A1.SS3.p1.m4" class="ltx_Math" alttext="\mathcal{U}(\mathcal{Y}_{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}(\mathcal{Y}_{\bm{x}})</annotation></semantics></math> is the uniform distribution on <math id="A1.SS3.p1.m5" class="ltx_Math" alttext="\mathcal{Y}_{\bm{x}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><annotation encoding="application/x-tex">\mathcal{Y}_{\bm{x}}</annotation></semantics></math>, and <math id="A1.SS3.p1.m6" class="ltx_Math" alttext="\mathds{1}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathds{1}(\cdot)</annotation></semantics></math> is the indicator function. When <math id="A1.SS3.p1.m7" class="ltx_Math" alttext="|\mathcal{Y}_{\bm{x}}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{Y}_{\bm{x}}|=1</annotation></semantics></math>, i.e., there is a unique correct answer expression <math id="A1.SS3.p1.m8" class="ltx_Math" alttext="{\bm{y}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝒚</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\bm{y}}^{*}</annotation></semantics></math>, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib77" title="" class="ltx_ref">Zhou et al. (2025)</a></cite> show that the likelihood-based estimator has lower variance (in fact, zero) compared to the accuracy-based one. We now extend this comparison to general cases when <math id="A1.SS3.p1.m9" class="ltx_Math" alttext="|\mathcal{Y}_{\bm{x}}|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{Y}_{\bm{x}}|&gt;1</annotation></semantics></math>:</p>
<table id="A1.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E16.m1" class="ltx_Math" alttext="\begin{split}\textrm{Var}_{\textrm{like}}&amp;=|\mathcal{Y}_{\bm{x}}|^{2}\cdot\textrm{Var}_{{\bm{y}}\sim\mathcal{U}(\mathcal{Y}_{\bm{x}})}\left[\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\textrm{;}\\
\textrm{Var}_{\textrm{acc}}&amp;=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\cdot\left(1-\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\right)\textrm{.}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mtext>Var</mtext><mtext>like</mtext></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mn>2</mn></msup><mo rspace="0.222em">⋅</mo><msub><mtext>Var</mtext><mrow><mi>𝒚</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mtext>Var</mtext><mtext>acc</mtext></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\textrm{Var}_{\textrm{like}}&amp;=|\mathcal{Y}_{\bm{x}}|^{2}\cdot\textrm{Var}_{{\bm{y}}\sim\mathcal{U}(\mathcal{Y}_{\bm{x}})}\left[\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\textrm{;}\\
\textrm{Var}_{\textrm{acc}}&amp;=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\cdot\left(1-\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\right)\textrm{.}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.3" class="ltx_p">Note that the variance <math id="A1.SS3.p1.m10" class="ltx_Math" alttext="\textrm{Var}_{\textrm{acc}}" display="inline" intent=":literal"><semantics><msub><mtext>Var</mtext><mtext>acc</mtext></msub><annotation encoding="application/x-tex">\textrm{Var}_{\textrm{acc}}</annotation></semantics></math> of accuracy-based estimator is independent of <math id="A1.SS3.p1.m11" class="ltx_Math" alttext="|\mathcal{Y}_{\bm{x}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Y}_{\bm{x}}|</annotation></semantics></math> and the model distribution <math id="A1.SS3.p1.m12" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> over different elements in <math id="A1.SS3.p1.m13" class="ltx_Math" alttext="\mathcal{Y}_{\bm{x}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><annotation encoding="application/x-tex">\mathcal{Y}_{\bm{x}}</annotation></semantics></math>. Assuming that in the worst case where only one element <math id="A1.SS3.p1.m14" class="ltx_Math" alttext="{\bm{y}}^{*}\in\mathcal{Y}_{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒚</mi><mo>∗</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{y}}^{*}\in\mathcal{Y}_{\bm{x}}</annotation></semantics></math> has non-zero probability under <math id="A1.SS3.p1.m15" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>, i.e., <math id="A1.SS3.p1.m16" class="ltx_Math" alttext="\pi_{\theta}({\bm{y}}^{*}|{\bm{x}},{\bm{z}})=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}({\bm{y}}^{*}|{\bm{x}},{\bm{z}})=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})</annotation></semantics></math>, we have</p>
<table id="A1.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E17.m1" class="ltx_Math" alttext="\begin{split}\textrm{Var}_{\textrm{like}}^{\textrm{worst}}&amp;\triangleq\max_{\pi_{\theta}}\textrm{Var}_{\textrm{like}}=\left(|\mathcal{Y}_{\bm{x}}|-1\right)\cdot\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})^{2}\textrm{;}\\
\textrm{Var}_{\textrm{acc}}^{\textrm{worst}}&amp;\triangleq\max_{\pi_{\theta}}\textrm{Var}_{\textrm{acc}}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\cdot\left(1-\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\right)\textrm{.}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mtext>Var</mtext><mtext>like</mtext><mtext>worst</mtext></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≜</mo><mrow><munder><mi>max</mi><msub><mi>π</mi><mi>θ</mi></msub></munder><mo lspace="0.167em">⁡</mo><msub><mtext>Var</mtext><mtext>like</mtext></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mtext>Var</mtext><mtext>acc</mtext><mtext>worst</mtext></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≜</mo><mrow><munder><mi>max</mi><msub><mi>π</mi><mi>θ</mi></msub></munder><mo lspace="0.167em">⁡</mo><msub><mtext>Var</mtext><mtext>acc</mtext></msub></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\textrm{Var}_{\textrm{like}}^{\textrm{worst}}&amp;\triangleq\max_{\pi_{\theta}}\textrm{Var}_{\textrm{like}}=\left(|\mathcal{Y}_{\bm{x}}|-1\right)\cdot\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})^{2}\textrm{;}\\
\textrm{Var}_{\textrm{acc}}^{\textrm{worst}}&amp;\triangleq\max_{\pi_{\theta}}\textrm{Var}_{\textrm{acc}}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\cdot\left(1-\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\right)\textrm{.}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.4" class="ltx_p">Here we slightly abuse the notation of <math id="A1.SS3.p1.m17" class="ltx_Math" alttext="\max_{\pi_{\theta}}" display="inline" intent=":literal"><semantics><msub><mi>max</mi><msub><mi>π</mi><mi>θ</mi></msub></msub><annotation encoding="application/x-tex">\max_{\pi_{\theta}}</annotation></semantics></math>, since the maximization is taken w.r.t. all <math id="A1.SS3.p1.m18" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> <em id="A1.SS3.p1.4.1" class="ltx_emph ltx_font_italic">under fixed value <math id="A1.SS3.p1.m19" class="ltx_Math" alttext="\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})</annotation></semantics></math></em>. As seen, <math id="A1.SS3.p1.m20" class="ltx_Math" alttext="\textrm{Var}_{\textrm{like}}^{\textrm{worst}}\geq\textrm{Var}_{\textrm{acc}}^{\textrm{worst}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>Var</mtext><mtext>like</mtext><mtext>worst</mtext></msubsup><mo>≥</mo><msubsup><mtext>Var</mtext><mtext>acc</mtext><mtext>worst</mtext></msubsup></mrow><annotation encoding="application/x-tex">\textrm{Var}_{\textrm{like}}^{\textrm{worst}}\geq\textrm{Var}_{\textrm{acc}}^{\textrm{worst}}</annotation></semantics></math> holds when the model accuracy (condition on <math id="A1.SS3.p1.m21" class="ltx_Math" alttext="{\bm{x}},{\bm{z}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">{\bm{x}},{\bm{z}}</annotation></semantics></math>) satisfies</p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_Math" alttext="\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\geq\frac{1}{|\mathcal{Y}_{x}|}\textrm{,}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>x</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext>,</mtext></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}})\geq\frac{1}{|\mathcal{Y}_{x}|}\textrm{,}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.5" class="ltx_p">which almost always holds for <math id="A1.SS3.p1.m22" class="ltx_Math" alttext="|\mathcal{Y}_{x}|\gg 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>x</mi></msub><mo stretchy="false">|</mo></mrow><mo>≫</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{Y}_{x}|\gg 1</annotation></semantics></math>.∎</p>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Derivation for Eq. (<a href="#S2.E9" title="In 2.3 Optimizing the variational posterior via forward KL divergence ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>)</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.p1.1" class="ltx_p">Now we derive the gradient of the forward KL divergence <math id="A1.SS4.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝔻</mi><mtext style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">KL</mtext></msub><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">P</mi><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">θ</mi></msub><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒛</mi><mo style="--ltx-fg-color:#FF8000;" fence="false" mathcolor="#FF8000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒙</mi><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">,</mo><msub><mi style="--ltx-fg-color:#FF8000;" class="ltx_font_mathcaligraphic" mathcolor="#FF8000">𝒴</mi><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒙</mi></msub><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#FF8000;" fence="false" mathcolor="#FF8000" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#FF8000;" fence="false" mathcolor="#FF8000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">q</mi><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">ϕ</mi></msub><mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒛</mi><mo style="--ltx-fg-color:#FF8000;" fence="false" mathcolor="#FF8000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒙</mi><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">,</mo><msup><mi style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">𝒚</mi><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">′</mo></msup><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))</annotation></semantics></math> w.r.t. <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>:</p>
<table id="A1.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E19.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\phi}\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))\\
={}&amp;-\nabla_{\phi}\mathbb{E}_{P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})}\left[\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\\
={}&amp;-\nabla_{\phi}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\frac{\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})}{P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\\
\simeq{}&amp;\mathbb{E}_{{\bm{z}}_{1:M}\sim\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\sum_{m=1}^{M}\widetilde{w}_{m}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{m}|{\bm{x}},{\bm{y}}^{\prime})\right]\triangleq\nabla_{\phi}\mathcal{L}_{\textrm{forward}}^{M}\textrm{,}\\
&amp;\textrm{where}\quad\widetilde{w}_{m}=\frac{w_{m}}{\sum_{j=1}^{M}w_{j}}\quad\text{and}\quad w_{m}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}}_{m})\textrm{.}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>𝔻</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>𝔼</mi><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≃</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>M</mi></mrow></msub><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>M</mi></msup><mover accent="true"><mi>w</mi><mo>~</mo></mover><msub><mrow></mrow><mi>m</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>log</mi><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>m</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>]</mo><mo>≜</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mtext>forward</mtext></msub><msup><mrow></mrow><mi>M</mi></msup><mtext>,</mtext></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>m</mi></msub><mo>=</mo><mfrac><msub><mi>w</mi><mi>m</mi></msub><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><msub><mi>w</mi><mi>j</mi></msub></mrow></mfrac></mrow><mspace style="width:2.000em;" width="2.000em"></mspace><mtext>and</mtext><mspace style="width:2.000em;" width="2.000em"></mspace><mrow><msub><mi>w</mi><mi>m</mi></msub><mo>=</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi>𝒛</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\nabla_{\phi}\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))\\
={}&amp;-\nabla_{\phi}\mathbb{E}_{P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})}\left[\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\\
={}&amp;-\nabla_{\phi}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\frac{\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})}{P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\\
\simeq{}&amp;\mathbb{E}_{{\bm{z}}_{1:M}\sim\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\sum_{m=1}^{M}\widetilde{w}_{m}\nabla_{\phi}\log q_{\phi}({\bm{z}}_{m}|{\bm{x}},{\bm{y}}^{\prime})\right]\triangleq\nabla_{\phi}\mathcal{L}_{\textrm{forward}}^{M}\textrm{,}\\
&amp;\textrm{where}\quad\widetilde{w}_{m}=\frac{w_{m}}{\sum_{j=1}^{M}w_{j}}\quad\text{and}\quad w_{m}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}}_{m})\textrm{.}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Connection to more general RL reward shaping</h3>

<div id="A1.SS5.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.p1.1" class="ltx_p">In the literature on reinforcement learning with verifiable rewards (RLVR), various strategies for reward shaping have been proposed, many of which can be expressed as</p>
<table id="A1.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E20.m1" class="ltx_Math" alttext="\mathcal{R}({\bm{x}},{\bm{y}})=\begin{cases}\alpha&amp;\textrm{if }{\bm{y}}\in\mathcal{Y}_{{\bm{x}}}\textrm{;}\\
\beta&amp;\textrm{if }{\bm{y}}\notin\mathcal{Y}_{{\bm{x}}}\land{\bm{y}}\in\mathcal{Y}_{\textrm{format}}\textrm{;}\\
\gamma&amp;\textrm{otherwise,}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi>α</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>β</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>∉</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>∧</mo><mi>𝒚</mi></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>γ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise,</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}({\bm{x}},{\bm{y}})=\begin{cases}\alpha&amp;\textrm{if }{\bm{y}}\in\mathcal{Y}_{{\bm{x}}}\textrm{;}\\
\beta&amp;\textrm{if }{\bm{y}}\notin\mathcal{Y}_{{\bm{x}}}\land{\bm{y}}\in\mathcal{Y}_{\textrm{format}}\textrm{;}\\
\gamma&amp;\textrm{otherwise,}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.2" class="ltx_p">where <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="\alpha,\beta,\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha,\beta,\gamma</annotation></semantics></math> are hyperparameters, <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="\mathcal{Y}_{\textrm{format}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><annotation encoding="application/x-tex">\mathcal{Y}_{\textrm{format}}</annotation></semantics></math> is the set of answers that correctly follow required format (e.g., <span id="A1.SS5.p1.2.1" class="ltx_text ltx_font_typewriter">\boxed{}</span>) and is typically independent of <math id="A1.SS5.p1.m3" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math>. Apparently, <math id="A1.SS5.p1.m4" class="ltx_Math" alttext="\mathcal{Y}_{{\bm{x}}}\subset\mathcal{Y}_{\textrm{format}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{Y}_{{\bm{x}}}\subset\mathcal{Y}_{\textrm{format}}</annotation></semantics></math> holds for any <math id="A1.SS5.p1.m5" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math>. Then we can derive the gradient of training objective under the general reward shaping <math id="A1.SS5.p1.m6" class="ltx_Math" alttext="\mathcal{R}({\bm{x}},{\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}({\bm{x}},{\bm{y}})</annotation></semantics></math> as</p>
<table id="A1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{general-RL}}({\bm{x}},\pi_{\theta})\\
\triangleq{}&amp;\nabla_{\theta}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\cdot\left(\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}}){\color[rgb]{0.668,0.668,0.668}+\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\right)\right]\\
\xRightarrow[\scriptstyle\pi_{\theta}({\bm{z}}|{\bm{x}})]{\textrm{only w.r.t.}}{}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\left((\alpha-\beta)\cdot\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})+(\beta-\gamma)\cdot\pi_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}},{\bm{z}})\right)\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})\right]\\
={}&{\color[rgb]{1,0,0}(\alpha-\beta)\cdot P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\cdot\nabla_{\theta}\mathbb{D}_{\textrm{KL}}(P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||\pi_{\theta}({\bm{z}}|{\bm{x}}))\\
&amp;\quad+{\color[rgb]{1,0,0}(\beta-\gamma)\cdot P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\cdot\nabla_{\theta}\mathbb{D}_{\textrm{KL}}(P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})||\pi_{\theta}({\bm{z}}|{\bm{x}}))\textrm{,}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>general-RL</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≜</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">+</mo><mrow><msub><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">∇</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">π</mi><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA" stretchy="false">(</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">𝒚</mi><mo style="--ltx-fg-color:#AAAAAA;" lspace="0em" mathcolor="#AAAAAA" rspace="0em">|</mo><mrow><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">𝒙</mi><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">,</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">𝒛</mi></mrow><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA" stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><munderover accent="true" accentunder="true"><mo class="ltx_mathvariant_italic" mathvariant="italic">⇒</mo><mrow><msub><mi mathsize="0.700em">π</mi><mi mathsize="0.710em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">𝒛</mi><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><mi mathsize="0.700em">𝒙</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mtext mathsize="0.700em">only w.r.t.</mtext></munderover></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mo>∇</mo><mi>θ</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mo>∇</mo><mi>θ</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">α</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">β</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.055em" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">P</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">θ</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" class="ltx_font_mathcaligraphic" mathcolor="#FF0000">𝒴</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝒙</mi></msub><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝒙</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔻</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>sg</mi></msup><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>+</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">β</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">γ</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.055em" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">P</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">θ</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" class="ltx_font_mathcaligraphic" mathcolor="#FF0000">𝒴</mi><msub><mrow></mrow><mtext style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">format</mtext></msub><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝒙</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔻</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>sg</mi></msup><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mtext>format</mtext></msub><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mtext>,</mtext></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{general-RL}}({\bm{x}},\pi_{\theta})\\
\triangleq{}&amp;\nabla_{\theta}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\cdot\left(\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}}){\color[rgb]{0.668,0.668,0.668}+\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\right)\right]\\
\xRightarrow[\scriptstyle\pi_{\theta}({\bm{z}}|{\bm{x}})]{\textrm{only w.r.t.}}{}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathcal{R}({\bm{x}},{\bm{y}})\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\left((\alpha-\beta)\cdot\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})+(\beta-\gamma)\cdot\pi_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}},{\bm{z}})\right)\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})\right]\\
={}&amp;{\color[rgb]{1,0,0}(\alpha-\beta)\cdot P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\cdot\nabla_{\theta}\mathbb{D}_{\textrm{KL}}(P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||\pi_{\theta}({\bm{z}}|{\bm{x}}))\\
&amp;\quad+{\color[rgb]{1,0,0}(\beta-\gamma)\cdot P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\cdot\nabla_{\theta}\mathbb{D}_{\textrm{KL}}(P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})||\pi_{\theta}({\bm{z}}|{\bm{x}}))\textrm{,}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.3" class="ltx_p">where <math id="A1.SS5.p1.m7" class="ltx_Math" alttext="P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})</annotation></semantics></math> is the probability that the output answers follow the required format. It is easy to know that the optimal solution for Eq. (<a href="#A1.E21" title="In A.5 Connection to more general RL reward shaping ‣ Appendix A Detailed derivations ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) can be written as:</p>
<table id="A1.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E22.m1" class="ltx_Math" alttext="\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})=\frac{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}},\mathcal{Y}_{\textrm{format}}|{\bm{x}})}{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\textrm{.}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>θ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒛</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒛</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})=\frac{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}},\mathcal{Y}_{\textrm{format}}|{\bm{x}})}{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\textrm{.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.4" class="ltx_p"><span id="A1.SS5.p1.4.1" class="ltx_text ltx_font_bold">Remark.</span> When <math id="A1.SS5.p1.m8" class="ltx_Math" alttext="\beta=\gamma" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\beta=\gamma</annotation></semantics></math>, i.e., there is no format reward, the optimization problem in Eq. (<a href="#A1.E21" title="In A.5 Connection to more general RL reward shaping ‣ Appendix A Detailed derivations ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) degrades to Eq. (<a href="#S3.E11" title="In 3 Connection to other methods ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>). When <math id="A1.SS5.p1.m9" class="ltx_Math" alttext="\alpha&gt;\beta&gt;\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mi>β</mi><mo>&gt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha&gt;\beta&gt;\gamma</annotation></semantics></math>, the model <math id="A1.SS5.p1.m10" class="ltx_Math" alttext="\pi_{\theta}({\bm{z}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}({\bm{z}}|{\bm{x}})</annotation></semantics></math> will tend to hack reward function on hard problems (i.e., low <math id="A1.SS5.p1.m11" class="ltx_Math" alttext="P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})</annotation></semantics></math>) that can easily follow format (i.e., high <math id="A1.SS5.p1.m12" class="ltx_Math" alttext="P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})</annotation></semantics></math>), where <math id="A1.SS5.p1.m13" class="ltx_Math" alttext="\pi_{\theta}({\bm{z}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}({\bm{z}}|{\bm{x}})</annotation></semantics></math> will seek modes of <math id="A1.SS5.p1.m14" class="ltx_Math" alttext="P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})</annotation></semantics></math>. Besides, there may be an intuition that setting <math id="A1.SS5.p1.m15" class="ltx_Math" alttext="\beta&lt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&lt;0</annotation></semantics></math> could alleviate reward hacking, however, as shown in Eq. (<a href="#A1.E21" title="In A.5 Connection to more general RL reward shaping ‣ Appendix A Detailed derivations ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>), the optimization only depends on the relative values of <math id="A1.SS5.p1.m16" class="ltx_Math" alttext="\alpha-\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha-\beta</annotation></semantics></math> and <math id="A1.SS5.p1.m17" class="ltx_Math" alttext="\beta-\gamma" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\beta-\gamma</annotation></semantics></math>.</p>
</div>
<div id="A1.SS5.p2" class="ltx_para ltx_noindent">
<p id="A1.SS5.p2.1" class="ltx_p">Now we show that it is straightforward to debias <math id="A1.SS5.p2.m1" class="ltx_Math" alttext="P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})</annotation></semantics></math> and <math id="A1.SS5.p2.m2" class="ltx_Math" alttext="P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})</annotation></semantics></math> in Eq. (<a href="#A1.E21" title="In A.5 Connection to more general RL reward shaping ‣ Appendix A Detailed derivations ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>). Specifically, we can rewrite the reward function as (note that reward functions are equivalent up to any constant):</p>
<table id="A1.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E23.m1" class="ltx_Math" alttext="\mathcal{R}({\bm{x}},{\bm{y}})=(\alpha-\beta)\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})+(\beta-\gamma)\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{\textrm{format}})\textrm{.}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mn>𝟙</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mn>𝟙</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}({\bm{x}},{\bm{y}})=(\alpha-\beta)\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})+(\beta-\gamma)\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{\textrm{format}})\textrm{.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.2" class="ltx_p">Then the debiased version of reward function is</p>
<table id="A1.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E24.m1" class="ltx_Math" alttext="\mathcal{R}^{\ddagger}({\bm{x}},{\bm{y}})=\frac{(\alpha-\beta)}{P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})+\frac{(\beta-\gamma)}{P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{\textrm{format}})\textrm{,}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>‡</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>,</mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}^{\ddagger}({\bm{x}},{\bm{y}})=\frac{(\alpha-\beta)}{P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})+\frac{(\beta-\gamma)}{P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})}\cdot\mathds{1}({\bm{y}}\in\mathcal{Y}_{\textrm{format}})\textrm{,}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.3" class="ltx_p">where in practice <math id="A1.SS5.p2.m3" class="ltx_Math" alttext="P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}})</annotation></semantics></math> and <math id="A1.SS5.p2.m4" class="ltx_Math" alttext="P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\theta}^{\mathrm{sg}}(\mathcal{Y}_{\textrm{format}}|{\bm{x}})</annotation></semantics></math> can be approximated by the ratio of correct answers (i.e., model accuracy) and the ratio of correct format for each batch of RL rollouts (larger rollout number could lead to more accurate estimation). After using the debiased reward function <math id="A1.SS5.p2.m5" class="ltx_Math" alttext="\mathcal{R}^{\ddagger}({\bm{x}},{\bm{y}})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>‡</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}^{\ddagger}({\bm{x}},{\bm{y}})</annotation></semantics></math>, the optimal solution of <math id="A1.SS5.p2.m6" class="ltx_Math" alttext="\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>θ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})</annotation></semantics></math> becomes</p>
<table id="A1.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E25.m1" class="ltx_Math" alttext="\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})=\frac{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})}{\alpha-\gamma}\textrm{.}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>θ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mi>γ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mi>θ</mi><mi>sg</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mtext>format</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>α</mi><mo>−</mo><mi>γ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}^{*}({\bm{z}}|{\bm{x}})=\frac{(\alpha-\beta)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})+(\beta-\gamma)\cdot P_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}},\mathcal{Y}_{\textrm{format}})}{\alpha-\gamma}\textrm{.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.6 </span>Special cases in Eq. (<a href="#S2.E6" title="In 2.2 Extension to IWAE-style lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)</h3>

<div id="A1.SS6.p1" class="ltx_para ltx_noindent">
<p id="A1.SS6.p1.1" class="ltx_p"><span id="A1.SS6.p1.1.1" class="ltx_text ltx_font_bold">Special case I: <math id="A1.SS6.p1.m1" class="ltx_Math" alttext="q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})=\pi_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>π</mi><mi>θ</mi><mi>sg</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})=\pi_{\theta}^{\mathrm{sg}}({\bm{z}}|{\bm{x}})</annotation></semantics></math>.</span> In this case, we can simplify the gradient estimation as</p>
<table id="A1.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E26.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}};\pi_{\theta},\pi_{\theta}^{\mathrm{sg}})=\mathbb{E}_{{\bm{z}}_{1:K}\sim\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\sum_{k=1}^{K}\widetilde{w}_{k}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\\
&amp;\textrm{where}\quad\widetilde{w}_{k}=\frac{w_{k}}{\sum_{j=1}^{K}w_{j}}\quad\text{and}\quad w_{k}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}}_{k})\textrm{,}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mtext>ELBO</mtext></msub><msup><mrow></mrow><mi>K</mi></msup><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo>;</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>,</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><msup><mrow></mrow><mi>sg</mi></msup><mo stretchy="false">)</mo><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>K</mi></mrow></msub><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mover accent="true"><mi>w</mi><mo>~</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><mfrac><msub><mi>w</mi><mi>k</mi></msub><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><msub><mi>w</mi><mi>j</mi></msub></mrow></mfrac></mrow><mspace style="width:2.000em;" width="2.000em"></mspace><mtext>and</mtext><mspace style="width:2.000em;" width="2.000em"></mspace><mrow><msub><mi>w</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msub><mi>𝒛</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>,</mtext></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}^{K}({\bm{x}},\mathcal{Y}_{{\bm{x}}};\pi_{\theta},\pi_{\theta}^{\mathrm{sg}})=\mathbb{E}_{{\bm{z}}_{1:K}\sim\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\sum_{k=1}^{K}\widetilde{w}_{k}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}_{k},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\\
&amp;\textrm{where}\quad\widetilde{w}_{k}=\frac{w_{k}}{\sum_{j=1}^{K}w_{j}}\quad\text{and}\quad w_{k}=\pi_{\theta}(\mathcal{Y}_{\bm{x}}|{\bm{x}},{\bm{z}}_{k})\textrm{,}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A1.SS6.p1.2" class="ltx_p">which can be regarded as a normalized version of VeriFree <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib77" title="" class="ltx_ref">Zhou et al., 2025</a>)</cite>.</p>
</div>
<div id="A1.SS6.p2" class="ltx_para ltx_noindent">
<p id="A1.SS6.p2.1" class="ltx_p"><span id="A1.SS6.p2.1.1" class="ltx_text ltx_font_bold">Special case II: <math id="A1.SS6.p2.m1" class="ltx_Math" alttext="K=1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K=1</annotation></semantics></math>.</span> In this case <math id="A1.SS6.p2.m2" class="ltx_Math" alttext="\mathcal{L}_{\textrm{ELBO}}^{1}=\mathcal{L}_{\textrm{ELBO}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext><mn>1</mn></msubsup><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\textrm{ELBO}}^{1}=\mathcal{L}_{\textrm{ELBO}}</annotation></semantics></math> and we can simplify the gradient estimation as</p>
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="\begin{split}\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;=\mathbb{E}_{{\bm{z}}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\nabla_{\theta}\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\textrm{;}\\
\nabla_{\phi}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;=\mathbb{E}_{{\bm{z}}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\left(\log\frac{\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\right)\cdot\nabla_{\phi}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\textrm{.}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><mo>∼</mo><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒛</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>;</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><mo>∼</mo><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒛</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mo>∇</mo><mi>ϕ</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>.</mtext></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\nabla_{\theta}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;=\mathbb{E}_{{\bm{z}}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\nabla_{\theta}\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\right]\textrm{;}\\
\nabla_{\phi}\mathcal{L}_{\textrm{ELBO}}({\bm{x}},\mathcal{Y}_{{\bm{x}}},{\bm{y}}^{\prime};\pi_{\theta},q_{\phi})&amp;=\mathbb{E}_{{\bm{z}}\sim q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\left[\left(\log\frac{\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})}{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\right)\cdot\nabla_{\phi}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\right]\textrm{.}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.7 </span>More derivations for Eq. (<a href="#S3.E11" title="In 3 Connection to other methods ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>)</h3>

<div id="A1.SS7.p1" class="ltx_para ltx_noindent">
<p id="A1.SS7.p1.1" class="ltx_p">Now we investigate the gradient of binary reward RL w.r.t. <math id="A1.SS7.p1.m1" class="ltx_Math" alttext="\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})</annotation></semantics></math>:</p>
<table id="A1.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E28.m1" class="ltx_Math" alttext="\begin{split}\nabla_{\theta}\mathcal{L}_{\textrm{bi-RL}}({\bm{x}},\pi_{\theta})\triangleq{}&amp;\nabla_{\theta}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\cdot\left({\color[rgb]{0.668,0.668,0.668}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})+}\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right)\right]\\
\xRightarrow[\scriptstyle\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})]{\textrm{only w.r.t.}}{}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\nabla_{\theta}\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\right]\textrm{,}\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>bi-RL</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>π</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msub><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">∇</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">π</mi><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA" stretchy="false">(</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">𝒛</mi><mo style="--ltx-fg-color:#AAAAAA;" lspace="0em" mathcolor="#AAAAAA" rspace="0em">|</mo><mi style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">𝒙</mi><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#AAAAAA;" mathcolor="#AAAAAA">+</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><munderover accent="true" accentunder="true"><mo class="ltx_mathvariant_italic" mathvariant="italic">⇒</mo><mrow><msub><mi mathsize="0.700em">π</mi><mi mathsize="0.710em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">𝒚</mi><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><mrow><mi mathsize="0.700em">𝒙</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">𝒛</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mtext mathsize="0.700em">only w.r.t.</mtext></munderover></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mo>∇</mo><mi>θ</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>𝔼</mi><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>,</mtext></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\nabla_{\theta}\mathcal{L}_{\textrm{bi-RL}}({\bm{x}},\pi_{\theta})\triangleq{}&amp;\nabla_{\theta}\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\cdot\left({\color[rgb]{0.668,0.668,0.668}\nabla_{\theta}\log\pi_{\theta}({\bm{z}}|{\bm{x}})+}\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right)\right]\\
\xRightarrow[\scriptstyle\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})]{\textrm{only w.r.t.}}{}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\mathbb{E}_{\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})}\left[\mathds{1}({\bm{y}}\in\mathcal{Y}_{{\bm{x}}})\cdot\nabla_{\theta}\log\pi_{\theta}({\bm{y}}|{\bm{x}},{\bm{z}})\right]\\
={}&amp;\mathbb{E}_{\pi_{\theta}({\bm{z}}|{\bm{x}})}\left[\nabla_{\theta}\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})\right]\textrm{,}\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A1.SS7.p1.2" class="ltx_p">where the optimal solution is straightforward that <math id="A1.SS7.p1.m2" class="ltx_Math" alttext="\forall{\bm{z}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\forall{\bm{z}}</annotation></semantics></math>, there is <math id="A1.SS7.p1.m3" class="ltx_Math" alttext="\pi_{\theta}^{*}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>θ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi_{\theta}^{*}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})=1</annotation></semantics></math>. However, this optimal solution is usually unachievable, since it requires the model to return <math id="A1.SS7.p1.m4" class="ltx_Math" alttext="100\%" display="inline" intent=":literal"><semantics><mrow><mn>100</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">100\%</annotation></semantics></math> correct answers independent of the thinking process <math id="A1.SS7.p1.m5" class="ltx_Math" alttext="{\bm{z}}" display="inline" intent=":literal"><semantics><mi>𝒛</mi><annotation encoding="application/x-tex">{\bm{z}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.8 </span>Connection to Reinforcement Learning Teachers</h3>

<div id="A1.SS8.p1" class="ltx_para ltx_noindent">
<p id="A1.SS8.p1.1" class="ltx_p">In the derivation of our method, the ELBO objective in Eq. (<a href="#S2.E4" title="In 2.1 Evidence lower bound ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) minimizes <em id="A1.SS8.p1.1.1" class="ltx_emph ltx_font_italic">reverse</em> KL divergence <math id="A1.SS8.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{D}_{\textrm{KL}}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔻</mi><mtext>KL</mtext></msub><mrow><mo>(</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{D}_{\textrm{KL}}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})\right)</annotation></semantics></math>.
As analyzed in Section <a href="#S2.SS3" title="2.3 Optimizing the variational posterior via forward KL divergence ‣ 2 Variational reasoning ‣ Variational Reasoning for Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>, we propose to optimize <math id="A1.SS8.p1.m2" class="ltx_Math" alttext="q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})</annotation></semantics></math> using the <em id="A1.SS8.p1.1.2" class="ltx_emph ltx_font_italic">forward</em> KL divergence <math id="A1.SS8.p1.m3" class="ltx_math_unparsed" alttext="\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔻</mi><mtext>KL</mtext></msub><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi>𝒙</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>q</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{D}_{\textrm{KL}}(P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})||q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime}))</annotation></semantics></math>, which shares the same optimal solution.</p>
</div>
<div id="A1.SS8.p2" class="ltx_para ltx_noindent">
<p id="A1.SS8.p2.1" class="ltx_p">Alternatively, we can also optimize the reverse KL divergence by policy gradient method as follows:</p>
<table id="A1.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E29.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\phi}\mathcal{L}_{\textrm{ELBO}}\\
={}&amp;\nabla_{\phi}\mathbb{D}_{\textrm{KL}}\left(q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})||P_{\theta}({\bm{z}}|{\bm{x}},\mathcal{Y}_{{\bm{x}}})\right)\\
={}&amp;\nabla_{\phi}\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}[\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})-\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})]\\
={}&amp;\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\Big[\log\pi_{\theta}({\bm{z}},\mathcal{Y}_{{\bm{x}}}|{\bm{x}})\nabla_{\phi}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})-\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\nabla_{\phi}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\Big]\\
={}&amp;\mathbb{E}_{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}\Bigg[\Bigg(\underbrace{\log\pi_{\theta}(\mathcal{Y}_{{\bm{x}}}|{\bm{x}},{\bm{z}})-\log\frac{q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})}{\pi_{\theta}({\bm{z}}|{\bm{x}})}}_{\text{reward}}\Bigg)\nabla_{\phi}\log q_{\phi}({\bm{z}}|{\bm{x}},{\bm{y}}^{\prime})\Bigg].\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>𝔻</mi><msub><mrow></mrow><mtext>KL</mtext></msub><mo>(</mo><mi>q</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>P</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><msub><mrow></mrow><mi>𝒙</mi></msub><mo stretchy="false">)</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>𝔼</mi><mrow><msub><mi>q</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><m