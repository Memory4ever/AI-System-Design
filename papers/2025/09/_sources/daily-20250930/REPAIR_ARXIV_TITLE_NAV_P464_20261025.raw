      <name>Siddharth Mansingh</name>
    </author>
    <author>
      <name>Bradley C. Love</name>
    </author>
    <author>
      <name>Alexander Scheinker</name>
    </author>
    <author>
      <name>Diane Oyen</name>
    </author>
    <author>
      <name>Nathan Debardeleben</name>
    </author>
    <author>
      <name>Earl Lawrence</name>
    </author>
