<td id="A1.T12.2.8.2" class="ltx_td ltx_nopad_r ltx_align_right">46.25</td></tr>
<tr id="A1.T12.2.9" class="ltx_tr">
<td id="A1.T12.2.9.1" class="ltx_td ltx_align_left"><span id="A1.T12.2.9.1.1" class="ltx_text ltx_font_italic">BiasRAG</span></td>
<td id="A1.T12.2.9.2" class="ltx_td ltx_nopad_r ltx_align_right">60.80</td></tr>
<tr id="A1.T12.2.10" class="ltx_tr">
