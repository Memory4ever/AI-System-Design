<td id="S5.T9.2.3.3" class="ltx_td ltx_nopad_r ltx_align_right">60.80 <math id="S5.T9.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 5.10</td></tr>
<tr id="S5.T9.2.4" class="ltx_tr">
