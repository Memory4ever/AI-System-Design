<td id="S5.T8.2.4.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="S5.T8.2.4.2.1" class="ltx_text ltx_font_bold">22.02</span> <math id="S5.T8.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.33</td>
