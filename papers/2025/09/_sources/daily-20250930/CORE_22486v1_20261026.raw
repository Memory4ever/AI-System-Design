<td id="A1.T12.2.5.1" class="ltx_td ltx_align_left"><span id="A1.T12.2.5.1.1" class="ltx_text ltx_font_italic">BiasRAG</span></td>
<td id="A1.T12.2.5.2" class="ltx_td ltx_nopad_r ltx_align_right">59.20</td></tr>
<tr id="A1.T12.2.6" class="ltx_tr">
<td id="A1.T12.2.6.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="A1.T12.2.6.1.1" class="ltx_text">Query Rewriting</span></td>
