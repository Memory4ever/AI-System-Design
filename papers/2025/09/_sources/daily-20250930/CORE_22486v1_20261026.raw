<td id="S5.T9.2.2.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t">59.20 <math id="S5.T9.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.20</td></tr>
