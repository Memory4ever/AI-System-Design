s-module__3RcHtG__value text-body-3\",\"children\":[[\"$\",\"a\",\"/resources/product-announcements\",{\"href\":\"/resources/product-announcements\",\"className\":\"DetailSidebar-module-scss-module__3RcHtG__inlineLink\",\"children\":\"Announcements\"}]]}]]}]]}],[\"$\",\"li\",\"1\",{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__item\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__icon\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"_base-module-scss-module__SsgDWW__wrapper\",\"style\":{\"width\":20,\"height\":20},\"children\":[\"$\",\"svg\",null,{\"width\":20,\"height\":20,\"viewBox\":\"0 0 20 20\",\"fill\":\"currentColor\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"className\":\"_base-module-scss-module__SsgDWW__vector\",\"aria-label\":\"$undefined\",\"aria-hidden\":true,\"children\":[\"$\",\"path\",null,{\"d\":\"M12.5 3C13.3284 3 14 3.67157 14 4.5V6H14.5C16.433 6 18 7.567 18 9.5V15.5C18 16.3284 17.3284 17 16.5 17H3.5C2.72334 17 2.08461 16.4097 2.00781 15.6533L2 15.5V9.5C2 7.567 3.567 6 5.5 6H6V4.5C6 3.67157 6.67157 3 7.5 3H12.5ZM3 15.5L3.00977 15.6006C3.05629 15.8286 3.25829 16 3.5 16H16.5C16.7761 16 17 15.7761 17 15.5V12H13V12.5C13 12.7761 12.7761 13 12.5 13C12.2239 13 12 12.7761 12 12.5V12H8V12.5C8 12.7761 7.77614 13 7.5 13C7.22386 13 7 12.7761 7 12.5V12H3V15.5ZM5.5 7C4.11929 7 3 8.11929 3 9.5V11H7V10.5C7 10.2239 7.22386 10 7.5 10C7.77614 10 8 10.2239 8 10.5V11H12V10.5C12 10.2239 12.2239 10 12.5 10C12.7761 10 13 10.2239 13 10.5V11H17V9.5C17 8.11929 15.8807 7 14.5 7H5.5ZM7.5 4C7.22386 4 7 4.22386 7 4.5V6H13V4.5C13 4.22386 12.7761 4 12.5 4H7.5Z\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__content\",\"children\":[[\"$\",\"span\",null,{\"className\":\"DetailSidebar-module-scss-module__3RcHtG__label text-caption\",\"children\":\"Product\"}],\"$L45\"]}]]}],\"$L46\",\"$L47\"],\"$L48\"]}]\n41:[\"$\",\"div\",null,{\"className\":\"grid-12 ArticleLayout-module-scss-module__W3addq__wrap\",\"children\":[[\"$\",\"div\",null,{\"className\":\"ArticleLayout-module-scss-module__W3addq__content\",\"children\":[\"\",[\"$\",\"div\",null,{\"className\":\"text-rich-text text-rich-text--article w-richtext\",\"style\":\"$undefined\",\"children\":[[\"$\",\"p\",\"319f4cf57b9f\",{\"className\":\"$undefined\",\"children\":[\"Today, we’re introducing new capabilities for managing your agents’ context on the Claude Developer Platform: context editing and the memory tool.\"]}],[\"$\",\"p\",\"86347090905b\",{\"className\":\"$undefined\",\"children\":[\"With our latest model, \",[\"$\",\"a\",\"56ac761dc370\",{\"href\":\"https://www.anthropic.com/news/claude-sonnet-4-5\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":[[\"Claude Sonnet 4.5\"],\"$undefined\"]}],\", these capabilities enable developers to build AI agents capable of handling long-running tasks at higher performance and without hitting context limits or losing critical information.\"]}],[\"$\",\"h2\",\"59f24e532c2c\",{\"className\":\"$undefined\",\"id\":\"context-windows-have-limits-but-real-work-doesn-t\",\"children\":[\"Context windows have limits, but real work doesn’t\"]}],[\"$\",\"p\",\"fc3bf852dc26\",{\"className\":\"$undefined\",\"children\":[\"As production agents handle more complex tasks and generate more tool results, they often exhaust their effective context windows—leaving developers stuck choosing between cutting agent transcripts or degrading performance. Context management solves this in two ways, helping developers ensure only relevant data stays in context and valuable insights get preserved across sessions.\"]}],[\"$\",\"p\",\"b7dbd3a6a5e0\",{\"className\":\"$undefined\",\"children\":[[\"$\",\"strong\",\"153b43a636b5\",{\"children\":[\"Context editing\"]}],\" automatically clears stale tool calls and results from within the context window when approaching token limits. As your agent executes tasks and accumulates tool results, context editing removes stale content while preserving the conversation flow, effectively extending how long agents can run without manual intervention. This also increases the effective model performance as Claude focuses only on relevant context.\"]}"])</script><script nonce="usfoTvutOV5VRcTEPvHMSQ==">self.__next_f.push([1,"],[\"$\",\"figure\",\"35d53bdc8463\",{\"style\":{\"--media-natural-width\":\"1920px\"},\"data-flush\":\"$undefined\",\"children\":[[\"$\",\"img\",null,{\"referrerPolicy\":\"strict-origin-when-cross-origin\",\"src\":\"https://assets.claude.com/614d9e48dd7fdba4d52f7ab3f12129793f337d01.png\",\"srcSet\":\"$undefined\",\"sizes\":\"$undefined\",\"width\":1920,\"height\":800,\"alt\":\"\",\"loading\":\"lazy\",\"fetchPriority\":\"$undefined\",\"decoding\":\"async\",\"className\":\"Media-module-scss-module__7ZZCyW__image\",\"style\":\"$undefined\"}],null]}],[\"$\",\"p\",\"f7d0cf718130\",{\"className\":\"$undefined\",\"children\":[[\"$\",\"strong\",\"532544f195c5\",{\"children\":[\"The memory tool\"]}],\" enables Claude to store and consult information outside the context window through a file-based system. Claude can create, read, update, and delete files in a dedicated memory directory stored in your infrastructure that persists across conversations. This allows agents to build up knowledge bases over time, maintain project state across sessions, and reference previous learnings without having to keep everything in context.\"]}],[\"$\",\"figure\",\"bd3c845f9901\",{\"style\":\"$undefined\",\"data-flush\":\"$undefined\",\"children\":[[\"$\",\"$L49\",null,{\"type\":\"youtubeEmbed\",\"videoUrl\":\"$undefined\",\"youtubeId\":\"BER3EhUIyz0\",\"thumbnail\":\"$undefined\",\"alt\":\"$undefined\",\"autoplay\":\"$undefined\",\"loop\":\"$undefined\",\"showControls\":\"$undefined\",\"previewVideoUrl\":\"$undefined\",\"pauseToggle\":\"$undefined\",\"className\":\"Media-module-scss-module__7ZZCyW__video\",\"thumbnailSizes\":\"$undefined\",\"thumbnailLoading\":\"$undefined\",\"thumbnailFetchPriority\":\"$undefined\"}],null]}],[\"$\",\"p\",\"65d026b04b34\",{\"className\":\"$undefined\",\"children\":[\"The memory tool operates entirely client-side through tool calls. Developers manage the storage backend, giving them complete control over where the data is stored and how it’s persisted.\"]}],[\"$\",\"p\",\"ebae21034c34\",{\"className\":\"$undefined\",\"children\":[\"Claude Sonnet 4.5 enhances both capabilities with built-in context awareness—tracking available tokens throughout conversations to manage context more effectively.\"]}],\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\"]}],\"$L55\"]}],false,false,false]}]\n57:T4ec,M15.0376 7.37598C15.2486 7.1205 15.6268 7.08398 15.8823 7.29492C17.2357 8.41281 18.1001 10.1067 18.1001 12.001C18.0999 13.4689 17.58 14.8161 16.7163 15.8682L17.9243 17.0762C18.0956 17.2478 18.147 17.5064 18.0542 17.7305C17.9612 17.9542 17.7427 18.1004 17.5005 18.1006H12.0005C10.1062 18.1006 8.4123 17.2362 7.29441 15.8828C7.0835 15.6273 7.12008 15.2491 7.37546 15.0381C7.63093 14.8272 8.00919 14.8628 8.22019 15.1182C9.11989 16.2073 10.4792 16.9004 12.0005 16.9004H16.0512L15.4643 16.3135C15.2302 16.0792 15.2302 15.6991 15.4643 15.4648C16.3517 14.5775 16.8997 13.3538 16.8999 12.001C16.8999 10.4797 16.2068 9.1204 15.1177 8.2207C14.8624 8.00975 14.8269 7.63144 15.0376 7.37598ZM8.00046 1.90039C11.3692 1.90064 14.1001 4.63122 14.1001 8C14.1001 11.3688 11.3692 14.0994 8.00046 14.0996H2.50046C2.25785 14.0996 2.03869 13.9536 1.94578 13.7295C1.85304 13.5053 1.9051 13.2477 2.07664 13.0762L3.28464 11.8672C2.42077 10.815 1.90086 9.46821 1.90086 8C1.90086 4.63106 4.63153 1.90039 8.00046 1.90039ZM8.00046 3.09961C5.29427 3.09961 3.10007 5.2938 3.10007 8C3.10007 9.3531 3.64812 10.5773 4.53562 11.4648C4.76963 11.6991 4.76963 12.0782 4.53562 12.3125L3.94773 12.9004H8.00046C10.7064 12.9001 12.9009 10.706 12.9009 8C12.9009 5.29396 10.7064 3.09986 8.00046 3.09961Z58:T9c0,M10 2.40039C14.1974