              <span id="alg2.l7.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l7.m1" class="ltx_Math" alttext="i=1,\dots,N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,N</annotation></semantics></math> <span id="alg2.l7.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8:</span>
                
                
                <span id="alg2.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l8.m1" class="ltx_Math" alttext="i\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">i\in\mathcal{S}</annotation></semantics></math> <span id="alg2.l8.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">9:</span>
                
                
                 <math id="alg2.l9.m1" class="ltx_Math" alttext="p_{\text{active}}\leftarrow\mathcal{P}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mtext>active</mtext></msub><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p_{\text{active}}\leftarrow\mathcal{P}</annotation></semantics></math><span id="alg2.l9.2" class="ltx_text ltx_font_typewriter">.pop(0)</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
