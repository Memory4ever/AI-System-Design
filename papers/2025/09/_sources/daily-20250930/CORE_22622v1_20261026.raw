<td id="A6.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_bb">82.68</td>
<td id="A6.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_bb">82.98</td>
<td id="A6.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A6.T1.2.3.5.1" class="ltx_text ltx_font_bold">83.12</span></td>
<td id="A6.T1.2.3.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">83.04</td>
