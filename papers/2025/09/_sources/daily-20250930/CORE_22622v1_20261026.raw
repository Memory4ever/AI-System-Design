              <math id="alg2.l6.m1" class="ltx_Math" alttext="p_{\text{active}}\leftarrow\mathcal{P}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mtext>active</mtext></msub><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p_{\text{active}}\leftarrow\mathcal{P}</annotation></semantics></math><span id="alg2.l6.2" class="ltx_text ltx_font_typewriter">.pop(0)</span>

</div>
<div id="alg2.l7" class="ltx_listingline">
