                <math id="alg1.l18.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\texttt{generate\_next\_clip}(G_{\theta},\ C,\ p_{\text{active}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">generate_next_clip</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>θ</mi></msub><mo>,</mo><mi>C</mi><mo>,</mo><msub><mi>p</mi><mtext>active</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\texttt{generate\_next\_clip}(G_{\theta},\ C,\ p_{\text{active}})</annotation></semantics></math> 
</div>
<div id="alg1.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">19:</span>
                
                
                <math id="alg1.l19.m1" class="ltx_Math" alttext="\mathcal{L}\leftarrow\texttt{DMD\_Loss}(G_{\theta},\ \mathbf{x},\ p_{\text{active}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">DMD_Loss</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>θ</mi></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><msub><mi>p</mi><mtext>active</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\texttt{DMD\_Loss}(G_{\theta},\ \mathbf{x},\ p_{\text{active}})</annotation></semantics></math>

</div>
<div id="alg1.l20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">20:</span>
                
                
                <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathcal{L}\texttt{.backward}()" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">.backward</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\texttt{.backward}()</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
