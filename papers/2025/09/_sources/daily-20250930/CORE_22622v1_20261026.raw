<figure id="alg2" class="ltx_float ltx_figure_panel ltx_float_algorithm ltx_minipage ltx_align_top ltx_framed ltx_framed_top" style="width:178.9pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Interactive Inference</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">1:</span>
                
                
              Causal video generator <math id="alg2.l1.m1" class="ltx_Math" alttext="G_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">G_{\theta}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">2:</span>
                
                
              Prompt sequence <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathcal{P}=[p_{0},\dots,p_{n}]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}=[p_{0},\dots,p_{n}]</annotation></semantics></math>, switch-index sequence <math id="alg2.l2.m2" class="ltx_Math" alttext="\mathcal{S}=[s_{1},\dots,s_{n}]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}=[s_{1},\dots,s_{n}]</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">3:</span>
                
                
              Number of video frames <math id="alg2.l3.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, diffusion steps per frame <math id="alg2.l3.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">4:</span>
                
                
              Initialize model output <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathbf{x}\ \leftarrow[]" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo lspace="0.778em" stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\ \leftarrow[]</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">5:</span>
                
                
              Initialize KV cache <math id="alg2.l5.m1" class="ltx_Math" alttext="C\leftarrow[]" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">C\leftarrow[]</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
