<span id="S4.SS3.p3" class="ltx_para">
<span id="S4.SS3.p3.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:178.9pt;height:41.6pt;vertical-align:-19.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-42.3pt,9.8pt) scale(0.678739898426086,0.678739898426086) ;">
<span id="S4.SS3.p3.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.SS3.p3.1.1.1" class="ltx_tr">
<span id="S4.SS3.p3.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding:0.5pt 3.0pt;"><span id="S4.SS3.p3.1.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></span>
<span id="S4.SS3.p3.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.5pt 3.0pt;"><span id="S4.SS3.p3.1.1.1.2.1" class="ltx_text"></span> <span id="S4.SS3.p3.1.1.1.2.2" class="ltx_text">
<span id="S4.SS3.p3.1.1.1.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.SS3.p3.1.1.1.2.2.1.1" class="ltx_tr">
<span id="S4.SS3.p3.1.1.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.5pt 3.0pt;">Background</span></span>
