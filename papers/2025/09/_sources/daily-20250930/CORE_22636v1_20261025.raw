<td id="S4.T2.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.26</td>
<td id="S4.T2.4.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">29.92</td>
<td id="S4.T2.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.48</td>
<td id="S4.T2.4.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">54.01</td>
<td id="S4.T2.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t">18.01</td>
