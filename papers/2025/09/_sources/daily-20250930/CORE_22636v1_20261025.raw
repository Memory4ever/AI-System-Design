<th id="S4.T2.4.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S4.T2.4.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">LPIPS <math id="S4.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
