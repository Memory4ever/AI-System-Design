<td id="S3.T1.4.1.4.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m9" class="ltx_Math" alttext="84.13" display="inline" intent=":literal"><semantics><mn>84.13</mn><annotation encoding="application/x-tex">84.13</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m10" class="ltx_Math" alttext="15.79" display="inline" intent=":literal"><semantics><mn>15.79</mn><annotation encoding="application/x-tex">15.79</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.4" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m11" class="ltx_Math" alttext="34.62" display="inline" intent=":literal"><semantics><mn>34.62</mn><annotation encoding="application/x-tex">34.62</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.5" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m12" class="ltx_Math" alttext="17.69" display="inline" intent=":literal"><semantics><mn>17.69</mn><annotation encoding="application/x-tex">17.69</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.6" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m13" class="ltx_Math" alttext="18.91" display="inline" intent=":literal"><semantics><mn>18.91</mn><annotation encoding="application/x-tex">18.91</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.7" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 8.0pt;"><math id="S3.T1.m14" class="ltx_Math" alttext="3.95" display="inline" intent=":literal"><semantics><mn>3.95</mn><annotation encoding="application/x-tex">3.95</annotation></semantics></math></td>
