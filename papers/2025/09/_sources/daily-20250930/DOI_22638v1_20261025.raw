{"data":{"id":"10.48550/arxiv.2509.22638","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.22638","prefix":"10.48550","suffix":"arxiv.2509.22638","identifiers":[{"identifier":"2509.22638","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.22638"}],"creators":[{"name":"Luo, Renjie","nameType":"Personal","givenName":"Renjie","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Zichen","nameType":"Personal","givenName":"Zichen","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xiangyan","nameType":"Personal","givenName":"Xiangyan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Du, Chao","nameType":"Personal","givenName":"Chao","familyName":"Du","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Min","nameType":"Personal","givenName":"Min","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Wenhu","nameType":"Personal","givenName":"Wenhu","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Wei","nameType":"Personal","givenName":"Wei","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Pang, Tianyu","nameType":"Personal","givenName":"Tianyu","familyName":"Pang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Language Models Can Learn from Verbal Feedback Without Scalar Rewards"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T17:58:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T01:21:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"LLMs are often trained with RL from human or AI feedback, yet such methods typically compress nuanced feedback into scalar rewards, discarding much of their richness and inducing scale imbalance. We propose treating verbal feedback as a conditioning signal. Inspired by language priors in text-to-image generation, which enable novel outputs from unseen prompts, we introduce the feedback-conditional policy (FCP). FCP learns directly from response-feedback pairs, approximating the feedback-conditional posterior through maximum likelihood training on offline data. We further develop an online bootstrapping stage where the policy generates under positive conditions and receives fresh feedback to refine itself. This reframes feedback-driven learning as conditional generation rather than reward optimization, offering a more expressive way for LLMs to directly learn from verbal feedback. Our code is available at https://github.com/sail-sg/feedback-conditional-policy.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.22638","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-29T02:35:19.000Z","registered":"2025-09-29T02:35:19.000Z","published":"2025","updated":"2025-09-29T02:35:19.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.22638","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}