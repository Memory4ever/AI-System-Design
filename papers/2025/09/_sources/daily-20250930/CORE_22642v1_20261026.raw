<td id="S6.T3.1.1.5.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T3.1.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#D7FFD7;">0.5077</span></td></tr>
