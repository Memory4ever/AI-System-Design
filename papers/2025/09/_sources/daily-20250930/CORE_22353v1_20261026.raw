<td id="S4.T1.5.1.4.6" class="ltx_td ltx_align_center"><math id="S4.T1.m4" class="ltx_Math" alttext="380\sim 3422m^{2}" display="inline" intent=":literal"><semantics><mrow><mn>380</mn><mo>∼</mo><mrow><mn>3422</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">380\sim 3422m^{2}</annotation></semantics></math></td></tr>
