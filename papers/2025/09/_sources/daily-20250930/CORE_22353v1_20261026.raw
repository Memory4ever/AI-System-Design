<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Assumptions and Proofs for <a href="#Thmtheorem1" title="Theorem 1. ‣ 3.3 Theoretical Analyses of ER and EL ‣ 3 Methodologies ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p"><span id="A1.p1.1.1" class="ltx_text ltx_font_bold">Proof for the first part of <a href="#Thmtheorem1" title="Theorem 1. ‣ 3.3 Theoretical Analyses of ER and EL ‣ 3 Methodologies ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></span>: We first define</p>
<table id="A1.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\displaystyle\Delta(e_{1},e_{2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta(e_{1},e_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{q}D_{KL}(\hat{p}_{\theta,e_{1}}(\cdot|q),\hat{p}_{\theta,e_{2}}(\cdot|q))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi>q</mi></msub><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{q}D_{KL}(\hat{p}_{\theta,e_{1}}(\cdot|q),\hat{p}_{\theta,e_{2}}(\cdot|q))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle\kappa(e_{1},e_{2})" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\kappa(e_{1},e_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m2" class="ltx_math_unparsed" alttext="\displaystyle=\max_{q}D_{KL}(\hat{p}_{\theta,e_{1}}(\cdot|q),\hat{p}_{\theta,e_{2}}(\cdot|q))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder><mi>max</mi><mi>q</mi></munder><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mi>e</mi><mn>1</mn></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{q}D_{KL}(\hat{p}_{\theta,e_{1}}(\cdot|q),\hat{p}_{\theta,e_{2}}(\cdot|q))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\displaystyle\hat{e}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\displaystyle\hat{e}_{0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13.m2" class="ltx_Math" alttext="\displaystyle=argmin_{e\in\mathcal{E}}\Delta(e,e_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><msub><mi>e</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=argmin_{e\in\mathcal{E}}\Delta(e,e_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\displaystyle\kappa_{i}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle\kappa_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m2" class="ltx_Math" alttext="\displaystyle=\inf_{e\in\mathcal{E},e\neq\hat{e}_{0}}\kappa(e,\hat{e}_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>≠</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></mrow></munder><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{e\in\mathcal{E},e\neq\hat{e}_{0}}\kappa(e,\hat{e}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\displaystyle\kappa_{s}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\displaystyle\kappa_{s}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex15.m2" class="ltx_Math" alttext="\displaystyle=\sup_{e\in\mathcal{E},e\neq\hat{e}_{0}}\kappa(e,\hat{e}_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>≠</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></mrow></munder><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{e\in\mathcal{E},e\neq\hat{e}_{0}}\kappa(e,\hat{e}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\displaystyle p_{e}(C_{T})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{e}(C_{T})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m2" class="ltx_Math" alttext="\displaystyle=\prod_{(q_{t},o_{t+1})\in C_{T}}p_{e}(o_{t+1}|q_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>C</mi><mi>T</mi></msub></mrow></munder></mstyle><mrow><msub><mi>p</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{(q_{t},o_{t+1})\in C_{T}}p_{e}(o_{t+1}|q_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p">We then make the following <span id="A1.p2.1.1" class="ltx_text ltx_font_bold">Assumptions</span>:</p>
<ul id="A1.I1" class="ltx_itemize">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p">Queries <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="q_{t}=(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{t}=(s_{t},a_{t})</annotation></semantics></math> are sampled i.i.d. from a distribution <math id="A1.I1.i1.p1.m2" class="ltx_Math" alttext="\mu(s,a)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(s,a)</annotation></semantics></math> with <math id="A1.I1.i1.p1.m3" class="ltx_Math" alttext="\mu(s,a)\equiv\frac{1}{|S||A|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mu(s,a)\equiv\frac{1}{|S||A|}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p"><math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\kappa(e_{1},e_{2})=\alpha(e_{1},e_{2})^{2}\Delta(e_{1},e_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa(e_{1},e_{2})=\alpha(e_{1},e_{2})^{2}\Delta(e_{1},e_{2})</annotation></semantics></math> with <math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="\alpha(e_{1},e_{2})=\sqrt{\frac{\kappa(e_{1},e_{2})}{\Delta(e_{1},e_{2})}},\alpha&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mfrac><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></msqrt></mrow><mo>,</mo><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha(e_{1},e_{2})=\sqrt{\frac{\kappa(e_{1},e_{2})}{\Delta(e_{1},e_{2})}},\alpha&gt;1</annotation></semantics></math>. We further define <math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="\alpha=\max_{e_{1},e_{2}}\alpha(e_{1},e_{2})" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><msub><mi>max</mi><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=\max_{e_{1},e_{2}}\alpha(e_{1},e_{2})</annotation></semantics></math>, so that <math id="A1.I1.i2.p1.m4" class="ltx_Math" alttext="\Delta(e_{1},e_{2})\geq\frac{\kappa(e_{1},e_{2})}{\alpha^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msup><mi>α</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\Delta(e_{1},e_{2})\geq\frac{\kappa(e_{1},e_{2})}{\alpha^{2}}</annotation></semantics></math>. Note that <math id="A1.I1.i2.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> can be interpreted as the measure of ”non-uniformity” between any two environments in the set: it attains maximum when the two environments are almost identical yet differ significantly at only a few positions, and approaches <math id="A1.I1.i2.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> when the environments are either completely different or exactly the same.</p>
</div></li>
<li id="A1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i3.p1" class="ltx_para">
<p id="A1.I1.i3.p1.1" class="ltx_p">The environment recognizer selects closest task <math id="A1.I1.i3.p1.m1" class="ltx_Math" alttext="\hat{e}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>e</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{e}</annotation></semantics></math> by <math id="A1.I1.i3.p1.m2" class="ltx_Math" alttext="\hat{e}=argmax_{e\in\mathcal{E}}p_{e}(C_{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>e</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{e}=argmax_{e\in\mathcal{E}}p_{e}(C_{T})</annotation></semantics></math></p>
</div></li>
</ul>
</div>
<div id="A1.p3" class="ltx_para">
<p id="A1.p3.1" class="ltx_p">First, we gave that</p>
<table id="A1.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle TV(\hat{p}_{ER},p_{e_{0}})=TV(\hat{p}_{\theta,\hat{e}},p_{e_{0}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><msub><mi>e</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msub><mo>,</mo><msub><mi>p</mi><msub><mi>e</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle TV(\hat{p}_{ER},p_{e_{0}})=TV(\hat{p}_{\theta,\hat{e}},p_{e_{0}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m2" class="ltx_Math" alttext="\displaystyle\leq TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})+TV(\hat{p}_{\theta,\hat{e}_{0}},p_{e_{0}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></msub><mo>,</mo><msub><mi>p</mi><msub><mi>e</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})+TV(\hat{p}_{\theta,\hat{e}_{0}},p_{e_{0}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\displaystyle=TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})+\min_{e\in\mathcal{E}}TV(\hat{p}_{\theta,e},p_{e_{0}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><munder><mi>min</mi><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>e</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><msub><mi>e</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})+\min_{e\in\mathcal{E}}TV(\hat{p}_{\theta,e},p_{e_{0}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p4" class="ltx_para">
<p id="A1.p4.1" class="ltx_p">We then estimate the first term and use the Chernoff bound for derivation:</p>
<table id="A1.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle TV(\hat{p}_{\theta,\hat{e}},\hat{p}_{\theta,\hat{e}_{0}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19.m2" class="ltx_Math" alttext="\displaystyle=\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}p(p_{e}(C_{T})&gt;p_{\hat{e}_{0}}(C_{T}))TV(\hat{p}_{\theta,e},\hat{p}_{\theta,\hat{e}_{0}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>≠</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></mrow></munder></mstyle><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>p</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>p</mi><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>e</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}p(p_{e}(C_{T})&gt;p_{\hat{e}_{0}}(C_{T}))TV(\hat{p}_{\theta,e},\hat{p}_{\theta,\hat{e}_{0}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}\alpha\cdot\underbrace{\exp(-T\cdot\Delta(e,\hat{e}_{0}))}_{\text{Chernoff bound}}\underbrace{\sqrt{1/2\Delta(e,\hat{e}_{0})}}_{\text{Pinsker's Inequality}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>≠</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></mrow></munder></mstyle><mi>α</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><munder><munder accentunder="true"><mrow><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mover accent="true"><mi>e</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>Chernoff bound</mtext></munder></mrow><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><msqrt><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo stretchy="true">⏟</mo></munder><mtext>Pinsker’s Inequality</mtext></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}\alpha\cdot\underbrace{\exp(-T\cdot\Delta(e,\hat{e}_{0}))}_{\text{Chernoff bound}}\underbrace{\sqrt{1/2\Delta(e,\hat{e}_{0})}}_{\text{Pinsker's Inequality}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle&lt;\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}\underbrace{\frac{\alpha}{2\sqrt{e\cdot T}}}_{\text{achieved maximum when }T\cdot\Delta(e,\hat{e}_{0})=1/2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>≠</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub></mrow></mrow></munder></mstyle><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow></msqrt></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><mrow><mrow><mrow><mtext>achieved maximum when </mtext><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\sum_{e\in\mathcal{E},e\neq\hat{e}_{0}}\underbrace{\frac{\alpha}{2\sqrt{e\cdot T}}}_{\text{achieved maximum when }T\cdot\Delta(e,\hat{e}_{0})=1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle&lt;\frac{\alpha(|\mathcal{E}|-1)}{3\sqrt{T}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\frac{\alpha(|\mathcal{E}|-1)}{3\sqrt{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p5" class="ltx_para">
<p id="A1.p5.1" class="ltx_p"><span id="A1.p5.1.1" class="ltx_text ltx_font_bold">Proof for the second part of <a href="#Thmtheorem1" title="Theorem 1. ‣ 3.3 Theoretical Analyses of ER and EL ‣ 3 Methodologies ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></span>. We keep the aforementioned assumptions that the distribution of the context <math id="A1.p5.m1" class="ltx_Math" alttext="C_{T}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>T</mi></msub><annotation encoding="application/x-tex">C_{T}</annotation></semantics></math> is uniform on the state and action space. We denote <math id="A1.p5.m2" class="ltx_Math" alttext="n(s,a)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">n(s,a)</annotation></semantics></math> as times of appearance of <math id="A1.p5.m3" class="ltx_Math" alttext="(s,a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,a)</annotation></semantics></math> in <math id="A1.p5.m4" class="ltx_Math" alttext="C_{T}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>T</mi></msub><annotation encoding="application/x-tex">C_{T}</annotation></semantics></math>. It is first straightforward to prove with Hoeffding’s inequality that with probability of <math id="A1.p5.m5" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</p>
<table id="A1.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle\frac{T}{|S||A|}-\sqrt{\frac{T\log{(4|S||A|/\delta)}}{2}}\leq n(s,a\in C_{T})\leq\frac{T}{|S||A|}+\sqrt{\frac{T\log{(4|S||A|/\delta)}}{2}}\quad\forall s,a" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>T</mi><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></mstyle></msqrt></mrow><mo>≤</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mi>a</mi><mo>∈</mo><msub><mi>C</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>T</mi><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></mstyle></msqrt></mrow></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>s</mi></mrow><mo>,</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">\displaystyle\frac{T}{|S||A|}-\sqrt{\frac{T\log{(4|S||A|/\delta)}}{2}}\leq n(s,a\in C_{T})\leq\frac{T}{|S||A|}+\sqrt{\frac{T\log{(4|S||A|/\delta)}}{2}}\quad\forall s,a</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p5.2" class="ltx_p">Then, by add the constraint <math id="A1.p5.m6" class="ltx_Math" alttext="T&gt;4|S|^{2}|A|^{2}\log(4|S||A|/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T&gt;4|S|^{2}|A|^{2}\log(4|S||A|/\delta)</annotation></semantics></math>, with at least probability of <math id="A1.p5.m7" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</p>
<table id="A1.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E6.m1" class="ltx_Math" alttext="\displaystyle n(s,a)&gt;\frac{T}{2|S||A|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mi>T</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle n(s,a)&gt;\frac{T}{2|S||A|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p6" class="ltx_para">
<p id="A1.p6.1" class="ltx_p">To estimate <math id="A1.p6.m1" class="ltx_Math" alttext="\hat{p}_{EL}(s^{\prime}|s,a)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>s</mi><mo>,</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{p}_{EL}(s^{\prime}|s,a)</annotation></semantics></math>, we use <a href="#S3.E4" title="In 3.2 Environment Learning (EL) ‣ 3 Methodologies ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">4</span></a> to acquire:</p>
<table id="A1.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle\hat{p}_{\theta,EL}(o_{t+1}|q_{t},C_{T})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>θ</mi><mo>,</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>q</mi><mi>t</mi></msub><mo>,</mo><msub><mi>C</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{p}_{\theta,EL}(o_{t+1}|q_{t},C_{T})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m2" class="ltx_Math" alttext="\displaystyle=\frac{p(q_{t},o_{t+1}|C_{T})}{p(q_{t}|C_{T})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{p(q_{t},o_{t+1}|C_{T})}{p(q_{t}|C_{T})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E7.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{s}p(s,a_{t},o_{t+1}|C_{T})p(s|q_{t})}{\sum_{s}p(s,a_{t}|C_{T})p(s|q_{t})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{s}p(s,a_{t},o_{t+1}|C_{T})p(s|q_{t})}{\sum_{s}p(s,a_{t}|C_{T})p(s|q_{t})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="A1.p6.2" class="ltx_p">Now employ <a href="#A1.E6" title="In Appendix A Assumptions and Proofs for ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#A1.E7" title="In Appendix A Assumptions and Proofs for ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a> in the calculation of TV:</p>
<table id="A1.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\displaystyle TV(\hat{p}_{EL},p_{e_{0}})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo>,</mo><msub><mi>p</mi><msub><mi>e</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle TV(\hat{p}_{EL},p_{e_{0}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m2" class="ltx_Math" alttext="\displaystyle=TV(\frac{\sum_{s}p(s,a_{t},o_{t+1}|C_{T})p(s|q_{t})}{\sum_{s}p(s,a_{t}|C_{T})p(s|q_{t})},\frac{\sum_{s}p(s,a_{t},o_{t+1})p(s|q_{t})}{\sum_{s}p(s,a_{t})p(s|q_{t})})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>C</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mi>s</mi></msub><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=TV(\frac{\sum_{s}p(s,a_{t},o_{t+1}|C_{T})p(s|q_{t})}{\sum_{s}p(s,a_{t}|C_{T})p(s|q_{t})},\frac{\sum_{s}p(s,a_{t},o_{t+1})p(s|q_{t})}{\sum_{s}p(s,a_{t})p(s|q_{t})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\displaystyle\leq\max_{s}TV(\frac{n(s,a_{t},o_{t+1}\in C_{T})}{n(s,a_{t}\in C_{T})},\frac{p(s,a_{t},o_{t+1})}{p(s,a_{t})})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><munder><mi>max</mi><mi>s</mi></munder><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><msub><mi>C</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∈</mo><msub><mi>C</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{s}TV(\frac{n(s,a_{t},o_{t+1}\in C_{T})}{n(s,a_{t}\in C_{T})},\frac{p(s,a_{t},o_{t+1})}{p(s,a_{t})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle\leq\underbrace{\sqrt{\frac{|O|log(4|O|/\delta)}{n(s,a_{t}\in C_{T})}}}_{\text{Hoeffding's inequality}}\text{ with probability at least }1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><munder><munder accentunder="true"><msqrt><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi>O</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>O</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∈</mo><msub><mi>C</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt><mo stretchy="true">⏟</mo></munder><mtext>Hoeffding’s inequality</mtext></munder><mo lspace="0em" rspace="0em">​</mo><mtext> with probability at least </mtext><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\underbrace{\sqrt{\frac{|O|log(4|O|/\delta)}{n(s,a_{t}\in C_{T})}}}_{\text{Hoeffding's inequality}}\text{ with probability at least }1-\delta/2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\displaystyle&lt;\sqrt{\frac{2|O||S||A|log(4|S|/\delta)}{T}}\text{ with probability at least }1-\delta" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>S</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mtext> with probability at least </mtext><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\sqrt{\frac{2|O||S||A|log(4|S|/\delta)}{T}}\text{ with probability at least }1-\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p6.3" class="ltx_p">This finishes the proof of <a href="#Thmtheorem1" title="Theorem 1. ‣ 3.3 Theoretical Analyses of ER and EL ‣ 3 Methodologies ‣ Context and Diversity Matter: The Emergence of In-Context Learning in World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></p>
</div>
</section>
