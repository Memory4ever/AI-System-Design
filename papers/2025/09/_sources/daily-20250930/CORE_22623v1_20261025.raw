<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex29.m2" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}\sum_{m\leq k_{1}}\sum_{s\in\mathcal{S}}\|\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mo lspace="0em" rspace="0em">∥</mo><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><msub><mi>u</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∥</mo><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}\sum_{m\leq k_{1}}\sum_{s\in\mathcal{S}}\|\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex29.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex29.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A4.E7" title="Equation D.7 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.7</span></a>)</span>)</span></span></td></tr></tbody>
