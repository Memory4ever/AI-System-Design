<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex30.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex30.m2" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}\sum_{s\in\mathcal{S}}\sum_{m\leq k_{1}}\|\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mo lspace="0em" rspace="0em">∥</mo><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><msub><mi>u</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∥</mo><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}\sum_{s\in\mathcal{S}}\sum_{m\leq k_{1}}\|\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex30.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex30.1.1" class="ltx_text" style="font-size:67%;">Interchange the order of summations</span>)</span></span></td></tr></tbody>
<tbody id="A4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E8.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E8.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}KM^{d}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}KM^{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.8)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p14.2" class="ltx_p"><span id="A4.SS2.p14.2.1" class="ltx_text">where the last line follows that <math id="A4.SS2.p14.m4" class="ltx_Math" alttext="u(s,t)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(s,t)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)</annotation></semantics></math> with respect to <math id="A4.SS2.p14.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
Also, we have</span></p>
<table id="A4.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex31.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m=k_{1}}\sup_{\begin{subarray}{c}{(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]}\\
(x,t_{1})\neq(y,t_{2})\end{subarray}}\frac{|\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(x,t_{1})-\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(y,t_{2})|}{\|(x,t_{1})-(y,t_{2})\|^{\gamma}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>λ</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable></munder><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>γ</mi></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m=k_{1}}\sup_{\begin{subarray}{c}{(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]}\\
(x,t_{1})\neq(y,t_{2})\end{subarray}}\frac{|\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(x,t_{1})-\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(y,t_{2})|}{\|(x,t_{1})-(y,t_{2})\|^{\gamma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex32.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex32.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m=k_{1}}\sup_{\begin{subarray}{c}{(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]}\\
(x,t_{1})\neq(y,t_{2})\end{subarray}}\frac{|\sum_{s\in\mathcal{S}}\partial^{\lambda}_{x}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{\lambda}_{x}\phi_{s}(y)\partial^{m}_{t}u_{k}(s,t_{2})|}{\|(x,t_{1})-(y,t_{2})\|^{\gamma}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>λ</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable></munder><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mrow><msubsup><mo>∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>γ</mi></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m=k_{1}}\sup_{\begin{subarray}{c}{(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]}\\
(x,t_{1})\neq(y,t_{2})\end{subarray}}\frac{|\sum_{s\in\mathcal{S}}\partial^{\lambda}_{x}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{\lambda}_{x}\phi_{s}(y)\partial^{m}_{t}u_{k}(s,t_{2})|}{\|(x,t_{1})-(y,t_{2})\|^{\gamma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex32.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex32.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A4.E6" title="Equation D.6 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.6</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex33.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex33.m2" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\sum_{n^{\prime}\leq k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{|\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{m}_{t}u_{k}(s,t_{2})|}{|t_{1}-t_{2}|^{\gamma}}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><msup><mi>M</mi><mi>d</mi></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>γ</mi></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\sum_{n^{\prime}\leq k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{|\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{m}_{t}u_{k}(s,t_{2})|}{|t_{1}-t_{2}|^{\gamma}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
