<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex34.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A2.Ex34.m1" class="ltx_Math" alttext="\|X_{1}\|_{2}\leq B_{X}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">1</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">2</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">≤</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">B</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi></msub></mrow><annotation encoding="application/x-tex">\|X_{1}\|_{2}\leq B_{X}</annotation></semantics></math><span id="A2.Ex34.1.1" class="ltx_text" style="font-size:67%;"> and <math id="A2.Ex34.m2" class="ltx_Math" alttext="\|AX\|_{F}\leq\|A\|_{F}\cdot\|X\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">X</mi></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">F</mi></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">≤</mo><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">A</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0.055em" stretchy="false">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">F</mi></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0.222em">⋅</mo><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">X</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|AX\|_{F}\leq\|A\|_{F}\cdot\|X\|_{F}</annotation></semantics></math></span>)</span></span></td></tr></tbody>
