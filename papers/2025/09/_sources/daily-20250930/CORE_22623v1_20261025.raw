<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex37.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ \hskip 70.0001pt+\sum_{n^{\prime}&lt;k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{\|\partial^{n^{\prime}+1}u_{k}(s,t)\|_{L^{\infty}}\cdot|t_{1}-t_{2}|}{|t_{1}-t_{2}|^{\gamma}})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>&lt;</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow></msup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>γ</mi></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \hskip 70.0001pt+\sum_{n^{\prime}&lt;k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{\|\partial^{n^{\prime}+1}u_{k}(s,t)\|_{L^{\infty}}\cdot|t_{1}-t_{2}|}{|t_{1}-t_{2}|^{\gamma}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex37.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex37.1.1" class="ltx_text" style="font-size:67%;">By Newton-Leibniz formula</span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex38.m7" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex38.m8" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\cdot(K+\sum_{n^{\prime}&lt;k_{1}}K)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>&lt;</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mi>K</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\cdot(K+\sum_{n^{\prime}&lt;k_{1}}K)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex38.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A4.Ex38.m1" class="ltx_Math" alttext="u(s,t)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">u</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">s</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">,</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">t</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">∈</mo><mrow><msubsup><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080" mathsize="0.670em">ℋ</mi><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">,</mo><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">M</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.660em">d</mi></msup></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">(</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">[</mo><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">0</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">,</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">1</mn></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">]</mo></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">,</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">K</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(s,t)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)</annotation></semantics></math><span id="A4.Ex38.1.1" class="ltx_text" style="font-size:67%;"> and <math id="A4.Ex38.m2" class="ltx_Math" alttext="|t_{1}-t_{2}|^{1-\gamma}\leq 1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">2</mn></msub></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">γ</mi></mrow></msup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">≤</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow><annotation encoding="application/x-tex">|t_{1}-t_{2}|^{1-\gamma}\leq 1</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E9.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E9.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(k_{1}+1)(2k_{1})^{2k_{1}}KM^{d}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(k_{1}+1)(2k_{1})^{2k_{1}}KM^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.9)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p15" class="ltx_para">
<p id="A4.SS2.p15.1" class="ltx_p"><span id="A4.SS2.p15.1.1" class="ltx_text ltx_font_bold">Step 5: Altogether.<span id="A4.SS2.p15.1.1.1" class="ltx_text ltx_font_medium">
Combing (<a href="#A4.E8" title="Equation D.8 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.8</span></a>) and (<a href="#A4.E9" title="Equation D.9 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.9</span></a>), we get</span></span></p>
<table id="A4.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex39.m1" class="ltx_Math" alttext="\displaystyle\widetilde{u}(x,t)\in\mathcal{H}^{\beta}_{d+1,M^{d}}(\mathbb{R}^{d}\times[0,1],e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM^{d})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{u}(x,t)\in\mathcal{H}^{\beta}_{d+1,M^{d}}(\mathbb{R}^{d}\times[0,1],e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM^{d}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p15.2" class="ltx_p"><span id="A4.SS2.p15.2.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proof of <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Approximation Theorem for Discrete Flow Matching). ‣ 4.2 Discrete Flow Matching Approximation ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></h3>

<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p">This section provides the proof of <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Approximation Theorem for Discrete Flow Matching). ‣ 4.2 Discrete Flow Matching Approximation ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.
We first develop auxiliary lemmas characterizing Lipschitz continuity properties and bound point-wise values of Lipschitz continuous functions using integral upper bounds.
Building on these technical tools, we then present the proof of approximation theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Approximation Theorem for Discrete Flow Matching). ‣ 4.2 Discrete Flow Matching Approximation ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>, which guarantees the existence of transformer networks that approximate the target function with controlled error and parameter bounds.</p>
</div>
<div id="A5.p2" class="ltx_para ltx_noindent">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text ltx_font_bold">Organization.</span>
We recall basic concepts of factorized discrete flow matching and mixture path setting in <a href="#A5.SS1" title="E.1 Preliminaries ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>.
Then we introduce and prove auxiliary lemmas in <a href="#A5.SS2" title="E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">E.2</span></a>.
Finally, we present the main proof of <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Approximation Theorem for Discrete Flow Matching). ‣ 4.2 Discrete Flow Matching Approximation ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> in <a href="#A5.SS3" title="E.3 Main Proof of ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">E.3</span></a>.</p>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Preliminaries</h4>

<div id="A5.SS1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.p1.1" class="ltx_p">To start with, recall from <a href="#S2" title="2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a> that when constructing a factorized path, the probability path has a factorized generating velocity of the form</p>
<table id="A5.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E1.m1" class="ltx_Math" alttext="\displaystyle u_{t}(y,x)=\sum_{i}\delta(y^{\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}},x^{\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}}),u_{t}^{i}(y^{i},x)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mtext class="undefined">\macc@depth</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@set@skewchar</mtext><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@nested@a</mtext><mo lspace="0em" rspace="0em">​</mo><mn>111</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mtext class="undefined">\macc@depth</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@set@skewchar</mtext><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@nested@a</mtext><mo lspace="0em" rspace="0em">​</mo><mn>111</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}(y,x)=\sum_{i}\delta(y^{\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}},x^{\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}}),u_{t}^{i}(y^{i},x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.1)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.2" class="ltx_p">where <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}=(1,\dots,i-1,i+1,\dots,d)" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="undefined">\macc@depth</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@set@skewchar</mtext><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\macc@nested@a</mtext><mo lspace="0em" rspace="0em">​</mo><mn>111</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{i}=(1,\dots,i-1,i+1,\dots,d)</annotation></semantics></math> denotes all indices except <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
Following notations in <a href="#S1" title="1 Introduction" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we write
<math id="A5.SS1.p1.m3" class="ltx_Math" alttext="u_{t}(\cdot,x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(\cdot,x)</annotation></semantics></math> and <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="u^{i}_{t}(\cdot,x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u^{i}_{t}(\cdot,x)</annotation></semantics></math> as <math id="A5.SS1.p1.m5" class="ltx_Math" alttext="u(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,t)</annotation></semantics></math> and <math id="A5.SS1.p1.m6" class="ltx_Math" alttext="u^{i}(x,t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u^{i}(x,t)</annotation></semantics></math> respectively.</p>
</div>
<div id="A5.SS1.p2" class="ltx_para ltx_noindent">
<p id="A5.SS1.p2.1" class="ltx_p">Next, recall that in <a href="#S2" title="2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a> we construct mixture path <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="p_{t|0,1}(x|x_{0},x_{1})=\prod_{i}p^{i}_{t|0,1}(x^{i}|x_{0},x_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∏</mo><mi>i</mi></msub><mrow><msubsup><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{t|0,1}(x|x_{0},x_{1})=\prod_{i}p^{i}_{t|0,1}(x^{i}|x_{0},x_{1})</annotation></semantics></math>, where each per-coordinate path interpolates between the source and target tokens:</p>
<table id="A5.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex1.m1" class="ltx_Math" alttext="\displaystyle p^{i}_{t|0,1}(x^{i}|x_{0},x_{1})=\kappa_{t}\delta(x^{i},x_{1}^{i})+(1-\kappa_{t})\delta(x^{i},x_{0}^{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>p</mi><mrow><mi>t</mi><mo fence="false">|</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>κ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>i</mi></msup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>i</mi></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle p^{i}_{t|0,1}(x^{i}|x_{0},x_{1})=\kappa_{t}\delta(x^{i},x_{1}^{i})+(1-\kappa_{t})\delta(x^{i},x_{0}^{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p2.2" class="ltx_p">Here, <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="\delta(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta(\cdot,\cdot)</annotation></semantics></math> is the Kronecker delta and <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="\kappa_{t}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\kappa_{t}</annotation></semantics></math> is a monotonically increasing smooth function that satisfies the boundary conditions:</p>
<table id="A5.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex2.m1" class="ltx_math_unparsed" alttext="\displaystyle\kappa_{0}=0,\quad\kappa_{1}=1,\quad\text{and}\quad\derivative{\kappa_t}{t}&gt;0\quad\text{for}\quad t\in(0,1)." display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn><mo rspace="1.167em">,</mo><msub><mi>κ</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn><mo rspace="1.167em">,</mo><mtext>and</mtext><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">d</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac></mstyle><mo>&gt;</mo><mn>0</mn><mtext>for</mtext><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\kappa_{0}=0,\quad\kappa_{1}=1,\quad\text{and}\quad\derivative{\kappa_t}{t}&gt;0\quad\text{for}\quad t\in(0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p2.3" class="ltx_p">Then the corresponding conditional factorized velocity field that generates this per-coordinate path takes the form:</p>
<table id="A5.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex3.m1" class="ltx_math_unparsed" alttext="\displaystyle u_{t}^{i}(y^{i},x^{i}|x_{0}^{i},x_{1}^{i})=\frac{\dot{\kappa_{t}}}{1-\kappa_{t}}[\delta(y^{i},x_{1}^{i})-\delta(y^{i},x^{i})]." display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><msup><mi>x</mi><mi>i</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mn>0</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><msub><mi>κ</mi><mi>t</mi></msub><mo>˙</mo></mover><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mrow><mo stretchy="false">[</mo><mi>δ</mi><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>δ</mi><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><msup><mi>x</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{i}(y^{i},x^{i}|x_{0}^{i},x_{1}^{i})=\frac{\dot{\kappa_{t}}}{1-\kappa_{t}}[\delta(y^{i},x_{1}^{i})-\delta(y^{i},x^{i})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p2.4" class="ltx_p">Taking expectation on <math id="A5.SS1.p2.m4" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> and we obtain:</p>
<table id="A5.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E2.m1" class="ltx_Math" alttext="\displaystyle u^{i}_{t}(y,x)=\frac{\dot{\kappa_{t}}}{1-\kappa_{t}}\underset{x_{1}\sim P_{1}}{\mathbb{E}}[\delta(y^{i},x_{1}^{i})-\delta(y^{i},x^{i})]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><msub><mi>κ</mi><mi>t</mi></msub><mo>˙</mo></mover><mrow><mn>1</mn><mo>−</mo><msub><mi>κ</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">1</mn></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mn mathsize="0.710em">1</mn></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo>,</mo><msup><mi>x</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle u^{i}_{t}(y,x)=\frac{\dot{\kappa_{t}}}{1-\kappa_{t}}\underset{x_{1}\sim P_{1}}{\mathbb{E}}[\delta(y^{i},x_{1}^{i})-\delta(y^{i},x^{i})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.2)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p2.5" class="ltx_p">Further, we clip the time interval for training stability.
Specifically, we focus on the time period <math id="A5.SS1.p2.m5" class="ltx_Math" alttext="[t_{0},T]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},T]</annotation></semantics></math>, where <math id="A5.SS1.p2.m6" class="ltx_Math" alttext="0&lt;t_{0}&lt;T&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>t</mi><mn>0</mn></msub><mo>&lt;</mo><mi>T</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;t_{0}&lt;T&lt;1</annotation></semantics></math>.
This clipping is to prevent <math id="A5.SS1.p2.m7" class="ltx_Math" alttext="\frac{\dot{\kappa}(t)}{1-\kappa(t)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mover accent="true"><mi>κ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\dot{\kappa}(t)}{1-\kappa(t)}</annotation></semantics></math> from blowing up at <math id="A5.SS1.p2.m8" class="ltx_Math" alttext="t=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=0,1</annotation></semantics></math>.
We assume <math id="A5.SS1.p2.m9" class="ltx_Math" alttext="\frac{\dot{\kappa}(t)}{1-\kappa(t)}=O(1)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mover accent="true"><mi>κ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\dot{\kappa}(t)}{1-\kappa(t)}=O(1)</annotation></semantics></math> and <math id="A5.SS1.p2.m10" class="ltx_Math" alttext="(\frac{\dot{\kappa}(t)}{1-\kappa(t)})^{\prime}=O(1)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mover accent="true"><mi>κ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow><mo>′</mo></msup><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\frac{\dot{\kappa}(t)}{1-\kappa(t)})^{\prime}=O(1)</annotation></semantics></math> in <math id="A5.SS1.p2.m11" class="ltx_Math" alttext="t\in[t_{0},T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{0},T]</annotation></semantics></math>.</p>
</div>
<div id="A5.Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmremark1.2" class="ltx_text ltx_font_bold">Remark E.1</span></span><span id="A5.Thmremark1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmremark1.p1" class="ltx_para ltx_noindent">
<p id="A5.Thmremark1.p1.1" class="ltx_p">We demonstrate that clipping the interval of <math id="A5.Thmremark1.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is necessary in discrete flow matching, for there doesn’t exist a construction of <math id="A5.Thmremark1.p1.m2" class="ltx_Math" alttext="\kappa(t)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(t)</annotation></semantics></math> that keeps stability of <math id="A5.Thmremark1.p1.m3" class="ltx_Math" alttext="\frac{\dot{\kappa}(t)}{1-\kappa(t)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mover accent="true"><mi>κ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\dot{\kappa}(t)}{1-\kappa(t)}</annotation></semantics></math> at both <math id="A5.Thmremark1.p1.m4" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> and <math id="A5.Thmremark1.p1.m5" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>.
To show this, we set <math id="A5.Thmremark1.p1.m6" class="ltx_Math" alttext="r(t)=\frac{\dot{\kappa}(t)}{1-\kappa(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mover accent="true"><mi>κ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">r(t)=\frac{\dot{\kappa}(t)}{1-\kappa(t)}</annotation></semantics></math> and <math id="A5.Thmremark1.p1.m7" class="ltx_Math" alttext="g(t)=1-\kappa(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g(t)=1-\kappa(t)</annotation></semantics></math>.
Then we have:</p>
<table id="A5.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex4.m1" class="ltx_Math" alttext="\displaystyle(-\log(g(t))^{\prime}=\frac{-g^{\prime}(t)}{g(t)}=r(t)." display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">−</mo><msup><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>′</mo></msup></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(-\log(g(t))^{\prime}=\frac{-g^{\prime}(t)}{g(t)}=r(t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.Thmremark1.p1.2" class="ltx_p">Since <math id="A5.Thmremark1.p1.m8" class="ltx_Math" alttext="\kappa(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(0)=0</annotation></semantics></math> and <math id="A5.Thmremark1.p1.m9" class="ltx_Math" alttext="\kappa(1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa(1)=1</annotation></semantics></math>, we have <math id="A5.Thmremark1.p1.m10" class="ltx_Math" alttext="-\log g(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-\log g(0)=0</annotation></semantics></math> and <math id="A5.Thmremark1.p1.m11" class="ltx_Math" alttext="-\log g(1)=\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\log g(1)=\infty</annotation></semantics></math>.
This means <math id="A5.Thmremark1.p1.m12" class="ltx_Math" alttext="r(t)=(-\log(g(t))^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><msup><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>′</mo></msup></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">r(t)=(-\log(g(t))^{\prime}</annotation></semantics></math> is not bounded on [0,1].
Then for <math id="A5.Thmremark1.p1.m13" class="ltx_Math" alttext="\kappa(t)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(t)</annotation></semantics></math> finite on (0,1), it must be instable at
<math id="A5.Thmremark1.p1.m14" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> or <math id="A5.Thmremark1.p1.m15" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>.
Therefore, clipping the interval of <math id="A5.Thmremark1.p1.m16" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is necessary.</p>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Auxiliary Lemmas</h4>

<div id="A5.SS2.p1" class="ltx_para ltx_noindent">
<p id="A5.SS2.p1.1" class="ltx_p">In this section, we introduce auxiliary lemmas for the proof of <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Approximation Theorem for Discrete Flow Matching). ‣ 4.2 Discrete Flow Matching Approximation ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.
We adapt <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> to the mixture path setting, stated as <a href="#A5.Thmlemma1" title="Lemma E.1 (Discrete-to-Continuous Functional Extension of Velocity under Mixture Path Setting, Modified from ). ‣ E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.1</span></a>.
In <a href="#A5.Thmlemma2" title="Lemma E.2 (Lipschitzness of Extension). ‣ E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.2</span></a> and <a href="#A5.Thmlemma3" title="Lemma E.3 (Lipschitzness of Extension under Mixture Path Setting, Modified from ). ‣ E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.3</span></a>, we compute the Lipschitz constants of the functions constructed in these bridging lemmas.
Finally, we establish connections between local Lipschitz behavior and integral bounds in <a href="#A5.Thmlemma4" title="Lemma E.4 (Integral Lower Bound via Point-wise Magnitude). ‣ E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.4</span></a> and <a href="#A5.Thmlemma5" title="Lemma E.5 (Point-wise Upper Bound via Integral Constraint). ‣ E.2 Auxiliary Lemmas ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">E.5</span></a>.</p>
</div>
<div id="A5.SS2.p2" class="ltx_para ltx_noindent">
<p id="A5.SS2.p2.1" class="ltx_p">To begin with, we introduce a lemma parallel to <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>, guaranteeing the existence of a smooth function taking same value as a given discrete function at certain points.</p>
</div>
<div id="A5.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma E.1</span></span><span id="A5.Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Discrete-to-Continuous Functional Extension of Velocity under Mixture Path Setting, Modified from <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>)<span id="A5.Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma1.p1" class="ltx_para">
<p id="A5.Thmlemma1.p1.1" class="ltx_p">Consider velocity function <math id="A5.Thmlemma1.p1.m1" class="ltx_Math" alttext="u(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,t)</annotation></semantics></math> with the form (<a href="#A5.E2" title="Equation E.2 ‣ E.1 Preliminaries ‣ Appendix E Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>) generating mixture path.
For each <math id="A5.Thmlemma1.p1.m2" class="ltx_Math" alttext="x\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{S}</annotation></semantics></math> and coordinate <math id="A5.Thmlemma1.p1.m3" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>,
let <math id="A5.Thmlemma1.p1.m4" class="ltx_Math" alttext="t\mapsto u^{i}(x,t)\in\mathcal{H}^{\beta}_{1,M}([t_{0},T],K)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">↦</mo><mrow><msup><mi>u</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>1</mn><mo>,</mo><mi>M</mi></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\mapsto u^{i}(x,t)\in\mathcal{H}^{\beta}_{1,M}([t_{0},T],K)</annotation></semantics></math> with <math id="A5.Thmlemma1.p1.m5" class="ltx_Math" alttext="\beta=k_{1}+\gamma\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mi>γ</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta=k_{1}+\gamma\geq 1</annotation></semantics></math>, where <math id="A5.Thmlemma1.p1.m6" class="ltx_Math" alttext="k=\lfloor\beta\rfloor" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mi>β</mi><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">k=\lfloor\beta\rfloor</annotation></semantics></math> and <math id="A5.Thmlemma1.p1.m7" class="ltx_Math" alttext="\gamma\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in[0,1)</annotation></semantics></math>.
Then there exists an continuous extension <math id="A5.Thmlemma1.p1.m8" class="ltx_Math" alttext="\widetilde{u}^{i}\in\mathcal{H}^{\beta}_{d+1,M}(\mathbb{R}^{d}\times[0,1],C)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>i</mi></msup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>M</mi></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}^{i}\in\mathcal{H}^{\beta}_{d+1,M}(\mathbb{R}^{d}\times[0,1],C)</annotation></semantics></math> such that</p>
<table id="A5.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex5.m1" class="ltx_Math" alttext="\displaystyle\widetilde{u}(s,t)=u(s,t)\penalty\ \penalty\ \penalty\ \penalty\ \text{for all}\penalty\ s\in\mathcal{S},t\in[t_{0},T]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for all</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{u}(s,t)=u(s,t)\penalty\ \penalty\ \penalty\ \penalty\ \text{for all}\penalty\ s\in\mathcal{S},t\in[t_{0},T],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.Thmlemma1.p1.2" class="ltx_p">where the Hölder norm <math id="A5.Thmlemma1.p1.m9" class="ltx_Math" alttext="C=e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">C=e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM</annotation></semantics></math>.</p>
</div>
</div>
<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p3" class="ltx_para ltx_noindent">
<p id="A5.SS2.p3.1" class="ltx_p"><span id="A5.SS2.p3.1.1" class="ltx_text">The construction of <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> is same as the construction in the proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.
We restate it for completeness.
Let <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="\eta(t)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(t)</annotation></semantics></math> be as defined in <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>.
For <math id="A5.SS2.p3.m3" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, we define <math id="A5.SS2.p3.m4" class="ltx_Math" alttext="\phi_{s}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi_{s}(x)</annotation></semantics></math> as:</span></p>
<table id="A5.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex6.m1" class="ltx_Math" alttext="\displaystyle\phi_{s}(x)=\eta(e^{2}\|x-E(s)\|^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\phi_{s}(x)=\eta(e^{2}\|x-E(s)\|^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.2" class="ltx_p"><span id="A5.SS2.p3.2.1" class="ltx_text">Then we construct <math id="A5.SS2.p3.m5" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> as:</span></p>
<table id="A5.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E3.m1" class="ltx_Math" alttext="\displaystyle\widetilde{u}^{i}(x,t)=\sum_{s\in\mathcal{S}}\phi_{s}(x)\cdot u^{i}(s,t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>u</mi><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{u}^{i}(x,t)=\sum_{s\in\mathcal{S}}\phi_{s}(x)\cdot u^{i}(s,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(E.3)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p3.3" class="ltx_p"><span id="A5.SS2.p3.3.1" class="ltx_text">This construction takes the same form as in (<a href="#A4.E6" title="Equation D.6 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.6</span></a>), while <math id="A5.SS2.p3.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="A5.SS2.p3.m7" class="ltx_Math" alttext="\widetilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{u}</annotation></semantics></math> has output dimension of <math id="A5.SS2.p3.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> in mixture path case instead of <math id="A5.SS2.p3.m9" class="ltx_Math" alttext="M^{d}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>d</mi></msup><annotation encoding="application/x-tex">M^{d}</annotation></semantics></math>.
Then <math id="A5.SS2.p3.m10" class="ltx_Math" alttext="\widetilde{u}^{i}(s,t)=u^{i}(s,t)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}^{i}(s,t)=u^{i}(s,t)</annotation></semantics></math> for every <math id="A5.SS2.p3.m11" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> given that <math id="A5.SS2.p3.m12" class="ltx_Math" alttext="\phi_{s}(s)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\phi_{s}(s)=1</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p"><span id="A5.SS2.p4.1.1" class="ltx_text">The computation of Hölder constant of <math id="A5.SS2.p4.m1" class="ltx_Math" alttext="\widetilde{u}^{i}(x,t)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}^{i}(x,t)</annotation></semantics></math> is exactly in the same form to the computation in proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>, while the only difference is to replace <math id="A5.SS2.p4.m2" class="ltx_Math" alttext="M^{d}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>d</mi></msup><annotation encoding="application/x-tex">M^{d}</annotation></semantics></math> with <math id="A5.SS2.p4.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p5" class="ltx_para ltx_noindent">
<p id="A5.SS2.p5.1" class="ltx_p">Next, we prove that when <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="u(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,t)</annotation></semantics></math> is Lipschitz continuous with respect to <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> for fixed <math id="A5.SS2.p5.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="A5.SS2.p5.m4" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> we construct is Lipschitz continuous.
Further, we give the Lipschitz constant of <math id="A5.SS2.p5.m5" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> under <math id="A5.SS2.p5.m6" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-norm.
We first present the result under general case to increase readability.</p>
</div>
<div id="A5.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma E.2</span></span><span id="A5.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Lipschitzness of Extension)<span id="A5.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmlemma2.p1" class="ltx_para">
<p id="A5.Thmlemma2.p1.1" class="ltx_p">Suppose that for every given <math id="A5.Thmlemma2.p1.m1" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, it holds <math id="A5.Thmlemma2.p1.m2" class="ltx_Math" alttext="\|u(s,t)\|_{2}\leq M_{u}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>M</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">\|u(s,t)\|_{2}\leq M_{u}</annotation></semantics></math> and <math id="A5.Thmlemma2.p1.m3" class="ltx_Math" alttext="u(s,t)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(s,t)</annotation></semantics></math> is Lipschitz continuous under <math id="A5.Thmlemma2.p1.m4" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-norm with respect to <math id="A5.Thmlemma2.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, with Lipschitz constant <math id="A5.Thmlemma2.p1.m6" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math>.
Then <math id="A5.Thmlemma2.p1.m7" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> defined in the proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> is Lipschitz continuous under <math id="A5.Thmlemma2.p1.m8" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-norm with respect to <math id="A5.Thmlemma2.p1.m9" class="ltx_Math" alttext="(x,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,t)</annotation></semantics></math>, with Lipschitz constant <math id="A5.Thmlemma2.p1.m10" class="ltx_Math" alttext="\max\{L_{u},4e\sqrt{d}M_{u}\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>u</mi></msub><mo>,</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>u</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\max\{L_{u},4e\sqrt{d}M_{u}\}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p6" class="ltx_para ltx_noindent">
<p id="A5.SS2.p6.1" class="ltx_p"><span id="A5.SS2.p6.1.1" class="ltx_text">By letting <math id="A5.SS2.p6.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> in (<a href="#A4.E7" title="Equation D.7 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.7</span></a>), we get <math id="A5.SS2.p6.m2" class="ltx_Math" alttext="|\partial\phi_{s}|\leq 4e" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mo lspace="0em">∂</mo><msub><mi>ϕ</mi><mi>s</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">|\partial\phi_{s}|\leq 4e</annotation></semantics></math>.
This indicates <math id="A5.SS2.p6.m3" class="ltx_Math" alttext="\|\nabla\phi_{s}\|_{2}\leq 4e\sqrt{d}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mo rspace="0.167em">∇</mo><msub><mi>ϕ</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\|\nabla\phi_{s}\|_{2}\leq 4e\sqrt{d}</annotation></semantics></math>, meaning that <math id="A5.SS2.p6.m4" class="ltx_Math" alttext="\phi_{s}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\phi_{s}</annotation></semantics></math> is is Lipschitz continuous under <math id="A5.SS2.p6.m5" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-norm, with Lipschitz constant <math id="A5.SS2.p6.m6" class="ltx_Math" alttext="4e\sqrt{d}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><annotation encoding="application/x-tex">4e\sqrt{d}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p7" class="ltx_para ltx_noindent">
<p id="A5.SS2.p7.1" class="ltx_p"><span id="A5.SS2.p7.1.1" class="ltx_text">By definition, for <math id="A5.SS2.p7.m1" class="ltx_Math" alttext="s_{1}\neq s_{2}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>s</mi><mn>2</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{1}\neq s_{2}\in\mathcal{S}</annotation></semantics></math>,
it holds <math id="A5.SS2.p7.m2" class="ltx_Math" alttext="\|s_{1}-s_{2}\|\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>−</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|s_{1}-s_{2}\|\geq 1</annotation></semantics></math>.
Then <math id="A5.SS2.p7.m3" class="ltx_Math" alttext="B(s_{1},\frac{1}{e})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mfrac><mn>1</mn><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(s_{1},\frac{1}{e})</annotation></semantics></math> and <math id="A5.SS2.p7.m4" class="ltx_Math" alttext="B(s_{2},\frac{1}{e})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo>,</mo><mfrac><mn>1</mn><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(s_{2},\frac{1}{e})</annotation></semantics></math> does not intersect for distinct <math id="A5.SS2.p7.m5" class="ltx_Math" alttext="s_{1}.s_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">.</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">s_{1}.s_{2}</annotation></semantics></math>.
Therefore for <math id="A5.SS2.p7.m6" class="ltx_Math" alttext="x\in[0,M]^{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x\in[0,M]^{d}</annotation></semantics></math>, there is at most one <math id="A5.SS2.p7.m7" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> such that <math id="A5.SS2.p7.m8" class="ltx_Math" alttext="x\in B(s,\frac{1}{e})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mfrac><mn>1</mn><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in B(s,\frac{1}{e})</annotation></semantics></math>.
For <math id="A5.SS2.p7.m9" class="ltx_Math" alttext="(x_{1},t_{1}),(x_{2},t_{2})\in\mathbb{R}^{d}\times\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(x_{1},t_{1}),(x_{2},t_{2})\in\mathbb{R}^{d}\times\mathbb{R}</annotation></semantics></math>, we discuss two possible cases as below.</span></p>
</div>
<div id="A5.SS2.p8" class="ltx_para ltx_noindent">
<p id="A5.SS2.p8.1" class="ltx_p"><span id="A5.SS2.p8.1.1" class="ltx_text">(1). There exists <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="s_{0}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{0}\in\mathcal{S}</annotation></semantics></math>, such that <math id="A5.SS2.p8.m2" class="ltx_Math" alttext="x_{1},x_{2}\in B(s_{0},\frac{1}{e})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><mfrac><mn>1</mn><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{1},x_{2}\in B(s_{0},\frac{1}{e})</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p9" class="ltx_para ltx_noindent">
<p id="A5.SS2.p9.1" class="ltx_p"><span id="A5.SS2.p9.1.1" class="ltx_text">Then it holds:</span></p>
<table id="A5.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex7.m1" class="ltx_Math" alttext="\displaystyle\|\widetilde{u}(x_{1},t_{1})-\widetilde{u}(x_{2},t_{2})\|_{2}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|\widetilde{u}(x_{1},t_{1})-\widetilde{u}(x_{2},t_{2})\|_{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex7.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|\sum_{s\in\mathcal{S}}\phi_{s}(x_{1})\cdot u(s,t_{1})-\sum_{s\in\mathcal{S}}\phi_{s}(x_{2})\cdot u(s,t_{2})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|\sum_{s\in\mathcal{S}}\phi_{s}(x_{1})\cdot u(s,t_{1})-\sum_{s\in\mathcal{S}}\phi_{s}(x_{2})\cdot u(s,t_{2})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex8.m7" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex8.m8" class="ltx_Math" alttext="\displaystyle\penalty\ \|\phi_{s_{0}}(x_{1})\cdot u(s_{0},t_{1})-\phi_{s_{0}}(x_{2})\cdot u(s_{0},t_{2})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><msub><mi>ϕ</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>ϕ</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|\phi_{s_{0}}(x_{1})\cdot u(s_{0},t_{1})-\phi_{s_{0}}(x_{2})\cdot u(s_{0},t_{2})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A5.Ex8.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A5.Ex8.m1" class="ltx_Math" alttext="\phi_{s}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">ϕ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">=</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">0</mn></mrow><annotation encoding="application/x-tex">\phi_{s}(x)=0</annotation></semantics></math><span id="A5.Ex8.1.1" class="ltx_text" style="font-size:67%;"> for <math id="A5.Ex8.m2" class="ltx_Math" alttext="x\notin B(s,\frac{1}{e})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∉</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">B</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">s</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><mfrac style="--ltx-fg-color:#808080;" mathcolor="#808080"><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">e</mi></mfrac><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\notin B(s,\frac{1}{e})</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A5.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex9.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
