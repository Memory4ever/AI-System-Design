<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex34.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\cdot(\sum_{n^{\prime}=k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{|\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{m}_{t}u_{k}(s,t_{2})|}{|t_{1}-t_{2}|^{\gamma}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>γ</mi></msup></mfrac></mstyle></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(2k_{1})^{2k_{1}}M^{d}\cdot(\sum_{n^{\prime}=k_{1}}\sup_{t_{1},t_{2}\in[0,1],t_{1}\neq t_{2},s\in\mathcal{S}}\frac{|\partial^{m}_{t}u_{k}(s,t_{1})-\partial^{m}_{t}u_{k}(s,t_{2})|}{|t_{1}-t_{2}|^{\gamma}}</annotation></semantics></math></td>
