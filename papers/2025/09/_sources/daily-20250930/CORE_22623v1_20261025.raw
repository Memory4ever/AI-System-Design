<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex36.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A2.Ex36.1.1" class="ltx_text" style="font-size:67%;">By <a href="#A2.Thmlemma5" title="Lemma B.5 (Lipschitzness of Softmax(⋅); Modified from Corollary A.7 of ( , )). ‣ Preparations of . ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.5</span></a> and <math id="A2.Ex36.m1" class="ltx_Math" alttext="\|\mathop{{\rm Softmax}}(Z)\|_{F}\leq L" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo><mrow><mo style="--ltx-fg-color:#808080;" lspace="0em" mathcolor="#808080" rspace="0em">Softmax</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">Z</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">F</mi></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">≤</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">L</mi></mrow><annotation encoding="application/x-tex">\|\mathop{{\rm Softmax}}(Z)\|_{F}\leq L</annotation></semantics></math> when <math id="A2.Ex36.m2" class="ltx_Math" alttext="Z\in\mathbb{R}^{L\times L}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">Z</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">ℝ</mi><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">L</mi><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z\in\mathbb{R}^{L\times L}</annotation></semantics></math></span>)</span></span></td></tr></tbody>
