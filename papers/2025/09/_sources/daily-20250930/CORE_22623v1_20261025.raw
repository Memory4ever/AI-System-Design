<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|X_{1}-X_{2}\|_{F}+\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot B_{X}\cdot\|X_{1}^{\top}W_{KQ}^{i}X_{1}-X_{2}^{\top}W_{KQ}^{i}X_{2}\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>−</mo><msub><mi>X</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mi>i</mi></msubsup><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><msub><mi>B</mi><mi>X</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msubsup><mi>X</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|X_{1}-X_{2}\|_{F}+\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot B_{X}\cdot\|X_{1}^{\top}W_{KQ}^{i}X_{1}-X_{2}^{\top}W_{KQ}^{i}X_{2}\|_{F}</annotation></semantics></math></td>
