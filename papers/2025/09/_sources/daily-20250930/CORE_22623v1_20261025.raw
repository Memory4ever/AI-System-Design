<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex41.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ +\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot B_{X}\cdot(\|X_{1}^{\top}\|_{2}\|W_{KQ}^{i}\|_{2}\|X_{1}-X_{2}\|_{F}+\|X_{2}^{\top}\|_{2}\|(W_{KQ}^{i})^{\top}\|_{2}\|X_{1}-X_{2}\|_{F})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mi>i</mi></msubsup><msub><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em" rspace="0.222em">⋅</mo><msub><mi>B</mi><mi>X</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><msub><mi>X</mi><mn>1</mn></msub><mo>−</mo><msub><mi>X</mi><mn>2</mn></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mi>F</mi></msub><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>X</mi><mn>2</mn><mo>⊤</mo></msubsup><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><msub><mi>X</mi><mn>1</mn></msub><mo>−</mo><msub><mi>X</mi><mn>2</mn></msub><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ +\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot B_{X}\cdot(\|X_{1}^{\top}\|_{2}\|W_{KQ}^{i}\|_{2}\|X_{1}-X_{2}\|_{F}+\|X_{2}^{\top}\|_{2}\|(W_{KQ}^{i})^{\top}\|_{2}\|X_{1}-X_{2}\|_{F})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex42.m4" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ +\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot\|X_{1}-X_{2}\|_{F}\cdot L" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>h</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>X</mi><msub><mrow></mrow><mn>1</mn></msub><mo>−</mo><mi>X</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0.222em">⋅</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ +\sum_{i=1}^{h}\|W_{OV}^{i}\|_{2}\cdot\|X_{1}-X_{2}\|_{F}\cdot L</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex42.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A2.Ex42.m1" class="ltx_Math" alttext="\|AX\|_{F}\leq\|A\|_{2}\cdot\|X\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">F</mi></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">≤</mo><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">A</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" rspace="0.055em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">2</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em" rspace="0.222em">⋅</mo><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|AX\|_{F}\leq\|A\|_{2}\cdot\|X\|_{F}</annotation></semantics></math>)</span></span></td></tr></tbody>
<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43.m4" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43.m5" class="ltx_Math" alttext="\displaystyle\penalty\ (1+2(B_{X})^{2}\sum_{i=1}^{h}\|W^{i}_{OV}\|_{2}\cdot\|W^{i}_{KQ}\|_{2}+L\sum_{i=1}^{h}\|W^{i}_{OV}\|_{2})\cdot\|X_{1}-X_{2}\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover></mstyle><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mi>i</mi></msubsup><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover></mstyle><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mi>i</mi></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>−</mo><msub><mi>X</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ (1+2(B_{X})^{2}\sum_{i=1}^{h}\|W^{i}_{OV}\|_{2}\cdot\|W^{i}_{KQ}\|_{2}+L\sum_{i=1}^{h}\|W^{i}_{OV}\|_{2})\cdot\|X_{1}-X_{2}\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex43.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A2.Ex43.m1" class="ltx_Math" alttext="\|X_{1}\|_{2},\|X_{2}\|_{2}\leq B_{X}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">1</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">2</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">,</mo><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">2</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">2</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">≤</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">B</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">X</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|X_{1}\|_{2},\|X_{2}\|_{2}\leq B_{X}</annotation></semantics></math>)</span></span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p15.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p15.2.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Lipschitzness of Transformer.</h5>

<div id="A2.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px2.p1.1" class="ltx_p">Now we state our result on the Lipschitzness of transformer.</p>
</div>
<div id="A2.Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma B.7</span></span><span id="A2.Thmlemma7.3" class="ltx_text ltx_font_bold"> </span>(Lipschitzness of Transformer Block)<span id="A2.Thmlemma7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma7.p1" class="ltx_para">
<p id="A2.Thmlemma7.p1.1" class="ltx_p">Let</p>
<table id="A2.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex44.m1" class="ltx_Math" alttext="\displaystyle f_{\mathcal{T}}:=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>:=</mo><mrow><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{\mathcal{T}}:=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmlemma7.p1.2" class="ltx_p">be a Transformer block in the class</p>
<table id="A2.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex45.m1" class="ltx_Math" alttext="\displaystyle\mathcal{T}^{h,s,r}(C_{\mathcal{T}},C^{2,\infty}_{KQ},C_{KQ},C^{2,\infty}_{OV},C_{OV},C_{E},C^{2,\infty}_{F},C_{F})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>h</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msubsup><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo>,</mo><msubsup><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo>,</mo><msub><mi>C</mi><mi>E</mi></msub><mo>,</mo><msubsup><mi>C</mi><mi>F</mi><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{T}^{h,s,r}(C_{\mathcal{T}},C^{2,\infty}_{KQ},C_{KQ},C^{2,\infty}_{OV},C_{OV},C_{E},C^{2,\infty}_{F},C_{F}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmlemma7.p1.3" class="ltx_p">If <math id="A2.Thmlemma7.p1.m1" class="ltx_Math" alttext="X\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X\in\mathbb{R}^{d\times L}</annotation></semantics></math> satisfies <math id="A2.Thmlemma7.p1.m2" class="ltx_Math" alttext="\|X\|\leq B_{X}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>B</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">\|X\|\leq B_{X}</annotation></semantics></math>, then <math id="A2.Thmlemma7.p1.m3" class="ltx_Math" alttext="f_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">f_{\mathcal{T}}</annotation></semantics></math> is Lipschitz continuous w.r.t. the Frobenius norm <math id="A2.Thmlemma7.p1.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{F}</annotation></semantics></math> with Lipschitz constant</p>
<table id="A2.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex46.m1" class="ltx_Math" alttext="\displaystyle L_{\mathcal{T}}\leq(1+2h(B_{X})^{2}C_{OV}C_{KQ}+hLC_{OV})\cdot(C_{F}^{2}+1)^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub></mrow><mo>+</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>C</mi><mi>F</mi><mn>2</mn></msubsup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle L_{\mathcal{T}}\leq(1+2h(B_{X})^{2}C_{OV}C_{KQ}+hLC_{OV})\cdot(C_{F}^{2}+1)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS2.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.SSS0.Px2.p2" class="ltx_para">
<p id="A2.SS2.SSS0.Px2.p2.1" class="ltx_p"><span id="A2.SS2.SSS0.Px2.p2.1.1" class="ltx_text">This is a direct consequence of combining <a href="#A2.Thmlemma3" title="Lemma B.3 (Lipschitzness of FFN). ‣ Preparations of . ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.3</span></a> and <a href="#A2.Thmlemma6" title="Lemma B.6 (Lipschitzness of Multi-Head Self-Attention). ‣ Preparations of . ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.6</span></a> with <a href="#A2.Thmlemma1" title="Lemma B.1. ‣ Preparations of . ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>.
∎</span></p>
</div>
</div>
<div id="A2.Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmremark1.2" class="ltx_text ltx_font_bold">Remark B.1</span></span><span id="A2.Thmremark1.3" class="ltx_text ltx_font_bold"> </span>(Near-Optimality of the Lipschitz Bound)<span id="A2.Thmremark1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmremark1.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmremark1.p1.1" class="ltx_p">We remark that the upper bound on the Lipschitz constant in <a href="#A2.Thmlemma7" title="Lemma B.7 (Lipschitzness of Transformer Block). ‣ Lipschitzness of Transformer. ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.7</span></a> is near-optimal in its dependence on the key parameters.
To illustrate this, we construct a worst-case example as follows.
Let <math id="A2.Thmremark1.p1.m1" class="ltx_Math" alttext="A\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{d\times L}</annotation></semantics></math> be the diagonal matrix</p>
<table id="A2.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex47.m1" class="ltx_Math" alttext="\displaystyle A_{ij}=\begin{cases}1,\penalty\ &amp;i=j,\\
0,\penalty\ &amp;i\neq j.\end{cases}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{ij}=\begin{cases}1,\penalty\ &amp;i=j,\\
0,\penalty\ &amp;i\neq j.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmremark1.p1.2" class="ltx_p">Consider the network <math id="A2.Thmremark1.p1.m2" class="ltx_Math" alttext="f_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">f_{\mathcal{T}}</annotation></semantics></math> with parameter</p>
<table id="A2.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\displaystyle W^{i}_{OV}=C_{OV}I_{d},\quad W^{i}_{KQ}=C_{KQ}I_{d},\quad W_{1}=W_{2}=C_{F}A," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mi>i</mi></msubsup><mo>=</mo><mrow><msub><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mi>i</mi></msubsup><mo>=</mo><mrow><msub><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo>=</mo><msub><mi>W</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>C</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle W^{i}_{OV}=C_{OV}I_{d},\quad W^{i}_{KQ}=C_{KQ}I_{d},\quad W_{1}=W_{2}=C_{F}A,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmremark1.p1.3" class="ltx_p">where <math id="A2.Thmremark1.p1.m3" class="ltx_Math" alttext="I_{d}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>d</mi></msub><annotation encoding="application/x-tex">I_{d}</annotation></semantics></math> is the <math id="A2.Thmremark1.p1.m4" class="ltx_Math" alttext="d\times d" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d\times d</annotation></semantics></math> identity.</p>
</div>
<div id="A2.Thmremark1.p2" class="ltx_para">
<p id="A2.Thmremark1.p2.1" class="ltx_p">A direct calculation shows that the operator norm of the directional derivative of <math id="A2.Thmremark1.p2.m1" class="ltx_Math" alttext="f_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">f_{\mathcal{T}}</annotation></semantics></math> at an input <math id="A2.Thmremark1.p2.m2" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> in direction <math id="A2.Thmremark1.p2.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> scales with the same order as the upper bound in <a href="#A2.Thmlemma7" title="Lemma B.7 (Lipschitzness of Transformer Block). ‣ Lipschitzness of Transformer. ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.7</span></a>, up to constants and polynomial factors in <math id="A2.Thmremark1.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.
Hence the bound in <a href="#A2.Thmlemma7" title="Lemma B.7 (Lipschitzness of Transformer Block). ‣ Lipschitzness of Transformer. ‣ B.2 Lipschitzness of Transformer Network ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.7</span></a> provides a tight estimate by construction.</p>
</div>
</div>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Universal Approximation of Transformers</h4>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">Previous works <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Hu et al., 2024b</a>; <a href="#bib.bib22" title="" class="ltx_ref">Kajitsuka and Sato, 2023</a>; <a href="#bib.bib36" title="" class="ltx_ref">Yun et al., 2019</a>)</cite> study the universal approximation property of Transformers for continuous functions.
In this section, we restate the proofs for completeness and adapt the parameter estimates to the discrete flow-matching framework.
This adaptation highlights the connection between universal approximation and our discrete setting.</p>
</div>
<section id="A2.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Background: Contextual Mapping.</h5>

<div id="A2.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p1.1" class="ltx_p">Concept of contextual mapping is key to the proof of universal approximation of transformer.
We restate the definition of contextual mapping and related concepts introduced by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib22" title="" class="ltx_ref">Kajitsuka and Sato (2023)</a></cite> for completeness.
To start with, we introduce the concept of Vocabulary.
We use <math id="A2.SS3.SSS0.Px1.p1.m1" class="ltx_math_unparsed" alttext="Z_{:,k}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Z_{:,k}</annotation></semantics></math> to denote the <math id="A2.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th column of vector <math id="A2.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmdefinition5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition5.2" class="ltx_text ltx_font_bold">Definition B.5</span></span><span id="A2.Thmdefinition5.3" class="ltx_text ltx_font_bold"> </span>(Vocabulary)<span id="A2.Thmdefinition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition5.p1" class="ltx_para">
<p id="A2.Thmdefinition5.p1.1" class="ltx_p">Let <math id="A2.Thmdefinition5.p1.m1" class="ltx_Math" alttext="Z\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z\in\mathbb{R}^{d\times L}</annotation></semantics></math> represent input embeddings.
Specifically, given <math id="A2.Thmdefinition5.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> embeddings <math id="A2.Thmdefinition5.p1.m3" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math>, we call <math id="A2.Thmdefinition5.p1.m4" class="ltx_Math" alttext="Z^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">Z^{(i)}</annotation></semantics></math> the <math id="A2.Thmdefinition5.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th sequence for <math id="A2.Thmdefinition5.p1.m6" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math>.
Further, we define the <math id="A2.Thmdefinition5.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th vocabulary set as <math id="A2.Thmdefinition5.p1.m8" class="ltx_math_unparsed" alttext="\mathcal{V}^{(i)}=\cup_{k\in[L]}Z^{(i)}_{:,k}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0em">=</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>⊂</mo><mi>ℝ</mi><msup><mrow></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}^{(i)}=\cup_{k\in[L]}Z^{(i)}_{:,k}\subset\mathbb{R}^{d}</annotation></semantics></math>.
Then the whole vocabulary set <math id="A2.Thmdefinition5.p1.m9" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math> is defined as <math id="A2.Thmdefinition5.p1.m10" class="ltx_math_unparsed" alttext="\mathcal{V}=\cup_{i\in[N]}\mathcal{V}^{(i)}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo rspace="0em">=</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}=\cup_{i\in[N]}\mathcal{V}^{(i)}\in\mathbb{R}^{d}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p2.1" class="ltx_p">We assume embeddings are separate.
Specifically, we assume embeddings are <math id="A2.SS3.SSS0.Px1.p2.m1" class="ltx_Math" alttext="(\gamma_{\rm min},\gamma_{\rm max},\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>max</mi></msub><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma_{\rm min},\gamma_{\rm max},\delta)</annotation></semantics></math>-separated defined below.</p>
</div>
<div id="A2.Thmdefinition6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition6.2" class="ltx_text ltx_font_bold">Definition B.6</span></span><span id="A2.Thmdefinition6.3" class="ltx_text ltx_font_bold"> </span>(Tokenwise Separateness)<span id="A2.Thmdefinition6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition6.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmdefinition6.p1.1" class="ltx_p">Let <math id="A2.Thmdefinition6.p1.m1" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math> be embeddings.
Then <math id="A2.Thmdefinition6.p1.m2" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}</annotation></semantics></math> are called tokenwise <math id="A2.Thmdefinition6.p1.m3" class="ltx_Math" alttext="(\gamma_{\rm min},\gamma_{\rm max},\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>max</mi></msub><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma_{\rm min},\gamma_{\rm max},\delta)</annotation></semantics></math>-separated if the following conditions hold:</p>
<ol id="A2.I2" class="ltx_enumerate">
<li id="A2.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A2.I2.ix1.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.ix1.p1.1" class="ltx_p">For any <math id="A2.I2.ix1.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="A2.I2.ix1.p1.m2" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math>, <math id="A2.I2.ix1.p1.m3" class="ltx_math_unparsed" alttext="\|Z^{(i)}_{:,k}\|&gt;\gamma_{\rm min}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&gt;</mo><mi>γ</mi><msub><mrow></mrow><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\|Z^{(i)}_{:,k}\|&gt;\gamma_{\rm min}</annotation></semantics></math> holds.</p>
</div></li>
<li id="A2.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A2.I2.ix2.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.ix2.p1.1" class="ltx_p">For any <math id="A2.I2.ix2.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="A2.I2.ix2.p1.m2" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math>, <math id="A2.I2.ix2.p1.m3" class="ltx_math_unparsed" alttext="\|Z^{(i)}_{:,k}\|&lt;\gamma_{\rm max}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&lt;</mo><mi>γ</mi><msub><mrow></mrow><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|Z^{(i)}_{:,k}\|&lt;\gamma_{\rm max}</annotation></semantics></math> holds.</p>
</div></li>
<li id="A2.I2.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A2.I2.ix3.p1" class="ltx_para">
<p id="A2.I2.ix3.p1.1" class="ltx_p">For any <math id="A2.I2.ix3.p1.m1" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math> and <math id="A2.I2.ix3.p1.m2" class="ltx_Math" alttext="k,m\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,m\in[L]</annotation></semantics></math>, if <math id="A2.I2.ix3.p1.m3" class="ltx_math_unparsed" alttext="Z^{(i)}_{:,k}\neq Z^{(j)}_{:,m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≠</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Z^{(i)}_{:,k}\neq Z^{(j)}_{:,m}</annotation></semantics></math>, then <math id="A2.I2.ix3.p1.m4" class="ltx_math_unparsed" alttext="\|Z^{(i)}_{:,k}-Z^{(j)}_{:,m}\|&gt;\delta" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&gt;</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\|Z^{(i)}_{:,k}-Z^{(j)}_{:,m}\|&gt;\delta</annotation></semantics></math> holds.</p>
</div></li>
</ol>
</div>
<div id="A2.Thmdefinition6.p2" class="ltx_para">
<p id="A2.Thmdefinition6.p2.1" class="ltx_p">Further, <math id="A2.Thmdefinition6.p2.m1" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}</annotation></semantics></math> are called tokenwise <math id="A2.Thmdefinition6.p2.m2" class="ltx_Math" alttext="(\gamma,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\delta)</annotation></semantics></math>-separated if only (ii) and (iii) hold.
Also, <math id="A2.Thmdefinition6.p2.m3" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}</annotation></semantics></math> are called tokenwise <math id="A2.Thmdefinition6.p2.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-separated if only (iii) holds.</p>
</div>
</div>
<div id="A2.SS3.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p3.1" class="ltx_p">Building on the condition (ii) and (iii) in <a href="#A2.Thmdefinition6" title="Definition B.6 (Tokenwise Separateness). ‣ Background: Contextual Mapping. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">B.6</span></a>, we introduce the concept of contextual mapping.
Contextual mapping describes attention layer’s ability to distinguish difference and relationship between tokens in different input sequences.</p>
</div>
<div id="A2.Thmdefinition7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition7.2" class="ltx_text ltx_font_bold">Definition B.7</span></span><span id="A2.Thmdefinition7.3" class="ltx_text ltx_font_bold"> </span>(Contextual Mapping)<span id="A2.Thmdefinition7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition7.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmdefinition7.p1.1" class="ltx_p">Let <math id="A2.Thmdefinition7.p1.m1" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math> be embeddings.
Then, we say a map <math id="A2.Thmdefinition7.p1.m2" class="ltx_Math" alttext="f:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> is a <math id="A2.Thmdefinition7.p1.m3" class="ltx_Math" alttext="(\gamma,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\delta)</annotation></semantics></math>-contextual mapping if the following conditions hold:</p>
<ol id="A2.I3" class="ltx_enumerate">
<li id="A2.I3.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A2.I3.ix1.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.ix1.p1.1" class="ltx_p">For For any <math id="A2.I3.ix1.p1.m1" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="A2.I3.ix1.p1.m2" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math>, <math id="A2.I3.ix1.p1.m3" class="ltx_math_unparsed" alttext="\|f(Z^{(i)})_{:,k}\|&lt;\gamma" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>f</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&lt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\|f(Z^{(i)})_{:,k}\|&lt;\gamma</annotation></semantics></math> holds.</p>
</div></li>
<li id="A2.I3.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A2.I3.ix2.p1" class="ltx_para">
<p id="A2.I3.ix2.p1.1" class="ltx_p">For any <math id="A2.I3.ix2.p1.m1" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math> and <math id="A2.I3.ix2.p1.m2" class="ltx_Math" alttext="k,m\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,m\in[L]</annotation></semantics></math>, if <math id="A2.I3.ix2.p1.m3" class="ltx_Math" alttext="\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}</annotation></semantics></math> or <math id="A2.I3.ix2.p1.m4" class="ltx_math_unparsed" alttext="Z^{(i)}_{:,k}\neq Z^{(j)}_{:,m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≠</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Z^{(i)}_{:,k}\neq Z^{(j)}_{:,m}</annotation></semantics></math>, then <math id="A2.I3.ix2.p1.m5" class="ltx_math_unparsed" alttext="\|f(Z^{(i)})_{:,k}-f(Z^{(j)})_{:,m}\|&gt;\delta" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>f</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&gt;</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\|f(Z^{(i)})_{:,k}-f(Z^{(j)})_{:,m}\|&gt;\delta</annotation></semantics></math> holds.</p>
</div></li>
</ol>
</div>
</div>
<div id="A2.SS3.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p4.1" class="ltx_p"><span id="A2.SS3.SSS0.Px1.p4.1.1" class="ltx_text ltx_font_bold">Helper Lemma.</span>
We restate a lemma from <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Hu et al., 2024a</a>)</cite>.
This lemma guarantee the existence of 1-layer single head attention that is <math id="A2.SS3.SSS0.Px1.p4.m1" class="ltx_Math" alttext="(\gamma,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\delta)</annotation></semantics></math>-contextual mapping.</p>
</div>
<div id="A2.Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma B.8</span></span><span id="A2.Thmlemma8.3" class="ltx_text ltx_font_bold"> </span>(Any-Rank Attention is <math id="A2.Thmlemma8.m1" class="ltx_Math" alttext="(\gamma,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\delta)</annotation></semantics></math>-Contextual Mapping, Lemma 2.2 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Hu et al., 2024a</a>)</cite>)<span id="A2.Thmlemma8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma8.p1" class="ltx_para">
<p id="A2.Thmlemma8.p1.1" class="ltx_p">Let <math id="A2.Thmlemma8.p1.m1" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math> be tokenwise <math id="A2.Thmlemma8.p1.m2" class="ltx_Math" alttext="(\gamma_{\rm min},\gamma_{\rm max},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>max</mi></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma_{\rm min},\gamma_{\rm max},\epsilon)</annotation></semantics></math>-separated embeddings with the vocabulary set <math id="A2.Thmlemma8.p1.m3" class="ltx_math_unparsed" alttext="\mathcal{V}=\cup_{i\in[N]}\mathcal{V}^{(i)}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo rspace="0em">=</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>⊂</mo><mi>ℝ</mi><msup><mrow></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}=\cup_{i\in[N]}\mathcal{V}^{(i)}\subset\mathbb{R}^{d}</annotation></semantics></math>.
Assume there are no duplicate token in each sequence; that is, <math id="A2.Thmlemma8.p1.m4" class="ltx_math_unparsed" alttext="Z^{(i)}_{:,k}\neq Z^{(i)}_{:,m}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≠</mo><mi>Z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Z^{(i)}_{:,k}\neq Z^{(i)}_{:,m}</annotation></semantics></math> for <math id="A2.Thmlemma8.p1.m5" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="A2.Thmlemma8.p1.m6" class="ltx_Math" alttext="k,m\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,m\in[L]</annotation></semantics></math>.
Then there exists a 1-layer single head attention layer that is a <math id="A2.Thmlemma8.p1.m7" class="ltx_Math" alttext="(\gamma,\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\delta)</annotation></semantics></math>-contextual mapping for the embeddings <math id="A2.Thmlemma8.p1.m8" class="ltx_Math" alttext="Z^{(1)},\dots,Z^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">Z^{(1)},\dots,Z^{(N)}</annotation></semantics></math> with</p>
<table id="A2.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex49.m1" class="ltx_Math" alttext="\displaystyle\gamma=\gamma_{\rm max}+\frac{\epsilon}{4},\penalty\ \delta=\exp(-\frac{5|\mathcal{V}|^4d\kappa\gamma_{\rm max}\log L}{\epsilon})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi>γ</mi><mi>max</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>4</mn></mfrac></mstyle></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>δ</mi><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma=\gamma_{\rm max}+\frac{\epsilon}{4},\penalty\ \delta=\exp(-\frac{5|\mathcal{V}|^4d\kappa\gamma_{\rm max}\log L}{\epsilon}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmlemma8.p1.2" class="ltx_p">where <math id="A2.Thmlemma8.p1.m9" class="ltx_Math" alttext="\kappa:=\frac{\gamma_{\rm max}}{\gamma_{\rm min}}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>:=</mo><mfrac><msub><mi>γ</mi><mi>max</mi></msub><msub><mi>γ</mi><mi>min</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\kappa:=\frac{\gamma_{\rm max}}{\gamma_{\rm min}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.SS3.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.SSS0.Px1.p5" class="ltx_para">
<p id="A2.SS3.SSS0.Px1.p5.1" class="ltx_p"><span id="A2.SS3.SSS0.Px1.p5.1.1" class="ltx_text">See the proof of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Hu et al., 2024a</a>, Lemma 2.2)</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Universal Approximation of Transformer.</h5>

<div id="A2.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p1.1" class="ltx_p">We introduce the universal approximation theory of transformer in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>)</cite> and restate the proof for completeness.</p>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Transformer Universal Approximation, Theorem H.2 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>)</cite>)<span id="A2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p">Let <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\epsilon\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,1)</annotation></semantics></math> and <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="p\in[1,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p\in[1,\infty)</annotation></semantics></math>.
Let <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="Z\in[-I,I]^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z\in[-I,I]^{d\times L}</annotation></semantics></math> be an input sequence on a bounder domain, where <math id="A2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="I&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">I&gt;0</annotation></semantics></math>.
Let <math id="A2.Thmtheorem1.p1.m5" class="ltx_Math" alttext="f(Z):[-I,I]^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f(Z):[-I,I]^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> be a continuous function on a bounded domain.
Then there exists a <math id="A2.Thmtheorem1.p1.m6" class="ltx_Math" alttext="g(Z)=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2}\in\mathcal{T}^{h,s,r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>h</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">g(Z)=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2}\in\mathcal{T}^{h,s,r}</annotation></semantics></math> such that <math id="A2.Thmtheorem1.p1.m7" class="ltx_Math" alttext="d_{F}(f(Z),g(Z))&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">d_{F}(f(Z),g(Z))&lt;\epsilon</annotation></semantics></math>, where <math id="A2.Thmtheorem1.p1.m8" class="ltx_Math" alttext="d_{F}:=(\int\|f(Z)-g(Z)\|_{F}^{2}\differential Z)^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>F</mi></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">∫</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>Z</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">d_{F}:=(\int\|f(Z)-g(Z)\|_{F}^{2}\differential Z)^{\frac{1}{2}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.SS3.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p2.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p2.1.1" class="ltx_text">Here, we restate the proof of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>, Theorem H.2)</cite> for completeness.</span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p3.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p3.1.1" class="ltx_text">The proof proceeds in four parts:</span></p>
<ul id="A2.I4" class="ltx_itemize">
<li id="A2.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I4.i1.p1.1" class="ltx_p">Step 1: Approximation using step function</p>
</div></li>
<li id="A2.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I4.i2.p1.1" class="ltx_p">Step 2: Quantization by the first feed-forward layer</p>
</div></li>
<li id="A2.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I4.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I4.i3.p1.1" class="ltx_p">Step 3: Contextual mapping through the self-attention layer</p>
</div></li>
<li id="A2.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I4.i4.p1" class="ltx_para">
<p id="A2.I4.i4.p1.1" class="ltx_p">Step 4: Memorization via the second feed-forward layer</p>
</div></li>
</ul>
</div>
<div id="A2.SS3.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p4.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_bold">Step 1: Approximation using Step Function.<span id="A2.SS3.SSS0.Px2.p4.1.1.1" class="ltx_text ltx_font_medium">
We assume the domain of <math id="A2.SS3.SSS0.Px2.p4.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is <math id="A2.SS3.SSS0.Px2.p4.m2" class="ltx_Math" alttext="\Omega=[-I,I]^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Omega=[-I,I]^{d\times L}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p5" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p5.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p5.1.1" class="ltx_text">Then we construct the grid <math id="A2.SS3.SSS0.Px2.p5.m1" class="ltx_Math" alttext="\mathbb{G}_{D}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>D</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{D}</annotation></semantics></math> as :</span></p>
<table id="A2.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex50.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{G}_{D}:=\{C\in\Omega|C_{i,k}=-I+\frac{s_{i,k}}{D},s_{i,k}=1,\dots,2ID,\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔾</mi><mi>D</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>C</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>C</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>I</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mi>D</mi></mfrac></mstyle><mo>,</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2</mn><mi>I</mi><mi>D</mi><mo>,</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{G}_{D}:=\{C\in\Omega|C_{i,k}=-I+\frac{s_{i,k}}{D},s_{i,k}=1,\dots,2ID,\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p5.2" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p5.2.1" class="ltx_text">where <math id="A2.SS3.SSS0.Px2.p5.m2" class="ltx_Math" alttext="D&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D&gt;0</annotation></semantics></math> is the grid granularity.
Given <math id="A2.SS3.SSS0.Px2.p5.m3" class="ltx_Math" alttext="Z\in\Omega" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow><annotation encoding="application/x-tex">Z\in\Omega</annotation></semantics></math>, we approximate <math id="A2.SS3.SSS0.Px2.p5.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> via the step function</span></p>
<table id="A2.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex51.m1" class="ltx_math_unparsed" alttext="\displaystyle g_{1}(Z)=\sum_{C\in\mathbb{G}_{D}}f(C)\mathds{1}\{Z\in C+[-1/D,0)^{d\times L}\}." display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>C</mi><mo>∈</mo><msub><mi>𝔾</mi><mi>D</mi></msub></mrow></munder></mstyle><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><mo>∈</mo><mi>C</mi><mo>+</mo><msup><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mi>D</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle g_{1}(Z)=\sum_{C\in\mathbb{G}_{D}}f(C)\mathds{1}\{Z\in C+[-1/D,0)^{d\times L}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p5.3" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p5.3.1" class="ltx_text">By uniform continuity of <math id="A2.SS3.SSS0.Px2.p5.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> , there exists <math id="A2.SS3.SSS0.Px2.p5.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> such that</span></p>
<table id="A2.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex52.m1" class="ltx_Math" alttext="\displaystyle d_{F}(f,g_{1})&lt;\frac{\epsilon}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(f,g_{1})&lt;\frac{\epsilon}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p5.4" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p5.4.1" class="ltx_text">Then we use a transformer to approximate the step function <math id="A2.SS3.SSS0.Px2.p5.m7" class="ltx_Math" alttext="g_{1}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{1}(Z)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p6" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p6.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p6.1.1" class="ltx_text ltx_font_bold">Step 2: Quantization by the First Feed-forward Layer.<span id="A2.SS3.SSS0.Px2.p6.1.1.1" class="ltx_text ltx_font_medium">
The quantification function we want to approximate consists of two parts, namely, the quantize function and the penalty function.
We approximate two parts separately.</span></span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p7" class="ltx_para ltx_noindent">
<ul id="A2.I5" class="ltx_itemize">
<li id="A2.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I5.i1.p1.1" class="ltx_p"><span id="A2.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">Quantize Function</span>
We define the quantization function <math id="A2.I5.i1.p1.m1" class="ltx_Math" alttext="{\rm quant}_{D}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>quant</mi><mi>D</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm quant}_{D}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math>:</p>
<table id="A2.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\displaystyle{\rm quant}_{D}(z):=\begin{cases}-I&amp;\penalty\ z&lt;-I,\\
-I+1/D&amp;\penalty\ -I\leq z&lt;-I+1/D,\\
\vdots&amp;\penalty\ \vdots\\
I&amp;\penalty\ I-1/D\leq z.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>quant</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>I</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>z</mi><mo>&lt;</mo><mrow><mo>−</mo><mi>I</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>≤</mo><mi>z</mi><mo>&lt;</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>I</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>I</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow></mrow><mo>≤</mo><mi>z</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\rm quant}_{D}(z):=\begin{cases}-I&amp;\penalty\ z&lt;-I,\\
-I+1/D&amp;\penalty\ -I\leq z&lt;-I+1/D,\\
\vdots&amp;\penalty\ \vdots\\
I&amp;\penalty\ I-1/D\leq z.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I5.i1.p1.2" class="ltx_p">Further, we define the quantize function <math id="A2.I5.i1.p1.m2" class="ltx_Math" alttext="{\rm quant}^{d\times L}_{D}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>quant</mi><mi>D</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\rm quant}^{d\times L}_{D}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> as the entrywise quantize function, such that <math id="A2.I5.i1.p1.m3" class="ltx_Math" alttext="({\rm quant}^{d\times L}_{D}(Z))_{t,k}={\rm quant}_{D}(Z_{t,k})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>quant</mi><mi>D</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>quant</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\rm quant}^{d\times L}_{D}(Z))_{t,k}={\rm quant}_{D}(Z_{t,k})</annotation></semantics></math>.
Notice that <math id="A2.I5.i1.p1.m4" class="ltx_Math" alttext="{\rm quant}_{D}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>quant</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm quant}_{D}(z)</annotation></semantics></math> is approximated through the following function by taking sufficiently small <math id="A2.I5.i1.p1.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>:</p>
<table id="A2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E1.m1" class="ltx_Math" alttext="\displaystyle f_{1}(z):=-I+\sum_{t=-ID}^{I(D-1)}\frac{\rm RELU[z/\delta-t/\delta D]-\mathop{\mathsf{ReLU}}[z/\delta-1-t/\delta D]}{D}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mo>−</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow></mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>RELU</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>z</mi><mo>/</mo><mi>δ</mi></mrow><mo>−</mo><mrow><mrow><mi>t</mi><mo>/</mo><mi>δ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>z</mi><mo>/</mo><mi>δ</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mrow><mrow><mi>t</mi><mo>/</mo><mi>δ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mi>D</mi></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{1}(z):=-I+\sum_{t=-ID}^{I(D-1)}\frac{\rm RELU[z/\delta-t/\delta D]-\mathop{\mathsf{ReLU}}[z/\delta-1-t/\delta D]}{D}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.1)</span></td></tr></tbody>
</table>
<p id="A2.I5.i1.p1.3" class="ltx_p">That’s to say, there exists RELU feed-forward network approximating <math id="A2.I5.i1.p1.m6" class="ltx_Math" alttext="{\rm quant}^{d\times L}_{D}(Z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>quant</mi><mi>D</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm quant}^{d\times L}_{D}(Z)</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I5.i2.p1" class="ltx_para">
<p id="A2.I5.i2.p1.1" class="ltx_p"><span id="A2.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">Penalty Function</span>
We define the penalty function <math id="A2.I5.i2.p1.m1" class="ltx_Math" alttext="{\rm penalty}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>penalty</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm penalty}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math>:</p>
<table id="A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\displaystyle{\rm penalty}(z):=\begin{cases}-1&amp;\penalty\ z&lt;-I,\\
0&amp;\penalty\ z\in[-I,I],\\
1&amp;\penalty\ z&gt;I.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>penalty</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>z</mi><mo>&lt;</mo><mrow><mo>−</mo><mi>I</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>z</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>z</mi><mo>&gt;</mo><mi>I</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\rm penalty}(z):=\begin{cases}-1&amp;\penalty\ z&lt;-I,\\
0&amp;\penalty\ z\in[-I,I],\\
1&amp;\penalty\ z&gt;I.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I5.i2.p1.2" class="ltx_p">Further, we define the penalty function <math id="A2.I5.i2.p1.m2" class="ltx_Math" alttext="{\rm penalty}^{d\times L}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>penalty</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\rm penalty}^{d\times L}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> as the entrywise penalty function, such that <math id="A2.I5.i2.p1.m3" class="ltx_Math" alttext="({\rm penalty}^{d\times L}(Z))_{t,k}={\rm quant}_{D}(Z_{t,k})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>penalty</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msub><mi>quant</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\rm penalty}^{d\times L}(Z))_{t,k}={\rm quant}_{D}(Z_{t,k})</annotation></semantics></math>.
Notice that <math id="A2.I5.i2.p1.m4" class="ltx_Math" alttext="{\rm penalty}(z)" display="inline" intent=":literal"><semantics><mrow><mi>penalty</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm penalty}(z)</annotation></semantics></math> is approximated through the following function by taking sufficiently small <math id="A2.I5.i2.p1.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>:</p>
<table id="A2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\displaystyle f_{2}(z)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle f_{2}(z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex55.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(z-I)/\delta]-\mathop{\mathsf{ReLU}}[(z-I)/\delta+1]" display="inline" intent=":literal"><semantics><mrow><mrow><mo movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(z-I)/\delta]-\mathop{\mathsf{ReLU}}[(z-I)/\delta+1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E2.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ +\mathop{\mathsf{ReLU}}[(-z-I)/\delta]-\mathop{\mathsf{ReLU}}[(-z-I)/\delta+1]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>z</mi><mo>−</mo><mi>I</mi><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>z</mi><mo>−</mo><mi>I</mi><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ +\mathop{\mathsf{ReLU}}[(-z-I)/\delta]-\mathop{\mathsf{ReLU}}[(-z-I)/\delta+1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.2)</span></td></tr></tbody>
</table>
<p id="A2.I5.i2.p1.3" class="ltx_p">That’s to say, there exists RELU feed-forward network approximating <math id="A2.I5.i2.p1.m6" class="ltx_Math" alttext="{\rm penalty}^{d\times L}(Z)" display="inline" intent=":literal"><semantics><mrow><msup><mi>penalty</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm penalty}^{d\times L}(Z)</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A2.SS3.SSS0.Px2.p8" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p8.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p8.1.1" class="ltx_text">Altogether, we define <math id="A2.SS3.SSS0.Px2.p8.m1" class="ltx_Math" alttext="g_{2}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">g_{2}(Z):\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> as :</span></p>
<table id="A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\displaystyle g_{2}(Z):=\frac{{\rm quant}^{d\times L}_{D}(Z)+I}{2I}+{\rm penalty}^{d\times L}(Z)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>quant</mi><mi>D</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>I</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><msup><mi>penalty</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle g_{2}(Z):=\frac{{\rm quant}^{d\times L}_{D}(Z)+I}{2I}+{\rm penalty}^{d\times L}(Z).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p8.2" class="ltx_p"><math id="A2.SS3.SSS0.Px2.p8.m2" class="ltx_Math" alttext="g_{2}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{2}(Z)</annotation></semantics></math><span id="A2.SS3.SSS0.Px2.p8.2.1" class="ltx_text"> map <math id="A2.SS3.SSS0.Px2.p8.m3" class="ltx_Math" alttext="[-I,I]^{d\times L}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><annotation encoding="application/x-tex">[-I,I]^{d\times L}</annotation></semantics></math> into normalized grid <math id="A2.SS3.SSS0.Px2.p8.m4" class="ltx_Math" alttext="\mathbb{G}_{D}^{\rm norm}\subset[0,1]^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup><mo>⊂</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{G}_{D}^{\rm norm}\subset[0,1]^{d\times L}</annotation></semantics></math> with gride granularity <math id="A2.SS3.SSS0.Px2.p8.m5" class="ltx_Math" alttext="2ID" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">2ID</annotation></semantics></math>.
At the same time, <math id="A2.SS3.SSS0.Px2.p8.m6" class="ltx_Math" alttext="g_{2}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{2}(Z)</annotation></semantics></math> guarantees non-positive outputs on domain <math id="A2.SS3.SSS0.Px2.p8.m7" class="ltx_Math" alttext="\mathbb{R}^{d\times L}\backslash[-I,I]^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">\</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{R}^{d\times L}\backslash[-I,I]^{d\times L}</annotation></semantics></math>.
We use <math id="A2.SS3.SSS0.Px2.p8.m8" class="ltx_Math" alttext="f_{1}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{1}(z)</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px2.p8.m9" class="ltx_Math" alttext="f_{2}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{2}(z)</annotation></semantics></math> introduced above to construct the first feed-forward layer <math id="A2.SS3.SSS0.Px2.p8.m10" class="ltx_Math" alttext="F^{\rm FF}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F^{\rm FF}_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p9" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p9.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p9.1.1" class="ltx_text ltx_font_bold">Step 3: Contextual Mapping through the Self-attention Layer.<span id="A2.SS3.SSS0.Px2.p9.1.1.1" class="ltx_text ltx_font_medium">
Let <math id="A2.SS3.SSS0.Px2.p9.m1" class="ltx_math_unparsed" alttext="\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}" display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\macc@depth</mtext><mi mathvariant="normal">Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><msub><mrow></mrow><mi>D</mi></msub></mrow><annotation encoding="application/x-tex">\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}</annotation></semantics></math> denote the following sub-grid class on <math id="A2.SS3.SSS0.Px2.p9.m2" class="ltx_Math" alttext="[0,1]^{d\times L}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><annotation encoding="application/x-tex">[0,1]^{d\times L}</annotation></semantics></math>:</span></span></p>
<table id="A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex57.m1" class="ltx_math_unparsed" alttext="\displaystyle\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}:=\{G\in\mathbb{G}_{D}^{\rm norm}\mid{\rm for\penalty\ all\penalty\ }k,m\in[L],G_{:,k}\neq G_{:,m}\}." display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\macc@depth</mtext><mi>Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><mmultiscripts><mo>:=</mo><mprescripts></mprescripts><mi>D</mi><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">{</mo><mi>G</mi><mo>∈</mo><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mi>for</mi><mi>all</mi><mi>k</mi><mo>,</mo><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><msub><mi>G</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≠</mo><msub><mi>G</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>m</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}:=\{G\in\mathbb{G}_{D}^{\rm norm}\mid{\rm for\penalty\ all\penalty\ }k,m\in[L],G_{:,k}\neq G_{:,m}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p9.2" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p9.2.1" class="ltx_text">The by definition, <math id="A2.SS3.SSS0.Px2.p9.m3" class="ltx_math_unparsed" alttext="\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}" display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\macc@depth</mtext><mi>Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><msub><mrow></mrow><mi>D</mi></msub></mrow><annotation encoding="application/x-tex">\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}</annotation></semantics></math> is a token class with token-wise <math id="A2.SS3.SSS0.Px2.p9.m4" class="ltx_Math" alttext="((2ID)^{-1},\sqrt{d},(2ID)^{-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msqrt><mi>d</mi></msqrt><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((2ID)^{-1},\sqrt{d},(2ID)^{-1})</annotation></semantics></math>-separated sequence.
Following the construction of <math id="A2.SS3.SSS0.Px2.p9.m5" class="ltx_Math" alttext="F^{\rm SA}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mi>SA</mi></msup><annotation encoding="application/x-tex">F^{\rm SA}</annotation></semantics></math> in proof of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>, Theorem H.2)</cite>, for sufficiently large <math id="A2.SS3.SSS0.Px2.p9.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> we have:</span></p>
<table id="A2.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\displaystyle F^{\rm SA}\circ F^{\rm FF}_{1}(Z)_{t,k}&lt;" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>&lt;</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F^{\rm SA}\circ F^{\rm FF}_{1}(Z)_{t,k}&lt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex58.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{4D}\quad{\rm for\penalty\ all}\quad Z\in\mathbb{R}^{d\times L}\backslash[-I,I]^{d\times L},\quad t\in[d],k\in[L]," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mfrac></mstyle><mspace style="width:1em;" width="1em"></mspace><mrow><mi>for</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>all</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mi>Z</mi><mo>∈</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">\</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{4D}\quad{\rm for\penalty\ all}\quad Z\in\mathbb{R}^{d\times L}\backslash[-I,I]^{d\times L},\quad t\in[d],k\in[L],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle F^{\rm SA}\circ F^{\rm FF}_{1}(Z)_{t,k}&gt;" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>&gt;</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F^{\rm SA}\circ F^{\rm FF}_{1}(Z)_{t,k}&gt;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{3}{4D}\quad{\rm for\penalty\ all}\quad Z\in[-I,I]^{d\times L},\quad t\in[d],k\in[L]." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mfrac></mstyle><mspace style="width:1em;" width="1em"></mspace><mrow><mi>for</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>all</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mi>Z</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{3}{4D}\quad{\rm for\penalty\ all}\quad Z\in[-I,I]^{d\times L},\quad t\in[d],k\in[L].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS0.Px2.p10" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p10.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p10.1.1" class="ltx_text ltx_font_bold">Step 4: Memorization via the Second Feed-forward Layer.<span id="A2.SS3.SSS0.Px2.p10.1.1.1" class="ltx_text ltx_font_medium">
Finally, we construct a bump function of scale <math id="A2.SS3.SSS0.Px2.p10.m1" class="ltx_Math" alttext="R&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R&gt;0</annotation></semantics></math> to map every <math id="A2.SS3.SSS0.Px2.p10.m2" class="ltx_math_unparsed" alttext="c\in\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mtext class="undefined">\macc@depth</mtext><mi mathvariant="normal">Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><msub><mrow></mrow><mi>D</mi></msub></mrow><annotation encoding="application/x-tex">c\in\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}</annotation></semantics></math> to its label <math id="A2.SS3.SSS0.Px2.p10.m3" class="ltx_Math" alttext="f(C)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(C)</annotation></semantics></math> and sends any sequence that lies component-wise below the threshold <math id="A2.SS3.SSS0.Px2.p10.m4" class="ltx_Math" alttext="1/(4D)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/(4D)</annotation></semantics></math> to zero.
Precisely, for each <math id="A2.SS3.SSS0.Px2.p10.m5" class="ltx_Math" alttext="C\in\mathbb{G}_{D}^{\rm norm}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup></mrow><annotation encoding="application/x-tex">C\in\mathbb{G}_{D}^{\rm norm}</annotation></semantics></math> we construct a bump function of scale <math id="A2.SS3.SSS0.Px2.p10.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>:</span></span></p>
<table id="A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\displaystyle{\rm bump}_{R}(Z)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>bump</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\rm bump}_{R}(Z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{f(2C-I)}{dL}\sum_{t=1}^{d}\sum_{k=1}^{L}({\rm RELU[R(Z_{t,k}-C_{t,k})-1]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mi>RELU</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{f(2C-I)}{dL}\sum_{t=1}^{d}\sum_{k=1}^{L}({\rm RELU[R(Z_{t,k}-C_{t,k})-1]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E3.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ -\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})]+\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})+1])." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ -\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})]+\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})+1]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(B.3)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p10.2" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p10.2.1" class="ltx_text">Summing up over <math id="A2.SS3.SSS0.Px2.p10.m7" class="ltx_Math" alttext="C\in\mathbb{G}_{D}^{\rm norm}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup></mrow><annotation encoding="application/x-tex">C\in\mathbb{G}_{D}^{\rm norm}</annotation></semantics></math> and we obtain the second feed-forward layer <math id="A2.SS3.SSS0.Px2.p10.m8" class="ltx_Math" alttext="F_{2}^{\rm FF}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F_{2}^{\rm FF}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS0.Px2.p11" class="ltx_para">
<p id="A2.SS3.SSS0.Px2.p11.1" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p11.1.1" class="ltx_text">We sum up the error bound in four steps.
As discussed in the step approximation using step function, there exists <math id="A2.SS3.SSS0.Px2.p11.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> such that</span></p>
<table id="A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle d_{F}(f,g_{1})&lt;\frac{\epsilon}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(f,g_{1})&lt;\frac{\epsilon}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p11.2" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p11.2.1" class="ltx_text">By choosing sifficiently quantization step <math id="A2.SS3.SSS0.Px2.p11.m2" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, we obtain</span></p>
<table id="A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\displaystyle d_{F}(F^{\rm FF}_{2}\circ F^{\rm SA}\circ F^{\rm FF}_{1},F^{\rm FF}_{2}\circ F^{\rm SA}\circ g_{2})&lt;\frac{\epsilon}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup></mrow><mo>,</mo><mrow><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(F^{\rm FF}_{2}\circ F^{\rm SA}\circ F^{\rm FF}_{1},F^{\rm FF}_{2}\circ F^{\rm SA}\circ g_{2})&lt;\frac{\epsilon}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p11.3" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p11.3.1" class="ltx_text">By choosing granularity <math id="A2.SS3.SSS0.Px2.p11.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> large enough, <math id="A2.SS3.SSS0.Px2.p11.m4" class="ltx_Math" alttext="|\mathbb{G}_{D}\backslash\mathbb{G}_{D}^{\rm norm}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝔾</mi><mi>D</mi></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathbb{G}_{D}\backslash\mathbb{G}_{D}^{\rm norm}|</annotation></semantics></math> is negligible.
Then we have for large enough <math id="A2.SS3.SSS0.Px2.p11.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px2.p11.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>,</span></p>
<table id="A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_Math" alttext="\displaystyle d_{F}(F^{\rm FF}_{2}\circ F^{\rm SA}\circ g_{2},g_{1})&lt;\frac{\epsilon}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>3</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(F^{\rm FF}_{2}\circ F^{\rm SA}\circ g_{2},g_{1})&lt;\frac{\epsilon}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p11.4" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p11.4.1" class="ltx_text">Altogether, summing up the error we have:</span></p>
<table id="A2.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex64.m1" class="ltx_Math" alttext="\displaystyle d_{F}(f(Z),g(Z))&lt;\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(f(Z),g(Z))&lt;\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p11.5" class="ltx_p"><span id="A2.SS3.SSS0.Px2.p11.5.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Parameter Norm Bounds of Transformer Approximator.</h5>

<div id="A2.SS3.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p1.1" class="ltx_p">Next, we compute the norm bound of the approximator transformer in <a href="#A2.Thmtheorem1" title="Theorem B.1 (Transformer Universal Approximation, Theorem H.2 of ( , )). ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>.
This theorem is modified from of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>, Lemma H.4)</cite>.
The main difference is that we also take polynomial factor of <math id="A2.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> into the final result instead of neglecting it, while other parts of computation is similar.</p>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Parameter Norm Bound for Approximator Transformer, Modified from Lemma H.4 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>)</cite>)<span id="A2.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p">Let <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\epsilon\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,1)</annotation></semantics></math>.
Consider <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="Z\in[-I,I]^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z\in[-I,I]^{d\times L}</annotation></semantics></math> be input sequence, where <math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="I&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">I&gt;0</annotation></semantics></math> and <math id="A2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="L&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L&gt;2</annotation></semantics></math>.
Let Let <math id="A2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="f(Z):[-I,I]^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f(Z):[-I,I]^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> be a Lipschitz continuous function with respect to Frobenius norm on a bounded domain.
Then for the approximator <math id="A2.Thmtheorem2.p1.m6" class="ltx_Math" alttext="g(Z)=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2}\in\mathcal{T}^{h,s,r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>F</mi><mi>SA</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>h</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">g(Z)=F^{\rm FF}_{1}\circ F^{\rm SA}\circ F^{\rm FF}_{2}\in\mathcal{T}^{h,s,r}</annotation></semantics></math> in <a href="#A2.Thmtheorem1" title="Theorem B.1 (Transformer Universal Approximation, Theorem H.2 of ( , )). ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> within <math id="A2.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> precision, i.e., <math id="A2.Thmtheorem2.p1.m8" class="ltx_Math" alttext="d_{F}(f,g)&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">d_{F}(f,g)&lt;\epsilon</annotation></semantics></math>, the parameter bound in the transformer network class follow:</p>
<table id="A2.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex65.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ C_{KQ},C^{2,\infty}_{KQ}=O(I^{4d+2}\epsilon^{-4d-2}L^{2d+1}\log L);C_{OV},C^{2,\infty}_{OV}=O(\epsilon L^{-1/2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo>,</mo><msubsup><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>I</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup><msup><mi>ϵ</mi><mrow><mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>−</mo><mn>2</mn></mrow></msup><msup><mi>L</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup><mi>log</mi><mi>L</mi><mo stretchy="false">)</mo></mrow><mo>;</mo><msub><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><mo>,</mo><msubsup><mi>C</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ C_{KQ},C^{2,\infty}_{KQ}=O(I^{4d+2}\epsilon^{-4d-2}L^{2d+1}\log L);C_{OV},C^{2,\infty}_{OV}=O(\epsilon L^{-1/2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m1" class="ltx_Math" alttext="\displaystyle\penalty\ C_{F},C^{2,\infty}_{F}=O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F});C_{E}=O(L)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>C</mi><mi>F</mi></msub><mo>,</mo><msubsup><mi>C</mi><mi>F</mi><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>max</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo><mrow><msub><mi>C</mi><mi>E</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ C_{F},C^{2,\infty}_{F}=O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F});C_{E}=O(L),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p1.2" class="ltx_p">where <math id="A2.Thmtheorem2.p1.m9" class="ltx_Math" alttext="O(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\cdot)</annotation></semantics></math> hides polynomial factors depending on <math id="A2.Thmtheorem2.p1.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.SS3.SSS0.Px3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p2.1" class="ltx_p"><span id="A2.SS3.SSS0.Px3.p2.1.1" class="ltx_text">The proof is modified from proof of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>, Lemma H.4)</cite>.</span></p>
</div>
<div id="A2.SS3.SSS0.Px3.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p3.1" class="ltx_p"><span id="A2.SS3.SSS0.Px3.p3.1.1" class="ltx_text">Recall that we take sufficiently large <math id="A2.SS3.SSS0.Px3.p3.m1" class="ltx_Math" alttext="D,R" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>,</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">D,R</annotation></semantics></math> and sufficiently small <math id="A2.SS3.SSS0.Px3.p3.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> in proof of <a href="#A2.Thmtheorem1" title="Theorem B.1 (Transformer Universal Approximation, Theorem H.2 of ( , )). ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> to ensure the precision.
We then start with bounding <math id="A2.SS3.SSS0.Px3.p3.m3" class="ltx_Math" alttext="D,R,\delta" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">D,R,\delta</annotation></semantics></math> in terms of <math id="A2.SS3.SSS0.Px3.p3.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS0.Px3.p4" class="ltx_para ltx_noindent">
<ul id="A2.I6" class="ltx_itemize">
<li id="A2.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I6.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I6.i1.p1.1" class="ltx_p"><span id="A2.I6.i1.p1.1.1" class="ltx_text ltx_font_bold">Bound on <math id="A2.I6.i1.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</span>
Recall the approximation in (<a href="#A2.E1" title="Equation B.1 ‣ 1st item ‣ Proof. ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>) and (<a href="#A2.Ex55" title="In 2nd item ‣ Proof. ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>).
To guarantee the effect of grid, we hope partition <math id="A2.I6.i1.p1.m2" class="ltx_Math" alttext="(i/D,i/D+\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>/</mo><mi>D</mi></mrow><mo>,</mo><mrow><mrow><mi>i</mi><mo>/</mo><mi>D</mi></mrow><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i/D,i/D+\delta)</annotation></semantics></math> is a contained in the interval <math id="A2.I6.i1.p1.m3" class="ltx_Math" alttext="(i/D,(i+1)/D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>/</mo><mi>D</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i/D,(i+1)/D)</annotation></semantics></math> where <math id="A2.I6.i1.p1.m4" class="ltx_Math" alttext="i\in\mathbb{Z}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msup><mi>ℤ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}^{+}</annotation></semantics></math>.
Then it’s sufficient to take <math id="A2.I6.i1.p1.m5" class="ltx_Math" alttext="\delta=o(1/D)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta=o(1/D)</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I6.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I6.i2.p1.1" class="ltx_p"><span id="A2.I6.i2.p1.1.1" class="ltx_text ltx_font_bold">Bound on <math id="A2.I6.i2.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.</span>
For Lipschitz continuous function <math id="A2.I6.i2.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> with respect to Frobenius norm with Lipschitz constant <math id="A2.I6.i2.p1.m3" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>, we have</p>
<table id="A2.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex67.m1" class="ltx_Math" alttext="\displaystyle d_{F}(f(Z),g_{1}(Z))\leq L_{f}\|Z-Z^{*}\|_{F}\leq 2\sqrt{dL}L_{f}/D," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>Z</mi><mo>−</mo><msup><mi>Z</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>/</mo><mi>D</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle d_{F}(f(Z),g_{1}(Z))\leq L_{f}\|Z-Z^{*}\|_{F}\leq 2\sqrt{dL}L_{f}/D,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I6.i2.p1.2" class="ltx_p">where <math id="A2.I6.i2.p1.m4" class="ltx_math_unparsed" alttext="Z^{*}={\rm argmin}_{Z^{\prime}\in\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}}\|Z-Z^{\prime}\|_{F}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>=</mo><mi>argmin</mi><msub><mrow></mrow><mrow><mi>Z</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mtext class="undefined">\macc@depth</mtext><mi>Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><msub><mrow></mrow><mi>D</mi></msub></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>Z</mi><mo>−</mo><mi>Z</mi><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0em">∥</mo><msub><mrow></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">Z^{*}={\rm argmin}_{Z^{\prime}\in\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}}\|Z-Z^{\prime}\|_{F}</annotation></semantics></math>.
Then we take <math id="A2.I6.i2.p1.m5" class="ltx_Math" alttext="D=O(\epsilon^{-1}\sqrt{L})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>L</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D=O(\epsilon^{-1}\sqrt{L})</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I6.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I6.i3.p1.1" class="ltx_p"><span id="A2.I6.i3.p1.1.1" class="ltx_text ltx_font_bold">Bound on <math id="A2.I6.i3.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>.</span>
To obtain the correct labeling in (<a href="#A2.Ex60" title="In Proof. ‣ Universal Approximation of Transformer. ‣ B.3 Universal Approximation of Transformers ‣ Appendix B Supplementary Background: Transformer Block ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>), we need <math id="A2.I6.i3.p1.m2" class="ltx_Math" alttext="S_{t,k}:=Z_{t,k}-C_{t,k}\in(0,1/R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{t,k}:=Z_{t,k}-C_{t,k}\in(0,1/R)</annotation></semantics></math> for all <math id="A2.I6.i3.p1.m3" class="ltx_Math" alttext="t\in[d],k\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in[d],k\in[L]</annotation></semantics></math>.
Then since <math id="A2.I6.i3.p1.m4" class="ltx_Math" alttext="C_{t,k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">C_{t,k}</annotation></semantics></math> is defined on <math id="A2.I6.i3.p1.m5" class="ltx_Math" alttext="\mathbb{G}^{\rm norm}_{D}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔾</mi><mi>D</mi><mi>norm</mi></msubsup><annotation encoding="application/x-tex">\mathbb{G}^{\rm norm}_{D}</annotation></semantics></math> with granularity <math id="A2.I6.i3.p1.m6" class="ltx_Math" alttext="2DI" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">2DI</annotation></semantics></math> and is chosen close enough to <math id="A2.I6.i3.p1.m7" class="ltx_Math" alttext="Z_{t,k}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">Z_{t,k}</annotation></semantics></math>, it suffices to set <math id="A2.I6.i3.p1.m8" class="ltx_Math" alttext="R=O(DI)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=O(DI)</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A2.SS3.SSS0.Px3.p5" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p5.1" class="ltx_p"><span id="A2.SS3.SSS0.Px3.p5.1.1" class="ltx_text">Next, we get the norm bound of matrices on the basis of computation above.
Since the <math id="A2.SS3.SSS0.Px3.p5.m1" class="ltx_Math" alttext="F^{\rm SA}" display="inline" intent=":literal"><semantics><msup><mi>F</mi><mi>SA</mi></msup><annotation encoding="application/x-tex">F^{\rm SA}</annotation></semantics></math> is a single head self-attention layer, we directly write <math id="A2.SS3.SSS0.Px3.p5.m2" class="ltx_Math" alttext="W_{K}^{1},W_{Q}^{1},W_{V}^{1},W_{O}^{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>K</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>W</mi><mi>Q</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>W</mi><mi>V</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>W</mi><mi>O</mi><mn>1</mn></msubsup></mrow><annotation encoding="application/x-tex">W_{K}^{1},W_{Q}^{1},W_{V}^{1},W_{O}^{1}</annotation></semantics></math> as <math id="A2.SS3.SSS0.Px3.p5.m3" class="ltx_Math" alttext="W_{K},W_{Q},W_{V},W_{O}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>,</mo><msub><mi>W</mi><mi>Q</mi></msub><mo>,</mo><msub><mi>W</mi><mi>V</mi></msub><mo>,</mo><msub><mi>W</mi><mi>O</mi></msub></mrow><annotation encoding="application/x-tex">W_{K},W_{Q},W_{V},W_{O}</annotation></semantics></math> for simplicity of notations.</span></p>
</div>
<div id="A2.SS3.SSS0.Px3.p6" class="ltx_para">
<ul id="A2.I7" class="ltx_itemize">
<li id="A2.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I7.i1.p1.1" class="ltx_p"><span id="A2.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">Bound on Norm of <math id="A2.I7.i1.p1.m1" class="ltx_Math" alttext="W_{KQ}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><annotation encoding="application/x-tex">W_{KQ}</annotation></semantics></math>.</span>
Recall that in the proof of Theorem H.1 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>)</cite>, <math id="A2.I7.i1.p1.m2" class="ltx_Math" alttext="W_{K}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>K</mi></msub><annotation encoding="application/x-tex">W_{K}</annotation></semantics></math> and <math id="A2.I7.i1.p1.m3" class="ltx_Math" alttext="W_{Q}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">W_{Q}</annotation></semantics></math> follows the construction of</p>
<table id="A2.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle W_{K}=\sum_{i=1}^{\rho}p_{i}q_{i}^{\top}\in\mathbb{R}^{s\times d},W_{Q}=\sum_{i=1}^{\rho}p_{i}^{\prime}q_{i}^{\prime\top}\in\mathbb{R}^{s\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>ρ</mi></munderover></mstyle><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo><mrow><msub><mi>W</mi><mi>Q</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>ρ</mi></munderover></mstyle><mrow><msubsup><mi>p</mi><mi>i</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>i</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle W_{K}=\sum_{i=1}^{\rho}p_{i}q_{i}^{\top}\in\mathbb{R}^{s\times d},W_{Q}=\sum_{i=1}^{\rho}p_{i}^{\prime}q_{i}^{\prime\top}\in\mathbb{R}^{s\times d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i1.p1.2" class="ltx_p">where <math id="A2.I7.i1.p1.m4" class="ltx_Math" alttext="p_{i}^{\top}p_{i}^{\prime}=(|\mathcal{V|}+1)^{4}d\log L/(\epsilon_{s}\gamma_{\rm min})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>p</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{i}^{\top}p_{i}^{\prime}=(|\mathcal{V|}+1)^{4}d\log L/(\epsilon_{s}\gamma_{\rm min})</annotation></semantics></math>.
Then we have</p>
<table id="A2.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \|W_{KQ}\|_{2}\leq\|W_{KQ}\|_{F}=\|W_{K}^{\top}W_{Q}\|_{F}=O(\frac{4\log L|V|^{4}}{\epsilon_{s}\gamma_{\rm min}})," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>W</mi><mi>K</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>4</mn></msup></mrow><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>min</mi></msub></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{KQ}\|_{2}\leq\|W_{KQ}\|_{F}=\|W_{K}^{\top}W_{Q}\|_{F}=O(\frac{4\log L|V|^{4}}{\epsilon_{s}\gamma_{\rm min}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \|W_{KQ}\|_{2,\infty}=\|W_{K}^{\top}W_{Q}\|_{2,\infty}=O(\frac{4\log L|V|^{4}}{\epsilon_{s}\gamma_{\rm min}})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>W</mi><mi>K</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow><mn>4</mn></msup></mrow><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>min</mi></msub></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{KQ}\|_{2,\infty}=\|W_{K}^{\top}W_{Q}\|_{2,\infty}=O(\frac{4\log L|V|^{4}}{\epsilon_{s}\gamma_{\rm min}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i1.p1.3" class="ltx_p">Recall that input <math id="A2.I7.i1.p1.m5" class="ltx_math_unparsed" alttext="\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}" display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\macc@depth</mtext><mi>Δ</mi><mtext class="undefined">\macc@set@skewchar</mtext><mtext class="undefined">\macc@nested@a</mtext><mn>111</mn><msub><mrow></mrow><mi>D</mi></msub></mrow><annotation encoding="application/x-tex">\macc@depth\char 1\relax\macc@set@skewchar\macc@nested@a 111{}_{D}</annotation></semantics></math> is a token class with token-wise <math id="A2.I7.i1.p1.m6" class="ltx_Math" alttext="((2ID)^{-1},\sqrt{d},(2ID)^{-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msqrt><mi>d</mi></msqrt><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((2ID)^{-1},\sqrt{d},(2ID)^{-1})</annotation></semantics></math>-separated sequence.
Then <math id="A2.I7.i1.p1.m7" class="ltx_Math" alttext="|V|=O((DI)^{d})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|V|=O((DI)^{d})</annotation></semantics></math> and <math id="A2.I7.i1.p1.m8" class="ltx_Math" alttext="\gamma_{\rm min},\epsilon_{s}=(2DI)^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>min</mi></msub><mo>,</mo><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{\rm min},\epsilon_{s}=(2DI)^{-1}</annotation></semantics></math>.
Finally, by <math id="A2.I7.i1.p1.m9" class="ltx_Math" alttext="D=O(\epsilon^{-1}\sqrt{L})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>L</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D=O(\epsilon^{-1}\sqrt{L})</annotation></semantics></math>, we get</p>
<table id="A2.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\displaystyle\|W_{KQ}\|_{2},\|W_{KQ}\|_{2,\infty}=O(\epsilon^{-4d-2}I^{4d+2}L^{2d+1}\log L)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>I</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|W_{KQ}\|_{2},\|W_{KQ}\|_{2,\infty}=O(\epsilon^{-4d-2}I^{4d+2}L^{2d+1}\log L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I7.i2.p1.1" class="ltx_p"><span id="A2.I7.i2.p1.1.1" class="ltx_text ltx_font_bold">Bound on Norm of <math id="A2.I7.i2.p1.m1" class="ltx_Math" alttext="W_{OV}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><annotation encoding="application/x-tex">W_{OV}</annotation></semantics></math>.</span>
Recall that in the proof of Theorem H.1 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Su et al., 2025</a>)</cite>, <math id="A2.I7.i2.p1.m2" class="ltx_Math" alttext="W_{O}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>O</mi></msub><annotation encoding="application/x-tex">W_{O}</annotation></semantics></math> and <math id="A2.I7.i2.p1.m3" class="ltx_Math" alttext="W_{V}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>V</mi></msub><annotation encoding="application/x-tex">W_{V}</annotation></semantics></math> follows the construction of</p>
<table id="A2.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_math_unparsed" alttext="\displaystyle W_{O}=\sum_{i=1}^{\rho}p_{i}^{\prime\prime}q_{i}^{\prime\prime\top}\in\mathbb{R}^{s\times d},W_{V}=\sum_{i=1}^{\rho}p_{i}^{\prime\prime\prime\prime}p_{i}^{\prime\prime\top}\in\mathbb{R}^{d\times s}," display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>ρ</mi></msup><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>′′</mo></msup><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0.111em">′</mo><mo lspace="0.111em">⊤</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>,</mo><mi>W</mi><msub><mrow></mrow><mi>V</mi></msub><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>ρ</mi></msup><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo lspace="0em">′</mo></mrow></msup><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0.111em">′</mo><mo lspace="0.111em">⊤</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>s</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle W_{O}=\sum_{i=1}^{\rho}p_{i}^{\prime\prime}q_{i}^{\prime\prime\top}\in\mathbb{R}^{s\times d},W_{V}=\sum_{i=1}^{\rho}p_{i}^{\prime\prime\prime\prime}p_{i}^{\prime\prime\top}\in\mathbb{R}^{d\times s},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i2.p1.2" class="ltx_p">where <math id="A2.I7.i2.p1.m4" class="ltx_Math" alttext="\|p_{i}^{\prime\prime\prime}\|\lesssim\epsilon_{s}/(4\rho\gamma_{\rm max}\|p_{i}^{\prime\prime}\|)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msubsup><mi>p</mi><mi>i</mi><mo>′′′</mo></msubsup><mo stretchy="false">‖</mo></mrow><mo>≲</mo><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msubsup><mi>p</mi><mi>i</mi><mo>′′</mo></msubsup><mo stretchy="false">‖</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|p_{i}^{\prime\prime\prime}\|\lesssim\epsilon_{s}/(4\rho\gamma_{\rm max}\|p_{i}^{\prime\prime}\|)</annotation></semantics></math> and <math id="A2.I7.i2.p1.m5" class="ltx_Math" alttext="p_{i}^{\prime\prime}\in\mathbb{R}^{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>i</mi><mo>′′</mo></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">p_{i}^{\prime\prime}\in\mathbb{R}^{s}</annotation></semantics></math> is any nonzero vector.
Then with the <math id="A2.I7.i2.p1.m6" class="ltx_Math" alttext="(\gamma_{\rm min}=1/D,\gamma_{\rm max}=\sqrt{d},\epsilon_{s}=1/D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>γ</mi><mi>min</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow></mrow><mo>,</mo><mrow><msub><mi>γ</mi><mi>max</mi></msub><mo>=</mo><msqrt><mi>d</mi></msqrt></mrow><mo>,</mo><mrow><msub><mi>ϵ</mi><mi>s</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma_{\rm min}=1/D,\gamma_{\rm max}=\sqrt{d},\epsilon_{s}=1/D)</annotation></semantics></math>-separateness and <math id="A2.I7.i2.p1.m7" class="ltx_Math" alttext="D=O(\epsilon^{-1}\sqrt{L}),\rho&lt;d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>L</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>ρ</mi><mo>&lt;</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">D=O(\epsilon^{-1}\sqrt{L}),\rho&lt;d</annotation></semantics></math>, we get:</p>
<table id="A2.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \|W_{V}\|_{2}=\sup_{\|x\|_{2}=1}\|W_{V}x\|_{2}\leq O(\sqrt{\rho})\leq O(\sqrt{d})," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>V</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>ρ</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>d</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{V}\|_{2}=\sup_{\|x\|_{2}=1}\|W_{V}x\|_{2}\leq O(\sqrt{\rho})\leq O(\sqrt{d}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ \|W_{V}\|_{2,\infty}=\max_{1\leq i\leq d}\|(W_{V})_{(i,:)}\|_{2}\leq O(\rho)\leq O(d)," display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>W</mi><mi>V</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0.0835em">=</mo><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>V</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{V}\|_{2,\infty}=\max_{1\leq i\leq d}\|(W_{V})_{(i,:)}\|_{2}\leq O(\rho)\leq O(d),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex75.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ \|W_{O}\|_{2}=\sup_{\|x\|_{2}=1}\|W_{O}x\|_{2}\leq O(\sqrt{\rho}\cdot\rho^{-1}\cdot\gamma^{-1}_{\rm max}\cdot\epsilon_{s})=O(d^{-1}\epsilon L^{-1/2})," display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>W</mi><mi>O</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>W</mi><mi>O</mi></msub><mi>x</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msqrt><mi>ρ</mi></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>ρ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>γ</mi><mi>max</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>ϵ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>ϵ</mi><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{O}\|_{2}=\sup_{\|x\|_{2}=1}\|W_{O}x\|_{2}\leq O(\sqrt{\rho}\cdot\rho^{-1}\cdot\gamma^{-1}_{\rm max}\cdot\epsilon_{s})=O(d^{-1}\epsilon L^{-1/2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ \|W_{O}\|_{2,\infty}=\max_{1\leq i\leq d}\|(W_{O})_{(i,:)}\|_{2}\leq O(\rho\cdot\rho^{-1}\cdot\gamma^{-1}_{\rm max}\cdot\epsilon_{s})=O(d^{-1/2}\epsilon L^{-1/2})." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>W</mi><mi>O</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0.0835em">=</mo><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>O</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">)</mo></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>ρ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>γ</mi><mi>max</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>ϵ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ϵ</mi><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|W_{O}\|_{2,\infty}=\max_{1\leq i\leq d}\|(W_{O})_{(i,:)}\|_{2}\leq O(\rho\cdot\rho^{-1}\cdot\gamma^{-1}_{\rm max}\cdot\epsilon_{s})=O(d^{-1/2}\epsilon L^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i2.p1.3" class="ltx_p">Therefore we get:</p>
<table id="A2.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_math_unparsed" alttext="\displaystyle\|W_{OV}\|_{2}=\|W_{O}W_{V}\|_{2}\leq O(\epsilon L^{-1/2}),\|W_{OV}\|_{2,\infty}=\|W_{O}W_{V}\|_{2,\infty}\leq O(\epsilon L^{-1/2})." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>W</mi><mi>O</mi></msub><msub><mi>W</mi><mi>V</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>W</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>W</mi><mi>O</mi></msub><msub><mi>W</mi><mi>V</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0.0835em">≤</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><msup><mi>L</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|W_{OV}\|_{2}=\|W_{O}W_{V}\|_{2}\leq O(\epsilon L^{-1/2}),\|W_{OV}\|_{2,\infty}=\|W_{O}W_{V}\|_{2,\infty}\leq O(\epsilon L^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I7.i3.p1.1" class="ltx_p"><span id="A2.I7.i3.p1.1.1" class="ltx_text ltx_font_bold">Bound on Norm of <math id="A2.I7.i3.p1.m1" class="ltx_Math" alttext="W_{1}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mn>1</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">W_{1}^{1}</annotation></semantics></math> and <math id="A2.I7.i3.p1.m2" class="ltx_Math" alttext="W_{2}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mn>2</mn><mn>1</mn></msubsup><annotation encoding="application/x-tex">W_{2}^{1}</annotation></semantics></math> in <math id="A2.I7.i3.p1.m3" class="ltx_Math" alttext="F^{\rm FF}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F^{\rm FF}_{1}</annotation></semantics></math>.</span>
Recall that in the construction of the first feed-forward layer, we have two key approximator:</p>
<table id="A2.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle f_{1}(z):=-I+\sum_{t=-ID}^{I(D-1)}\frac{\rm RELU[z/\delta-t/\delta D]-\mathop{\mathsf{ReLU}}[z/\delta-1-t/\delta D]}{D}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo>−</mo><mi>I</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mo>−</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow></mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>RELU</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>z</mi><mo>/</mo><mi>δ</mi></mrow><mo>−</mo><mrow><mrow><mi>t</mi><mo>/</mo><mi>δ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>z</mi><mo>/</mo><mi>δ</mi></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mrow><mrow><mi>t</mi><mo>/</mo><mi>δ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mi>D</mi></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{1}(z):=-I+\sum_{t=-ID}^{I(D-1)}\frac{\rm RELU[z/\delta-t/\delta D]-\mathop{\mathsf{ReLU}}[z/\delta-1-t/\delta D]}{D},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i3.p1.2" class="ltx_p">and</p>
<table id="A2.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle f_{2}(z)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle f_{2}(z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(z-I)/\delta]-\mathop{\mathsf{ReLU}}[(z-I)/\delta+1]+" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(z-I)/\delta]-\mathop{\mathsf{ReLU}}[(z-I)/\delta+1]+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(-z-I)/\delta]-\mathop{\mathsf{ReLU}}[(-z-I)/\delta+1]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mi>z</mi></mrow><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mi>z</mi></mrow><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>δ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \mathop{\mathsf{ReLU}}[(-z-I)/\delta]-\mathop{\mathsf{ReLU}}[(-z-I)/\delta+1].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i3.p1.3" class="ltx_p">Then for <math id="A2.I7.i3.p1.m4" class="ltx_Math" alttext="t\in[d],k\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in[d],k\in[L]</annotation></semantics></math>, we approximate each entry of <math id="A2.I7.i3.p1.m5" class="ltx_Math" alttext="g_{1}(Z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{1}(Z)</annotation></semantics></math> with</p>
<table id="A2.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle F^{\rm FF}_{1}(Z)_{t,k}=\frac{f_{1}(Z_{t,k})+I}{2I}+f_{2}(Z_{t,k})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>F</mi><mn>1</mn><mi>FF</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>I</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle F^{\rm FF}_{1}(Z)_{t,k}=\frac{f_{1}(Z_{t,k})+I}{2I}+f_{2}(Z_{t,k}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i3.p1.4" class="ltx_p">That’s to say, each element in <math id="A2.I7.i3.p1.m6" class="ltx_Math" alttext="W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">W_{1}</annotation></semantics></math> and <math id="A2.I7.i3.p1.m7" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math> is bounded by <math id="A2.I7.i3.p1.m8" class="ltx_Math" alttext="1/\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1/\delta</annotation></semantics></math> and <math id="A2.I7.i3.p1.m9" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>.
Recall that <math id="A2.I7.i3.p1.m10" class="ltx_Math" alttext="\delta=o(1/D)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta=o(1/D)</annotation></semantics></math> and <math id="A2.I7.i3.p1.m11" class="ltx_Math" alttext="D=O(\epsilon^{-1}\sqrt{L})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>L</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D=O(\epsilon^{-1}\sqrt{L})</annotation></semantics></math>, we have</p>
<table id="A2.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle\max\{\|W_{1}^{1}\|_{2},\|W_{2}^{1}\|_{2}\}\leq O(\epsilon^{-1}L),\max\{\|W_{1}^{1}\|_{2,\infty},\|W_{2}^{1}\|_{2,\infty}\}\leq O(\epsilon^{-1}L)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>1</mn><mn>1</mn></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>2</mn><mn>1</mn></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>1</mn><mn>1</mn></msubsup><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>2</mn><mn>1</mn></msubsup><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\max\{\|W_{1}^{1}\|_{2},\|W_{2}^{1}\|_{2}\}\leq O(\epsilon^{-1}L),\max\{\|W_{1}^{1}\|_{2,\infty},\|W_{2}^{1}\|_{2,\infty}\}\leq O(\epsilon^{-1}L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i4.p1" class="ltx_para ltx_noindent">
<p id="A2.I7.i4.p1.1" class="ltx_p"><span id="A2.I7.i4.p1.1.1" class="ltx_text ltx_font_bold">Bound on Norm of <math id="A2.I7.i4.p1.m1" class="ltx_Math" alttext="W_{1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mn>1</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">W_{1}^{2}</annotation></semantics></math> and <math id="A2.I7.i4.p1.m2" class="ltx_Math" alttext="W_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">W_{2}^{2}</annotation></semantics></math> in <math id="A2.I7.i4.p1.m3" class="ltx_Math" alttext="F^{\rm FF}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F^{\rm FF}_{2}</annotation></semantics></math>.</span>
Recall that in the construction of the second feed-forward layer, we construct <math id="A2.I7.i4.p1.m4" class="ltx_Math" alttext="F^{\rm FF}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F^{\rm FF}_{2}</annotation></semantics></math> through bump function:</p>
<table id="A2.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle{\rm bump}_{R}(Z)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>bump</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\rm bump}_{R}(Z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{f(2C-I)}{dL}\sum_{t=1}^{d}\sum_{k=1}^{L}({\rm RELU[R(Z_{t,k}-C_{t,k})-1]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>−</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mi>RELU</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{f(2C-I)}{dL}\sum_{t=1}^{d}\sum_{k=1}^{L}({\rm RELU[R(Z_{t,k}-C_{t,k})-1]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ -\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})]+\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})+1])." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mo lspace="0em" movablelimits="false" rspace="0em">𝖱𝖾𝖫𝖴</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>C</mi><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ -\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})]+\mathop{\mathsf{ReLU}}[R(Z_{t,k}-C_{t,k})+1]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i4.p1.2" class="ltx_p">Therefore, the output of <math id="A2.I7.i4.p1.m5" class="ltx_Math" alttext="F^{\rm FF}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mn>2</mn><mi>FF</mi></msubsup><annotation encoding="application/x-tex">F^{\rm FF}_{2}</annotation></semantics></math> is bounded by <math id="A2.I7.i4.p1.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> and <math id="A2.I7.i4.p1.m7" class="ltx_Math" alttext="\max\|f(Z)\|_{F}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\max\|f(Z)\|_{F}</annotation></semantics></math>.
Then by <math id="A2.I7.i4.p1.m8" class="ltx_Math" alttext="R=O(DI)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=O(DI)</annotation></semantics></math> and <math id="A2.I7.i4.p1.m9" class="ltx_Math" alttext="D=O(\epsilon^{-1}\sqrt{L})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>L</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D=O(\epsilon^{-1}\sqrt{L})</annotation></semantics></math>, we have:</p>
<table id="A2.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \max\{\|W_{1}^{2}\|_{2},\|W_{2}^{2}\|_{2}\}\leq O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>1</mn><mn>2</mn></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>max</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \max\{\|W_{1}^{2}\|_{2},\|W_{2}^{2}\|_{2}\}\leq O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \max\{\|W_{1}^{2}\|_{2,\infty},\|W_{2}^{2}\|_{2,\infty}\}\leq O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>1</mn><mn>2</mn></msubsup><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>W</mi><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>max</mi><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \max\{\|W_{1}^{2}\|_{2,\infty},\|W_{2}^{2}\|_{2,\infty}\}\leq O(I\epsilon^{-1}L\cdot\max\|f(Z)\|_{F}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i5.p1" class="ltx_para">
<p id="A2.I7.i5.p1.1" class="ltx_p"><span id="A2.I7.i5.p1.1.1" class="ltx_text ltx_font_bold">Bound on Norm of Encoding Matrix <math id="A2.I7.i5.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>.</span>
By Corollary 2 of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Kajitsuka and Sato, 2023</a>)</cite>, it suffices to take the encoding matrix <math id="A2.I7.i5.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>:</p>
<table id="A2.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\displaystyle E=\begin{bmatrix}2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\\
2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\\
\vdots&amp;\vdots&amp;&amp;\vdots\\
2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\end{bmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle E=\begin{bmatrix}2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\\
2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\\
\vdots&amp;\vdots&amp;&amp;\vdots\\
2\gamma_{\rm max}&amp;4\gamma_{\rm max}&amp;\dots&amp;2L\gamma_{\rm max}\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i5.p1.2" class="ltx_p">Recall that we have <math id="A2.I7.i5.p1.m3" class="ltx_Math" alttext="\gamma_{\rm max}=\sqrt{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>max</mi></msub><mo>=</mo><msqrt><mi>d</mi></msqrt></mrow><annotation encoding="application/x-tex">\gamma_{\rm max}=\sqrt{d}</annotation></semantics></math>, then we obtain:</p>
<table id="A2.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex88.m1" class="ltx_Math" alttext="\displaystyle\|E^{\top}\|_{2,\infty}=\sqrt{4dL^{2}}\gamma_{\rm max}=O(L)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>E</mi><mo>⊤</mo></msup><mo stretchy="false">‖</mo></mrow><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo>=</mo><mrow><msqrt><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>max</mi></msub></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|E^{\top}\|_{2,\infty}=\sqrt{4dL^{2}}\gamma_{\rm max}=O(L).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A2.SS3.SSS0.Px3.p6.1" class="ltx_p"><span id="A2.SS3.SSS0.Px3.p6.1.1" class="ltx_text">This complete the proof.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Proof of <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Error Bound for Discrete Flow Matching). ‣ 3 Error Bounds for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a></h3>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">This section provides the proof of <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Error Bound for Discrete Flow Matching). ‣ 3 Error Bounds for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>.</p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p"><span id="A3.p2.1.1" class="ltx_text ltx_font_bold">Organization.</span>
Due to the complexity of the proof, our proof proceeds in two steps: (i) First, in <a href="#A3.Thmlemma2" title="Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a>, we establish a key intermediate result by presenting the distribution error in terms of the velocity error.
(ii) Second, building upon this lemma, we present the final proof of <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Error Bound for Discrete Flow Matching). ‣ 3 Error Bounds for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> in <a href="#A3.Thmtheorem2" title="Theorem C.2 (Error Bounds for Discrete Flow Matching with Factorized Velocity, Restate). ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.2</span></a> by applying Grönwall’s Inequality.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Preliminaries</h4>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">Total Variation Distance is a distance function defined between probability distributions.
We start with the definition of total variation distance as below.</p>
</div>
<div id="A3.Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition C.1</span></span><span id="A3.Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Total Variation Distance)<span id="A3.Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmdefinition1.p1" class="ltx_para">
<p id="A3.Thmdefinition1.p1.1" class="ltx_p">Let <math id="A3.Thmdefinition1.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="A3.Thmdefinition1.p1.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> be two probability distributions defined on a discrete state space <math id="A3.Thmdefinition1.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, with corresponding probability mass functions <math id="A3.Thmdefinition1.p1.m4" class="ltx_Math" alttext="p(x)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(x)</annotation></semantics></math> and <math id="A3.Thmdefinition1.p1.m5" class="ltx_Math" alttext="q(x)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(x)</annotation></semantics></math>.
Then the total variation (TV) distance between them is defined as:</p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex1.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,Q):=\frac{1}{2}\sum_{x\in S}|p(x)-q(x)|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,Q):=\frac{1}{2}\sum_{x\in S}|p(x)-q(x)|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p">Our analysis relies on Grönwall’s Inequality.
It is a fundamental tool for establishing bounds on the solutions of ordinary differential equations (ODEs).</p>
</div>
<div id="A3.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Grönwall’s Inequality, <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib15" title="" class="ltx_ref">Gronwall, 1919</a>)</cite>)<span id="A3.Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma1.p1" class="ltx_para">
<p id="A3.Thmlemma1.p1.1" class="ltx_p">Let <math id="A3.Thmlemma1.p1.m1" class="ltx_Math" alttext="a,b\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">a,b\in\mathbb{R}</annotation></semantics></math> satisfy <math id="A3.Thmlemma1.p1.m2" class="ltx_Math" alttext="a&lt;b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a&lt;b</annotation></semantics></math>.
Let <math id="A3.Thmlemma1.p1.m3" class="ltx_Math" alttext="y(t)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y(t)</annotation></semantics></math> and <math id="A3.Thmlemma1.p1.m4" class="ltx_Math" alttext="f(t)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(t)</annotation></semantics></math> be two real value function defined on <math id="A3.Thmlemma1.p1.m5" class="ltx_Math" alttext="[a,b]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[a,b]</annotation></semantics></math>.
Suppose that <math id="A3.Thmlemma1.p1.m6" class="ltx_Math" alttext="y(t)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y(t)</annotation></semantics></math> is differentiable on <math id="A3.Thmlemma1.p1.m7" class="ltx_Math" alttext="[a,b]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[a,b]</annotation></semantics></math> and satisfies:</p>
<table id="A3.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex2.m1" class="ltx_Math" alttext="\displaystyle\frac{\differential}{\differential t}y(t)\leq y(t)f(t),t\in[a,b]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\differential}{\differential t}y(t)\leq y(t)f(t),t\in[a,b].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmlemma1.p1.2" class="ltx_p">Then we have:</p>
<table id="A3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex3.m1" class="ltx_Math" alttext="\displaystyle y(b)\leq y(a)\exp(\int_a^b f(s) \dd s)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>a</mi><mi>b</mi></msubsup></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle y(b)\leq y(a)\exp(\int_a^b f(s) \dd s).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS1.p3.1" class="ltx_p">To analyze the distribution error, we first express the DFM framework in the language of linear algebra.
Let the discrete state space be indexed as <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="S=\{w_{1},\ldots,w_{|S|}\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>w</mi><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{w_{1},\ldots,w_{|S|}\}</annotation></semantics></math>.
We represent the ground-truth probability mass function <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="p_{t}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t}(x)</annotation></semantics></math> and its corresponding estimator <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="p_{t,\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t,\theta}(x)</annotation></semantics></math> as vectors <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="p_{t},p_{t,\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo>,</mo><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">p_{t},p_{t,\theta}</annotation></semantics></math> in <math id="A3.SS1.p3.m5" class="ltx_Math" alttext="\mathbb{R}^{|S|}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{|S|}</annotation></semantics></math>, where <math id="A3.SS1.p3.m6" class="ltx_Math" alttext="p_{t}[i]=p_{t}(w_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{t}[i]=p_{t}(w_{i})</annotation></semantics></math> and <math id="A3.SS1.p3.m7" class="ltx_Math" alttext="p_{t,\theta}[i]=p_{t,\theta}(w_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{t,\theta}[i]=p_{t,\theta}(w_{i})</annotation></semantics></math>.
Similarly, the velocity fields are represented as rates matrices <math id="A3.SS1.p3.m8" class="ltx_Math" alttext="U_{t},U_{t,\theta}\in\mathbb{R}^{|S|\times|S|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U_{t},U_{t,\theta}\in\mathbb{R}^{|S|\times|S|}</annotation></semantics></math>, where the entry <math id="A3.SS1.p3.m9" class="ltx_Math" alttext="[U_{t}]_{ij}=u_{t}(w_{i},w_{j}),[U_{t,\theta}]_{ij}=u_{t,\theta}(w_{i},w_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><msub><mi>U</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo>,</mo><msub><mi>w</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mrow><mo stretchy="false">[</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>u</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo>,</mo><msub><mi>w</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">[U_{t}]_{ij}=u_{t}(w_{i},w_{j}),[U_{t,\theta}]_{ij}=u_{t,\theta}(w_{i},w_{j})</annotation></semantics></math> is the corresponding rate of transition from state <math id="A3.SS1.p3.m10" class="ltx_Math" alttext="w_{j}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>j</mi></msub><annotation encoding="application/x-tex">w_{j}</annotation></semantics></math> to state <math id="A3.SS1.p3.m11" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math>.
With these definitions, we rewrite the Kolmogorov Forward Equation (<a href="#S2.E3" title="Equation 2.3 ‣ 2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>) for both the true and estimated paths into the compact matrix form (<a href="#A3.E1" title="Equation C.1 ‣ Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>).
Then we derive the distribution error bounds in terms of the risk function.</p>
</div>
<div id="A3.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma C.2</span></span><span id="A3.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Variation of Constants Formula for Error)<span id="A3.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma2.p1" class="ltx_para">
<p id="A3.Thmlemma2.p1.1" class="ltx_p">Let the true probability vector <math id="A3.Thmlemma2.p1.m1" class="ltx_Math" alttext="p_{t}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>t</mi></msub><annotation encoding="application/x-tex">p_{t}</annotation></semantics></math> and the estimated vector <math id="A3.Thmlemma2.p1.m2" class="ltx_Math" alttext="p_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">p_{t,\theta}</annotation></semantics></math> be solutions to the linear differential systems</p>
<table id="A3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E1.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}\frac{\differential}{\differential t}p_{t}=U_{t}p_{t},\\
\frac{\differential}{\differential t}p_{t,\theta}=U_{t,\theta}p_{t,\theta},\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\frac{\differential}{\differential t}p_{t}=U_{t}p_{t},\\
\frac{\differential}{\differential t}p_{t,\theta}=U_{t,\theta}p_{t,\theta},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.1)</span></td></tr></tbody>
</table>
<p id="A3.Thmlemma2.p1.2" class="ltx_p">with a shared initial condition <math id="A3.Thmlemma2.p1.m3" class="ltx_Math" alttext="p_{0}=p_{0,\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>=</mo><msub><mi>p</mi><mrow><mn>0</mn><mo>,</mo><mi>θ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">p_{0}=p_{0,\theta}</annotation></semantics></math>.
Let the evolution operator for the estimated system be <math id="A3.Thmlemma2.p1.m4" class="ltx_Math" alttext="\mathcal{P}_{s,t,\theta}\in\mathbb{R}^{|S|\times|S|}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{P}_{s,t,\theta}\in\mathbb{R}^{|S|\times|S|}</annotation></semantics></math>, which is the solution to <math id="A3.Thmlemma2.p1.m5" class="ltx_Math" alttext="\frac{\differential}{\differential t}\mathcal{P}_{s,t,\theta}=U_{t,\theta}\mathcal{P}_{s,t,\theta}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\frac{\differential}{\differential t}\mathcal{P}_{s,t,\theta}=U_{t,\theta}\mathcal{P}_{s,t,\theta}</annotation></semantics></math> with <math id="A3.Thmlemma2.p1.m6" class="ltx_Math" alttext="\mathcal{P}_{s,s,\theta}=I" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\mathcal{P}_{s,s,\theta}=I</annotation></semantics></math>.
The difference between the distributions at time <math id="A3.Thmlemma2.p1.m7" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math> is given by</p>
<table id="A3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex4.m1" class="ltx_Math" alttext="\displaystyle p_{t,\theta}-p_{t}=\int_{0}^{t}\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{t,\theta}-p_{t}=\int_{0}^{t}\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p4" class="ltx_para">
<p id="A3.SS1.p4.1" class="ltx_p"><span id="A3.SS1.p4.1.1" class="ltx_text">We construct the helping function <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="Z(s)" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z(s)</annotation></semantics></math> as:</span></p>
<table id="A3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E2.m1" class="ltx_Math" alttext="\displaystyle Z(s)=\mathcal{P}_{s,t,\theta}p_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Z(s)=\mathcal{P}_{s,t,\theta}p_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.2)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p4.2" class="ltx_p"><span id="A3.SS1.p4.2.1" class="ltx_text">Then since <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{P}_{s,t,\theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{P}_{s,t,\theta}</annotation></semantics></math> and <math id="A3.SS1.p4.m3" class="ltx_Math" alttext="p_{s}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>s</mi></msub><annotation encoding="application/x-tex">p_{s}</annotation></semantics></math> is differentiable, we have:</span></p>
<table id="A3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\frac{\differential}{\differential s}Z(s)=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\differential}{\differential s}Z(s)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex5.m2" class="ltx_Math" alttext="\displaystyle\penalty\ (\frac{\differential}{\differential s}\mathcal{P}_{s,t,\theta})p_{s}+\mathcal{P}_{s,t,\theta}(\frac{\differential}{\differential s}p_{s})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ (\frac{\differential}{\differential s}\mathcal{P}_{s,t,\theta})p_{s}+\mathcal{P}_{s,t,\theta}(\frac{\differential}{\differential s}p_{s})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex5.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex5.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A3.E2" title="Equation C.2 ‣ Proof. ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex6.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex6.m2" class="ltx_Math" alttext="\displaystyle\penalty\ (-\mathcal{P}_{s,t,\theta}U_{s,\theta})p_{s}+\mathcal{P}_{s,t,\theta}(U_{s}p_{s})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ (-\mathcal{P}_{s,t,\theta}U_{s,\theta})p_{s}+\mathcal{P}_{s,t,\theta}(U_{s}p_{s})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex6.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex6.1.1" class="ltx_text" style="font-size:67%;">By backward Kolmogorov Equation (<a href="#S2.E3" title="Equation 2.3 ‣ 2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>) and (<a href="#A3.E1" title="Equation C.1 ‣ Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E3.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E3.m2" class="ltx_Math" alttext="\displaystyle\penalty\ -\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ -\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.3)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p4.3" class="ltx_p"><span id="A3.SS1.p4.3.1" class="ltx_text">Integrating (<a href="#A3.E3" title="Equation C.3 ‣ Proof. ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>), we obtain:</span></p>
<table id="A3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex7.m1" class="ltx_math_unparsed" alttext="\displaystyle-\int_{0}^{t}\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s=\int_{0}^{t}\frac{\differential}{\differential s}Z(s)\differential s=Z(t)-Z(0)=p_{t}-p_{t,\theta}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">d</mo><mi>s</mi><mo>=</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mfrac></mstyle><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">d</mo><mi>s</mi><mo>=</mo><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>Z</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mi>t</mi></msub><mo>−</mo><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\int_{0}^{t}\mathcal{P}_{s,t,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s=\int_{0}^{t}\frac{\differential}{\differential s}Z(s)\differential s=Z(t)-Z(0)=p_{t}-p_{t,\theta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.4" class="ltx_p"><span id="A3.SS1.p4.4.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Main Proof of <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Error Bound for Discrete Flow Matching). ‣ 3 Error Bounds for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a></h4>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">Before studying the tractable factorized velocity (<a href="#S2" title="2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>) case, we first establish a foundational error bound for the general discrete flow matching framework.
Presenting the universal principle first makes our subsequent, more detailed analysis clearer and more readable.</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Error Bounds for Discrete Flow Matching)<span id="A3.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p">Consider the discrete state space <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathcal{S}=\mathcal{T}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{S}=\mathcal{T}^{d}</annotation></semantics></math>, where the vocabulary is <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathcal{T}=\{1,\ldots,M\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{1,\ldots,M\}</annotation></semantics></math>.
Let <math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> be the true data distribution over <math id="A3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>.
Let <math id="A3.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\widehat{u}_{\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>θ</mi></msub><annotation encoding="application/x-tex">\widehat{u}_{\theta}</annotation></semantics></math> be the velocity estimator, with parameters <math id="A3.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\widehat{\Theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\Theta}</annotation></semantics></math> and let <math id="A3.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\widehat{P}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>P</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{P}</annotation></semantics></math> be the distribution generated using this estimator.
Define the risk of the velocity estimator as</p>
<table id="A3.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}(\widehat{\Theta}):=\int_{0}^{1}\underset{X_{t}\sim p_{t}(x)}{\mathbb{E}}\|u(X_{t},t)-u_{\widehat{\theta}}(X_{t},t)\|_{2}^{2}\differential t," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">X</mi><mi mathsize="0.710em">t</mi></msub><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mover accent="true"><mi>θ</mi><mo>^</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}(\widehat{\Theta}):=\int_{0}^{1}\underset{X_{t}\sim p_{t}(x)}{\mathbb{E}}\|u(X_{t},t)-u_{\widehat{\theta}}(X_{t},t)\|_{2}^{2}\differential t,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p1.2" class="ltx_p">where <math id="A3.Thmtheorem1.p1.m8" class="ltx_Math" alttext="p_{t}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t}(x)</annotation></semantics></math> is the true probability path. Then, the total variation distance between the true and generated distributions is bounded by the risk of this estimator:</p>
<table id="A3.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})\lesssim\exp(M_u)M^{\frac{d}{2}}\sqrt{\mathcal{R}(\widehat{\Theta})}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mfrac><mi>d</mi><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})\lesssim\exp(M_u)M^{\frac{d}{2}}\sqrt{\mathcal{R}(\widehat{\Theta})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p1.3" class="ltx_p">where <math id="A3.Thmtheorem1.p1.m9" class="ltx_Math" alttext="M_{u}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>u</mi></msub><annotation encoding="application/x-tex">M_{u}</annotation></semantics></math> is the upper bound of the true velocity field, satisfying <math id="A3.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\underset{y,x\in S,t\in[0,1]}{\max}|u_{t}(y,x)|\leq M_{u}" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>max</mi><mrow><mrow><mrow><mi mathsize="0.700em">y</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">x</mi></mrow><mo mathsize="0.700em">∈</mo><mi mathsize="0.700em">S</mi></mrow><mo mathsize="0.700em">,</mo><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">∈</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">1</mn></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><msub><mi>M</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">\underset{y,x\in S,t\in[0,1]}{\max}|u_{t}(y,x)|\leq M_{u}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text">Following the definitions in <a href="#A3.Thmlemma2" title="Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a>,
let <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="p_{t}\in\mathbb{R}^{M^{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msup><mi>M</mi><mi>d</mi></msup></msup></mrow><annotation encoding="application/x-tex">p_{t}\in\mathbb{R}^{M^{d}}</annotation></semantics></math> and <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="U_{t}\in\mathbb{R}^{M^{d}\times M^{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>M</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>M</mi><mi>d</mi></msup></mrow></msup></mrow><annotation encoding="application/x-tex">U_{t}\in\mathbb{R}^{M^{d}\times M^{d}}</annotation></semantics></math> be the true probability vector and the true rates matrix.
Let <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="\widehat{p}_{t,\theta}\in\mathbb{R}^{M^{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><msup><mi>M</mi><mi>d</mi></msup></msup></mrow><annotation encoding="application/x-tex">\widehat{p}_{t,\theta}\in\mathbb{R}^{M^{d}}</annotation></semantics></math> and <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="\widehat{U}_{t,\theta}\in\mathbb{R}^{M^{d}\times M^{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>M</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>M</mi><mi>d</mi></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\widehat{U}_{t,\theta}\in\mathbb{R}^{M^{d}\times M^{d}}</annotation></semantics></math> be the estimated probability vectors and rates matrix defined by estimated velocity <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="\widehat{u}_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\widehat{u}_{t,\theta}</annotation></semantics></math>.
Then we have:</span></p>
<table id="A3.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}\frac{\differential}{\differential t}p_{t}=U_{t}p_{t},\\
\frac{\differential}{\differential t}\widehat{p}_{t,\theta}=\widehat{U}_{t,\theta}p_{t,\theta},\\
p_{0}=\widehat{p}_{0,\theta}\sim P_{0}.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>=</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo>∼</mo><msub><mi>P</mi><mn>0</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\frac{\differential}{\differential t}p_{t}=U_{t}p_{t},\\
\frac{\differential}{\differential t}\widehat{p}_{t,\theta}=\widehat{U}_{t,\theta}p_{t,\theta},\\
p_{0}=\widehat{p}_{0,\theta}\sim P_{0}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p3" class="ltx_para">
<p id="A3.SS2.p3.1" class="ltx_p"><span id="A3.SS2.p3.1.1" class="ltx_text">Let evolution operator <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{P}_{s,t,\theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{P}_{s,t,\theta}</annotation></semantics></math> be defined as in <a href="#A3.Thmlemma2" title="Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a>.
Then by definition of total variation distance, we have:</span></p>
<table id="A3.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex11.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})=" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex11.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2}\sum_{x\in S}|p_{1}(x)-p_{1,\theta}(x)|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2}\sum_{x\in S}|p_{1}(x)-p_{1,\theta}(x)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex13.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex13.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2}\|\widehat{p}_{1,\theta}-p_{1}\|_{1}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2}\|\widehat{p}_{1,\theta}-p_{1}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex14.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex14.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2}\|\int_{0}^{1}\mathcal{P}_{s,1,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s\|_{1}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2}\|\int_{0}^{1}\mathcal{P}_{s,1,\theta}(U_{s,\theta}-U_{s})p_{s}\differential s\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex14.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex14.1.1" class="ltx_text" style="font-size:67%;">By <a href="#A3.Thmlemma2" title="Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a></span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex15.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E4.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E4.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}\|_{1}\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}\|_{1}\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.4)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p"><span id="A3.SS2.p3.2.1" class="ltx_text">where the last line follows by <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="\|p_{s}\|_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>p</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|p_{s}\|_{1}=1</annotation></semantics></math> the sub-multiplicative property of norm <math id="A3.SS2.p3.m3" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math>.
To bound <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="\|\mathcal{P}_{s,1,\theta}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\|\mathcal{P}_{s,1,\theta}\|_{F}</annotation></semantics></math>,
we first bound the derivative of <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="\|\mathcal{P}_{s,t,\theta}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\|\mathcal{P}_{s,t,\theta}\|_{F}</annotation></semantics></math>.
Let <math id="A3.SS2.p3.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be the vocabulary size and set the transformer estimator <math id="A3.SS2.p3.m7" class="ltx_Math" alttext="u_{\widehat{\theta}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mover accent="true"><mi>θ</mi><mo>^</mo></mover></msub><annotation encoding="application/x-tex">u_{\widehat{\theta}}</annotation></semantics></math> bound by <math id="A3.SS2.p3.m8" class="ltx_Math" alttext="M_{u}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>u</mi></msub><annotation encoding="application/x-tex">M_{u}</annotation></semantics></math>, then we have</span></p>
<table id="A3.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex17.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial}{\partial t}\|\mathcal{P}_{s,t,\theta}\|_{1}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial}{\partial t}\|\mathcal{P}_{s,t,\theta}\|_{1}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex17.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|\frac{\partial}{\partial t}\mathcal{P}_{s,t,\theta}\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|\frac{\partial}{\partial t}\mathcal{P}_{s,t,\theta}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex18.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex18.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|U_{t,\theta}\mathcal{P}_{s,t,\theta}\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|U_{t,\theta}\mathcal{P}_{s,t,\theta}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex18.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex18.1.1" class="ltx_text" style="font-size:67%;">By Kolmogorov Equation</span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex19.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex19.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|U_{t,\theta}\|_{1}\|\mathcal{P}_{s,t,\theta}\|_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|U_{t,\theta}\|_{1}\|\mathcal{P}_{s,t,\theta}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex19.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex19.1.1" class="ltx_text" style="font-size:67%;">By triangle inequality</span>)</span></span></td></tr></tbody>
<tbody id="A3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E5.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E5.m2" class="ltx_Math" alttext="\displaystyle\penalty\ 2M_{u}\|\mathcal{P}_{s,t,\theta}\|_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ 2M_{u}\|\mathcal{P}_{s,t,\theta}\|_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.5)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.3" class="ltx_p"><span id="A3.SS2.p3.3.1" class="ltx_text">where the last line follows by the maximum of the sum of absolute value if entry of <math id="A3.SS2.p3.m9" class="ltx_Math" alttext="U_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">U_{t,\theta}</annotation></semantics></math> in each column is less than <math id="A3.SS2.p3.m10" class="ltx_Math" alttext="M^{d}M_{u}" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">M^{d}M_{u}</annotation></semantics></math>.
Then by Grönwall’s Inequality <a href="#A3.Thmlemma1" title="Lemma C.1 (Grönwall’s Inequality, ( , )). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>, we have:</span></p>
<table id="A3.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E6.m1" class="ltx_Math" alttext="\displaystyle\|\mathcal{P}_{s,1,\theta}\|_{1}\leq\|\mathcal{P}_{s,s,\theta}\|_{1}\exp(\int_0^t M_u \dd s)\leq 2\exp(M_u)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi>M</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathcal{P}_{s,1,\theta}\|_{1}\leq\|\mathcal{P}_{s,s,\theta}\|_{1}\exp(\int_0^t M_u \dd s)\leq 2\exp(M_u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.6)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.4" class="ltx_p"><span id="A3.SS2.p3.4.1" class="ltx_text">Substituting (<a href="#A3.E6" title="Equation C.6 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.6</span></a>) into
(<a href="#A3.E4" title="Equation C.4 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4</span></a>), we get:</span></p>
<table id="A3.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex20.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex20.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}\|_{1}\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\|\mathcal{P}_{s,1,\theta}\|_{1}\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex20.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex20.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A3.E4" title="Equation C.4 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex21.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex21.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\exp(M_u)\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow></msub><mo>−</mo><msub><mi>U</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\exp(M_u)\|(U_{s,\theta}-U_{s})p_{s}\|_{1}\differential s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex22.m4" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex22.m5" class="ltx_Math" alttext="\displaystyle\penalty\ \exp(M_u)M^{\frac{d}{2}}\sqrt{\mathcal{R}(\widehat{\Theta}))}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mfrac><mi>d</mi><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \exp(M_u)M^{\frac{d}{2}}\sqrt{\mathcal{R}(\widehat{\Theta}))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex22.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex22.1.1" class="ltx_text" style="font-size:67%;">By the definition of risk function <math id="A3.Ex22.m1" class="ltx_Math" alttext="\cal{R}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">ℛ</mi><annotation encoding="application/x-tex">\cal{R}</annotation></semantics></math></span>)</span></span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.5" class="ltx_p"><span id="A3.SS2.p3.5.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.p4.1" class="ltx_p">Now we consider the error bounds for discrete flow matching with factorized velocity (<a href="#S2" title="2 Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>).</p>
</div>
<div id="A3.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem C.2</span></span><span id="A3.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Error Bounds for Discrete Flow Matching with Factorized Velocity, <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Error Bound for Discrete Flow Matching). ‣ 3 Error Bounds for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a> Restate)<span id="A3.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem2.p1" class="ltx_para">
<p id="A3.Thmtheorem2.p1.1" class="ltx_p">Consider the discrete state space <math id="A3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathcal{S}=\mathcal{T}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{S}=\mathcal{T}^{d}</annotation></semantics></math> with vocabulary <math id="A3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathcal{T}=\{1,\ldots,M\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{1,\ldots,M\}</annotation></semantics></math>.
Let <math id="A3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> be the true data distribution and let <math id="A3.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\widehat{P}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>P</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{P}</annotation></semantics></math> be the distribution generated by a DFM model using factorized velocity estimators <math id="A3.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\widehat{u}_{\theta}^{1},\ldots,\widehat{u}_{\theta}^{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>θ</mi><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>θ</mi><mi>d</mi></msubsup></mrow><annotation encoding="application/x-tex">\widehat{u}_{\theta}^{1},\ldots,\widehat{u}_{\theta}^{d}</annotation></semantics></math>.
For each coordinate <math id="A3.Thmtheorem2.p1.m6" class="ltx_Math" alttext="i_{0}\in[d]" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i_{0}\in[d]</annotation></semantics></math>, define the factorized risk as the mean squared error of its velocity estimator:</p>
<table id="A3.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex23.m1" class="ltx_Math" alttext="\displaystyle\mathcal{R}^{i_{0}}(\widehat{\Theta}):=\int_{t_{0}}^{T}\underset{X_{t}\sim p_{t}(x)}{\mathbb{E}}\|u^{i_{0}}(X_{t},t)-\widehat{u}^{i_{0}}_{\theta}(X_{t},t)\|_{2}^{2}\differential t," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><msub><mi>i</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>0</mn></msub><mi>T</mi></msubsup></mstyle><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><msub><mi mathsize="0.700em">X</mi><mi mathsize="0.710em">t</mi></msub><mo mathsize="0.700em">∼</mo><mrow><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>u</mi><msub><mi>i</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>θ</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{R}^{i_{0}}(\widehat{\Theta}):=\int_{t_{0}}^{T}\underset{X_{t}\sim p_{t}(x)}{\mathbb{E}}\|u^{i_{0}}(X_{t},t)-\widehat{u}^{i_{0}}_{\theta}(X_{t},t)\|_{2}^{2}\differential t,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p1.2" class="ltx_p">where the time interval is clipped to <math id="A3.Thmtheorem2.p1.m7" class="ltx_Math" alttext="[t_{0},T]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},T]</annotation></semantics></math> to ensure numerical stability and <math id="A3.Thmtheorem2.p1.m8" class="ltx_Math" alttext="p_{t}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t}(x)</annotation></semantics></math> is true probability path generated by <math id="A3.Thmtheorem2.p1.m9" class="ltx_Math" alttext="u^{1},\ldots,u^{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>u</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">u^{1},\ldots,u^{d}</annotation></semantics></math>. Then, the total variation distance between the true and generated distributions is bounded by the sum of the risks from each factorized component:</p>
<table id="A3.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})\lesssim\sqrt{M}\exp(M_u)\sum_{i_{0}\in[d]}\sqrt{\mathcal{R}^{i_{0}}(\widehat{\Theta}))}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><msqrt><mi>M</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><msqrt><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><msub><mi>i</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})\lesssim\sqrt{M}\exp(M_u)\sum_{i_{0}\in[d]}\sqrt{\mathcal{R}^{i_{0}}(\widehat{\Theta}))},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p1.3" class="ltx_p">where <math id="A3.Thmtheorem2.p1.m10" class="ltx_Math" alttext="M_{u}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>u</mi></msub><annotation encoding="application/x-tex">M_{u}</annotation></semantics></math> is the upper bound of estimated velocity such that <math id="A3.Thmtheorem2.p1.m11" class="ltx_Math" alttext="\absolutevalue{u_t^{\theta,i}(y,x)}\leq M_{u}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mi>θ</mi><mo>,</mo><mi>i</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>M</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">\absolutevalue{u_t^{\theta,i}(y,x)}\leq M_{u}</annotation></semantics></math> for all <math id="A3.Thmtheorem2.p1.m12" class="ltx_Math" alttext="y,x\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>y</mi><mo>,</mo><mi>x</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">y,x\in\mathcal{S}</annotation></semantics></math>.</p>
</div>
</div>
<div id="A3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p5" class="ltx_para">
<p id="A3.SS2.p5.1" class="ltx_p"><span id="A3.SS2.p5.1.1" class="ltx_text">Following the definitions in <a href="#A3.Thmlemma2" title="Lemma C.2 (Variation of Constants Formula for Error). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.2</span></a> and <a href="#A3.Thmtheorem1" title="Theorem C.1 (Error Bounds for Discrete Flow Matching). ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>.
Let evolution operator <math id="A3.SS2.p5.m1" class="ltx_Math" alttext="\mathcal{P}_{s,t,\theta}^{i_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><annotation encoding="application/x-tex">\mathcal{P}_{s,t,\theta}^{i_{0}}</annotation></semantics></math> be the transformation operator for coordinate <math id="A3.SS2.p5.m2" class="ltx_Math" alttext="i_{0}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>0</mn></msub><annotation encoding="application/x-tex">i_{0}</annotation></semantics></math>.
Let <math id="A3.SS2.p5.m3" class="ltx_Math" alttext="p_{t}^{i_{0}}\in\mathbb{R}^{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>t</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>M</mi></msup></mrow><annotation encoding="application/x-tex">p_{t}^{i_{0}}\in\mathbb{R}^{M}</annotation></semantics></math> and <math id="A3.SS2.p5.m4" class="ltx_Math" alttext="U_{t}^{i_{0}}\in\mathbb{R}^{M\times M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>U</mi><mi>t</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U_{t}^{i_{0}}\in\mathbb{R}^{M\times M}</annotation></semantics></math> be the true probability vector and the true rates matrix for coordinate <math id="A3.SS2.p5.m5" class="ltx_Math" alttext="i_{0}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>0</mn></msub><annotation encoding="application/x-tex">i_{0}</annotation></semantics></math>.
Let <math id="A3.SS2.p5.m6" class="ltx_Math" alttext="\widehat{p}_{t,\theta}^{i_{0}}\in\mathbb{R}^{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>M</mi></msup></mrow><annotation encoding="application/x-tex">\widehat{p}_{t,\theta}^{i_{0}}\in\mathbb{R}^{M}</annotation></semantics></math> and <math id="A3.SS2.p5.m7" class="ltx_Math" alttext="\widehat{U}_{t,\theta}^{i_{0}}\in\mathbb{R}^{M\times M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\widehat{U}_{t,\theta}^{i_{0}}\in\mathbb{R}^{M\times M}</annotation></semantics></math> be the estimated probability vectors and rates matrix defined by estimated velocity <math id="A3.SS2.p5.m8" class="ltx_Math" alttext="\widehat{u}_{t,\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow></msub><annotation encoding="application/x-tex">\widehat{u}_{t,\theta}</annotation></semantics></math> for coordinate <math id="A3.SS2.p5.m9" class="ltx_Math" alttext="i_{0}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>0</mn></msub><annotation encoding="application/x-tex">i_{0}</annotation></semantics></math>.
Then by definition of total variation distance, we have:</span></p>
<table id="A3.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex25.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})=" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex25.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2}\sum_{x\in S}|p_{1}(x)-p_{1,\theta}(x)|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>p</mi><mrow><mn>1</mn><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2}\sum_{x\in S}|p_{1}(x)-p_{1,\theta}(x)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex26.m7" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26.m8" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2}\sum_{i_{0}\in[d]}\sum_{x\in S}|p_{1}^{i_{0}}(x)-p^{i_{0}}_{1,\theta}(x)|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>p</mi><mn>1</mn><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>p</mi><mrow><mn>1</mn><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2}\sum_{i_{0}\in[d]}\sum_{x\in S}|p_{1}^{i_{0}}(x)-p^{i_{0}}_{1,\theta}(x)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex26.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex26.1.1" class="ltx_text" style="font-size:67%;">By <math id="A3.Ex26.m1" class="ltx_Math" alttext="p_{1}^{i_{0}}=\prod_{i_{0}=1}^{d}p_{1}^{i_{0}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0.111em">=</mo><mrow><msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∏</mo><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">=</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">d</mi></msubsup><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub></msubsup></mrow></mrow><annotation encoding="application/x-tex">p_{1}^{i_{0}}=\prod_{i_{0}=1}^{d}p_{1}^{i_{0}}</annotation></semantics></math> and <math id="A3.Ex26.m2" class="ltx_Math" alttext="p_{1,\theta}^{i_{0}}=\prod_{i_{0}=1}^{d}p_{1,\theta}^{i_{0}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi></mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0.111em">=</mo><mrow><msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∏</mo><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">=</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">d</mi></msubsup><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi></mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub></msubsup></mrow></mrow><annotation encoding="application/x-tex">p_{1,\theta}^{i_{0}}=\prod_{i_{0}=1}^{d}p_{1,\theta}^{i_{0}}</annotation></semantics></math>.</span>)</span></span></td></tr></tbody>
<tbody id="A3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E7.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E7.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\sum_{i_{0}\in[d]}\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>−</mo><msubsup><mi>U</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\sum_{i_{0}\in[d]}\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.7)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.2" class="ltx_p"><span id="A3.SS2.p5.2.1" class="ltx_text">where the last equation follows from the proof of <a href="#A3.Thmtheorem1" title="Theorem C.1 (Error Bounds for Discrete Flow Matching). ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>.
As in <a href="#A3.Thmtheorem1" title="Theorem C.1 (Error Bounds for Discrete Flow Matching). ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>,
we then bound the derivative of <math id="A3.SS2.p5.m10" class="ltx_Math" alttext="\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{F}</annotation></semantics></math>.
Let <math id="A3.SS2.p5.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be the vocabulary size and set the transformer estimator <math id="A3.SS2.p5.m12" class="ltx_Math" alttext="u_{\widehat{\theta}}^{i_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mover accent="true"><mi>θ</mi><mo>^</mo></mover><msub><mi>i</mi><mn>0</mn></msub></msubsup><annotation encoding="application/x-tex">u_{\widehat{\theta}}^{i_{0}}</annotation></semantics></math> bound by <math id="A3.SS2.p5.m13" class="ltx_Math" alttext="M_{u}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>u</mi></msub><annotation encoding="application/x-tex">M_{u}</annotation></semantics></math> for any <math id="A3.SS2.p5.m14" class="ltx_Math" alttext="i_{0}\in[d]" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i_{0}\in[d]</annotation></semantics></math>, then we have</span></p>
<table id="A3.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial}{\partial t}\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial}{\partial t}\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|\frac{\partial}{\partial t}\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|\frac{\partial}{\partial t}\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex29.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|U_{t,\theta}^{i_{0}}\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\penalty\ \|U_{t,\theta}^{i_{0}}\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex29.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex29.1.1" class="ltx_text" style="font-size:67%;">By Kolmogorov Equation</span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \|U_{t,\theta}^{i_{0}}\|_{1}\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \|U_{t,\theta}^{i_{0}}\|_{1}\|\mathcal{P}_{s,t,\theta}^{i_{0}}\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex30.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex30.1.1" class="ltx_text" style="font-size:67%;">By triangle inequality</span>)</span></span></td></tr></tbody>
<tbody id="A3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E8.m1" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E8.m2" class="ltx_Math" alttext="\displaystyle\penalty\ M_{u}\|\mathcal{P}^{i_{0}}_{s,t,\theta}\|_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ M_{u}\|\mathcal{P}^{i_{0}}_{s,t,\theta}\|_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.8)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.3" class="ltx_p"><span id="A3.SS2.p5.3.1" class="ltx_text">where the last line follows by the maximum of the sum of absolute value of entry of <math id="A3.SS2.p5.m15" class="ltx_Math" alttext="U_{t,\theta}^{i_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><annotation encoding="application/x-tex">U_{t,\theta}^{i_{0}}</annotation></semantics></math> in each column is lesssim than <math id="A3.SS2.p5.m16" class="ltx_Math" alttext="M_{u}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>u</mi></msub><annotation encoding="application/x-tex">M_{u}</annotation></semantics></math>.
Then by Grönwall’s Inequality <a href="#A3.Thmlemma1" title="Lemma C.1 (Grönwall’s Inequality, ( , )). ‣ C.1 Preliminaries ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>, we have:</span></p>
<table id="A3.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E9.m1" class="ltx_Math" alttext="\displaystyle\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\lesssim\|\mathcal{P}_{s,s,\theta}^{i_{0}}\|_{1}\exp(\int_0^t M_u \dd s)\leq\exp(M_u)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≲</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup></mstyle><mrow><msub><mi>M</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\lesssim\|\mathcal{P}_{s,s,\theta}^{i_{0}}\|_{1}\exp(\int_0^t M_u \dd s)\leq\exp(M_u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.9)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.4" class="ltx_p"><span id="A3.SS2.p5.4.1" class="ltx_text">Substituting (<a href="#A3.E9" title="Equation C.9 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.9</span></a>) into
(<a href="#A3.E7" title="Equation C.7 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a>), we get:</span></p>
<table id="A3.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_Math" alttext="\displaystyle\text{TV}(P,\widehat{P})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\text{TV}(P,\widehat{P})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \int_{0}^{1}\sum_{i_{0}\in[d]}\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>s</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>−</mo><msubsup><mi>U</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \int_{0}^{1}\sum_{i_{0}\in[d]}\|\mathcal{P}_{s,1,\theta}^{i_{0}}\|_{1}\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex31.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex31.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A3.E7" title="Equation C.7 ‣ Proof. ‣ C.2 Main Proof of ‣ Appendix C Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \sum_{i_{0}\in[d]}\int_{0}^{1}\exp(M_u)\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>U</mi><mrow><mi>s</mi><mo>,</mo><mi>θ</mi></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup><mo>−</mo><msubsup><mi>U</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>s</mi><msub><mi>i</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \sum_{i_{0}\in[d]}\int_{0}^{1}\exp(M_u)\|(U_{s,\theta}^{i_{0}}-U_{s}^{i_{0}})p_{s}^{i_{0}}\|_{1}\differential s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex33.m4" class="ltx_Math" alttext="\displaystyle\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\displaystyle\lesssim</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m5" class="ltx_Math" alttext="\displaystyle\penalty\ \sqrt{M}\exp(M_u)\sum_{i_{0}\in[d]}\sqrt{\mathcal{R}^{i_{0}}(\widehat{\Theta}))}." display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>M</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>M</mi><mi>u</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><msqrt><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><msub><mi>i</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \sqrt{M}\exp(M_u)\sum_{i_{0}\in[d]}\sqrt{\mathcal{R}^{i_{0}}(\widehat{\Theta}))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A3.Ex33.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A3.Ex33.1.1" class="ltx_text" style="font-size:67%;">By the definition of risk function <math id="A3.Ex33.m1" class="ltx_Math" alttext="\mathcal{R}^{i_{0}}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">ℛ</mi><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">i</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></msub></msup><annotation encoding="application/x-tex">\mathcal{R}^{i_{0}}</annotation></semantics></math></span>)</span></span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.5" class="ltx_p"><span id="A3.SS2.p5.5.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></h3>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">This section provides the proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.
Note that we view <math id="A4.p1.m1" class="ltx_Math" alttext="\mathcal{T}=[M]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=[M]</annotation></semantics></math> as a subspace of <math id="A4.p1.m2" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math> in this section.
In other words, we embed <math id="A4.p1.m3" class="ltx_Math" alttext="\mathcal{S}=\mathcal{T}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{S}=\mathcal{T}^{d}</annotation></semantics></math> into <math id="A4.p1.m4" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math> through the inclusion map <math id="A4.p1.m5" class="ltx_Math" alttext="E:\mathcal{S}\hookrightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">↪</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">E:\mathcal{S}\hookrightarrow\mathbb{R}^{d}</annotation></semantics></math>.</p>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text ltx_font_bold">Organization.</span>
In <a href="#A4.SS1" title="D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>, we define a <math id="A4.p2.m1" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> function <math id="A4.p2.m2" class="ltx_Math" alttext="\eta(x)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(x)</annotation></semantics></math> and derive bounds for all its derivatives in <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>.
Then we present the main proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> in <a href="#A4.SS2" title="D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.2</span></a> on the basis of function constructed in <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Preliminaries</h4>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p">We start with defining a smooth function <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="\eta(x)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(x)</annotation></semantics></math> and bounding its derivatives.</p>
</div>
<div id="A4.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma D.1</span></span><span id="A4.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma1.p1" class="ltx_para">
<p id="A4.Thmlemma1.p1.1" class="ltx_p">Define <math id="A4.Thmlemma1.p1.m1" class="ltx_Math" alttext="\eta(x):[0,\infty)\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta(x):[0,\infty)\to[0,1]</annotation></semantics></math> by</p>
<table id="A4.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex1.m1" class="ltx_Math" alttext="\displaystyle\eta(x)=\begin{cases}e\cdot\exp(-\frac{1}{1-x}),\penalty\ &amp;x\in[0,1),\\
0,\penalty\ &amp;x\in[1,\infty).\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta(x)=\begin{cases}e\cdot\exp(-\frac{1}{1-x}),\penalty\ &amp;x\in[0,1),\\
0,\penalty\ &amp;x\in[1,\infty).\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmlemma1.p1.2" class="ltx_p">Then <math id="A4.Thmlemma1.p1.m2" class="ltx_Math" alttext="\eta(t)\in C^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\eta(t)\in C^{\infty}</annotation></semantics></math> and <math id="A4.Thmlemma1.p1.m3" class="ltx_Math" alttext="|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|\leq e\cdot(\frac{2n}{e})^{2n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|\leq e\cdot(\frac{2n}{e})^{2n}</annotation></semantics></math> for all <math id="A4.Thmlemma1.p1.m4" class="ltx_Math" alttext="x\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[0,1]</annotation></semantics></math>.</p>
</div>
</div>
<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text">Our proof consists of three steps.</span></p>
</div>
<div id="A4.SS1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS1.p3.1" class="ltx_p"><span id="A4.SS1.p3.1.1" class="ltx_text ltx_font_bold">Step 1: Smoothness.<span id="A4.SS1.p3.1.1.1" class="ltx_text ltx_font_medium">
First, we show that <math id="A4.SS1.p3.m1" class="ltx_Math" alttext="\eta(x)\in C^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\eta(x)\in C^{\infty}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A4.SS1.p4" class="ltx_para ltx_noindent">
<p id="A4.SS1.p4.1" class="ltx_p"><span id="A4.SS1.p4.1.1" class="ltx_text">For <math id="A4.SS1.p4.m1" class="ltx_Math" alttext="x&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x&gt;1</annotation></semantics></math>, <math id="A4.SS1.p4.m2" class="ltx_Math" alttext="\eta(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta(x)=0</annotation></semantics></math> so all derivatives vanish (i.e., <math id="A4.SS1.p4.m3" class="ltx_Math" alttext="\frac{\differential^{n}\eta}{\differential x^{n}}=0" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{\differential^{n}\eta}{\differential x^{n}}=0</annotation></semantics></math> for any <math id="A4.SS1.p4.m4" class="ltx_Math" alttext="n\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">n\in\Z^{+}</annotation></semantics></math>).</span></p>
</div>
<div id="A4.SS1.p5" class="ltx_para ltx_noindent">
<p id="A4.SS1.p5.1" class="ltx_p"><span id="A4.SS1.p5.1.1" class="ltx_text">For <math id="A4.SS1.p5.m1" class="ltx_Math" alttext="x\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[0,1)</annotation></semantics></math>, we have <math id="A4.SS1.p5.m2" class="ltx_Math" alttext="\frac{\differential\eta}{\differential x}(x)=e\cdot(-\frac{1}{(x-1)^{2}})\cdot\exp(\frac{1}{x-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo rspace="0em">d</mo><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><mi>x</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\differential\eta}{\differential x}(x)=e\cdot(-\frac{1}{(x-1)^{2}})\cdot\exp(\frac{1}{x-1})</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p6" class="ltx_para ltx_noindent">
<p id="A4.SS1.p6.1" class="ltx_p"><span id="A4.SS1.p6.1.1" class="ltx_text">We denote, for <math id="A4.SS1.p6.m1" class="ltx_Math" alttext="x&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x&lt;1</annotation></semantics></math>,</span></p>
<table id="A4.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E1.m1" class="ltx_Math" alttext="\displaystyle\frac{\differential^{n}\eta}{\differential x^{n}}(x):=e\cdot p_{n}(\frac{1}{x-1})\cdot\exp(\frac{1}{x-1}),\quad\text{for}\quad n\in\mathbb{Z}^{+}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mtext>for</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>n</mi><mo>∈</mo><msup><mi>ℤ</mi><mo>+</mo></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\differential^{n}\eta}{\differential x^{n}}(x):=e\cdot p_{n}(\frac{1}{x-1})\cdot\exp(\frac{1}{x-1}),\quad\text{for}\quad n\in\mathbb{Z}^{+},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.1)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p6.2" class="ltx_p"><span id="A4.SS1.p6.2.1" class="ltx_text">where <math id="A4.SS1.p6.m2" class="ltx_Math" alttext="p_{n}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{n}(x)</annotation></semantics></math> is a function to be determined.
Then <math id="A4.SS1.p6.m3" class="ltx_Math" alttext="p_{0}(x)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{0}(x)=1</annotation></semantics></math> and <math id="A4.SS1.p6.m4" class="ltx_Math" alttext="p_{1}(x)=-x^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">p_{1}(x)=-x^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p7" class="ltx_para ltx_noindent">
<p id="A4.SS1.p7.1" class="ltx_p"><span id="A4.SS1.p7.1.1" class="ltx_text">For <math id="A4.SS1.p7.m1" class="ltx_Math" alttext="n\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">n\in\Z^{+}</annotation></semantics></math>, it holds</span></p>
<table id="A4.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex2.m1" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{\differential^{n}\eta}{\differential x^{n}}(x)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{\differential^{n}\eta}{\differential x^{n}}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex3.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex3.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{\differential}{\differential x}(\frac{\differential^{n-1}\eta}{\differential x^{n-1}})(x)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>x</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{\differential}{\differential x}(\frac{\differential^{n-1}\eta}{\differential x^{n-1}})(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex4.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex4.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{\differential}{\differential x}(e\cdot p_{n-1}(\frac{1}{x-1})\cdot\exp(\frac{1}{x-1}))" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mo>d</mo><mrow><mo rspace="0em">d</mo><mi>x</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{\differential}{\differential x}(e\cdot p_{n-1}(\frac{1}{x-1})\cdot\exp(\frac{1}{x-1}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex5.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex5.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(-\frac{1}{(x-1)^{2}}p^{\prime}_{n-1}(\frac{1}{x-1})+-\frac{1}{(x-1)^{2}}p_{n-1}(\frac{1}{x-1}))\cdot\exp(\frac{1}{x-1})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0em">+</mo></mrow><mo lspace="0em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(-\frac{1}{(x-1)^{2}}p^{\prime}_{n-1}(\frac{1}{x-1})+-\frac{1}{(x-1)^{2}}p_{n-1}(\frac{1}{x-1}))\cdot\exp(\frac{1}{x-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex5.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex5.1.1" class="ltx_text" style="font-size:67%;">By chain rule</span>)</span></span></td></tr></tbody>
</table>
<p id="A4.SS1.p7.2" class="ltx_p"><span id="A4.SS1.p7.2.1" class="ltx_text">Then we have the recurrence relation <math id="A4.SS1.p7.m2" class="ltx_Math" alttext="p_{n}(x)=-x^{2}(p_{n-1}(x)+p^{\prime}_{n-1}(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>p</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>p</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{n}(x)=-x^{2}(p_{n-1}(x)+p^{\prime}_{n-1}(x))</annotation></semantics></math> for <math id="A4.SS1.p7.m3" class="ltx_Math" alttext="n\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">n\in\Z^{+}</annotation></semantics></math> and <math id="A4.SS1.p7.m4" class="ltx_Math" alttext="p_{0}(x)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{0}(x)=1</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p8" class="ltx_para ltx_noindent">
<p id="A4.SS1.p8.1" class="ltx_p"><span id="A4.SS1.p8.1.1" class="ltx_text">By induction, <math id="A4.SS1.p8.m1" class="ltx_Math" alttext="p_{n}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>n</mi></msub><annotation encoding="application/x-tex">p_{n}</annotation></semantics></math> is a polynomial of degree <math id="A4.SS1.p8.m2" class="ltx_Math" alttext="2n" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">2n</annotation></semantics></math>.
Then for <math id="A4.SS1.p8.m3" class="ltx_Math" alttext="n\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">n\in\Z^{+}</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex6.m1" class="ltx_Math" alttext="\displaystyle\lim_{x\to 1^{-}}\frac{\differential^{n}\eta}{\differential x^{n}}(x)=" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>−</mo></msup></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{x\to 1^{-}}\frac{\differential^{n}\eta}{\differential x^{n}}(x)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex6.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \lim_{x\to 1^{-}}e\cdot p_{n}(\frac{1}{x-1})\exp(\frac{1}{x-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>−</mo></msup></mrow></munder><mi>e</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \lim_{x\to 1^{-}}e\cdot p_{n}(\frac{1}{x-1})\exp(\frac{1}{x-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex6.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex6.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A4.E1" title="Equation D.1 ‣ Proof. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex7.m4" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex7.m5" class="ltx_Math" alttext="\displaystyle\penalty\ \lim_{x\to-\infty}e\cdot p_{n}(x)\cdot e^{x}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mrow><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>e</mi><mi>x</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \lim_{x\to-\infty}e\cdot p_{n}(x)\cdot e^{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex7.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex7.1.1" class="ltx_text" style="font-size:67%;">By setting <math id="A4.Ex7.m1" class="ltx_Math" alttext="z=\frac{1}{x-1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">z</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">=</mo><mfrac style="--ltx-fg-color:#808080;" mathcolor="#808080"><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">z=\frac{1}{x-1}</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex8.m7" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex8.m8" class="ltx_Math" alttext="\displaystyle\penalty\ 0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\displaystyle\penalty\ 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex8.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A4.Ex8.m1" class="ltx_Math" alttext="({\rm polynomial})\cdot e^{z}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">polynomial</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em" rspace="0.055em">)</mo></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em" rspace="0.222em">⋅</mo><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">e</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">z</mi></msup></mrow><annotation encoding="application/x-tex">({\rm polynomial})\cdot e^{z}</annotation></semantics></math><span id="A4.Ex8.1.1" class="ltx_text" style="font-size:67%;"> vanishes as <math id="A4.Ex8.m2" class="ltx_Math" alttext="z\to-\infty" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">z</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">→</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">z\to-\infty</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex9.m7" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex9.m8" class="ltx_Math" alttext="\displaystyle\penalty\ \lim_{x\to 1^{+}}\frac{\differential^{n}\eta}{\differential x^{n}}(x)," display="inline" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><msup><mn>1</mn><mo>+</mo></msup></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \lim_{x\to 1^{+}}\frac{\differential^{n}\eta}{\differential x^{n}}(x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex9.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex9.1.1" class="ltx_text" style="font-size:67%;">By <math id="A4.Ex9.m1" class="ltx_Math" alttext="\eta(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">η</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">=</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn></mrow><annotation encoding="application/x-tex">\eta(x)=0</annotation></semantics></math> for <math id="A4.Ex9.m2" class="ltx_Math" alttext="x&gt;1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">&gt;</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow><annotation encoding="application/x-tex">x&gt;1</annotation></semantics></math></span>)</span></span></td></tr></tbody>
</table>
<p id="A4.SS1.p8.2" class="ltx_p"><span id="A4.SS1.p8.2.1" class="ltx_text">showing that all derivatives match at <math id="A4.SS1.p8.m4" class="ltx_Math" alttext="x=1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x=1</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p9" class="ltx_para ltx_noindent">
<p id="A4.SS1.p9.1" class="ltx_p"><span id="A4.SS1.p9.1.1" class="ltx_text">Then, since <math id="A4.SS1.p9.m1" class="ltx_Math" alttext="\eta(x)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(x)</annotation></semantics></math> is smooth on <math id="A4.SS1.p9.m2" class="ltx_Math" alttext="[0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,1)</annotation></semantics></math> and <math id="A4.SS1.p9.m3" class="ltx_Math" alttext="(1,\infty]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(1,\infty]</annotation></semantics></math>, we have <math id="A4.SS1.p9.m4" class="ltx_Math" alttext="\eta(x)\in C^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\eta(x)\in C^{\infty}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p10" class="ltx_para ltx_noindent">
<p id="A4.SS1.p10.1" class="ltx_p"><span id="A4.SS1.p10.1.1" class="ltx_text ltx_font_bold">Step 2: Growth Bound.<span id="A4.SS1.p10.1.1.1" class="ltx_text ltx_font_medium">
Next, we bound <math id="A4.SS1.p10.m1" class="ltx_Math" alttext="|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|</annotation></semantics></math>.</span></span></p>
</div>
<div id="A4.SS1.p11" class="ltx_para ltx_noindent">
<p id="A4.SS1.p11.1" class="ltx_p"><span id="A4.SS1.p11.1.1" class="ltx_text">Define <math id="A4.SS1.p11.m1" class="ltx_Math" alttext="q_{n}(x):=|e^{x}\cdot p_{n}(x)|" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>e</mi><mi>x</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">q_{n}(x):=|e^{x}\cdot p_{n}(x)|</annotation></semantics></math>.
Then <math id="A4.SS1.p11.m2" class="ltx_Math" alttext="q_{n+1}(x)=x^{2}\cdot q^{\prime}_{n}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>q</mi><mi>n</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{n+1}(x)=x^{2}\cdot q^{\prime}_{n}(x)</annotation></semantics></math>, <math id="A4.SS1.p11.m3" class="ltx_Math" alttext="n\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">n\in\Z^{+}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p12" class="ltx_para ltx_noindent">
<p id="A4.SS1.p12.1" class="ltx_p"><span id="A4.SS1.p12.1.1" class="ltx_text">Introduce the generating function</span></p>
<table id="A4.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex10.m1" class="ltx_Math" alttext="\displaystyle G(t,x):=\sum_{n\geq 0}\frac{q_{n}(x)}{n!}t^{n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>n</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle G(t,x):=\sum_{n\geq 0}\frac{q_{n}(x)}{n!}t^{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p12.2" class="ltx_p"><span id="A4.SS1.p12.2.1" class="ltx_text">Then <math id="A4.SS1.p12.m1" class="ltx_Math" alttext="G(t,x)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(t,x)</annotation></semantics></math> satisfies the partial differential equation</span></p>
<table id="A4.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E2.m1" class="ltx_Math" alttext="\displaystyle\partial_{t}G(t,x)=x^{2}\partial_{x}G(t,x),\quad G(0,x)=e^{x}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>x</mi></msub><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mi>x</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{t}G(t,x)=x^{2}\partial_{x}G(t,x),\quad G(0,x)=e^{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.2)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p12.3" class="ltx_p"><span id="A4.SS1.p12.3.1" class="ltx_text">One solution to (<a href="#A4.E2" title="Equation D.2 ‣ Proof. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>) is <math id="A4.SS1.p12.m2" class="ltx_Math" alttext="G(t,x)=\exp(\frac{x}{1-xt})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>x</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(t,x)=\exp(\frac{x}{1-xt})</annotation></semantics></math>.
Hence, <math id="A4.SS1.p12.m3" class="ltx_Math" alttext="\frac{q_{n}(x)}{n!}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{q_{n}(x)}{n!}</annotation></semantics></math> is the <math id="A4.SS1.p12.m4" class="ltx_Math" alttext="t^{n}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mi>n</mi></msup><annotation encoding="application/x-tex">t^{n}</annotation></semantics></math>-th coefficient in the Taylor expansion of <math id="A4.SS1.p12.m5" class="ltx_Math" alttext="G(t,x)=\exp(\frac{x}{1-xt})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>x</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(t,x)=\exp(\frac{x}{1-xt})</annotation></semantics></math> at point <math id="A4.SS1.p12.m6" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p13" class="ltx_para ltx_noindent">
<p id="A4.SS1.p13.1" class="ltx_p"><span id="A4.SS1.p13.1.1" class="ltx_text">By Cauchy integral formula, for all
<math id="A4.SS1.p13.m1" class="ltx_Math" alttext="x\leq-1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x\leq-1</annotation></semantics></math> and <math id="A4.SS1.p13.m2" class="ltx_Math" alttext="0&lt;r&lt;1/|x|" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0&lt;r&lt;1/|x|</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex11.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{n}(x)}{n!}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{n}(x)}{n!}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex11.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2\pi i}\int_{|t|=r,t\in\mathbb{C}}\frac{G(t,x)}{t^{n+1}}\differential t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>ℂ</mi></mrow></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2\pi i}\int_{|t|=r,t\in\mathbb{C}}\frac{G(t,x)}{t^{n+1}}\differential t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex12.m7" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex12.m8" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{1}{2\pi}\int_{|t|=r,t\in\mathbb{C}}|\frac{G(t,x)}{t^{n+1}}|\differential t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>ℂ</mi></mrow></mrow></msub></mstyle><mrow><mrow><mo stretchy="false">|</mo><mstyle displaystyle="true"><mfrac><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2\pi}\int_{|t|=r,t\in\mathbb{C}}|\frac{G(t,x)}{t^{n+1}}|\differential t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex12.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex12.1.1" class="ltx_text" style="font-size:67%;">By <math id="A4.Ex12.m1" class="ltx_Math" alttext="q_{n}(x)\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">q</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">ℝ</mi></mrow><annotation encoding="application/x-tex">q_{n}(x)\in\mathbb{R}</annotation></semantics></math> and <math id="A4.Ex12.m2" class="ltx_Math" alttext="|\int f\differential x|\leq\int|f|\differential x" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mrow><mo style="--ltx-fg-color:#808080;" lspace="0em" mathcolor="#808080">∫</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">d</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0.111em">≤</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">∫</mo><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">f</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">d</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">|\int f\differential x|\leq\int|f|\differential x</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex13.m4" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex13.m5" class="ltx_math_unparsed" alttext="\displaystyle\penalty\ \frac{1}{2\pi}\cdot\frac{\max_{|t|=r,t\in\mathbb{C}}|G(t,x)|}{r^{n+1}}\int_{|t|=r,t\in\mathbb{C}}1\differential x" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>max</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>ℂ</mi></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>ℂ</mi></mrow></mrow></msub><mn>1</mn><mo lspace="0em" rspace="0em">d</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{1}{2\pi}\cdot\frac{\max_{|t|=r,t\in\mathbb{C}}|G(t,x)|}{r^{n+1}}\int_{|t|=r,t\in\mathbb{C}}1\differential x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex13.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex13.1.1" class="ltx_text" style="font-size:67%;">By <math id="A4.Ex13.m1" class="ltx_Math" alttext="\int|fg|\differential x\leq(\sup|f|)\int|g|\differential x" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">∫</mo><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">f</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">g</mi></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">d</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">≤</mo><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#808080;" lspace="0em" mathcolor="#808080" rspace="0em">sup</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">f</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">∫</mo><mrow><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">g</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em">d</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\int|fg|\differential x\leq(\sup|f|)\int|g|\differential x</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E3.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E3.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \frac{\max_{|t|=r,t\in\mathbb{C}}|G(t,x)|}{r^{n}}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>max</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>ℂ</mi></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \frac{\max_{|t|=r,t\in\mathbb{C}}|G(t,x)|}{r^{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.3)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p14" class="ltx_para ltx_noindent">
<p id="A4.SS1.p14.1" class="ltx_p"><span id="A4.SS1.p14.1.1" class="ltx_text">Further, for <math id="A4.SS1.p14.m1" class="ltx_Math" alttext="x\leq-1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x\leq-1</annotation></semantics></math> and <math id="A4.SS1.p14.m2" class="ltx_Math" alttext="0&lt;r&lt;1/|x|" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0&lt;r&lt;1/|x|</annotation></semantics></math>, we set <math id="A4.SS1.p14.m3" class="ltx_Math" alttext="t=re^{i\theta}\in\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup></mrow><mo>∈</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">t=re^{i\theta}\in\mathbb{C}</annotation></semantics></math> and get</span></p>
<table id="A4.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex14.m1" class="ltx_Math" alttext="\displaystyle\max_{|t|=r,t\in C}|G(t,x)|=" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mi>C</mi></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\max_{|t|=r,t\in C}|G(t,x)|=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex14.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \max_{\theta\in[0,2\pi]}|\exp(\frac{x}{1-xre^{i\theta}})|" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \max_{\theta\in[0,2\pi]}|\exp(\frac{x}{1-xre^{i\theta}})|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex15.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex15.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \max_{\theta\in[0,2\pi]}\exp(x\cdot{\rm Re}(\frac{1}{1-xre^{i\theta}}))" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Re</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \max_{\theta\in[0,2\pi]}\exp(x\cdot{\rm Re}(\frac{1}{1-xre^{i\theta}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E4.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E4.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \exp(\frac{x}{1-xr})," display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \exp(\frac{x}{1-xr}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.4)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p14.2" class="ltx_p"><span id="A4.SS1.p14.2.1" class="ltx_text">where the second line is by <math id="A4.SS1.p14.m4" class="ltx_Math" alttext="|\exp(z)|=\exp({\rm Re}(z))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>z</mi><mo>)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Re</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\exp(z)|=\exp({\rm Re}(z))</annotation></semantics></math>, and the last line is by <math id="A4.SS1.p14.m5" class="ltx_Math" alttext="x\leq-1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x\leq-1</annotation></semantics></math> and <math id="A4.SS1.p14.m6" class="ltx_Math" alttext="|xr|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|xr|&lt;1</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p15" class="ltx_para ltx_noindent">
<p id="A4.SS1.p15.1" class="ltx_p"><span id="A4.SS1.p15.1.1" class="ltx_text">Substituting (<a href="#A4.E4" title="Equation D.4 ‣ Proof. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4</span></a>) into (<a href="#A4.E3" title="Equation D.3 ‣ Proof. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a>), we get</span></p>
<table id="A4.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex16.m1" class="ltx_Math" alttext="\displaystyle\frac{q_{n}(x)}{n!}\leq" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mstyle><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{q_{n}(x)}{n!}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex16.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \inf_{0&lt;r&lt;\frac{1}{|x|}}\frac{1}{r^{n}}\exp(\frac{x}{1-xr})" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mrow><mn>0</mn><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mfrac></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \inf_{0&lt;r&lt;\frac{1}{|x|}}\frac{1}{r^{n}}\exp(\frac{x}{1-xr})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex17.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex17.m2" class="ltx_Math" alttext="\displaystyle\penalty\ (2|x|)^{n}\cdot\exp(\frac{2}{3}x)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ (2|x|)^{n}\cdot\exp(\frac{2}{3}x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E5.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E5.m2" class="ltx_Math" alttext="\displaystyle\penalty\ (\frac{3n}{e})^{n}," display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>e</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ (\frac{3n}{e})^{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.5)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p15.2" class="ltx_p"><span id="A4.SS1.p15.2.1" class="ltx_text">where the second line is by setting <math id="A4.SS1.p15.m1" class="ltx_Math" alttext="r=\frac{1}{2|x|}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">r=\frac{1}{2|x|}</annotation></semantics></math>, and the last line follow from <math id="A4.SS1.p15.m2" class="ltx_Math" alttext="x\leq-1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x\leq-1</annotation></semantics></math> and optimizing over <math id="A4.SS1.p15.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS1.p16" class="ltx_para">
<p id="A4.SS1.p16.1" class="ltx_p"><span id="A4.SS1.p16.1.1" class="ltx_text ltx_font_bold">Step 3: Final Bound.<span id="A4.SS1.p16.1.1.1" class="ltx_text ltx_font_medium">
Finally we bound <math id="A4.SS1.p16.m1" class="ltx_Math" alttext="|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|</annotation></semantics></math> as</span></span></p>
<table id="A4.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex18.m1" class="ltx_Math" alttext="\displaystyle|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|=" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>n</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>n</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle|\frac{\differential^{n}\eta}{\differential x^{n}}(x)|=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex18.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot q_{n}(\frac{1}{x-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot q_{n}(\frac{1}{x-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex19.m7" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex19.m8" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot n!\cdot(\frac{3n}{e})^{n}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>n</mi><mo rspace="0.055em">!</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>e</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot n!\cdot(\frac{3n}{e})^{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex19.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex19.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A4.E5" title="Equation D.5 ‣ Proof. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a>) and <math id="A4.Ex19.m1" class="ltx_Math" alttext="\frac{1}{x-1}\leq-1" display="inline" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#808080;" mathcolor="#808080"><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow></mfrac><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">≤</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{x-1}\leq-1</annotation></semantics></math> when <math id="A4.Ex19.m2" class="ltx_Math" alttext="x\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">[</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[0,1)</annotation></semantics></math></span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex20.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex20.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(\frac{n}{e})^{n}\cdot(\frac{3n}{e})^{n}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mi>e</mi></mfrac></mstyle><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>n</mi></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>e</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(\frac{n}{e})^{n}\cdot(\frac{3n}{e})^{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex20.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex20.1.1" class="ltx_text" style="font-size:67%;">By Stirling’s formula</span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex21.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex21.m2" class="ltx_Math" alttext="\displaystyle\penalty\ e\cdot(\frac{2n}{e})^{2n}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>e</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ e\cdot(\frac{2n}{e})^{2n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p16.2" class="ltx_p"><span id="A4.SS1.p16.2.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Main Proof of <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></h4>

<div id="A4.SS2.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.p1.1" class="ltx_p">We now establish <a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> building on <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>.
This lemma guarantees the existence of a smooth function that interpolates a given discrete function by matching its values at prescribed points.
In this way, it provides a bridge between discrete functions and their continuous counterparts.</p>
</div>
<div id="A4.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma D.2</span></span><span id="A4.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(<a href="#S4.Thmlemma1" title="Lemma 4.1 (Discrete-to-Continuous Functional Extension). ‣ 4.1 Extending the Velocity Field ‣ 4 Approximation Error for Discrete Flow Matching" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> Restate)<span id="A4.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlemma2.p1" class="ltx_para">
<p id="A4.Thmlemma2.p1.1" class="ltx_p">Let <math id="A4.Thmlemma2.p1.m1" class="ltx_Math" alttext="\mathcal{S}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{S}\subset\mathbb{R}^{d}</annotation></semantics></math> be the state space of discrete flow matching.
Recall that <math id="A4.Thmlemma2.p1.m2" class="ltx_Math" alttext="\mathcal{S}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{S}\subset\mathbb{R}^{d}</annotation></semantics></math> is a <math id="A4.Thmlemma2.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-separated finite set with <math id="A4.Thmlemma2.p1.m4" class="ltx_Math" alttext="|\mathcal{S}|=M^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=M^{d}</annotation></semantics></math>, i.e., <math id="A4.Thmlemma2.p1.m5" class="ltx_Math" alttext="\|s-s^{\prime}\|\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>s</mi><mo>−</mo><msup><mi>s</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|s-s^{\prime}\|\geq 1</annotation></semantics></math> for all distinct <math id="A4.Thmlemma2.p1.m6" class="ltx_Math" alttext="s,s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s,s^{\prime}\in\mathcal{S}</annotation></semantics></math>.
For each <math id="A4.Thmlemma2.p1.m7" class="ltx_Math" alttext="x\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{S}</annotation></semantics></math>,
let <math id="A4.Thmlemma2.p1.m8" class="ltx_Math" alttext="u(x,\cdot)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mn>1</mn><mo>,</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(x,\cdot)\in\mathcal{H}^{\beta}_{1,M^{d}}([0,1],K)</annotation></semantics></math> with <math id="A4.Thmlemma2.p1.m9" class="ltx_Math" alttext="\beta=k_{1}+\gamma\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mi>γ</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta=k_{1}+\gamma\geq 1</annotation></semantics></math> and <math id="A4.Thmlemma2.p1.m10" class="ltx_Math" alttext="k_{1}=\lfloor\beta\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mi>β</mi><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">k_{1}=\lfloor\beta\rfloor</annotation></semantics></math>.
Then there exists an extension <math id="A4.Thmlemma2.p1.m11" class="ltx_Math" alttext="\widetilde{u}:\mathbb{R}^{d}\times[0,1]\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}:\mathbb{R}^{d}\times[0,1]\to\mathbb{R}</annotation></semantics></math> such that</p>
<table id="A4.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex22.m1" class="ltx_Math" alttext="\displaystyle\widetilde{u}(x,t)\in\mathcal{H}^{\beta}_{d+1,M^{d}}(\mathbb{R}^{d}\times[0,1],e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM^{d})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{u}(x,t)\in\mathcal{H}^{\beta}_{d+1,M^{d}}(\mathbb{R}^{d}\times[0,1],e\cdot(k_{1}+2)(2k_{1})^{2k_{1}}KM^{d}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmlemma2.p1.2" class="ltx_p">and <math id="A4.Thmlemma2.p1.m12" class="ltx_Math" alttext="\widetilde{u}(s,t)=u(s,t)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(s,t)=u(s,t)</annotation></semantics></math> for all <math id="A4.Thmlemma2.p1.m13" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> and <math id="A4.Thmlemma2.p1.m14" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math>.</p>
</div>
</div>
<div id="A4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS2.p2" class="ltx_para ltx_noindent">
<p id="A4.SS2.p2.1" class="ltx_p"><span id="A4.SS2.p2.1.1" class="ltx_text">Our proof consists of five steps.
We give the construction of <math id="A4.SS2.p2.m1" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> first in <span id="A4.SS2.p2.1.1.1" class="ltx_text ltx_font_bold">Step 1 &amp; 2</span>, and then prove that it has desired properties in <span id="A4.SS2.p2.1.1.2" class="ltx_text ltx_font_bold">Step 3 - 5</span>.</span></p>
</div>
<div id="A4.SS2.p3" class="ltx_para ltx_noindent">
<p id="A4.SS2.p3.1" class="ltx_p"><span id="A4.SS2.p3.1.1" class="ltx_text ltx_font_bold">Step 1: Partition of Unity around <math id="A4.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>.<span id="A4.SS2.p3.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A4.SS2.p4" class="ltx_para ltx_noindent">
<p id="A4.SS2.p4.1" class="ltx_p"><span id="A4.SS2.p4.1.1" class="ltx_text">Let <math id="A4.SS2.p4.m1" class="ltx_Math" alttext="\eta(t)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(t)</annotation></semantics></math> be the bump function from <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a>.</span></p>
</div>
<div id="A4.SS2.p5" class="ltx_para ltx_noindent">
<p id="A4.SS2.p5.1" class="ltx_p"><span id="A4.SS2.p5.1.1" class="ltx_text">Let <math id="A4.SS2.p5.m1" class="ltx_Math" alttext="r=1/e&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>e</mi></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">r=1/e&lt;1/2</annotation></semantics></math>.
For <math id="A4.SS2.p5.m2" class="ltx_Math" alttext="s\in\mathcal{S}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}\subset\mathbb{R}^{d}</annotation></semantics></math>, we define <math id="A4.SS2.p5.m3" class="ltx_Math" alttext="\phi^{r}_{s}(x):\mathbb{R}^{d}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϕ</mi><mi>s</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\phi^{r}_{s}(x):\mathbb{R}^{d}\to\mathbb{R}</annotation></semantics></math> as</span></p>
<table id="A4.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex23.m1" class="ltx_Math" alttext="\displaystyle\phi^{r}_{s}(x):=\eta(\frac{\|x-s\|^{2}}{r^{2}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ϕ</mi><mi>s</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\phi^{r}_{s}(x):=\eta(\frac{\|x-s\|^{2}}{r^{2}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p6" class="ltx_para ltx_noindent">
<p id="A4.SS2.p6.1" class="ltx_p"><span id="A4.SS2.p6.1.1" class="ltx_text">Then <math id="A4.SS2.p6.m1" class="ltx_Math" alttext="\phi^{r}_{s}(x)\in C^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϕ</mi><mi>s</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\phi^{r}_{s}(x)\in C^{\infty}</annotation></semantics></math>, <math id="A4.SS2.p6.m2" class="ltx_Math" alttext="{\rm supp}\penalty\ \phi^{r}_{s}(x)\subset B(s,r)=\{x\in\mathbb{R}^{d}\mid\|x-s\|&lt;r\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>supp</mi><mo lspace="0.500em" rspace="0em">​</mo><msubsup><mi>ϕ</mi><mi>s</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">‖</mo></mrow><mo>&lt;</mo><mi>r</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm supp}\penalty\ \phi^{r}_{s}(x)\subset B(s,r)=\{x\in\mathbb{R}^{d}\mid\|x-s\|&lt;r\}</annotation></semantics></math>, and <math id="A4.SS2.p6.m3" class="ltx_Math" alttext="\phi^{r}_{s}(s)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϕ</mi><mi>s</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\phi^{r}_{s}(s)=1</annotation></semantics></math>.
Since <math id="A4.SS2.p6.m4" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is <math id="A4.SS2.p6.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-separated and <math id="A4.SS2.p6.m6" class="ltx_Math" alttext="r&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">r&lt;1/2</annotation></semantics></math>, the supports <math id="A4.SS2.p6.m7" class="ltx_Math" alttext="\{\supp(\phi_{s})\}_{s\in\mathcal{S}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><annotation encoding="application/x-tex">\{\supp(\phi_{s})\}_{s\in\mathcal{S}}</annotation></semantics></math> are pairwise disjoint.</span></p>
</div>
<div id="A4.SS2.p7" class="ltx_para ltx_noindent">
<p id="A4.SS2.p7.1" class="ltx_p"><span id="A4.SS2.p7.1.1" class="ltx_text ltx_font_bold">Step 2: Extension.<span id="A4.SS2.p7.1.1.1" class="ltx_text ltx_font_medium">
Next, we extend the discrete function <math id="A4.SS2.p7.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to a continuous function <math id="A4.SS2.p7.m2" class="ltx_Math" alttext="\widetilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{u}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A4.SS2.p8" class="ltx_para ltx_noindent">
<p id="A4.SS2.p8.1" class="ltx_p"><span id="A4.SS2.p8.1.1" class="ltx_text">We construct <math id="A4.SS2.p8.m1" class="ltx_Math" alttext="\widetilde{u}(x,t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)</annotation></semantics></math> as:</span></p>
<table id="A4.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E6.m1" class="ltx_Math" alttext="\displaystyle\widetilde{u}(x,t)=\sum_{s\in\mathcal{S}}\phi_{s}(x)\cdot u(s,t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{u}(x,t)=\sum_{s\in\mathcal{S}}\phi_{s}(x)\cdot u(s,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.6)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p8.2" class="ltx_p"><span id="A4.SS2.p8.2.1" class="ltx_text">Disjointness implies that for each fixed <math id="A4.SS2.p8.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> at most one term in (<a href="#A4.E6" title="Equation D.6 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.6</span></a>) is nonzero.
Hence, <math id="A4.SS2.p8.m3" class="ltx_Math" alttext="\widetilde{u}(s,t)=u(s,t)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(s,t)=u(s,t)</annotation></semantics></math> for all <math id="A4.SS2.p8.m4" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS2.p9" class="ltx_para ltx_noindent">
<p id="A4.SS2.p9.1" class="ltx_p"><span id="A4.SS2.p9.1.1" class="ltx_text ltx_font_bold">Step 3: Derivative Bounds up to Order <math id="A4.SS2.p9.m1" class="ltx_Math" alttext="k_{1}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>1</mn></msub><annotation encoding="application/x-tex">k_{1}</annotation></semantics></math>.<span id="A4.SS2.p9.1.1.1" class="ltx_text ltx_font_medium">
We now prove <math id="A4.SS2.p9.m2" class="ltx_Math" alttext="\widetilde{u}(x,t)\in\mathcal{H}^{\beta^{\prime}}_{d,M^{d}}(\mathbb{R}^{d}\times[0,1],K^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>d</mi><mo>,</mo><msup><mi>M</mi><mi>d</mi></msup></mrow><msup><mi>β</mi><mo>′</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><msup><mi>K</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{u}(x,t)\in\mathcal{H}^{\beta^{\prime}}_{d,M^{d}}(\mathbb{R}^{d}\times[0,1],K^{\prime})</annotation></semantics></math>.</span></span></p>
</div>
<div id="A4.SS2.p10" class="ltx_para ltx_noindent">
<p id="A4.SS2.p10.1" class="ltx_p"><span id="A4.SS2.p10.1.1" class="ltx_text">Let <math id="A4.SS2.p10.m1" class="ltx_Math" alttext="(\lambda,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda,m)</annotation></semantics></math> be multi<span id="A4.SS2.p10.1.1.1" class="ltx_text">-</span>indices with <math id="A4.SS2.p10.m2" class="ltx_Math" alttext="\lambda\in\mathbb{N}_{0}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><msubsup><mi>ℕ</mi><mn>0</mn><mi>d</mi></msubsup></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{N}_{0}^{d}</annotation></semantics></math>, <math id="A4.SS2.p10.m3" class="ltx_Math" alttext="m\in\mathbb{N}_{0}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">m\in\mathbb{N}_{0}</annotation></semantics></math>, and <math id="A4.SS2.p10.m4" class="ltx_Math" alttext="|\lambda|+m\leq k_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>m</mi></mrow><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">|\lambda|+m\leq k_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS2.p11" class="ltx_para ltx_noindent">
<p id="A4.SS2.p11.1" class="ltx_p"><span id="A4.SS2.p11.1.1" class="ltx_text">Since <math id="A4.SS2.p11.m1" class="ltx_Math" alttext="\phi_{s}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\phi_{s}</annotation></semantics></math> is independent of <math id="A4.SS2.p11.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="A4.SS2.p11.m3" class="ltx_Math" alttext="u(s,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(s,\cdot)</annotation></semantics></math> is independent of <math id="A4.SS2.p11.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span></p>
<table id="A4.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex24.m1" class="ltx_Math" alttext="\displaystyle\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}(x,t)=\sum_{s\in\mathcal{S}}\partial_{x}^{\lambda}\phi_{s}(x)\partial_{t}^{m}u(s,t)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}(x,t)=\sum_{s\in\mathcal{S}}\partial_{x}^{\lambda}\phi_{s}(x)\partial_{t}^{m}u(s,t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p11.2" class="ltx_p"><span id="A4.SS2.p11.2.1" class="ltx_text">or in component-wise form, for every <math id="A4.SS2.p11.m5" class="ltx_Math" alttext="k\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">k\in\mathbb{R}^{d}</annotation></semantics></math>, it holds:</span></p>
<table id="A4.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(x,t)=\sum_{s\in\mathcal{S}}\partial^{\lambda}_{x}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{x}^{\lambda}\partial_{t}^{m}\widetilde{u}_{k}(x,t)=\sum_{s\in\mathcal{S}}\partial^{\lambda}_{x}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p11.3" class="ltx_p"><span id="A4.SS2.p11.3.1" class="ltx_text">Further, for all <math id="A4.SS2.p11.m6" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, <math id="A4.SS2.p11.m7" class="ltx_Math" alttext="x\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{d}</annotation></semantics></math> and <math id="A4.SS2.p11.m8" class="ltx_Math" alttext="j\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[d]</annotation></semantics></math>, it holds</span></p>
<table id="A4.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex26.m1" class="ltx_Math" alttext="\displaystyle|\frac{\partial}{\partial x[j]}\phi_{s}(x)|=|\frac{2(x[j]-s[j])}{r^{2}}\eta^{\prime}(\frac{\|x-s\|^{2}}{r^{2}})|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>r</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\frac{\partial}{\partial x[j]}\phi_{s}(x)|=|\frac{2(x[j]-s[j])}{r^{2}}\eta^{\prime}(\frac{\|x-s\|^{2}}{r^{2}})|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p11.4" class="ltx_p"><span id="A4.SS2.p11.4.1" class="ltx_text">Then with <math id="A4.SS2.p11.m9" class="ltx_Math" alttext="|s[j]-x[j]|\leq\frac{1}{e}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mi>e</mi></mfrac></mrow><annotation encoding="application/x-tex">|s[j]-x[j]|\leq\frac{1}{e}</annotation></semantics></math> when <math id="A4.SS2.p11.m10" class="ltx_Math" alttext="x\in{\rm supp}\{\phi_{s}(x)\}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>supp</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in{\rm supp}\{\phi_{s}(x)\}</annotation></semantics></math>, using mathematical induction we get that for all <math id="A4.SS2.p11.m11" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, <math id="A4.SS2.p11.m12" class="ltx_Math" alttext="x\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{d}</annotation></semantics></math> and <math id="A4.SS2.p11.m13" class="ltx_Math" alttext="m\in\Z^{+}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo rspace="0.1389em">∈</mo><msup><mo lspace="0.1389em">ℤ</mo><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">m\in\Z^{+}</annotation></semantics></math>, it holds</span></p>
<table id="A4.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex27.m1" class="ltx_Math" alttext="\displaystyle|\partial_{x}^{\lambda}\partial_{t}^{m}\phi_{s}(x)|\leq\frac{1}{r^{2m}}\cdot|\frac{\differential^{m}\eta}{\differential x^{m}}(\frac{\|x-s\|^{2}}{r^{2}})|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msubsup><mo lspace="0em">∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>d</mo><mi>m</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>m</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\partial_{x}^{\lambda}\partial_{t}^{m}\phi_{s}(x)|\leq\frac{1}{r^{2m}}\cdot|\frac{\differential^{m}\eta}{\differential x^{m}}(\frac{\|x-s\|^{2}}{r^{2}})|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p12" class="ltx_para ltx_noindent">
<p id="A4.SS2.p12.1" class="ltx_p"><span id="A4.SS2.p12.1.1" class="ltx_text">By <a href="#A4.Thmlemma1" title="Lemma D.1. ‣ D.1 Preliminaries ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.1</span></a> and <math id="A4.SS2.p12.m1" class="ltx_Math" alttext="r=1/e" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">r=1/e</annotation></semantics></math>, we have <math id="A4.SS2.p12.m2" class="ltx_Math" alttext="|\frac{\differential^{m}\eta}{\differential x^{m}}(x)|\leq e\cdot(\frac{2m}{e})^{2m}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mfrac><mrow><msup><mo>d</mo><mi>m</mi></msup><mi>η</mi></mrow><mrow><mo rspace="0em">d</mo><msup><mi>x</mi><mi>m</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>e</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>e</mi></mfrac><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">|\frac{\differential^{m}\eta}{\differential x^{m}}(x)|\leq e\cdot(\frac{2m}{e})^{2m}</annotation></semantics></math> and hence</span></p>
<table id="A4.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E7.m1" class="ltx_Math" alttext="\displaystyle\|\partial_{x}^{\alpha}\phi_{s}\|_{L^{\infty}(\mathbb{R}^{d})}\leq e(2|\alpha|)^{2|\alpha|}\quad\text{for all}\quad s\in\mathcal{S}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>α</mi></msubsup><msub><mi>ϕ</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>for all</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\partial_{x}^{\alpha}\phi_{s}\|_{L^{\infty}(\mathbb{R}^{d})}\leq e(2|\alpha|)^{2|\alpha|}\quad\text{for all}\quad s\in\mathcal{S}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(D.7)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p13" class="ltx_para ltx_noindent">
<p id="A4.SS2.p13.1" class="ltx_p"><span id="A4.SS2.p13.1.1" class="ltx_text ltx_font_bold">Step 4: <math id="A4.SS2.p13.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-Hölder Seminorm for Order <math id="A4.SS2.p13.m2" class="ltx_Math" alttext="k_{1}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>1</mn></msub><annotation encoding="application/x-tex">k_{1}</annotation></semantics></math>.<span id="A4.SS2.p13.1.1.1" class="ltx_text ltx_font_medium">
Return to the discussion of <math id="A4.SS2.p13.m3" class="ltx_Math" alttext="\widetilde{u}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\widetilde{u}_{k}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A4.SS2.p14" class="ltx_para ltx_noindent">
<p id="A4.SS2.p14.1" class="ltx_p"><span id="A4.SS2.p14.1.1" class="ltx_text">Let <math id="A4.SS2.p14.m1" class="ltx_Math" alttext="|\lambda|+m=k_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>m</mi></mrow><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">|\lambda|+m=k_{1}</annotation></semantics></math>.
For <math id="A4.SS2.p14.m2" class="ltx_Math" alttext="(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(x,t_{1}),(y,t_{2})\in\mathbb{R}^{d}\times[0,1]</annotation></semantics></math> and for every <math id="A4.SS2.p14.m3" class="ltx_Math" alttext="k\in[M^{d}]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>M</mi><mi>d</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[M^{d}]</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex28.m1" class="ltx_Math" alttext="\displaystyle\sum_{\|\lambda\|_{1}+m\leq k_{1}}\|\partial_{x}^{\lambda}\widetilde{u}_{k}(x,t)\|_{L^{\infty}}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>λ</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup></msub></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\|\lambda\|_{1}+m\leq k_{1}}\|\partial_{x}^{\lambda}\widetilde{u}_{k}(x,t)\|_{L^{\infty}}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex28.m2" class="ltx_Math" alttext="\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m\leq k_{1}}\sum_{s\in\mathcal{S}}\|\partial_{x}^{\lambda}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>λ</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow><mo>≤</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mo lspace="0em">∂</mo><mi>x</mi><mi>λ</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∂</mo><mi>t</mi><mi>m</mi></msubsup><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ \sum_{\|\lambda\|_{1}+m\leq k_{1}}\sum_{s\in\mathcal{S}}\|\partial_{x}^{\lambda}\phi_{s}(x)\partial^{m}_{t}u_{k}(s,t)\|_{L^{\infty}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A4.Ex28.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<span id="A4.Ex28.1.1" class="ltx_text" style="font-size:67%;">By (<a href="#A4.E6" title="Equation D.6 ‣ Proof. ‣ D.2 Main Proof of ‣ Appendix D Proof of ‣ Appendix" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.6</span></a>)</span>)</span></span></td></tr></tbody>
<tbody id="A4.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
