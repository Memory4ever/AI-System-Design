<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A5.Ex11.1" class="ltx_text" style="font-size:120%;--ltx-fg-color:#808080;">(<math id="A5.Ex11.m1" class="ltx_Math" alttext="\phi_{s}(x)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">ϕ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">x</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" maxsize="0.670em" minsize="0.670em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">≤</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.670em">1</mn></mrow><annotation encoding="application/x-tex">\phi_{s}(x)\leq 1</annotation></semantics></math><span id="A5.Ex11.1.1" class="ltx_text" style="font-size:67%;">,<math id="A5.Ex11.m2" class="ltx_Math" alttext="\|u(s,t)\|_{2}\leq M_{u}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">u</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">(</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">s</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi><mo style="--ltx-fg-col