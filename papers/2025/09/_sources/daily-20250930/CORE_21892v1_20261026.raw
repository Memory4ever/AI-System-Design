<td id="S5.T1.2.1.3.4" class="ltx_td ltx_align_center">33.33</td>
<td id="S5.T1.2.1.3.5" class="ltx_td ltx_align_center">52.71</td>
<td id="S5.T1.2.1.3.6" class="ltx_td ltx_align_center">15.97</td>
<td id="S5.T1.2.1.3.7" class="ltx_td ltx_align_center">22.89</td>
