<span id="S4.SS4.p1.p1.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.SS4.p1.p1.1.3.6.1" class="ltx_text ltx_ulem_uline" style="font-size:90%;--ltx-fg-color:#000000;">61.0</span></span></span>
<span id="S4.SS4.p1.p1.1.4" class="ltx_tr">
<span id="S4.SS4.p1.p1.1.4.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="S4.SS4.p1.p1.1.4.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Text</span></span>
<span id="S4.SS4.p1.p1.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="S4.SS4.p1.p1.1.4.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">86.8</span></span>
<span id="S4.SS4.p1.p1.1.4.3" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="S4.SS4.p1.p1.1.4.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">89.4   <span class="ltx_rule" style="width:1.0pt;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span></span></span>
<span id="S4.SS4.p1.p1.1.4.4" class="ltx_td ltx_align_center"><span id="S4.SS4.p1.p1.1.4.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">83.0</span></span>
<span id="S4.SS4.p1.p1.1.4.5" class="ltx_td ltx_align_center"><span id="S4.SS4.p1.p1.1.4.5.1" class="ltx_text ltx_ulem_uline" style="font-size:90%;--ltx-fg-color:#000000;">87.2</span></span>
