<p id="A3.p18.2" class="ltx_p"><span id="A3.p18.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">In block matrix form, the complex SSM can be represented as a real SSM through</span></p>
<table id="A3.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\begin{pmatrix}x_{t+1}^{r}\\
x_{t+1}^{i}\end{pmatrix}=\begin{bmatrix}A_{t}^{r}&amp;-A_{t}^{i}\\
A_{t}^{i}&amp;+A_{t}^{r}\end{bmatrix}\begin{pmatrix}x_{t}^{r}\\
x_{t}^{i}\end{pmatrix}+\begin{pmatrix}b_{t}^{r}\\
b_{t}^{i}\end{pmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mtd></mtr><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mtd></mtr></mtable><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">)</mo></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mtd><mtd><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mtd></mtr><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mtd><mtd><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mrow></mtd></mtr></mtable><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mtd></mtr><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mtd></mtr></mtable><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mtd></mtr><mtr><mtd><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mtd></mtr></mtable><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" lspace="0em" mathbackground="#FFFFFF" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\begin{pmatrix}x_{t+1}^{r}\\
x_{t+1}^{i}\end{pmatrix}=\begin{bmatrix}A_{t}^{r}&amp;-A_{t}^{i}\\
A_{t}^{i}&amp;+A_{t}^{r}\end{bmatrix}\begin{pmatrix}x_{t}^{r}\\
