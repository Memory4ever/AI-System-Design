<span id="S4.SS4.p1.p1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_3"><span id="S4.SS4.p1.p1.1.1.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Time-Variant</span></span></span>
