<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\displaystyle\displaystyle=A_{t}^{r}x_{t}^{r}-A_{t}^{i}x_{t}^{i}+b_{t}^{r}+i(A_{t}^{i}x_{t}^{r}+A_{t}^{r}x_{t}^{i}+b_{t}^{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" lspace="0em" mathbackground="#FFFFFF" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle=A_{t}^{r}x_{t}^{r}-A_{t}^{i}x_{t}^{i}+b_{t}^{r}+i(A_{t}^{i}x_{t}^{r}+A_{t}^{r}x_{t}^{i}+b_{t}^{i}).</annotation></semantics></math></td>
