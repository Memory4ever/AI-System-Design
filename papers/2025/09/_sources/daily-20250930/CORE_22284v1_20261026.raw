<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_math_unparsed" alttext="\displaystyle\displaystyle=B\sqrt{N}\left[(1-\epsilon)^{k}(1+\frac{(\frac{1}{1-\epsilon})^{k}-1}{\epsilon}\right]=B\sqrt{N}\left[(1-\epsilon)^{k}(1-\frac{1}{\epsilon})+\frac{1}{\epsilon}\right]\leq\frac{B\sqrt{N}}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">B</mi><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">N</mi></msqrt><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">[</mo><msup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">k</mi></msup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mrow><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi></mrow></mfrac><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">k</mi></msup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi></mfrac></mstyle><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">B</mi><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">N</mi></msqrt><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">[</mo><msup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">k</mi></msup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi></mfrac></mstyle><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi></mfrac></mstyle><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">≤</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">N</mi></msqrt></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ϵ</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle=B\sqrt{N}\left[(1-\epsilon)^{k}(1+\frac{(\frac{1}{1-\epsilon})^{k}-1}{\epsilon}\right]=B\sqrt{N}\left[(1-\epsilon)^{k}(1-\frac{1}{\epsilon})+\frac{1}{\epsilon}\right]\leq\frac{B\sqrt{N}}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p16" class="ltx_para">
<p id="A3.p16.1" class="ltx_p"><span id="A3.p16.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">∎</span></p>
</div>
</div>
<div id="A3.p17" class="ltx_para ltx_noindent">
<p id="A3.p17.1" class="ltx_p"><span id="A3.p17.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The following lemma will be of use for proving the optimality of </span><math id="A3.p17.m1" class="ltx_Math" alttext="\displaystyle PD" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">P</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">D</mi></mrow><annotation encoding="application/x-tex">\displaystyle PD</annotation></semantics></math><span id="A3.p17.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> parametrization.</span></p>
</div>
<div id="Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlem1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlem1.p1" class="ltx_para">
<p id="Thmlem1.p1.1" class="ltx_p"><span id="Thmlem1.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Any single-layer complex SSM with state size <math id="Thmlem1.p1.m1" class="ltx_Math" alttext="\displaystyle d" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">d</mi><annotation encoding="application/x-tex">\displaystyle d</annotation></semantics></math> can be reduced to a single-layer real SSM with state size <math id="Thmlem1.p1.m2" class="ltx_Math" alttext="\displaystyle 2d" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">d</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2d</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="A3.p18" class="ltx_para ltx_noindent">
<p id="A3.p18.1" class="ltx_p"><span id="A3.p18.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let <math id="A3.p18.m1" class="ltx_Math" alttext="\displaystyle x_{t},b_{t}\in\mathbb{C}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ℂ</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x_{t},b_{t}\in\mathbb{C}^{d}</annotation></semantics></math> and <math id="A3.p18.m2" class="ltx_Math" alttext="\displaystyle A_{t}\in\mathbb{C}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">ℂ</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" lspace="0.222em" mathbackground="#FFFFFF" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle A_{t}\in\mathbb{C}^{d\times d}</annotation></semantics></math> with <math id="A3.p18.m3" class="ltx_Math" alttext="\displaystyle x_{t+1}=A_{t}x_{t}+b_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x_{t+1}=A_{t}x_{t}+b_{t}</annotation></semantics></math>. Write <math id="A3.p18.m4" class="ltx_Math" alttext="\displaystyle x^{r}_{t}=\mathcal{R}(x_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℛ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x^{r}_{t}=\mathcal{R}(x_{t})</annotation></semantics></math>, <math id="A3.p18.m5" class="ltx_Math" alttext="\displaystyle x^{i}_{t}=\mathcal{I}(x_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℐ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x^{i}_{t}=\mathcal{I}(x_{t})</annotation></semantics></math>, <math id="A3.p18.m6" class="ltx_Math" alttext="\displaystyle b^{r}_{t}=\mathcal{R}(b_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℛ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle b^{r}_{t}=\mathcal{R}(b_{t})</annotation></semantics></math>, <math id="A3.p18.m7" class="ltx_Math" alttext="\displaystyle b^{i}_{t}=\mathcal{I}(b_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℐ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle b^{i}_{t}=\mathcal{I}(b_{t})</annotation></semantics></math>, <math id="A3.p18.m8" class="ltx_Math" alttext="\displaystyle A^{r}_{t}=\mathcal{R}(A_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℛ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A^{r}_{t}=\mathcal{R}(A_{t})</annotation></semantics></math>, and <math id="A3.p18.m9" class="ltx_Math" alttext="\displaystyle A^{i}_{t}=\mathcal{I}(A_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF" mathcolor="#000000">ℐ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A^{i}_{t}=\mathcal{I}(A_{t})</annotation></semantics></math>. Then</span></p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle\displaystyle x^{r}_{t+1}+ix^{i}_{t+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle x^{r}_{t+1}+ix^{i}_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m2" class="ltx_Math" alttext="\displaystyle\displaystyle=x_{t+1}=A_{t}x_{t}+b_{t}=(A^{r}_{t}+iA^{i}_{t})(x^{r}_{t}+ix^{i}_{t})+b^{r}_{t}+ib^{i}_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">=</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">r</mi></msubsup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" mathcolor="#000000">i</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle=x_{t+1}=A_{t}x_{t}+b_{t}=(A^{r}_{t}+iA^{i}_{t})(x^{r}_{t}+ix^{i}_{t})+b^{r}_{t}+ib^{i}_{t}</annotation></semantics></math></td>
