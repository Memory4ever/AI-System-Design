4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp1"><path d="M 19.77 -11.66 L 159.99 -11.66 L 159.99 89.36 L 19.77 89.36 Z"></path></clipPath><g clip-path="url(#pgfcp1)"><g stroke-width="0.6pt"><path style="fill:none" d="M 35.95 59.68 L 71.9 27.35 L 107.86 4.04 L 143.81 26.42"></path></g><g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0 77.71 L 179.76 77.71"></path></g><g></g><g style="--ltx-stroke-color:#5E35B1;--ltx-fill-color:#5E35B1;" fill="#5E35B1" stroke="#5E35B1" transform="matrix(1.0 0.0 0.0 1.0 114.32 82.6)"><foreignObject style="--ltx-fo-width:1.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="24.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.1" class="ltx_text" style="--ltx-fg-color:#5E35B1;">77.6</span></span></span></foreignObject></g><g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 0 52.84 L 179.76 52.84"></path></g><g></g><g style="--ltx-stroke-color:#228B22;--ltx-fill-color:#228B22;" fill="#228B22" stroke="#228B22" transform="matrix(1.0 0.0 0.0 1.0 114.32 57.73)"><foreignObject style="--ltx-fo-width:1.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="24.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.2" class="ltx_text" style="--ltx-fg-color:#228B22;">68.2</span></span></span></foreignObject></g><g></g></g><g style="--ltx-stroke-color:#2759A7;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#2759A7" stroke-width="0.5pt"><path d="M 38.03 59.68 C 38.03 60.83 37.1 61.76 35.95 61.76 C 34.81 61.76 33.88 60.83 33.88 59.68 C 33.88 58.53 34.81 57.6