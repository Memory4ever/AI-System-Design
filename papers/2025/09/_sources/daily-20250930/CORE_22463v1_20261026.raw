<th id="A2.T6.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A2.T6.2.1.1.2.1" class="ltx_text"></span> <span id="A2.T6.2.1.1.2.2" class="ltx_text">
