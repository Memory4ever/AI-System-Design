eru","familyName":"Jia","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Jiaming","nameType":"Personal","givenName":"Jiaming","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Yong","nameType":"Personal","givenName":"Yong","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Wuwu, Qingpo","nameType":"Personal","givenName":"Qingpo","familyName":"Wuwu","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Chengyu","nameType":"Personal","givenName":"Chengyu","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yu-Kai","nameType":"Personal","givenName":"Yu-Kai","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Ying","nameType":"Personal","givenName":"Ying","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Lizhang","nameType":"Personal","givenName":"Lizhang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Bao, Yong","nameType":"Personal","givenName":"Yong","familyName":"Bao","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Jiacheng","nameType":"Personal","givenName":"Jiacheng","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Kai","nameType":"Personal","givenName":"Kai","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"An, Ruichuan","nameType":"Personal","givenName":"Ruichuan","familyName":"An","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Yulin","nameType":"Personal","givenName":"Yulin","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Feng, Qiuxuan","nameType":"Personal","givenName":"Qiuxuan","familyName":"Feng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Siyuan","nameType":"Personal","givenName":"Siyuan","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Chan, Chi-min","nameType":"Personal","givenName":"Chi-min","familyName":"Chan","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Chengkai","nameType":"Personal","givenName":"Chengkai","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Xue, Wei","nameType":"Personal","givenName":"Wei","familyName":"Xue","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Sirui","nameType":"Personal","givenName":"Sirui","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yike","nameType":"Personal","givenName":"Yike","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shanghang","nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jian","nameType":"Personal","givenName":"Jian","familyName":"Tang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WoW: Towards a World omniscient World model Through Embodied Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multimedia (cs.MM)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T17:59:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T01:21:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T07:48:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:33:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Humans develop an understanding of intuitive physics through active interaction with the world. This approach is in stark contrast to current video models, such as Sora, which rely on passive observation and therefore struggle with grasping physical causality. This observation leads to our central hypothesis: authentic physical intuition of the world model must be grounded in extensive, causally rich interactions with the real world. To test this hypothesis, we present WoW, a 14-billion-parameter generative world model trained on 2 million robot interaction trajectories. Our findings reveal that the model's understanding of physics is a probabilistic distribution of plausible outcomes, leading to stochastic instabilities and physical hallucinations. Furthermore, we demonstrate that this emergent capability can be actively constrained toward physical realism by SOPHIA, where vision-language model agents evaluate the DiT-generated output and guide its refinement by iteratively evolving the language instructions. In addition, a co-trained Inverse Dynamics Model translates these refined plans into executable robotic actions, thus closing the imagination-to-action loop. We establish WoWBench, a new benchmark focused on physical consistency and causal reasoning in video, where WoW achieves state-of-the-art performance in both human and autonomous evaluation, demonstrating strong ability in physical causality, collision dynamics, and object permanence. Our work provides systematic evidence that large-scale, real-world interaction is a cornerstone for developing physical intuition in AI. Models, data, and benchmarks will be open-sourced.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.22642","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-29T02:35:24.000Z","registered":"2025-09-29T02:35:25.000Z","published":"2025","updated":"2025-10-17T04:14:55.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.22642","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}