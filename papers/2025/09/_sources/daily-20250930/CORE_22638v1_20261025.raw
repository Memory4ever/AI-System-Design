<td id="S3.T2.4.7.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T2.4.7.1.1" class="ltx_text ltx_font_bold">FCP</span></td>
