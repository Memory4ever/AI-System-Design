<td id="S7.T5.5.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T5.5.1.1.3.1" class="ltx_text ltx_font_bold">AgentDojo</span></td>
<td id="S7.T5.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T5.5.1.1.4.1" class="ltx_text ltx_font_bold">AndroidWorld</span></td></tr>
