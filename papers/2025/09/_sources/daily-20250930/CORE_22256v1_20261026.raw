<tr id="S7.T4.5.1.3" class="ltx_tr">
<td id="S7.T4.5.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.7pt;padding-right:1.7pt;">Vanilla</td>
<td id="S7.T4.5.1.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.7pt;padding-right:1.7pt;">45.14</td>
