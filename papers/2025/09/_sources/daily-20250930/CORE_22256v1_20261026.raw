<td id="S7.T5.5.1.4.1" class="ltx_td ltx_align_center">Overhead</td>
<td id="S7.T5.5.1.4.2" class="ltx_td ltx_align_center">200.03%</td>
<td id="S7.T5.5.1.4.3" class="ltx_td ltx_align_center">33.57%</td>
<td id="S7.T5.5.1.4.4" class="ltx_td ltx_align_center">6.55%</td></tr>
<tr id="S7.T5.5.1.5" class="ltx_tr">
<td id="S7.T5.5.1.5.1" class="ltx_td ltx_align_center ltx_border_bb">Prompt</td>
<td id="S7.T5.5.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">96.44%</td>
<td id="S7.T5.5.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">95.39%</td>
