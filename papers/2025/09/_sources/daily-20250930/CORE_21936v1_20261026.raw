<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E140.m1" class="ltx_Math" alttext="\displaystyle Z_{\mathrm{out}}^{\prime}(\gamma,R,\omega,V)=\int_{\mathbb{R}}\mathrm{d}\hat{y}\,e^{O}\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\int\mathrm{d}P_{\epsilon}(\epsilon)\,\tilde{g}_{\nu}(\epsilon,\chi)\hat{P}(\hat{y}|z,\chi,\epsilon)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\mathcal{N}(z_{l};\omega_{l},V)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>O</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">|</mo><mrow><mi>z</mi><mo>,</mo><mi>χ</mi><mo>,</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>ω</mi><mi>l</mi></msub><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\mathrm{out}}^{\prime}(\gamma,R,\omega,V)=\int_{\mathbb{R}}\mathrm{d}\hat{y}\,e^{O}\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\int\mathrm{d}P_{\epsilon}(\epsilon)\,\tilde{g}_{\nu}(\epsilon,\chi)\hat{P}(\hat{y}|z,\chi,\epsilon)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\mathcal{N}(z_{l};\omega_{l},V)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(140)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p4" class="ltx_para">
<p id="A3.SS2.p4.1" class="ltx_p">Once <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is extremized over the order parameters the test errors are computed as</p>
<table id="A3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E141.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}(\alpha)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E141.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\beta}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,(Z^{\prime}_{\mathrm{out}})^{-1}Z_{\mathrm{out}}\partial_{t}Z^{\prime}_{\mathrm{out}}|_{s=0,t=0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><msub><mrow><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\beta}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,(Z^{\prime}_{\mathrm{out}})^{-1}Z_{\mathrm{out}}\partial_{t}Z^{\prime}_{\mathrm{out}}|_{s=0,t=0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(141)</span></td></tr></tbody>
<tbody id="A3.E142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E142.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{B0}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>B0</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{B0}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E142.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,(Z^{\prime}_{\mathrm{out}})^{-1}Z_{\mathrm{out}}\partial_{s}Z^{\prime}_{\mathrm{out}}|_{s=0,t=0}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>s</mi></msub><msub><mrow><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></mrow></msub></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,(Z^{\prime}_{\mathrm{out}})^{-1}Z_{\mathrm{out}}\partial_{s}Z^{\prime}_{\mathrm{out}}|_{s=0,t=0}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(142)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Specialization to the BO</h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">We consider the BO setting, where <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="Z_{k}^{*}=Z_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>=</mo><msub><mi>Z</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">Z_{k}^{*}=Z_{k}</annotation></semantics></math>, <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="Z_{v}^{*}=Z_{v}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>v</mi><mo>∗</mo></msubsup><mo>=</mo><msub><mi>Z</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">Z_{v}^{*}=Z_{v}</annotation></semantics></math> and <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="Z_{\mathrm{out}}^{*}=Z_{\mathrm{out}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>out</mi><mo>∗</mo></msubsup><mo>=</mo><msub><mi>Z</mi><mi>out</mi></msub></mrow><annotation encoding="application/x-tex">Z_{\mathrm{out}}^{*}=Z_{\mathrm{out}}</annotation></semantics></math>. A main simplification, known as Nishimori condition, is given by the fact the BO estimator is sampling the posterior distribution: we have <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="m_{k}=q_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">m_{k}=q_{k}</annotation></semantics></math>, <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="\hat{m}_{k}=\hat{q}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\hat{m}_{k}=\hat{q}_{k}</annotation></semantics></math>, <math id="A3.SS3.p1.m6" class="ltx_Math" alttext="Q_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Q_{k}=1</annotation></semantics></math>, <math id="A3.SS3.p1.m7" class="ltx_Math" alttext="m_{v}=q_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><msub><mi>q</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">m_{v}=q_{v}</annotation></semantics></math>, <math id="A3.SS3.p1.m8" class="ltx_Math" alttext="\hat{m}_{v}=\hat{q}_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">\hat{m}_{v}=\hat{q}_{v}</annotation></semantics></math> and <math id="A3.SS3.p1.m9" class="ltx_Math" alttext="Q_{v}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>v</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Q_{v}=1</annotation></semantics></math>. We set the function <math id="A3.SS3.p1.m10" class="ltx_Math" alttext="\mathrm{xlogx}:x\to x\log(x)" display="inline" intent=":literal"><semantics><mrow><mi>xlogx</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><mrow><mi>x</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{xlogx}:x\to x\log(x)</annotation></semantics></math>. The resulting free entropy is</p>
<table id="A3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E143.m1" class="ltx_Math" alttext="\displaystyle\phi=-\frac{1}{2\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{k}\left(\sqrt{\hat{m}_{k}}\varsigma,\hat{m}_{k}\right)+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{v}\left(\sqrt{\hat{m}_{v}}\varsigma,\hat{m}_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>xlogx</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>xlogx</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi=-\frac{1}{2\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{k}\left(\sqrt{\hat{m}_{k}}\varsigma,\hat{m}_{k}\right)+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{v}\left(\sqrt{\hat{m}_{v}}\varsigma,\hat{m}_{v}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(143)</span></td></tr></tbody>
<tbody id="A3.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex41.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\mathrm{xlogx}Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>y</mi><mi>xlogx</mi><msub><mi>Z</mi><mi>out</mi></msub><mrow><mo>(</mo><mi>y</mi><mo>,</mo><msub><msqrt><mi>m</mi></msqrt><mi>k</mi></msub><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\mathrm{xlogx}Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex42.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\rho\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)\log Z_{\mathrm{out}}^{\prime}\left(\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ρ</mi><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>y</mi><msub><mi>Z</mi><mi>out</mi></msub><mrow><mo>(</mo><mi>y</mi><mo>,</mo><msub><msqrt><mi>m</mi></msqrt><mi>k</mi></msub><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub><mo rspace="0.167em">)</mo></mrow><mi>log</mi><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mrow><mo>(</mo><msub><msqrt><mi>m</mi></msqrt><mi>k</mi></msub><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\rho\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)\log Z_{\mathrm{out}}^{\prime}\left(\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">The extremality condition of <math id="A3.SS3.p2.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> over the order parameters is obtained by setting its gradient to zero. We take the limit <math id="A3.SS3.p2.m2" class="ltx_Math" alttext="\rho=0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho=0</annotation></semantics></math>. It gives the following fixed-point equations:</p>
<table id="A3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E144.m1" class="ltx_Math" alttext="\displaystyle m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E144.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\varsigma}Z_{k}^{-1}(\partial_{B}Z_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mi>B</mi></msub><msub><mi>Z</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\varsigma}Z_{k}^{-1}(\partial_{B}Z_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(144)</span></td></tr></tbody>
<tbody id="A3.E145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E145.m1" class="ltx_Math" alttext="\displaystyle m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E145.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\varsigma}Z_{v}^{-1}(\partial_{B}Z_{v})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mi>B</mi></msub><msub><mi>Z</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\varsigma}Z_{v}^{-1}(\partial_{B}Z_{v})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(145)</span></td></tr></tbody>
<tbody id="A3.E146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E146.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E146.m2" class="ltx_Math" alttext="\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{-1}(\nabla_{\gamma}Z_{\mathrm{out}})^{\top}(\nabla_{\gamma}Z_{\mathrm{out}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>out</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>γ</mi></msub><msub><mi>Z</mi><mi>out</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>γ</mi></msub><msub><mi>Z</mi><mi>out</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{-1}(\nabla_{\gamma}Z_{\mathrm{out}})^{\top}(\nabla_{\gamma}Z_{\mathrm{out}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(146)</span></td></tr></tbody>
<tbody id="A3.E147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E147.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E147.m2" class="ltx_Math" alttext="\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{-1}(\nabla_{\omega}Z_{\mathrm{out}})^{\top}(\nabla_{\omega}Z_{\mathrm{out}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>out</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ω</mi></msub><msub><mi>Z</mi><mi>out</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ω</mi></msub><msub><mi>Z</mi><mi>out</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{-1}(\nabla_{\omega}Z_{\mathrm{out}})^{\top}(\nabla_{\omega}Z_{\mathrm{out}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(147)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p3" class="ltx_para">
<p id="A3.SS3.p3.1" class="ltx_p">We explicit the fixed-point equations. We set</p>
<table id="A3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E148.m1" class="ltx_Math" alttext="\displaystyle h_{\nu}(\epsilon,\gamma,R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{\nu}(\epsilon,\gamma,R)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E148.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\,g_{\nu}(\epsilon,\chi)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\,g_{\nu}(\epsilon,\chi)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(148)</span></td></tr></tbody>
</table>
<p id="A3.SS3.p3.2" class="ltx_p">the effective distribution over <math id="A3.SS3.p3.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>. We assume that <math id="A3.SS3.p3.m2" class="ltx_Math" alttext="P_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>out</mi></msub><annotation encoding="application/x-tex">P_{\mathrm{out}}</annotation></semantics></math> is the identity channel. Then</p>
<table id="A3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E149.m1" class="ltx_Math" alttext="\displaystyle m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E149.m2" class="ltx_Math" alttext="\displaystyle=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(149)</span></td></tr></tbody>
<tbody id="A3.E150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E150.m1" class="ltx_Math" alttext="\displaystyle m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E150.m2" class="ltx_Math" alttext="\displaystyle=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(150)</span></td></tr></tbody>
<tbody id="A3.E151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E151.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E151.m2" class="ltx_Math" alttext="\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>ϵ</mi></munder></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>ϵ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(151)</span></td></tr></tbody>
<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle\quad\frac{1}{L}\sum_{l}^{L}\left[\sum_{\epsilon}\partial_{\gamma_{l}}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>ϵ</mi></munder></mstyle><mrow><msub><mo lspace="0em">∂</mo><msub><mi>γ</mi><mi>l</mi></msub></msub><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>ϵ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\frac{1}{L}\sum_{l}^{L}\left[\sum_{\epsilon}\partial_{\gamma_{l}}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E152.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E152.m2" class="ltx_Math" alttext="\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>ϵ</mi></munder></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>ϵ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{\epsilon})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(152)</span></td></tr></tbody>
<tbody id="A3.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex44.m1" class="ltx_Math" alttext="\displaystyle\quad\frac{1}{L}\sum_{l}^{L}\left[h_{\nu}(l,\sqrt{m_{k}}\xi,1-m_{k})\frac{y-\sqrt{m_{v}}\zeta_{l}}{1-m_{v}}\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><msup><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\frac{1}{L}\sum_{l}^{L}\left[h_{\nu}(l,\sqrt{m_{k}}\xi,1-m_{k})\frac{y-\sqrt{m_{v}}\zeta_{l}}{1-m_{v}}\frac{e^{-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}}}{\sqrt{2\pi(1-m_{v})}}\right]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p4" class="ltx_para">
<p id="A3.SS3.p4.1" class="ltx_p">At the fixed-point the Bayes-optimal error is given by</p>
<table id="A3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E153.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E153.m2" class="ltx_Math" alttext="\displaystyle=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\right]^{-1}\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>ϵ</mi></munder></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>ϵ</mi></munder></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}\left[\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\right]^{-1}\sum_{\epsilon}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(153)</span></td></tr></tbody>
</table>
</div>
<section id="A3.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.3.1 </span>Specialization to spiked-SLR</h4>

<div id="A3.SS3.SSS1.p1" class="ltx_para">
<p id="A3.SS3.SSS1.p1.1" class="ltx_p">The spiked-SLR is defined by taking <math id="A3.SS3.SSS1.p1.m1" class="ltx_Math" alttext="g_{\nu}(\epsilon,\chi)=e^{\sqrt{\nu}\chi_{\epsilon}-\frac{\nu}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>ϵ</mi></msub></mrow><mo>−</mo><mfrac><mi>ν</mi><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">g_{\nu}(\epsilon,\chi)=e^{\sqrt{\nu}\chi_{\epsilon}-\frac{\nu}{2}}</annotation></semantics></math>. We can integrate over <math id="A3.SS3.SSS1.p1.m2" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> and explicitly compute <math id="A3.SS3.SSS1.p1.m3" class="ltx_Math" alttext="h_{\nu}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ν</mi></msub><annotation encoding="application/x-tex">h_{\nu}</annotation></semantics></math>:</p>
<table id="A3.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E154.m1" class="ltx_Math" alttext="\displaystyle h_{\nu}(\epsilon,\gamma,R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{\nu}(\epsilon,\gamma,R)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E154.m2" class="ltx_Math" alttext="\displaystyle=e^{\sqrt{\nu}\gamma_{\epsilon}+\frac{1}{2}\nu(R-1)}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mi>e</mi><mrow><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>ϵ</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=e^{\sqrt{\nu}\gamma_{\epsilon}+\frac{1}{2}\nu(R-1)}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(154)</span></td></tr></tbody>
</table>
<p id="A3.SS3.SSS1.p1.2" class="ltx_p">Thanks to the invariance by permutation of the tokens we isolate the index <math id="A3.SS3.SSS1.p1.m4" class="ltx_Math" alttext="l=1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l=1</annotation></semantics></math>. We change the variables <math id="A3.SS3.SSS1.p1.m5" class="ltx_Math" alttext="\xi_{1}\to\xi_{1}+\sqrt{\nu m_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><msub><mi>ξ</mi><mn>1</mn></msub><mo>+</mo><msqrt><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\xi_{1}\to\xi_{1}+\sqrt{\nu m_{k}}</annotation></semantics></math> and <math id="A3.SS3.SSS1.p1.m6" class="ltx_Math" alttext="\zeta_{1}\to\sqrt{1-m_{v}}\zeta_{1}+\sqrt{m_{v}}y" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{1}\to\sqrt{1-m_{v}}\zeta_{1}+\sqrt{m_{v}}y</annotation></semantics></math> to obtain expressions that are easier to compute numerically. This gives</p>
<table id="A3.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E155.m1" class="ltx_Math" alttext="\displaystyle m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E155.m2" class="ltx_Math" alttext="\displaystyle=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}\ ,\qquad m_{v}=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0.500em" rspace="2.167em">,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}\ ,\qquad m_{v}=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(155)</span></td></tr></tbody>
<tbody id="A3.E156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E156.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E156.m2" class="ltx_Math" alttext="\displaystyle=\alpha\nu\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{1}{1+\sum_{l&gt;1}^{L}e^{-\nu m_{k}+\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}+\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></msubsup><msup><mi>e</mi><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></mrow><mo>+</mo><mrow><msqrt><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ξ</mi><mi>l</mi></msub><mo>−</mo><msub><mi>ξ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup></mrow></mrow></mfrac></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\nu\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{1}{1+\sum_{l&gt;1}^{L}e^{-\nu m_{k}+\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}+\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(156)</span></td></tr></tbody>
<tbody id="A3.E157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E157.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E157.m2" class="ltx_Math" alttext="\displaystyle=\frac{\alpha}{1-m_{v}}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}{1+\sum_{l&gt;1}^{L}e^{-\nu m_{k}+\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}+\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></msubsup><msup><mi>e</mi><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></mrow><mo>+</mo><mrow><msqrt><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ξ</mi><mi>l</mi></msub><mo>−</mo><msub><mi>ξ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup></mrow></mrow></mfrac></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha}{1-m_{v}}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}{1+\sum_{l&gt;1}^{L}e^{-\nu m_{k}+\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}+\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(157)</span></td></tr></tbody>
<tbody id="A3.E158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E158.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E158.m2" class="ltx_Math" alttext="\displaystyle=1-m_{v}e^{-\frac{\nu m_{k}}{2}}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{e^{\sqrt{\nu m_{k}}\xi_{1}}}{1+\sum_{l&gt;1}^{L}e^{\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msqrt><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mn>1</mn></msub></mrow></msup><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></msubsup><msup><mi>e</mi><mrow><msqrt><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ξ</mi><mi>l</mi></msub><mo>−</mo><msub><mi>ξ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-m_{v}e^{-\frac{\nu m_{k}}{2}}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{e^{\sqrt{\nu m_{k}}\xi_{1}}}{1+\sum_{l&gt;1}^{L}e^{\sqrt{\nu m_{k}}(\xi_{l}-\xi_{1})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(158)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.3.2 </span>Specialization to the max-SLR model</h4>

<div id="A3.SS3.SSS2.p1" class="ltx_para">
<p id="A3.SS3.SSS2.p1.1" class="ltx_p">The max-SLR model is defined by taking <math id="A3.SS3.SSS2.p1.m1" class="ltx_Math" alttext="g_{\nu}(\epsilon,\chi)=Le^{\nu\chi_{\epsilon}}/(\sum_{l}e^{\nu\chi_{l}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>ϵ</mi></msub></mrow></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>l</mi></msub><msup><mi>e</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>l</mi></msub></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{\nu}(\epsilon,\chi)=Le^{\nu\chi_{\epsilon}}/(\sum_{l}e^{\nu\chi_{l}})</annotation></semantics></math>. <math id="A3.SS3.SSS2.p1.m2" class="ltx_Math" alttext="\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\chi</annotation></semantics></math> cannot be integrated out. We consider the limit <math id="A3.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\nu=+\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\nu=+\infty</annotation></semantics></math> to simplify the expression of <math id="A3.SS3.SSS2.p1.m4" class="ltx_Math" alttext="h_{\nu}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ν</mi></msub><annotation encoding="application/x-tex">h_{\nu}</annotation></semantics></math>:</p>
<table id="A3.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E159.m1" class="ltx_Math" alttext="\displaystyle h_{\nu}(\epsilon,\gamma,R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{\nu}(\epsilon,\gamma,R)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E159.m2" class="ltx_Math" alttext="\displaystyle=L\int_{\mathbb{R}}\mathrm{d}\chi\,\mathcal{N}(\chi;\gamma_{\epsilon},R)\prod_{l\neq\epsilon}\frac{1}{2}\left(1+\erf\frac{\chi-\gamma_{l}}{\sqrt{2R}}\right)\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><msub><mi>γ</mi><mi>ϵ</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>≠</mo><mi>ϵ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>erf</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>χ</mi><mo>−</mo><msub><mi>γ</mi><mi>l</mi></msub></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mfrac></mstyle></mrow></mrow><mo rspace="0.222em">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=L\int_{\mathbb{R}}\mathrm{d}\chi\,\mathcal{N}(\chi;\gamma_{\epsilon},R)\prod_{l\neq\epsilon}\frac{1}{2}\left(1+\erf\frac{\chi-\gamma_{l}}{\sqrt{2R}}\right)\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(159)</span></td></tr></tbody>
</table>
<p id="A3.SS3.SSS2.p1.2" class="ltx_p">Thanks to the invariance by permutation of the tokens we isolate the indices <math id="A3.SS3.SSS2.p1.m5" class="ltx_Math" alttext="l=1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l=1</annotation></semantics></math> and <math id="A3.SS3.SSS2.p1.m6" class="ltx_Math" alttext="l=2" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">l=2</annotation></semantics></math>. We can still change variables <math id="A3.SS3.SSS2.p1.m7" class="ltx_Math" alttext="\zeta_{\epsilon}\to\sqrt{1-m_{v}}\zeta_{\epsilon}+\sqrt{m_{v}}y" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>ϵ</mi></msub><mo stretchy="false">→</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>ϵ</mi></msub></mrow><mo>+</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\epsilon}\to\sqrt{1-m_{v}}\zeta_{\epsilon}+\sqrt{m_{v}}y</annotation></semantics></math> to obtain expressions that are easier to compute numerically. This gives</p>
<table id="A3.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E160.m1" class="ltx_Math" alttext="\displaystyle m_{k}=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}\ ,\qquad m_{v}=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0.500em" rspace="2.167em">,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{k}=\frac{\hat{m}_{k}}{1+\hat{m}_{k}}\ ,\qquad m_{v}=\frac{\hat{m}_{v}}{1+\hat{m}_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(160)</span></td></tr></tbody>
<tbody id="A3.E161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E161.m1" class="ltx_math_unparsed" alttext="\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\left[(\partial_{\gamma_{1}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k}))^{2}e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}\right." display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mi>α</mi><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow></msup><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mo lspace="0em">∂</mo><msub><mi>γ</mi><mn>1</mn></msub></msub><msub><mi>h</mi><mi>ν</mi></msub><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\left[(\partial_{\gamma_{1}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k}))^{2}e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(161)</span></td></tr></tbody>
<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
