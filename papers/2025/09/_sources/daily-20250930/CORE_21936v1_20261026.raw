<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_Math" alttext="\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|z_{\mu}^{*},\epsilon_{\mu}^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\,e^{O_{\mu}^{a}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mi>N</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></munder></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><msubsup><mi>O</mi><mi>μ</mi><mi>a</mi></msubsup></msup></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|z_{\mu}^{*},\epsilon_{\mu}^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\,e^{O_{\mu}^{a}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
