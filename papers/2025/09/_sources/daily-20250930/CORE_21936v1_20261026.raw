<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left.{}+2(L-1)\partial_{\gamma_{1}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})\partial_{\gamma_{1}}h_{\nu}(2,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{(y-\sqrt{m_{v}}\zeta_{2})^{2}}{2(1-m_{v})}}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∂</mo><msub><mi>γ</mi><mn>1</mn></msub></msub><msub><mi>h</mi><mi>ν</mi></msub><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em">∂</mo><msub><mi>γ</mi><mn>1</mn></msub></msub><msub><mi>h</mi><mi>ν</mi></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left.{}+2(L-1)\partial_{\gamma_{1}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})\partial_{\gamma_{1}}h_{\nu}(2,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{(y-\sqrt{m_{v}}\zeta_{2})^{2}}{2(1-m_{v})}}\right]</annotation></semantics></math></td>
