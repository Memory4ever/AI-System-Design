<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\rho\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{*}\left(y,\frac{m_{k}}{\sqrt{q}_{k}}\xi,1-\frac{m_{k}^{2}}{q_{k}},\frac{m_{v}}{\sqrt{q_{v}}}\zeta,1-\frac{m_{v}^{2}}{q_{v}}\right)\log Z_{\mathrm{out}}^{\prime}\left(\sqrt{q_{v}}\xi,Q_{k}-q_{k},\sqrt{q_{v}}\zeta,Q_{v}-q_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ρ</mi><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>y</mi><msubsup><mi>Z</mi><mi>out</mi><mo>∗</mo></msubsup><mrow><mo>(</mo><mi>y</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>k</mi></msub><msub><msqrt><mi>q</mi></msqrt><mi>k</mi></msub></mfrac></mstyle><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>q</mi><mi>k</mi></msub></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>v</mi></msub><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt></mfrac></mstyle><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup><msub><mi>q</mi><mi>v</mi></msub></mfrac></mstyle><mo rspace="0.167em">)</mo></mrow><mi>log</mi><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mrow><mo>(</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mi>ξ</mi><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo>−</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><msub><mi>Q</mi><mi>v</mi></msub><mo>−</mo><msub><mi>q</mi><mi>v</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\rho\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{*}\left(y,\frac{m_{k}}{\sqrt{q}_{k}}\xi,1-\frac{m_{k}^{2}}{q_{k}},\frac{m_{v}}{\sqrt{q_{v}}}\zeta,1-\frac{m_{v}^{2}}{q_{v}}\right)\log Z_{\mathrm{out}}^{\prime}\left(\sqrt{q_{v}}\xi,Q_{k}-q_{k},\sqrt{q_{v}}\zeta,Q_{v}-q_{v}\right)</annotation></semantics></math></td>
