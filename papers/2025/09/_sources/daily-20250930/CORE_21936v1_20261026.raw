<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E132.m1" class="ltx_Math" alttext="\displaystyle Z_{\mathrm{out}}^{\prime}(\omega,V)=\int_{\mathbb{R}}\mathrm{d}\hat{y}\,e^{O}\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\int\mathrm{d}P_{\epsilon}(\epsilon)\,\tilde{g}_{\nu}(\epsilon,\chi)\hat{P}(\hat{y}|z,\chi,\epsilon)\prod_{l}^{L}\mathcal{N}\left(\left(\begin{smallmatrix}\chi_{l}\\
z_{l}\end{smallmatrix}\right);\omega_{l},V\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>out</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>O</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">|</mo><mrow><mi>z</mi><mo>,</mo><mi>χ</mi><mo>,</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi mathsize="0.700em">χ</mi><mi mathsize="0.700em">l</mi></msub></mtd></mtr><mtr><mtd><msub><mi mathsize="0.700em">z</mi><mi mathsize="0.700em">l</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>,</mo><msub><mi>ω</mi><mi>l</mi></msub><mo>,</mo><mi>V</mi><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\mathrm{out}}^{\prime}(\omega,V)=\int_{\mathbb{R}}\mathrm{d}\hat{y}\,e^{O}\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\int\mathrm{d}P_{\epsilon}(\epsilon)\,\tilde{g}_{\nu}(\epsilon,\chi)\hat{P}(\hat{y}|z,\chi,\epsilon)\prod_{l}^{L}\mathcal{N}\left(\left(\begin{smallmatrix}\chi_{l}\\
z_{l}\end{smallmatrix}\right);\omega_{l},V\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(132)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.5" class="ltx_p">and the observables <math id="A3.SS2.p2.m9" class="ltx_Math" alttext="O=sy(y-\hat{y})+t\beta(y-\hat{y})^{2}" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>=</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">O=sy(y-\hat{y})+t\beta(y-\hat{y})^{2}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.p3" class="ltx_para">
<p id="A3.SS2.p3.1" class="ltx_p">This expression of the free entropy can be simplified assuming that the order parameters <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="m,q,Q" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">m,q,Q</annotation></semantics></math> are diagonal. We numerically extremized <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> for the full order parameters from uninformed and informed initializations and we observed that the cross-terms <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="m_{kv^{*}},m_{vk^{*}},q_{kv}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub></mrow><annotation encoding="application/x-tex">m_{kv^{*}},m_{vk^{*}},q_{kv}</annotation></semantics></math>, <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="Q_{kv}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">Q_{kv}</annotation></semantics></math> and their conjugates go to 0. This simplification is similar to the one discussed in the main part for the population loss, though there is no direct relation with gradient descent and that we have the additional order parameter <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. We simplify the notations setting</p>
<table id="A3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E133.m1" class="ltx_Math" alttext="\displaystyle m_{k}=m_{kk^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle m_{k}=m_{kk^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E133.m2" class="ltx_Math" alttext="\displaystyle q_{k}=q_{kk^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>=</mo><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle q_{k}=q_{kk^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E133.m3" class="ltx_Math" alttext="\displaystyle Q_{k}=Q_{kk^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>k</mi></msub><mo>=</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle Q_{k}=Q_{kk^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(133)</span></td></tr></tbody>
<tbody id="A3.E134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E134.m1" class="ltx_Math" alttext="\displaystyle m_{v}=m_{kk^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle m_{v}=m_{kk^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E134.m2" class="ltx_Math" alttext="\displaystyle q_{v}=q_{vv^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>=</mo><msub><mi>q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle q_{v}=q_{vv^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E134.m3" class="ltx_Math" alttext="\displaystyle Q_{v}=Q_{vv^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>v</mi></msub><mo>=</mo><msub><mi>Q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle Q_{v}=Q_{vv^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(134)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p">and similarly for the conjugates. The set of order parameters becomes</p>
<table id="A3.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\Theta=(m_{k},\hat{m}_{k},m_{v},\hat{m}_{v},q_{k},\hat{q}_{k},q_{v},\hat{q}_{v},Q_{k},\hat{Q}_{k},Q_{v},\hat{Q}_{v})\in\mathbb{R}^{12}." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>v</mi></msub><mo>,</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>v</mi></msub><mo>,</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>12</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Theta=(m_{k},\hat{m}_{k},m_{v},\hat{m}_{v},q_{k},\hat{q}_{k},q_{v},\hat{q}_{v},Q_{k},\hat{Q}_{k},Q_{v},\hat{Q}_{v})\in\mathbb{R}^{12}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p3.3" class="ltx_p">The free entropy is now</p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E135.m1" class="ltx_Math" alttext="\displaystyle\phi(\Theta)=-\frac{1}{\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{2\alpha}(\hat{q}_{k}q_{k}+\hat{Q}_{k}Q_{k}+\hat{q}_{v}q_{v}+\hat{Q}_{v}Q_{v})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>v</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>v</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi(\Theta)=-\frac{1}{\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{2\alpha}(\hat{q}_{k}q_{k}+\hat{Q}_{k}Q_{k}+\hat{q}_{v}q_{v}+\hat{Q}_{v}Q_{v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(135)</span></td></tr></tbody>
<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle\quad{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{k}^{*}\left(\frac{\hat{m}_{k}}{\sqrt{\hat{q}_{k}}}\varsigma,\frac{\hat{m}_{k}^{2}}{\hat{q}_{k}}\right)\log Z_{k}\left(\sqrt{\hat{q}_{k}}\varsigma,\hat{q}_{k}+\hat{Q}_{k}\right)+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{v}^{*}\left(\frac{\hat{m}_{v}}{\sqrt{\hat{q}_{v}}}\varsigma,\frac{\hat{m}_{v}^{2}}{\hat{q}_{v}}\right)\log Z_{v}\left(\sqrt{\hat{q}_{v}}\varsigma,\hat{q}_{v}+\hat{Q}_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>k</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi><mn>2</mn></msubsup><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mi>v</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><msubsup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi><mn>2</mn></msubsup><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo>+</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{k}^{*}\left(\frac{\hat{m}_{k}}{\sqrt{\hat{q}_{k}}}\varsigma,\frac{\hat{m}_{k}^{2}}{\hat{q}_{k}}\right)\log Z_{k}\left(\sqrt{\hat{q}_{k}}\varsigma,\hat{q}_{k}+\hat{Q}_{k}\right)+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{v}^{*}\left(\frac{\hat{m}_{v}}{\sqrt{\hat{q}_{v}}}\varsigma,\frac{\hat{m}_{v}^{2}}{\hat{q}_{v}}\right)\log Z_{v}\left(\sqrt{\hat{q}_{v}}\varsigma,\hat{q}_{v}+\hat{Q}_{v}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{*}\left(y,\frac{m_{k}}{\sqrt{q}_{k}}\xi,1-\frac{m_{k}^{2}}{q_{k}},\frac{m_{v}}{\sqrt{q_{v}}}\zeta,1-\frac{m_{v}^{2}}{q_{v}}\right)\log Z_{\mathrm{out}}\left(y,\sqrt{q_{v}}\xi,Q_{k}-q_{k},\sqrt{q_{v}}\zeta,Q_{v}-q_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>y</mi><msubsup><mi>Z</mi><mi>out</mi><mo>∗</mo></msubsup><mrow><mo>(</mo><mi>y</mi><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>k</mi></msub><msub><msqrt><mi>q</mi></msqrt><mi>k</mi></msub></mfrac></mstyle><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup><msub><mi>q</mi><mi>k</mi></msub></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>v</mi></msub><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt></mfrac></mstyle><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup><msub><mi>q</mi><mi>v</mi></msub></mfrac></mstyle><mo rspace="0.167em">)</mo></mrow><mi>log</mi><msub><mi>Z</mi><mi>out</mi></msub><mrow><mo>(</mo><mi>y</mi><mo>,</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mi>ξ</mi><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo>−</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><msub><mi>Q</mi><mi>v</mi></msub><mo>−</mo><msub><mi>q</mi><mi>v</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{*}\left(y,\frac{m_{k}}{\sqrt{q}_{k}}\xi,1-\frac{m_{k}^{2}}{q_{k}},\frac{m_{v}}{\sqrt{q_{v}}}\zeta,1-\frac{m_{v}^{2}}{q_{v}}\right)\log Z_{\mathrm{out}}\left(y,\sqrt{q_{v}}\xi,Q_{k}-q_{k},\sqrt{q_{v}}\zeta,Q_{v}-q_{v}\right)</annotation></semantics></math></td>
