></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\quad\left[h_{\nu}(2,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{2})^{2}}+\sum_{l\neq 2}^{L}h_{\nu}(l,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}}\right]^{-1}</annotation></semantics></math></td>
