</div>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p">We introduce these overlaps via new Dirac deltas. We leverage the replica-symmetric assumption: we assume that there are <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="m_{kk^{*}},m_{vk^{*}},m_{kv^{*}},m_{vv^{*}},q_{kk},q_{kv},q_{vv},Q_{kk},Q_{kv},Q_{vv}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><msub><mi>q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><mrow><msub><mi>Q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>∈</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">m_{kk^{*}},m_{vk^{*}},m_{kv^{*}},m_{vv^{*}},q_{kk},q_{kv},q_{vv},Q_{kk},Q_{kv},Q_{vv}\in\mathbb{R}</annotation></semantics></math> such that for all <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math></p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E123.m1" class="ltx_Math" alttext="\displaystyle(\underline{m}_{kk^{*}})_{a}=m_{kk^{*}}\ ,\quad(\underline{m}_{vk^{*}})_{a}=m_{vk^{*}}\ ,\quad(\underline{m}_{kv^{*}})_{a}=m_{kv^{*}}\ ,\quad(\underline{m}_{vv^{*}})_{a}=m_{vv^{*}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>m</mi><mo stretchy="true">¯</mo></munder><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo stretchy="false">)</mo></mrow><mi>a</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>m</mi><mo stretchy="true">¯</mo></munder><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo stretchy="false">)</mo></mrow><mi>a</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>m</mi><mo stretchy="true">¯</mo></munder><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo stretchy="false">)</mo></mrow><mi>a</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>m</mi><mo stretchy="true">¯</mo></munder><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo stretchy="false">)</mo></mrow><mi>a</mi></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(\underline{m}_{kk^{*}})_{a}=m_{kk^{*}}\ ,\quad(\underline{m}_{vk^{*}})_{a}=m_{vk^{*}}\ ,\quad(\underline{m}_{kv^{*}})_{a}=m_{kv^{*}}\ ,\quad(\underline{m}_{vv^{*}})_{a}=m_{vv^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(123)</span></td></tr></tbody>
<tbody id="A3.E124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E124.m1" class="ltx_Math" alttext="\displaystyle(\underline{Q}_{kk})_{ab}=q_{kk}\delta_{a\neq b}+Q_{kk}\delta_{a=b}\ ,\quad(\underline{Q}_{kv})_{ab}=q_{kv}\delta_{a\neq b}+Q_{kv}\delta_{a=b}\ ,\quad(\underline{Q}_{vv})_{ab}=q_{vv}\delta_{a\neq b}+Q_{vv}\delta_{a=b}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>Q</mi><mo stretchy="true">¯</mo></munder><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>≠</mo><mi>b</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>=</mo><mi>b</mi></mrow></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>Q</mi><mo stretchy="true">¯</mo></munder><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>≠</mo><mi>b</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>=</mo><mi>b</mi></mrow></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><munder accentunder="true"><mi>Q</mi><mo stretchy="true">¯</mo></munder><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>≠</mo><mi>b</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo>=</mo><mi>b</mi></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(\underline{Q}_{kk})_{ab}=q_{kk}\delta_{a\neq b}+Q_{kk}\delta_{a=b}\ ,\quad(\underline{Q}_{kv})_{ab}=q_{kv}\delta_{a\neq b}+Q_{kv}\delta_{a=b}\ ,\quad(\underline{Q}_{vv})_{ab}=q_{vv}\delta_{a\neq b}+Q_{vv}\delta_{a=b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(124)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p">We pack these values into matrices</p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E125.m1" class="ltx_Math" alttext="\displaystyle m=\left(\begin{smallmatrix}m_{kk^{*}}&amp;m_{kv^{*}}\\
m_{vk^{*}}&amp;m_{vv^{*}}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi mathsize="0.700em">m</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">k</mi><mo mathsize="0.700em">∗</mo></msup></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">m</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">v</mi><mo mathsize="0.700em">∗</mo></msup></mrow></msub></mtd></mtr><mtr><mtd><msub><mi mathsize="0.700em">m</mi><mrow><mi mathsize="0.700em">v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">k</mi><mo mathsize="0.700em">∗</mo></msup></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">m</mi><mrow><mi mathsize="0.700em">v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">v</mi><mo mathsize="0.700em">∗</mo></msup></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle m=\left(\begin{smallmatrix}m_{kk^{*}}&amp;m_{kv^{*}}\\
m_{vk^{*}}&amp;m_{vv^{*}}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E125.m2" class="ltx_Math" alttext="\displaystyle q=\left(\begin{smallmatrix}q_{kk}&amp;q_{kv}\\
q_{kv}&amp;q_{vv}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi mathsize="0.700em">q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">k</mi></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi mathsize="0.700em">q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">q</mi><mrow><mi mathsize="0.700em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle q=\left(\begin{smallmatrix}q_{kk}&amp;q_{kv}\\
q_{kv}&amp;q_{vv}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E125.m3" class="ltx_Math" alttext="\displaystyle Q=\left(\begin{smallmatrix}Q_{kk}&amp;Q_{kv}\\
Q_{kv}&amp;Q_{vv}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi mathsize="0.700em">Q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">k</mi></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">Q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi mathsize="0.700em">Q</mi><mrow><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd><mtd><msub><mi mathsize="0.700em">Q</mi><mrow><mi mathsize="0.700em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">v</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle Q=\left(\begin{smallmatrix}Q_{kk}&amp;Q_{kv}\\
Q_{kv}&amp;Q_{vv}\end{smallmatrix}\right)\in\mathbb{R}^{2\times 2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(125)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p">We factorize the replica by introducing random Gaussian variables <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="\varsigma\sim\mathcal{N}(0,I_{2})" display="inline" intent=":literal"><semantics><mrow><mi>ς</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varsigma\sim\mathcal{N}(0,I_{2})</annotation></semantics></math>, <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="\xi\sim\mathcal{N}(0,I_{L})" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi\sim\mathcal{N}(0,I_{L})</annotation></semantics></math> and <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="\zeta\sim\mathcal{N}(0,I_{L})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta\sim\mathcal{N}(0,I_{L})</annotation></semantics></math>. After a standard computation (see e.g. <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib5" title="" class="ltx_ref">Aubin et al. [2020]</a></cite>) we obtain that the free entropy can be expressed as an extremum over the order parameters <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="\Theta=(m,q,Q)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=(m,q,Q)</annotation></semantics></math> and their conjugates <math id="A3.SS2.p2.m8" class="ltx_Math" alttext="\hat{\Theta}=(\hat{m}\in\mathbb{R}^{2\times 2},\hat{q}\in\mathbb{R}^{2\times 2},\hat{Q}\in\mathbb{R}^{2\times 2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo><mrow><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\Theta}=(\hat{m}\in\mathbb{R}^{2\times 2},\hat{q}\in\mathbb{R}^{2\times 2},\hat{Q}\in\mathbb{R}^{2\times 2})</annotation></semantics></math>:</p>
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E126.m1" class="ltx_Math" alttext="\displaystyle\phi=\max_{\Theta,\hat{\Theta}}\phi(\Theta,\hat{\Theta})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi mathvariant="normal">Θ</mi><mo>,</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi=\max_{\Theta,\hat{\Theta}}\phi(\Theta,\hat{\Theta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(126)</span></td></tr></tbody>
<tbody id="A3.E127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E127.m1" class="ltx_Math" alttext="\displaystyle\phi(\Theta,\hat{\Theta})=-\frac{1}{\alpha}\tr\hat{m}^{\top}m+\frac{1}{2\alpha}(\tr\hat{q}q+\tr\hat{Q}Q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>Tr</mi><mo lspace="0.167em" rspace="0em">​</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>Tr</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mrow><mrow><mi>Tr</mi><mo lspace="0.167em">⁡</mo><mover accent="true"><mi>Q</mi><mo>^</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi(\Theta,\hat{\Theta})=-\frac{1}{\alpha}\tr\hat{m}^{\top}m+\frac{1}{2\alpha}(\tr\hat{q}q+\tr\hat{Q}Q)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(127)</span></td></tr></tbody>
<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{kv}^{*}\left(\hat{m}^{\top}\hat{q}^{-1/2}\varsigma,\hat{m}^{\top}\hat{q}^{-1}\hat{m}\right)\log Z_{kv}\left(\hat{q}^{1/2}\varsigma,\hat{q}+\hat{Q}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>ς</mi></msub><msubsup><mi>Z</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∗</mo></msubsup><mrow><mo>(</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo>⊤</mo></msup><msup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ς</mi><mo>,</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo>⊤</mo></msup><msup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo rspace="0.167em">)</mo></mrow><mi>log</mi><msub><mi>Z</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mrow><mo>(</mo><msup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>ς</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo>+</mo><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}Z_{kv}^{*}\left(\hat{m}^{\top}\hat{q}^{-1/2}\varsigma,\hat{m}^{\top}\hat{q}^{-1}\hat{m}\right)\log Z_{kv}\left(\hat{q}^{1/2}\varsigma,\hat{q}+\hat{Q}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,Z_{\mathrm{out}}^{*}\left(y,mq^{-1/2}\left(\begin{smallmatrix}\xi^{\top}\\
\zeta^{\top}\end{smallmatrix}\right),1-m^{\top}qm\right)\log Z_{\mathrm{out}}\left(y,q^{1/2}\left(\begin{smallmatrix}\xi^{\top}\\
