<tbody id="A3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}{1-m_{v}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\frac{(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}{1-m_{v}}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E162.m1" class="ltx_Math" alttext="\displaystyle\quad\left[h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}+\sum_{l&gt;1}^{L}h_{\nu}(l,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}}\right]^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\quad\left[h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{1})^{2}}+\sum_{l&gt;1}^{L}h_{\nu}(l,\sqrt{m_{k}}\xi,1-m_{k})e^{-\frac{(y-\sqrt{m_{v}}\zeta_{l})^{2}}{2(1-m_{v})}}\right]^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(162)</span></td></tr></tbody>
<tbody id="A3.E163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E163.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}h_{\nu}(1,\sqrt{m_{k}}\xi,1-m_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(163)</span></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Specialization to the attention</h3>

<div id="A3.SS4.p1" class="ltx_para">
<p id="A3.SS4.p1.1" class="ltx_p">We consider the attention case, where the distributions <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="\tilde{P}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\tilde{P}_{k}</annotation></semantics></math>, <math id="A3.SS4.p1.m2" class="ltx_Math" alttext="\tilde{P}_{v}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi></msub><annotation encoding="application/x-tex">\tilde{P}_{v}</annotation></semantics></math> and <math id="A3.SS4.p1.m3" class="ltx_Math" alttext="\tilde{P}(y|X,\epsilon,k,v)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>P</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{P}(y|X,\epsilon,k,v)</annotation></semantics></math> do not match the distributions of the model. In this case it is more convenient to work with the variables</p>
<table id="A3.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E164.m1" class="ltx_Math" alttext="\displaystyle V_{k}=Q_{k}-q_{k}\ ,\quad\hat{V}_{k}=\hat{Q}_{k}+\hat{q}_{k}\ ,\quad V_{v}=Q_{v}-q_{v}\ ,\quad\hat{V}_{v}=\hat{Q}_{v}+\hat{q}_{v}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>V</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>Q</mi><mi>k</mi></msub><mo>−</mo><msub><mi>q</mi><mi>k</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>V</mi><mi>v</mi></msub><mo>=</mo><mrow><msub><mi>Q</mi><mi>v</mi></msub><mo>−</mo><msub><mi>q</mi><mi>v</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>v</mi></msub><mo>+</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle V_{k}=Q_{k}-q_{k}\ ,\quad\hat{V}_{k}=\hat{Q}_{k}+\hat{q}_{k}\ ,\quad V_{v}=Q_{v}-q_{v}\ ,\quad\hat{V}_{v}=\hat{Q}_{v}+\hat{q}_{v}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(164)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p1.2" class="ltx_p">We perform the changes <math id="A3.SS4.p1.m4" class="ltx_Math" alttext="\varsigma_{k}\to\varsigma_{k}+k^{*}\hat{m}_{k}/\sqrt{\hat{q}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ς</mi><mi>k</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>ς</mi><mi>k</mi></msub><mo>+</mo><mrow><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo>/</mo><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\varsigma_{k}\to\varsigma_{k}+k^{*}\hat{m}_{k}/\sqrt{\hat{q}_{k}}</annotation></semantics></math>, <math id="A3.SS4.p1.m5" class="ltx_Math" alttext="\varsigma_{v}\to\varsigma_{v}+v^{*}\hat{m}_{v}/\sqrt{\hat{q}_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ς</mi><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>ς</mi><mi>v</mi></msub><mo>+</mo><mrow><mrow><msup><mi>v</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><mo>/</mo><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\varsigma_{v}\to\varsigma_{v}+v^{*}\hat{m}_{v}/\sqrt{\hat{q}_{v}}</annotation></semantics></math>, <math id="A3.SS4.p1.m6" class="ltx_Math" alttext="\xi_{l}\to\xi_{l}\sqrt{q_{k}-m_{k}^{2}}/\sqrt{q_{k}}+\chi_{l}^{*}m_{k}/\sqrt{q_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>l</mi></msub><mo stretchy="false">→</mo><mrow><mrow><mrow><msub><mi>ξ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt></mrow><mo>/</mo><msqrt><msub><mi>q</mi><mi>k</mi></msub></msqrt></mrow><mo>+</mo><mrow><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo>/</mo><msqrt><msub><mi>q</mi><mi>k</mi></msub></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{l}\to\xi_{l}\sqrt{q_{k}-m_{k}^{2}}/\sqrt{q_{k}}+\chi_{l}^{*}m_{k}/\sqrt{q_{k}}</annotation></semantics></math> and <math id="A3.SS4.p1.m7" class="ltx_Math" alttext="\zeta_{l}\to\zeta_{l}\sqrt{q_{v}-m_{v}^{2}}/\sqrt{q_{v}}+z_{l}^{*}m_{v}/\sqrt{q_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>l</mi></msub><mo stretchy="false">→</mo><mrow><mrow><mrow><msub><mi>ζ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup></mrow></msqrt></mrow><mo>/</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt></mrow><mo>+</mo><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>v</mi></msub></mrow><mo>/</mo><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{l}\to\zeta_{l}\sqrt{q_{v}-m_{v}^{2}}/\sqrt{q_{v}}+z_{l}^{*}m_{v}/\sqrt{q_{v}}</annotation></semantics></math>. We deal with the limit <math id="A3.SS4.p1.m8" class="ltx_Math" alttext="\beta\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\beta\to\infty</annotation></semantics></math> by rescaling the parameters according to <math id="A3.SS4.p1.m9" class="ltx_Math" alttext="\hat{m}_{k}\to\beta\hat{m}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">→</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{m}_{k}\to\beta\hat{m}_{k}</annotation></semantics></math>, <math id="A3.SS4.p1.m10" class="ltx_Math" alttext="\hat{m}_{v}\to\beta\hat{m}_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{m}_{v}\to\beta\hat{m}_{v}</annotation></semantics></math>, <math id="A3.SS4.p1.m11" class="ltx_Math" alttext="\hat{q}_{k}\to\beta^{2}\hat{q}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{q}_{k}\to\beta^{2}\hat{q}_{k}</annotation></semantics></math>, <math id="A3.SS4.p1.m12" class="ltx_Math" alttext="\hat{q}_{v}\to\beta^{2}\hat{q}_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{q}_{v}\to\beta^{2}\hat{q}_{v}</annotation></semantics></math>, <math id="A3.SS4.p1.m13" class="ltx_Math" alttext="\hat{V}_{k}\to\beta\hat{V}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">→</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{V}_{k}\to\beta\hat{V}_{k}</annotation></semantics></math>, <math id="A3.SS4.p1.m14" class="ltx_Math" alttext="\hat{V}_{v}\to\beta\hat{V}_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{V}_{v}\to\beta\hat{V}_{v}</annotation></semantics></math> and <math id="A3.SS4.p1.m15" class="ltx_Math" alttext="V_{k}\to\beta^{-1}V_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>k</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V_{k}\to\beta^{-1}V_{k}</annotation></semantics></math>, <math id="A3.SS4.p1.m16" class="ltx_Math" alttext="V_{v}\to\beta^{-1}V_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>β</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V_{v}\to\beta^{-1}V_{v}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS4.p2" class="ltx_para">
<p id="A3.SS4.p2.1" class="ltx_p">We introduce the effective joint distribution of the data, for <math id="A3.SS4.p2.m1" class="ltx_Math" alttext="y\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">y\in\mathbb{R}</annotation></semantics></math>, <math id="A3.SS4.p2.m2" class="ltx_Math" alttext="\epsilon^{*}\in\{1,\ldots,L\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon^{*}\in\{1,\ldots,L\}</annotation></semantics></math>, <math id="A3.SS4.p2.m3" class="ltx_Math" alttext="\chi^{*}\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>χ</mi><mo>∗</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">\chi^{*}\in\mathbb{R}^{L}</annotation></semantics></math> and <math id="A3.SS4.p2.m4" class="ltx_Math" alttext="z^{*}\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">z^{*}\in\mathbb{R}^{L}</annotation></semantics></math>:</p>
<table id="A3.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E165.m1" class="ltx_Math" alttext="\displaystyle P^{*}(y,\epsilon^{*},\chi^{*},z^{*})=\frac{1}{L}g_{\nu}(\epsilon^{*},\chi^{*})P_{\mathrm{out}}(y|z_{\epsilon^{*}}^{*})\prod_{l}^{L}\mathcal{N}(\chi_{l}^{*};0,1)\mathcal{N}(z_{l}^{*};0,1)\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle P^{*}(y,\epsilon^{*},\chi^{*},z^{*})=\frac{1}{L}g_{\nu}(\epsilon^{*},\chi^{*})P_{\mathrm{out}}(y|z_{\epsilon^{*}}^{*})\prod_{l}^{L}\mathcal{N}(\chi_{l}^{*};0,1)\mathcal{N}(z_{l}^{*};0,1)\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(165)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p2.2" class="ltx_p">The free entropy is then</p>
<table id="A3.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{\beta}\phi(\Theta)=-\frac{1}{\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{2\alpha}\left(\frac{1}{\beta}V_{k}\hat{V}_{k}+q_{k}\hat{V}_{k}-V_{k}\hat{q}_{k}+\frac{1}{\beta}V_{v}\hat{V}_{v}+q_{v}\hat{V}_{v}-V_{v}\hat{q}_{v}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><mo>+</mo><mrow><msub><mi>q</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\phi(\Theta)=-\frac{1}{\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{2\alpha}\left(\frac{1}{\beta}V_{k}\hat{V}_{k}+q_{k}\hat{V}_{k}-V_{k}\hat{q}_{k}+\frac{1}{\beta}V_{v}\hat{V}_{v}+q_{v}\hat{V}_{v}-V_{v}\hat{q}_{v}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E166.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\frac{1}{\alpha\beta}\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,\log\int_{\mathbb{R}}\mathrm{d}k\,e^{\beta\psi_{k}(k)}+\frac{1}{\alpha\beta}\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,\log\int_{\mathbb{R}}\mathrm{d}v\,e^{\beta\psi_{v}(v)}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mi>ς</mi></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><msub><mi>P</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>∗</mo></msup><mo rspace="0.337em" stretchy="false">)</mo></mrow><mi>log</mi><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>k</mi><msup><mi>e</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mi>ς</mi></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><msub><mi>P</mi><mi>v</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>∗</mo></msup><mo rspace="0.337em" stretchy="false">)</mo></mrow><mi>log</mi><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>v</mi><msup><mi>e</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\frac{1}{\alpha\beta}\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,\log\int_{\mathbb{R}}\mathrm{d}k\,e^{\beta\psi_{k}(k)}+\frac{1}{\alpha\beta}\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,\log\int_{\mathbb{R}}\mathrm{d}v\,e^{\beta\psi_{v}(v)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(166)</span></td></tr></tbody>
<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad{}+\frac{1}{\beta}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\log\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\,\left(e^{\beta\psi_{\mathrm{out}}(\chi,z;1)}+\rho e^{\beta\psi_{\mathrm{out}}(\chi,z;0)+t\beta(y-\hat{y}_{\sigma}(z,\chi))^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mi>d</mi><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mi>d</mi><mi>χ</mi><mi>d</mi><mi>z</mi><mrow><mo lspace="0.170em">(</mo><msup><mi>e</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><mi>z</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><mi>ρ</mi><msup><mi>e</mi><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><mi>z</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}+\frac{1}{\beta}\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\log\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\,\left(e^{\beta\psi_{\mathrm{out}}(\chi,z;1)}+\rho e^{\beta\psi_{\mathrm{out}}(\chi,z;0)+t\beta(y-\hat{y}_{\sigma}(z,\chi))^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS4.p2.3" class="ltx_p">with the potentials</p>
<table id="A3.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E167.m1" class="ltx_Math" alttext="\displaystyle\psi_{k}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{k}(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E167.m2" class="ltx_Math" alttext="\displaystyle=-r_{k}\gamma(k)-\frac{1}{2}\hat{V}_{k}k^{2}+(\hat{m}_{k}k^{*}+\sqrt{\hat{q}_{k}}\varsigma)k" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>r</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-r_{k}\gamma(k)-\frac{1}{2}\hat{V}_{k}k^{2}+(\hat{m}_{k}k^{*}+\sqrt{\hat{q}_{k}}\varsigma)k</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(167)</span></td></tr></tbody>
<tbody id="A3.E168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E168.m1" class="ltx_Math" alttext="\displaystyle\psi_{v}(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{v}(v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E168.m2" class="ltx_Math" alttext="\displaystyle=-r_{v}\gamma(v)-\frac{1}{2}\hat{V}_{v}v^{2}+(\hat{m}_{v}v^{*}+\sqrt{\hat{q}_{v}}\varsigma)v" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>r</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ς</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-r_{v}\gamma(v)-\frac{1}{2}\hat{V}_{v}v^{2}+(\hat{m}_{v}v^{*}+\sqrt{\hat{q}_{v}}\varsigma)v</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(168)</span></td></tr></tbody>
<tbody id="A3.E169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E169.m1" class="ltx_Math" alttext="\displaystyle\psi_{\mathrm{out}}(\chi,z;\bar{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><mi>z</mi><mo>,</mo><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{\mathrm{out}}(\chi,z;\bar{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E169.m2" class="ltx_Math" alttext="\displaystyle=-\bar{t}\ell(y,\hat{y}_{\sigma}(z,\chi))+\sum_{l}^{L}\log\mathcal{N}(\chi_{l};\gamma_{l},V_{k})+\sum_{l}^{L}\log\mathcal{N}(z_{l};\omega_{l},V_{v})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>V</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>ω</mi><mi>l</mi></msub><mo>,</mo><msub><mi>V</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\bar{t}\ell(y,\hat{y}_{\sigma}(z,\chi))+\sum_{l}^{L}\log\mathcal{N}(\chi_{l};\gamma_{l},V_{k})+\sum_{l}^{L}\log\mathcal{N}(z_{l};\omega_{l},V_{v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(169)</span></td></tr></tbody>
<tbody id="A3.E170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E170.m1" class="ltx_Math" alttext="\displaystyle\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\displaystyle\gamma</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E170.m2" class="ltx_Math" alttext="\displaystyle=m_{k}\chi^{*}+\sqrt{q_{k}-m_{k}^{2}}\xi\ ,\qquad\omega=m_{v}z^{*}+\sqrt{q_{v}-m_{v}^{2}}\zeta" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow></mrow><mo lspace="0.500em" rspace="2.167em">,</mo><mrow><mi>ω</mi><mo>=</mo><mrow><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=m_{k}\chi^{*}+\sqrt{q_{k}-m_{k}^{2}}\xi\ ,\qquad\omega=m_{v}z^{*}+\sqrt{q_{v}-m_{v}^{2}}\zeta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(170)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p2.4" class="ltx_p"><math id="A3.SS4.p2.m5" class="ltx_Math" alttext="\bar{t}\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{t}\in\{0,1\}</annotation></semantics></math> controls whether the loss or the observable are active or not. We introduce the extremizers of these potentials:</p>
<table id="A3.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E171.m1" class="ltx_Math" alttext="\displaystyle k^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle k^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E171.m2" class="ltx_Math" alttext="\displaystyle=\argmax_{k}\psi_{k}(k)\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>k</mi></msub><mo>⁡</mo><msub><mi>ψ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\argmax_{k}\psi_{k}(k)\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E171.m3" class="ltx_Math" alttext="\displaystyle v^{\prime}=\argmax_{v}\psi_{v}(v)" display="inline" intent=":literal"><semantics><mrow><msup><mi>v</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>v</mi></msub><mo>⁡</mo><msub><mi>ψ</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle v^{\prime}=\argmax_{v}\psi_{v}(v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(171)</span></td></tr></tbody>
<tbody id="A3.E172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E172.m1" class="ltx_Math" alttext="\displaystyle\chi^{\prime},z^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>χ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\chi^{\prime},z^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E172.m2" class="ltx_Math" alttext="\displaystyle=\argmax_{\chi,z}\psi_{\mathrm{out}}(\chi,z;\bar{t}=1)\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mrow><mi>χ</mi><mo>,</mo><mi>z</mi></mrow></msub><mo>⁡</mo><msub><mi>ψ</mi><mi>out</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><mi>z</mi><mo>,</mo><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo>=</mo><mn>1</mn></mrow><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\argmax_{\chi,z}\psi_{\mathrm{out}}(\chi,z;\bar{t}=1)\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E172.m3" class="ltx_Math" alttext="\displaystyle\chi^{\prime\prime},z^{\prime\prime}=\argmax_{\chi,z}\psi_{\mathrm{out}}(\chi,z;\bar{t}=0)" display="inline" intent=":literal"><semantics><mrow><msup><mi>χ</mi><mo>′′</mo></msup><mo>,</mo><mrow><msup><mi>z</mi><mo>′′</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mrow><mi>χ</mi><mo>,</mo><mi>z</mi></mrow></msub><mo>⁡</mo><msub><mi>ψ</mi><mi>out</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo>,</mo><mi>z</mi><mo>,</mo><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\chi^{\prime\prime},z^{\prime\prime}=\argmax_{\chi,z}\psi_{\mathrm{out}}(\chi,z;\bar{t}=0)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(172)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p2.5" class="ltx_p">We introduce the covariances under these potentials around there maxima, with <math id="A3.SS4.p2.m6" class="ltx_Math" alttext="\nabla^{2}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mn>2</mn></msup><annotation encoding="application/x-tex">\nabla^{2}</annotation></semantics></math> the Hessian.</p>
<table id="A3.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E173.m1" class="ltx_Math" alttext="\displaystyle\cov(k)" display="inline" intent=":literal"><semantics><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cov(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E173.m2" class="ltx_Math" alttext="\displaystyle=-\left(\nabla^{2}\psi_{k}(k^{\prime})\right)^{-1}\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>ψ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\left(\nabla^{2}\psi_{k}(k^{\prime})\right)^{-1}\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E173.m3" class="ltx_Math" alttext="\displaystyle\cov(v)=-\left(\nabla^{2}\psi_{v}(v^{\prime})\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>ψ</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cov(v)=-\left(\nabla^{2}\psi_{v}(v^{\prime})\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(173)</span></td></tr></tbody>
<tbody id="A3.E174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E174.m1" class="ltx_Math" alttext="\displaystyle\cov\left(\chi_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cov\left(\chi_{l}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E174.m2" class="ltx_Math" alttext="\displaystyle=-\left(\left(\nabla^{2}\psi_{\mathrm{out}}(\chi^{\prime},z^{\prime};\bar{t}=1)\right)^{-1}\right)_{\chi_{l}}\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><msub><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>ψ</mi><mi>out</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>χ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo>,</mo><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow><msub><mi>χ</mi><mi>l</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\left(\left(\nabla^{2}\psi_{\mathrm{out}}(\chi^{\prime},z^{\prime};\bar{t}=1)\right)^{-1}\right)_{\chi_{l}}\ ,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E174.m3" class="ltx_Math" alttext="\displaystyle\cov\left(z_{l}\right)=-\left(\left(\nabla^{2}\psi_{\mathrm{out}}(\chi^{\prime},z^{\prime};\bar{t}=1)\right)^{-1}\right)_{z_{l}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>z</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><msub><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>ψ</mi><mi>out</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>χ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo>,</mo><mrow><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow><msub><mi>z</mi><mi>l</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cov\left(z_{l}\right)=-\left(\left(\nabla^{2}\psi_{\mathrm{out}}(\chi^{\prime},z^{\prime};\bar{t}=1)\right)^{-1}\right)_{z_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(174)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.p3" class="ltx_para">
<p id="A3.SS4.p3.1" class="ltx_p">The extremality condition of <math id="A3.SS4.p3.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> over the order parameters is obtained by setting its gradient to zero. We take the limit <math id="A3.SS4.p3.m2" class="ltx_Math" alttext="\rho=0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho=0</annotation></semantics></math>. It gives the following fixed-point equations:</p>
<table id="A3.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E175.m1" class="ltx_Math" alttext="\displaystyle m_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,k^{*}k^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,k^{*}k^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E175.m2" class="ltx_Math" alttext="\displaystyle m_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,v^{*}v^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>′</mo></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,v^{*}v^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(175)</span></td></tr></tbody>
<tbody id="A3.E176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E176.m1" class="ltx_Math" alttext="\displaystyle q_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,(k^{\prime})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}(k^{*})\,(k^{\prime})^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E176.m2" class="ltx_Math" alttext="\displaystyle q_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,(v^{\prime})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}(v^{*})\,(v^{\prime})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(176)</span></td></tr></tbody>
<tbody id="A3.E177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E177.m1" class="ltx_Math" alttext="\displaystyle V_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}\,\cov(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{k}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{k}\,\cov(k)</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E177.m2" class="ltx_Math" alttext="\displaystyle V_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}\,\cov(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>v</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>ς</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>v</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{v}=\mathbb{E}_{\varsigma}\int_{\mathbb{R}}\mathrm{d}P_{v}\,\cov(v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(177)</span></td></tr></tbody>
</table>
<p id="A3.SS4.p3.2" class="ltx_p">and</p>
<table id="A3.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E178.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}}\sum_{l}^{L}\left(\chi_{l}^{*}\chi_{l}^{\prime}-\frac{m_{k}}{V_{k}}\cov(\chi_{l})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msub><mi>V</mi><mi>k</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mi>l</mi><mi>L</mi></munderover><mrow><mo>(</mo><mrow><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>′</mo></msubsup></mrow><mo>−</mo><mrow><mfrac><msub><mi>m</mi><mi>k</mi></msub><msub><mi>V</mi><mi>k</mi></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}}\sum_{l}^{L}\left(\chi_{l}^{*}\chi_{l}^{\prime}-\frac{m_{k}}{V_{k}}\cov(\chi_{l})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(178)</span></td></tr></tbody>
<tbody id="A3.E179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E179.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}}\left(z_{\epsilon^{*}}^{*}z_{\epsilon^{*}}^{\prime}-\frac{m_{v}}{V_{v}}\cov(z_{\epsilon^{*}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msub><mi>V</mi><mi>v</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>′</mo></msubsup></mrow><mo>−</mo><mrow><mfrac><msub><mi>m</mi><mi>v</mi></msub><msub><mi>V</mi><mi>v</mi></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}}\left(z_{\epsilon^{*}}^{*}z_{\epsilon^{*}}^{\prime}-\frac{m_{v}}{V_{v}}\cov(z_{\epsilon^{*}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(179)</span></td></tr></tbody>
<tbody id="A3.E180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E180.m1" class="ltx_Math" alttext="\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}^{2}}\sum_{l}^{L}\left(\chi_{l}^{\prime}-m_{k}\chi_{l}^{*}-\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>k</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mi>l</mi><mi>L</mi></munderover><msup><mrow><mo>(</mo><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}^{2}}\sum_{l}^{L}\left(\chi_{l}^{\prime}-m_{k}\chi_{l}^{*}-\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(180)</span></td></tr></tbody>
<tbody id="A3.E181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E181.m1" class="ltx_Math" alttext="\displaystyle\hat{q}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}^{2}}\sum_{l}^{L}\left(z_{l}^{\prime}-m_{v}z_{l}^{*}-\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>v</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mi>l</mi><mi>L</mi></munderover><msup><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}^{2}}\sum_{l}^{L}\left(z_{l}^{\prime}-m_{v}z_{l}^{*}-\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(181)</span></td></tr></tbody>
<tbody id="A3.E182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E182.m1" class="ltx_Math" alttext="\displaystyle\hat{V}_{k}=\mathbb{E}_{L}\frac{\alpha L}{V_{k}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}^{2}}\sum_{l}^{L}\cov(\chi_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><msub><mi>V</mi><mi>k</mi></msub></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>k</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{V}_{k}=\mathbb{E}_{L}\frac{\alpha L}{V_{k}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{k}^{2}}\sum_{l}^{L}\cov(\chi_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(182)</span></td></tr></tbody>
<tbody id="A3.E183"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E183.m1" class="ltx_Math" alttext="\displaystyle\hat{V}_{v}=\mathbb{E}_{L}\frac{\alpha L}{V_{v}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}^{2}}\sum_{l}^{L}\cov(z_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><msub><mi>V</mi><mi>v</mi></msub></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>v</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{V}_{v}=\mathbb{E}_{L}\frac{\alpha L}{V_{v}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,\frac{1}{V_{v}^{2}}\sum_{l}^{L}\cov(z_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(183)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.p4" class="ltx_para">
<p id="A3.SS4.p4.1" class="ltx_p">At the fixed-point the test error is given by</p>
<table id="A3.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E184.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}(\alpha)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E184.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,(y-\hat{y}_{\sigma}(\chi^{\prime\prime},z^{\prime\prime}))^{2}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>χ</mi><mo>′′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\mathrm{d}P^{*}(y,\epsilon^{*},\chi^{*},z^{*})\,(y-\hat{y}_{\sigma}(\chi^{\prime\prime},z^{\prime\prime}))^{2}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(184)</span></td></tr></tbody>
</table>
</div>
<section id="A3.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.4.1 </span>Specializations to spiked- and max-SLR models</h4>

<div id="A3.SS4.SSS1.p1" class="ltx_para">
<p id="A3.SS4.SSS1.p1.1" class="ltx_p">We consider an attention trained with <math id="A3.SS4.SSS1.p1.m1" class="ltx_Math" alttext="l_{2}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mn>2</mn></msub><annotation encoding="application/x-tex">l_{2}</annotation></semantics></math> regularization <math id="A3.SS4.SSS1.p1.m2" class="ltx_Math" alttext="\gamma(x)=\frac{1}{2}x^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma(x)=\frac{1}{2}x^{2}</annotation></semantics></math>. The first fixed-point equations can be explicited</p>
<table id="A3.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E185.m1" class="ltx_Math" alttext="\displaystyle m_{k}=\frac{\hat{m}_{k}}{r_{k}+\hat{V}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle m_{k}=\frac{\hat{m}_{k}}{r_{k}+\hat{V}_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E185.m2" class="ltx_Math" alttext="\displaystyle m_{v}=\frac{\hat{m}_{v}}{r_{v}+\hat{V}_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mrow><msub><mi>r</mi><mi>v</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle m_{v}=\frac{\hat{m}_{v}}{r_{v}+\hat{V}_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(185)</span></td></tr></tbody>
<tbody id="A3.E186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E186.m1" class="ltx_Math" alttext="\displaystyle q_{k}=\frac{\hat{m}_{k}^{2}+\hat{q}_{k}}{(r_{k}+\hat{V}_{k})^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi><mn>2</mn></msubsup><mo>+</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle q_{k}=\frac{\hat{m}_{k}^{2}+\hat{q}_{k}}{(r_{k}+\hat{V}_{k})^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E186.m2" class="ltx_Math" alttext="\displaystyle q_{v}=\frac{\hat{m}_{v}^{2}+\hat{q}_{v}}{(r_{v}+\hat{V}_{v})^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi><mn>2</mn></msubsup><mo>+</mo><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>v</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle q_{v}=\frac{\hat{m}_{v}^{2}+\hat{q}_{v}}{(r_{v}+\hat{V}_{v})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(186)</span></td></tr></tbody>
<tbody id="A3.E187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E187.m1" class="ltx_Math" alttext="\displaystyle V_{k}=\frac{1}{r_{k}+\hat{V}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>k</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle V_{k}=\frac{1}{r_{k}+\hat{V}_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E187.m2" class="ltx_Math" alttext="\displaystyle V_{v}=\frac{1}{r_{v}+\hat{V}_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>v</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>r</mi><mi>v</mi></msub><mo>+</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle V_{v}=\frac{1}{r_{v}+\hat{V}_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(187)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.SSS1.p2" class="ltx_para">
<p id="A3.SS4.SSS1.p2.1" class="ltx_p">We can simplify the rest of the equations by using the permutation invariance w.r.t. the tokens to fix <math id="A3.SS4.SSS1.p2.m1" class="ltx_Math" alttext="\epsilon^{*}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\epsilon^{*}=1</annotation></semantics></math>. For the two models we have that, for <math id="A3.SS4.SSS1.p2.m2" class="ltx_Math" alttext="l\neq\epsilon^{*}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≠</mo><msup><mi>ϵ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">l\neq\epsilon^{*}</annotation></semantics></math>, <math id="A3.SS4.SSS1.p2.m3" class="ltx_Math" alttext="z_{l}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">z_{l}^{*}</annotation></semantics></math> is Gaussian under <math id="A3.SS4.SSS1.p2.m4" class="ltx_Math" alttext="P^{*}(y,\epsilon^{*},\chi^{*},z^{*})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{*}(y,\epsilon^{*},\chi^{*},z^{*})</annotation></semantics></math> and <math id="A3.SS4.SSS1.p2.m5" class="ltx_Math" alttext="m_{v}z_{l}^{*}+\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\sim\mathcal{N}(0,q_{v})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>q</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{v}z_{l}^{*}+\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\sim\mathcal{N}(0,q_{v})</annotation></semantics></math>, so we can integrate out <math id="A3.SS4.SSS1.p2.m6" class="ltx_Math" alttext="z_{l}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mi>l</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">z_{l}^{*}</annotation></semantics></math>. We assume that <math id="A3.SS4.SSS1.p2.m7" class="ltx_Math" alttext="P_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>out</mi></msub><annotation encoding="application/x-tex">P_{\mathrm{out}}</annotation></semantics></math> is the identity channel so <math id="A3.SS4.SSS1.p2.m8" class="ltx_Math" alttext="z^{*}_{\epsilon^{*}}=y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">z^{*}_{\epsilon^{*}}=y</annotation></semantics></math>. In the potential <math id="A3.SS4.SSS1.p2.m9" class="ltx_Math" alttext="\psi_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>out</mi></msub><annotation encoding="application/x-tex">\psi_{\mathrm{out}}</annotation></semantics></math> we have <math id="A3.SS4.SSS1.p2.m10" class="ltx_Math" alttext="\omega_{l}=m_{v}y\delta_{l,1}+\sqrt{q_{v}-m_{v}^{2}\delta_{l,1}}\zeta_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ω</mi><mi>l</mi></msub><mo>=</mo><mrow><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>l</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><mrow><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>l</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega_{l}=m_{v}y\delta_{l,1}+\sqrt{q_{v}-m_{v}^{2}\delta_{l,1}}\zeta_{l}</annotation></semantics></math> for all <math id="A3.SS4.SSS1.p2.m11" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. The joint distribution over data reduces to</p>
<table id="A3.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E188.m1" class="ltx_Math" alttext="\displaystyle P^{*}(y,\epsilon^{*},\chi^{*},z^{*})=P^{*}(y,\chi^{*})=\mathcal{N}(y;0,1)g_{\nu}(1,\chi^{*})\prod_{l}^{L}\mathcal{N}(\chi_{l}^{*};0,1)\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle P^{*}(y,\epsilon^{*},\chi^{*},z^{*})=P^{*}(y,\chi^{*})=\mathcal{N}(y;0,1)g_{\nu}(1,\chi^{*})\prod_{l}^{L}\mathcal{N}(\chi_{l}^{*};0,1)\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(188)</span></td></tr></tbody>
</table>
<p id="A3.SS4.SSS1.p2.2" class="ltx_p">Taking <math id="A3.SS4.SSS1.p2.m12" class="ltx_Math" alttext="y\sim\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\sim\mathcal{N}(0,1)</annotation></semantics></math> and <math id="A3.SS4.SSS1.p2.m13" class="ltx_Math" alttext="\chi^{*}\sim\mathcal{N}(0,I_{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>χ</mi><mo>∗</mo></msup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi^{*}\sim\mathcal{N}(0,I_{L})</annotation></semantics></math>, the fixed-point equations and the error are</p>
<table id="A3.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E189.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}}\sum_{l}^{L}\left(\chi_{l}^{*}\chi_{l}^{\prime}-\frac{m_{k}}{V_{k}}\cov(\chi_{l})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>V</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>′</mo></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>k</mi></msub><msub><mi>V</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}}\sum_{l}^{L}\left(\chi_{l}^{*}\chi_{l}^{\prime}-\frac{m_{k}}{V_{k}}\cov(\chi_{l})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(189)</span></td></tr></tbody>
<tbody id="A3.E190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E190.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}}\left(yz_{1}^{\prime}-\frac{m_{v}}{V_{v}}\cov(z_{1})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>V</mi><mi>v</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>v</mi></msub><msub><mi>V</mi><mi>v</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}}\left(yz_{1}^{\prime}-\frac{m_{v}}{V_{v}}\cov(z_{1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(190)</span></td></tr></tbody>
<tbody id="A3.E191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E191.m1" class="ltx_Math" alttext="\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}^{2}}\sum_{l}^{L}\left(\chi_{l}^{\prime}-m_{k}\chi_{l}^{*}-\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}^{2}}\sum_{l}^{L}\left(\chi_{l}^{\prime}-m_{k}\chi_{l}^{*}-\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(191)</span></td></tr></tbody>
<tbody id="A3.E192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E192.m1" class="ltx_Math" alttext="\displaystyle\hat{q}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}^{2}}\left(\left(z_{l}^{\prime}-m_{v}y-\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\right)^{2}+\sum_{l&gt;1}^{L}\left(z_{l}^{\prime}-\sqrt{q_{v}}\zeta_{l}\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>v</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>v</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>v</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{v}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}^{2}}\left(\left(z_{l}^{\prime}-m_{v}y-\sqrt{q_{v}-m_{v}^{2}}\zeta_{l}\right)^{2}+\sum_{l&gt;1}^{L}\left(z_{l}^{\prime}-\sqrt{q_{v}}\zeta_{l}\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(192)</span></td></tr></tbody>
<tbody id="A3.E193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E193.m1" class="ltx_Math" alttext="\displaystyle\hat{V}_{k}=\mathbb{E}_{L}\frac{\alpha L}{V_{k}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}^{2}}\sum_{l}^{L}\cov(\chi_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><msub><mi>V</mi><mi>k</mi></msub></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{V}_{k}=\mathbb{E}_{L}\frac{\alpha L}{V_{k}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{k}^{2}}\sum_{l}^{L}\cov(\chi_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(193)</span></td></tr></tbody>
<tbody id="A3.E194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E194.m1" class="ltx_Math" alttext="\displaystyle\hat{V}_{v}=\mathbb{E}_{L}\frac{\alpha L}{V_{v}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}^{2}}\sum_{l}^{L}\cov(z_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><msub><mi>V</mi><mi>v</mi></msub></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>v</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{V}_{v}=\mathbb{E}_{L}\frac{\alpha L}{V_{v}}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\frac{1}{V_{v}^{2}}\sum_{l}^{L}\cov(z_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(194)</span></td></tr></tbody>
<tbody id="A3.E195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E195.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}(\alpha)=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})(y-\hat{y}_{\sigma}(\chi^{\prime\prime},z^{\prime\prime}))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>χ</mi><mo>′′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}(\alpha)=\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})(y-\hat{y}_{\sigma}(\chi^{\prime\prime},z^{\prime\prime}))^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(195)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.SSS1.p3" class="ltx_para">
<p id="A3.SS4.SSS1.p3.1" class="ltx_p">For the spiked-SLR model we additionally have that <math id="A3.SS4.SSS1.p3.m1" class="ltx_Math" alttext="\chi_{l}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\chi_{l}^{*}</annotation></semantics></math> is Gaussian under <math id="A3.SS4.SSS1.p3.m2" class="ltx_Math" alttext="P^{*}(y,\chi^{*})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{*}(y,\chi^{*})</annotation></semantics></math>; so <math id="A3.SS4.SSS1.p3.m3" class="ltx_Math" alttext="m_{k}\chi_{l}^{*}+\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\sim\mathcal{N}(\sqrt{\nu}m_{k}\delta_{l,1},q_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>l</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{k}\chi_{l}^{*}+\sqrt{q_{k}-m_{k}^{2}}\xi_{l}\sim\mathcal{N}(\sqrt{\nu}m_{k}\delta_{l,1},q_{k})</annotation></semantics></math> and <math id="A3.SS4.SSS1.p3.m4" class="ltx_Math" alttext="\chi^{*}" display="inline" intent=":literal"><semantics><msup><mi>χ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\chi^{*}</annotation></semantics></math> can be integrated out. In the potential <math id="A3.SS4.SSS1.p3.m5" class="ltx_Math" alttext="\psi_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>out</mi></msub><annotation encoding="application/x-tex">\psi_{\mathrm{out}}</annotation></semantics></math> we have <math id="A3.SS4.SSS1.p3.m6" class="ltx_Math" alttext="\gamma_{l}=\sqrt{\nu}m_{k}\delta_{l,1}+\sqrt{q_{v}}\xi_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>l</mi></msub><mo>=</mo><mrow><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>l</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msqrt><msub><mi>q</mi><mi>v</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{l}=\sqrt{\nu}m_{k}\delta_{l,1}+\sqrt{q_{v}}\xi_{l}</annotation></semantics></math> for all <math id="A3.SS4.SSS1.p3.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. We have the simplifications</p>
<table id="A3.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E196.m1" class="ltx_Math" alttext="\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y}\frac{1}{V_{k}}\left(\sqrt{\nu}\chi_{1}^{\prime}-\nu m_{k}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>V</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{m}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y}\frac{1}{V_{k}}\left(\sqrt{\nu}\chi_{1}^{\prime}-\nu m_{k}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(196)</span></td></tr></tbody>
<tbody id="A3.E197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E197.m1" class="ltx_Math" alttext="\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y}\frac{1}{V_{k}^{2}}\left(\left(\chi_{1}^{\prime}-\sqrt{\nu}m_{k}-\sqrt{q_{k}}\xi_{1}\right)^{2}+\sum_{l&gt;1}^{L}\left(\chi_{l}^{\prime}-\sqrt{q_{k}}\xi_{l}\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>V</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mi>χ</mi><mn>1</mn><mo>′</mo></msubsup><mo>−</mo><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo>−</mo><mrow><msqrt><msub><mi>q</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mn>1</mn></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>χ</mi><mi>l</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msqrt><msub><mi>q</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{q}_{k}=\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y}\frac{1}{V_{k}^{2}}\left(\left(\chi_{1}^{\prime}-\sqrt{\nu}m_{k}-\sqrt{q_{k}}\xi_{1}\right)^{2}+\sum_{l&gt;1}^{L}\left(\chi_{l}^{\prime}-\sqrt{q_{k}}\xi_{l}\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(197)</span></td></tr></tbody>
</table>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Details on the numerics</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Training of the attention</h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">The attention eq. (<a href="#S3.E4" title="Equation 4 ‣ 3.3 Learning with attention ‣ 3 Task and data model ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) is trained using LBFGS on the full batch until convergence. The parameters <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> are initialized randomly according to a standard Gaussian <math id="A4.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{N}(0,I_{D})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,I_{D})</annotation></semantics></math>.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.1" class="ltx_p">In Fig. <a href="#S5.F2" title="Figure 2 ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> the regularizations <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="r_{k}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>k</mi></msub><annotation encoding="application/x-tex">r_{k}</annotation></semantics></math> and <math id="A4.SS1.p2.m2" class="ltx_Math" alttext="r_{v}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>v</mi></msub><annotation encoding="application/x-tex">r_{v}</annotation></semantics></math> are tuned by grid search to minimize the test error, over <math id="A4.SS1.p2.m3" class="ltx_Math" alttext="\{0.3,1,3,10\}^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0.3</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>10</mn></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\{0.3,1,3,10\}^{2}</annotation></semantics></math> for the linear attention and <math id="A4.SS1.p2.m4" class="ltx_Math" alttext="\{0.03,0.1,0.3,1\}^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0.03</mn><mo>,</mo><mn>0.1</mn><mo>,</mo><mn>0.3</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\{0.03,0.1,0.3,1\}^{2}</annotation></semantics></math> for the softmax. These values were determined according to Fig. <a href="#A5.F6" title="Figure 6 ‣ Appendix E Additional figures ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
<div id="A4.SS1.p3" class="ltx_para">
<p id="A4.SS1.p3.1" class="ltx_p">For most of the parameters of the data model we explored the training converges to the global minimum of the training loss eq. (<a href="#S5.E15" title="Equation 15 ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>), in the sense that the training loss of trained attention is equal to the training loss predicted by our asymptotic characterization.</p>
</div>
<div id="A4.SS1.p4" class="ltx_para">
<p id="A4.SS1.p4.1" class="ltx_p">In a few cases, in particular at low signal and low regularization, the training does not converge towards the global minimum of the loss, which results in a discrepancy between the simulated performances and the predicted ones. In these cases we train the attention starting from an informed initialization <math id="A4.SS1.p4.m1" class="ltx_Math" alttext="v=v^{*}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">v=v^{*}</annotation></semantics></math> and <math id="A4.SS1.p4.m2" class="ltx_Math" alttext="k=k^{*}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">k=k^{*}</annotation></semantics></math>. Note that this initialization does not necessary correspond to a minimum of the loss. The performances of the trained attention then better matches our predictions, as depicted in Fig. <a href="#A5.F6" title="Figure 6 ‣ Appendix E Additional figures ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> for the softmax on the max-SLR. We checked that the achieved training loss is well smaller than the one starting from a random initialization.</p>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Computation of the asymptotic characterization</h3>

<section id="A4.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.2.1 </span>BO</h4>

<div id="A4.SS2.SSS1.p1" class="ltx_para">
<p id="A4.SS2.SSS1.p1.1" class="ltx_p">We compute the BO performance stated in result <a href="#A2.Thmresult1" title="Result B.1 (Bayes-optimal risk). ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> by iterating the fixed point equations given by the condition <math id="A4.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\nabla\phi_{\mathrm{BO}}(m_{k},m_{v})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>ϕ</mi><mi>BO</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla\phi_{\mathrm{BO}}(m_{k},m_{v})=0</annotation></semantics></math>. These equations are detailed in appendices <a href="#A3.SS3.SSS1" title="C.3.1 Specialization to spiked-SLR ‣ C.3 Specialization to the BO ‣ Appendix C Asymptotic characterization at finite sampling ratio: replica ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3.1</span></a> and <a href="#A3.SS3.SSS2" title="C.3.2 Specialization to the max-SLR model ‣ C.3 Specialization to the BO ‣ Appendix C Asymptotic characterization at finite sampling ratio: replica ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3.2</span></a> for the two models. The uninformed initialization corresponds to <math id="A4.SS2.SSS1.p1.m2" class="ltx_Math" alttext="m_{k},m_{v}=0.1,0.1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mn>0.1</mn></mrow><mo>,</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">m_{k},m_{v}=0.1,0.1</annotation></semantics></math> while the informed initialization corresponds to <math id="A4.SS2.SSS1.p1.m3" class="ltx_Math" alttext="m_{k},m_{v}=1-10^{-2},1-10^{-2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">m_{k},m_{v}=1-10^{-2},1-10^{-2}</annotation></semantics></math>. The expectation over the Gaussian random variables is computed over <math id="A4.SS2.SSS1.p1.m4" class="ltx_Math" alttext="10^{6}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>6</mn></msup><annotation encoding="application/x-tex">10^{6}</annotation></semantics></math> and <math id="A4.SS2.SSS1.p1.m5" class="ltx_Math" alttext="10^{5}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>5</mn></msup><annotation encoding="application/x-tex">10^{5}</annotation></semantics></math> Monte-Carlo samples respectively for the spiked-SLR and the max-SLR models.</p>
</div>
</section>
<section id="A4.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.2.2 </span>Attention</h4>

<div id="A4.SS2.SSS2.p1" class="ltx_para">
<p id="A4.SS2.SSS2.p1.1" class="ltx_p">We compute the performance of the attention stated in result <a href="#S5.Thmresult1" title="Result 5.1 (Test risk for attention-based predictors). ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> by iterating the given equations. We use Steffensen’s method to speed up the convergence. For the spiked-SLR a simplification of the equations is given in Appendix <a href="#A3.SS4.SSS1" title="C.4.1 Specializations to spiked- and max-SLR models ‣ C.4 Specialization to the attention ‣ Appendix C Asymptotic characterization at finite sampling ratio: replica ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4.1</span></a>. The expectation over the Gaussian random variables is computed over <math id="A4.SS2.SSS2.p1.m1" class="ltx_Math" alttext="10^{5}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>5</mn></msup><annotation encoding="application/x-tex">10^{5}</annotation></semantics></math> Monte-Carlo samples. For each sample at each iteration the extremizers of <math id="A4.SS2.SSS2.p1.m2" class="ltx_Math" alttext="\psi_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>out</mi></msub><annotation encoding="application/x-tex">\psi_{\mathrm{out}}</annotation></semantics></math> are computed using a quasi-Newton optimization scheme. The optimization is started at the extremizers computed at the previous step.</p>
</div>
<div id="A4.SS2.SSS2.p2" class="ltx_para">
<p id="A4.SS2.SSS2.p2.1" class="ltx_p">Notice that <math id="A4.SS2.SSS2.p2.m1" class="ltx_Math" alttext="\psi_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>out</mi></msub><annotation encoding="application/x-tex">\psi_{\mathrm{out}}</annotation></semantics></math> is not convex and may admit several maxima. In practice, for most of the values of <math id="A4.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, <math id="A4.SS2.SSS2.p2.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, <math id="A4.SS2.SSS2.p2.m4" class="ltx_Math" alttext="V_{k}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>k</mi></msub><annotation encoding="application/x-tex">V_{k}</annotation></semantics></math> and <math id="A4.SS2.SSS2.p2.m5" class="ltx_Math" alttext="V_{v}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>v</mi></msub><annotation encoding="application/x-tex">V_{v}</annotation></semantics></math>, <math id="A4.SS2.SSS2.p2.m6" class="ltx_Math" alttext="\psi_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>out</mi></msub><annotation encoding="application/x-tex">\psi_{\mathrm{out}}</annotation></semantics></math> admits a unique maximum. When it is not the case (in particular at low signal and low regularization) one should compare several different initializations of the optimization algorithm to find the global maximum. We tried on a few cases; it appeared that the final predictions do not change by a quantity greater than the fluctuations due to the randomness.</p>
</div>
<div id="A4.SS2.SSS2.p3" class="ltx_para">
<p id="A4.SS2.SSS2.p3.1" class="ltx_p">The minimum over the set <math id="A4.SS2.SSS2.p3.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> of fixed points is computed by running the iterations of result <a href="#S5.Thmresult1" title="Result 5.1 (Test risk for attention-based predictors). ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> from several initializations. We considered informed initialization <math id="A4.SS2.SSS2.p3.m2" class="ltx_Math" alttext="(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(1,1,0,0,\varepsilon,\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>v</mi></msub><mo>,</mo><msub><mi>V</mi><mi>k</mi></msub><mo>,</mo><msub><mi>V</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi>ε</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(1,1,0,0,\varepsilon,\varepsilon)</annotation></semantics></math> for small <math id="A4.SS2.SSS2.p3.m3" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>, partially informed initializations <math id="A4.SS2.SSS2.p3.m4" class="ltx_Math" alttext="(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(1,1,1,1,1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>v</mi></msub><mo>,</mo><msub><mi>V</mi><mi>k</mi></msub><mo>,</mo><msub><mi>V</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(1,1,1,1,1,1)</annotation></semantics></math> and uninformed initializations <math id="A4.SS2.SSS2.p3.m5" class="ltx_Math" alttext="(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(0,0,1,1,1,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo>,</mo><msub><mi>q</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>v</mi></msub><mo>,</mo><msub><mi>V</mi><mi>k</mi></msub><mo>,</mo><msub><mi>V</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(m_{k},m_{v},q_{k},q_{v},V_{k},V_{v})=(0,0,1,1,1,1)</annotation></semantics></math>. We performed a few different runs, adding small randomness to the initial condition. For all the values of the parameters, the obtained fixed point did not depend on the choice of the initialization, up to some small numerical fluctuations. These fluctuations are larger at small regularizations and low signals, in which case we select the run which reaches the highest free entropy eq. (<a href="#A3.E166" title="Equation 166 ‣ C.4 Specialization to the attention ‣ Appendix C Asymptotic characterization at finite sampling ratio: replica ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">166</span></a>), i.e. the lowest train loss, among those that converged before a certain amount of iterations.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Additional figures</h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">We provide an additional figure for the result <a href="#S5.Thmresult1" title="Result 5.1 (Test risk for attention-based predictors). ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> about the test risk of the attention at finite <math id="A5.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. Fig. <a href="#A5.F6" title="Figure 6 ‣ Appendix E Additional figures ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> gives the test risk <math id="A5.p1.m2" class="ltx_Math" alttext="\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}</annotation></semantics></math> for the same configurations as in Fig. <a href="#S5.F2" title="Figure 2 ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> for several additional regularizations <math id="A5.p1.m3" class="ltx_Math" alttext="r_{k}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>k</mi></msub><annotation encoding="application/x-tex">r_{k}</annotation></semantics></math> and <math id="A5.p1.m4" class="ltx_Math" alttext="r_{v}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>v</mi></msub><annotation encoding="application/x-tex">r_{v}</annotation></semantics></math>. It justifies the ranges of the grid search for the linear and the softmax attention in Fig. <a href="#S5.F2" title="Figure 2 ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, in the sense that <math id="A5.p1.m5" class="ltx_Math" alttext="\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}</annotation></semantics></math> seems to reach its minimal value for regularizations close to the ones considered in Fig. <a href="#A5.F6" title="Figure 6 ‣ Appendix E Additional figures ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Moreover it shows the excellent agreement between our theory result <a href="#S5.Thmresult1" title="Result 5.1 (Test risk for attention-based predictors). ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> and the simulations. We observe a discrepancy for the softmax at small regularization for the spiked-SLR at <math id="A5.p1.m6" class="ltx_Math" alttext="\nu=1" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\nu=1</annotation></semantics></math> or the max-SLR at <math id="A5.p1.m7" class="ltx_Math" alttext="\nu=+\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\nu=+\infty</annotation></semantics></math>. For the spiked-SLR it may be caused by the replica-symmetry assumption being false or the numerical errors in the resolution of the fixed point equations. For the max-SLR at <math id="A5.p1.m8" class="ltx_Math" alttext="r_{k}=r_{v}=0.03" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>k</mi></msub><mo>=</mo><msub><mi>r</mi><mi>v</mi></msub><mo>=</mo><mn>0.03</mn></mrow><annotation encoding="application/x-tex">r_{k}=r_{v}=0.03</annotation></semantics></math> we observe that initializing the simulations at the informed point <math id="A5.p1.m9" class="ltx_Math" alttext="k=k^{*},v=v^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mi>v</mi><mo>=</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">k=k^{*},v=v^{*}</annotation></semantics></math> leads to an agreement with our theory. This shows that in this case the local optimization cannot recover the global minimum of the loss from random initialization.</p>
</div>
<figure id="A5.F6" class="ltx_figure"><object type="image/svg+xml" data="2509.21936v1/att.svg" id="A5.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/297;" width="476" height="297"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>
Test error of the trained attention, linear (top) and softmax (bottom), across different tasks and signal strengths <math id="A5.F6.m11" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>, for <math id="A5.F6.m12" class="ltx_Math" alttext="L=3" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">L=3</annotation></semantics></math>. Solid lines indicate <math id="A5.F6.m13" class="ltx_Math" alttext="\mathsf{E}_{\sigma}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}(\alpha)</annotation></semantics></math> at finite <math id="A5.F6.m14" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> (Result <a href="#S5.Thmresult1" title="Result 5.1 (Test risk for attention-based predictors). ‣ 5 Performance of the attention at finite sample complexity ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>), while markers represent the test error of an ERM approximated via a local optimization method with <math id="A5.F6.m15" class="ltx_Math" alttext="\sqrt{ND}=10^{4}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msqrt><mo>=</mo><msup><mn>10</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\sqrt{ND}=10^{4}</annotation></semantics></math> and averaged over ten instances. Random initialization means that the attention is initialized at random <math id="A5.F6.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A5.F6.m17" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> while informed initialization means it is initialized at <math id="A5.F6.m18" class="ltx_Math" alttext="k=k^{*},v=v^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mi>v</mi><mo>=</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">k=k^{*},v=v^{*}</annotation></semantics></math>.
Dashed lines correspond to the value of <math id="A5.F6.m19" class="ltx_Math" alttext="\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}</annotation></semantics></math> in the infinite-<math id="A5.F6.m20" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> limit (see closed-formed formulas in Proposition <a href="#S4.Thmproposition1" title="Proposition 4.1. ‣ 4.1 Bayes risk and optimality of softmax ‣ 4 Comparison of softmax with alternatives in population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> for softmax and Appendix <a href="#A1.SS2.SSS7" title="A.2.7 Minimizer for the linear attention ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.7</span></a> for linear). The Bayes-optimal risk is shown in black (see <a href="#A2" title="Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">B</span></a> for a discussion on its discontinuity). Appendix <a href="#A4" title="Appendix D Details on the numerics ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a> includes more experimental details.</figcaption>
</figure>
</section>
</article>
</div>
</div>
