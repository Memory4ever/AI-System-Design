on encoding="application/x-tex">\displaystyle\quad{}+\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int\frac{\mathrm{d}y}{\sqrt{2\pi}}\,e^{-\frac{1}{2}y^{2}}\left[(L-1)(\partial_{\gamma_{1}}h_{\nu}(2,\sqrt{m_{k}}\xi,1-m_{k}))^{2}e^{-\frac{1}{2}(\sqrt{1-m_{v}}y-\sqrt{m_{v}}\zeta_{2})^{2}}\right.</annotation></semantics></math></td>
