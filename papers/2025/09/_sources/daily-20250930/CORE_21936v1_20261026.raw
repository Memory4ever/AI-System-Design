<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E22.m1" class="ltx_Math" alttext="\displaystyle\begin{pmatrix}\hat{V}_{k}^{t}\\
\hat{V}_{v}^{t}\end{pmatrix}=\alpha\mathbb{E}_{L}L\begin{pmatrix}(V_{k}^{t})^{-1}\\
(V_{v}^{t})^{-1}\end{pmatrix}-\alpha\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta,y,\chi^{*}}g_{\nu}(1,\chi^{*})\sum_{l=1}^{L}\begin{pmatrix}(V_{k}^{t})^{-2}\cov(\chi_{\ell})\\
(V_{v}^{t})^{-2}\cov(z_{\ell})\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo>^</mo></mover><mi mathsize="0.900em">k</mi><mi mathsize="0.900em">t</mi></msubsup></mtd></mtr><mtr><mtd><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo>^</mo></mover><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">t</mi></msubsup></mtd></mtr></mtable><mo>)</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mrow><mi mathsize="0.900em">α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><mi mathsize="0.900em">L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">k</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mtd></mtr><mtr><mtd><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><mi mathsize="0.900em">L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">ξ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">ζ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">,</mo><msup><mi mathsize="0.900em">χ</mi><mo mathsize="0.900em">∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">,</mo><msup><mi mathsize="0.900em">χ</mi><mo mathsize="0.900em">∗</mo></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">l</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">L</mi></munderover></mstyle><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">k</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">χ</mi><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation enco