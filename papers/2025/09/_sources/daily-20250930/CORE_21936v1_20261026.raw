<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle\left.\quad{}+m_{vv^{*}}^{2}(R_{vk}^{2}+R_{kk}^{2})z^{*\top}z^{*}+m_{kk^{*}}^{2}(R_{vv}^{2}+R_{vk}^{2})\chi^{*\top}\chi^{*}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msubsup><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left.\quad{}+m_{vv^{*}}^{2}(R_{vk}^{2}+R_{kk}^{2})z^{*\top}z^{*}+m_{kk^{*}}^{2}(R_{vv}^{2}+R_{vk}^{2})\chi^{*\top}\chi^{*}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.\quad{}+2m_{vv^{*}}m_{kv^{*}}m_{vk^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+2m_{vv^{*}}m_{kv^{*}}m_{vk^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>z</mi><mo>∗</mo></msup><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mi>χ</mi><mo>∗</mo></msup><mo>+</mo><mn>2</mn><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mi>z</mi><mo>∗</mo></msup><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>χ</mi><mo>∗</mo></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\quad{}+2m_{vv^{*}}m_{kv^{*}}m_{vk^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+2m_{vv^{*}}m_{kv^{*}}m_{vk^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS5.p2.2" class="ltx_p">The Hessian is diagonal and positive with respect to <math id="A1.SS2.SSS5.p2.m5" class="ltx_Math" alttext="R_{vv},R_{kk}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">R_{vv},R_{kk}</annotation></semantics></math> and <math id="A1.SS2.SSS5.p2.m6" class="ltx_Math" alttext="R_{kv}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">R_{kv}</annotation></semantics></math>; and consequently <math id="A1.SS2.SSS5.p2.m7" class="ltx_Math" alttext="R_{vv},R_{kk},R_{kv}=0,0,0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><mrow><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{vv},R_{kk},R_{kv}=0,0,0</annotation></semantics></math> is well stable. The Hessian in the two remaining directions <math id="A1.SS2.SSS5.p2.m8" class="ltx_Math" alttext="m_{vk^{*}}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><annotation encoding="application/x-tex">m_{vk^{*}}</annotation></semantics></math> and <math id="A1.SS2.SSS5.p2.m9" class="ltx_Math" alttext="m_{kv^{*}}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><annotation encoding="application/x-tex">m_{kv^{*}}</annotation></semantics></math> reads</p>
<table id="A1.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E75.m1" class="ltx_Math" alttext="\displaystyle\partial^{2}_{m_{vk^{*}},m_{vk^{*}}}\tilde{\mathcal{E}}_{\sigma}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∂</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><mn>2</mn></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\partial^{2}_{m_{vk^{*}},m_{vk^{*}}}\tilde{\mathcal{E}}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E75.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left((1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left((1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
<tbody id="A1.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E76.m1" class="ltx_Math" alttext="\displaystyle\partial^{2}_{m_{kv^{*}},m_{kv^{*}}}\tilde{\mathcal{E}}_{\sigma}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∂</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow><mn>2</mn></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\partial^{2}_{m_{kv^{*}},m_{kv^{*}}}\tilde{\mathcal{E}}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E76.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}m_{vv^{*}}^{2}\left(z^{*\top}z^{*}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}m_{vv^{*}}^{2}\left(z^{*\top}z^{*}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
<tbody id="A1.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E77.m1" class="ltx_Math" alttext="\displaystyle\partial^{2}_{m_{kv^{*}},m_{vk^{*}}}\tilde{\mathcal{E}}_{\sigma}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∂</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><mn>2</mn></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\partial^{2}_{m_{kv^{*}},m_{vk^{*}}}\tilde{\mathcal{E}}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E77.m2" class="ltx_Math" alttext="\displaystyle=2\mathbb{E}\left[-\chi_{\epsilon^{*}}^{*}+m_{vv^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+m_{vv^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2\mathbb{E}\left[-\chi_{\epsilon^{*}}^{*}+m_{vv^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+m_{vv^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS5.p2.3" class="ltx_p">where we used the shorthand <math id="A1.SS2.SSS5.p2.m10" class="ltx_Math" alttext="\mathbb{E}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">\mathbb{E}</annotation></semantics></math> for <math id="A1.SS2.SSS5.p2.m11" class="ltx_Math" alttext="\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*},z^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*},z^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})</annotation></semantics></math>. The trace of the Hessian is positive. The determinant of the Hessian is</p>
<table id="A1.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E78.m1" class="ltx_Math" alttext="\displaystyle\det" display="inline" intent=":literal"><semantics><mo movablelimits="false">det</mo><annotation encoding="application/x-tex">\displaystyle\det</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E78.m2" class="ltx_Math" alttext="\displaystyle=m_{vv^{*}}^{2}\mathbb{E}\left((1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}\right)^{2}\mathbb{E}\left(z^{*\top}z^{*}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=m_{vv^{*}}^{2}\mathbb{E}\left((1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}\right)^{2}\mathbb{E}\left(z^{*\top}z^{*}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\displaystyle\quad{}-\left(\mathbb{E}\left[-\chi_{\epsilon^{*}}^{*}+m_{vv^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+m_{vv^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad{}-\left(\mathbb{E}\left[-\chi_{\epsilon^{*}}^{*}+m_{vv^{*}}z^{*\top}z^{*}(1+m_{kk^{*}}\chi^{*})^{\top}\chi^{*}+m_{vv^{*}}(1+m_{kk^{*}}\chi^{*})^{\top}z^{*}z^{*\top}\chi^{*}\right]\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS5.p2.4" class="ltx_p">We evaluate this quantity at <math id="A1.SS2.SSS5.p2.m12" class="ltx_Math" alttext="m_{vv^{*}},m_{kk^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">m_{vv^{*}},m_{kk^{*}}</annotation></semantics></math> the minimizers of the loss on the manifold, for all the configurations considered in the article. We find that <math id="A1.SS2.SSS5.p2.m13" class="ltx_math_unparsed" alttext="\det&gt;0" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">det</mo><mo lspace="0.1389em">&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\det&gt;0</annotation></semantics></math> and consequently the Hessian at the fixed point is positive, that is to say the fixed point on the manifold is a local minimizer on <math id="A1.SS2.SSS5.p2.m14" class="ltx_Math" alttext="\mathbb{R}^{7}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>7</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{7}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS2.SSS6" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.6 </span>Other possible minima</h4>

<div id="A1.SS2.SSS6.p1" class="ltx_para">
<p id="A1.SS2.SSS6.p1.1" class="ltx_p">We numerically show that if one does not restrict the space of the parameters to <math id="A1.SS2.SSS6.p1.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>, <math id="A1.SS2.SSS6.p1.m2" class="ltx_Math" alttext="\mathcal{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\sigma}</annotation></semantics></math> can admit several minima. Yet, among them, the minimum reached on <math id="A1.SS2.SSS6.p1.m3" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> is the best.</p>
</div>
<div id="A1.SS2.SSS6.p2" class="ltx_para">
<p id="A1.SS2.SSS6.p2.1" class="ltx_p">We perform a local minimization of <math id="A1.SS2.SSS6.p2.m1" class="ltx_Math" alttext="\tilde{\mathcal{E}}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub><annotation encoding="application/x-tex">\tilde{\mathcal{E}}_{\sigma}</annotation></semantics></math> starting from the initial condition</p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="(m_{kk^{*}},m_{kv^{*}},m_{vk^{*}},m_{vv^{*}},R_{kk},R_{kv},R_{vv})=(0,1,1,0,0,0,0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(m_{kk^{*}},m_{kv^{*}},m_{vk^{*}},m_{vv^{*}},R_{kk},R_{kv},R_{vv})=(0,1,1,0,0,0,0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS6.p2.2" class="ltx_p">The intuition is that the attention can confuse and mix <math id="A1.SS2.SSS6.p2.m2" class="ltx_Math" alttext="k^{*}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">k^{*}</annotation></semantics></math> and <math id="A1.SS2.SSS6.p2.m3" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math>. For instance for an identity activation function <math id="A1.SS2.SSS6.p2.m4" class="ltx_Math" alttext="\sigma(\chi)=\chi" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>χ</mi></mrow><annotation encoding="application/x-tex">\sigma(\chi)=\chi</annotation></semantics></math>, <math id="A1.SS2.SSS6.p2.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A1.SS2.SSS6.p2.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> play symmetric roles, that we partially broke by adding a constant bias. We call <em id="A1.SS2.SSS6.p2.2.1" class="ltx_emph ltx_font_italic">mismatched minimum</em> such a minimum where <math id="A1.SS2.SSS6.p2.m7" class="ltx_Math" alttext="m_{kv^{*}}\neq 0,m_{vk^{*}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>≠</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>≠</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">m_{kv^{*}}\neq 0,m_{vk^{*}}\neq 0</annotation></semantics></math> and <math id="A1.SS2.SSS6.p2.m8" class="ltx_Math" alttext="m_{kk^{*}}=0,m_{vv^{*}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">m_{kk^{*}}=0,m_{vv^{*}}=0</annotation></semantics></math>, and set <math id="A1.SS2.SSS6.p2.m9" class="ltx_Math" alttext="{\beth}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℶ</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">{\beth}_{\sigma}</annotation></semantics></math> its risk, by opposition with the <em id="A1.SS2.SSS6.p2.2.2" class="ltx_emph ltx_font_italic">well matched minimum</em> on <math id="A1.SS2.SSS6.p2.m10" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> where <math id="A1.SS2.SSS6.p2.m11" class="ltx_Math" alttext="m_{kk^{*}}\neq 0,m_{vv^{*}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>≠</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>≠</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">m_{kk^{*}}\neq 0,m_{vv^{*}}\neq 0</annotation></semantics></math> and <math id="A1.SS2.SSS6.p2.m12" class="ltx_Math" alttext="m_{kv^{*}}=0,m_{vk^{*}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">m_{kv^{*}}=0,m_{vk^{*}}=0</annotation></semantics></math>. On Figure <a href="#A1.F4" title="Figure 4 ‣ A.2.6 Other possible minima ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> we show that at large enough sequence length <math id="A1.SS2.SSS6.p2.m13" class="ltx_Math" alttext="L=10" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">L=10</annotation></semantics></math> and at <math id="A1.SS2.SSS6.p2.m14" class="ltx_Math" alttext="\nu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu&gt;0</annotation></semantics></math>, on the two models, the attention always has a well matched and a mismatched minimum, and that the mismatched minimum has a larger population error <math id="A1.SS2.SSS6.p2.m15" class="ltx_Math" alttext="{\beth}_{\sigma}&gt;\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℶ</mi><mi>σ</mi></msub><mo>&gt;</mo><msub><mi>𝖤</mi><mi>σ</mi></msub></mrow><annotation encoding="application/x-tex">{\beth}_{\sigma}&gt;\mathsf{E}_{\sigma}</annotation></semantics></math>.</p>
</div>
<figure id="A1.F4" class="ltx_figure"><object type="image/svg+xml" data="2509.21936v1/mauvaisMin.svg" id="A1.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/194;" width="476" height="194"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>
Minimal population risk <math id="A1.F4.m6" class="ltx_Math" alttext="\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}</annotation></semantics></math>, reached at the well matched minimum, and population risk of the mismatched minimum <math id="A1.F4.m7" class="ltx_Math" alttext="{\beth}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℶ</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">{\beth}_{\sigma}</annotation></semantics></math>, for different attention activations <math id="A1.F4.m8" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> (colors), for the two tasks spiked-SLR and max-SLR at <math id="A1.F4.m9" class="ltx_Math" alttext="L=10" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">L=10</annotation></semantics></math>. The markers on the lines are for readability only. Population risks are computed by numerical optimization of <math id="A1.F4.m10" class="ltx_Math" alttext="\tilde{\mathcal{E}}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub><annotation encoding="application/x-tex">\tilde{\mathcal{E}}_{\sigma}</annotation></semantics></math> from a random initialization (well matched minimum) or from the mismatched initialization described in section <a href="#A1.SS2.SSS6" title="A.2.6 Other possible minima ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.6</span></a> (mismatched minimum).</figcaption>
</figure>
</section>
<section id="A1.SS2.SSS7" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.7 </span>Minimizer for the linear attention</h4>

<div id="A1.SS2.SSS7.p1" class="ltx_para">
<p id="A1.SS2.SSS7.p1.1" class="ltx_p">On the manifold <math id="A1.SS2.SSS7.p1.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> the loss can be analytically minimized. We state here the expression of the minimizer. The loss is</p>
<table id="A1.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathcal{E}}_{\sigma}=" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathcal{E}}_{\sigma}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*},z^{*},\xi,\zeta}\ g_{\nu}(\epsilon^{*},\chi^{*})\left(z^{*}_{\epsilon^{*}}-(m_{vv^{*}}z^{*}+R_{vv}\zeta)^{\top}(1+m_{kk^{*}}\chi^{*}+R_{kk}\xi)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mo>,</mo><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msub><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*},z^{*},\xi,\zeta}\ g_{\nu}(\epsilon^{*},\chi^{*})\left(z^{*}_{\epsilon^{*}}-(m_{vv^{*}}z^{*}+R_{vv}\zeta)^{\top}(1+m_{kk^{*}}\chi^{*}+R_{kk}\xi)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E79.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E79.m2" class="ltx_Math" alttext="\displaystyle 1-2m_{vv^{*}}-2m_{vv^{*}}m_{kk^{*}}\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\chi_{\epsilon^{*}}^{*}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-2m_{vv^{*}}-2m_{vv^{*}}m_{kk^{*}}\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\chi_{\epsilon^{*}}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle{}+\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\left[m_{vv^{*}}^{2}(1+m_{kk^{*}}\chi^{*})^{\top}(1+m_{kk^{*}}\chi^{*})\right." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><msub><mi>g</mi><mi>ν</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><msubsup><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{}+\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\left[m_{vv^{*}}^{2}(1+m_{kk^{*}}\chi^{*})^{\top}(1+m_{kk^{*}}\chi^{*})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.{}+LR_{vv}^{2}+Lm_{vv^{*}}^{2}R_{kk}^{2}+m_{kk^{*}}^{2}R_{vv}^{2}\chi^{*\top}\chi^{*}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>L</mi><msubsup><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mn>2</mn></msubsup><mo>+</mo><mi>L</mi><msubsup><mi>m</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><msubsup><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mn>2</mn></msubsup><msubsup><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mn>2</mn></msubsup><msup><mi>χ</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>χ</mi><mo>∗</mo></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.{}+LR_{vv}^{2}+Lm_{vv^{*}}^{2}R_{kk}^{2}+m_{kk^{*}}^{2}R_{vv}^{2}\chi^{*\top}\chi^{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS7.p1.2" class="ltx_p">At the minimizer <math id="A1.SS2.SSS7.p1.m2" class="ltx_Math" alttext="R_{vv}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{vv}=0</annotation></semantics></math> and <math id="A1.SS2.SSS7.p1.m3" class="ltx_Math" alttext="R_{kk}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{kk}=0</annotation></semantics></math>. We perform the minimization over the remaining variables and obtain that the loss is</p>
<table id="A1.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E80.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathcal{E}}_{\sigma}=1-\frac{\left(\mathbb{E}(1+m_{kk^{*}}\chi^{*})_{\epsilon^{*}}\right)^{2}}{\mathbb{E}(1+m_{kk^{*}}\chi^{*})^{\top}(1+m_{kk^{*}}\chi^{*})}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>~</mo></mover><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><msup><mi>ϵ</mi><mo>∗</mo></msup></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathcal{E}}_{\sigma}=1-\frac{\left(\mathbb{E}(1+m_{kk^{*}}\chi^{*})_{\epsilon^{*}}\right)^{2}}{\mathbb{E}(1+m_{kk^{*}}\chi^{*})^{\top}(1+m_{kk^{*}}\chi^{*})}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E80.m2" class="ltx_Math" alttext="\displaystyle m_{kk^{*}}=\frac{\mathbb{E}L\mathbb{E}\chi^{*}_{\epsilon^{*}}-\mathbb{E}1^{\top}\chi^{*}}{\mathbb{E}\chi^{*\top}\chi^{*}-\mathbb{E}\chi^{*}_{\epsilon^{*}}\mathbb{E}1^{\top}\chi^{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle m_{kk^{*}}=\frac{\mathbb{E}L\mathbb{E}\chi^{*}_{\epsilon^{*}}-\mathbb{E}1^{\top}\chi^{*}}{\mathbb{E}\chi^{*\top}\chi^{*}-\mathbb{E}\chi^{*}_{\epsilon^{*}}\mathbb{E}1^{\top}\chi^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS7.p1.3" class="ltx_p">where we used the shorthand <math id="A1.SS2.SSS7.p1.m4" class="ltx_Math" alttext="\mathbb{E}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">\mathbb{E}</annotation></semantics></math> for <math id="A1.SS2.SSS7.p1.m5" class="ltx_Math" alttext="\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{L}\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})</annotation></semantics></math>. We evaluate these quantities for the two models, the spiked- and the max-SLR. We set <math id="A1.SS2.SSS7.p1.m6" class="ltx_Math" alttext="f(L,\nu)=\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\chi^{*}_{\epsilon^{*}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>χ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">f(L,\nu)=\mathbb{E}_{\epsilon^{*},\chi^{*}}\ g_{\nu}(\epsilon^{*},\chi^{*})\chi^{*}_{\epsilon^{*}}</annotation></semantics></math>, which for the max-SLR has no simpler expression in general. We compute:</p>
<table id="A1.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.EGx48.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.EGx48.m1" class="ltx_Math" alttext="\displaystyle\begin{array}[]{cccc}&amp;\mathbb{E}\chi^{*}_{\epsilon^{*}}&amp;\mathbb{E}1^{\top}\chi^{*}&amp;\mathbb{E}\chi^{*\top}\chi^{*}\\
\hline\cr\mathrm{spiked-SLR}&amp;\sqrt{\nu}&amp;\sqrt{\nu}&amp;\mathbb{E}L+\nu\\
\hline\cr\mathrm{max-SLR}&amp;\mathbb{E}f(L,\nu)&amp;0&amp;\mathbb{E}L\end{array}" display="inline" intent=":literal"><semantics><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd></mtd><mtd><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow></mtd><mtd><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mtd><mtd><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>χ</mi><mo>∗</mo></msup></mrow></mtd></mtr><mtr><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd></mtr><mtr><mtd><mrow><mi>spiked</mi><mo>−</mo><mi>SLR</mi></mrow></mtd><mtd><msqrt><mi>ν</mi></msqrt></mtd><mtd><msqrt><mi>ν</mi></msqrt></mtd><mtd><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mi>ν</mi></mrow></mtd></mtr><mtr><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd></mtr><mtr><mtd><mrow><mi>max</mi><mo>−</mo><mi>SLR</mi></mrow></mtd><mtd><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{array}[]{cccc}&amp;\mathbb{E}\chi^{*}_{\epsilon^{*}}&amp;\mathbb{E}1^{\top}\chi^{*}&amp;\mathbb{E}\chi^{*\top}\chi^{*}\\
\hline\cr\mathrm{spiked-SLR}&amp;\sqrt{\nu}&amp;\sqrt{\nu}&amp;\mathbb{E}L+\nu\\
\hline\cr\mathrm{max-SLR}&amp;\mathbb{E}f(L,\nu)&amp;0&amp;\mathbb{E}L\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.SSS7.p1.4" class="ltx_p">The optimal risk for the spiked-SLR finally is</p>
<table id="A1.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E81.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}=1-\frac{\mathbb{E}L+\nu(\mathbb{E}L-1)}{(\mathbb{E}L)^{2}+\nu(\mathbb{E}L-1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}=1-\frac{\mathbb{E}L+\nu(\mathbb{E}L-1)}{(\mathbb{E}L)^{2}+\nu(\mathbb{E}L-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS7.p1.5" class="ltx_p">while for the max-SLR the optimal risk is</p>
<table id="A1.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E82.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}=1-\frac{1+(\mathbb{E}f(L,\nu))^{2}}{\mathbb{E}L}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.500em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}=1-\frac{1+(\mathbb{E}f(L,\nu))^{2}}{\mathbb{E}L}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2.SSS8" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.8 </span>Proof of corollary <a href="#S4.Thmcorollary2" title="Corollary 4.2. ‣ 4.3 Comparison between linear and softmax attentions ‣ 4 Comparison of softmax with alternatives in population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>: asymptotic convergence rates</h4>

<section id="A1.SS2.SSS8.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Spiked-SLR at large signal <math id="A1.SS2.SSS8.Px1.m1" class="ltx_Math" alttext="\nu\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\nu\to\infty</annotation></semantics></math> and constant length <math id="A1.SS2.SSS8.Px1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</h5>

<div id="A1.SS2.SSS8.Px1.p1" class="ltx_para">
<p id="A1.SS2.SSS8.Px1.p1.1" class="ltx_p">The loss of the linear attention is derived in part <a href="#A1.SS2.SSS7" title="A.2.7 Minimizer for the linear attention ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.7</span></a>. We take the limit <math id="A1.SS2.SSS8.Px1.p1.m1" class="ltx_Math" alttext="\nu\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\nu\to\infty</annotation></semantics></math>:</p>
<table id="A1.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E83.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}=1-\frac{L+\nu(L-1)}{L^{2}+\nu(L-1)}=\frac{L}{L-1}\frac{1}{\nu}+o_{\nu\to\infty}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo>+</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ν</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>o</mi><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}=1-\frac{L+\nu(L-1)}{L^{2}+\nu(L-1)}=\frac{L}{L-1}\frac{1}{\nu}+o_{\nu\to\infty}(1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS8.Px1.p1.2" class="ltx_p">The loss of the softmax attention is derived in part <a href="#A1.SS2.SSS1" title="A.2.1 Proof of proposition : the softmax is Bayes-optimal ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.1</span></a>. For the spiked-SLR it reads</p>
<table id="A1.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E84.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E84.m2" class="ltx_Math" alttext="\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}\frac{g(\epsilon,\chi)^{2}}{\sum_{\epsilon^{\prime}}^{L}g(\epsilon^{\prime},\chi)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>χ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mi>L</mi></msubsup><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}\frac{g(\epsilon,\chi)^{2}}{\sum_{\epsilon^{\prime}}^{L}g(\epsilon^{\prime},\chi)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
<tbody id="A1.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E85.m1" class="ltx_Math" alttext="\displaystyle=1-\mathbb{E}_{\chi_{1}\sim\mathcal{N}(\sqrt{\nu},1)}\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]\frac{e^{\sqrt{\nu}\chi_{1}}}{\sum_{l^{\prime}=1}^{L}e^{\sqrt{\nu}\chi_{l^{\prime}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>χ</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>ν</mi></msqrt><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><msub><mi>χ</mi><mi>l</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mn>1</mn></msub></mrow></msup><mrow><msubsup><mo>∑</mo><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><msup><mi>e</mi><mrow><msqrt><mi>ν</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><msup><mi>l</mi><mo>′</mo></msup></msub></mrow></msup></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\mathbb{E}_{\chi_{1}\sim\mathcal{N}(\sqrt{\nu},1)}\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]\frac{e^{\sqrt{\nu}\chi_{1}}}{\sum_{l^{\prime}=1}^{L}e^{\sqrt{\nu}\chi_{l^{\prime}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS8.Px1.p1.3" class="ltx_p">where we isolated the first index by symmetry and made a change of variable on <math id="A1.SS2.SSS8.Px1.p1.m2" class="ltx_Math" alttext="\chi_{1}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\chi_{1}</annotation></semantics></math>. At large <math id="A1.SS2.SSS8.Px1.p1.m3" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> we approximate the softmax by a hardmax and</p>
<table id="A1.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E86.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E86.m2" class="ltx_Math" alttext="\displaystyle\approx 1-\mathbb{E}_{\chi_{1}\sim\mathcal{N}(\sqrt{\nu},1)}\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]\delta_{\chi_{1}&gt;\max_{l&gt;1}\chi_{l}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>χ</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>ν</mi></msqrt><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><msub><mi>χ</mi><mi>l</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><msub><mi>χ</mi><mn>1</mn></msub><mo>&gt;</mo><mrow><msub><mi>max</mi><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>χ</mi><mi>l</mi></msub></mrow></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx 1-\mathbb{E}_{\chi_{1}\sim\mathcal{N}(\sqrt{\nu},1)}\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]\delta_{\chi_{1}&gt;\max_{l&gt;1}\chi_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
<tbody id="A1.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E87.m1" class="ltx_Math" alttext="\displaystyle=\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]e^{-\frac{1}{2}(\nu-\max_{l&gt;1}\chi_{l})+o_{\nu\to\infty}(\nu)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><msub><mi>χ</mi><mi>l</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mrow><msub><mi>max</mi><mrow><mi>l</mi><mo>&gt;</mo><mn>1</mn></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>χ</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>o</mi><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{l&gt;1}^{L}\left[\mathbb{E}_{\chi_{l}\sim\mathcal{N}(0,1)}\right]e^{-\frac{1}{2}(\nu-\max_{l&gt;1}\chi_{l})+o_{\nu\to\infty}(\nu)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
<tbody id="A1.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E88.m1" class="ltx_Math" alttext="\displaystyle=e^{-\frac{1}{2}\nu+o_{\nu\to\infty}(\nu)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mi>e</mi><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></mrow><mo>+</mo><mrow><msub><mi>o</mi><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\frac{1}{2}\nu+o_{\nu\to\infty}(\nu)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2.SSS8.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Max-SLR at <math id="A1.SS2.SSS8.Px2.m1" class="ltx_Math" alttext="\nu=\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\nu=\infty</annotation></semantics></math> for growing lengths <math id="A1.SS2.SSS8.Px2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</h5>

<div id="A1.SS2.SSS8.Px2.p1" class="ltx_para">
<p id="A1.SS2.SSS8.Px2.p1.1" class="ltx_p">We take the limit <math id="A1.SS2.SSS8.Px2.p1.m1" class="ltx_Math" alttext="\nu=\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\nu=\infty</annotation></semantics></math> so <math id="A1.SS2.SSS8.Px2.p1.m2" class="ltx_Math" alttext="g_{\nu}(\epsilon,\chi)=L\delta_{\epsilon=\argmax_{l}\chi_{l}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>ϵ</mi><mo>=</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>l</mi></msub><mo>⁡</mo><msub><mi>χ</mi><mi>l</mi></msub></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">g_{\nu}(\epsilon,\chi)=L\delta_{\epsilon=\argmax_{l}\chi_{l}}</annotation></semantics></math> and <math id="A1.SS2.SSS8.Px2.p1.m3" class="ltx_Math" alttext="f(L,\nu)=\mathbb{E}_{\chi^{*}\sim\mathcal{(}0,I_{L})}\max_{l}\chi_{l}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>χ</mi><mo>∗</mo></msup><mo>∼</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mi>l</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>l</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">f(L,\nu)=\mathbb{E}_{\chi^{*}\sim\mathcal{(}0,I_{L})}\max_{l}\chi_{l}^{*}</annotation></semantics></math>. We assume constant length, i.e. <math id="A1.SS2.SSS8.Px2.p1.m4" class="ltx_Math" alttext="P_{L}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>L</mi></msub><annotation encoding="application/x-tex">P_{L}</annotation></semantics></math> is a delta. The loss of the linear attention is derived in part <a href="#A1.SS2.SSS7" title="A.2.7 Minimizer for the linear attention ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.7</span></a>:</p>
<table id="A1.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E89.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}=1-\frac{1+(\mathbb{E}f(L,\nu))^{2}}{\mathbb{E}L}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.500em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}=1-\frac{1+(\mathbb{E}f(L,\nu))^{2}}{\mathbb{E}L}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS8.Px2.p1.2" class="ltx_p">For large <math id="A1.SS2.SSS8.Px2.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> we have the asymptotic <math id="A1.SS2.SSS8.Px2.p1.m6" class="ltx_Math" alttext="f(L,\nu)=\mathcal{O}_{L\to\infty}(\sqrt{\log L})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>L</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(L,\nu)=\mathcal{O}_{L\to\infty}(\sqrt{\log L})</annotation></semantics></math>, which gives</p>
<table id="A1.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E90.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}=1-\mathcal{O}_{L\to\infty}\left(\frac{\log L}{L}\right)\ ." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>L</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mi>L</mi></mfrac></mstyle><mo rspace="0.222em">)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}=1-\mathcal{O}_{L\to\infty}\left(\frac{\log L}{L}\right)\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS8.Px2.p1.3" class="ltx_p">The loss of the softmax attention is derived in part <a href="#A1.SS2.SSS1" title="A.2.1 Proof of proposition : the softmax is Bayes-optimal ‣ A.2 Risk of the attention layer on population loss ‣ Appendix A Population risk ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2.1</span></a>. For the max-SLR it reads</p>
<table id="A1.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E91.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>𝖤</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E91.m2" class="ltx_Math" alttext="\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}\frac{g(\epsilon,\chi)^{2}}{\sum_{\epsilon^{\prime}}^{L}g(\epsilon^{\prime},\chi)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>χ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mo>∑</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mi>L</mi></msubsup><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}\frac{g(\epsilon,\chi)^{2}}{\sum_{\epsilon^{\prime}}^{L}g(\epsilon^{\prime},\chi)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
<tbody id="A1.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E92.m1" class="ltx_Math" alttext="\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}g(\epsilon,\chi)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>χ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-\mathbb{E}_{\chi}\frac{1}{L}\sum_{\epsilon}^{L}g(\epsilon,\chi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
<tbody id="A1.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E93.m1" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS8.Px2.p1.4" class="ltx_p">The softmax attention reaches exact recovery for any <math id="A1.SS2.SSS8.Px2.p1.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, and in particular for large <math id="A1.SS2.SSS8.Px2.p1.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, the limit been taken after the limit <math id="A1.SS2.SSS8.Px2.p1.m9" class="ltx_Math" alttext="\nu=\infty" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\nu=\infty</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Bayes-optimal error at finite sample complexity <math id="A2.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">In this section we state the expression for the Bayes-optimal test error in the case where samples are limited, i.e. when <math id="A2.p1.m1" class="ltx_Math" alttext="\alpha=\nicefrac{{N}}{{D}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mpadded voffset="0.3em"><mi mathsize="0.700em">N</mi></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mi mathsize="0.700em">D</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha=\nicefrac{{N}}{{D}}</annotation></semantics></math> is finite, in the high-dimensional limit <math id="A2.p1.m2" class="ltx_Math" alttext="N,D\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>,</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">N,D\to\infty</annotation></semantics></math>. The derivation of this expression is given in appendix <a href="#A3" title="Appendix C Asymptotic characterization at finite sampling ratio: replica ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>. We analyze behaviour of the BO performances and show that the SLR task presents a hard phase where best algorithmic performances cannot reach best information-theoretical performances. This hard phase is not present at <math id="A2.p1.m3" class="ltx_Math" alttext="\alpha\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\alpha\to\infty</annotation></semantics></math>.</p>
</div>
<div id="A2.p2" class="ltx_para">
<p id="A2.p2.1" class="ltx_p">The Bayes-optimal performances can be expressed in function of two low-dimensional order parameters (or summary statistics, or sufficient statistics), <math id="A2.p2.m1" class="ltx_Math" alttext="m_{k}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">m_{k}\in\mathbb{R}</annotation></semantics></math> and <math id="A2.p2.m2" class="ltx_Math" alttext="m_{v}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">m_{v}\in\mathbb{R}</annotation></semantics></math>. Writing <math id="A2.p2.m3" class="ltx_Math" alttext="k_{\mathrm{BO}}\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>BO</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">k_{\mathrm{BO}}\in\mathbb{R}^{D}</annotation></semantics></math> and <math id="A2.p2.m4" class="ltx_Math" alttext="v_{\mathrm{BO}}\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>BO</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">v_{\mathrm{BO}}\in\mathbb{R}^{D}</annotation></semantics></math> the BO estimators of <math id="A2.p2.m5" class="ltx_Math" alttext="k^{*}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">k^{*}</annotation></semantics></math> and <math id="A2.p2.m6" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math>, <math id="A2.p2.m7" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> and <math id="A2.p2.m8" class="ltx_Math" alttext="m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">m_{v}</annotation></semantics></math> are defined as</p>
<table id="A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E94.m1" class="ltx_Math" alttext="\displaystyle m_{k}=\frac{1}{D}k_{\mathrm{BO}}^{\top}k^{*}=\mathrm{angle}(k_{\mathrm{BO}},k^{*})^{2}\ ,\qquad m_{v}=\frac{1}{D}v_{\mathrm{BO}}^{\top}v^{*}=\mathrm{angle}(v_{\mathrm{BO}},v^{*})^{2}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>BO</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><mi>angle</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>BO</mi></msub><mo>,</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mi>BO</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><mi>angle</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>BO</mi></msub><mo>,</mo><msup><mi>v</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle m_{k}=\frac{1}{D}k_{\mathrm{BO}}^{\top}k^{*}=\mathrm{angle}(k_{\mathrm{BO}},k^{*})^{2}\ ,\qquad m_{v}=\frac{1}{D}v_{\mathrm{BO}}^{\top}v^{*}=\mathrm{angle}(v_{\mathrm{BO}},v^{*})^{2}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">To state our asymptotic characterization result we introduce the following partition functions, for all <math id="A2.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and for <math id="A2.p3.m2" class="ltx_Math" alttext="B,y\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">B,y\in\mathbb{R}</annotation></semantics></math>, <math id="A2.p3.m3" class="ltx_Math" alttext="A,R,V\in\mathbb{R}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>R</mi><mo>,</mo><mrow><mi>V</mi><mo>∈</mo><msup><mi>ℝ</mi><mo>+</mo></msup></mrow></mrow><annotation encoding="application/x-tex">A,R,V\in\mathbb{R}^{+}</annotation></semantics></math> and <math id="A2.p3.m4" class="ltx_Math" alttext="\gamma,\omega\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>,</mo><mi>ω</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">\gamma,\omega\in\mathbb{R}^{L}</annotation></semantics></math>:</p>
<table id="A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E95.m1" class="ltx_Math" alttext="\displaystyle Z_{k}(B,A)=\mathbb{E}_{k\sim\mathcal{N}(0,1)}e^{-\frac{1}{2}Ak^{2}+Bk}\ ,\qquad Z_{v}(B,A)=\mathbb{E}_{v\sim\mathcal{N}(0,1)}e^{-\frac{1}{2}Av^{2}+Bv}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>k</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>Z</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>v</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{k}(B,A)=\mathbb{E}_{k\sim\mathcal{N}(0,1)}e^{-\frac{1}{2}Ak^{2}+Bk}\ ,\qquad Z_{v}(B,A)=\mathbb{E}_{v\sim\mathcal{N}(0,1)}e^{-\frac{1}{2}Av^{2}+Bv}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(95)</span></td></tr></tbody>
<tbody id="A2.E96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E96.m1" class="ltx_Math" alttext="\displaystyle Z_{\mathrm{out}}(y,\gamma,R,\omega,V)=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\,\frac{1}{L}\sum_{\epsilon}^{L}g_{\nu}(\epsilon,\chi)P_{\mathrm{out}}(y|z_{\epsilon})\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\mathcal{N}(z_{l};\omega_{l},V)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>z</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>l</mi></msub><mo>,</mo><msub><mi>ω</mi><mi>l</mi></msub><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\mathrm{out}}(y,\gamma,R,\omega,V)=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\mathrm{d}z\,\frac{1}{L}\sum_{\epsilon}^{L}g_{\nu}(\epsilon,\chi)P_{\mathrm{out}}(y|z_{\epsilon})\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\mathcal{N}(z_{l};\omega_{l},V)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(96)</span></td></tr></tbody>
</table>
<p id="A2.p3.2" class="ltx_p">where</p>
<table id="A2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex22.m1" class="ltx_Math" alttext="P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})=\frac{e^{-\frac{1}{2\Delta}(y-z^{*}_{\epsilon^{*}})^{2}}}{\sqrt{2\pi\Delta}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})=\frac{e^{-\frac{1}{2\Delta}(y-z^{*}_{\epsilon^{*}})^{2}}}{\sqrt{2\pi\Delta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.3" class="ltx_p">is the output channel that corresponds to an additive Gaussian noise.
We set <math id="A2.p3.m5" class="ltx_Math" alttext="h_{\nu}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ν</mi></msub><annotation encoding="application/x-tex">h_{\nu}</annotation></semantics></math> an effective distribution on <math id="A2.p3.m6" class="ltx_Math" alttext="\epsilon\in\{1,\ldots,L\}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in\{1,\ldots,L\}</annotation></semantics></math> defined as</p>
<table id="A2.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E97.m1" class="ltx_Math" alttext="\displaystyle h_{\nu}(\epsilon,\gamma,R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{\nu}(\epsilon,\gamma,R)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E97.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\,g_{\nu}(\epsilon,\chi)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>𝕃</mi></msup></msub></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>l</mi><mi>L</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>l</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>,</mo><mi>R</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathbb{R^{L}}}\mathrm{d}\chi\,g_{\nu}(\epsilon,\chi)\prod_{l}^{L}\mathcal{N}(\chi_{l};\gamma_{l},R)\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(97)</span></td></tr></tbody>
</table>
<p id="A2.p3.4" class="ltx_p">Last we set the function <math id="A2.p3.m7" class="ltx_Math" alttext="\mathrm{xlogx}:x\to x\log(x)" display="inline" intent=":literal"><semantics><mrow><mi>xlogx</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>x</mi><mo stretchy="false">→</mo><mrow><mi>x</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{xlogx}:x\to x\log(x)</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmresult1" class="ltx_theorem ltx_theorem_result">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmresult1.2" class="ltx_text ltx_font_bold">Result B.1</span></span><span id="A2.Thmresult1.3" class="ltx_text ltx_font_bold"> </span>(Bayes-optimal risk)<span id="A2.Thmresult1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmresult1.p1" class="ltx_para">
<p id="A2.Thmresult1.p1.1" class="ltx_p"><span id="A2.Thmresult1.p1.1.1" class="ltx_text ltx_font_italic">We consider the high-dimensional limit <math id="A2.Thmresult1.p1.m1" class="ltx_Math" alttext="N,D\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>,</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">N,D\to\infty</annotation></semantics></math>, with <math id="A2.Thmresult1.p1.m2" class="ltx_Math" alttext="\alpha=\Omega(1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=\Omega(1)</annotation></semantics></math>. Let <math id="A2.Thmresult1.p1.m3" class="ltx_Math" alttext="L\sim P_{L}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∼</mo><msub><mi>P</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">L\sim P_{L}</annotation></semantics></math> and, conditionally on <math id="A2.Thmresult1.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, <math id="A2.Thmresult1.p1.m5" class="ltx_Math" alttext="\varsigma\sim\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ς</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varsigma\sim\mathcal{N}(0,1)</annotation></semantics></math>, <math id="A2.Thmresult1.p1.m6" class="ltx_Math" alttext="\xi\sim\mathcal{N}(0,I_{L})" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi\sim\mathcal{N}(0,I_{L})</annotation></semantics></math> and <math id="A2.Thmresult1.p1.m7" class="ltx_Math" alttext="\zeta\sim\mathcal{N}(0,I_{L})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta\sim\mathcal{N}(0,I_{L})</annotation></semantics></math>. Fix <math id="A2.Thmresult1.p1.m8" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> and <math id="A2.Thmresult1.p1.m9" class="ltx_Math" alttext="m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">m_{v}</annotation></semantics></math> so they satisfy the following fixed-point condition:</span></p>
<table id="A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E98.m1" class="ltx_Math" alttext="\displaystyle m_{k},m_{v}=\argmax_{m_{k},m_{v}}\phi_{\mathrm{BO}}(m_{k},m_{v})" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub></mrow></msub><mo>⁡</mo><msub><mi>ϕ</mi><mi>BO</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{k},m_{v}=\argmax_{m_{k},m_{v}}\phi_{\mathrm{BO}}(m_{k},m_{v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(98)</span></td></tr></tbody>
<tbody id="A2.E99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E99.m1" class="ltx_math_unparsed" alttext="\displaystyle\phi_{\mathrm{BO}}(m_{k},m_{v})=\max_{\hat{m}_{k}\in\mathbb{R},\hat{m}_{v}\in\mathbb{R}}\left[-\frac{1}{2\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{k}\left(\sqrt{\hat{m}_{k}}\varsigma,\hat{m}_{k}\right)\right." display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>BO</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msub><mi>m</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><munder><mi>max</mi><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow></mrow></munder><mrow><mo>[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><msub><mi>m</mi><mi>k</mi></msub><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><msub><mi>m</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>ς</mi></msub><mi>xlogx</mi><msub><mi>Z</mi><mi>k</mi></msub><mrow><mo>(</mo><msqrt><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub></msqrt><mi>ς</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>k</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi_{\mathrm{BO}}(m_{k},m_{v})=\max_{\hat{m}_{k}\in\mathbb{R},\hat{m}_{v}\in\mathbb{R}}\left[-\frac{1}{2\alpha}(\hat{m}_{k}m_{k}+\hat{m}_{v}m_{v})+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{k}\left(\sqrt{\hat{m}_{k}}\varsigma,\hat{m}_{k}\right)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(99)</span></td></tr></tbody>
<tbody id="A2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\left.{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{v}\left(\sqrt{\hat{m}_{v}}\varsigma,\hat{m}_{v}\right)+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\mathrm{xlogx}Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><msub><mi>𝔼</mi><mi>ς</mi></msub><mi>xlogx</mi><msub><mi>Z</mi><mi>v</mi></msub><mrow><mo>(</mo><msqrt><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub></msqrt><mi>ς</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>v</mi></msub><mo>)</mo></mrow><mo>+</mo><msub><mi>𝔼</mi><mi>L</mi></msub><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mi>d</mi><mi>y</mi><mi>xlogx</mi><msub><mi>Z</mi><mi>out</mi></msub><mrow><mo>(</mo><mi>y</mi><mo>,</mo><msub><msqrt><mi>m</mi></msqrt><mi>k</mi></msub><mi>ξ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><msqrt><msub><mi>m</mi><mi>v</mi></msub></msqrt><mi>ζ</mi><mo>,</mo><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>v</mi></msub><mo>)</mo></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\left.{}+\frac{1}{\alpha}\mathbb{E}_{\varsigma}\mathrm{xlogx}Z_{v}\left(\sqrt{\hat{m}_{v}}\varsigma,\hat{m}_{v}\right)+\mathbb{E}_{L}\mathbb{E}_{\xi,\zeta}\int_{\mathbb{R}}\mathrm{d}y\,\mathrm{xlogx}Z_{\mathrm{out}}\left(y,\sqrt{m}_{k}\xi,1-m_{k},\sqrt{m_{v}}\zeta,1-m_{v}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmresult1.p1.2" class="ltx_p"><math id="A2.Thmresult1.p1.m10" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math><span id="A2.Thmresult1.p1.2.1" class="ltx_text ltx_font_italic"> is the free entropy of the problem at given <math id="A2.Thmresult1.p1.m11" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> and <math id="A2.Thmresult1.p1.m12" class="ltx_Math" alttext="m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">m_{v}</annotation></semantics></math>. Then the Bayes-optimal (BO) test error on inferring <math id="A2.Thmresult1.p1.m13" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is:</span></p>
<table id="A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E100.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E100.m2" class="ltx_Math" alttext="\displaystyle=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}\left[\sum_{\epsilon}^{L}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\right]^{-1}\sum_{\epsilon}^{L}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})^{2}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>ϵ</mi><mi>L</mi></munderover></mstyle><mrow><msub><mi>h</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msqrt><msub><mi>m</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1-m_{v}\mathbb{E}_{L}\mathbb{E}_{\xi}\,\frac{1}{L}\left[\sum_{\epsilon}^{L}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})\right]^{-1}\sum_{\epsilon}^{L}h_{\nu}(\epsilon,\sqrt{m_{k}}\xi,1-m_{k})^{2}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(100)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p">Our above result describes the information-theoretical (IT) best performance. In general it may not correspond to the algorithmic best performance. In fact, the SLR task presents an interesting phenomenology: in a whole region of the parameters <math id="A2.p4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, <math id="A2.p4.m2" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>, <math id="A2.p4.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> of the model, there is a gap between the IT and algorithmic achievable best performances. Such a discrepancy is related to the existence of several maxima in the free entropy <math id="A2.p4.m4" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> eq. (<a href="#A2.E99" title="Equation 99 ‣ Result B.1 (Bayes-optimal risk). ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">99</span></a>) and has already been studied for other models in numerous previous works <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib22" title="" class="ltx_ref">Krzakala et al., 2012</a>, <a href="#bib.bib16" title="" class="ltx_ref">Dia et al., 2016</a>, <a href="#bib.bib23" title="" class="ltx_ref">Lesieur et al., 2017</a>]</cite> and we refer to <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib8" title="" class="ltx_ref">Bandeira et al. [2022]</a></cite> for a more rigorous treatment. The free entropy <math id="A2.p4.m5" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> plays a central role and it is related to the log-likelihood of the model; higher free entropy gives lower risk.</p>
</div>
<div id="A2.p5" class="ltx_para">
<p id="A2.p5.1" class="ltx_p">We can show that <math id="A2.p5.m1" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> admits one or two maxima. We introduce some notation to distinguish them. At given <math id="A2.p5.m2" class="ltx_Math" alttext="\nu,L" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\nu,L</annotation></semantics></math> we call <math id="A2.p5.m3" class="ltx_Math" alttext="\alpha_{\mathrm{algo}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>algo</mi></msub><annotation encoding="application/x-tex">\alpha_{\mathrm{algo}}</annotation></semantics></math> the <em id="A2.p5.1.1" class="ltx_emph ltx_font_italic">algorithmic threshold</em> (or spinodal) the smallest <math id="A2.p5.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> such that for all <math id="A2.p5.m5" class="ltx_Math" alttext="\alpha&gt;\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><msub><mi>α</mi><mi>alg</mi></msub></mrow><annotation encoding="application/x-tex">\alpha&gt;\alpha_{\mathrm{alg}}</annotation></semantics></math>, <math id="A2.p5.m6" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> has a unique maximum. In the region <math id="A2.p5.m7" class="ltx_Math" alttext="\alpha&lt;\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&lt;</mo><msub><mi>α</mi><mi>alg</mi></msub></mrow><annotation encoding="application/x-tex">\alpha&lt;\alpha_{\mathrm{alg}}</annotation></semantics></math> where <math id="A2.p5.m8" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> admits two maxima, we set <math id="A2.p5.m9" class="ltx_Math" alttext="\phi_{\mathrm{BO}}^{\mathrm{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>ϕ</mi><mi>BO</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}^{\mathrm{i}}</annotation></semantics></math> the maximum whose basin of attraction includes a neighborhood of <math id="A2.p5.m10" class="ltx_Math" alttext="m_{k},m_{v}=1,1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{k},m_{v}=1,1</annotation></semantics></math> and call it <em id="A2.p5.1.2" class="ltx_emph ltx_font_italic">informed maximum</em>. We set <math id="A2.p5.m11" class="ltx_Math" alttext="\phi_{\mathrm{BO}}^{\mathrm{u}}" display="inline" intent=":literal"><semantics><msubsup><mi>ϕ</mi><mi>BO</mi><mi>u</mi></msubsup><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}^{\mathrm{u}}</annotation></semantics></math> the maximum of <math id="A2.p5.m12" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> whose basin of attraction includes a neighborhood of <math id="A2.p5.m13" class="ltx_Math" alttext="m_{k},m_{v}=0,0" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m_{k},m_{v}=0,0</annotation></semantics></math> and call it <em id="A2.p5.1.3" class="ltx_emph ltx_font_italic">uninformed maximum</em>; it describes the algorithmic best performances, in the sense that an algorithm locally optimizing <math id="A2.p5.m14" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> and starting without information on the solution will reach <math id="A2.p5.m15" class="ltx_Math" alttext="\phi_{\mathrm{BO}}^{\mathrm{u}}" display="inline" intent=":literal"><semantics><msubsup><mi>ϕ</mi><mi>BO</mi><mi>u</mi></msubsup><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}^{\mathrm{u}}</annotation></semantics></math>. In general <math id="A2.p5.m16" class="ltx_Math" alttext="\phi_{\mathrm{BO}}^{\mathrm{u}}\neq\phi_{\mathrm{BO}}^{\mathrm{i}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϕ</mi><mi>BO</mi><mi>u</mi></msubsup><mo>≠</mo><msubsup><mi>ϕ</mi><mi>BO</mi><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}^{\mathrm{u}}\neq\phi_{\mathrm{BO}}^{\mathrm{i}}</annotation></semantics></math>. We call <math id="A2.p5.m17" class="ltx_Math" alttext="\alpha_{\mathrm{IT}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>IT</mi></msub><annotation encoding="application/x-tex">\alpha_{\mathrm{IT}}</annotation></semantics></math> the <em id="A2.p5.1.4" class="ltx_emph ltx_font_italic">IT threshold</em> the <math id="A2.p5.m18" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> such that <math id="A2.p5.m19" class="ltx_Math" alttext="\phi_{\mathrm{BO}}^{\mathrm{i}}=\phi_{\mathrm{BO}}^{\mathrm{u}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϕ</mi><mi>BO</mi><mi>i</mi></msubsup><mo>=</mo><msubsup><mi>ϕ</mi><mi>BO</mi><mi>u</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}^{\mathrm{i}}=\phi_{\mathrm{BO}}^{\mathrm{u}}</annotation></semantics></math>. We have <math id="A2.p5.m20" class="ltx_Math" alttext="\alpha_{\mathrm{IT}}\leq\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>IT</mi></msub><mo>≤</mo><msub><mi>α</mi><mi>alg</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{IT}}\leq\alpha_{\mathrm{alg}}</annotation></semantics></math> and we compute that for the SLR <math id="A2.p5.m21" class="ltx_Math" alttext="\alpha_{\mathrm{IT}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>IT</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{IT}}=1</annotation></semantics></math> for a noise-less output channel <math id="A2.p5.m22" class="ltx_Math" alttext="\Delta=0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta=0</annotation></semantics></math>.</p>
</div>
<div id="A2.p6" class="ltx_para">
<p id="A2.p6.1" class="ltx_p">To summarize, in the region <math id="A2.p6.m1" class="ltx_Math" alttext="\alpha_{\mathrm{IT}}&lt;\alpha&lt;\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>IT</mi></msub><mo>&lt;</mo><mi>α</mi><mo>&lt;</mo><msub><mi>α</mi><mi>alg</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{IT}}&lt;\alpha&lt;\alpha_{\mathrm{alg}}</annotation></semantics></math> the free entropy <math id="A2.p6.m2" class="ltx_Math" alttext="\phi_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\phi_{\mathrm{BO}}</annotation></semantics></math> has two maxima; the global maximum describes the IT best performances but it cannot be reached from <math id="A2.p6.m3" class="ltx_Math" alttext="m_{k},m_{v}=0,0" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>m</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m_{k},m_{v}=0,0</annotation></semantics></math> by local algorithms, that only reach a local maximum with higher risk. We depict this hard phase on Figure <a href="#A2.F5" title="Figure 5 ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> for the spiked- and max-SLR.</p>
</div>
<figure id="A2.F5" class="ltx_figure"><object type="image/svg+xml" data="2509.21936v1/bo.svg" id="A2.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/333;" width="476" height="333"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span> BO test error <math id="A2.F5.m12" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math>, overlap <math id="A2.F5.m13" class="ltx_Math" alttext="m_{v}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>v</mi></msub><annotation encoding="application/x-tex">m_{v}</annotation></semantics></math> with <math id="A2.F5.m14" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math> and overlap <math id="A2.F5.m15" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> with <math id="A2.F5.m16" class="ltx_Math" alttext="k^{*}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">k^{*}</annotation></semantics></math> for the spiked-SLR and the max-SLR models, for different signals <math id="A2.F5.m17" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> and sequence lengths <math id="A2.F5.m18" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, in the noise-less case <math id="A2.F5.m19" class="ltx_Math" alttext="\Delta=0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta=0</annotation></semantics></math>. The values are given by the eq. (<a href="#A2.E100" title="Equation 100 ‣ Result B.1 (Bayes-optimal risk). ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">100</span></a>). The algorithmic best performances are given by the ”uninformed” curve while for <math id="A2.F5.m20" class="ltx_Math" alttext="\alpha_{\mathrm{IT}}&lt;\alpha&lt;\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>IT</mi></msub><mo>&lt;</mo><mi>α</mi><mo>&lt;</mo><msub><mi>α</mi><mi>alg</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{IT}}&lt;\alpha&lt;\alpha_{\mathrm{alg}}</annotation></semantics></math> the IT best performances are given by the ”informed” curve. For <math id="A2.F5.m21" class="ltx_Math" alttext="\alpha&lt;\alpha_{\mathrm{IT}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&lt;</mo><msub><mi>α</mi><mi>IT</mi></msub></mrow><annotation encoding="application/x-tex">\alpha&lt;\alpha_{\mathrm{IT}}</annotation></semantics></math> and <math id="A2.F5.m22" class="ltx_Math" alttext="\alpha_{\mathrm{alg}}&lt;\alpha" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>alg</mi></msub><mo>&lt;</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{alg}}&lt;\alpha</annotation></semantics></math> the two curves are equal.</figcaption>
</figure>
<div id="A2.p7" class="ltx_para">
<p id="A2.p7.1" class="ltx_p">Considering Figure <a href="#A2.F5" title="Figure 5 ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> we can state that the extent of the hard phase <math id="A2.p7.m1" class="ltx_Math" alttext="\alpha_{\mathrm{alg}}-\alpha_{\mathrm{IT}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>alg</mi></msub><mo>−</mo><msub><mi>α</mi><mi>IT</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{alg}}-\alpha_{\mathrm{IT}}</annotation></semantics></math> decreases with the signal <math id="A2.p7.m2" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> and grows with the sequence length <math id="A2.p7.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. At finite <math id="A2.p7.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> the upper limit of the hard phase <math id="A2.p7.m5" class="ltx_Math" alttext="\alpha_{\mathrm{alg}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>alg</mi></msub><annotation encoding="application/x-tex">\alpha_{\mathrm{alg}}</annotation></semantics></math> is finite and consequently on population loss at <math id="A2.p7.m6" class="ltx_Math" alttext="\alpha=+\infty" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha=+\infty</annotation></semantics></math> the hard phase is not sensible. Notice that since we consider a noise-less setting <math id="A2.p7.m7" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math> can be exactly inferred at finite <math id="A2.p7.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</p>
</div>
<div id="A2.p8" class="ltx_para">
<p id="A2.p8.1" class="ltx_p">A possible explanation of why such a hard phase exists is that it is induced by the sparsity of the SLR. If one flatten each sequence into a single token <math id="A2.p8.m1" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> of dimension <math id="A2.p8.m2" class="ltx_Math" alttext="LD" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">LD</annotation></semantics></math> one would have a setting similar to compress sensing where <math id="A2.p8.m3" class="ltx_Math" alttext="y=\tilde{X}^{\top}\tilde{v}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><msup><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">y=\tilde{X}^{\top}\tilde{v}^{*}</annotation></semantics></math>, where the regression vector <math id="A2.p8.m4" class="ltx_Math" alttext="\tilde{v}^{*}\in\mathbb{R}^{LD}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>v</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{v}^{*}\in\mathbb{R}^{LD}</annotation></semantics></math> has a proportion <math id="A2.p8.m5" class="ltx_Math" alttext="(L-1)/L" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">(L-1)/L</annotation></semantics></math> of null entries. Compress sensing has been shown to present a similar hard phase <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib22" title="" class="ltx_ref">Krzakala et al., 2012</a>]</cite>. More generally sparsity induces hard phase, as shown for sparse PCA <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib16" title="" class="ltx_ref">Dia et al., 2016</a>]</cite> or strongly unbalanced binary SBM <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib11" title="" class="ltx_ref">Caltagirone et al., 2016</a>]</cite>.</p>
</div>
<div id="A2.p9" class="ltx_para">
<p id="A2.p9.1" class="ltx_p">An interesting particular case is the 0-SLR when <math id="A2.p9.m1" class="ltx_Math" alttext="\nu=0" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu=0</annotation></semantics></math> and the tokens are iid Gaussians bringing no information alone. As shown on Figure <a href="#A2.F5" title="Figure 5 ‣ Appendix B Bayes-optimal error at finite sample complexity 𝛼 ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> it is still possible to exactly recover <math id="A2.p9.m2" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math> and perform better than random. Indeed one can compare the train label <math id="A2.p9.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> to <math id="A2.p9.m4" class="ltx_Math" alttext="X_{l}^{\top}v" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>l</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">X_{l}^{\top}v</annotation></semantics></math> for each token <math id="A2.p9.m5" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. If <math id="A2.p9.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> has some correlations with <math id="A2.p9.m7" class="ltx_Math" alttext="v^{*}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">v^{*}</annotation></semantics></math> then <math id="A2.p9.m8" class="ltx_Math" alttext="(y-X_{l}^{\top}v)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><msubsup><mi>X</mi><mi>l</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">(y-X_{l}^{\top}v)^{2}</annotation></semantics></math> is likely to be smaller for <math id="A2.p9.m9" class="ltx_Math" alttext="l=\epsilon^{*}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><msup><mi>ϵ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">l=\epsilon^{*}</annotation></semantics></math>. This gives some information on the probable relevant token. Then one can refine <math id="A2.p9.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> by focusing more on the right <math id="A2.p9.m11" class="ltx_Math" alttext="X_{l}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>l</mi></msub><annotation encoding="application/x-tex">X_{l}</annotation></semantics></math>. At inference time one cannot use the label to guess <math id="A2.p9.m12" class="ltx_Math" alttext="\epsilon^{*}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\epsilon^{*}</annotation></semantics></math> and the prediction is simply <math id="A2.p9.m13" class="ltx_Math" alttext="\sum_{l}X_{l}^{T}v" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>l</mi></msub><mrow><msubsup><mi>X</mi><mi>l</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\sum_{l}X_{l}^{T}v</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Asymptotic characterization at finite sampling ratio: replica</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">In this part we derive the asymptotic characterization of the Bayes-optimal performances and the performances of the trained attention, at finite sampling ratio <math id="A3.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. We jointly treat the two cases, the BO and the attention, and the two models, spiked-SLR and max-SLR, taking a variable sequence length. The derivation is done for a general output channel <math id="A3.p1.m2" class="ltx_Math" alttext="P_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>out</mi></msub><annotation encoding="application/x-tex">P_{\mathrm{out}}</annotation></semantics></math> such that for each sample the label <math id="A3.p1.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is distributed with density <math id="A3.p1.m4" class="ltx_Math" alttext="P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})</annotation></semantics></math>. The additive Gaussian noise channel considered in the main part then corresponds to</p>
<table id="A3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E101.m1" class="ltx_Math" alttext="\displaystyle P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})=\frac{e^{-\frac{1}{2\Delta^{2}}(y-z^{*}_{\epsilon^{*}})^{2}}}{\sqrt{2\pi\Delta^{2}}}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>out</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><msubsup><mi>z</mi><msup><mi>ϵ</mi><mo>∗</mo></msup><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle></mrow><mo lspace="0.500em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathrm{out}}(y|z^{*}_{\epsilon^{*}})=\frac{e^{-\frac{1}{2\Delta^{2}}(y-z^{*}_{\epsilon^{*}})^{2}}}{\sqrt{2\pi\Delta^{2}}}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
</table>
<p id="A3.p1.2" class="ltx_p">Moreover the derivation is done for any convex loss function with strictly convex regularization.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Introduction of the partition function</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">We consider data <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="X,y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">X,y</annotation></semantics></math> made of <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> train samples, indexed by <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="\mu=1,\ldots,N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\mu=1,\ldots,N</annotation></semantics></math>, together with <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="N^{\prime}=\rho N" display="inline" intent=":literal"><semantics><mrow><msup><mi>N</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">N^{\prime}=\rho N</annotation></semantics></math> test samples, with <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="\rho&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho&gt;0</annotation></semantics></math>, indexed by <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="\mu=N+1,\ldots,N+N^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mu=N+1,\ldots,N+N^{\prime}</annotation></semantics></math>. They are distributed according to the generative model defined in the main part <a href="#S3.SS1" title="3.1 Overview of the single-location regression task ‣ 3 Task and data model ‣ Statistical Advantage of Softmax Attention: Insights from Single-Location Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. We will take the limit <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="\rho\to 0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho\to 0</annotation></semantics></math> at the end of the derivation, so no information can be extracted from the test samples <math id="A3.SS1.p1.m8" class="ltx_Math" alttext="X_{N+1\leq\mu\leq N+N^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>μ</mi><mo>≤</mo><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></mrow></msub><annotation encoding="application/x-tex">X_{N+1\leq\mu\leq N+N^{\prime}}</annotation></semantics></math> in a unsupervised way by the Bayes-optimal estimator.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p">The expected test square error of the attention-based estimator is</p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E102.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}(\alpha)=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}(y_{\mu}-f_{\sigma,k,v}(X_{\mu}))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>N</mi><mo>′</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>σ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}(\alpha)=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}(y_{\mu}-f_{\sigma,k,v}(X_{\mu}))^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p">where</p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E103.m1" class="ltx_Math" alttext="\displaystyle f_{\sigma,k,v}(X_{\mu})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>σ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{\sigma,k,v}(X_{\mu})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E103.m2" class="ltx_Math" alttext="\displaystyle=\sigma\left(\frac{1}{\sqrt{D}}X_{\mu}k\right)^{\top}\frac{1}{\sqrt{D}}X_{\mu}v" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma\left(\frac{1}{\sqrt{D}}X_{\mu}k\right)^{\top}\frac{1}{\sqrt{D}}X_{\mu}v</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
<tbody id="A3.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E104.m1" class="ltx_Math" alttext="\displaystyle k,v" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>,</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\displaystyle k,v</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E104.m2" class="ltx_Math" alttext="\displaystyle=\argmin_{k,v}\mathcal{L}(k,v)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo>⁡</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\argmin_{k,v}\mathcal{L}(k,v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
<tbody id="A3.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E105.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(k,v)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(k,v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E105.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\mu=1}^{N}\ell(y_{\mu},f_{\sigma,k,v}(X_{\mu}))+r_{k}\sum_{i}^{D}\gamma(k_{i})+r_{v}\sum_{i}^{D}\gamma(v_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo>,</mo><mrow><msub><mi>f</mi><mrow><mi>σ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>r</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>i</mi><mi>D</mi></munderover></mstyle><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>r</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>i</mi><mi>D</mi></munderover></mstyle><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\mu=1}^{N}\ell(y_{\mu},f_{\sigma,k,v}(X_{\mu}))+r_{k}\sum_{i}^{D}\gamma(k_{i})+r_{v}\sum_{i}^{D}\gamma(v_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p2.3" class="ltx_p">with <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\ell(x,x^{\prime})=\frac{1}{2}(x-x^{\prime})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\ell(x,x^{\prime})=\frac{1}{2}(x-x^{\prime})^{2}</annotation></semantics></math> the square loss and <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\gamma(x)=\frac{1}{2}x^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma(x)=\frac{1}{2}x^{2}</annotation></semantics></math> the <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="l_{2}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mn>2</mn></msub><annotation encoding="application/x-tex">l_{2}</annotation></semantics></math> regularization. Notice that the following derivation is done in full generality for any convex <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> and strictly convex <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. We will specialize to ridge regression at the end of the derivation.</p>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p">The expected test square error of the BO estimator is</p>
<table id="A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E106.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}(y_{\mu}-\hat{y}_{\mu}^{\mathrm{BO}})^{2}=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}\left(y_{\mu}^{2}-2y_{\mu}\hat{y}_{\mu}^{\mathrm{BO}}+(\hat{y}_{\mu}^{\mathrm{BO}})^{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>N</mi><mo>′</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>BO</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>N</mi><mo>′</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>y</mi><mi>μ</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>BO</mi></msubsup></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>BO</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}(y_{\mu}-\hat{y}_{\mu}^{\mathrm{BO}})^{2}=\mathbb{E}_{X,y}\frac{1}{N^{\prime}}\sum_{\mu=N+1}^{N+N^{\prime}}\left(y_{\mu}^{2}-2y_{\mu}\hat{y}_{\mu}^{\mathrm{BO}}+(\hat{y}_{\mu}^{\mathrm{BO}})^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p3.2" class="ltx_p">where <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="\hat{y}^{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>BO</mi></msup><annotation encoding="application/x-tex">\hat{y}^{\mathrm{BO}}</annotation></semantics></math> is the optimal estimator in terms of expected square error, that is, for a test sample <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="\mu^{\prime}&gt;N" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mo>′</mo></msup><mo>&gt;</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\mu^{\prime}&gt;N</annotation></semantics></math>:</p>
<table id="A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E107.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}=\int\mathrm{d}y_{\mu^{\prime}}\,y_{\mu^{\prime}}P(y_{\mu^{\prime}}|X,y_{\mu\leq N})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><msup><mi>μ</mi><mo>′</mo></msup><mi>BO</mi></msubsup><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><msup><mi>μ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><msup><mi>μ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><msup><mi>μ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><msub><mi>y</mi><mrow><mi>μ</mi><mo>≤</mo><mi>N</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}=\int\mathrm{d}y_{\mu^{\prime}}\,y_{\mu^{\prime}}P(y_{\mu^{\prime}}|X,y_{\mu\leq N})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(107)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p3.3" class="ltx_p">Notice that, since <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><msup><mi>μ</mi><mo>′</mo></msup><mi>BO</mi></msubsup><annotation encoding="application/x-tex">\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}</annotation></semantics></math> is sampled from the posterior distribution, we have the simplification <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="\mathbb{E}_{X,y}\,(\hat{y}_{\mu^{\prime}}^{\mathrm{BO}})^{2}=\mathbb{E}_{X,y}\,y_{\mu^{\prime}}\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><msup><mi>μ</mi><mo>′</mo></msup><mi>BO</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><msup><mi>μ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><msup><mi>μ</mi><mo>′</mo></msup><mi>BO</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{X,y}\,(\hat{y}_{\mu^{\prime}}^{\mathrm{BO}})^{2}=\mathbb{E}_{X,y}\,y_{\mu^{\prime}}\hat{y}_{\mu^{\prime}}^{\mathrm{BO}}</annotation></semantics></math>. We can expand the posterior distribution over the test labels as</p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E108.m1" class="ltx_math_unparsed" alttext="\displaystyle P(y_{\mu&gt;N}|X,y_{\mu\leq N})=\int\mathrm{d}\epsilon\mathrm{d}k\mathrm{d}v\,P(y_{\mu&gt;N},\epsilon,k,v|X,y_{\mu\leq N})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo>,</mo><msub><mi>y</mi><mrow><mi>μ</mi><mo>≤</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mi>d</mi><mi>ϵ</mi><mi>d</mi><mi>k</mi><mi>d</mi><mi>v</mi><mi>P</mi><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></msub><mo>,</mo><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo>,</mo><msub><mi>y</mi><mrow><mi>μ</mi><mo>≤</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P(y_{\mu&gt;N}|X,y_{\mu\leq N})=\int\mathrm{d}\epsilon\mathrm{d}k\mathrm{d}v\,P(y_{\mu&gt;N},\epsilon,k,v|X,y_{\mu\leq N})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
<tbody id="A3.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E109.m1" class="ltx_Math" alttext="\displaystyle\qquad\propto\int\mathrm{d}P(\epsilon,k,v|X)\,P(y|X,\epsilon,k,v)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">∝</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>,</mo><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\propto\int\mathrm{d}P(\epsilon,k,v|X)\,P(y|X,\epsilon,k,v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(109)</span></td></tr></tbody>
<tbody id="A3.E110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E110.m1" class="ltx_Math" alttext="\displaystyle\qquad\propto\int\mathrm{d}P_{k}(k)\mathrm{d}P_{v}(v)\prod_{\mu=1}^{N+N^{\prime}}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,g_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)P\left(y_{\mu}|\frac{1}{\sqrt{D}}(X_{\mu}v)_{\epsilon_{\mu}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">∝</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ϵ</mi><mi>μ</mi></msub></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\propto\int\mathrm{d}P_{k}(k)\mathrm{d}P_{v}(v)\prod_{\mu=1}^{N+N^{\prime}}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,g_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)P\left(y_{\mu}|\frac{1}{\sqrt{D}}(X_{\mu}v)_{\epsilon_{\mu}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(110)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p3.4" class="ltx_p">with <math id="A3.SS1.p3.m5" class="ltx_Math" alttext="P_{k}=P_{v}=\mathcal{N}(0,I_{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>k</mi></msub><mo>=</mo><msub><mi>P</mi><mi>v</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{k}=P_{v}=\mathcal{N}(0,I_{D})</annotation></semantics></math> the prior distribution on <math id="A3.SS1.p3.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A3.SS1.p3.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and, with an abuse of notation, <math id="A3.SS1.p3.m8" class="ltx_Math" alttext="P_{\epsilon}=\unif(\{1,\ldots,L(\mu)\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\epsilon}=\unif(\{1,\ldots,L(\mu)\})</annotation></semantics></math> the prior on <math id="A3.SS1.p3.m9" class="ltx_Math" alttext="\epsilon_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">\epsilon_{\mu}</annotation></semantics></math>. We used Bayes rule and <math id="A3.SS1.p3.m10" class="ltx_Math" alttext="P(X|\epsilon,k,v)\propto g_{\nu}(\epsilon,Xk/\sqrt{D})P(\epsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>/</mo><msqrt><mi>D</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(X|\epsilon,k,v)\propto g_{\nu}(\epsilon,Xk/\sqrt{D})P(\epsilon)</annotation></semantics></math> to rewrite <math id="A3.SS1.p3.m11" class="ltx_Math" alttext="P(\epsilon,k,v|X)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\epsilon,k,v|X)</annotation></semantics></math>; and we used the independence of the samples <math id="A3.SS1.p3.m12" class="ltx_Math" alttext="X_{\mu},y_{\mu}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>y</mi><mi>μ</mi></msub></mrow><annotation encoding="application/x-tex">X_{\mu},y_{\mu}</annotation></semantics></math> conditional on <math id="A3.SS1.p3.m13" class="ltx_Math" alttext="\epsilon_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">\epsilon_{\mu}</annotation></semantics></math>, <math id="A3.SS1.p3.m14" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A3.SS1.p3.m15" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> to factorize the expression.</p>
</div>
<div id="A3.SS1.p4" class="ltx_para">
<p id="A3.SS1.p4.1" class="ltx_p">We can express the two errors <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="\mathsf{E}_{\sigma}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{E}_{\sigma}(\alpha)</annotation></semantics></math> and <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math> under the same formalism thanks to a partition function and a free entropy over <math id="A3.SS1.p4.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A3.SS1.p4.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>:</p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E111.m1" class="ltx_Math" alttext="\displaystyle Z(X,y)=\int\mathrm{d}\tilde{P}_{k}(k)\mathrm{d}\tilde{P}_{v}(v)\int\prod_{\mu=1}^{N}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,\tilde{g}_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)\tilde{P}(y_{\mu}|X_{\mu},\epsilon_{\mu},k,v)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle Z(X,y)=\int\mathrm{d}\tilde{P}_{k}(k)\mathrm{d}\tilde{P}_{v}(v)\int\prod_{\mu=1}^{N}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,\tilde{g}_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)\tilde{P}(y_{\mu}|X_{\mu},\epsilon_{\mu},k,v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(111)</span></td></tr></tbody>
<tbody id="A3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\displaystyle\quad\int\prod_{\mu=N+1}^{N+N^{\prime}}\mathrm{d}\hat{y}_{\mu}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,\tilde{g}_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)\hat{P}(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},k,v)\,e^{\sum_{\mu=N+1}^{N+N^{\prime}}\left(sy_{\mu}(y_{\mu}-\hat{y}_{\mu})+t\beta(y_{\mu}-\hat{y}_{\mu})^{2}\right)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>μ</mi><mo>=</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></msubsup></mstyle><mrow><mo>(</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></msup></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\quad\int\prod_{\mu=N+1}^{N+N^{\prime}}\mathrm{d}\hat{y}_{\mu}\mathrm{d}P_{\epsilon}(\epsilon_{\mu})\,\tilde{g}_{\nu}\left(\epsilon_{\mu},\frac{1}{\sqrt{D}}X_{\mu}k\right)\hat{P}(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},k,v)\,e^{\sum_{\mu=N+1}^{N+N^{\prime}}\left(sy_{\mu}(y_{\mu}-\hat{y}_{\mu})+t\beta(y_{\mu}-\hat{y}_{\mu})^{2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E112.m1" class="ltx_Math" alttext="\displaystyle\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\displaystyle\phi</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E112.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{N}\mathbb{E}_{X,y}\log Z(X,y)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{N}\mathbb{E}_{X,y}\log Z(X,y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p4.2" class="ltx_p">where, depending on the estimator, the densities are taken according to</p>
<table id="A3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.EGx69.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.EGx69.m1" class="ltx_Math" alttext="\displaystyle\begin{array}[]{cccccc}&amp;\tilde{P}_{k}(k)&amp;\tilde{P}_{v}(v)&amp;\tilde{g}_{\nu}&amp;\tilde{P}(y_{\mu}|X_{\mu},\epsilon_{\mu},k,v)&amp;\hat{P}(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},k,v)\\
\hline\cr\mathrm{attention}&amp;e^{-\beta r_{k}\sum_{i}^{D}\gamma(k_{i})}&amp;e^{-\beta r_{v}\sum_{i}^{D}\gamma(v_{i})}&amp;1&amp;e^{-\beta\ell(y_{\mu},f_{\sigma,k,v}(X_{\mu}))}&amp;\delta(\hat{y}_{\mu}-f_{\sigma,k,v}(X_{\mu}))\\
\hline\cr\mathrm{BO}&amp;P_{k}(k)&amp;P_{v}(v)&amp;g_{\nu}&amp;P(y_{\mu}|X_{\mu},\epsilon_{\mu},v)&amp;P(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},v)\end{array}" display="inline" intent=":literal"><semantics><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd></mtd><mtd><mrow><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub></mtd><mtd><mrow><mover accent="true"><mi>P</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd></mtr><mtr><mtd><mi>attention</mi></mtd><mtd><mrow><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>β</mi><mi>r</mi><msub><mrow></mrow><mi>k</mi></msub><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>D</mi></msup><mi>γ</mi><mo stretchy="false">(</mo><mi>k</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msup></mrow></mtd><mtd><mrow><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>β</mi><mi>r</mi><msub><mrow></mrow><mi>v</mi></msub><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>D</mi></msup><mi>γ</mi><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msup></mrow></mtd><mtd><mn>1</mn></mtd><mtd><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo>,</mo><mrow><msub><mi>f</mi><mrow><mi>σ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mtd><mtd><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi>σ</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>μ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd><mtd class="ltx_border_t"></mtd></mtr><mtr><mtd><mi>BO</mi></mtd><mtd><mrow><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi>P</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><msub><mi>g</mi><mi>ν</mi></msub></mtd><mtd><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>ϵ</mi><mi>μ</mi></msub><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{array}[]{cccccc}&amp;\tilde{P}_{k}(k)&amp;\tilde{P}_{v}(v)&amp;\tilde{g}_{\nu}&amp;\tilde{P}(y_{\mu}|X_{\mu},\epsilon_{\mu},k,v)&amp;\hat{P}(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},k,v)\\
\hline\cr\mathrm{attention}&amp;e^{-\beta r_{k}\sum_{i}^{D}\gamma(k_{i})}&amp;e^{-\beta r_{v}\sum_{i}^{D}\gamma(v_{i})}&amp;1&amp;e^{-\beta\ell(y_{\mu},f_{\sigma,k,v}(X_{\mu}))}&amp;\delta(\hat{y}_{\mu}-f_{\sigma,k,v}(X_{\mu}))\\
\hline\cr\mathrm{BO}&amp;P_{k}(k)&amp;P_{v}(v)&amp;g_{\nu}&amp;P(y_{\mu}|X_{\mu},\epsilon_{\mu},v)&amp;P(\hat{y}_{\mu}|X_{\mu},\epsilon_{\mu},v)\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.3" class="ltx_p">with <math id="A3.SS1.p4.m5" class="ltx_Math" alttext="\beta\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\beta\to\infty</annotation></semantics></math>, so for the attention <math id="A3.SS1.p4.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A3.SS1.p4.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> concentrate onto the minimizer of the empirical loss. We introduced tilting variables <math id="A3.SS1.p4.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="A3.SS1.p4.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to access the expected test errors, obtained according to</p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E113.m1" class="ltx_Math" alttext="\displaystyle\mathsf{E}_{\sigma}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖤</mi><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{E}_{\sigma}(\alpha)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E113.m2" class="ltx_Math" alttext="\displaystyle=\lim_{\beta\to\infty}\frac{\partial}{\partial t}\frac{1}{\rho\beta}\phi|_{s=0,t=0}\ ," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\beta\to\infty}\frac{\partial}{\partial t}\frac{1}{\rho\beta}\phi|_{s=0,t=0}\ ,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
<tbody id="A3.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E114.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{BO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>BO</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{BO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E114.m2" class="ltx_Math" alttext="\displaystyle=\frac{\partial}{\partial s}\frac{1}{\rho}\phi|_{s=0,t=0}\ ." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ρ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial}{\partial s}\frac{1}{\rho}\phi|_{s=0,t=0}\ .</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Replica, free entropy</h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">We compute the free entropy <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> in the high-dimensional limit <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="N,D\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>,</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">N,D\to\infty</annotation></semantics></math>. We use the replica trick:</p>
<table id="A3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E115.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{X,y}\log Z(X,y)=\partial_{n}(\mathbb{E}_{X,y}Z(X,y)^{n})|_{n=0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∂</mo><mi>n</mi></msub><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{X,y}\log Z(X,y)=\partial_{n}(\mathbb{E}_{X,y}Z(X,y)^{n})|_{n=0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p">We introduce <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> replica, indexed by <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="a=1,\ldots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">a=1,\ldots,n</annotation></semantics></math>, and count the expectation over the data <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="X,y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">X,y</annotation></semantics></math> as an additional replica indexed by <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math> corresponding to the ground truth. We equivalently use the superscript <math id="A3.SS2.p1.m7" class="ltx_Math" alttext="*" display="inline" intent=":literal"><semantics><mo>∗</mo><annotation encoding="application/x-tex">*</annotation></semantics></math> to denote the ground truth when it is clearer to do so. We use the shorthand <math id="A3.SS2.p1.m8" class="ltx_Math" alttext="O_{\mu}^{a}=sy_{\mu}(y_{\mu}-\hat{y}_{\mu}^{a})+t\beta(y_{\mu}-\hat{y}_{\mu}^{a})^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mi>μ</mi><mi>a</mi></msubsup><mo>=</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>μ</mi></msub><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">O_{\mu}^{a}=sy_{\mu}(y_{\mu}-\hat{y}_{\mu}^{a})+t\beta(y_{\mu}-\hat{y}_{\mu}^{a})^{2}</annotation></semantics></math> for the observables. This gives</p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E116.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{X,y}Z^{n}\propto\mathbb{E}_{X,y}\int\prod_{a=1}^{n}\mathrm{d}\tilde{P}_{k}(k^{a})\mathrm{d}\tilde{P}_{v}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=1}^{n}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}\left(\epsilon_{\mu}^{a},\frac{1}{\sqrt{D}}X_{\mu}k^{a}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mi>n</mi></msup></mrow><mo>∝</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mi>μ</mi><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mi>a</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{X,y}Z^{n}\propto\mathbb{E}_{X,y}\int\prod_{a=1}^{n}\mathrm{d}\tilde{P}_{k}(k^{a})\mathrm{d}\tilde{P}_{v}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=1}^{n}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}\left(\epsilon_{\mu}^{a},\frac{1}{\sqrt{D}}X_{\mu}k^{a}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_Math" alttext="\displaystyle\quad\prod_{\mu}^{N}\prod_{a=1}^{n}\tilde{P}^{a}(y_{\mu}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\prod_{\mu&gt;N}\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\,e^{O_{\mu}^{a}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msup><mi>k</mi><mi>a</mi></msup><mo>,</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msup><mi>k</mi><mi>a</mi></msup><mo>,</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><msubsup><mi>O</mi><mi>μ</mi><mi>a</mi></msubsup></msup></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\prod_{\mu}^{N}\prod_{a=1}^{n}\tilde{P}^{a}(y_{\mu}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\prod_{\mu&gt;N}\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\,e^{O_{\mu}^{a}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E117.m1" class="ltx_Math" alttext="\displaystyle\propto\mathbb{E}_{X\sim\mathcal{N}}\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=0}^{n}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\frac{1}{\sqrt{D}}X_{\mu}k^{a}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mi>μ</mi><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mi>a</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbb{E}_{X\sim\mathcal{N}}\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=0}^{n}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\frac{1}{\sqrt{D}}X_{\mu}k^{a}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_Math" alttext="\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|X_{\mu},\epsilon_{\mu}^{*},v^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\,e^{O_{\mu}^{a}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mi>N</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msup><mi>k</mi><mi>a</mi></msup><mo>,</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></munder></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mo>∗</mo></msubsup><mo>,</mo><msup><mi>v</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mi>μ</mi></msub><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msup><mi>k</mi><mi>a</mi></msup><mo>,</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><msubsup><mi>O</mi><mi>μ</mi><mi>a</mi></msubsup></msup></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|X_{\mu},\epsilon_{\mu}^{*},v^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|X_{\mu},\epsilon_{\mu}^{a},k^{a},v^{a})\,e^{O_{\mu}^{a}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.3" class="ltx_p">where <math id="A3.SS2.p1.m9" class="ltx_Math" alttext="\tilde{P}_{k}^{a},\tilde{P}_{v}^{a},\tilde{g}_{\nu}^{a},\tilde{P}^{a}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi><mi>a</mi></msubsup><mo>,</mo><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>a</mi></msup></mrow><annotation encoding="application/x-tex">\tilde{P}_{k}^{a},\tilde{P}_{v}^{a},\tilde{g}_{\nu}^{a},\tilde{P}^{a}</annotation></semantics></math> equals <math id="A3.SS2.p1.m10" class="ltx_Math" alttext="P_{k},P_{v},g_{\nu},P" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>k</mi></msub><mo>,</mo><msub><mi>P</mi><mi>v</mi></msub><mo>,</mo><msub><mi>g</mi><mi>ν</mi></msub><mo>,</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">P_{k},P_{v},g_{\nu},P</annotation></semantics></math> if <math id="A3.SS2.p1.m11" class="ltx_Math" alttext="a=0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a=0</annotation></semantics></math> and <math id="A3.SS2.p1.m12" class="ltx_Math" alttext="\tilde{P}_{k},\tilde{P}_{v},\tilde{g}_{\nu},\tilde{P}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi></msub><mo>,</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi></msub><mo>,</mo><mover accent="true"><mi>P</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{P}_{k},\tilde{P}_{v},\tilde{g}_{\nu},\tilde{P}</annotation></semantics></math> otherwise. We now introduce the two projections</p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E118.m1" class="ltx_Math" alttext="\displaystyle\chi_{\mu}^{a}=\frac{1}{\sqrt{D}}X_{\mu}k^{a}\in\mathbb{R}^{L(\mu)}\ ,\qquad z_{\mu}^{a}=\frac{1}{\sqrt{D}}X_{\mu}v^{a}\in\mathbb{R}^{L(\mu)}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mi>a</mi></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\chi_{\mu}^{a}=\frac{1}{\sqrt{D}}X_{\mu}k^{a}\in\mathbb{R}^{L(\mu)}\ ,\qquad z_{\mu}^{a}=\frac{1}{\sqrt{D}}X_{\mu}v^{a}\in\mathbb{R}^{L(\mu)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p1.4" class="ltx_p">thanks to Dirac deltas. We integrate over Gaussian <math id="A3.SS2.p1.m13" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. We pack the replica into vectors of size <math id="A3.SS2.p1.m14" class="ltx_Math" alttext="n+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n+1</annotation></semantics></math>. This gives</p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E119.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{X,y}Z^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>,</mo><mi>y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>Z</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{X,y}Z^{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E119.m2" class="ltx_Math" alttext="\displaystyle\propto\mathbb{E}_{X\sim\mathcal{N}}\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=0}^{n}\mathrm{d}\chi_{\mu}^{a}\mathrm{d}\hat{\chi}_{\mu}^{a}\mathrm{d}z_{\mu}^{a}\mathrm{d}\hat{z}_{\mu}^{a}\mathrm{\mathrm{}}dP_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\chi_{\mu}^{a}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mi>μ</mi><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>χ</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathbb{E}_{X\sim\mathcal{N}}\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\prod_{a=0}^{n}\mathrm{d}\chi_{\mu}^{a}\mathrm{d}\hat{\chi}_{\mu}^{a}\mathrm{d}z_{\mu}^{a}\mathrm{d}\hat{z}_{\mu}^{a}\mathrm{\mathrm{}}dP_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\chi_{\mu}^{a}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_Math" alttext="\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|z_{\mu}^{*},\epsilon_{\mu}^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\,e^{O_{\mu}^{a}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mi>N</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>&gt;</mo><mi>N</mi></mrow></munder></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>P</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><msubsup><mi>O</mi><mi>μ</mi><mi>a</mi></msubsup></msup></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\prod_{\mu}^{N}\mathrm{d}y_{\mu}\prod_{a=0}^{n}\tilde{P}^{a}(y_{\mu}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\prod_{\mu&gt;N}\mathrm{d}y_{\mu}P(y_{\mu}|z_{\mu}^{*},\epsilon_{\mu}^{*})\prod_{a=1}^{n}\mathrm{d}\hat{y}_{\mu}^{a}\hat{P}(\hat{y}_{\mu}^{a}|z_{\mu}^{a},\chi_{\mu}^{a},\epsilon_{\mu}^{a})\,e^{O_{\mu}^{a}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_Math" alttext="\displaystyle\quad\prod_{a=0}^{n}\prod_{\mu}^{N+N^{\prime}}e^{\sum_{l}^{L(\mu)}\mathrm{i}\hat{\chi}_{\mu,l}^{a}\left(\chi_{\mu,l}^{a}-\frac{1}{\sqrt{D}}X_{\mu,l}k^{a}\right)+\mathrm{i}\hat{z}_{\mu,l}^{a}\left(z_{\mu,l}^{a}-\frac{1}{\sqrt{D}}X_{\mu,l}v^{a}\right)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover></mstyle><msup><mi>e</mi><mrow><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>l</mi><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mstyle><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>χ</mi><mo>^</mo></mover><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>χ</mi><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow><mi>a</mi></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mi>a</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow><mi>a</mi></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><msqrt><mi>D</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mrow><mi>μ</mi><mo>,</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>a</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\prod_{a=0}^{n}\prod_{\mu}^{N+N^{\prime}}e^{\sum_{l}^{L(\mu)}\mathrm{i}\hat{\chi}_{\mu,l}^{a}\left(\chi_{\mu,l}^{a}-\frac{1}{\sqrt{D}}X_{\mu,l}k^{a}\right)+\mathrm{i}\hat{z}_{\mu,l}^{a}\left(z_{\mu,l}^{a}-\frac{1}{\sqrt{D}}X_{\mu,l}v^{a}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E120.m1" class="ltx_Math" alttext="\displaystyle\propto\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\mathrm{d}P_{L}(L(\mu))\prod_{a=0}^{n}\mathrm{d}\chi_{\mu}^{a}\mathrm{d}z_{\mu}^{a}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\chi_{\mu}^{a}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>k</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mi>v</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>v</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mi>μ</mi><mrow><mi>N</mi><mo>+</mo><msup><mi>N</mi><mo>′</mo></msup></mrow></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>μ</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>g</mi><mo>~</mo></mover><mi>ν</mi><mi>a</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>ϵ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>,</mo><msubsup><mi>χ</mi><mi>μ</mi><mi>a</mi></msubsup><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\propto\int\prod_{a=0}^{n}\mathrm{d}\tilde{P}_{k}^{a}(k^{a})\mathrm{d}\tilde{P}_{v}^{a}(v^{a})\prod_{\mu}^{N+N^{\prime}}\mathrm{d}P_{L}(L(\mu))\prod_{a=0}^{n}\mathrm{d}\chi_{\mu}^{a}\mathrm{d}z_{\mu}^{a}\mathrm{d}P_{\epsilon}(\epsilon_{\mu}^{a})\,\tilde{g}_{\nu}^{a}\left(\epsilon_{\mu}^{a},\chi_{\mu}^{a}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
