<td id="A1.F4.sf2.3.5.2" class="ltx_td ltx_align_center"><math id="A1.F4.sf2.m6" class="ltx_Math" alttext="13.47" display="inline" intent=":literal"><semantics><mn>13.47</mn><annotation encoding="application/x-tex">13.47</annotation></semantics></math></td></tr>
