<tr id="A1.F4.sf2.3.4" class="ltx_tr">
<td id="A1.F4.sf2.3.4.1" class="ltx_td ltx_align_left">Ours (<math id="A1.F4.sf2.m3" class="ltx_Math" alttext="\tfrac{1}{4}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>4</mn></mfrac><annotation encoding="application/x-tex">\tfrac{1}{4}</annotation></semantics></math> MLPs)</td>
<td id="A1.F4.sf2.3.4.2" class="ltx_td ltx_align_center"><math id="A1.F4.sf2.m4" class="ltx_Math" alttext="12.73" display="inline" intent=":literal"><semantics><mn>12.73</mn><annotation encoding="application/x-tex">12.73</annotation></semantics></math></td></tr>
