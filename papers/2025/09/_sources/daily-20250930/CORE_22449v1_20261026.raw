<span id="A1.T9.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:63.5pt;">
<span id="A1.T9.2.3.2.1.1" class="ltx_p"><span id="A1.T9.2.3.2.1.1.1" class="ltx_text ltx_font_smallcaps">SQuAD</span></span>
</span></td>
<td id="A1.T9.2.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">27</td>
<td id="A1.T9.2.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="A1.T9.m2" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math></td></tr>
<tr id="A1.T9.2.4" class="ltx_tr">
<td id="A1.T9.2.4.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:2.5pt;padding-bottom:2.5pt;"></td>
<td id="A1.T9.2.4.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="A1.T9.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:63.5pt;">
<span id="A1.T9.2.4.2.1.1" class="ltx_p"><span id="A1.T9.2.4.2.1.1.1" class="ltx_text ltx_font_smallcaps">RepLiQA</span></span>
</span></td>
