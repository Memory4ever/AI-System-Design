<td id="S4.T1.4.1.4.3" class="ltx_td ltx_align_right ltx_border_t">0.32</td>
<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_right ltx_border_t">0.71</td>
<td id="S4.T1.4.1.4.5" class="ltx_td ltx_align_right ltx_border_t">0.66</td>
<td id="S4.T1.4.1.4.6" class="ltx_td ltx_align_right ltx_border_t">0.55</td>
<td id="S4.T1.4.1.4.7" class="ltx_td ltx_align_right ltx_border_t">0.40</td>
<td id="S4.T1.4.1.4.8" class="ltx_td ltx_align_right ltx_border_t">0.77</td>
<td id="S4.T1.4.1.4.9" class="ltx_td ltx_align_right ltx_border_t">0.29</td>
