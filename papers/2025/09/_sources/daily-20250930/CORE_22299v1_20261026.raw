<td id="S4.T1.4.1.3.5" class="ltx_td ltx_align_right ltx_border_t">0.71</td>
<td id="S4.T1.4.1.3.6" class="ltx_td ltx_align_right ltx_border_t">0.58</td>
<td id="S4.T1.4.1.3.7" class="ltx_td ltx_align_right ltx_border_t">0.45</td>
