<tr id="S4.T1.4.1.4" class="ltx_tr">
<th id="S4.T1.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="4"><span id="S4.T1.4.1.4.1.1" class="ltx_text">20%</span></th>
