<td id="S4.T2.8.1.1.9" class="ltx_td ltx_align_right ltx_border_tt">MathQA</td>
<td id="S4.T2.8.1.1.10" class="ltx_td ltx_align_right ltx_border_tt">Average</td></tr>
<tr id="S4.T2.8.1.2" class="ltx_tr">
<th id="S4.T2.8.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="10"><span id="S4.T2.8.1.2.1.1" class="ltx_text ltx_font_bold">DeepSeekMoE-16B-Base</span></th></tr>
<tr id="S4.T2.8.1.3" class="ltx_tr">
<th id="S4.T2.8.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="3"><span id="S4.T2.8.1.3.1.1" class="ltx_text">20%</span></th>
<th id="S4.T2.8.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">CAMERA-P</th>
<td id="S4.T2.8.1.3.3" class="ltx_td ltx_align_right ltx_border_t">44.00</td>
<td id="S4.T2.8.1.3.4" class="ltx_td ltx_align_right ltx_border_t">71.80</td>
<td id="S4.T2.8.1.3.5" class="ltx_td ltx_align_right ltx_border_t">70.17</td>
<td id="S4.T2.8.1.3.6" class="ltx_td ltx_align_right ltx_border_t">75.02</td>
<td id="S4.T2.8.1.3.7" class="ltx_td ltx_align_right ltx_border_t">45.56</td>
<td id="S4.T2.8.1.3.8" class="ltx_td ltx_align_right ltx_border_t">78.62</td>
<td id="S4.T2.8.1.3.9" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.8.1.3.9.1" class="ltx_text ltx_font_bold">31.46</span></td>
<td id="S4.T2.8.1.3.10" class="ltx_td ltx_align_right ltx_border_t">59.52</td></tr>
<tr id="S4.T2.8.1.4" class="ltx_tr">
<th id="S4.T2.8.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S4.T2.8.1.4.1.1" class="ltx_text ltx_font_smallcaps">Heap</span>r-L</th>
<td id="S4.T2.8.1.4.2" class="ltx_td ltx_align_right">44.01</td>
<td id="S4.T2.8.1.4.3" class="ltx_td ltx_align_right">72.64</td>
