<td id="S4.T2.8.1.1.5" class="ltx_td ltx_align_right ltx_border_tt">WinoG.</td>
<td id="S4.T2.8.1.1.6" class="ltx_td ltx_align_right ltx_border_tt">HellaS.</td>
<td id="S4.T2.8.1.1.7" class="ltx_td ltx_align_right ltx_border_tt">ARC_c</td>
