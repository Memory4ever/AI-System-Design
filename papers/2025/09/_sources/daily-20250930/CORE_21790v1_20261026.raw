<td id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold">LIBERO</span></td>
<td id="S4.T1.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S4.T1.2.1.3.1" class="ltx_text ltx_font_bold">AGIBOT-World</span></td></tr>
