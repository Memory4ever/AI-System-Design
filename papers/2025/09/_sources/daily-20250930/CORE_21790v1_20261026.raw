<td id="S4.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t">FVD<math id="S4.T1.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
