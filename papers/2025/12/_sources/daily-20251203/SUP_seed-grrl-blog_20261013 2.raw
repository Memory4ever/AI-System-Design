[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnisKjhZh5oDNKb7r7Fqp6nb&quot;:{&quot;id&quot;:&quot;doxcnisKjhZh5oDNKb7r7Fqp6nb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+7n&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;However, when robotic applications transition from ideal laboratory conditions to complex home environments, even state-of-the-art (SOTA) models struggle with tasks such as shoe lacing—seemingly trivial yet requiring high-precision, robust manipulation of deformable objects.&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;HwpFdqnz2oOUpcxbZLvc0iOpnFb&quot;:{&quot;id&quot;:&quot;HwpFdqnz2oOUpcxbZLvc0iOpnFb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnIh8nSEsI4UFo8OHZSo0qwc&quot;:{&quot;id&quot;:&quot;doxcnIh8nSEsI4UFo8OHZSo0qwc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+3v&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;For humans, \\&quot;shoe lacing\\&quot; is about muscle memory; for robots, however, it remains one of the most challenging dexterous manipulation tasks.&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;BSVad1MxjoFGObxGjOFcnijYnBE&quot;:{&quot;id&quot;:&quot;BSVad1MxjoFGObxGjOFcnijYnBE&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnhuAnMRiCYqZaAzt28YeeDb&quot;:{&quot;id&quot;:&quot;doxcnhuAnMRiCYqZaAzt28YeeDb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+2j&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Why do robots with \\&quot;general-purpose brains\\&quot; still struggle with this seemingly simple task?&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;BgSQd4qbZoTTMTxVGl4cqvivnRg&quot;:{&quot;id&quot;:&quot;BgSQd4qbZoTTMTxVGl4cqvivnRg&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnsDFG5J7zjodwmhKfrZqgJg&quot;:{&quot;id&quot;:&quot;doxcnsDFG5J7zjodwmhKfrZqgJg&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;],&quot;1&quot;:[&quot;bold&quot;,&quot;true&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+9a*0*1+x*0+1&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Research from the ByteDance Seed team identifies two fundamental flaws in the dominant imitation learning paradigms: suboptimal human demonstrations and a mismatch between training and inference. To overcome this bottleneck, the team bypassed simulation learning, which is difficult to model, and opted for a more demanding approach: real-world reinforcement learning.&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;DZP5djCDEoDlTVx8TPjcYhCpnCc&quot;:{&quot;id&quot;:&quot;DZP5djCDEoDlTVx8TPjcYhCpnCc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnc74ZnvygEiKrS2PHQnRTsg&quot;:{&quot;id&quot;:&quot;doxcnc74ZnvygEiKrS2PHQnRTsg&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;Based on this approach, the ByteDance Seed team has released its latest breakthrough, GR-RL. This framework aims to expand the capability boundaries of VLA models in long-horizon dexterous and precise manipulation.&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*1*0+5y&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]},&quot;nextNum&quot;:2}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;:{&quot;id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;page&quot;,&quot;parent_id&quot;:&quot;&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[&quot;YqU2dEKrfoC48GxAA3qc2FjUnZe&quot;,&quot;doxcnj8odth9AWNUqoPfG9bZVwg&quot;,&quot;QUVwdQ1ygobtV2xqm84cD8olnRe&quot;,&quot;doxcnisKjhZh5oDNKb7r7Fqp6nb&quot;,&quot;HwpFdqnz2oOUpcxbZLvc0iOpnFb&quot;,&quot;doxcnIh8nSEsI4UFo8OHZSo0qwc&quot;,&quot;BSVad1MxjoFGObxGjOFcnijYnBE&quot;,&quot;doxcnhuAnMRiCYqZaAzt28YeeDb&quot;,&quot;BgSQd4qbZoTTMTxVGl4cqvivnRg&quot;,&quot;doxcnsDFG5J7zjodwmhKfrZqgJg&quot;,&quot;DZP5djCDEoDlTVx8TPjcYhCpnCc&quot;,&quot;doxcnc74ZnvygEiKrS2PHQnRTsg&quot;,&quot;NECrdMX0coaJiOxmssZcfQgsnGg&quot;,&quot;Zm0BdYfFvoM0ZNxuRoacZ9ALnEb&quot;,&quot;doxcnwBDT4K7VnyhEtzWQRDBs8e&quot;,&quot;DSPJddm5Wovgc8xbOFEchK5DnSh&quot;,&quot;doxcnsFCqYlGrrFkGmywPX4fd8d&quot;,&quot;DLxzdYLiPo30iLx8XlXcolulnBg&quot;,&quot;GRlidg5wFoldvfxen9ecsWrknac&quot;,&quot;HUCAdYy3MoBzO4xAlYrcUxs8nfg&quot;,&quot;doxcnwiJCAIJV7C44un1TgkuOgf&quot;,&quot;X2UldMBMEoLI8hxHbILcoW3endg&quot;,&quot;R9HTdRfbToMoDWxAdBmco8i6nwd&quot;,&quot;doxcnBFc7SECtW5R01FhbNgvmXc&quot;,&quot;doxcnly5RxMIsCOTHzFZ3PQ60GX&quot;,&quot;doxcnYBfYRUzMs1IvEyYMh37Znc&quot;,&quot;FwGddZxS2oqnCOxrEh9cre2wnKh&quot;,&quot;doxcnCNmvtF1UdPexJuOpCfPmnN&quot;,&quot;U4LAdABUsoIMm1xTt6HchGDOnnf&quot;,&quot;doxcnH0F1lwWx2llJZvZ2KEukJc&quot;,&quot;EWfvdoyZroY2eDxAgZ8cs9Ionah&quot;,&quot;doxcnRUnSxOSnlswzGtjg1hIXfe&quot;,&quot;doxcn4psI5rTfE0d0oUAobZTS8g&quot;,&quot;doxcno3spU057cmX6AtQo9Lnh2g&quot;,&quot;ZL6EdOYA1osd6hxOfdZccftXnzg&quot;,&quot;doxcnQW82M722Qtuoh8RbXgYTZe&quot;,&quot;TeALd0743oue7pxCGVzcZEFcnOg&quot;,&quot;doxcnbqhWgQpe62tmvOfvHgmiHb&quot;,&quot;ZfNmdeGgso4stJxlPWMcDyMkn6f&quot;,&quot;doxcn8OUCtd1nqBWPAL