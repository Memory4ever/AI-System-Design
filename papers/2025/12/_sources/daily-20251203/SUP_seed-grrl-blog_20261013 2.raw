F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; max-width: 80%; margin: 0px auto;\"\u003E\u003C\u002Fvideo\u003E\u003C\u002Fp\u003E\u003Csection style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;\"\u003E\u003Cspan data-lark-record-data=\"{&quot;rootId&quot;:&quot;SbX4djHPMoN8V7xj0yZcmGYjnBh&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;GR-RL 提出了一套从离线数据筛选到在线真机微调的强化学习框架，在业界首次实现“让机器人给整只鞋连续穿鞋带”。相较前作监督学习模型 GR-3，GR-RL 在穿鞋带任务上将成功率从 45.7% 提升至 83.3%，减少了近 70% 的失败情况。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+y*1+6*0*2+g*0+y*0*3+6*0+q&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7389819644754722819&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7424339991441850396&quot;],&quot;2&quot;:[&quot;comment-id-7576975112105102280&quot;,&quot;true&quot;],&quot;3&quot;:[&quot;comment-id-7577331747222867166&quot;,&quot;true&quot;]},&quot;nextNum&quot;:4}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:true,&quot;pasteRandomId&quot;:&quot;9493a67a-0a27-4294-8366-faffaa5f0f0e&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:22,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:122},&quot;recordId&quot;:&quot;PSEYdbcUPo0HEixNAzwcOylqnhc&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx\u002Ftext\" style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;\"\u003E\u003C\u002Fspan\u003E\u003C\u002Fsection\u003E\u003Csection class=\"channels_iframe_wrp\" nodeleaf=\"\" style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;\"\u003E\u003Cmp-common-videosnap class=\"js_uneditable custom_select_card channels_iframe videosnap_video_iframe videosnap_video_iframe\" data-pluginname=\"mpvideosnap\" data-url=\"https:\u002F\u002Ffindermp.video.qq.com\u002F251\u002F20304\u002Fstodownload?encfilekey=rjD5jyTuFrIpZ2ibE8T7YmwgiahniaXswqzfv8eMsyg3QsftvU5ASwiabZcjLyduIwNAaMMYlgLmhU4qiabwfzjsIdsZIQwobCfY1LFXBI2ahmS2jKkAyAzibaUA&amp;token=x5Y29zUxcibAGgbJMusqRJwq3KySOe0WialfGiaQlDiaVzQQxmKKuuiaPicaJuPftZE7264tfYiav2BzzAZoGVhoGcyyMHKiac1RyFUOt4yMR9r8bVu9WhWPOyMRslzURcSKCIbfxKtj60R57N8HBVeRwtlKOzibsPkUAgEEjdbwuZ6aErruFfAEuhc692PABBiboTick1O&amp;hy=SH&amp;idx=1&amp;m=&amp;scene=2&amp;uzid=1&amp;wxampicformat=503&amp;picformat=200\" data-headimgurl=\"http:\u002F\u002Fwx.qlogo.cn\u002Ffinderhead\u002FdH8QVxmk2IUxxwHD4vgf1JqZOEmKuYlFcXERRj8oZFjVHfhyHicQvOZPIfMjvicCyCU1ZpJ0Os4G0\u002F0\" data-username=\"v2_060000231003b20faec8c5e78d11c1d6c60cee37b07720582dfe28a665dd0d3bce60dd395edd@finder\" data-nickname=\"字节跳动Seed\" data-desc=\"🤖还记得小时候学穿鞋带吗？对人类来说，是成长的必修课；但对机器人而言，却是操作领域最难的灵巧任务之一。&lt;br&gt;&lt;br&gt;👀今天，字节跳动 Seed 团队正式发布 GR-RL 模型，在业界首次实现“让机器人给整只鞋连续穿鞋带”，拓展了 VLA 模型在长时程、精细灵巧操作方面的能力边界。&lt;br&gt;&lt;br&gt;🚀为何 GR-RL 能挑战高精细的操作难题？这背后是一套从离线数据筛选到在线真机微调的强化学习框架。GR-RL 具备较强的鲁棒性，不仅穿鞋带成功率达 83.3%；还具备自动重试、主动调整场景、识别错位并纠偏的能力；也可应对不同颜色、尺寸和材质的鞋子。&lt;br&gt;&lt;br&gt;👉GR-RL 更多技术细节已公开，欢迎查阅项目主页：https:\u002F\u002Fseed.bytedance.com\u002Fgr_rl&lt;br&gt;&lt;br&gt;#字节seed #机器人 #强化学习 #具身智能 #robotics #字节跳动 #GR-RL\" data-nonceid=\"14164560072063492984\" data-authiconurl=\"https:\u002F\u002Fdldir1v6.qq.com\u002Fweixin\u002Fcheckresupdate\u002Ficons_filled_channels_authentication_enterprise_a2658032368245639e666fb11533a600.png\" data-width=\"1920\" data-height=\"1440\" data-type=\"video\" data-id=\"export\u002FUzFfAgtgekIEAQAAAAAAl8cZph2OGwAAAAstQy6ubaLX4KHWvLEZgBPEpaBMFjFxctKOzNPgMIsgIu94_LlF6yTvSLV47ChJ\" style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdr