quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;While pre-training equips VLA models with general perception and decision-making capabilities, it doesn't guarantee they can perform reliably in specific, real-world applications right out of the box.&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+5k&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]},&quot;nextNum&quot;:1}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;U4LAdABUsoIMm1xTt6HchGDOnnf&quot;:{&quot;id&quot;:&quot;U4LAdABUsoIMm1xTt6HchGDOnnf&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnH0F1lwWx2llJZvZ2KEukJc&quot;:{&quot;id&quot;:&quot;doxcnH0F1lwWx2llJZvZ2KEukJc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+3x&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;To explore this boundary, the team selected \\&quot;shoe lacing\\&quot; as a benchmark task, which presents three major challenges in robotic manipulation:&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;EWfvdoyZroY2eDxAgZ8cs9Ionah&quot;:{&quot;id&quot;:&quot;EWfvdoyZroY2eDxAgZ8cs9Ionah&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnRUnSxOSnlswzGtjg1hIXfe&quot;:{&quot;id&quot;:&quot;doxcnRUnSxOSnlswzGtjg1hIXfe&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+u*1+34&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Deformable Object Interaction: The shape of a shoelace changes dynamically with every force applied, making its behavior difficult to predict.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;doxcn4psI5rTfE0d0oUAobZTS8g&quot;:{&quot;id&quot;:&quot;doxcn4psI5rTfE0d0oUAobZTS8g&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+i*1+2q&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Extreme Precision: The task demands millimeter-level control to reliably thread the lace through designated eyelets.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;doxcno3spU057cmX6AtQo9Lnh2g&quot;:{&quot;id&quot;:&quot;doxcno3spU057cmX6AtQo9Lnh2g&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+o*1+2z&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Long-Horizon Robustness: The system must remain reliable over several minutes of continuous action, despite potential disturbances.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;ZL6EdOYA1osd6hxOfdZccftXnzg&quot;:{&quot;id&quot;:&quot;ZL6EdOYA1osd6hxOfdZccftXnzg&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnQW82M722Qtuoh8RbXgYTZe&quot;:{&quot;id&quot;:&quot;doxcnQW82M722Qtuoh8RbXgYTZe&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+7x&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;The team found that even a general-purpose model with strong generalization capabilities, such as GR-3 (which is trained on robot trajectories, human demonstrations, and public image-text data), could not yield a usable policy through fine-tuning alone when confronted with such tasks.&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;TeALd0743oue7pxCGVzcZEFcnOg&quot;:{&quot;id&quot;:&quot;TeALd0743oue7pxCGVzcZEFcnOg&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnbqhWgQpe62tmvOfvHgmiHb&quot;:{&quot;id&quot;:&quot;doxcnbqhWgQpe62tmvOfvHgmiHb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+38&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Why does mainstream imitation learning fall short in this context? The team pinpoints two core technical challenges:&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;ZfNmdeGgso4stJxlPWMcDyMkn6f&quot;:{&quot;id&quot;:&quot;ZfNmdeGgso4stJxlPWMcDyMkn6f&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcn8OUCtd1nqBWPALUJ040jvc&quot;:{&quot;id&quot;:&quot;doxcn8OUCtd1nqBWPALUJ040jvc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+1a*1+95&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;\\&quot;Suboptimal Segments\\&quot; in Human Demonstrations: When performing highly dexterous and precise manipulation tasks, human demonstrators instinctively slow down, hesitate, or even fail and recover multiple times. If imitation learning is applied directly, the model memorizes these inefficient or even incorrect actions, resulting in a policy that is neither decisive nor precise.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;ThNVdtfzsorAKix2hsicVATSnLc&quot;:{&quot;id&quot;:&quot;ThNVdtfzsorAKix2hsicVATSnLc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnQ0wemGVBuEyoMqobZXTw8c&quot;:{&quot;id&quot;:&quot;doxcnQ0wemGVBuEyoMqobZXTw8c&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;],&quot;1&quot;:[&quot;bold&quot;,&quot;true&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+13*1*0+1*0+g4&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Mismatch Between Training and Inference: To ensure smooth inference and control, the industry commonly applies post-processing techniques—such as temporal ensembling or receding horizon control—to predicted action sequences. While these optimizations improve motion smoothness, they also create a mismatch between the actions learned during training (Predicted Actions) and those actually executed during inference (Final Actions). In manipulation tasks requiring millimeter-level precision, this discrepancy severs the critical causal link between actions and environmental feedback, ultimately leading to task failure.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;L4RsdlvmPoSQLCxBBnKcUxJHntf&quot;:{&quot;id&quot;:&quot;L4RsdlvmPoSQLCxBBnKcUxJHntf&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcn2RH2rGTlQMqZawJDgBPTRe&quot;:{&quot;id&quot;:&quot;doxcn2RH2rGTlQMqZawJDgBPTRe&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;To overcome the bottleneck of high-precision manipulation for VLA models, a new approach is needed, one that can distill high-quality actions from imperfect demonstration data while also enabling the model to practice and learn from its own experience, allowing it to truly adapt to its deployment environment.&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+8m&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]},&quot;nextNum&quot;:1}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;:{&quot;id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;page&quot;,&quot;parent_id&quot;:&quot;&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[&quot;YqU2dEKrfoC48GxAA3qc2FjUnZe&quot;,&quot;doxcnj8odth9AWNUqoPfG9bZVwg&quot;,&quot;QUVwdQ1ygobtV2xqm84cD8olnRe&quot;,&quot;doxcnisKjhZh5oDNKb7r7Fqp6nb&quot;,&quot;HwpFdqnz2oOUpcxbZLvc0iOpnFb&quot;,&quot;doxcnIh8nSEsI4UFo8OHZSo0qwc&quot;,&quot;BSVad1MxjoFGObxGjOFcnijYnBE&quot;,&quot;doxcnhuAnMRiCYqZaAzt28YeeDb&quot;,&quot;BgSQd4qbZoTTMTxVGl4cqvivnRg&quot;,&quot;doxcnsDFG5J7zjodwmhKfrZqgJg&quot;,&quot;DZP5djCDEoDlTVx8TPjcYhCpnCc&quot;,&quot;doxcnc74ZnvygEiKrS2PHQnRTsg&quot;,&quot;NECrdMX0coaJiOxmssZcfQgsnGg&quot;,&quot;Zm0BdYfFvoM0ZNxuRoacZ9ALnEb&quot;,&quot;doxcnwBDT4K7VnyhEtzWQRDBs8e&quot;,&quot;DSPJddm5Wovgc8xbOFEchK5DnSh&quot;,&quot;doxcnsFCqYlGrrFkGmywPX4fd8d&quot;,&quot;DLxzdYLiPo30iLx8XlXcolulnBg&quot;,&quot;GRlidg5wFoldvfxen9ecsWrknac&quot;,&quot;HUCAdYy3MoBzO4xAlYrcUxs8nfg&quot;,&quot;doxcnwiJCAIJV7C44un1TgkuOgf&quot;,&quot;X2UldMBMEoLI8hxHbILcoW3endg&quot;,&quot;R9HTdRfbToMoDWxAdBmco8i6nwd&quot;,&quot;doxcnBFc7SECtW5R01FhbNgvmXc&quot;,&quot;doxcnly5RxMIsCOTHzFZ3PQ60GX&quot;,&quot;doxcnYBfYRUzMs1IvEyYMh37Znc&quot;,&quot;FwGddZxS2oqnCOxrEh9cre2wnKh&quot;,&quot;doxcnCNmvtF1UdPexJuOpCfPmnN&quot;,&quot;U4LAdABUsoIMm1xTt6HchGDOnnf&quot;,&quot;doxcnH0F1lwWx2llJZvZ2KEukJc&quot;,&quot;EWfvdoyZroY2eDxAgZ8cs9Ionah&quot;,&quot;doxcnRUnSxOSnlswzGtjg1hIXfe&quot;,&quot;doxcn4psI5rTfE0d0oUAobZTS8g&