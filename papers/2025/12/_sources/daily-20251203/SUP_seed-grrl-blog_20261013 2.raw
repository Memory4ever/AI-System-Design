t;,&quot;doxcnAh0MlHS1q749Nkkk99qdLf&quot;,&quot;doxcnJHCORGOUGWeMMUJ7nFEBIe&quot;,&quot;UhMcdkDfHoEURqxIyUCc157pnOh&quot;,&quot;doxcn9KwiYkKk05VccA7kDH9uAg&quot;,&quot;B4IsdhAC5oSxVWxxPgncRhHinCg&quot;,&quot;doxcnYd93Olnqn6RaxUsA88lSPp&quot;,&quot;IQSWdhtqBosdERxxgpQc637lnQc&quot;,&quot;doxcnPDTbTTYlAhMsHcNzHMx44g&quot;,&quot;W3bKd6Ch5oRC7lxky6Bcdz6lnsg&quot;,&quot;doxcnP0Q7bgb7ESWGDA08RZP8ue&quot;],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+4q&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Seed Research | GR-RL Released: A Breakthrough in High-Precision Manipulation for VLA Models, Applying Real-World Reinforcement Learning to Shoe Lacing for the First Time&quot;}}},&quot;align&quot;:&quot;&quot;}}},&quot;payloadMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;pasteRandomId&quot;:&quot;36af6973-ca31-4062-856d-010126c9ce27&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{},&quot;isEqualBlockSelection&quot;:true},&quot;isKeepQuoteContainer&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:51,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:53},&quot;recordId&quot;:&quot;doxcnG6Ov7pFpYweRbwoSBjogWF&quot;},{&quot;id&quot;:52,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:58},&quot;recordId&quot;:&quot;doxcnLLVXamF3oWwrc8W97xfwAh&quot;}],&quot;pasteFlag&quot;:&quot;a6934769-11bf-4c7c-a129-9ca4134d2a3c&quot;}\" data-lark-record-format=\"docx\u002Frecord\" class=\"lark-record-clipboard\"\u003E\u003C\u002Fspan\u003E\u003Ch2 data-pm-slice=\"0 0 []\" style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; line-height: 1.6em; --tw-text-opacity: 1; -webkit-tap-highlight-color: transparent; outline: 0px; text-align: center;\"\u003E\u003Cspan leaf=\"\" style=\"color: rgb(30, 173, 149); font-family: &quot;PingFang SC&quot;, system-ui, -apple-system, &quot;system-ui&quot;, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif; letter-spacing: 0.544px; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; font-size: 18px; -webkit-tap-highlight-color: transparent; outline: 0px;\"\u003EOffline and Online Multi-Stage Reinforcement Learning\u003Cbr\u003E\u003C\u002Fspan\u003E\u003Cfont color=\"#1ead95\" face=\"PingFang SC, system-ui, -apple-system, system-ui, Helvetica Neue, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Arial, sans-serif\"\u003E\u003Cspan style=\"font-size: 18px; letter-spacing: 0.544px; color: rgb(30, 173, 149);\"\u003EEnabling Robots to Learn Continuously from trial and Error\u003C\u002Fspan\u003E\u003C\u002Ffont\u003E\u003C\u002Fh2\u003E\u003Cdiv data-page-id=\"Rr07d9wHKog671x1ph0cLyfanIb\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\"\u003E\u003Cdiv style=\"text-align:left\" class=\"ace-line ace-line old-record-id-doxcnTpqOBVJlew6vMn5H0STYpc\"\u003ETo tackle the challenges of \"suboptimal human demonstrations\" and \"mismatch between training and inference,\" the Seed team developed GR-RL, a model suitable for long-horizon, high-precision dexterous manipulation tasks.\u003C\u002Fdiv\u003E\u003Cdiv class=\"ace-line ace-line old-record-id-K7h4d4VQDoil9ex98hDcoljMnrd\"\u003E\u003Cbr\u003E\u003C\u002Fdiv\u003E\u003Cdiv style=\"text-align:left\" class=\"ace-line ace-line old-record-id-doxcnwbRNhVdsTUYs7fiDcIiboh\"\u003EGR-RL extends the base VLA architecture by introducing an additional discriminator network (Critic Transformer) that evaluates the quality of the robot's actions, assigning a score to each action at every timestep in the sequence. Specifically, GR-RL employs value distribution reinforcement learning, which models the critic's output as a discrete probability distribution. This allows the model to more robustly capture the noise present in real-world environments.\u003C\u002Fdiv\u003E\u003Cdiv style=\"text-align:left\" class=\"ace-line ace-line old-record-id-doxcnwbRNhVdsTUYs7fiDcIiboh\"\u003E\u003Cbr\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003Csection style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;\"\u003E\u003Cspan data-lark-record-format=\"docx\u002Frecord\" style=\"--tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 \u002F .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotat