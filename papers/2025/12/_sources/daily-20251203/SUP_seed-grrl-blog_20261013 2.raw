t YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif; letter-spacing: 0.544px;\"\u003E\u003Cspan data-lark-record-data=\"{&quot;isCut&quot;:false,&quot;rootId&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;parentId&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;blockIds&quot;:[60,61,62,63,64,65,66,67],&quot;recordIds&quot;:[&quot;doxcnu98ViLrLtPKjIGCJw6QBKb&quot;,&quot;T5U0dXxwjoBBoRxFKdlc7d4Enyc&quot;,&quot;doxcnGWQyVt2nFYFEY3XieS5n6d&quot;,&quot;I8fZds0zOoGNLrx8QGqc0kcHnLd&quot;,&quot;doxcn9w7AUbh9juu3ep4eEjfXWb&quot;,&quot;FaX1dSsQ1om3vyx5WCscbV0MnGh&quot;,&quot;doxcnLquWLLWx2eZcunAOFWYDjb&quot;,&quot;doxcnaBCZ7f9i8MoV9XTTh5UuSd&quot;],&quot;recordMap&quot;:{&quot;doxcnu98ViLrLtPKjIGCJw6QBKb&quot;:{&quot;id&quot;:&quot;doxcnu98ViLrLtPKjIGCJw6QBKb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;Building on this architecture, GR-RL implements a multi-stage training framework designed to filter from experience and evolve in practice. This framework consists of three core components: offline reinforcement learning (RL), data augmentation, and online RL.&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+2l*0*1+19*0+3e&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;],&quot;1&quot;:[&quot;bold&quot;,&quot;true&quot;]},&quot;nextNum&quot;:2}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;T5U0dXxwjoBBoRxFKdlc7d4Enyc&quot;:{&quot;id&quot;:&quot;T5U0dXxwjoBBoRxFKdlc7d4Enyc&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnGWQyVt2nFYFEY3XieS5n6d&quot;:{&quot;id&quot;:&quot;doxcnGWQyVt2nFYFEY3XieS5n6d&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;heading4&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+1a&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Offline RL: Using Critic Models to Refine Data&quot;}}},&quot;align&quot;:&quot;left&quot;}},&quot;I8fZds0zOoGNLrx8QGqc0kcHnLd&quot;:{&quot;id&quot;:&quot;I8fZds0zOoGNLrx8QGqc0kcHnLd&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcn9w7AUbh9juu3ep4eEjfXWb&quot;:{&quot;id&quot;:&quot;doxcn9w7AUbh9juu3ep4eEjfXWb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:1,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+7c&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Since human demonstration data often contains suboptimal segments, GR-RL's first step is to use offline RL to train the discriminator network (i.e., the critic value evaluation model). This initially teaches the model to identify \\&quot;what constitutes a wrong action.\\&quot;&quot;}}},&quot;align&quot;:&quot;left&quot;,&quot;text_indent&quot;:0}},&quot;FaX1dSsQ1om3vyx5WCscbV0MnGh&quot;:{&quot;id&quot;:&quot;FaX1dSsQ1om3vyx5WCscbV0MnGh&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;text&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:[],&quot;revisions&quot;:[],&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:0,&quot;numToAttrib&quot;:{}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;&quot;}}},&quot;align&quot;:&quot;&quot;,&quot;folded&quot;:false}},&quot;doxcnLquWLLWx2eZcunAOFWYDjb&quot;:{&quot;id&quot;:&quot;doxcnLquWLLWx2eZcunAOFWYDjb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;apool&quot;:{&quot;nextNum&quot;:2,&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]}},&quot;initialAttributedTexts&quot;:{&quot;attribs&quot;:{&quot;0&quot;:&quot;*0*1+1b*1+gx&quot;},&quot;text&quot;:{&quot;0&quot;:&quot;Constructing \\&quot;Counterfactual\\&quot; Negative Samples: Trajectories collected from teleoperation are mostly successful, leading to a shortage of negative samples. To address this issue, the team marks the key frames where retries are initiated within each trajectory to construct more failed trajectories. For example, given a successful original trajectory , the team identifies the key frame  that marks the start of a retry. Besides the original successful trajectory, the system also extracts the segment before the retry  and labels it as a failure. This approach substantially expands the negative sample space without incurring additional collection costs.&quot;}}},&quot;align&quot;:&quot;&quot;}},&quot;doxcnaBCZ7f9i8MoV9XTTh5UuSd&quot;:{&quot;id&quot;:&quot;doxcnaBCZ7f9i8MoV9XTTh5UuSd&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;bullet&quot;,&quot;parent_id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[],&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;Training the Value Discriminator: On a dataset containing both successful and failed trajectories, the team trains the critic value evaluation model using Temporal Difference (TD) Learning. The figure below shows the critic model's predictions on a collected trajectory: When an operator's mistake causes the shoelace to slip out of the eyelet, the critic model's predicted value (Q-value) plummets. Conversely, when the operator's second attempt is successful, the predicted value immediately bounces back and rises steadily. Based on this signal, low-value segments with sharply declining Q-values are filtered out. Only high-quality data is retained for supervised learning, resulting in a refined base policy.&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*1*0+x*1+iw&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;bold&quot;,&quot;true&quot;],&quot;1&quot;:[&quot;author&quot;,&quot;7444063051120132097&quot;]},&quot;nextNum&quot;:2}},&quot;align&quot;:&quot;&quot;}},&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;:{&quot;id&quot;:&quot;Rr07d9wHKog671x1ph0cLyfanIb&quot;,&quot;snapshot&quot;:{&quot;type&quot;:&quot;page&quot;,&quot;parent_id&quot;:&quot;&quot;,&quot;comments&quot;:null,&quot;revisions&quot;:null,&quot;locked&quot;:false,&quot;hidden&quot;:false,&quot;author&quot;:&quot;7444063051120132097&quot;,&quot;children&quot;:[&quot;YqU2dEKrfoC48GxAA3qc2FjUnZe&quot;,&quot;doxcnj8odth9AWNUqoPfG9bZVwg&quot;,&quot;QUVwdQ1ygobtV2xqm84cD8olnRe&quot;,&quot;doxcnisKjhZh5oDNKb7r7Fqp6nb&quot;,&quot;HwpFdqnz2oOUpcxbZLvc0iOpnFb&quot;,&quot;doxcnIh8nSEsI4UFo8OHZSo0qwc&quot;,&quot;BSVad1MxjoFGObxGjOFcnijYnBE&quot;,&quot;doxcnhuAnMRiCYqZaAzt28YeeDb&quot;,&quot;BgSQd4qbZoTTMTxVGl4cqvivnRg&quot;,&quot;doxcnsDFG5J7zjodwmhKfrZqgJg&quot;,&quot;DZP5djCDEoDlTVx8TPjcYhCpnCc&quot;,&quot;doxcnc74ZnvygEiKrS2PHQnRTsg&quot;,&quot;NECrdMX0coaJiOxmssZcfQgsnGg&quot;,&quot;Zm0BdYfFvoM0ZNxuRoacZ9ALnEb&quot;,&quot;doxcnwBDT4K7VnyhEtzWQRDBs8e&quot;,&quot;DSPJddm5Wovgc8xbOFEchK5DnSh&quot;,&quot;doxcnsFCqYlGrrFkGmywPX4fd8d&quot;,&quot;DLxzdYLiPo30iLx8XlXcolulnBg&quot;,&quot;GRlidg5wFoldvfxen9ecsWrknac&quot;,&quot;HUCAdYy3MoBzO4xAlYrcUxs8nfg&quot;,&quot;doxcnwiJCAIJV7C44un1TgkuOgf&quot;,&quot;X2UldMBMEoLI8hxHbILcoW3endg&quot;,&quot;R9HTdRfbToMoDWxAdBmco8i6nwd&quot;,&quot;doxcnBFc7SECtW5R01FhbNgvmXc&quot;,&quot;doxcnly5RxMIsCOTHzFZ3PQ60GX&quot;,&quot;doxcnYBfYRUzMs1IvEyYMh37Znc&quot;,&quot;FwGddZxS2oqnCOxrEh9cre2wnKh&quot;,&quot;doxcnCNmvtF1UdP