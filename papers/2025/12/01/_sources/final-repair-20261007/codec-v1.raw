</span></td>
<td id="A1.T3.3.11.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b" style="padding-top:0.65pt;padding-bottom:0.65pt;">
<span id="A1.T3.3.11.2.1" class="ltx_inline-block ltx_align_top" style="width:269.1pt;">
<span id="A1.T3.3.11.2.1.1" class="ltx_p"><span id="A1.T3.3.11.2.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">EEG A1-REF</span><span id="A1.T3.3.11.2.1.1.2" class="ltx_text" style="font-size:80%;">, </span><span id="A1.T3.3.11.2.1.1.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">EEG A2-REF</span><span id="A1.T3.3.11.2.1.1.4" class="ltx_text" style="font-size:80%;">, </span><span id="A1.T3.3.11.2.1.1.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">EEG SP1-REF</span><span id="A1.T3.3.11.2.1.1.6" class="ltx_text" style="font-size:80%;">, </span><span id="A1.T3.3.11.2.1.1.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">EEG SP2-REF</span></span>
</span></td></tr>
