<td id="S3.T1.st2.3.3.3" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.st2.3.3.3.1" class="ltx_text" style="font-size:80%;">81 %</span></td></tr>
<tr id="S3.T1.st2.3.4" class="ltx_tr">
<th id="S3.T1.st2.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.st2.3.4.1.1" class="ltx_text" style="font-size:80%;">Random-Groups (<span id="S3.T1.st2.3.4.1.1.1" class="ltx_text ltx_font_typewriter">DAC-MC</span>)</span></th>
