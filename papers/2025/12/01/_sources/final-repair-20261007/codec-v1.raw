<th id="S3.T1.st2.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.st2.3.3.1.1" class="ltx_text" style="font-size:80%;">Single-Channel (<span id="S3.T1.st2.3.3.1.1.1" class="ltx_text ltx_font_typewriter">DAC-MC</span>)</span></th>
