<td id="S3.T1.st2.3.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.st2.3.2.3.1" class="ltx_text" style="font-size:80%;">83 %</span></td></tr>
