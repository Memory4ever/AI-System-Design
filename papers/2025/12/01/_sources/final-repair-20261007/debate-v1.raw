<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\displaystyle M^{\prime}(1,(2,a_{2}),\delta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M^{\prime}(1,(2,a_{2}),\delta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m2" class="ltx_Math" alttext="\displaystyle=1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle M^{\prime}(1,\delta,(1,a_{1}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M^{\prime}(1,\delta,(1,a_{1}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m2" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle M^{\prime}(1,\delta,(2,a_{2}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M^{\prime}(1,\delta,(2,a_{2}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m2" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle M^{\prime}(1,\delta,\delta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M^{\prime}(1,\delta,\delta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I2.i1.p1.2" class="ltx_p">I claim that <math id="A2.I2.i1.p1.m4" class="ltx_Math" alttext="M^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mo>′</mo></msup><annotation encoding="application/x-tex">M^{\prime}</annotation></semantics></math> is a perfect policy for our CKDDG. To show this, suppose <math id="A2.I2.i1.p1.m5" class="ltx_Math" alttext="s^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s^{\prime}\in S^{\prime}</annotation></semantics></math> and suppose <math id="A2.I2.i1.p1.m6" class="ltx_Math" alttext="w\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">w\in\{1,2\}</annotation></semantics></math> is the desired winner of a non-anonymous scenario in the unfurled version of our CKDDG. Let’s define <math id="A2.I2.i1.p1.m7" class="ltx_Math" alttext="i_{s^{\prime}}=\begin{cases}1&amp;u(1,s^{\prime})&gt;u(2,s^{\prime})\\
2&amp;u(2,s^{\prime})&gt;u(1,s^{\prime})\end{cases}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>2</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">i_{s^{\prime}}=\begin{cases}1&amp;u(1,s^{\prime})&gt;u(2,s^{\prime})\\
2&amp;u(2,s^{\prime})&gt;u(1,s^{\prime})\end{cases}</annotation></semantics></math> (we cannot have equality since <math id="A2.I2.i1.p1.m8" class="ltx_Math" alttext="s^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s^{\prime}\in S^{\prime}</annotation></semantics></math>). Since <math id="A2.I2.i1.p1.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is perfect and since <math id="A2.I2.i1.p1.m10" class="ltx_Math" alttext="s^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>′</mo></msup><annotation encoding="application/x-tex">s^{\prime}</annotation></semantics></math> occurred in our original CKDG with non-zero probability, agent <math id="A2.I2.i1.p1.m11" class="ltx_Math" alttext="i_{s^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">i_{s^{\prime}}</annotation></semantics></math> must have had an action to play which beat every action agent <math id="A2.I2.i1.p1.m12" class="ltx_Math" alttext="-i_{s^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">-i_{s^{\prime}}</annotation></semantics></math> could play. Let’s say that <math id="A2.I2.i1.p1.m13" class="ltx_Math" alttext="a(s^{\prime})\in A_{i_{s^{\prime}}}\cup\{\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msub><mi>A</mi><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a(s^{\prime})\in A_{i_{s^{\prime}}}\cup\{\delta\}</annotation></semantics></math> denotes this action. Now, if agent <math id="A2.I2.i1.p1.m14" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> performs action <math id="A2.I2.i1.p1.m15" class="ltx_Math" alttext="(i_{s^{\prime}},a(s^{\prime}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo>,</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i_{s^{\prime}},a(s^{\prime}))</annotation></semantics></math> in our CKDDG, they are guaranteed to win our non-anonymized scenario (this can be seen by casework on <math id="A2.I2.i1.p1.m16" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and <math id="A2.I2.i1.p1.m17" class="ltx_Math" alttext="i_{s^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">i_{s^{\prime}}</annotation></semantics></math>). Thus <math id="A2.I2.i1.p1.m18" class="ltx_Math" alttext="M^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mo>′</mo></msup><annotation encoding="application/x-tex">M^{\prime}</annotation></semantics></math> is a perfect policy for our CKDDG.</p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p1.1" class="ltx_p">To show that if the CKDDG has a perfect policy then so does the CKDG, suppose <math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="M^{\prime}:\{1,2\}\times(A\cup\{\delta\})^{2}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M^{\prime}:\{1,2\}\times(A\cup\{\delta\})^{2}\to[0,1]</annotation></semantics></math> is a perfect policy for our CKDDG. This means that for every non-anonymized scenario, the desired winner must be able to take an action which beats every available action of the desired loser. Let’s say that <math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="b:\{1,2\}\times S^{\prime}\to A\cup\{\delta\}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><mo stretchy="false">→</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">b:\{1,2\}\times S^{\prime}\to A\cup\{\delta\}</annotation></semantics></math> takes in a non-anonymized scenario and outputs such an action.</p>
</div>
<div id="A2.I2.i2.p2" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p2.1" class="ltx_p">For every <math id="A2.I2.i2.p2.m1" class="ltx_Math" alttext="s^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s^{\prime}\in S^{\prime}</annotation></semantics></math>, let’s define <math id="A2.I2.i2.p2.m2" class="ltx_Math" alttext="i_{s^{\prime}}=\begin{cases}1&amp;u(1,s^{\prime})&gt;u(2,s^{\prime})\\
2&amp;u(2,s^{\prime})&gt;u(1,s^{\prime})\end{cases}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>2</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">i_{s^{\prime}}=\begin{cases}1&amp;u(1,s^{\prime})&gt;u(2,s^{\prime})\\
2&amp;u(2,s^{\prime})&gt;u(1,s^{\prime})\end{cases}</annotation></semantics></math> as in the previous part. Now, I claim that there exists <math id="A2.I2.i2.p2.m3" class="ltx_Math" alttext="j\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,2\}</annotation></semantics></math> such that for all <math id="A2.I2.i2.p2.m4" class="ltx_Math" alttext="s^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s^{\prime}\in S^{\prime}</annotation></semantics></math>, if <math id="A2.I2.i2.p2.m5" class="ltx_Math" alttext="i_{s^{\prime}}=j" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i_{s^{\prime}}=j</annotation></semantics></math>, then <math id="A2.I2.i2.p2.m6" class="ltx_Math" alttext="b(j,s^{\prime})\notin\{(j,\delta),\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∉</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b(j,s^{\prime})\notin\{(j,\delta),\delta\}</annotation></semantics></math> (note that it’s very possible for both <math id="A2.I2.i2.p2.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="A2.I2.i2.p2.m8" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> to satisfy this property, in that case <math id="A2.I2.i2.p2.m9" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is defined arbitrarily). To prove this statement, suppose towards a contradiction that there exists <math id="A2.I2.i2.p2.m10" class="ltx_Math" alttext="s_{1}^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s_{1}^{\prime}\in S^{\prime}</annotation></semantics></math> with <math id="A2.I2.i2.p2.m11" class="ltx_Math" alttext="i_{s_{1}^{\prime}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i_{s_{1}^{\prime}}=1</annotation></semantics></math> and <math id="A2.I2.i2.p2.m12" class="ltx_Math" alttext="b(1,s_{1}^{\prime})\in\{(1,\delta),\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b(1,s_{1}^{\prime})\in\{(1,\delta),\delta\}</annotation></semantics></math> and also that there exists <math id="A2.I2.i2.p2.m13" class="ltx_Math" alttext="s_{2}^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s_{2}^{\prime}\in S^{\prime}</annotation></semantics></math> with <math id="A2.I2.i2.p2.m14" class="ltx_Math" alttext="i_{s_{2}^{\prime}}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i_{s_{2}^{\prime}}=2</annotation></semantics></math> and <math id="A2.I2.i2.p2.m15" class="ltx_Math" alttext="b(2,s_{2}^{\prime})\in\{(2,\delta),\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b(2,s_{2}^{\prime})\in\{(2,\delta),\delta\}</annotation></semantics></math>. In the non-anonymized scenario <math id="A2.I2.i2.p2.m16" class="ltx_Math" alttext="(1,s_{1}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,s_{1}^{\prime})</annotation></semantics></math> the desired loser (agent <math id="A2.I2.i2.p2.m17" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>) has access to <math id="A2.I2.i2.p2.m18" class="ltx_Math" alttext="b(2,s_{2}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b(2,s_{2}^{\prime})</annotation></semantics></math> and in the non-anonymized scenario <math id="A2.I2.i2.p2.m19" class="ltx_Math" alttext="(2,s_{2}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,s_{2}^{\prime})</annotation></semantics></math> the desired loser (agent 1) has access to <math id="A2.I2.i2.p2.m20" class="ltx_Math" alttext="b(1,s_{1}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b(1,s_{1}^{\prime})</annotation></semantics></math>. Since these actions are perfect we must have <math id="A2.I2.i2.p2.m21" class="ltx_Math" alttext="M^{\prime}(1,b(1,s_{1}^{\prime}),b(2,s_{2}^{\prime}))=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M^{\prime}(1,b(1,s_{1}^{\prime}),b(2,s_{2}^{\prime}))=1</annotation></semantics></math> and <math id="A2.I2.i2.p2.m22" class="ltx_Math" alttext="M^{\prime}(2,b(1,s_{1}^{\prime}),b(2,s_{2}^{\prime}))=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M^{\prime}(2,b(1,s_{1}^{\prime}),b(2,s_{2}^{\prime}))=1</annotation></semantics></math>, contradiction. Thus <math id="A2.I2.i2.p2.m23" class="ltx_Math" alttext="j\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,2\}</annotation></semantics></math> exists.</p>
</div>
<div id="A2.I2.i2.p3" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p3.1" class="ltx_p">Now we are ready to construct a perfect policy for our CKDG. Consider <math id="A2.I2.i2.p3.m1" class="ltx_Math" alttext="M:\{1,2\}\times(A_{1}\cup\{\delta\})\times(A_{2}\cup\{\delta\})\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mn>2</mn></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M:\{1,2\}\times(A_{1}\cup\{\delta\})\times(A_{2}\cup\{\delta\})\to[0,1]</annotation></semantics></math> defined so that <math id="A2.I2.i2.p3.m2" class="ltx_Math" alttext="M(1,a_{1},a_{2})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(1,a_{1},a_{2})</annotation></semantics></math> is equal to:</p>
<table id="A2.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}M^{\prime}(1,(1,a_{1}),(2,a_{2}))&amp;a_{1},a_{2}\neq\delta\\
\max\left(M^{\prime}(1,(1,\delta),(2,a_{2})),M^{\prime}(1,\delta,(2,a_{2}))\right)&amp;a_{1}=\delta,a_{2}\neq\delta\\
\min\left(M^{\prime}(1,(1,a_{1}),(2,\delta)),M^{\prime}(1,(1,a_{1}),\delta)\right)&amp;a_{1}\neq\delta,a_{2}=\delta\\
0&amp;a_{1},a_{2}=\delta,j=1\\
1&amp;a_{1},a_{2}=\delta,j=2\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>≠</mo><mi>δ</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mi>δ</mi></mrow><mo>,</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>≠</mo><mi>δ</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>M</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>≠</mo><mi>δ</mi></mrow><mo>,</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mi>δ</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}M^{\prime}(1,(1,a_{1}),(2,a_{2}))&amp;a_{1},a_{2}\neq\delta\\
\max\left(M^{\prime}(1,(1,\delta),(2,a_{2})),M^{\prime}(1,\delta,(2,a_{2}))\right)&amp;a_{1}=\delta,a_{2}\neq\delta\\
\min\left(M^{\prime}(1,(1,a_{1}),(2,\delta)),M^{\prime}(1,(1,a_{1}),\delta)\right)&amp;a_{1}\neq\delta,a_{2}=\delta\\
0&amp;a_{1},a_{2}=\delta,j=1\\
1&amp;a_{1},a_{2}=\delta,j=2\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I2.i2.p3.2" class="ltx_p">I claim that <math id="A2.I2.i2.p3.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a perfect policy for our original CKDG. To show this, suppose we’re in scenario <math id="A2.I2.i2.p3.m4" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>. If <math id="A2.I2.i2.p3.m5" class="ltx_Math" alttext="P(s)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">P(s)=0</annotation></semantics></math> or <math id="A2.I2.i2.p3.m6" class="ltx_Math" alttext="u(1,s)=u(2,s)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(1,s)=u(2,s)</annotation></semantics></math> then <math id="A2.I2.i2.p3.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> doesn’t contribute anything to the overall error so we can assume <math id="A2.I2.i2.p3.m8" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math>. We want agent <math id="A2.I2.i2.p3.m9" class="ltx_Math" alttext="i_{s}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>s</mi></msub><annotation encoding="application/x-tex">i_{s}</annotation></semantics></math> to have a perfect action in the original CKDG. Let’s define <math id="A2.I2.i2.p3.m10" class="ltx_Math" alttext="d(s)\in A_{i_{s}}\cup\{\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msub><mi>A</mi><msub><mi>i</mi><mi>s</mi></msub></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d(s)\in A_{i_{s}}\cup\{\delta\}</annotation></semantics></math> by:</p>
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle d(s)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle d(s)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}a&amp;b(i_{s},s)=(i_{s},a)\\
\delta&amp;b(i_{s},s)=\delta\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi>a</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mi>s</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mi>s</mi></msub><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>δ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>i</mi><mi>s</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>δ</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}a&amp;b(i_{s},s)=(i_{s},a)\\
\delta&amp;b(i_{s},s)=\delta\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I2.i2.p3.3" class="ltx_p">(Note that <math id="A2.I2.i2.p3.m11" class="ltx_Math" alttext="a\in A_{i_{s}}\cup\{\delta\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><msub><mi>A</mi><msub><mi>i</mi><mi>s</mi></msub></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\in A_{i_{s}}\cup\{\delta\}</annotation></semantics></math>.) Now <math id="A2.I2.i2.p3.m12" class="ltx_Math" alttext="d(s)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(s)</annotation></semantics></math> is a perfect action for agent <math id="A2.I2.i2.p3.m13" class="ltx_Math" alttext="i_{s}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>s</mi></msub><annotation encoding="application/x-tex">i_{s}</annotation></semantics></math> in the original CKDG as can be seen by casework.</p>
</div></li>
<li id="A2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i3.p1" class="ltx_para">
<p id="A2.I2.i3.p1.1" class="ltx_p">To show that <math id="A2.I2.i3.p1.m1" class="ltx_Math" alttext="C_{w}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>w</mi></msub><annotation encoding="application/x-tex">C_{w}</annotation></semantics></math> and <math id="A2.I2.i3.p1.m2" class="ltx_Math" alttext="C_{l}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>l</mi></msub><annotation encoding="application/x-tex">C_{l}</annotation></semantics></math> are injective, note that their outputs are always of the form <math id="A2.I2.i3.p1.m3" class="ltx_Math" alttext="\{i\}\times(C_{i}(s^{\prime})\cup\{\delta\})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>C</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\{i\}\times(C_{i}(s^{\prime})\cup\{\delta\})</annotation></semantics></math> for some <math id="A2.I2.i3.p1.m4" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math>. Thus, if we see an output of the form <math id="A2.I2.i3.p1.m5" class="ltx_Math" alttext="(i,X)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,X)</annotation></semantics></math> from either <math id="A2.I2.i3.p1.m6" class="ltx_Math" alttext="C_{w}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>w</mi></msub><annotation encoding="application/x-tex">C_{w}</annotation></semantics></math> or <math id="A2.I2.i3.p1.m7" class="ltx_Math" alttext="C_{l}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>l</mi></msub><annotation encoding="application/x-tex">C_{l}</annotation></semantics></math> then we can use injectivity of <math id="A2.I2.i3.p1.m8" class="ltx_Math" alttext="C_{1},C_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>,</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">C_{1},C_{2}</annotation></semantics></math> to find a unique <math id="A2.I2.i3.p1.m9" class="ltx_Math" alttext="s^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s^{\prime}\in S^{\prime}</annotation></semantics></math> with <math id="A2.I2.i3.p1.m10" class="ltx_Math" alttext="C_{i}(s^{\prime})=X\setminus\{\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{i}(s^{\prime})=X\setminus\{\delta\}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Economic Example Parameter Setting</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">We wish to find <math id="A3.p1.m1" class="ltx_Math" alttext="\alpha,k,l,(\mu_{i})_{i=1}^{k},(\nu_{j})_{j=1}^{l}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mo>,</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup></mrow><annotation encoding="application/x-tex">\alpha,k,l,(\mu_{i})_{i=1}^{k},(\nu_{j})_{j=1}^{l}</annotation></semantics></math> such that <math id="A3.p1.m2" class="ltx_Math" alttext="\sum_{i=1}^{k}\sum_{j=1}^{l}\theta_{i,j}\zeta_{i-1}\xi_{j-1}+\zeta_{k}+\xi_{l}\leq 0.000035" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><msubsup><mo lspace="0.167em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><mrow><msub><mi>θ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo>+</mo><msub><mi>ζ</mi><mi>k</mi></msub><mo>+</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow><mo>≤</mo><mn>0.000035</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{k}\sum_{j=1}^{l}\theta_{i,j}\zeta_{i-1}\xi_{j-1}+\zeta_{k}+\xi_{l}\leq 0.000035</annotation></semantics></math> when <math id="A3.p1.m3" class="ltx_Math" alttext="r=\frac{3596}{7}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mfrac><mn>3596</mn><mn>7</mn></mfrac></mrow><annotation encoding="application/x-tex">r=\frac{3596}{7}</annotation></semantics></math>. Let’s choose the value of <math id="A3.p1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> as well as our sequences of <math id="A3.p1.m5" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>’s and <math id="A3.p1.m6" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math>’s as hard-coded in the following Python 3 script:</p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent"><img src="2511.23454v1/arxiv_code_image.png" id="A3.p2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:908/556;" width="908" height="556" alt="[Uncaptioned image]">
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p">If we run this code, we see that our error contribution with these parameter settings is 3.4722976180203346e-05 &lt; 0.000035, as desired.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Theorem 5.1 Proof Details</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">To complete the proof of Theorem 5.1 we need upper bounds on the probabilities of our events <math id="A4.p1.m1" class="ltx_Math" alttext="E_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">E_{i,j}</annotation></semantics></math> and we need an upper bound on the probability of avoiding the <math id="A4.p1.m2" class="ltx_Math" alttext="E_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">E_{i,j}</annotation></semantics></math>’s entirely. To facilitate both of these bounds, let’s establish a lemma:</p>
</div>
<div id="A4.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma D.1</span></span><span id="A4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmtheorem1.p1.1" class="ltx_p"><span id="A4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math>.</span></p>
<ol id="A4.I1" class="ltx_enumerate">
<li id="A4.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A4.I1.ix1.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.ix1.p1.1" class="ltx_p"><span id="A4.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">Suppose </span><math id="A4.I1.ix1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="A4.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic"> is distributed according to </span><math id="A4.I1.ix1.p1.m2" class="ltx_Math" alttext="B(|C_{w}(s)|,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(|C_{w}(s)|,\beta)</annotation></semantics></math><span id="A4.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic"> and suppose </span><math id="A4.I1.ix1.p1.m3" class="ltx_Math" alttext="x\in\left(0,\beta m\right]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in\left(0,\beta m\right]</annotation></semantics></math><span id="A4.I1.ix1.p1.1.4" class="ltx_text ltx_font_italic">. Then </span><math id="A4.I1.ix1.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{P}\left[X\leq x\right]\leq e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mi>x</mi><mo>]</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow></msup><msup><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>x</mi></mfrac><mo>)</mo></mrow><mi>x</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}\left[X\leq x\right]\leq e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}</annotation></semantics></math><span id="A4.I1.ix1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A4.I1.ix2.p1" class="ltx_para">
<p id="A4.I1.ix2.p1.1" class="ltx_p"><span id="A4.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">Suppose </span><math id="A4.I1.ix2.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math><span id="A4.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic"> is distributed according to </span><math id="A4.I1.ix2.p1.m2" class="ltx_Math" alttext="B(|C_{l}(s)|,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(|C_{l}(s)|,\beta)</annotation></semantics></math><span id="A4.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic"> and suppose </span><math id="A4.I1.ix2.p1.m3" class="ltx_Math" alttext="y\in\left[\beta n,\infty\right)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mi mathvariant="normal">∞</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">y\in\left[\beta n,\infty\right)</annotation></semantics></math><span id="A4.I1.ix2.p1.1.4" class="ltx_text ltx_font_italic">. Then </span><math id="A4.I1.ix2.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{P}\left[Y\geq y\right]\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mi>y</mi><mo>]</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup><msup><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>y</mi></mfrac><mo>)</mo></mrow><mi>y</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}\left[Y\geq y\right]\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}</annotation></semantics></math><span id="A4.I1.ix2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text">Let’s use Chernoff bound on the tails of the binomial distribution:</span></p>
<ol id="A4.I2" class="ltx_enumerate">
<li id="A4.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A4.I2.ix1.p1" class="ltx_para ltx_noindent">
<p id="A4.I2.ix1.p1.1" class="ltx_p">Theorem 4.5 part (1) from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite> tells us that for all <math id="A4.I2.ix1.p1.m1" class="ltx_Math" alttext="0&lt;\gamma&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>γ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\gamma&lt;1</annotation></semantics></math>:</p>
<table id="A4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex29.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[X\leq(1-\gamma)\beta|C_{w}(s)|\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mi>β</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>C</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[X\leq(1-\gamma)\beta|C_{w}(s)|\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex29.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta|C_{w}(s)|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta|C_{w}(s)|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.ix1.p1.2" class="ltx_p">Note that this formula continues to hold if <math id="A4.I2.ix1.p1.m2" class="ltx_Math" alttext="\gamma=0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma=0</annotation></semantics></math>. We have <math id="A4.I2.ix1.p1.m3" class="ltx_Math" alttext="\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\leq 1" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mfrac><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\leq 1</annotation></semantics></math> for all <math id="A4.I2.ix1.p1.m4" class="ltx_Math" alttext="\gamma\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in[0,1)</annotation></semantics></math> and we have <math id="A4.I2.ix1.p1.m5" class="ltx_Math" alttext="\beta|C_{w}(s)|\geq\beta m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≥</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">\beta|C_{w}(s)|\geq\beta m</annotation></semantics></math> since <math id="A4.I2.ix1.p1.m6" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math> so:</p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[X\leq(1-\gamma)\beta m\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mi>β</mi><mi>m</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[X\leq(1-\gamma)\beta m\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex30.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{P}\left[X\leq(1-\gamma)\beta|C_{w}(s)|\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mi>β</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>C</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left[X\leq(1-\gamma)\beta|C_{w}(s)|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex31.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta|C_{w}(s)|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta|C_{w}(s)|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex32.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta m}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{-\gamma}}{(1-\gamma)^{(1-\gamma)}}\right)^{\beta m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.ix1.p1.3" class="ltx_p">Now we can substitute <math id="A4.I2.ix1.p1.m7" class="ltx_Math" alttext="\gamma=1-\frac{x}{\beta m}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\gamma=1-\frac{x}{\beta m}</annotation></semantics></math> to see:</p>
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex33.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[X\leq x\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mi>x</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[X\leq x\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex33.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{P}\left[X\leq\left(1-\left(1-\frac{x}{\beta m}\right)\right)\beta m\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>)</mo></mrow><mi>β</mi><mi>m</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\left[X\leq\left(1-\left(1-\frac{x}{\beta m}\right)\right)\beta m\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex34.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{-\left(1-\frac{x}{\beta m}\right)}}{\left(1-\left(1-\frac{x}{\beta m}\right)\right)^{\left(1-\left(1-\frac{x}{\beta m}\right)\right)}}\right)^{\beta m}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{-\left(1-\frac{x}{\beta m}\right)}}{\left(1-\left(1-\frac{x}{\beta m}\right)\right)^{\left(1-\left(1-\frac{x}{\beta m}\right)\right)}}\right)^{\beta m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex35.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{e^{-\left(1-\frac{x}{\beta m}\right)}}{\left(\frac{x}{\beta m}\right)^{\left(\frac{x}{\beta m}\right)}}\right)^{\beta m}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></msup><msup><mrow><mo>(</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mo>(</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac><mo>)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{e^{-\left(1-\frac{x}{\beta m}\right)}}{\left(\frac{x}{\beta m}\right)^{\left(\frac{x}{\beta m}\right)}}\right)^{\beta m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex36.m1" class="ltx_Math" alttext="\displaystyle=\frac{e^{-\left(\beta m-x\right)}}{\left(\frac{x}{\beta m}\right)^{x}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow></msup><msup><mrow><mo>(</mo><mfrac><mi>x</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac><mo>)</mo></mrow><mi>x</mi></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{e^{-\left(\beta m-x\right)}}{\left(\frac{x}{\beta m}\right)^{x}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex37.m1" class="ltx_Math" alttext="\displaystyle=e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>x</mi></mfrac></mstyle><mo>)</mo></mrow><mi>x</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A4.I2.ix2.p1" class="ltx_para">
<p id="A4.I2.ix2.p1.1" class="ltx_p">Theorem 4.4 part (1) from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite> tells us that for all <math id="A4.I2.ix2.p1.m1" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math>:</p>
<table id="A4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex38.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[Y\geq(1+\gamma)\beta|C_{l}(s)|\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mi>β</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>C</mi><mi>l</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[Y\geq(1+\gamma)\beta|C_{l}(s)|\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex38.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{\gamma}}{(1+\gamma)^{(1+\gamma)}}\right)^{\beta|C_{l}(s)|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mi>γ</mi></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{\gamma}}{(1+\gamma)^{(1+\gamma)}}\right)^{\beta|C_{l}(s)|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.ix2.p1.2" class="ltx_p">Again, note that this formula continues to hold if <math id="A4.I2.ix2.p1.m2" class="ltx_Math" alttext="\gamma=0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma=0</annotation></semantics></math>. If we substitute <math id="A4.I2.ix2.p1.m3" class="ltx_Math" alttext="\gamma=\frac{y}{\beta|C_{l}(s)|}-1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma=\frac{y}{\beta|C_{l}(s)|}-1</annotation></semantics></math> (note that <math id="A4.I2.ix2.p1.m4" class="ltx_Math" alttext="y\geq\beta n\geq\beta|C_{l}(s)|" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>≥</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≥</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\geq\beta n\geq\beta|C_{l}(s)|</annotation></semantics></math> since <math id="A4.I2.ix2.p1.m5" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math>) then we see:</p>
<table id="A4.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[Y\geq y\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mi>y</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[Y\geq y\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex39.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{P}\left[Y\geq\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)\beta|C_{l}(s)|\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mo>)</mo></mrow><mi>β</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>C</mi><mi>l</mi></msub><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\left[Y\geq\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)\beta|C_{l}(s)|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex40.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{e^{\left(\frac{y}{\beta|C_{l}(s)|}-1\right)}}{\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)^{\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)}}\right)^{\beta|C_{l}(s)|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>(</mo><mrow><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></msup><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mo>(</mo><mrow><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mo>(</mo><mrow><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{e^{\left(\frac{y}{\beta|C_{l}(s)|}-1\right)}}{\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)^{\left(1+\left(\frac{y}{\beta|C_{l}(s)|}-1\right)\right)}}\right)^{\beta|C_{l}(s)|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex41.m1" class="ltx_Math" alttext="\displaystyle=\frac{e^{\left(y-\beta|C_{l}(s)|\right)}}{\left(\frac{y}{\beta|C_{l}(s)|}\right)^{y}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mo>(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>)</mo></mrow></msup><msup><mrow><mo>(</mo><mfrac><mi>y</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mi>y</mi></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{e^{\left(y-\beta|C_{l}(s)|\right)}}{\left(\frac{y}{\beta|C_{l}(s)|}\right)^{y}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex42.m1" class="ltx_Math" alttext="\displaystyle=e^{-\beta|C_{l}(s)|}\left(\frac{e\beta|C_{l}(s)|}{y}\right)^{y}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>y</mi></mfrac></mstyle><mo>)</mo></mrow><mi>y</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\beta|C_{l}(s)|}\left(\frac{e\beta|C_{l}(s)|}{y}\right)^{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.ix2.p1.3" class="ltx_p">We can note that for fixed <math id="A4.I2.ix2.p1.m6" class="ltx_Math" alttext="w\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w\geq 0</annotation></semantics></math>, <math id="A4.I2.ix2.p1.m7" class="ltx_Math" alttext="e^{-z}\left(\frac{ez}{w}\right)^{w}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>z</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mi>w</mi></mfrac><mo>)</mo></mrow><mi>w</mi></msup></mrow><annotation encoding="application/x-tex">e^{-z}\left(\frac{ez}{w}\right)^{w}</annotation></semantics></math> is non-decreasing for <math id="A4.I2.ix2.p1.m8" class="ltx_Math" alttext="z\in[0,w]" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">z\in[0,w]</annotation></semantics></math>. Since <math id="A4.I2.ix2.p1.m9" class="ltx_Math" alttext="\beta|C_{l}(s)|,\beta n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\beta|C_{l}(s)|,\beta n</annotation></semantics></math> both lie in <math id="A4.I2.ix2.p1.m10" class="ltx_Math" alttext="[0,y]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,y]</annotation></semantics></math> and <math id="A4.I2.ix2.p1.m11" class="ltx_Math" alttext="\beta|C_{l}(s)|\leq\beta n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\beta|C_{l}(s)|\leq\beta n</annotation></semantics></math>:</p>
<table id="A4.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex43.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[Y\geq y\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mi>y</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[Y\geq y\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex43.m2" class="ltx_Math" alttext="\displaystyle\leq e^{-\beta|C_{l}(s)|}\left(\frac{e\beta|C_{l}(s)|}{y}\right)^{y}\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>y</mi></mfrac></mstyle><mo>)</mo></mrow><mi>y</mi></msup></mrow><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>y</mi></mfrac></mstyle><mo>)</mo></mrow><mi>y</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\beta|C_{l}(s)|}\left(\frac{e\beta|C_{l}(s)|}{y}\right)^{y}\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A4.p2.2" class="ltx_p"><span id="A4.p2.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A4.p3" class="ltx_para ltx_noindent">
<p id="A4.p3.1" class="ltx_p">We can now substitute specific values of <math id="A4.p3.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="A4.p3.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> into these results:</p>
</div>
<div id="A4.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma D.2</span></span><span id="A4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmtheorem2.p1.1" class="ltx_p"><span id="A4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math>.</span></p>
<ol id="A4.I3" class="ltx_enumerate">
<li id="A4.I3.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A4.I3.ix1.p1" class="ltx_para ltx_noindent">
<p id="A4.I3.ix1.p1.1" class="ltx_p"><span id="A4.I3.ix1.p1.1.1" class="ltx_text ltx_font_italic">Suppose </span><math id="A4.I3.ix1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="A4.I3.ix1.p1.1.2" class="ltx_text ltx_font_italic"> has distribution </span><math id="A4.I3.ix1.p1.m2" class="ltx_Math" alttext="B(|C_{w}(s)|,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(|C_{w}(s)|,\beta)</annotation></semantics></math><span id="A4.I3.ix1.p1.1.3" class="ltx_text ltx_font_italic"> and suppose </span><math id="A4.I3.ix1.p1.m3" class="ltx_Math" alttext="\mu\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mu\in(0,1]</annotation></semantics></math><span id="A4.I3.ix1.p1.1.4" class="ltx_text ltx_font_italic">. Then </span><math id="A4.I3.ix1.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{P}[X\leq\mu\beta m]\leq e^{-\alpha r}\left(\frac{e}{\mu}\right)^{\mu\alpha r}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">[</mo><mi>X</mi><mo>≤</mo><mi>μ</mi><mi>β</mi><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup><msup><mrow><mo>(</mo><mfrac><mi>e</mi><mi>μ</mi></mfrac><mo>)</mo></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}[X\leq\mu\beta m]\leq e^{-\alpha r}\left(\frac{e}{\mu}\right)^{\mu\alpha r}</annotation></semantics></math><span id="A4.I3.ix1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I3.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A4.I3.ix2.p1" class="ltx_para">
<p id="A4.I3.ix2.p1.1" class="ltx_p"><span id="A4.I3.ix2.p1.1.1" class="ltx_text ltx_font_italic">Suppose </span><math id="A4.I3.ix2.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math><span id="A4.I3.ix2.p1.1.2" class="ltx_text ltx_font_italic"> has distribution </span><math id="A4.I3.ix2.p1.m2" class="ltx_Math" alttext="B(|C_{l}(s)|,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(|C_{l}(s)|,\beta)</annotation></semantics></math><span id="A4.I3.ix2.p1.1.3" class="ltx_text ltx_font_italic"> and suppose </span><math id="A4.I3.ix2.p1.m3" class="ltx_Math" alttext="\nu\in\left[\frac{\alpha}{\log_{2}(r)},\infty\right)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>∈</mo><mrow><mo>[</mo><mfrac><mi>α</mi><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>,</mo><mi mathvariant="normal">∞</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu\in\left[\frac{\alpha}{\log_{2}(r)},\infty\right)</annotation></semantics></math><span id="A4.I3.ix2.p1.1.4" class="ltx_text ltx_font_italic">. Then </span><math id="A4.I3.ix2.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{P}\left[Y\geq\nu\log_{2}(r)\right]\leq e^{-\alpha}r^{-\nu\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mi>ν</mi><msub><mi>log</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><msup><mi>r</mi><mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{P}\left[Y\geq\nu\log_{2}(r)\right]\leq e^{-\alpha}r^{-\nu\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}</annotation></semantics></math><span id="A4.I3.ix2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.p4" class="ltx_para ltx_noindent">
<p id="A4.p4.1" class="ltx_p"><span id="A4.p4.1.1" class="ltx_text">Let’s appeal to Lemma <a href="#A4.Thmtheorem1" title="Lemma D.1. ‣ Appendix D Theorem 5.1 Proof Details ‣ Designing Rules for Choosing a Winner in a Debate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>.</span></p>
<ol id="A4.I4" class="ltx_enumerate">
<li id="A4.I4.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A4.I4.ix1.p1" class="ltx_para ltx_noindent">
<p id="A4.I4.ix1.p1.1" class="ltx_p">Define <math id="A4.I4.ix1.p1.m1" class="ltx_Math" alttext="x=\mu\alpha r=\mu\beta m" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>=</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">x=\mu\alpha r=\mu\beta m</annotation></semantics></math>. We have <math id="A4.I4.ix1.p1.m2" class="ltx_Math" alttext="x\in(0,\beta m]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in(0,\beta m]</annotation></semantics></math> since <math id="A4.I4.ix1.p1.m3" class="ltx_Math" alttext="\mu\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mu\in(0,1]</annotation></semantics></math>. By Lemma <a href="#A4.Thmtheorem1" title="Lemma D.1. ‣ Appendix D Theorem 5.1 Proof Details ‣ Designing Rules for Choosing a Winner in a Debate" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a> part (i):</p>
<table id="A4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex44.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[X\leq\mu\beta m\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>≤</mo><mi>μ</mi><mi>β</mi><mi>m</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[X\leq\mu\beta m\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex44.m2" class="ltx_Math" alttext="\displaystyle\leq e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}=e^{-\alpha r}\left(\frac{e\alpha r}{\mu\alpha r}\right)^{\mu\alpha r}=e^{-\alpha r}\left(\frac{e}{\mu}\right)^{\mu\alpha r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>x</mi></mfrac></mstyle><mo>)</mo></mrow><mi>x</mi></msup></mrow><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>e</mi><mi>μ</mi></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\beta m}\left(\frac{e\beta m}{x}\right)^{x}=e^{-\alpha r}\left(\frac{e\alpha r}{\mu\alpha r}\right)^{\mu\alpha r}=e^{-\alpha r}\left(\frac{e}{\mu}\right)^{\mu\alpha r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I4.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A4.I4.ix2.p1" class="ltx_para">
<p id="A4.I4.ix2.p1.1" class="ltx_p">Define <math id="A4.I4.ix2.p1.m1" class="ltx_Math" alttext="y=\nu\log_{2}(r)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y=\nu\log_{2}(r)</annotation></semantics></math>. We have <math id="A4.I4.ix2.p1.m2" class="ltx_Math" alttext="y\in\left[\beta n,\infty\right)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mi mathvariant="normal">∞</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">y\in\left[\beta n,\infty\right)</annotation></semantics></math> because:</p>
<table id="A4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex45.m1" class="ltx_Math" alttext="\displaystyle\nu\log_{2}(r)\geq\frac{\alpha}{\log_{2}(r)}\log_{2}(r)=\alpha=\beta n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mi>α</mi><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nu\log_{2}(r)\geq\frac{\alpha}{\log_{2}(r)}\log_{2}(r)=\alpha=\beta n</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I4.ix2.p1.2" class="ltx_p">Thus:</p>
<table id="A4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex46.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\left[Y\geq\nu\log_{2}(r)\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>≥</mo><mi>ν</mi><msub><mi>log</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[Y\geq\nu\log_{2}(r)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex46.m2" class="ltx_Math" alttext="\displaystyle\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>y</mi></mfrac></mstyle><mo>)</mo></mrow><mi>y</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\beta n}\left(\frac{e\beta n}{y}\right)^{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex47.m1" class="ltx_Math" alttext="\displaystyle=e^{-\alpha}\left(\frac{e\alpha}{\nu\log_{2}(r)}\right)^{\nu\log_{2}(r)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\alpha}\left(\frac{e\alpha}{\nu\log_{2}(r)}\right)^{\nu\log_{2}(r)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex48.m1" class="ltx_Math" alttext="\displaystyle=e^{-\alpha}2^{\log_{2}\left(\frac{e\alpha}{\nu\log_{2}(r)}\right)\nu\log_{2}(r)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\alpha}2^{\log_{2}\left(\frac{e\alpha}{\nu\log_{2}(r)}\right)\nu\log_{2}(r)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
