<td id="A1.T2.2.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><math id="A1.T2.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
