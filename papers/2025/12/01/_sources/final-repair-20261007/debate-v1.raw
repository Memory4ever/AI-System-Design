<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex49.m1" class="ltx_Math" alttext="\displaystyle=e^{-\alpha}2^{-\nu\log_{2}(r)\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\alpha}2^{-\nu\log_{2}(r)\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex50.m1" class="ltx_Math" alttext="\displaystyle=e^{-\alpha}r^{-\nu\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=e^{-\alpha}r^{-\nu\log_{2}\left(\frac{\nu\log_{2}(r)}{e\alpha}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A4.p4.2" class="ltx_p"><span id="A4.p4.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A4.p5" class="ltx_para ltx_noindent">
<p id="A4.p5.1" class="ltx_p">Now we can proceed with proving our upper bounds for Theorem 5.1:</p>
<ul id="A4.I5" class="ltx_itemize">
<li id="A4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="A4.I5.i1.p1.1" class="ltx_p">Suppose <math id="A4.I5.i1.p1.m1" class="ltx_Math" alttext="s\in S^{\prime},X\sim B(|C_{w}(s)|,\beta),Y\sim B(|C_{l}(s)|,\beta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>X</mi><mo>∼</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>Y</mi><mo>∼</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">s\in S^{\prime},X\sim B(|C_{w}(s)|,\beta),Y\sim B(|C_{l}(s)|,\beta)</annotation></semantics></math> where <math id="A4.I5.i1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A4.I5.i1.p1.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> are independent. Suppose <math id="A4.I5.i1.p1.m4" class="ltx_Math" alttext="i\in\{1,...,k\},j\in\{1,...,l\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,...,k\},j\in\{1,...,l\}</annotation></semantics></math>. We have:</p>
<table id="A4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex51.m1" class="ltx_Math" alttext="\displaystyle\,\mathbb{P}\left[E_{i,j}\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>E</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{P}\left[E_{i,j}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex52.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex52.m2" class="ltx_math_unparsed" alttext="\displaystyle\,\mathbb{P}\Bigg[X\in\left[\mu_{i}\beta m,\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases}\right)," display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>X</mi><mo>∈</mo><mrow><mo>[</mo><msub><mi>μ</mi><mi>i</mi></msub><mi>β</mi><mi>m</mi><mo>,</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>μ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∞</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>)</mo></mrow><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{P}\Bigg[X\in\left[\mu_{i}\beta m,\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex53.m1" class="ltx_math_unparsed" alttext="\displaystyle\,Y\in\left(\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases},\nu_{j}\log_{2}(r)\right]\Bigg]" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∈</mo><mrow><mo>(</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ν</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>,</mo><msub><mi>ν</mi><mi>j</mi></msub><msub><mi>log</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\,Y\in\left(\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases},\nu_{j}\log_{2}(r)\right]\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex54.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex54.m2" class="ltx_Math" alttext="\displaystyle\,\mathbb{P}\left[X&lt;\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases},Y&gt;\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases}\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>X</mi><mo>⁡</mo><mrow><mo>&lt;</mo><mrow><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>μ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∞</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>,</mo><mi>Y</mi></mrow><mo>&gt;</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ν</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{P}\left[X&lt;\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases},Y&gt;\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex55.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex55.m2" class="ltx_math_unparsed" alttext="\displaystyle\,\mathbb{P}\left[X&lt;\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases}\right]\mathbb{P}\left[Y&gt;\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases}\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>&lt;</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>μ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∞</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>]</mo></mrow><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>&gt;</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ν</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{P}\left[X&lt;\begin{cases}\mu_{i-1}\beta m&amp;i\geq 2\\
\infty&amp;i=1\end{cases}\right]\mathbb{P}\left[Y&gt;\begin{cases}\nu_{j-1}\log_{2}(r)&amp;j\geq 2\\
-\infty&amp;j=1\end{cases}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex56.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex56.m2" class="ltx_Math" alttext="\displaystyle\,\left(\begin{cases}e^{-\alpha r}\left(\frac{e}{\mu_{i-1}}\right)^{\mu_{i-1}\alpha r}&amp;i\geq 2\\
1&amp;i=1\end{cases}\right)\left(\begin{cases}e^{-\alpha}r^{-\nu_{j-1}\log_{2}\left(\frac{\nu_{j-1}\log_{2}(r)}{e\alpha}\right)}&amp;j\geq 2\\
1&amp;j=1\end{cases}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mi>e</mi><msub><mi>μ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mfrac><mo>)</mo></mrow><mrow><msub><mi>μ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mrow><msub><mi>ν</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>ν</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></msup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\left(\begin{cases}e^{-\alpha r}\left(\frac{e}{\mu_{i-1}}\right)^{\mu_{i-1}\alpha r}&amp;i\geq 2\\
1&amp;i=1\end{cases}\right)\left(\begin{cases}e^{-\alpha}r^{-\nu_{j-1}\log_{2}\left(\frac{\nu_{j-1}\log_{2}(r)}{e\alpha}\right)}&amp;j\geq 2\\
1&amp;j=1\end{cases}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex57.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex57.m2" class="ltx_Math" alttext="\displaystyle\,\zeta_{i-1}\xi_{j-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\,\zeta_{i-1}\xi_{j-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I5.i2.p1" class="ltx_para">
<p id="A4.I5.i2.p1.1" class="ltx_p">Suppose <math id="A4.I5.i2.p1.m1" class="ltx_Math" alttext="s\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">s\in S^{\prime}</annotation></semantics></math>. The only way for <math id="A4.I5.i2.p1.m2" class="ltx_Math" alttext="X,Y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">X,Y</annotation></semantics></math> to avoid all of the <math id="A4.I5.i2.p1.m3" class="ltx_Math" alttext="E_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">E_{i,j}</annotation></semantics></math> events is if <math id="A4.I5.i2.p1.m4" class="ltx_Math" alttext="X&lt;\mu_{k}\beta m" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>&lt;</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">X&lt;\mu_{k}\beta m</annotation></semantics></math> or if <math id="A4.I5.i2.p1.m5" class="ltx_Math" alttext="Y&gt;\nu_{l}\log_{2}(r)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>&gt;</mo><mrow><msub><mi>ν</mi><mi>l</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Y&gt;\nu_{l}\log_{2}(r)</annotation></semantics></math>. We can thus apply a union bound to see that:</p>
<table id="A4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex58.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left[\underset{\begin{subarray}{c}i\in\{1,...,k\}\\
j\in\{1,...,l\}\end{subarray}}{\bigcap}E_{i,j}^{c}\right]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder accentunder="true"><mstyle displaystyle="true"><mo movablelimits="false">⋂</mo></mstyle><mtable rowspacing="0pt"><mtr><mtd><mrow><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">k</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi mathsize="0.700em">j</mi><mo mathsize="0.700em">∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">l</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr></mtable></munder><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>E</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>c</mi></msubsup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left[\underset{\begin{subarray}{c}i\in\{1,...,k\}\\
j\in\{1,...,l\}\end{subarray}}{\bigcap}E_{i,j}^{c}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex58.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{P}\left[X&lt;\mu_{k}\beta m\right]+\mathbb{P}\left[Y&gt;\nu_{l}\log_{2}(r)\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo>[</mo><mi>X</mi><mo>&lt;</mo><msub><mi>μ</mi><mi>k</mi></msub><mi>β</mi><mi>m</mi><mo>]</mo></mrow><mo>+</mo><mi>ℙ</mi><mrow><mo>[</mo><mi>Y</mi><mo>&gt;</mo><msub><mi>ν</mi><mi>l</mi></msub><msub><mi>log</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left[X&lt;\mu_{k}\beta m\right]+\mathbb{P}\left[Y&gt;\nu_{l}\log_{2}(r)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex59.m1" class="ltx_Math" alttext="\displaystyle\leq e^{-\alpha r}\left(\frac{e}{\mu_{k}}\right)^{\mu_{k}\alpha r}+e^{-\alpha}r^{-\nu_{l}\log_{2}\left(\frac{\nu_{l}\log_{2}(r)}{e\alpha}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>e</mi><msub><mi>μ</mi><mi>k</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mrow><msub><mi>ν</mi><mi>l</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>ν</mi><mi>l</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\alpha r}\left(\frac{e}{\mu_{k}}\right)^{\mu_{k}\alpha r}+e^{-\alpha}r^{-\nu_{l}\log_{2}\left(\frac{\nu_{l}\log_{2}(r)}{e\alpha}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex60.m1" class="ltx_Math" alttext="\displaystyle=\zeta_{k}+\xi_{l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo>+</mo><msub><mi>ξ</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\zeta_{k}+\xi_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="A4.p6" class="ltx_para ltx_noindent">
<p id="A4.p6.1" class="ltx_p">Thus the proof of Theorem 5.1 is complete.</p>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Common Knowledge Error Lower Bound</h2>

<div id="A5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem E.1</span></span><span id="A5.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem1.p1" class="ltx_para">
<p id="A5.Thmtheorem1.p1.1" class="ltx_p"><span id="A5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="m,n\in\mathbb{N}^{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><mo>∈</mo><msup><mi>ℕ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">m,n\in\mathbb{N}^{+}</annotation></semantics></math> with <math id="A5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="m\geq n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\geq n</annotation></semantics></math>. Then there exists a CKDDG <math id="A5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="B=(A,S,P,C_{w},C_{l})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>P</mi><mo>,</mo><msub><mi>C</mi><mi>w</mi></msub><mo>,</mo><msub><mi>C</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B=(A,S,P,C_{w},C_{l})</annotation></semantics></math> such that <math id="A5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="|C_{w}(s)|\geq m,|C_{l}(s)|\leq n" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>m</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">|C_{w}(s)|\geq m,|C_{l}(s)|\leq n</annotation></semantics></math> for all <math id="A5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> but <math id="A5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="e^{\text{CKDDG}}_{B}(M)\geq\frac{2n-m}{2m}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>e</mi><mi>B</mi><mtext class="ltx_mathvariant_italic">CKDDG</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mi>m</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">e^{\text{CKDDG}}_{B}(M)\geq\frac{2n-m}{2m}</annotation></semantics></math> for all policies <math id="A5.Thmtheorem1.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p"><span id="A5.p1.1.1" class="ltx_text">Let’s consider the CKDDG with the exact same specification as the PIDDG from the proof of Theorem 5.5: <math id="A5.p1.m1" class="ltx_Math" alttext="A=\{1,...,m\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A=\{1,...,m\}</annotation></semantics></math>, <math id="A5.p1.m2" class="ltx_Math" alttext="S=\begin{pmatrix}A\\
n\end{pmatrix}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mi>A</mi></mtd></mtr><mtr><mtd><mi>n</mi></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">S=\begin{pmatrix}A\\
n\end{pmatrix}</annotation></semantics></math>, <math id="A5.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is uniform over <math id="A5.p1.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, and <math id="A5.p1.m5" class="ltx_Math" alttext="C_{w}(s)=A,C_{l}(s)=s" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>A</mi></mrow><mo>,</mo><mrow><mrow><msub><mi>C</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">C_{w}(s)=A,C_{l}(s)=s</annotation></semantics></math> for all <math id="A5.p1.m6" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math>. Let <math id="A5.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a policy for this CKDDG.</span></p>
</div>
<div id="A5.p2" class="ltx_para ltx_noindent">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text">Let’s repeat the key idea from the proof of Theorem 5.5: let’s pretend that we’re in a new de-anonymized scenario where agents <math id="A5.p2.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="A5.p2.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> have access to every possible action and let’s define <math id="A5.p2.m3" class="ltx_Math" alttext="q_{1}^{*},q_{2}^{*}:(A\cup\{\delta\})\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo>,</mo><mrow><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{1}^{*},q_{2}^{*}:(A\cup\{\delta\})\to[0,1]</annotation></semantics></math> to be Nash equilibrium strategies in this made-up de-anonymized scenario. Let <math id="A5.p2.m4" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> denote the value to agent <math id="A5.p2.m5" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math> of this de-anonymized scenario where <math id="A5.p2.m6" class="ltx_Math" alttext="v_{1}+v_{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>+</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">v_{1}+v_{2}=1</annotation></semantics></math>. Let’s again consider the strategies <math id="A5.p2.m7" class="ltx_Math" alttext="q_{i}^{l}:S\to(A\cup\{\delta\})\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mi>l</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{l}:S\to(A\cup\{\delta\})\to[0,1]</annotation></semantics></math> for <math id="A5.p2.m8" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math> defined by:</span></p>
<table id="A5.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex61.m1" class="ltx_Math" alttext="\displaystyle q_{i}^{l}(s)(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{i}^{l}(s)(a)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex61.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}q_{i}^{*}(a)&amp;a\in s\\
0&amp;a\in A\setminus s\\
q_{i}^{*}(\delta)+\sum_{b\in A\setminus s}q_{i}^{*}(b)&amp;a=\delta\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>q</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>a</mi><mo>∈</mo><mi>s</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>a</mi><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>q</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>b</mi><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></msub><mrow><msubsup><mi>q</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>a</mi><mo>=</mo><mi>δ</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}q_{i}^{*}(a)&amp;a\in s\\
0&amp;a\in A\setminus s\\
q_{i}^{*}(\delta)+\sum_{b\in A\setminus s}q_{i}^{*}(b)&amp;a=\delta\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.2" class="ltx_p"><span id="A5.p2.2.1" class="ltx_text">Let’s lower-bound the error by considering the value agent <math id="A5.p2.m9" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math> receives in de-anonymized scenario <math id="A5.p2.m10" class="ltx_Math" alttext="(-i,s)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>i</mi></mrow><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(-i,s)</annotation></semantics></math> by committing to the strategy <math id="A5.p2.m11" class="ltx_Math" alttext="q_{i}^{l}(s)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{l}(s)</annotation></semantics></math> for <math id="A5.p2.m12" class="ltx_Math" alttext="i\in\{1,2\},s\in S" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\},s\in S</annotation></semantics></math>. If agent <math id="A5.p2.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> commits to the strategy <math id="A5.p2.m14" class="ltx_Math" alttext="q_{1}^{l}(s)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>1</mn><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{1}^{l}(s)</annotation></semantics></math> in de-anonymized scenario <math id="A5.p2.m15" class="ltx_Math" alttext="(2,s)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,s)</annotation></semantics></math> then agent <math id="A5.p2.m16" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> can guarantee a winning probability of at least:</span></p>
<table id="A5.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex62.m1" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}(q_{1}^{l}(s))^{\intercal}M(1,\cdot,a_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>q</mi><mn>1</mn><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊺</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}(q_{1}^{l}(s))^{\intercal}M(1,\cdot,a_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex63.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex63.m2" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left(\sum_{a_{1}\in s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})+\left(q_{1}^{*}(\delta)+\sum_{b\in A\setminus s}q_{1}^{*}(b)\right)M(1,\delta,a_{2})\right)" display="inline" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mi>s</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left(\sum_{a_{1}\in s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})+\left(q_{1}^{*}(\delta)+\sum_{b\in A\setminus s}q_{1}^{*}(b)\right)M(1,\delta,a_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex64.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex64.m2" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left(\sum_{a_{1}\in s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})+q_{1}^{*}(\delta)M(1,\delta,a_{2})\right)" display="inline" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mi>s</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>δ</mi><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left(\sum_{a_{1}\in s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})+q_{1}^{*}(\delta)M(1,\delta,a_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex65.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex65.m2" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left((q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})\right)" display="inline" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left((q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})M(1,a_{1},a_{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex66.m1" class="ltx_Math" alttext="\displaystyle\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex66.m2" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left((q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right)" display="inline" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}\left((q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex67.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex67.m2" class="ltx_Math" alttext="\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}(q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>δ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>⊺</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\min_{a_{2}\in A\cup\{\delta\}}(q_{1}^{*})^{\intercal}M(1,\cdot,a_{2})-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex68.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex68.m2" class="ltx_Math" alttext="\displaystyle\,v_{1}-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,v_{1}-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.3" class="ltx_p"><span id="A5.p2.3.1" class="ltx_text">In the last step we have used the fact that <math id="A5.p2.m17" class="ltx_Math" alttext="q_{1}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><annotation encoding="application/x-tex">q_{1}^{*}</annotation></semantics></math> is a Nash equilibrium strategy. A symmetric line of reasoning shows that if agent <math id="A5.p2.m18" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> commits to the strategy <math id="A5.p2.m19" class="ltx_Math" alttext="q_{2}^{l}(s)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mn>2</mn><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{2}^{l}(s)</annotation></semantics></math> in de-anonymized scenario <math id="A5.p2.m20" class="ltx_Math" alttext="(1,s)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,s)</annotation></semantics></math> then agent <math id="A5.p2.m21" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> can guarantee a winning probability of at least <math id="A5.p2.m22" class="ltx_Math" alttext="v_{2}-\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>2</mn></msub><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></msub><mrow><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{2}-\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p"><span id="A5.p3.1.1" class="ltx_text">Finally, taking the expectation over <math id="A5.p3.m1" class="ltx_Math" alttext="s\in S" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">s\in S</annotation></semantics></math> shows that:</span></p>
<table id="A5.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex69.m1" class="ltx_Math" alttext="\displaystyle e_{B}^{\text{CKDDG}}(M)\geq" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>e</mi><mi>B</mi><mtext>CKDDG</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle e_{B}^{\text{CKDDG}}(M)\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex69.m2" class="ltx_Math" alttext="\displaystyle\,\underset{s\sim P}{\mathbb{E}}\left[\frac{\left(v_{1}-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right)+\left(v_{2}-\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})\right)}{2}\right]" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo>(</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></msub><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></msub><mrow><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\underset{s\sim P}{\mathbb{E}}\left[\frac{\left(v_{1}-\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right)+\left(v_{2}-\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})\right)}{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex70.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex70.m2" class="ltx_Math" alttext="\displaystyle\,\frac{v_{1}+v_{2}}{2}-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right]-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>+</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\frac{v_{1}+v_{2}}{2}-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{1}\in A\setminus s}q_{1}^{*}(a_{1})\right]-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{2}\in A\setminus s}q_{2}^{*}(a_{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex71.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex71.m2" class="ltx_Math" alttext="\displaystyle\,\frac{1}{2}-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{1}\in A}\chi_{A\setminus s}(a_{1})q_{1}^{*}(a_{1})\right]-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{2}\in A}\chi_{A\setminus s}(a_{2})q_{2}^{*}(a_{2})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mi>A</mi></mrow></munder></mstyle><mrow><msub><mi>χ</mi><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mi>A</mi></mrow></munder></mstyle><mrow><msub><mi>χ</mi><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\frac{1}{2}-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{1}\in A}\chi_{A\setminus s}(a_{1})q_{1}^{*}(a_{1})\right]-\frac{1}{2}\underset{s\sim P}{\mathbb{E}}\left[\sum_{a_{2}\in A}\chi_{A\setminus s}(a_{2})q_{2}^{*}(a_{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex72.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex72.m2" class="ltx_Math" alttext="\displaystyle\,\frac{1}{2}-\frac{1}{2}\sum_{a_{1}\in A}q_{1}^{*}(a_{1})\underset{s\sim P}{\mathbb{E}}\left[\chi_{A\setminus s}(a_{1})\right]-\frac{1}{2}\sum_{a_{2}\in A}q_{2}^{*}(a_{2})\underset{s\sim P}{\mathbb{E}}\left[\chi_{A\setminus s}(a_{2})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>∈</mo><mi>A</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>χ</mi><mrow><mi>A</mi><mo>∖</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mi>A</mi></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize=