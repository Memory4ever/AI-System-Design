<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathop{\leq}\limits^{\text{(a)}}\frac{1}{2}\left\|\mathbf{X}_{n,t}-\eta_{n}\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}-\mathbf{U}_{n,t}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mover><mo movablelimits="false">≤</mo><mtext>(a)</mtext></mover><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msup><mrow><mo>‖</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>η</mi><mi>n</mi></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\leq}\limits^{\text{(a)}}\frac{1}{2}\left\|\mathbf{X}_{n,t}-\eta_{n}\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}-\mathbf{U}_{n,t}\right\|^{2}</annotation></semantics></math></td>
