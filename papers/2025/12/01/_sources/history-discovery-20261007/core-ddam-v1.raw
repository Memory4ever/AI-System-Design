<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\eta_{n}^{2}}{2}\left\|\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>η</mi><mi>n</mi><mn>2</mn></msubsup><mn>2</mn></mfrac></mstyle><msup><mrow><mo>‖</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta_{n}^{2}}{2}\left\|\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E1.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 10.00002pt-\eta_{n}\sum_{m\in\mathcal{W}_{n}}\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>η</mi><mi>n</mi></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mo>⟨</mo><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>,</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⟩</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt-\eta_{n}\sum_{m\in\mathcal{W}_{n}}\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A-1)</span></td></tr></tbody>
</table>
<p id="A1.p1.2" class="ltx_p">where (a) holds since <math id="A1.p1.m1" class="ltx_Math" alttext="\left\|\Pi_{\mathcal{X}}[\mathbf{X}]-\mathbf{Y}\right\|^{2}\leq\left\|\mathbf{X}-\mathbf{Y}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi mathvariant="normal">Π</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>𝐗</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>𝐘</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><msup><mrow><mo>‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\left\|\Pi_{\mathcal{X}}[\mathbf{X}]-\mathbf{Y}\right\|^{2}\leq\left\|\mathbf{X}-\mathbf{Y}\right\|^{2}</annotation></semantics></math> for <math id="A1.p1.m2" class="ltx_Math" alttext="\mathbf{Y}\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝐘</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">\mathbf{Y}\in\mathcal{X}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>, Proposition 2.11]</cite>.</p>
</div>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p">Dividing both sides by <math id="A1.p2.m1" class="ltx_Math" alttext="\eta_{n}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\eta_{n}</annotation></semantics></math> and rearranging the terms, we obtain</p>
<table id="A1.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m\in\mathcal{W}_{n}}\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{U}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mo>⟨</mo><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>,</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m\in\mathcal{W}_{n}}\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{U}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{\eta_{n}}{2}\left\|\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>n</mi></msub><mn>2</mn></mfrac></mstyle><msup><mrow><mo>‖</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\eta_{n}}{2}\left\|\sum_{m\in\mathcal{W}_{n}}w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.00002pt+\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt+\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
