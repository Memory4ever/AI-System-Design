<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS2.6" class="ltx_text">IV-B</span> </span><span id="S4.SS2.7" class="ltx_text ltx_font_italic">Regret Analysis</span></h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">The regret of the proposed DDAM-TOGD algorithm is characterized in the following theorem.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.1" class="ltx_p"><span id="Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>–<a href="#Thmassumption3" title="Assumption 3. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the dynamic regret of the proposed DDAM-TOGD protocol satisfies the upper bound</span></p>
<table id="S4.E16" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E16X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E16X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{D\text{-}Reg}(T)\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{D\text{-}Reg}(T)\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E16X.m3" class="ltx_Math" alttext="\displaystyle\sum_{n\in\mathcal{N}}\Bigg(Q_{n}\eta_{n}\left(T+\Delta\tau_{n}\right)+J_{n}\eta_{n}+\frac{7B^{2}}{4\eta_{n}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>J</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{n\in\mathcal{N}}\Bigg(Q_{n}\eta_{n}\left(T+\Delta\tau_{n}\right)+J_{n}\eta_{n}+\frac{7B^{2}}{4\eta_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(16)</span></td></tr>
<tr id="S4.E16Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E16Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\frac{B}{\eta_{n}}+H_{n}\right)\mathrm{PL}_{n}^{T+\tau_{n,\max}}+C_{n}\Bigg)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>B</mi><msub><mi>η</mi><mi>n</mi></msub></mfrac></mstyle><mo>+</mo><msub><mi>H</mi><mi>n</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow></mrow><mo>+</mo><msub><mi>C</mi><mi>n</mi></msub></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\frac{B}{\eta_{n}}+H_{n}\right)\mathrm{PL}_{n}^{T+\tau_{n,\max}}+C_{n}\Bigg),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E17.m1" class="ltx_Math" alttext="\displaystyle Q_{n}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle Q_{n}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E17.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)+|\mathcal{W}_{n}|K_{n}^{2}\tau_{n,\mathrm{sum}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>G</mi><mi>m</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)+|\mathcal{W}_{n}|K_{n}^{2}\tau_{n,\mathrm{sum}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
<tbody id="S4.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E18.m1" class="ltx_Math" alttext="\displaystyle J_{n}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>n</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle J_{n}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E18.m2" class="ltx_Math" alttext="\displaystyle|\mathcal{W}_{n}|^{2}K_{n}^{2}\tau_{n,\max}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow><mn>2</mn></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathcal{W}_{n}|^{2}K_{n}^{2}\tau_{n,\max}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
<tbody id="S4.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E19.m1" class="ltx_Math" alttext="\displaystyle H_{n}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle H_{n}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E19.m2" class="ltx_Math" alttext="\displaystyle K_{n}\tau_{n,\mathrm{sum}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K_{n}\tau_{n,\mathrm{sum}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
<tbody id="S4.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E20.m1" class="ltx_Math" alttext="\displaystyle C_{n}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>n</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle C_{n}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E20.m2" class="ltx_Math" alttext="\displaystyle K_{n}\Delta\tau_{n}|\mathcal{W}_{n}|B," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K_{n}\Delta\tau_{n}|\mathcal{W}_{n}|B,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.3" class="ltx_p"><span id="Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">with</span></p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21.m1" class="ltx_Math" alttext="\displaystyle K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\displaystyle K_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E21.m2" class="ltx_Math" alttext="\displaystyle=\max_{m}w_{n,m}G_{m}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder><mi>max</mi><mi>m</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>m</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{m}w_{n,m}G_{m},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
<tbody id="S4.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E22.m1" class="ltx_Math" alttext="\displaystyle\tau_{n,\min}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\tau_{n,\min}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E22.m2" class="ltx_Math" alttext="\displaystyle=\min_{m}\tau_{n,m}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>min</mi><mi>m</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\min_{m}\tau_{n,m},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="S4.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E23.m1" class="ltx_Math" alttext="\displaystyle\tau_{n,\max}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\tau_{n,\max}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E23.m2" class="ltx_Math" alttext="\displaystyle=\max_{m}\tau_{n,m}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>max</mi><mi>m</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{m}\tau_{n,m},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="S4.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E24.m1" class="ltx_Math" alttext="\displaystyle\Delta\tau_{n}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\tau_{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E24.m2" class="ltx_Math" alttext="\displaystyle=\tau_{n,\max}-\tau_{n,\min}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{n,\max}-\tau_{n,\min},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
<tbody id="S4.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E25.m1" class="ltx_Math" alttext="\displaystyle\tau_{n,\mathrm{sum}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\tau_{n,\mathrm{sum}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E25.m2" class="ltx_Math" alttext="\displaystyle=\sum_{m\in\mathcal{W}_{n}}\tau_{n,m}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{m\in\mathcal{W}_{n}}\tau_{n,m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">The proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> is discussed in Sec. <a href="#S5" title="V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a>.
Based on Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, by specifying the learning rate, the static and dynamic regrets can be specialized as stated in the following corollary.</p>
</div>
<div id="Thmcorollary2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary2.2" class="ltx_text ltx_font_bold">Corollary 2</span></span><span id="Thmcorollary2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary2.p1" class="ltx_para">
<p id="Thmcorollary2.p1.2" class="ltx_p"><span id="Thmcorollary2.p1.2.1" class="ltx_text ltx_font_italic">By setting <math id="Thmcorollary2.p1.m1" class="ltx_Math" alttext="\eta_{n}\!=\!\sqrt{7B^{2}/4\left(Q_{n}(T+\Delta\tau_{n})+J_{n}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0.108em" rspace="0.108em">=</mo><msqrt><mrow><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>J</mi><mi>n</mi></msub></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\eta_{n}\!=\!\sqrt{7B^{2}/4\left(Q_{n}(T+\Delta\tau_{n})+J_{n}\right)}</annotation></semantics></math>, the dynamic regret of proposed DDAM-TOGD is upper bounded by</span></p>
<table id="S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\displaystyle\mathrm{D}\text{-}\mathrm{Reg}(T)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{D}\text{-}\mathrm{Reg}(T)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex2.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{n\in\mathcal{N}}\Bigg(\sqrt{7}B\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><msqrt><mn>7</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>J</mi><mi>n</mi></msub></mrow></msqrt></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{n\in\mathcal{N}}\Bigg(\sqrt{7}B\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex3.m1" class="ltx_Math" alttext="\displaystyle\hskip 20.00003pt\hskip 10.00002pt+\left(H_{n}+\frac{2}{\sqrt{7}}\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}\right)\mathrm{PL}_{n}^{T+\tau_{n,\max}}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msqrt><mn>7</mn></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>J</mi><mi>n</mi></msub></mrow></msqrt></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 20.00003pt\hskip 10.00002pt+\left(H_{n}+\frac{2}{\sqrt{7}}\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}\right)\mathrm{PL}_{n}^{T+\tau_{n,\max}}\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E26.m1" class="ltx_Math" alttext="\displaystyle=\mathcal{O}\!\!\left(\!\sum_{n\in\mathcal{N}}\!\!\left(\!\left(1\!+\!\mathrm{PL}_{n}^{T+\tau_{n,\max}}\right)\!\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mpadded style="width:0.484em;" width="0.484em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mo>+</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow><mpadded style="width:0.219em;" width="0.219em"><mo>)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{O}\!\!\left(\!\sum_{n\in\mathcal{N}}\!\!\left(\!\left(1\!+\!\mathrm{PL}_{n}^{T+\tau_{n,\max}}\right)\!\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="Thmcorollary2.p1.3" class="ltx_p"><span id="Thmcorollary2.p1.3.1" class="ltx_text ltx_font_italic">Furthermore, by letting <math id="Thmcorollary2.p1.m2" class="ltx_Math" alttext="\mathbf{U}_{n,t}=\mathbf{U}_{n}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msubsup><mi>𝐔</mi><mi>n</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{U}_{n,t}=\mathbf{U}_{n}^{*}</annotation></semantics></math> in (<a href="#S2.E3" title="In 1st item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), the path-length vanishes, i.e., <math id="Thmcorollary2.p1.m3" class="ltx_Math" alttext="\mathrm{PL}_{n}^{T}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>PL</mi><mi>n</mi><mi>T</mi></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathrm{PL}_{n}^{T}=0</annotation></semantics></math>, and the dynamic regret reduces to the static regret, yielding the upper bound</span></p>
<table id="S4.E27" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E27X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E27X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{S}\text{-}\mathrm{Reg}(T)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{S}\text{-}\mathrm{Reg}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E27X.m3" class="ltx_Math" alttext="\displaystyle\leq\sum_{n\in\mathcal{N}}\sqrt{7}B\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><msqrt><mn>7</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>J</mi><mi>n</mi></msub></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{n\in\mathcal{N}}\sqrt{7}B\sqrt{Q_{n}(T+\Delta\tau_{n})+J_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(27)</span></td></tr>
<tr id="S4.E27Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E27Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{O}\left(\sum_{n\in\mathcal{N}}\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><msqrt><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{O}\left(\sum_{n\in\mathcal{N}}\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">From Corollary <a href="#Thmcorollary2" title="Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, DDAM-TOGD achieves the dynamic regret bound in (<a href="#S4.E26" title="In Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>).
Compared with the dynamic regret of the idealized OGD in (<a href="#S3.E9" title="In Corollary 1. ‣ III-A Full-Information DDAM ‣ III Conventional Protocols ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), where the path-length is scaled by the factor <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\sqrt{T}" display="inline" intent=":literal"><semantics><msqrt><mi>T</mi></msqrt><annotation encoding="application/x-tex">\sqrt{T}</annotation></semantics></math>, the path-length in DDAM-TOGD is scaled by the term <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}</annotation></semantics></math>, making the regret explicitly dependent on the communication delay.
In fact, the quantity <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="\tau_{n,\mathrm{sum}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{n,\mathrm{sum}}</annotation></semantics></math> in (<a href="#S4.E25" title="In Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) is the cumulative delay from agent <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> to all agents of interest in <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="\mathcal{W}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathcal{W}_{n}</annotation></semantics></math>; while the quantity <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="\Delta\tau_{n}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\Delta\tau_{n}</annotation></semantics></math> in (<a href="#S4.E24" title="In Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) is the difference between the maximum and minimum delays from agent <math id="S4.SS2.p3.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">This dependence on the delay reflects the fact that information exchange in the distributed network slows down the learning progress of the AM process.
When the time horizon <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is much larger than the sum-delay <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="\tau_{n,\mathrm{sum}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{n,\mathrm{sum}}</annotation></semantics></math>, the coefficient <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\left(1+\tau_{n,\mathrm{sum}}\right)(T+\Delta\tau_{n})}</annotation></semantics></math> remains sublinear in <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, and thus DDAM-TOGD achieves the same sublinear time dependency as the idealized OGD.
The same conclusions hold for the static regret (<a href="#S4.E27" title="In Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>).</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS3.6" class="ltx_text">IV-C</span> </span><span id="S4.SS3.7" class="ltx_text ltx_font_italic">Design of Communication Trees</span></h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">The proposed DDAM-TOGD protocol applies to any choice of the routing trees <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{T}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathcal{T}_{n}</annotation></semantics></math> connecting each agent <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> to all the agents <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="m\in\mathcal{W}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">m\in\mathcal{W}_{n}</annotation></semantics></math>, whose data must be memorized by agent <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.
However, the regret bounds in (<a href="#S4.E26" title="In Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) and (<a href="#S4.E27" title="In Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) provide useful insights into the design of the routing trees <math id="S4.SS3.p1.m5" class="ltx_Math" alttext="\{\mathcal{T}_{n}\}_{n\in\mathcal{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>n</mi></msub><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><annotation encoding="application/x-tex">\{\mathcal{T}_{n}\}_{n\in\mathcal{N}}</annotation></semantics></math>.
In particular, the upper bound highlights the influence of the term <math id="S4.SS3.p1.m6" class="ltx_Math" alttext="(1+\tau_{n,\mathrm{sum}})(T+\Delta\tau_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1+\tau_{n,\mathrm{sum}})(T+\Delta\tau_{n})</annotation></semantics></math> on each agent’s performance.
As discussed in the previous subsection, when the memorization horizon <math id="S4.SS3.p1.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is large enough, the dominant component of the regret bound is the cumulative delay term <math id="S4.SS3.p1.m8" class="ltx_Math" alttext="\tau_{n,\mathrm{sum}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{n,\mathrm{sum}}</annotation></semantics></math>.
Based on these insights, we propose to design the trees <math id="S4.SS3.p1.m9" class="ltx_Math" alttext="\mathcal{T}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathcal{T}_{n}</annotation></semantics></math> with the aim of minimizing the sum-delay <math id="S4.SS3.p1.m10" class="ltx_Math" alttext="\tau_{n,\mathrm{sum}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{n,\mathrm{sum}}</annotation></semantics></math>.
The proposed combinatorial optimization procedure is detailed in Appendix <a href="#A5" title="Appendix E Combinatorial Optimization-based Tree Design ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>, and we refer to the resulting scheme as <math id="S4.SS3.p1.m11" class="ltx_Math" alttext="\mathrm{DDAM}\text{-}\mathrm{TOGD}^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>DDAM</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>TOGD</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\mathrm{DDAM}\text{-}\mathrm{TOGD}^{\star}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">V </span><span id="S5.2" class="ltx_text ltx_font_smallcaps">Theoretical Analysis</span></h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section, we outline the proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, with additional details provided in the Appendix.
The proof proceeds by first decomposing the dynamic regret (<a href="#S2.E5" title="In 2nd item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) to isolate the impact of communication delays and then bounding each constituent term separately.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS1.6" class="ltx_text">V-A</span> </span><span id="S5.SS1.7" class="ltx_text ltx_font_italic">Regret Decomposition</span></h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">The network dynamic regret (<a href="#S2.E5" title="In 2nd item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) can be expressed as the sum of the local dynamic regrets of all agents as</p>
<table id="S5.E28" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E28X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E28X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{D\text{-}Reg}(T)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{D\text{-}Reg}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E28X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{n\in\mathcal{N}}\Big(\underbrace{\mathcal{L}_{n}^{T}\left(\mathbf{X}_{n}^{T}\right)-\mathcal{L}_{n}^{T}\left(\mathbf{U}_{n}^{T}\right)}_{\mathrm{D\text{-}Reg}_{n}(T)}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><munder><munder accentunder="true"><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>n</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>n</mi><mi>T</mi></msubsup><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>n</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐔</mi><mi>n</mi><mi>T</mi></msubsup><mo>)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>Reg</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></munder><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n\in\mathcal{N}}\Big(\underbrace{\mathcal{L}_{n}^{T}\left(\mathbf{X}_{n}^{T}\right)-\mathcal{L}_{n}^{T}\left(\mathbf{U}_{n}^{T}\right)}_{\mathrm{D\text{-}Reg}_{n}(T)}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(28)</span></td></tr>
<tr id="S5.E28Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E28Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{n\in\mathcal{N}}\mathrm{D\text{-}Reg}_{n}(T)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder></mstyle><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>Reg</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n\in\mathcal{N}}\mathrm{D\text{-}Reg}_{n}(T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p1.2" class="ltx_p">We next derive a bound for the dynamic regret of each agent <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, i.e., <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="\mathrm{D\text{-}Reg}_{n}(T)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>Reg</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{D\text{-}Reg}_{n}(T)</annotation></semantics></math>.
Summing these bounds over all agents yields an overall network-level guarantee.
To start, the local dynamic regret of agent <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> can be upper bounded in a convenient way that isolates the contributions of communication delays</p>
<table id="S5.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex4.m1" class="ltx_Math" alttext="\displaystyle\mathrm{D\text{-}Reg}_{n}(T)=\mathcal{L}_{n}^{T}\left(\mathbf{X}_{n}^{T}\right)-\mathcal{L}_{n}^{T}\left(\mathbf{U}_{n}^{T}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>Reg</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>n</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>n</mi><mi>T</mi></msubsup><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>n</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐔</mi><mi>n</mi><mi>T</mi></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{D\text{-}Reg}_{n}(T)=\mathcal{L}_{n}^{T}\left(\mathbf{X}_{n}^{T}\right)-\mathcal{L}_{n}^{T}\left(\mathbf{U}_{n}^{T}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex5.m1" class="ltx_Math" alttext="\displaystyle\mathop{\leq}\limits^{\text{(a)}}\sum_{t=1}^{T}\sum_{m\in\mathcal{W}_{n}}w_{n,m}\left\langle\mathbf{G}_{m,t}^{n},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mover><mo movablelimits="false">≤</mo><mtext>(a)</mtext></mover><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{\leq}\limits^{\text{(a)}}\sum_{t=1}^{T}\sum_{m\in\mathcal{W}_{n}}w_{n,m}\left\langle\mathbf{G}_{m,t}^{n},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex6.m1" class="ltx_Math" alttext="\displaystyle\mathop{=}\limits^{\text{(b)}}\!\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mover><mo movablelimits="false">=</mo><mtext>(b)</mtext></mover><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathop{=}\limits^{\text{(b)}}\!\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex7.m1" class="ltx_Math" alttext="\displaystyle=\!\!\!\underbrace{\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\sum_{m\in\mathcal{W}_{n}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle}_{\mathtt{Reg^{\star}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mpadded style="width:0.546em;" width="0.546em"><mo>=</mo></mpadded><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></msub><mi>w</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>⟨</mo><mi>𝐆</mi><msub><mrow></mrow><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mn>𝟙</mn><msub><mrow></mrow><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>,</mo><mi>𝐗</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mi>𝐔</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⟩</mo></mrow><mo stretchy="true">⏟</mo></munder><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup></munder></mrow><annotation encoding="application/x-tex">\displaystyle=\!\!\!\underbrace{\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\sum_{m\in\mathcal{W}_{n}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle}_{\mathtt{Reg^{\star}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex8.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{X}_{n,t}\right\rangle}_{\mathtt{Drift}_{\mathbf{X}}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub></munder></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}-\mathbf{X}_{n,t}\right\rangle}_{\mathtt{Drift}_{\mathbf{X}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex9.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle}_{\mathtt{Drift}_{\mathbf{U}}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub></munder></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle}_{\mathtt{Drift}_{\mathbf{U}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E29.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\rangle}_{\mathtt{Tail}}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mi>𝚃𝚊𝚒𝚕</mi></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt+\underbrace{\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\rangle}_{\mathtt{Tail}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="S5.SS1.p1.3" class="ltx_p">where (a) holds by the convexity of the local loss functions <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>, Lemma 2.5]</cite>, and (b) holds by changing the order of summation and adjusting the start and end indices.
In the decomposition (<a href="#S5.E29" title="In V-A Regret Decomposition ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), the term <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="\mathtt{Reg}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathtt{Reg}^{\star}</annotation></semantics></math> retains the characteristic form of conventional regret analyses <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite>, while the remaining terms, namely <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math>, <math id="S5.SS1.p1.m6" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math>, and <math id="S5.SS1.p1.m7" class="ltx_Math" alttext="\mathtt{Tail}" display="inline" intent=":literal"><semantics><mi>𝚃𝚊𝚒𝚕</mi><annotation encoding="application/x-tex">\mathtt{Tail}</annotation></semantics></math>, are consequences of the presence of communication delays.
Specifically, the terms <math id="S5.SS1.p1.m8" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math> and <math id="S5.SS1.p1.m9" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math> quantify the drift caused by the mismatch between stale and current iterates in the decision and comparator sequences, respectively; while the term <math id="S5.SS1.p1.m10" class="ltx_Math" alttext="\mathtt{Tail}" display="inline" intent=":literal"><semantics><mi>𝚃𝚊𝚒𝚕</mi><annotation encoding="application/x-tex">\mathtt{Tail}</annotation></semantics></math> accounts for gradient information that arrives only after the horizon <math id="S5.SS1.p1.m11" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and hence cannot be incorporated into the updates.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS2.6" class="ltx_text">V-B</span> </span><span id="S5.SS2.7" class="ltx_text ltx_font_italic">Bounding Individual Terms</span></h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">We now analyze each term separately.
Combining the bounds below immediately yields Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<section id="S5.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS1.6" class="ltx_text">V-B</span>1 </span>Bounding <math id="S5.SS2.SSS1.m1" class="ltx_Math" alttext="\mathtt{Reg}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathtt{Reg}^{\star}</annotation></semantics></math></h4>

<div id="S5.SS2.SSS1.p1" class="ltx_para">
<p id="S5.SS2.SSS1.p1.1" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>, Lemma 2.12]</cite>, we first establish the following key lemma.</p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.2" class="ltx_p"><span id="Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#Thmassumption3" title="Assumption 3. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the DDAM-TOGD update rule in (<a href="#S4.E14" title="In IV-A DDAM-TOGD ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) satisfies the following inequality</span></p>
<table id="S5.E30" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E30X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E30X.m2" class="ltx_Math" alttext="\displaystyle\sum_{m\in\mathcal{W}_{n}}\!\!\!\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></msub><mo>⟨</mo><mi>w</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mi>𝐆</mi><msub><mrow></mrow><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mn>𝟙</mn><msub><mrow></mrow><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>,</mo><mi>𝐗</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mi>𝐔</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m\in\mathcal{W}_{n}}\!\!\!\left\langle w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(30)</span></td></tr>
<tr id="S5.E30Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E30Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E30Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E30Xb.m2" class="ltx_Math" alttext="\displaystyle+K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\frac{\eta_{n}}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>G</mi><mi>m</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>n</mi></msub><mn>2</mn></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\frac{\eta_{n}}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.3" class="ltx_p"><span id="Thmlemma1.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> is defined in (<a href="#S4.E21" title="In Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>).</span></p>
</div>
</div>
<div id="S5.SS2.SSS1.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_bold ltx_font_italic ltx_title_proof">Proof:</h6>
<div id="S5.SS2.SSS1.p2" class="ltx_para">
<p id="S5.SS2.SSS1.p2.1" class="ltx_p"><span id="S5.SS2.SSS1.p2.1.1" class="ltx_text">See Appendix <a href="#A1" title="Appendix A Proof of Lemma ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.
∎</span></p>
</div>
<div id="S5.SS2.SSS1.p3" class="ltx_para">
<p id="S5.SS2.SSS1.p3.1" class="ltx_p"><span id="S5.SS2.SSS1.p3.1.1" class="ltx_text">Summing (<a href="#S5.E30" title="In Lemma 1. ‣ V-B1 Bounding 𝚁𝚎𝚐^⋆ ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) over index <math id="S5.SS2.SSS1.p3.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> from <math id="S5.SS2.SSS1.p3.m2" class="ltx_Math" alttext="\tau_{\min}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\tau_{\min}</annotation></semantics></math> to <math id="S5.SS2.SSS1.p3.m3" class="ltx_Math" alttext="T+\tau_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">T+\tau_{\max}</annotation></semantics></math> gives the upper bound</span></p>
<table id="S5.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex10.m1" class="ltx_Math" alttext="\displaystyle\mathtt{Reg}^{\star}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathtt{Reg}^{\star}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex10.m2" class="ltx_math_unparsed" alttext="\displaystyle\!\!\!\!\!\!\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\sum_{m\in\mathcal{W}_{n}}\!\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}\!\!-\!\!\mathbf{U}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mrow><mo>⟨</mo><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mo>,</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mpadded style="width:0.632em;" width="0.632em"><mo>−</mo></mpadded><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\!\!\!\!\!\!\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\sum_{m\in\mathcal{W}_{n}}\!\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}},\mathbf{X}_{n,t}\!\!-\!\!\mathbf{U}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex11.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex11.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\eta_{n}\left(T+\Delta\tau_{n}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>G</mi><mi>m</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\eta_{n}\left(T+\Delta\tau_{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E31.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#Thmassumption2" title="Assumption 2. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, the telescoping term in (<a href="#S5.E31" title="In Proof: ‣ V-B1 Bounding 𝚁𝚎𝚐^⋆ ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) can be bounded as</span></p>
<table id="S5.E32" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E32X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E32X.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>min</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=\tau_{n,\min}+1}^{T+\tau_{n,\max}}\frac{\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}-\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}}{2\eta_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(32)</span></td></tr>
<tr id="S5.E32Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E32Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{B}{\eta_{n}}\mathrm{PL}_{n}^{T+\tau_{n,\max}}+\frac{7B^{2}}{4\eta_{n}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>B</mi><msub><mi>η</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{B}{\eta_{n}}\mathrm{PL}_{n}^{T+\tau_{n,\max}}+\frac{7B^{2}}{4\eta_{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS1.7.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_bold ltx_font_italic ltx_title_proof">Proof:</h6>
<div id="S5.SS2.SSS1.p4" class="ltx_para">
<p id="S5.SS2.SSS1.p4.1" class="ltx_p"><span id="S5.SS2.SSS1.p4.1.1" class="ltx_text">See Appendix <a href="#A2" title="Appendix B Proof of Theorem ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.
∎</span></p>
</div>
<div id="S5.SS2.SSS1.p5" class="ltx_para">
<p id="S5.SS2.SSS1.p5.2" class="ltx_p"><span id="S5.SS2.SSS1.p5.2.1" class="ltx_text">Plugging (<a href="#S5.E32" title="In Theorem 4. ‣ Proof: ‣ V-B1 Bounding 𝚁𝚎𝚐^⋆ ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) into (<a href="#S5.E31" title="In Proof: ‣ V-B1 Bounding 𝚁𝚎𝚐^⋆ ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), <math id="S5.SS2.SSS1.p5.m1" class="ltx_Math" alttext="\mathtt{Reg}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathtt{Reg}^{\star}</annotation></semantics></math> is bounded as</span></p>
<table id="S5.E33" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E33X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E33X.m2" class="ltx_Math" alttext="\displaystyle\mathtt{Reg}^{\star}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚁𝚎𝚐</mi><mo>⋆</mo></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathtt{Reg}^{\star}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E33X.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\eta_{n}\left(T+\Delta\tau_{n}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>G</mi><mi>m</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}K_{n}\left(\sum_{m\in\mathcal{W}_{n}}G_{m}\right)\eta_{n}\left(T+\Delta\tau_{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(33)</span></td></tr>
<tr id="S5.E33Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E33Xa.m2" class="ltx_Math" alttext="\displaystyle+\frac{B}{\eta_{n}}\mathrm{PL}_{n}^{T+\tau_{n,\max}}+\frac{7B^{2}}{4\eta_{n}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>B</mi><msub><mi>η</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{B}{\eta_{n}}\mathrm{PL}_{n}^{T+\tau_{n,\max}}+\frac{7B^{2}}{4\eta_{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</div>
</section>
<section id="S5.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS2.6" class="ltx_text">V-B</span>2 </span>Bounding <math id="S5.SS2.SSS2.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math></h4>

<div id="S5.SS2.SSS2.p1" class="ltx_para">
<p id="S5.SS2.SSS2.p1.1" class="ltx_p">By applying the Cauchy–Schwarz inequality together with Assumption <a href="#Thmassumption3" title="Assumption 3. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <math id="S5.SS2.SSS2.p1.m1" class="ltx_Math" alttext="\mathtt{Drfit}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚏𝚒𝚝</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathtt{Drfit}_{1}</annotation></semantics></math> is bounded as</p>
<table id="S5.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\displaystyle\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex12.m2" class="ltx_Math" alttext="\displaystyle\!=\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}\!\!-\!\!\mathbf{X}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mpadded style="width:0.716em;" width="0.716em"><mo>=</mo></mpadded><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub><mpadded style="width:0.632em;" width="0.632em"><mo>−</mo></mpadded><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\!=\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{X}_{n,t-\tau_{n,m}}\!\!-\!\!\mathbf{X}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex13.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}G_{m}\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}G_{m}\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E34.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}K_{n}\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}K_{n}\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.SSS2.p2" class="ltx_para">
<p id="S5.SS2.SSS2.p2.2" class="ltx_p">Thus, the bound of <math id="S5.SS2.SSS2.p2.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math> depends on the term <math id="S5.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|</annotation></semantics></math>, which measures the difference between the variables with and without delay.
Unrolling the difference <math id="S5.SS2.SSS2.p2.m3" class="ltx_Math" alttext="\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}</annotation></semantics></math> for <math id="S5.SS2.SSS2.p2.m4" class="ltx_Math" alttext="t&gt;\tau_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">t&gt;\tau_{n,m}</annotation></semantics></math> and from the update rule (<a href="#S4.E14" title="In IV-A DDAM-TOGD ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), we obtain the inequality</p>
<table id="S5.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35X.m2" class="ltx_Math" alttext="\displaystyle\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|=\left\|\sum_{j=1}^{\tau_{n,m}}(\mathbf{X}_{n,t-j+1}-\mathbf{X}_{n,t-j})\right\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow><mo>=</mo><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbf{X}_{n,t}-\mathbf{X}_{n,t-\tau_{n,m}}\right\|=\left\|\sum_{j=1}^{\tau_{n,m}}(\mathbf{X}_{n,t-j+1}-\mathbf{X}_{n,t-j})\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr>
<tr id="S5.E35Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E35Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{n}K_{n}\sum_{s\in\mathcal{W}_{n}}\min\{\tau_{n,m},t-\tau_{n,s}-1\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mi>min</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>s</mi></mrow></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{n}K_{n}\sum_{s\in\mathcal{W}_{n}}\min\{\tau_{n,m},t-\tau_{n,s}-1\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.SSS2.p3" class="ltx_para">
<p id="S5.SS2.SSS2.p3.2" class="ltx_p">Substituting (<a href="#S5.E35" title="In V-B2 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐗 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) into (<a href="#S5.E34" title="In V-B2 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐗 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) and after some algebraic manipulation, <math id="S5.SS2.SSS2.p3.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{X}}</annotation></semantics></math> can be bounded by</p>
<table id="S5.E36" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E36X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E36X.m2" class="ltx_Math" alttext="\displaystyle\mathtt{Drift}_{\mathbf{X}}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐗</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathtt{Drift}_{\mathbf{X}}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E36X.m3" class="ltx_Math" alttext="\displaystyle|\mathcal{W}_{n}|^{2}K_{n}^{2}\tau_{n,\max}^{2}\eta_{n}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle|\mathcal{W}_{n}|^{2}K_{n}^{2}\tau_{n,\max}^{2}\eta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(36)</span></td></tr>
<tr id="S5.E36Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E36Xa.m2" class="ltx_Math" alttext="\displaystyle+|\mathcal{W}_{n}|K_{n}^{2}\tau_{n,\mathrm{sum}}\eta_{n}\left(T+\Delta\tau_{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+|\mathcal{W}_{n}|K_{n}^{2}\tau_{n,\mathrm{sum}}\eta_{n}\left(T+\Delta\tau_{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS2.p3.3" class="ltx_p">The detailed derivations of (<a href="#S5.E35" title="In V-B2 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐗 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) and (<a href="#S5.E36" title="In V-B2 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐗 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) can be found in Appendix <a href="#A3" title="Appendix C Proof of Bound on 𝙳𝚛𝚒𝚏𝚝_𝐗 ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
</section>
<section id="S5.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS3.6" class="ltx_text">V-B</span>3 </span>Bounding <math id="S5.SS2.SSS3.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math></h4>

<div id="S5.SS2.SSS3.p1" class="ltx_para">
<p id="S5.SS2.SSS3.p1.1" class="ltx_p">By applying the Cauchy–Schwarz inequality together with Assumption <a href="#Thmassumption3" title="Assumption 3. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we obtain</p>
<table id="S5.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex14.m1" class="ltx_Math" alttext="\displaystyle\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex14.m2" class="ltx_Math" alttext="\displaystyle=\!\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}\!-\!\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mpadded style="width:0.546em;" width="0.546em"><mo>=</mo></mpadded><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo rspace="0.052em">−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\!\!\!\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\!\!\!w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}\!-\!\mathbf{U}_{n,t-\tau_{n,m}}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}G_{m}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}w_{n,m}G_{m}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E37.m1" class="ltx_Math" alttext="\displaystyle\leq K_{n}\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq K_{n}\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS3.p1.2" class="ltx_p">The expression (<a href="#S5.E37" title="In V-B3 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐔 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) reveals that the term <math id="S5.SS2.SSS3.p1.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math> arises to the discrepancy between the comparator sequences with and without delay.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">The drift of the comparator caused by delay can be bounded as</span></p>
<table id="S5.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E38.m1" class="ltx_Math" alttext="\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|\leq\tau_{n,m}\mathrm{PL}_{n}^{T+\tau_{n,m}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover><mrow><mo lspace="0em">‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|\leq\tau_{n,m}\mathrm{PL}_{n}^{T+\tau_{n,m}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS3.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_bold ltx_font_italic ltx_title_proof">Proof:</h6>
<div id="S5.SS2.SSS3.p2" class="ltx_para">
<p id="S5.SS2.SSS3.p2.1" class="ltx_p"><span id="S5.SS2.SSS3.p2.1.1" class="ltx_text">See Appendix <a href="#A4" title="Appendix D Proof of Lemma ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>.
∎</span></p>
</div>
<div id="S5.SS2.SSS3.p3" class="ltx_para">
<p id="S5.SS2.SSS3.p3.1" class="ltx_p"><span id="S5.SS2.SSS3.p3.1.1" class="ltx_text">With Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ V-B3 Bounding 𝙳𝚛𝚒𝚏𝚝_𝐔 ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <math id="S5.SS2.SSS3.p3.m1" class="ltx_Math" alttext="\mathtt{Drift}_{\mathbf{U}}" display="inline" intent=":literal"><semantics><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><annotation encoding="application/x-tex">\mathtt{Drift}_{\mathbf{U}}</annotation></semantics></math> can be bounded as</span></p>
<table id="S5.E39" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E39X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E39X.m2" class="ltx_Math" alttext="\displaystyle\mathtt{Drift}_{\mathbf{U}}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙳𝚛𝚒𝚏𝚝</mi><mi>𝐔</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathtt{Drift}_{\mathbf{U}}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39X.m3" class="ltx_Math" alttext="\displaystyle K_{n}\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K_{n}\sum_{m\in\mathcal{W}_{n}}\sum_{t=\tau_{n,m}+1}^{T+\tau_{n,m}}\left\|\mathbf{U}_{n,t}-\mathbf{U}_{n,t-\tau_{n,m}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(39)</span></td></tr>
<tr id="S5.E39Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E39Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39Xa.m3" class="ltx_Math" alttext="\displaystyle K_{n}\sum_{m\in\mathcal{W}_{n}}\tau_{n,m}\sum_{t=2}^{T+\tau_{n,m}}\mathrm{PL}_{n}^{T+\tau_{n,m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></munderover></mstyle><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K_{n}\sum_{m\in\mathcal{W}_{n}}\tau_{n,m}\sum_{t=2}^{T+\tau_{n,m}}\mathrm{PL}_{n}^{T+\tau_{n,m}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E39Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E39Xb.m2" class="ltx_Math" alttext="\displaystyle\mathop{\leq}\limits^{(a)}" display="inline" intent=":literal"><semantics><mover><mo movablelimits="false">≤</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\mathop{\leq}\limits^{(a)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39Xb.m3" class="ltx_Math" alttext="\displaystyle K_{n}\tau_{n,\mathrm{sum}}\mathrm{PL}_{n}^{T+\tau_{n,\max}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>sum</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K_{n}\tau_{n,\mathrm{sum}}\mathrm{PL}_{n}^{T+\tau_{n,\max}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS3.p3.2" class="ltx_p"><span id="S5.SS2.SSS3.p3.2.1" class="ltx_text">where (a) follows from the inequality <math id="S5.SS2.SSS3.p3.m2" class="ltx_Math" alttext="\mathrm{PL}_{n}^{T+\tau_{n,m}}\leq\mathrm{PL}_{n}^{T+\tau_{n,\max}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></msubsup><mo>≤</mo><msubsup><mi>PL</mi><mi>n</mi><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathrm{PL}_{n}^{T+\tau_{n,m}}\leq\mathrm{PL}_{n}^{T+\tau_{n,\max}}</annotation></semantics></math> for all <math id="S5.SS2.SSS3.p3.m3" class="ltx_Math" alttext="m\in\mathcal{W}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">m\in\mathcal{W}_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="S5.SS2.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS4.6" class="ltx_text">V-B</span>4 </span>Bounding <math id="S5.SS2.SSS4.m1" class="ltx_Math" alttext="\mathtt{Tail}" display="inline" intent=":literal"><semantics><mi>𝚃𝚊𝚒𝚕</mi><annotation encoding="application/x-tex">\mathtt{Tail}</annotation></semantics></math></h4>

<div id="S5.SS2.SSS4.p1" class="ltx_para">
<p id="S5.SS2.SSS4.p1.1" class="ltx_p">By applying the Cauchy–Schwarz inequality together with Assumptions <a href="#Thmassumption2" title="Assumption 2. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and <a href="#Thmassumption3" title="Assumption 3. ‣ II-C Technical Assumptions ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we obtain</p>
<table id="S5.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex16.m1" class="ltx_Math" alttext="\displaystyle\mathtt{Tail}" display="inline" intent=":literal"><semantics><mi>𝚃𝚊𝚒𝚕</mi><annotation encoding="application/x-tex">\displaystyle\mathtt{Tail}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex16.m2" class="ltx_Math" alttext="\displaystyle=\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}\left\langle\mathbf{G}_{m,t-\tau_{n,m}}^{n},\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex17.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}G_{m}\left\|\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>max</mi></mrow></msub></mrow></munderover></mstyle><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{m\in\mathcal{W}_{n}}\sum_{t=T+\tau_{n,m}+1}^{T+\tau_{n,\max}}w_{n,m}G_{m}\left\|\mathbf{U}_{n,t}-\mathbf{X}_{n,t}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E40.m1" class="ltx_Math" alttext="\displaystyle\leq K_{n}\Delta\tau_{n}|\mathcal{W}_{n}|B," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>K</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq K_{n}\Delta\tau_{n}|\mathcal{W}_{n}|B,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS4.p1.2" class="ltx_p">concluding the proof.</p>
</div>
</section>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">VI </span><span id="S6.2" class="ltx_text ltx_font_smallcaps">Experiments</span></h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">In this section, we empirically evaluate the performance of the proposed DDAM-TOGD using a synthetic dataset and a real wireless traffic dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>.</p>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS1.6" class="ltx_text">VI-A</span> </span><span id="S6.SS1.7" class="ltx_text ltx_font_italic">Synthetic Dataset</span></h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">We consider memorization under the DeltaNet model <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>, where memory retrieval is linear and the loss function for agent <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> at time <math id="S6.SS1.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is given by the third entry in Table <a href="#S2.T1" title="TABLE I ‣ II-A Setting ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a>.
The key vectors <math id="S6.SS1.p1.m3" class="ltx_Math" alttext="\mathbf{k}_{n,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{k}_{n,t}</annotation></semantics></math> are generated independently for each agent <math id="S6.SS1.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and time <math id="S6.SS1.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, by drawing each entry from a uniform distribution over the interval <math id="S6.SS1.p1.m6" class="ltx_Math" alttext="[-1,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1,1]</annotation></semantics></math>.
The corresponding value vectors <math id="S6.SS1.p1.m7" class="ltx_Math" alttext="\mathbf{v}_{n,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{v}_{n,t}</annotation></semantics></math> are generated as</p>
<table id="S6.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E41.m1" class="ltx_Math" alttext="\mathbf{v}_{n,t}=\left((1-\rho)\mathbf{M}_{n}^{*}+\rho\mathbf{M}_{\mathrm{com}}^{*}\right)\mathbf{k}_{n,t}+\mathbf{n}_{n,t}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐌</mi><mi>n</mi><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐌</mi><mi>com</mi><mo>∗</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><msub><mi>𝐧</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{v}_{n,t}=\left((1-\rho)\mathbf{M}_{n}^{*}+\rho\mathbf{M}_{\mathrm{com}}^{*}\right)\mathbf{k}_{n,t}+\mathbf{n}_{n,t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p1.2" class="ltx_p">where <math id="S6.SS1.p1.m8" class="ltx_Math" alttext="\mathbf{n}_{n,t}\sim\mathcal{N}(0,\sigma_{n}^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐧</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mi>σ</mi><mi>n</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{n}_{n,t}\sim\mathcal{N}(0,\sigma_{n}^{2})</annotation></semantics></math> denotes additive Gaussian noise, with <math id="S6.SS1.p1.m9" class="ltx_Math" alttext="\sigma_{n}^{2}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>n</mi><mn>2</mn></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sigma_{n}^{2}=1</annotation></semantics></math>.
The data-generation model (<a href="#S6.E41" title="In VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) indicates that, apart from the presence of noise, the ground-truth optimal linear mechanism for agent <math id="S6.SS1.p1.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is given by
<math id="S6.SS1.p1.m11" class="ltx_Math" alttext="(1-\rho)\mathbf{M}_{n}^{*}+\rho\mathbf{M}_{\mathrm{com}}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐌</mi><mi>n</mi><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐌</mi><mi>com</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">(1-\rho)\mathbf{M}_{n}^{*}+\rho\mathbf{M}_{\mathrm{com}}^{*}</annotation></semantics></math>, combining a personalized component <math id="S6.SS1.p1.m12" class="ltx_Math" alttext="\mathbf{M}_{n}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐌</mi><mi>n</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathbf{M}_{n}^{*}</annotation></semantics></math> and a common component <math id="S6.SS1.p1.m13" class="ltx_Math" alttext="\mathbf{M}_{\mathrm{com}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐌</mi><mi>com</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathbf{M}_{\mathrm{com}}^{*}</annotation></semantics></math> shared across all agents.
The correlation parameter <math id="S6.SS1.p1.m14" class="ltx_Math" alttext="\rho\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in[0,1]</annotation></semantics></math> controls the trade-off between personalized and common memory contributions.
Matrix <math id="S6.SS1.p1.m15" class="ltx_Math" alttext="\mathbf{M}_{\mathrm{com}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐌</mi><mi>com</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathbf{M}_{\mathrm{com}}^{*}</annotation></semantics></math> is generated by sampling each entry independently from a chi-squared distribution with 2 degrees of freedom, while the matrices <math id="S6.SS1.p1.m16" class="ltx_Math" alttext="\mathbf{M}_{n}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐌</mi><mi>n</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathbf{M}_{n}^{*}</annotation></semantics></math> are generated independently with Gaussian entries <math id="S6.SS1.p1.m17" class="ltx_Math" alttext="\mathbf{M}_{n}^{*}\sim\mathcal{N}(\mu_{n},\sigma_{n}^{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐌</mi><mi>n</mi><mo>∗</mo></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>n</mi></msub><mo>,</mo><msubsup><mi>σ</mi><mi>n</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}_{n}^{*}\sim\mathcal{N}(\mu_{n},\sigma_{n}^{2})</annotation></semantics></math>, where the mean <math id="S6.SS1.p1.m18" class="ltx_Math" alttext="\mu_{n}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mu_{n}</annotation></semantics></math> and variance <math id="S6.SS1.p1.m19" class="ltx_Math" alttext="\sigma_{n}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>n</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{n}^{2}</annotation></semantics></math> are independently and uniformly sampled from the intervals <math id="S6.SS1.p1.m20" class="ltx_Math" alttext="[-5,5]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>5</mn></mrow><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-5,5]</annotation></semantics></math> and <math id="S6.SS1.p1.m21" class="ltx_Math" alttext="[0,50]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>50</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,50]</annotation></semantics></math>, respectively.</p>
</div>
<figure id="S6.F2" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp1_Tree.svg" id="S6.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/258;" width="381" height="258"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 2: </span>Physical topology considered in the experiments.</figcaption>
</figure>
<figure id="S6.F3" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp1_Times.svg" id="S6.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 3: </span>Regret versus time horizon <math id="S6.F3.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (<math id="S6.F3.m6" class="ltx_Math" alttext="\rho=0.75" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\rho=0.75</annotation></semantics></math>, <math id="S6.F3.m7" class="ltx_Math" alttext="y_{0}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">y_{0}=2</annotation></semantics></math>, and <math id="S6.F3.m8" class="ltx_Math" alttext="y_{1}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">y_{1}=10</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p">The logical weight matrix <math id="S6.SS1.p2.m1" class="ltx_Math" alttext="\mathbf{W}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">\mathbf{W}</annotation></semantics></math> is constructed such that each <math id="S6.SS1.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th row is sampled independently from a Dirichlet distribution.
Specifically, the <math id="S6.SS1.p2.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th row is determined as the random vector</p>
<table id="S6.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E42.m1" class="ltx_math_unparsed" alttext="\mathbf{W}[n,:]\sim\mathrm{Dirichlet}(\underbrace{y_{0},\ldots y_{0}}_{1:n-1},y_{1},\underbrace{y_{0},\ldots y_{0}}_{n+1:N})," display="block" intent=":literal"><semantics><mrow><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo>,</mo><mo rspace="0em">:</mo><mo stretchy="false">]</mo></mrow><mo>∼</mo><mi>Dirichlet</mi><mrow><mo stretchy="false">(</mo><munder><munder accentunder="true"><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><munder><munder accentunder="true"><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></munder><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{W}[n,:]\sim\mathrm{Dirichlet}(\underbrace{y_{0},\ldots y_{0}}_{1:n-1},y_{1},\underbrace{y_{0},\ldots y_{0}}_{n+1:N}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p2.2" class="ltx_p">for some <math id="S6.SS1.p2.m4" class="ltx_Math" alttext="y_{1}\geq y_{0}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>y</mi><mn>0</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{1}\geq y_{0}\geq 0</annotation></semantics></math>.
This way, the weight in (<a href="#S6.E42" title="In VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>) assigned to the local data at agent <math id="S6.SS1.p2.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is, on average, more relevant than the data from other agents by a factor <math id="S6.SS1.p2.m6" class="ltx_Math" alttext="y_{1}/y_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>/</mo><msub><mi>y</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">y_{1}/y_{0}</annotation></semantics></math>.
The number of agents is set to <math id="S6.SS1.p2.m7" class="ltx_Math" alttext="N=20" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">N=20</annotation></semantics></math>, and the connecting graph is shown in Fig. <a href="#S6.F2" title="Fig. 2 ‣ VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="S6.SS1.p3" class="ltx_para">
<p id="S6.SS1.p3.1" class="ltx_p">To ensure a fair comparison, given a time horizon <math id="S6.SS1.p3.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> for OGD and C-DOGD, we set the time horizon for DDAM-TOGD as <math id="S6.SS1.p3.m2" class="ltx_Math" alttext="T/C_{\max}^{\mathcal{T}}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>/</mo><msubsup><mi>C</mi><mi>max</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msubsup></mrow><annotation encoding="application/x-tex">T/C_{\max}^{\mathcal{T}}</annotation></semantics></math>, where the maximum per-link capacity <math id="S6.SS1.p3.m3" class="ltx_Math" alttext="C_{\max}^{\mathcal{T}}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>max</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msubsup><annotation encoding="application/x-tex">C_{\max}^{\mathcal{T}}</annotation></semantics></math> for a given choice of trees <math id="S6.SS1.p3.m4" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> is defined in (<a href="#S4.E15" title="In IV-A DDAM-TOGD ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>).
This accounts for the fact that a single iteration may take up to <math id="S6.SS1.p3.m5" class="ltx_Math" alttext="1/C_{\max}^{\mathcal{T}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><msubsup><mi>C</mi><mi>max</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msubsup></mrow><annotation encoding="application/x-tex">1/C_{\max}^{\mathcal{T}}</annotation></semantics></math> more time in DDAM-TOGD as compared to C-DOGD, since the link with the largest load must communicate <math id="S6.SS1.p3.m6" class="ltx_Math" alttext="C_{\max}^{\mathcal{T}}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>max</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msubsup><annotation encoding="application/x-tex">C_{\max}^{\mathcal{T}}</annotation></semantics></math> messages per iteration.
For DDAM-TOGD, we consider a baseline version using Steiner trees, referred to as “DAM-TOGD (ST)”, with DDAM-TOGD<sup id="S6.SS1.p3.1.1" class="ltx_sup">∗</sup> defined as in Section <a href="#S4.SS3" title="IV-C Design of Communication Trees ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV-C</span></a>.
Recall that Steiner trees optimize the total edge weight, while the design introduced in Section <a href="#S4.SS3" title="IV-C Design of Communication Trees ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV-C</span></a> minimizes the total path-length.
The time average static regret of the network at time horizon <math id="S6.SS1.p3.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is <math id="S6.SS1.p3.m9" class="ltx_Math" alttext="\mathrm{S}\text{-}\mathrm{Reg}(T)/T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\mathrm{S}\text{-}\mathrm{Reg}(T)/T</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p4" class="ltx_para ltx_noindent">
<p id="S6.SS1.p4.1" class="ltx_p"><span id="S6.SS1.p4.1.1" class="ltx_text ltx_font_bold">Convergence:</span>
In Fig. <a href="#S6.F3" title="Fig. 3 ‣ VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we study the evolution of the time average static regret (<a href="#S2.E4" title="In 1st item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) over time for OGD, C-DOGD, and the proposed DDAM-TOGD.
As evidenced by the consistent decline in regret with increasing time horizon <math id="S6.SS1.p4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> seen in Fig. <a href="#S6.F3" title="Fig. 3 ‣ VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, both OGD and the proposed DDAM-TOGD exhibit a clear sublinear regret trend, conforming to Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and Corollary <a href="#Thmcorollary2" title="Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
In contrast, the regret of C-DOGD initially decreases but quickly plateaus, demonstrating a regret behavior that fails to improve with time.
This is because C-DOGD forces the agents to use the same memory mechanism as time <math id="S6.SS1.p4.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> increases, while the model (<a href="#S6.E41" title="In VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) implies that different memorization mechanisms are preferred at different agents.</p>
</div>
<figure id="S6.F4" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp1_Memory.svg" id="S6.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 4: </span>Regret at <math id="S6.F4.m5" class="ltx_Math" alttext="T=2500" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2500</mn></mrow><annotation encoding="application/x-tex">T=2500</annotation></semantics></math> versus memory correlation parameter <math id="S6.F4.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> (<math id="S6.F4.m7" class="ltx_Math" alttext="y_{0}=6" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">y_{0}=6</annotation></semantics></math>, and <math id="S6.F4.m8" class="ltx_Math" alttext="y_{1}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">y_{1}=10</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS1.p5" class="ltx_para ltx_noindent">
<p id="S6.SS1.p5.1" class="ltx_p"><span id="S6.SS1.p5.1.1" class="ltx_text ltx_font_bold">Impact of Memory Correlation:</span>
Fig. <a href="#S6.F4" title="Fig. 4 ‣ VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> shows the effect of the memory correlation parameter <math id="S6.SS1.p5.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> in (<a href="#S6.E41" title="In VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) on the regret.
For large <math id="S6.SS1.p5.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, memory heterogeneity is minimal and all methods perform similarly.
As <math id="S6.SS1.p5.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> decreases, personalization increases, consensus becomes restrictive, and C-DOGD suffers a rapidly growing regret.
In contrast, DDAM-TOGD mitigates heterogeneity and maintains low regret, demonstrating robustness to personalization.</p>
</div>
<figure id="S6.F5" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp1_Weights.svg" id="S6.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 5: </span>Regret at <math id="S6.F5.m5" class="ltx_Math" alttext="T=2500" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2500</mn></mrow><annotation encoding="application/x-tex">T=2500</annotation></semantics></math> versus Dirichlet parameter <math id="S6.F5.m6" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> (<math id="S6.F5.m7" class="ltx_Math" alttext="\rho=0.75" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">\rho=0.75</annotation></semantics></math>, and <math id="S6.F5.m8" class="ltx_Math" alttext="y_{1}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">y_{1}=10</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS1.p6" class="ltx_para ltx_noindent">
<p id="S6.SS1.p6.1" class="ltx_p"><span id="S6.SS1.p6.1.1" class="ltx_text ltx_font_bold">Impact of the Logical Weight Matrix:</span>
In Fig. <a href="#S6.F5" title="Fig. 5 ‣ VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, we report the effect of the logical weight matrix in (<a href="#S6.E42" title="In VI-A Synthetic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>) by varying the Dirichlet parameter <math id="S6.SS1.p6.m1" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> (with <math id="S6.SS1.p6.m2" class="ltx_Math" alttext="y_{1}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">y_{1}=10</annotation></semantics></math>), which controls how each agent’s memory incorporates data from others.
When the parameter <math id="S6.SS1.p6.m3" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> is small, the weight matrix <math id="S6.SS1.p6.m4" class="ltx_Math" alttext="\mathbf{W}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">\mathbf{W}</annotation></semantics></math> becomes highly imbalanced, emphasizing personalized weights.
In this regime, achieving consensus does not result in the optimal solution and C-DOGD incurs a large regret.
In contrast, the results show that OGD and the proposed DDAM-TOGD methods are largely unaffected by variations in parameter <math id="S6.SS1.p6.m5" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math>, demonstrating their robustness to changes in the network logical weight structure.</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS2.6" class="ltx_text">VI-B</span> </span><span id="S6.SS2.7" class="ltx_text ltx_font_italic">Wireless Traffic Dataset</span></h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">In this experiment, we evaluate wireless traffic usage memorization using real traffic data from an enterprise network <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>.
The dataset consists of measurements collected from <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="470" display="inline" intent=":literal"><semantics><mn>470</mn><annotation encoding="application/x-tex">470</annotation></semantics></math> access points (APs).
In our experiment, we focus on <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="N=16" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">N=16</annotation></semantics></math> APs randomly selected from the “High” group <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>, which consists of 79 APs with the highest mean traffic usage.
To reduce the dynamic range of inputs, raw traffic measurements are preprocessed using a logarithmic transformation.
In this experiment, the connection graph is randomly generated, where each pair of nodes is connected with probability <math id="S6.SS2.p1.m3" class="ltx_Math" alttext="0.25" display="inline" intent=":literal"><semantics><mn>0.25</mn><annotation encoding="application/x-tex">0.25</annotation></semantics></math>.
The resulting graph is illustrated in Fig. <a href="#S6.F6" title="Fig. 6 ‣ VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
<figure id="S6.F6" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp2_Tree.svg" id="S6.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/258;" width="381" height="258"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 6: </span>Physical topology considered in the experiments with the wireless traffic dataset.</figcaption>
</figure>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">In this dataset, the transmitted traffic volume was recorded every 10 minutes between December 20, 2018 and February 8, 2019 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>.
Thus, each hour consists of six consecutive samples for every AP.
For each AP <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and time step <math id="S6.SS2.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we form a key–value pair <math id="S6.SS2.p2.m3" class="ltx_Math" alttext="(\mathbf{k}_{n,t},\mathbf{v}_{n,t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{k}_{n,t},\mathbf{v}_{n,t})</annotation></semantics></math>, where the value <math id="S6.SS2.p2.m4" class="ltx_Math" alttext="\mathbf{v}_{n,t}\in\mathbb{R}^{d_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>v</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{n,t}\in\mathbb{R}^{d_{v}}</annotation></semantics></math> aggregates the six (<math id="S6.SS2.p2.m5" class="ltx_Math" alttext="d_{v}=6" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">d_{v}=6</annotation></semantics></math>) 10-minute traffic measurements of AP <math id="S6.SS2.p2.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> within the hour associated with time step <math id="S6.SS2.p2.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
The corresponding key is constructed as
<math id="S6.SS2.p2.m8" class="ltx_Math" alttext="\mathbf{k}_{n,t}=[\mathbf{k}_{\mathrm{AP},n};\;\mathbf{k}_{\mathrm{time},t}]\in\mathbb{R}^{d_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐤</mi><mrow><mi>AP</mi><mo>,</mo><mi>n</mi></mrow></msub><mo rspace="0.387em">;</mo><msub><mi>𝐤</mi><mrow><mi>time</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>k</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{k}_{n,t}=[\mathbf{k}_{\mathrm{AP},n};\;\mathbf{k}_{\mathrm{time},t}]\in\mathbb{R}^{d_{k}}</annotation></semantics></math>,
where <math id="S6.SS2.p2.m9" class="ltx_Math" alttext="\mathbf{k}_{\mathrm{AP},n}=\Phi_{\mathrm{AP}}(n)\in\mathbb{R}^{d_{\mathrm{AP}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐤</mi><mrow><mi>AP</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mi>AP</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>AP</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{k}_{\mathrm{AP},n}=\Phi_{\mathrm{AP}}(n)\in\mathbb{R}^{d_{\mathrm{AP}}}</annotation></semantics></math> specifies the identity of the <math id="S6.SS2.p2.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th AP, and
<math id="S6.SS2.p2.m11" class="ltx_Math" alttext="\mathbf{k}_{\mathrm{time},t}=\Phi_{\mathrm{time}}(t\mod 24)\in\mathbb{R}^{d_{\mathrm{time}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐤</mi><mrow><mi>time</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mi>time</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>mod</mo><mn>24</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>time</mi></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{k}_{\mathrm{time},t}=\Phi_{\mathrm{time}}(t\mod 24)\in\mathbb{R}^{d_{\mathrm{time}}}</annotation></semantics></math> encodes the hour-of-day associated with time step <math id="S6.SS2.p2.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
The temporal embedding function <math id="S6.SS2.p2.m13" class="ltx_Math" alttext="\Phi_{\mathrm{time}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>time</mi></msub><annotation encoding="application/x-tex">\Phi_{\mathrm{time}}</annotation></semantics></math> uses Transformer-style sinusoidal (cos/sin) embeddings <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite>, whereas the AP embedding function <math id="S6.SS2.p2.m14" class="ltx_Math" alttext="\Phi_{\mathrm{AP}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>AP</mi></msub><annotation encoding="application/x-tex">\Phi_{\mathrm{AP}}</annotation></semantics></math> combines a one-hot representation of the AP index with a Transformer-style sinusoidal embedding.
In our experiments, we set <math id="S6.SS2.p2.m15" class="ltx_Math" alttext="d_{\mathrm{AP}}=24" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>AP</mi></msub><mo>=</mo><mn>24</mn></mrow><annotation encoding="application/x-tex">d_{\mathrm{AP}}=24</annotation></semantics></math>, and <math id="S6.SS2.p2.m16" class="ltx_Math" alttext="d_{\mathrm{time}}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>time</mi></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">d_{\mathrm{time}}=10</annotation></semantics></math>.</p>
</div>
<div id="S6.SS2.p3" class="ltx_para">
<p id="S6.SS2.p3.1" class="ltx_p">To evaluate the dynamic regret, we use as a reference a comparator <math id="S6.SS2.p3.m1" class="ltx_Math" alttext="\mathbf{U}_{n,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{U}_{n,t}</annotation></semantics></math> that is optimized in hindsight separately, for each time window
<math id="S6.SS2.p3.m2" class="ltx_Math" alttext="\Theta_{k}\triangleq\{(k-1)\Omega+1,\ldots,k\Omega\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>k</mi></msub><mo>≜</mo><mrow><mo maxsize="0.800em" minsize="0.800em">{</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta_{k}\triangleq\{(k-1)\Omega+1,\ldots,k\Omega\}</annotation></semantics></math> with <math id="S6.SS2.p3.m3" class="ltx_Math" alttext="k=1,2,\ldots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">k=1,2,\ldots</annotation></semantics></math>, of duration <math id="S6.SS2.p3.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> time intervals, i.e., <math id="S6.SS2.p3.m5" class="ltx_Math" alttext="\Omega\times 10" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">\Omega\times 10</annotation></semantics></math> minutes.
Accordingly, we select the comparator <math id="S6.SS2.p3.m6" class="ltx_Math" alttext="\mathbf{U}_{n,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{U}_{n,t}</annotation></semantics></math>, for all <math id="S6.SS2.p3.m7" class="ltx_Math" alttext="t\in\Theta_{k}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msub><mi mathvariant="normal">Θ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">t\in\Theta_{k}</annotation></semantics></math>, as</p>
<table id="S6.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E43.m1" class="ltx_Math" alttext="\mathbf{U}_{n,t}\in\arg\min_{\mathbf{U}\in\mathcal{X}}\sum_{s\in\Theta_{k}}\ \sum_{m\in\mathcal{W}_{n}}w_{n,m}\,f_{m,s}\big(\mathbf{U}\big)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∈</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mrow><mi>𝐔</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi mathvariant="normal">Θ</mi><mi>k</mi></msub></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder><mrow><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>m</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐔</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{U}_{n,t}\in\arg\min_{\mathbf{U}\in\mathcal{X}}\sum_{s\in\Theta_{k}}\ \sum_{m\in\mathcal{W}_{n}}w_{n,m}\,f_{m,s}\big(\mathbf{U}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="S6.SS2.p3.2" class="ltx_p">If <math id="S6.SS2.p3.m8" class="ltx_Math" alttext="\Omega=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Omega=1</annotation></semantics></math>, the comparator (<a href="#S6.E43" title="In VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>) can change at every time step, while if <math id="S6.SS2.p3.m9" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> equals the time horizon <math id="S6.SS2.p3.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, the comparator (<a href="#S6.E43" title="In VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>) reduces to the hindsight-optimal static solution in (<a href="#S2.E3" title="In 1st item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), yielding the static-regret criterion.</p>
</div>
<div id="S6.SS2.p4" class="ltx_para">
<p id="S6.SS2.p4.1" class="ltx_p">The time-horizon scaling method and logical weights are set in the same way as in the synthetic-dataset case described in the previous subsection.
The time average dynamic regret of network at time horizon <math id="S6.SS2.p4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is evaluated as the ratio <math id="S6.SS2.p4.m2" class="ltx_Math" alttext="\mathrm{D}\text{-}\mathrm{Reg}(T)/T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>Reg</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\mathrm{D}\text{-}\mathrm{Reg}(T)/T</annotation></semantics></math>.</p>
</div>
<figure id="S6.F7" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp2_Time_DReg_PL.svg" id="S6.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 7: </span>Regret of proposed DDAM-TOGD<sup id="S6.F7.3" class="ltx_sup">⋆</sup> and scaled path-length versus time horizon <math id="S6.F7.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> with different <math id="S6.F7.m8" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> (<math id="S6.F7.m9" class="ltx_Math" alttext="y_{0}=10" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">y_{0}=10</annotation></semantics></math>, and <math id="S6.F7.m10" class="ltx_Math" alttext="y_{1}=100" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">y_{1}=100</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS2.p5" class="ltx_para ltx_noindent">
<p id="S6.SS2.p5.1" class="ltx_p"><span id="S6.SS2.p5.1.1" class="ltx_text ltx_font_bold">Validation of the relation between dynamic regret and path-length:</span>
We plot the dynamic regret for the proposed DDAM-TOGD<sup id="S6.SS2.p5.1.2" class="ltx_sup">⋆</sup> with different time window sieze <math id="S6.SS2.p5.m2" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> in Fig. <a href="#S6.F7" title="Fig. 7 ‣ VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.
To validate the bounds (<a href="#S4.E27" title="In Corollary 2. ‣ IV-B Regret Analysis ‣ IV Distributed Dynamic Associative Memory via Tree-based Online Gradient Descent ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), we also show the quantity <math id="S6.SS2.p5.m3" class="ltx_Math" alttext="(1+\mathrm{PL}_{n}^{T})/\sqrt{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msubsup><mi>PL</mi><mi>n</mi><mi>T</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msqrt><mi>T</mi></msqrt></mrow><annotation encoding="application/x-tex">(1+\mathrm{PL}_{n}^{T})/\sqrt{T}</annotation></semantics></math>, which describes the scaling of the bounds on the time-averaged dynamic regret.
When <math id="S6.SS2.p5.m4" class="ltx_Math" alttext="\Omega=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Omega=1</annotation></semantics></math>, the comparator may change at every time step, causing the path-length to increase rapidly.
In contrast, when <math id="S6.SS2.p5.m5" class="ltx_Math" alttext="\Omega=168" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mn>168</mn></mrow><annotation encoding="application/x-tex">\Omega=168</annotation></semantics></math>, the comparator changes every week (since <math id="S6.SS2.p5.m6" class="ltx_Math" alttext="\Omega=7\times 24" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mrow><mn>7</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>24</mn></mrow></mrow><annotation encoding="application/x-tex">\Omega=7\times 24</annotation></semantics></math>), and the path-length grows much more slowly.
Validating the theoretical bounds, in the case <math id="S6.SS2.p5.m7" class="ltx_Math" alttext="\Omega=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Omega=1</annotation></semantics></math>, the dynamic regret also exhibits a fast-increasing trend, whereas for <math id="S6.SS2.p5.m8" class="ltx_Math" alttext="\Omega=168" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mn>168</mn></mrow><annotation encoding="application/x-tex">\Omega=168</annotation></semantics></math> it grows significantly more slowly.
Overall, the dynamic regret closely follows the evolution of the scaled path-length.</p>
</div>
<figure id="S6.F8" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp2_Time_Avg_DReg.svg" id="S6.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 8: </span>Regret versus time horizon <math id="S6.F8.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (<math id="S6.F8.m5" class="ltx_Math" alttext="y_{0}=0.1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">y_{0}=0.1</annotation></semantics></math>, and <math id="S6.F8.m6" class="ltx_Math" alttext="y_{1}=100" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">y_{1}=100</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS2.p6" class="ltx_para ltx_noindent">
<p id="S6.SS2.p6.1" class="ltx_p"><span id="S6.SS2.p6.1.1" class="ltx_text ltx_font_bold">Convergence:</span>
In Fig. <a href="#S6.F8" title="Fig. 8 ‣ VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, we study the evolution of the dynamic regret (<a href="#S2.E5" title="In 2nd item ‣ II-B Problem Definition ‣ II Problem Statement ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) over time for OGD, C-DOGD, and the proposed DDAM-TOGD with different choices of the time window size <math id="S6.SS2.p6.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> of the comparators (<a href="#S6.E43" title="In VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>).
The proposed DDAM-TOGD is seen to approach the ideal centralized solution set by OGD.
This shows that in this setting communication delays have a minor impact on performance due to the near-periodicity of the data.
In contrast, for C-DOGD, the dynamic regret is much larger than for OGD, indicating the need for specializing the AM mechanisms at the agents.
Note also that the static regret, obtained with <math id="S6.SS2.p6.m2" class="ltx_Math" alttext="\Omega=T=1200" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mi>T</mi><mo>=</mo><mn>1200</mn></mrow><annotation encoding="application/x-tex">\Omega=T=1200</annotation></semantics></math>, can become negative, showing that the hindsight-best solution is not necessarily optimal in a non-stationary environment.</p>
</div>
<figure id="S6.F9" class="ltx_figure"><object type="image/svg+xml" data="2511.23347v1/Exp2_Weight_NMSE.svg" id="S6.F9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/249;" width="381" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 9: </span>NMSE versus Dirichlet parameter <math id="S6.F9.m3" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> (<math id="S6.F9.m4" class="ltx_Math" alttext="y_{1}=100" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">y_{1}=100</annotation></semantics></math>).</figcaption>
</figure>
<div id="S6.SS2.p7" class="ltx_para ltx_noindent">
<p id="S6.SS2.p7.1" class="ltx_p"><span id="S6.SS2.p7.1.1" class="ltx_text ltx_font_bold">Normalized Mean Squared Error (NMSE) Performance:</span>
In addition to the regret performance shown so far, in Fig. <a href="#S6.F9" title="Fig. 9 ‣ VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> we investigate the NMSE performance of memory retrieval.
Specifically, we evaluate self-NMSE and cross-NMSE, measuring the error in retrieving one’s own value and the ability to recall other APs’ traffic usage, respectively, defined as</p>
<table id="S6.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex18.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Self}\text{-}\mathrm{NMSE}=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Self</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>NMSE</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Self}\text{-}\mathrm{NMSE}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex18.m2" class="ltx_Math" alttext="\displaystyle\frac{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\|\mathbf{X}_{n}\mathbf{k}_{n,t}-\mathbf{v}_{n,t}\|^{2}}{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\|\mathbf{v}_{n,t}\|^{2}}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mi>t</mi><mi>T</mi></msubsup><mrow><msub><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐗</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>−</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><msubsup><mo>∑</mo><mi>t</mi><mi>T</mi></msubsup><mrow><msub><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\|\mathbf{X}_{n}\mathbf{k}_{n,t}-\mathbf{v}_{n,t}\|^{2}}{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\|\mathbf{v}_{n,t}\|^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex19.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Cross}\text{-}\mathrm{NMSE}=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Cross</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>NMSE</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Cross}\text{-}\mathrm{NMSE}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex19.m2" class="ltx_Math" alttext="\displaystyle\frac{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\sum_{n\in\mathcal{W}_{n}\backslash\{n\}}\|\mathbf{X}_{n}\mathbf{k}_{m,t}-\mathbf{v}_{m,t}\|^{2}}{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\sum_{m\in\mathcal{W}_{n}\backslash\{n\}}\|\mathbf{v}_{m,t}\|^{2}}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mi>t</mi><mi>T</mi></msubsup><mrow><msub><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><mrow><msub><mo rspace="0em">∑</mo><mrow><mi>n</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">\</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>n</mi><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></mrow></mrow></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐗</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>−</mo><msub><mi>𝐯</mi><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mi>t</mi><mi>T</mi></msubsup><mrow><msub><mo lspace="0.167em" rspace="0em">∑</mo><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></msub><mrow><msub><mo rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">\</mo><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>n</mi><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></mrow></mrow></msub><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐯</mi><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\sum_{n\in\mathcal{W}_{n}\backslash\{n\}}\|\mathbf{X}_{n}\mathbf{k}_{m,t}-\mathbf{v}_{m,t}\|^{2}}{\sum_{t}^{T}\sum_{n\in\mathcal{N}}\sum_{m\in\mathcal{W}_{n}\backslash\{n\}}\|\mathbf{v}_{m,t}\|^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p7.2" class="ltx_p">In Fig. <a href="#S6.F9" title="Fig. 9 ‣ VI-B Wireless Traffic Dataset ‣ VI Experiments ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, as <math id="S6.SS2.p7.m1" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> increases, each agent places less weight on its own data and more weight on other APs, which enhances its ability to memorize the traffic usage of other APs leading to a decreasing trend in cross-NMSE.
Furthermore, as <math id="S6.SS2.p7.m2" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> increases, the self-NMSE first decreases slightly and then rises sharply.
This observation suggests that selectively incorporating information from others can be beneficial, but excessive attention to other agents’ data is detrimental.</p>
</div>
</section>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">VII </span><span id="S7.2" class="ltx_text ltx_font_smallcaps">Conclusion</span></h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">This paper introduced the concept of DDAM and proposed DDAM-TOGD, a tree-based distributed online gradient optimization method that enables agents to build and update AMs under time-varying data streams.
We established sublinear static regret and path-length dependent dynamic regret, revealing how communication delay and routing topology affect regret performance.
Based on these insights from the theoretical analysis, we proposed a combinatorial optimization based routing-tree design method.
Experiments on synthetic datasets and real wireless traffic usage memorization have verified the theory: DDAM-TOGD adapts to changing associations, and achieves lower regret than existing solutions.</p>
</div>
<div id="S7.p2" class="ltx_para">
<p id="S7.p2.1" class="ltx_p">Future work includes investigating time-varying connectivity, exploring non-linear associative memory mechanisms, and studying parameter-free online learning algorithms <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite>.</p>
</div>
</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proof of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ V-B1 Bounding 𝚁𝚎𝚐^⋆ ‣ V-B Bounding Individual Terms ‣ V Theoretical Analysis ‣ Distributed Dynamic Associative Memory via Online Convex Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">We first present the following inequality</p>
<table id="A1.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}-\frac{1}{2}\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\left\|\mathbf{X}_{n,t+1}-\mathbf{U}_{n,t}\right\|^{2}-\frac{1}{2}\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{2}\left\|\Pi_{\mathcal{X}}\left[\mathbf{X}_{n,t}\!-\!\eta_{n}\!\!\!\sum_{m\in\mathcal{W}_{n}}\!\!\!w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right]\!\!-\!\mathbf{U}_{n,t}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msup><mrow><mo>‖</mo><msub><mi mathvariant="normal">Π</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mrow><mo>[</mo><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo rspace="0.052em">−</mo><msub><mi>η</mi><mi>n</mi></msub><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>n</mi></msub></mrow></munder></mstyle><msub><mi>w</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><msubsup><mi>𝐆</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mi>n</mi></msubsup><msub><mn>𝟙</mn><mrow><mo maxsize="1.140em" minsize="1.140em">{</mo><mi>t</mi><mo>&gt;</mo><mi>τ</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo maxsize="1.140em" minsize="1.140em">}</mo></mrow></msub><mpadded style="width:0.160em;" width="0.160em"><mo>]</mo></mpadded></mrow><mo rspace="0.052em">−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left\|\Pi_{\mathcal{X}}\left[\mathbf{X}_{n,t}\!-\!\eta_{n}\!\!\!\sum_{m\in\mathcal{W}_{n}}\!\!\!w_{n,m}\mathbf{G}_{m,t-\tau_{n,m}}^{n}\mathbbm{1}_{\{t&gt;\tau_{n,m}\}}\right]\!\!-\!\mathbf{U}_{n,t}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.00002pt-\frac{1}{2}\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>𝐗</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐔</mi><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.00002pt-\frac{1}{2}\left\|\mathbf{X}_{n,t}-\mathbf{U}_{n,t}\right\|^{2}</annotation></semantics></math></td>
