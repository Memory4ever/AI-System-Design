        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.22779">pdf</a>, <a href="https://arxiv.org/ps/2511.22779">ps</a>, <a href="https://arxiv.org/format/2511.22779">other</a>]&nbsp;</span>
