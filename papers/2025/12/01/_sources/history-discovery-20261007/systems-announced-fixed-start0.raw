    <p class="title is-5 mathjax">
      
        LFM2 Technical Report
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Amini%2C+A">Alexander Amini</a>, 
      
