  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2512.03091">arXiv:2512.03091</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.03091">pdf</a>, <a href="https://arxiv.org/ps/2512.03091">ps</a>, <a href="https://arxiv.org/format/2512.03091">other</a>]&nbsp;</span>
