        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.02074">pdf</a>, <a href="https://arxiv.org/ps/2512.02074">ps</a>, <a href="https://arxiv.org/format/2512.02074">other</a>]&nbsp;</span>
