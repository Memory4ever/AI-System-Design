      <a href="/search/?searchtype=author&amp;query=Verma%2C+R">Ruchika Verma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kandoi%2C+S">Shrishtee Kandoi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Afzal%2C+R">Robina Afzal</a>, 
      
