  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2512.08955">arXiv:2512.08955</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.08955">pdf</a>, <a href="https://arxiv.org/ps/2512.08955">ps</a>, <a href="https://arxiv.org/format/2512.08955">other</a>]&nbsp;</span>
