        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.02061">pdf</a>, <a href="https://arxiv.org/ps/2512.02061">ps</a>, <a href="https://arxiv.org/format/2512.02061">other</a>]&nbsp;</span>
