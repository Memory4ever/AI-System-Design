    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Y">Yanhui Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+Q">Qi Zhou</a>, 
      
