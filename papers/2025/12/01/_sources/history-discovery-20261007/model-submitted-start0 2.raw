        <span>&nbsp;[<a href="https://arxiv.org/pdf/2601.02368">pdf</a>, <a href="https://arxiv.org/ps/2601.02368">ps</a>, <a href="https://arxiv.org/format/2601.02368">other</a>]&nbsp;</span>
