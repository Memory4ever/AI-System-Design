    <p class="title is-5 mathjax">
      
        SUPERChem: A Multimodal Reasoning Benchmark in Chemistry
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+Z">Zehua Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+Z">Zhixian Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+J">Junren Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+S">Siyu Lin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+J">Junting Zhou</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cao%2C+F">Fengqi Cao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+K">Kun Zhou</a>, 
      
