      <a href="/search/?searchtype=author&amp;query=Loo%2C+N">Noel Loo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Marks%2C+J">Jacob Marks</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mosca%2C+E">Edoardo Mosca</a>, 
      
