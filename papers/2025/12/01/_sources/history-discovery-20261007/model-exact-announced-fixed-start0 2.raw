        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.23271">pdf</a>, <a href="https://arxiv.org/ps/2511.23271">ps</a>, <a href="https://arxiv.org/format/2511.23271">other</a>]&nbsp;</span>
