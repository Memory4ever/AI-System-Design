    <p class="title is-5 mathjax">
      
        ThetaEvolve: Test-time Learning on Open Problems
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Y">Yiping Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Su%2C+S">Shao-Rong Su</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zeng%2C+Z">Zhiyuan Zeng</a>, 
      
