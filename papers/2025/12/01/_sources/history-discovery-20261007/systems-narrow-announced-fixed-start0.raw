  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2511.22521">arXiv:2511.22521</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.22521">pdf</a>, <a href="https://arxiv.org/ps/2511.22521">ps</a>, <a href="https://arxiv.org/format/2511.22521">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
