  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2511.22737">arXiv:2511.22737</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.22737">pdf</a>, <a href="https://arxiv.org/ps/2511.22737">ps</a>, <a href="https://arxiv.org/format/2511.22737">other</a>]&nbsp;</span>
