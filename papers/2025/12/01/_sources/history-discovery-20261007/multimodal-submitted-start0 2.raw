        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.01234">pdf</a>, <a href="https://arxiv.org/ps/2512.01234">ps</a>, <a href="https://arxiv.org/format/2512.01234">other</a>]&nbsp;</span>
