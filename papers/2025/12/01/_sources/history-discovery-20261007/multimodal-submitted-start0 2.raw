  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2512.00797">arXiv:2512.00797</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.00797">pdf</a>, <a href="https://arxiv.org/ps/2512.00797">ps</a>, <a href="https://arxiv.org/format/2512.00797">other</a>]&nbsp;</span>
