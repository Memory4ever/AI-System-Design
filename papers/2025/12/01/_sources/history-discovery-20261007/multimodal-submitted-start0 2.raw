        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.00961">pdf</a>, <a href="https://arxiv.org/ps/2512.00961">ps</a>, <a href="https://arxiv.org/format/2512.00961">other</a>]&nbsp;</span>
