  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2511.22859">arXiv:2511.22859</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.22859">pdf</a>, <a href="https://arxiv.org/ps/2511.22859">ps</a>, <a href="https://arxiv.org/format/2511.22859">other</a>]&nbsp;</span>
      </p>
