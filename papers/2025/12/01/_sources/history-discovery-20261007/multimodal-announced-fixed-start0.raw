      <a href="/search/?searchtype=author&amp;query=Lechner%2C+V">Valentine Lechner</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+S">Simon Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Z">Zetian Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Loo%2C+N">Noel Loo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Marks%2C+J">Jacob Marks</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mosca%2C+E">Edoardo Mosca</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Paech%2C+S+J">Samuel J. Paech</a>, 
      
