      <a href="/search/?searchtype=author&amp;query=H%C3%A4rk%C3%B6nen%2C+M">Marc Härkönen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Harrington%2C+A">Anne Harrington</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hasani%2C+R">Ramin Hasani</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Karwa%2C+S">Saniya Karwa</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Khrustalev%2C+Y">Yuri Khrustalev</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Labonne%2C+M">Maxime Labonne</a>, 
      
