        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.23477">pdf</a>, <a href="https://arxiv.org/ps/2511.23477">ps</a>, <a href="https://arxiv.org/format/2511.23477">other</a>]&nbsp;</span>
