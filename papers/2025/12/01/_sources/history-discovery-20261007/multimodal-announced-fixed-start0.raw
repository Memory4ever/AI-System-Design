        <span>&nbsp;[<a href="https://arxiv.org/pdf/2511.23465">pdf</a>, <a href="https://arxiv.org/ps/2511.23465">ps</a>, <a href="https://arxiv.org/format/2511.23465">other</a>]&nbsp;</span>
