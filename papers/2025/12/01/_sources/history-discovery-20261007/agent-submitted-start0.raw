      <a href="/search/?searchtype=author&amp;query=Maharaj%2C+S+K">Saloni Kumar Maharaj</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jain%2C+P">Priyank Jain</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tran%2C+J">Jessica Tran</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gwiazdon%2C+M">Matthew Gwiazdon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rustagi%2C+A">Arjun Rustagi</a>, 
      
