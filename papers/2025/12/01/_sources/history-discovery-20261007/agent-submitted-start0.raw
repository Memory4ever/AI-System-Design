      <a href="/search/?searchtype=author&amp;query=Kadiyala%2C+V">Vinay Kadiyala</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Agarwal%2C+A">Anup Agarwal</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tappuni%2C+B">Bassman Tappuni</a>, 
      
      <a href="/search/?searchtype=author&amp;query=French%2C+B">Brianna French</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jesudasen%2C+S">Sirus Jesudasen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cosgriff%2C+C+V">Christopher V. Cosgriff</a>, 
      
