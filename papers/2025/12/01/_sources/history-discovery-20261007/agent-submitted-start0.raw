        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.10971">pdf</a>, <a href="https://arxiv.org/ps/2512.10971">ps</a>, <a href="https://arxiv.org/format/2512.10971">other</a>]&nbsp;</span>
