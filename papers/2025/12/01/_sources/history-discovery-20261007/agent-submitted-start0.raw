        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.08964">pdf</a>, <a href="https://arxiv.org/ps/2512.08964">ps</a>, <a href="https://arxiv.org/format/2512.08964">other</a>]&nbsp;</span>
