<td id="S4.T1.2.4.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 3.0pt;"><span id="S4.T1.2.4.3.1" class="ltx_text" style="font-size:90%;">Baseline gains</span></td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.45pt 3.0pt;">
