<td id="S4.T1.2.8.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding:0.45pt 3.0pt;"><math id="S4.T1.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math><span id="S4.T1.2.8.3.1" class="ltx_text" style="font-size:90%;">: medium <math id="S4.T1.m11" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> slow <math id="S4.T1.m12" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> medium</span></td>
