<td id="S4.T1.2.7.3" class="ltx_td ltx_align_left" style="padding:0.45pt 3.0pt;"><math id="S4.T1.m7" class="ltx_Math" alttext="\downarrow K_{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em" stretchy="false">↓</mo><msub><mi mathsize="0.900em">K</mi><mi mathsize="0.900em">p</mi></msub></mrow><annotation encoding="application/x-tex">\downarrow K_{p}</annotation></semantics></math><span id="S4.T1.2.7.3.1" class="ltx_text" style="font-size:90%;">, <math id="S4.T1.m8" class="ltx_Math" alttext="\uparrow K_{d}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">↑</mo><msub><mi>K</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\uparrow K_{d}</annotation></semantics></math>, <math id="S4.T1.m9" class="ltx_Math" alttext="\downarrow v" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">↓</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\downarrow v</annotation></semantics></math></span></td>
<td id="S4.T1.2.7.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">
