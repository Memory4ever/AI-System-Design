<td id="S4.T1.2.5.3" class="ltx_td ltx_align_left" style="padding:0.45pt 3.0pt;"><math id="S4.T1.m4" class="ltx_Math" alttext="\downarrow K_{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em" stretchy="false">↓</mo><msub><mi mathsize="0.900em">K</mi><mi mathsize="0.900em">p</mi></msub></mrow><annotation encoding="application/x-tex">\downarrow K_{p}</annotation></semantics></math><span id="S4.T1.2.5.3.1" class="ltx_text" style="font-size:90%;">, <math id="S4.T1.m5" class="ltx_Math" alttext="\uparrow K_{d}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">↑</mo><msub><mi>K</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\uparrow K_{d}</annotation></semantics></math>, <math id="S4.T1.m6" class="ltx_Math" alttext="\downarrow v" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">↓</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\downarrow v</annotation></semantics></math></span></td>
<td id="S4.T1.2.5.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">
<span id="S4.T1.2.5.4.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.2.5.4.1.1" class="ltx_p"><span id="S4.T1.2.5.4.1.1.1" class="ltx_text" style="font-size:90%;">Safe handover despite object not in dataset</span></span>
</span></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<td id="S4.T1.2.6.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 3.0pt;"><span id="S4.T1.2.6.1.1" class="ltx_text" style="font-size:90%;">Pick cube (in DB)</span></td>
<td id="S4.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 3.0pt;"><span id="S4.T1.2.6.2.1" class="ltx_text" style="font-size:90%;">No</span></td>
<td id="S4.T1.2.6.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 3.0pt;"><span id="S4.T1.2.6.3.1" class="ltx_text" style="font-size:90%;">Baseline gains</span></td>
