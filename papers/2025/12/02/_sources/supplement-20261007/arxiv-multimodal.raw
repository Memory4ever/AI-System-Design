      <a href="/search/?searchtype=author&amp;query=Mao%2C+S">Shangqing Mao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jiyao Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+R">Ruihai Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+D">Dongjiang Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shen%2C+H">Hui Shen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dong%2C+H">Hao Dong</a>
      
