      <a href="/search/?searchtype=author&amp;query=Dai%2C+W">Weicheng Dai</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gichoya%2C+J+W">Judy Wawira Gichoya</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Trivedi%2C+H+M">Hari M. Trivedi</a>, 
      
