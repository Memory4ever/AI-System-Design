      <a href="/search/?searchtype=author&amp;query=Casey%2C+C">Connor Casey</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Williams%2C+A">Albert Williams</a>, 
      
      <a href="/search/?searchtype=author&amp;query=McCaffrey%2C+C">Catherine McCaffrey</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rotherham%2C+E">Eugene Rotherham</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Darby%2C+N">Nathan Darby</a>
      
