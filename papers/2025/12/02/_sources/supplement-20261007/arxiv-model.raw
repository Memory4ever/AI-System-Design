        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.00016">pdf</a>, <a href="https://arxiv.org/ps/2512.00016">ps</a>, <a href="https://arxiv.org/format/2512.00016">other</a>]&nbsp;</span>
