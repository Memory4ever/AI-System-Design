        <span>&nbsp;[<a href="https://arxiv.org/pdf/2512.00136">pdf</a>, <a href="https://arxiv.org/ps/2512.00136">ps</a>, <a href="https://arxiv.org/format/2512.00136">other</a>]&nbsp;</span>
