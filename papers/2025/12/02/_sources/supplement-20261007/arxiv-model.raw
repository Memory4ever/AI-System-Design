      <a href="/search/?searchtype=author&amp;query=Yakolli%2C+N">Nivedan Yakolli</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gautam%2C+A">Avinash Gautam</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Das%2C+A">Abhijit Das</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Qi%2C+Y">Yuankai Qi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shekhawat%2C+V+S">Virendra Singh Shekhawat</a>
      
