<td id="S3.T3.2.7.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCCC;padding-top:1pt;padding-bottom:1pt;"><span id="S3.T3.2.7.5.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">7.69 s</span></td>
<td id="S3.T3.2.7.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">7.3 s</td></tr>
