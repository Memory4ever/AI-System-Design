<td id="S3.T3.2.6.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">12.9007</td>
<td id="S3.T3.2.6.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">9.5993</td>
<td id="S3.T3.2.6.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCCC;padding-top:1pt;padding-bottom:1pt;"><span id="S3.T3.2.6.4.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">17.9429</span></td>
<td id="S3.T3.2.6.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;padding-top:1pt;padding-bottom:1pt;"><span id="S3.T3.2.6.5.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">4.4414</span></td>
<td id="S3.T3.2.6.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">10.0233</td></tr>
<tr id="S3.T3.2.7" class="ltx_tr">
<th id="S3.T3.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">Prediction Time (s) (↓)</th>
<td id="S3.T3.2.7.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;padding-top:1pt;padding-bottom:1pt;"><span id="S3.T3.2.7.2.1" class="ltx_text" style="--ltx-bg-color:#CCFFCC;">2.59 s</span></td>
