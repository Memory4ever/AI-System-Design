<td id="S3.T3.2.5.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFCCCC;padding-top:1pt;padding-bottom:1pt;"><span id="S3.T3.2.5.4.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">0.0431</span></td>
<td id="S3.T3.2.5.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.1967</td>
<td id="S3.T3.2.5.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.2615</td></tr>
<tr id="S3.T3.2.6" class="ltx_tr">
