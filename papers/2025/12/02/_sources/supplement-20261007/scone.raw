97j23qw78.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconLogoMark\"]\n1e:[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__postFooter\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__footnotes\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"headline-5\",\"children\":\"Footnotes\"}],[[\"$\",\"p\",\"1co0tkxd\",{\"children\":[\"[1] One proxy for estimating the value of a software vulnerability is the bug bounty—the amount a company offers security researchers for responsibly disclosing flaws in its code. However, bug bounties reflect only the defensive value of a vulnerability to an organization, not the offensive value that could be realized through exploitation in the wild. \"]}],[\"$\",\"p\",\"d6jy4ue4\",{\"children\":[\"[2] For each contract in the benchmark, we estimated the exploit’s dollar value by converting the agent’s profit in the native token (ETH or BNB) to USD using the historical exchange rate from the day the real exploit occurred, as reported by the \",[\"$\",\"a\",\"aopxigsb\",{\"href\":\"https://docs.coingecko.com/\",\"children\":[\"CoinGecko API\"]}],\".        \"]}],[\"$\",\"p\",\"yuf2k8x2\",{\"children\":[\"[3] We evaluated models that were considered \\\"frontier\\\" based on their release dates throughout the year: Llama 3, GPT-4o, DeepSeek V3, Sonnet 3.7, o3, Opus 4, Opus 4.1, GPT-5, Sonnet 4.5, and Opus 4.5. We use extended thinking for all Claude models (except Sonnet 3.7) and high reasoning for GPT-5. In the revenue vs models charts, we only show models that solved at least one problem. \"]}],[\"$\",\"p\",\"909w661f\",{\"children\":[\"[4] This is according to each model's Best@8 performance. Best@8 means that we run each model on each smart contract 8 independent times, and take the highest dollar value achieved across those attempts as the model's performance for that problem.\"]}],[\"$\",\"p\",\"rpbivahp\",{\"children\":[\"[5] For each problem, we look at all 10 models, take the highest exploit revenue of any model achieved on that problem, and then sum those per-problem maxima across all problems to get the maximum total revenue.\"]}],[\"$\",\"p\",\"pbm3tbgf\",{\"children\":[\"[6]  This is according to each model's Best@8 performance.\"]}],[\"$\",\"p\",\"uyihtd4m\",{\"children\":[\"[7] On the recently deployed contracts, the exploit’s dollar value is estimated by converting the agent’s profit in BNB to USD using the historical exchange rate on the day we ran the agent (October 3, 2025), as reported by the \",[\"$\",\"a\",\"rp0yglld\",{\"href\":\"https://docs.coingecko.com/\",\"children\":[\"CoinGecko API\"]}],\".\"]}],[\"$\",\"p\",\"04ir7ik9\",{\"children\":[\"[8] This is according to each model's Best@1 performance.\"]}],[\"$\",\"p\",\"o9xmbov2\",{\"children\":[\"[9] See Figure 3 for more details. \"]}],[\"$\",\"p\",\"f6a5jsiy\",{\"children\":[\"[10] See Figure 6a and 6b for more details.  \"]}],[\"$\",\"p\",\"1s1f0b3h\",{\"children\":[\"[11] See Figure 7 and Figure 8 for more details. \"]}],[\"$\",\"p\",\"w7r77obe\",{\"children\":[\"[12] One agent run ends either when the agent stops making tool calls or the session times out after 60 minutes. \"]}]]]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__socialShare\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://twitter.com/intent/tweet?text=https://www.anthropic.com/research/smart-contracts\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on Twitter\",\"children\":[\"$\",\"$L23\",null,{}]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/shareArticle?mini=true\u0026url=https://www.anthropic.com/research/smart-contracts\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on LinkedIn\",\"children\":[\"$\",\"$L24\",null,{}]}]]}]]}]\n1f:[\"$\",\"section\",null,{\"className\":\"LandingPageSection-module-scss-module__ZSMdoa__root\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SectionIntro-module-scss-module__i9TRza__root LinkGrid-module-scss-module__wTN57W__intro\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"headline-4 SectionIntro-module-scss-module__i9TRza__title\",\"children\":\"Related content\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__root\",\"children\":[false,[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__items LinkGrid-module-scss-module__wTN57W__threeItems\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"Claude-shaped science\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"Guest author Prof. Matthew Schwartz describes what happened when he stopped fighting Claude and allowed Claude to find “Claude-shaped” problems: ones best suited to the capabilities of the current generation of LLM tools. This led him to build BootLoops, a toolkit for exact calculations in quantitative science, which he has been applying across scientific fields alongside experts.\"}],[\"$\",\"$L25\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/claude-shaped-science\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L26\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"What work can robots do?\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We built an index of how well today’s robots can perform US job tasks. Robots can already do three-quarters of physical tasks, mostly in limited settings, but are cost-competitive for just 0.3% of them.\"}],[\"$\",\"$L25\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/what-work-can-robots-do\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L26\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"What do you want from AI? \"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We’re launching a new study using Anthropic Interviewer to learn from your experiences with AI. \"}],[\"$\",\"$L25\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/your-thoughts-on-ai\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L26\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}]]}]]}]]}]]}]\n20:[\"$\",\"section\",null,{\"className\":\"SubjectNewsletter-module-scss-module__qHNNfa__wrapper\",\"data-theme\":\"slate\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-wrapper SubjectNewsletter-module-scss-module__qHNNfa__content\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SubjectNewsletter-module-scss-module__qHNNfa__text-content\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"headline-2 SubjectNewsletter-module-scss-module__qHNNfa__title\",\"children\":\"Subscribe to the Frontier Red Team newsletter\"}],[\"$\",\"p\",null,{\"className\":\"body-1 SubjectNewsletter-module-scss-module__qHNNfa__subtitle\",\"children\":\"Get updates on our latest red-teaming research and findings.\"}]]}],[\"$\",\"div\",null,{\"id\":\"subject-newsletter-frontier-red-team\",\"className\":\"SubjectNewsletter-module-scss-module__qHNNfa__form-container\",\"children\":[\"$\",\"$L27\",null,{\"formId\":\"a1b9e951-ba1d-4c55-9876-cb6