<td id="S3.T1.5.1.6.10" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:9.0pt;padding-right:9.0pt;">6.50</td>
<td id="S3.T1.5.1.6.11" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:9.0pt;padding-right:9.0pt;">50.3</td>
