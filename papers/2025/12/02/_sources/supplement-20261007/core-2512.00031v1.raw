<td id="S3.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">1.0×</td>
<td id="S3.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t">Baseline, high accuracy</td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
<th id="S3.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">FP16</th>
<td id="S3.T2.2.3.2" class="ltx_td ltx_align_center">16</td>
<td id="S3.T2.2.3.3" class="ltx_td ltx_align_center">2</td>
<td id="S3.T2.2.3.4" class="ltx_td ltx_align_center">2.0×</td>
<td id="S3.T2.2.3.5" class="ltx_td ltx_align_center">Balanced performance/accuracy</td></tr>
<tr id="S3.T2.2.4" class="ltx_tr">
<th id="S3.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">BF16</th>
<td id="S3.T2.2.4.2" class="ltx_td ltx_align_center">16</td>
<td id="S3.T2.2.4.3" class="ltx_td ltx_align_center">2</td>
<td id="S3.T2.2.4.4" class="ltx_td ltx_align_center">2.0×</td>
<td id="S3.T2.2.4.5" class="ltx_td ltx_align_center">Training stability</td></tr>
<tr id="S3.T2.2.5" class="ltx_tr">
<th id="S3.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">FP8</th>
