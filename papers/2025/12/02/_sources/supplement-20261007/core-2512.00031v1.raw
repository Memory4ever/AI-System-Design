<td id="S3.T2.2.5.3" class="ltx_td ltx_align_center">1</td>
<td id="S3.T2.2.5.4" class="ltx_td ltx_align_center">4.0×</td>
<td id="S3.T2.2.5.5" class="ltx_td ltx_align_center">Aggressive quantization</td></tr>
<tr id="S3.T2.2.6" class="ltx_tr">
<th id="S3.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">FP4</th>
