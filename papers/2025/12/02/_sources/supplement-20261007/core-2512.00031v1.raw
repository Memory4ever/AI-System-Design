<tr id="S4.T5.2.3" class="ltx_tr">
<td id="S4.T5.2.3.1" class="ltx_td ltx_align_left ltx_border_t">MatMul (128×256×512)</td>
<td id="S4.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_t">200</td>
<td id="S4.T5.2.3.3" class="ltx_td ltx_align_center ltx_border_t">85</td>
<td id="S4.T5.2.3.4" class="ltx_td ltx_align_center ltx_border_t">57.5% faster</td></tr>
<tr id="S4.T5.2.4" class="ltx_tr">
<td id="S4.T5.2.4.1" class="ltx_td ltx_align_left">Conv2D (3×224×224)</td>
<td id="S4.T5.2.4.2" class="ltx_td ltx_align_center">250</td>
<td id="S4.T5.2.4.3" class="ltx_td ltx_align_center">110</td>
<td id="S4.T5.2.4.4" class="ltx_td ltx_align_center">56.0% faster</td></tr>
<tr id="S4.T5.2.5" class="ltx_tr">
