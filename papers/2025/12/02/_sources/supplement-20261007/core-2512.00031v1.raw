<td id="S3.T2.2.6.4" class="ltx_td ltx_align_center">8.0×</td>
<td id="S3.T2.2.6.5" class="ltx_td ltx_align_center">Extreme compression</td></tr>
<tr id="S3.T2.2.7" class="ltx_tr">
<th id="S3.T2.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">INT8</th>
<td id="S3.T2.2.7.2" class="ltx_td ltx_align_center">8</td>
<td id="S3.T2.2.7.3" class="ltx_td ltx_align_center">1</td>
<td id="S3.T2.2.7.4" class="ltx_td ltx_align_center">4.0×</td>
<td id="S3.T2.2.7.5" class="ltx_td ltx_align_center">Standard quantization</td></tr>
<tr id="S3.T2.2.8" class="ltx_tr">
<th id="S3.T2.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">INT4</th>
<td id="S3.T2.2.8.2" class="ltx_td ltx_align_center">4</td>
<td id="S3.T2.2.8.3" class="ltx_td ltx_align_center">0.5</td>
<td id="S3.T2.2.8.4" class="ltx_td ltx_align_center">8.0×</td>
<td id="S3.T2.2.8.5" class="ltx_td ltx_align_center">Ultra-low bitwidth</td></tr>
<tr id="S3.T2.2.9" class="ltx_tr">
<th id="S3.T2.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">Binary</th>
<td id="S3.T2.2.9.2" class="ltx_td ltx_align_center ltx_border_b">1</td>
<td id="S3.T2.2.9.3" class="ltx_td ltx_align_center ltx_border_b">0.125</td>
<td id="S3.T2.2.9.4" class="ltx_td ltx_align_center ltx_border_b">32.0×</td>
