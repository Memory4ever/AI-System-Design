<td id="S2.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">XgenSilicon</span></td>
<td id="S2.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">TVM</span></td>
<td id="S2.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">MLIR</span></td>
<td id="S2.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">XLA</span></td>
<td id="S2.T1.2.1.1.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Glow</span></td>
<td id="S2.T1.2.1.1.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;">LLVM</span></td></tr>
<tr id="S2.T1.2.1.2" class="ltx_tr">
<td id="S2.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S2.T1.2.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Learned Optimization</span></td>
