<span id="A1.T5.2.2.1.1.1" class="ltx_p">XLOGIQA</span>
</span></td>
<td id="A1.T5.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T5.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:241.5pt;">
