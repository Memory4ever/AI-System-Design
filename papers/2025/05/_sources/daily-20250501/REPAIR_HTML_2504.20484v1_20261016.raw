</span></td></tr>
<tr id="A1.T5.2.3" class="ltx_tr">
<td id="A1.T5.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A1.T5.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:69.0pt;">
<span id="A1.T5.2.3.1.1.1" class="ltx_p">XHELLASWAG</span>
</span></td>
<td id="A1.T5.2.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T5.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:241.5pt;">
