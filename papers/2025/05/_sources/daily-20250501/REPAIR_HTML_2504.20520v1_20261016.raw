<span id="S5.T1.1.2.3.1.1" class="ltx_p"><span id="S5.T1.1.2.3.1.1.1" class="ltx_text ltx_font_bold">✓</span></span>
</span></td>
<td id="S5.T1.1.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:1.5pt 0.1pt;">
<span id="S5.T1.1.2.4.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S5.T1.1.2.4.1.1" class="ltx_p"><span id="S5.T1.1.2.4.1.1.1" class="ltx_text ltx_font_bold">✗</span></span>
</span></td>
