<td id="S5.T1.1.1.2" class="ltx_td ltx_nopad_l ltx_align_center ltx_align_middle ltx_border_tt" style="padding:1.5pt 0.1pt;" colspan="2"><span id="S5.T1.1.1.2.1" class="ltx_text ltx_font_bold">Lift banana</span></td>
