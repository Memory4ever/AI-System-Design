<td id="S4.T5.8.1.13.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.8.1.13.4.1" class="ltx_text" style="--ltx-fg-color:#008000;">+<span id="S4.T5.8.1.13.4.1.1" class="ltx_text ltx_font_bold">1.51</span></span></td>
