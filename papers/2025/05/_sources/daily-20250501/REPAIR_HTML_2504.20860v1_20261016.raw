<tr id="A1.T7.6.1.1" class="ltx_tr">
<td id="A1.T7.6.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.T7.6.1.1.1.1" class="ltx_text ltx_font_bold">Methods</span></td>
<td id="A1.T7.6.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A1.T7.6.1.1.2.1" class="ltx_text ltx_font_bold">Prompts</span></td>
