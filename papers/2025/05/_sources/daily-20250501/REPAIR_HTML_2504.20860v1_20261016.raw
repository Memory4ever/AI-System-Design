<tr id="S4.T3.6.1.3" class="ltx_tr">
<td id="S4.T3.6.1.3.1" class="ltx_td ltx_align_left ltx_border_t">ZS-CLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite></td>
