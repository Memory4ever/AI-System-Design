<tr id="A2.T18.6.1.3" class="ltx_tr">
<td id="A2.T18.6.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Llama-3.2-3B <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite></td>
<td id="A2.T18.6.1.3.2" class="ltx_td ltx_align_center ltx_border_t">96.34</td>
<td id="A2.T18.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t">98.92</td>
