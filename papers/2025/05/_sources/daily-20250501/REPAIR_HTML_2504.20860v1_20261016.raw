<td id="A2.T16.6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="A2.T16.6.1.1.3.1" class="ltx_text ltx_font_bold">L43</span></td>
<td id="A2.T16.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="A2.T16.6.1.1.4.1" class="ltx_text ltx_font_bold">L46</span></td>
