<td id="A1.T7.6.1.2.1" class="ltx_td ltx_align_left ltx_border_t">ZS-CLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite></td>
<td id="A1.T7.6.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="A1.T7.6.1.2.2.1" class="ltx_text">hand-crafted</span></td>
