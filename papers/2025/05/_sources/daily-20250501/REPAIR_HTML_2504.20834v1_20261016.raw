<td id="S4.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.2.1" class="ltx_text ltx_font_bold">SVAMP Acc (%)</span></td>
<td id="S4.T4.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.3.1" class="ltx_text ltx_font_bold">Multiplication Acc (%)</span></td></tr>
<tr id="S4.T4.2.2" class="ltx_tr">
<th id="S4.T4.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">1</th>
<td id="S4.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_t">70.3</td>
<td id="S4.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t">22.9</td></tr>
<tr id="S4.T4.2.3" class="ltx_tr">
