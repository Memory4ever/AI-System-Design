<span id="S5.T2.5.4.1.1.1" class="ltx_p">Localization/scope</span>
</span></td>
<td id="S5.T2.5.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S5.T2.5.4.2.1" class="ltx_inline-block ltx_align_top" style="width:27.6pt;">
<span id="S5.T2.5.4.2.1.1" class="ltx_p">6</span>
</span></td>
<td id="S5.T2.5.4.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S5.T2.5.4.3.1" class="ltx_inline-block ltx_align_top" style="width:224.3pt;">
