<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Appendix: Prompt Templates for Evaluations</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p"><span id="A1.p1.1.1" class="ltx_text ltx_font_bold">Prompt (standard prompting) for Natural Questions and RealTime QA:</span></p>
</div>
<div id="A1.p2" class="ltx_para ltx_noindent">
<div id="A1.p2.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx26" class="ltx_listingline"><span id="lstnumberx26.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Context</span><span id="lstnumberx26.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">information</span><span id="lstnumberx26.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx26.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">below</span><span id="lstnumberx26.8" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_font_typewriter">---------------------</span>
</div>
<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">NASA</span><span id="lstnumberx28.2" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx28.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx28.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx28.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Artemis</span><span id="lstnumberx28.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx28.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Program</span><span id="lstnumberx28.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx28.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Advances</span>
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx29.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">In</span><span id="lstnumberx29.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.4" class="ltx_text ltx_font_typewriter">2022,</span><span id="lstnumberx29.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">NASA</span><span id="lstnumberx29.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">made</span><span id="lstnumberx29.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">significant</span><span id="lstnumberx29.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">progress</span><span id="lstnumberx29.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx29.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx29.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Artemis</span><span id="lstnumberx29.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">program</span><span id="lstnumberx29.21" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx29.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">aimed</span><span id="lstnumberx29.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">at</span><span id="lstnumberx29.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">returning</span><span id="lstnumberx29.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">humans</span><span id="lstnumberx29.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx29.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx29.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Moon</span><span id="lstnumberx29.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx29.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">establishing</span><span id="lstnumberx29.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx29.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sustainable</span><span id="lstnumberx29.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">presence</span><span id="lstnumberx29.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">by</span><span id="lstnumberx29.48" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx29.50" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter">end</span><span id="lstnumberx29.52" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx29.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx29.56" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.57" class="ltx_text ltx_lst_identifier ltx_font_typewriter">decade</span><span id="lstnumberx29.58" class="ltx_text ltx_font_typewriter">...</span>
</div>
<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_font_typewriter">---------------------</span>
</div>
<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Given</span><span id="lstnumberx31.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx31.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">context</span><span id="lstnumberx31.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">information</span><span id="lstnumberx31.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx31.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx31.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">prior</span><span id="lstnumberx31.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">knowledge</span><span id="lstnumberx31.16" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx31.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx31.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx31.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.22" class="ltx_text ltx_lst_identifier ltx_font_type