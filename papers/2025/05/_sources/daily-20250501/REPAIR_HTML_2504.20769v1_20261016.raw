<div id="lstnumberx158" class="ltx_listingline"><span id="lstnumberx158.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Query</span><span id="lstnumberx158.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx158.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">What</span><span id="lstnumberx158.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx158.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx158.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">first</span><span id="lstnumberx158.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">number</span><span id="lstnumberx158.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx158.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx158.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">code</span><span id="lstnumberx158.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sequence</span><span id="lstnumberx158.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx158.22" class="ltx_text ltx_lst_identifier ltx