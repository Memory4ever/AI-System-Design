<td id="S3.T3.2.1.14.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_tt" style="padding-top:0.1pt;padding-bottom:0.1pt;" rowspan="12"><span id="S3.T3.2.1.14.1.1" class="ltx_text">
<span id="S3.T3.2.1.14.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T3.2.1.14.1.1.1.1" class="ltx_tr">
<span id="S3.T3.2.1.14.1.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:0.1pt;padding-bottom:0.1pt;">RealTime</span></span>
