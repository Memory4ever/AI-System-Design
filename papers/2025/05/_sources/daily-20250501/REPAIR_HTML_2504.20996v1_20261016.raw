<th id="S5.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.3.1.3.4.1" class="ltx_text" style="font-size:90%;">—</span></th>
<th id="S5.T1.3.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.3.1.3.5.1" class="ltx_text" style="font-size:90%;">—</span></th></tr>
