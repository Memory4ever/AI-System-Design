<th id="S1.T1.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S1.T1.3.4.1.1" class="ltx_text" style="--ltx-fg-color:#9B9B9B;">Llama2 7B</span></th>
