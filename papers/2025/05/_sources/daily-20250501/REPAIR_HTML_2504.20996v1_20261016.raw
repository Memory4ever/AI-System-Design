<span id="S5.T1.3.1.4.1.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:71.1pt;">
<span id="S5.T1.3.1.4.1.1.1" class="ltx_p"><span id="S5.T1.3.1.4.1.1.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Single Tower</span></span>
</span></th>
<td id="S5.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.3.1.4.2.1" class="ltx_text" style="font-size:90%;">25.0</span></td>
<td id="S5.T1.3.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.3.1.4.3.1" class="ltx_text ltx_underline" style="font-size:90%;">19.10</span></td>
<td id="S5.T1.3.1.4.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.3.1.4.4.1" class="ltx_text ltx_underline" style="font-size:90%;">22.63</span></td>
<td id="S5.T1.3.1.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.3.1.4.5.1" class="ltx_text" style="font-size:90%;">30.2</span></td></tr>
<tr id="S5.T1.3.1.5" class="ltx_tr">
<th id="S5.T1.3.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">
<span id="S5.T1.3.1.5.1.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:71.1pt;">
<span id="S5.T1.3.1.5.1.1.1" class="ltx_p"><span id="S5.T1.3.1.5.1.1.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Gated Tower</span></span>
</span></th>
<td id="S5.T1.3.1.5.2" class="ltx_td ltx_align_center"><span id="S5.T1.3.1.5.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">32.2</span></td>
<td id="S5.T1.3.1.5.3" class="ltx_td ltx_align_center"><span id="S5.T1.3.1.5.3.1" class="ltx_text" style="font-size:90%;">24.51</span></td>
<td id="S5.T1.3.1.5.4" class="ltx_td ltx_align_center"><span id="S5.T1.3.1.5.4.1" class="ltx_text" style="font-size:90%;">21.91</span></td>
<td id="S5.T1.3.1.5.5" class="ltx_td ltx_align_center"><span id="S5.T1.3.1.5.5.1" class="ltx_text" style="font-size:90%;">14.5</span></td></tr>
