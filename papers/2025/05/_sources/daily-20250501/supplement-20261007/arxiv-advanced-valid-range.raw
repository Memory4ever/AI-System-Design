      <a href="/search/?searchtype=author&amp;query=Wiese%2C+C+W">Chris W. Wiese</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sherrill%2C+A+M">Andrew M. Sherrill</a>
      
