      <a href="/search/?searchtype=author&amp;query=de+Rosa%2C+G">Gustavo de Rosa</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gunasekar%2C+S">Suriya Gunasekar</a>, 
      
