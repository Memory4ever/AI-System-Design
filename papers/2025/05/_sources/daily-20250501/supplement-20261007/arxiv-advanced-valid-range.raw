      <a href="/search/?searchtype=author&amp;query=Guimard%2C+Q">Quentin Guimard</a>, 
      
      <a href="/search/?searchtype=author&amp;query=D%27Inc%C3%A0%2C+M">Moreno D&#39;Incà</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mancini%2C+M">Massimiliano Mancini</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ricci%2C+E">Elisa Ricci</a>
      
