        <span>&nbsp;[<a href="https://arxiv.org/pdf/2504.20924">pdf</a>, <a href="https://arxiv.org/ps/2504.20924">ps</a>, <a href="https://arxiv.org/format/2504.20924">other</a>]&nbsp;</span>
