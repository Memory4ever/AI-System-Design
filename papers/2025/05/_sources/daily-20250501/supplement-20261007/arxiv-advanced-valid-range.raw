      <a href="/search/?searchtype=author&amp;query=Kneisel%2C+T">Tristan Kneisel</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Vehlken%2C+F">Fabian Vehlken</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zeume%2C+T">Thomas Zeume</a>
      
