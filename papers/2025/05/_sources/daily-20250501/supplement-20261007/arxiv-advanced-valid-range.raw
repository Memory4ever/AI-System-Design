      <a href="/search/?searchtype=author&amp;query=Zohary%2C+A">Avi Zohary</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Weerawardhena%2C+S">Sajana Weerawardhena</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Priyanshu%2C+A">Aman Priyanshu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Swanda%2C+A">Adam Swanda</a>, 
      
