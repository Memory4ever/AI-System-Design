    <p class="title is-5 mathjax">
      
        RWKV-X: A Linear Complexity Hybrid <span class="search-hit mathjax">Language</span> <span class="search-hit mathjax">Model</span>
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Hou%2C+H">Haowen Hou</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+Z">Zhiyi Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tan%2C+K">Kaifeng Tan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lu%2C+R">Rongchang Lu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+F+R">Fei Richard Yu</a>
      
