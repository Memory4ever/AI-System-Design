    <p class="title is-5 mathjax">
      
        Coyote v2: Raising the Level of Abstraction for Data Center FPGAs
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Ramhorst%2C+B">Benjamin Ramhorst</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Korolija%2C+D">Dario Korolija</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Heer%2C+M+J">Maximilian Jakob Heer</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dann%2C+J">Jonas Dann</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+L">Luhao Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Alonso%2C+G">Gustavo Alonso</a>
      
