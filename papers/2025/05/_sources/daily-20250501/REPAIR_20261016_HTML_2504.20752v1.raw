<span id="S3.T2.4.1.1.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
<span id="S3.T2.4.1.1.1.1" class="ltx_p"><span id="S3.T2.4.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Type</span></span>
</span></th>
<th id="S3.T2.4.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S3.T2.4.1.2.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
