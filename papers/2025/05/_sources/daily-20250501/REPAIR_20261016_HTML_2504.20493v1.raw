<figure id="S5.F8" class="ltx_figure"><object type="image/svg+xml" data="2504.20493v1/analyze.svg" id="S5.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/136;" width="476" height="136"></object>
