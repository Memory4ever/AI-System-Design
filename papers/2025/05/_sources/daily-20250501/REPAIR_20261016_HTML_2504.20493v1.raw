</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m22" class="ltx_Math" alttext="(c,d)\leftarrow Random(p_{1},p_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(c,d)\leftarrow Random(p_{1},p_{2})</annotation></semantics></math>  <math id="algorithm1.m23" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="algorithm1.4.14.1" class="ltx_text ltx_font_italic"> <math id="algorithm1.m24" class="ltx_Math" alttext="c&gt;d" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">c&gt;d</annotation></semantics></math>.</span>
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m25" class="ltx_Math" alttext="q\leftarrow Gen_{t}(c,d)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo stretchy="false">←</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q\leftarrow Gen_{t}(c,d)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.16.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m26" class="ltx_Math" alttext="count==N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>=</mo><mphantom></mphantom><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">count==N</annotation></semantics></math></em> <span id="algorithm1.4.16.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.17.1" class="ltx_text ltx_font_bold">search completed</span>. 
</div>
