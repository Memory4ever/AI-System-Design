<div id="A3.SS1.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A3.SS1.p5.pic1" class="ltx_picture" height="58.48" overflow="visible" version="1.1" viewBox="0 0 477.38 58.48" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,58.48) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#909FB9;" fill="#909FB9" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 53.71 C 0 56.35 2.13 58.48 4.77 58.48 L 472.61 58.48 C 475.24 58.48 477.38 56.35 477.38 53.71 L 477.38 0 Z"></path></g><g style="--ltx-fill-color:#E9EEF8;" fill="#E9EEF8" fill-opacity="1.0"><path style="stroke:none" d="M 0.83 0.83 L 0.83 36.65 L 476.55 36.65 L 476.55 0.83 Z"></path></g><g style="--ltx-fill-color:#DAE3F3;" fill="#DAE3F3"><path style="stroke:none" d="M 0 58.48 M 0 58.48 L 0 58.48 L 497.06 58.48 L 497.06 58.48 Z M 497.06 58.48"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 15.84 44.1)"><foreignObject style="--ltx-fo-width:28.01em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="387.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A3.SS1.p5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:28.01em;">
<span id="A3.SS1.p5.pic1.1.1" class="ltx_p"><span id="A3.SS1.p5.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Abstract App</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 15.84 15.49)"><foreignObject style="--ltx-fo-width:32.21em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.34" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="445.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A3.SS1.p5.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.21em;">
<span id="A3.SS1.p5.pic1.2.1" class="ltx_listing ltx_lst_language_json ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">{</span>
</span>
<span id="lstnumberx35" class="ltx_listingline"><span id="lstnumberx35.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">  </span><span id="lstnumberx35.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx35.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">apps</span><span id="lstnumberx35.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx35.5" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx35.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">[</span>
</span>
