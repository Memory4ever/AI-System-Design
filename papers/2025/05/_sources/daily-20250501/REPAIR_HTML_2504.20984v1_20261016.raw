</span></span><span id="S4.T2.7.1.1.4.4" class="ltx_text"></span></td>
<td id="S4.T2.7.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.7.1.1.5.1" class="ltx_text"></span><span id="S4.T2.7.1.1.5.2" class="ltx_text" style="font-size:70%;"> </span><span id="S4.T2.7.1.1.5.3" class="ltx_text" style="font-size:70%;">
<span id="S4.T2.7.1.1.5.3.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.7.1.1.5.3.1.1" class="ltx_tr">
