<span id="A2.p3.pic1.1.4" class="ltx_p" style="width:326.5pt;"><span id="A2.p3.pic1.1.4.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:326.5pt;--ltx-fg-color:#000000;"><span id="A2.p3.pic1.1.4.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:326.5pt;">
