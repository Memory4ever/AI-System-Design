</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 15.7 15.08)"><foreignObject style="--ltx-fo-width:32.23em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.16em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="445.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
