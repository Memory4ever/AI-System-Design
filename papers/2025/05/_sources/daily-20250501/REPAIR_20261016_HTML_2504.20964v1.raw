          <span id="lstnumberx60.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx60.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">if</span><span id="lstnumberx60.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.5" class="ltx_text ltx_font_typewriter">(--</span><span id="lstnumberx60.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">file</span><span id="lstnumberx60.7" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx60.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">refcnt</span><span id="lstnumberx60.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.10" class="ltx_text ltx_font_typewriter">==</span><span id="lstnumberx60.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.12" class="ltx_text ltx_font_typewriter">0)</span><span id="lstnumberx60.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.14" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx60.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx60.16" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="--ltx-fg-color:#808080;">//<span id="lstnumberx60.16.1" class="ltx_text ltx_lst_space"> </span>Cond5.</span>
</div>
<div id="lstnumberx61" class="ltx_listingline">
