          <span id="lstnumberx58.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx58.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">proc</span><span id="lstnumberx58.4" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx58.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ofile</span><span id="lstnumberx58.6" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx58.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fd</span><span id="lstnumberx58.8" class="ltx_text ltx_font_typewriter">]</span><span id="lstnumberx58.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx58.10" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx58.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx58.12" class="ltx_text ltx_font_typewriter">0;</span>
</div>
