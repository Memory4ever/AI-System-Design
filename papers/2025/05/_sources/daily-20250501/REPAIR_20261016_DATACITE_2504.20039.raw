{"data":{"id":"10.48550/arxiv.2504.20039","type":"dois","attributes":{"doi":"10.48550/arxiv.2504.20039","prefix":"10.48550","suffix":"arxiv.2504.20039","identifiers":[{"identifier":"2504.20039","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2504.20039"}],"creators":[{"name":"Garipov, Roman","nameType":"Personal","givenName":"Roman","familyName":"Garipov","affiliation":[],"nameIdentifiers":[]},{"name":"Velikonivtsev, Fedor","nameType":"Personal","givenName":"Fedor","familyName":"Velikonivtsev","affiliation":[],"nameIdentifiers":[]},{"name":"Ermakov, Ivan","nameType":"Personal","givenName":"Ivan","familyName":"Ermakov","affiliation":[],"nameIdentifiers":[]},{"name":"Svirschevski, Ruslan","nameType":"Personal","givenName":"Ruslan","familyName":"Svirschevski","affiliation":[],"nameIdentifiers":[]},{"name":"Egiazarian, Vage","nameType":"Personal","givenName":"Vage","familyName":"Egiazarian","affiliation":[],"nameIdentifiers":[]},{"name":"Ryabinin, Max","nameType":"Personal","givenName":"Max","familyName":"Ryabinin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoJudge: Judge Decoding Without Manual Annotation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-04-28T17:59:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-04-29T02:00:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-30T17:21:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T01:19:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-28T14:35:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-29T00:56:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-20T14:38:33Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-11-21T01:45:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-04","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We introduce AutoJudge, a method that accelerates large language model (LLM) inference with task-specific lossy speculative decoding. Instead of matching the original model output distribution token-by-token, we identify which of the generated tokens affect the downstream quality of the response, relaxing the distribution match guarantee so that the \"unimportant\" tokens can be generated faster. Our approach relies on a semi-greedy search algorithm to test which of the mismatches between target and draft models should be corrected to preserve quality and which ones may be skipped. We then train a lightweight classifier based on existing LLM embeddings to predict, at inference time, which mismatching tokens can be safely accepted without compromising the final answer quality. We evaluate the effectiveness of AutoJudge with multiple draft/target model pairs on mathematical reasoning and programming benchmarks, achieving significant speedups at the cost of a minor accuracy reduction. Notably, on GSM8k with the Llama 3.1 70B target model, our approach achieves up to $\\approx2\\times$ speedup over speculative decoding at the cost of $\\le 1\\%$ drop in accuracy. When applied to the LiveCodeBench benchmark, AutoJudge automatically detects programming-specific important tokens, accepting $\\ge 25$ tokens per speculation cycle at $2\\%$ drop in Pass@1. Our approach requires no human annotation and is easy to integrate with modern LLM inference frameworks.","descriptionType":"Abstract"},{"description":"Accepted at NeurIPS 2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2504.20039","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-04-29T03:44:39.000Z","registered":"2025-04-29T03:44:40.000Z","published":"2025","updated":"2025-11-21T02:59:16.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2504.20039","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}