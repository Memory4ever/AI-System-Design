<td id="S3.T1.2.1.2" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.2.1.2.1" class="ltx_text ltx_font_bold">Size</span></td>
