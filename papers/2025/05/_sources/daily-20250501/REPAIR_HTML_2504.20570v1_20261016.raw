<td id="S5.T2.1.5.2" class="ltx_td ltx_align_left"><span id="S5.T2.1.5.2.1" class="ltx_text ltx_font_bold">54.53%</span></td>
<td id="S5.T2.1.5.3" class="ltx_td ltx_align_left"><span id="S5.T2.1.5.3.1" class="ltx_text ltx_font_bold">41.21%</span></td>
<td id="S5.T2.1.5.4" class="ltx_td ltx_align_left ltx_border_r"><span id="S5.T2.1.5.4.1" class="ltx_text ltx_font_bold">30.07%</span></td>
<td id="S5.T2.1.5.5" class="ltx_td ltx_align_left"><span id="S5.T2.1.5.5.1" class="ltx_text ltx_font_bold">49.58%</span></td>
