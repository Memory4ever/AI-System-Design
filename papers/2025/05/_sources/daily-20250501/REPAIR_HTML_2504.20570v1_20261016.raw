<td id="S5.T2.1.2.5" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="b=2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">b=2</annotation></semantics></math></td>
<td id="S5.T2.1.2.6" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m5" class="ltx_Math" alttext="b=16" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">b=16</annotation></semantics></math></td>
<td id="S5.T2.1.2.7" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S5.T2.m6" class="ltx_Math" alttext="b=128" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>128</mn></mrow><annotation encoding="application/x-tex">b=128</annotation></semantics></math></td>
