<tr id="S5.T3.fig1.1.8" class="ltx_tr">
<th id="S5.T3.fig1.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:0.55pt 2.8pt;"><span id="S5.T3.fig1.1.8.1.1" class="ltx_text" style="font-size:70%;">GPT-4v-0409 </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T3.fig1.1.8.1.2" class="ltx_text" style="font-size:70%;">[</span><a href="#bib.bib2" title="" class="ltx_ref">2</a><span id="S5.T3.fig1.1.8.1.3" class="ltx_text" style="font-size:70%;">]</span></cite></th>
