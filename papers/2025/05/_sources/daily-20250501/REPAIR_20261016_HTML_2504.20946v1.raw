<td id="S7.T4.2.4.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S7.T4.2.4.3.1" class="ltx_text ltx_font_bold">70.5</span></td>
<td id="S7.T4.2.4.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S7.T4.2.4.4.1" class="ltx_text ltx_font_bold">39.2</span></td></tr>
