<span id="S6.T2.2.1.1.1.5.4" class="ltx_td ltx_align_center ltx_border_r">+<span id="S6.T2.2.1.1.1.5.4.1" class="ltx_text ltx_font_bold">125.53%</span></span></span>
<span id="S6.T2.2.1.1.1.6" class="ltx_tr">
<span id="S6.T2.2.1.1.1.6.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_l ltx_border_r">Zephyr-7B</span>
<span id="S6.T2.2.1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">12</span>
