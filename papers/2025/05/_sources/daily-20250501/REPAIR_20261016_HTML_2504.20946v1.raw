<span id="S6.T2.2.1.1.1.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">+<span id="S6.T2.2.1.1.1.6.4.1" class="ltx_text ltx_font_bold">50%</span></span></span>
</span>
</span></span></p>
</span></div></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="S6.T2.3" class="ltx_inline-block ltx_figure_panel ltx_align_center ltx_transformed_outer" style="width:333.9pt;height:73.2pt;vertical-align:-34.1pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<p id="S6.T2.3.1" class="ltx_p"><span id="S6.T2.3.1.1" class="ltx_text">
<span id="S6.T2.3.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
