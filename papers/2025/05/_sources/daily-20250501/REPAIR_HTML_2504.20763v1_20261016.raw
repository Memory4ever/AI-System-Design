            <math id="alg1.m18" class="ltx_Math" alttext="n^{\prime}\leftarrow\text{CreateNode}(package,version_{\text{latest}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mtext>CreateNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mtext>latest</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n^{\prime}\leftarrow\text{CreateNode}(package,version_{\text{latest}})</annotation></semantics></math>;
</div>
