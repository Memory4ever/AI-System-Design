<div id="alg1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.9.1" class="ltx_text ltx_font_bold">5</span></span>
            <span id="alg1.4.9.2" class="ltx_text ltx_font_bold">foreach</span> <em id="alg1.4.9.3" class="ltx_emph ltx_font_italic"><math id="alg1.m9" class="ltx_Math" alttext="n\in V" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">n\in V</annotation></semantics></math></em> <span id="alg1.4.9.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.10.1" class="ltx_text ltx_font_bold">6</span></span>
            <span id="alg1.4.10.2" class="ltx_text ltx_font_bold">if</span> <em id="alg1.4.10.3" class="ltx_emph ltx_font_italic"><math id="alg1.m10" class="ltx_Math" alttext="\text{HasLocalDeps}(n,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">HasLocalDeps</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{HasLocalDeps}(n,\mathcal{D})</annotation></semantics></math></em> <span id="alg1.4.10.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
