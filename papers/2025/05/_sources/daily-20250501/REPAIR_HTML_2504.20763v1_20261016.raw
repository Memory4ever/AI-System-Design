            <span id="alg1.4.21.2" class="ltx_text">ProcessDependencies</span>(<math id="alg1.m19" class="ltx_Math" alttext="n^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mo>′</mo></msup><annotation encoding="application/x-tex">n^{\prime}</annotation></semantics></math>);
</div>
