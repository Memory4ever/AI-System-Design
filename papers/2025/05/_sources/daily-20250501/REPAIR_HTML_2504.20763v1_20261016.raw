            <math id="alg1.m11" class="ltx_Math" alttext="E\leftarrow E\cup\text{LinkExistingDeps}(n,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mrow><mi>E</mi><mo>∪</mo><mrow><mtext>LinkExistingDeps</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E\leftarrow E\cup\text{LinkExistingDeps}(n,\mathcal{D})</annotation></semantics></math>;
</div>
<div id="alg1.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.12.1" class="ltx_text ltx_font_bold">8</span></span>
            <span id="alg1.4.12.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.13.1" class="ltx_text ltx_font_bold">9</span></span>
            <math id="alg1.m12" class="ltx_math_unparsed" alttext="\text{resp}\leftarrow\mathcal{A}.\text{fetch}(n.package,n.version)" display="inline" intent=":literal"><semantics><mrow><mtext>resp</mtext><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext>fetch</mtext><mrow><mo stretchy="false">(</mo><mi>n</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>p</mi><mi>a</mi><mi>c</mi><mi>k</mi><mi>a</mi><mi>g</mi><mi>e</mi><mo>,</mo><mi>n</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>v</mi><mi>e</mi><mi>r</mi><mi>s</mi><mi>i</mi><mi>o</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{resp}\leftarrow\mathcal{A}.\text{fetch}(n.package,n.version)</annotation></semantics></math>;
</div>
<div id="alg1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.14.1" class="ltx_text ltx_font_bold">10</span></span>
            <math id="alg1.m13" class="ltx_math_unparsed" alttext="V\leftarrow V\cup\text{CreateNode}(\text{resp}.package,\text{resp}.version)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo stretchy="false">←</mo><mi>V</mi><mo>∪</mo><mtext>CreateNode</mtext><mrow><mo stretchy="false">(</mo><mtext>resp</mtext><mo lspace="0em" rspace="0.167em">.</mo><mi>p</mi><mi>a</mi><mi>c</mi><mi>k</mi><mi>a</mi><mi>g</mi><mi>e</mi><mo>,</mo><mtext>resp</mtext><mo lspace="0em" rspace="0.167em">.</mo><mi>v</mi><mi>e</mi><mi>r</mi><mi>s</mi><mi>i</mi><mi>o</mi><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V\leftarrow V\cup\text{CreateNode}(\text{resp}.package,\text{resp}.version)</annotation></semantics></math>;
</div>
<div id="alg1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.15.1" class="ltx_text ltx_font_bold">11</span></span>
            <math id="alg1.m14" class="ltx_math_unparsed" alttext="E\leftarrow E\cup(n\to\text{resp}.\text{node})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mi>E</mi><mo>∪</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">→</mo><mtext>resp</mtext><mo lspace="0em" rspace="0.167em">.</mo><mtext>node</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E\leftarrow E\cup(n\to\text{resp}.\text{node})</annotation></semantics></math>;
</div>
<div id="alg1.4.16" class="ltx_listingline"><span id="alg1.4.16.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">// </span><span id="alg1.4.16.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Package version normalization<span id="alg1.4.16.2.1" class="ltx_text" style="--ltx-fg-color:#000000;"> </span></span>
</div>
<div id="alg1.4.17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.17.1" class="ltx_text ltx_font_bold">12</span></span>
            <span id="alg1.4.17.2" class="ltx_text ltx_font_bold">Function</span> <em id="alg1.4.17.3" class="ltx_emph ltx_font_italic">HandleV2Packages(<math id="alg1.m15" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>)</em><span id="alg1.4.17.4" class="ltx_text ltx_font_bold">:</span>
</div>
<div id="alg1.4.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.18.1" class="ltx_text ltx_font_bold">13</span></span>
            <span id="alg1.4.18.2" class="ltx_text ltx_font_bold">foreach</span> <em id="alg1.4.18.3" class="ltx_emph ltx_font_italic"><math id="alg1.m16" class="ltx_Math" alttext="package\in\text{GetV2}(\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>∈</mo><mrow><mtext class="ltx_mathvariant_italic">GetV2</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">package\in\text{GetV2}(\mathcal{D})</annotation></semantics></math></em> <span id="alg1.4.18.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg1.4.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.4.19.1" class="ltx_text ltx_font_bold">14</span></span>
            <math id="alg1.m17" class="ltx_Math" alttext="v_{\text{latest}}\leftarrow\mathcal{A}.\text{get\_latest}(package)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mtext>latest</mtext></msub><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>get_latest</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{\text{latest}}\leftarrow\mathcal{A}.\text{get\_latest}(package)</annotation></semantics></math>;
</div>
<div id="alg1.4.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
