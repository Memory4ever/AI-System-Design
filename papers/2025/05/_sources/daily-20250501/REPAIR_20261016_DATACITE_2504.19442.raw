{"data":{"id":"10.48550/arxiv.2504.19442","type":"dois","attributes":{"doi":"10.48550/arxiv.2504.19442","prefix":"10.48550","suffix":"arxiv.2504.19442","identifiers":[{"identifier":"2504.19442","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2504.19442"}],"creators":[{"name":"Zheng, Size","nameType":"Personal","givenName":"Size","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Bao, Wenlei","nameType":"Personal","givenName":"Wenlei","familyName":"Bao","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Qi","nameType":"Personal","givenName":"Qi","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Xuegui","nameType":"Personal","givenName":"Xuegui","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Jin","nameType":"Personal","givenName":"Jin","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Chenhui","nameType":"Personal","givenName":"Chenhui","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Tianqi","nameType":"Personal","givenName":"Tianqi","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Duanmu, Haojie","nameType":"Personal","givenName":"Haojie","familyName":"Duanmu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Renze","nameType":"Personal","givenName":"Renze","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Ruifan","nameType":"Personal","givenName":"Ruifan","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yifan","nameType":"Personal","givenName":"Yifan","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Ningxin","nameType":"Personal","givenName":"Ningxin","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Ziheng","nameType":"Personal","givenName":"Ziheng","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Di, Xinyi","nameType":"Personal","givenName":"Xinyi","familyName":"Di","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Dongyang","nameType":"Personal","givenName":"Dongyang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Jianxi","nameType":"Personal","givenName":"Jianxi","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Haibin","nameType":"Personal","givenName":"Haibin","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Chang, Li-Wen","nameType":"Personal","givenName":"Li-Wen","familyName":"Chang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Liqiang","nameType":"Personal","givenName":"Liqiang","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Liang, Yun","nameType":"Personal","givenName":"Yun","familyName":"Liang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhai, Jidong","nameType":"Personal","givenName":"Jidong","familyName":"Zhai","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xin","nameType":"Personal","givenName":"Xin","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Triton-distributed: Programming Overlapping Kernels on Distributed AI Systems with the Triton Compiler"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-04-28T03:09:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-04-29T01:14:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-04T08:05:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-06T00:41:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-06-05T05:48:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-06-06T00:26:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-04","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"In this report, we propose Triton-distributed, an extension of existing Triton compiler, to overcome the programming challenges in distributed AI systems. Triton-distributed is the first compiler that supports native overlapping optimizations for distributed AI workloads, providing a good coverage of existing optimizations from different frameworks. First, we integrate communication primitives compliant with the OpenSHMEM standard into the compiler. This enables programmers to utilize these primitives with a higher-level Python programming model. Second, we illustrate how to achieve complex joint optimization of computation, memory access, and communication with the assistance of the compiler. In particular, we show how to use overlapping techniques to hide latency and present our compiler-based programming methods in both single-node and multi-node scenarios. Finally, we showcase the performance of the code generated by our compiler. In a test environment with up to 64 devices, our compiler can fully utilize heterogeneous communication and computation resources to provide effective overlapping and high performance. In many cases, the performance of the generated code can even outperform hand-optimized code. Moreover, the development difficulty and the time cost for development using our compiler are far less than those of low-level programming such as CUDA/C++, which clearly demonstrates significant productivity advantages.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2504.19442","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-04-29T03:27:23.000Z","registered":"2025-04-29T03:27:24.000Z","published":"2025","updated":"2025-06-06T02:16:53.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2504.19442","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}