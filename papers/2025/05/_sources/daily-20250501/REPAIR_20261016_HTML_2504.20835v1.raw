<td id="S5.T5.2.5.7" class="ltx_td ltx_align_left">52.4 &lt;94&gt;</td>
<td id="S5.T5.2.5.8" class="ltx_td ltx_align_left">53.4 &lt;99&gt;</td>
<td id="S5.T5.2.5.9" class="ltx_td ltx_nopad_r ltx_align_left">49.9 &lt;99&gt;</td></tr>
<tr id="S5.T5.2.6" class="ltx_tr">
<td id="S5.T5.2.6.1" class="ltx_td ltx_align_left ltx_border_bb">Semi-Implicit XS-CoT</td>
<td id="S5.T5.2.6.2" class="ltx_td ltx_align_left ltx_border_bb">38.6 &lt;29&gt;</td>
<td id="S5.T5.2.6.3" class="ltx_td ltx_align_left ltx_border_bb">40.4 &lt;31&gt;</td>
<td id="S5.T5.2.6.4" class="ltx_td ltx_align_left ltx_border_bb">32.2 &lt;31&gt;</td>
<td id="S5.T5.2.6.5" class="ltx_td ltx_align_left ltx_border_bb">37.1 &lt;30&gt;</td>
<td id="S5.T5.2.6.6" class="ltx_td ltx_align_left ltx_border_bb">34.6 &lt;27&gt;</td>
<td id="S5.T5.2.6.7" class="ltx_td ltx_align_left ltx_border_bb">40.0 &lt;28&gt;</td>
