</span></th>
<th id="A6.T1.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2"><span id="A6.T1.5.1.4.1" class="ltx_text ltx_font_bold">Non-Optimized</span></th>
<th id="A6.T1.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="A6.T1.5.1.5.1" class="ltx_text ltx_font_bold">DSPy-Optimized</span></th></tr>
<tr id="A6.T1.5.2" class="ltx_tr">
<th id="A6.T1.5.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r"></th>
<th id="A6.T1.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r"></th>
<th id="A6.T1.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="A6.T1.5.2.3.1" class="ltx_text ltx_font_bold">is_safe</span></th>
<th id="A6.T1.5.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t">
<span id="A6.T1.5.2.4.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
