<span id="A5.T3.3.3.2.1.1" class="ltx_p">SFT - 220 mins</span>
</span></td></tr>
<tr id="A5.T3.3.4" class="ltx_tr">
<th id="A5.T3.3.4.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r"></th>
<td id="A5.T3.3.4.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_b ltx_border_r ltx_border_t">
<span id="A5.T3.3.4.2.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
<span id="A5.T3.3.4.2.1.1" class="ltx_p">DPO - 280 mins</span>
</span></td></tr>
