<span id="A5.T3.3.1.1.1.1" class="ltx_p"><span id="A5.T3.3.1.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></span>
</span></th>
<th id="A5.T3.3.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_r ltx_border_t">
<span id="A5.T3.3.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
<span id="A5.T3.3.1.2.1.1" class="ltx_p">Pythia - 2.8B</span>
</span></th></tr>
</thead>
