</span></th>
<td id="A5.T3.3.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="A5.T3.3.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
<span id="A5.T3.3.2.2.1.1" class="ltx_p">Anthropic-HH (161k train split, 8552 test split) Bai et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite></span>
</span></td></tr>
<tr id="A5.T3.3.3" class="ltx_tr">
<th id="A5.T3.3.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">
<span id="A5.T3.3.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:56.9pt;">
<span id="A5.T3.3.3.1.1.1" class="ltx_p"><span id="A5.T3.3.3.1.1.1.1" class="ltx_text ltx_font_bold">Time taken</span></span>
</span></th>
