        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.01652">pdf</a>, <a href="https://arxiv.org/ps/2505.01652">ps</a>, <a href="https://arxiv.org/format/2505.01652">other</a>]&nbsp;</span>
