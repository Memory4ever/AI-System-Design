{"data":[{"id":"10.48550/arxiv.2505.01490","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01490","identifiers":[{"identifier":"2505.01490","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruoshi","familyName":"Xu","name":"Xu, Ruoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daoan","familyName":"Zhang","name":"Zhang, Daoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Che","familyName":"Jiang","name":"Jiang, Che","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biaoxiang","familyName":"Chen","name":"Chen, Biaoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Jin","name":"Jin, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutian","familyName":"Lu","name":"Lu, Yutian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianguo","familyName":"Zhang","name":"Zhang, Jianguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Yong","name":"Yong, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiebo","familyName":"Luo","name":"Luo, Jiebo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengda","familyName":"Luo","name":"Luo, Shengda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WorldGenBench: A World-Knowledge-Integrated Benchmark for Reasoning-Driven Text-to-Image Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T17:59:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:02:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-09T09:32:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-12T00:46:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent text-to-image (T2I) models achieve high visual fidelity and accurate explicit grounding from input prompts. However, image generation is fundamentally a process of semantic expansion. Beyond surface-level descriptions, generating authentic visual content requires supplementing prompts with unstated cues, a crucial step that current models frequently overlook. In response, we introduce WorldGenBench, a benchmark designed to evaluate how well T2I systems integrate factual grounding with contextual inference. Unlike prior work that isolates these abilities, WorldGenBench emphasizes their synergy, recognizing that true understanding requires both knowing and reasoning. To enable interpretable evaluation, we propose the Knowledge Checklist Score, which assesses whether generated images faithfully reflect key explicit and implicit semantic elements. Evaluating 24 models reveals persistent gaps: proprietary models like GPT-4o show strong integration, while most open-source systems lag, particularly in culturally diverse and scientific scenarios. Our analysis further identifies common failure modes, including semantic hallucination and the underrepresentation of non-Western knowledge, underscoring the limitations of current models in achieving real-world readiness. These findings highlight the need to guide future T2I models toward deeper, knowledge-aware generation. Project Page: \\href{https://dwanzhang-ai.github.io/WorldGenBench/}{https://dwanzhang-ai.github.io/WorldGenBench/}"},{"descriptionType":"Other","description":"accepted at the 3rd Workshop on Generative Models for Computer Vision, CVPR 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01490","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:30:29Z","registered":"2025-05-06T02:30:30Z","published":null,"updated":"2026-10-12T02:47:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.03819","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.03819","identifiers":[{"identifier":"2505.03819","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johannes","familyName":"Schneider","name":"Schneider, Johannes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Focus on Likely Classes for Test-Time Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T21:06:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-08T00:02:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-16T15:21:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-19T00:48:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-20T07:23:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-23T01:19:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-27T07:18:39Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-29T01:23:05Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We ask: Can focusing on likely classes of a single, in-domain sample improve accuracy? Prior work argued \"no\", we answer \"yes\" on average. Standard entropy minimization yields largest gains, and we further dissect why by looking at its two core mechanisms: increasing likely and decreasing unlikely class predictions. Simply maximizing logits of the two most likely classes explains most of its benefits and, in some cases, even outperforms entropy minimization. Thus, decreasing classes is a secondary concern.\n Our controlled experiment and theory investigate the most puzzling case, why simply optimizing the logits of the two most likely classes leads to accuracy gains. Our small scale networks suggest that the degree of uncertainty of a prediction, followed by model choice, and to a lesser extent dataset choice moderate the success chances of the optimization. We show that the true class tends to have larger gradients independent of whether the prediction is correct or not. Our theory thoroughly investigates one of multiple possible explanations from the angle of shared features.\n Our evaluation focuses on 26 large language models and 12 text datasets, and 18 image recognition models trained on ImageNet. It demonstrates gains of 0.6 percent on average for entropy minimization on uncertain samples using no extra data aside from the given test sample using a fixed learning rate. We also suggest gradient-ray ensembling. When traversing input/embedding space by applying the same gradient with differing learning rates and aggregating probabilities for the same sample further improves accuracy significantly to 0.75 percent relying on a coarse range for learning rates, thus improving accuracy and eliminating the need to find a precise learning rate at the expense of computation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.03819","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-08T01:45:13Z","registered":"2025-05-08T01:45:13Z","published":null,"updated":"2026-09-29T06:54:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01583","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01583","identifiers":[{"identifier":"2505.01583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jen-Hao","familyName":"Cheng","name":"Cheng, Jen-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Hao","familyName":"Peng","name":"Peng, Yi-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huapeng","familyName":"Zhou","name":"Zhou, Huapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivian","familyName":"Wang","name":"Wang, Vivian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huayu","familyName":"Wang","name":"Wang, Huayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsiang-Wei","familyName":"Huang","name":"Huang, Hsiang-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Chai","name":"Chai, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hou-I","familyName":"Liu","name":"Liu, Hou-I","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuang-Ming","familyName":"Chen","name":"Chen, Kuang-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Yen","familyName":"Yang","name":"Yang, Cheng-Yen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Ling","familyName":"Chen","name":"Chen, Yi-Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vibhav","familyName":"Vineet","name":"Vineet, Vibhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qin","familyName":"Cai","name":"Cai, Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenq-Neng","familyName":"Hwang","name":"Hwang, Jenq-Neng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TEMPURA: Temporal Event Masked Prediction and Understanding for Reasoning in Action"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T21:00:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:08:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-22T17:54:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-23T01:16:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding causal event relationships and achieving fine-grained temporal grounding in videos remain challenging for vision-language models (VLMs). We propose TEMPURA (Temporal Event Masked Prediction and Understanding for Reasoning in Action), a two-stage training framework that enhances the video temporal understanding of VLMs. Inspired by infilling techniques in language modeling, TEMPURA first performs masked event prediction, learning to reconstruct missing events and generate step-by-step causal explanations from dense event annotations. It then learns video segmentation and dense captioning, decomposing videos into non-overlapping events with detailed, timestamp-aligned descriptions. We train TEMPURA on VER, our large-scale dataset of 500K videos annotated with temporally aligned event descriptions and structured reasoning steps. Experiments on video temporal grounding and highlight detection benchmarks show that TEMPURA substantially improves strong base VLMs across model families and scales, confirming that combining event-level reasoning with fine-grained temporal segmentation is an effective recipe for video temporal understanding."},{"descriptionType":"Other","description":"CoLM 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01583","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:46Z","registered":"2025-05-06T02:32:48Z","published":null,"updated":"2026-09-23T02:46:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.03818","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.03818","identifiers":[{"identifier":"2505.03818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonio Valerio","familyName":"Miceli-Barone","name":"Miceli-Barone, Antonio Valerio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vaishak","familyName":"Belle","name":"Belle, Vaishak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Payani","name":"Payani, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Program Semantic Inequivalence Game with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T20:03:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-09T04:03:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-08-28T16:38:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-08-29T00:48:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-12T12:41:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-13T00:43:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) can achieve strong performance on everyday coding tasks, but they can fail on complex tasks that require non-trivial reasoning about program semantics. Finding training examples to teach LLMs to solve these tasks can be challenging.\n In this work, we explore a method to synthetically generate code reasoning training data based on a semantic inequivalence game (SInQ): a generator agent creates program variants that are semantically distinct, derived from a dataset of real-world programming tasks, while an evaluator agent has to identify input examples for which they behave differently. The agents train each other semi-adversarially, improving their ability to understand the underlying logic of code.\n We evaluated our approach on multiple code generation and understanding benchmarks, including cross-language vulnerability detection (Lu et al., 2021),, where our method improves vulnerability detection in C/C++ code despite being trained exclusively on Python code, and the challenging Python builtin identifier swap benchmark (Miceli Barone et al., 2023),, showing that whereas modern LLMs still struggle with this benchmark, our approach yields substantial improvements.\n We release the code needed to replicate the experiments, as well as the generated synthetic data, which can be used to fine-tune LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.03818","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-08T01:45:11Z","registered":"2025-05-08T01:45:12Z","published":null,"updated":"2026-08-13T02:10:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01652","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01652","identifiers":[{"identifier":"2505.01652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yucong","familyName":"Dai","name":"Dai, Yucong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Zhang","name":"Zhang, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaowei","familyName":"Hu","name":"Hu, Yaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susan","familyName":"Gauch","name":"Gauch, Susan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongkai","familyName":"Wu","name":"Wu, Yongkai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causally Fair Node Classification on Non-IID Graph Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T02:05:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:12:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-22T16:59:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T02:54:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fair machine learning seeks to identify and mitigate biases in predictions against unfavorable populations characterized by demographic attributes, such as race and gender. Recent research has extended fairness to graph data, such as social networks, but many studies neglect the causal relationships among data instances. This paper addresses a prevalent challenge in many fair machine learning research, which typically assumes independent and identically distributed (IID) data, from the causal perspective. Specifically, this work targets the circumstance where nodes with different neighborhood structures follow different causal mechanisms, violating the invariance assumptions required for classical structural causal models and do-calculus. We base our research on the Network Structural Causal Model (NSCM) framework and develop a Message Passing Variational Autoencoder for Causal Inference (MPVA) to compute interventional distributions for causally fair node classification. We establish theoretical soundness under two conditions: Decomposability and Graph Independence. These conditions formalize when causal mechanism heterogeneity can be overcome by constructing a structural representation that restores invariance and facilitates the computation of interventional distributions using do-calculus in non-IID settings. Empirical evaluations on semi-synthetic and real-world datasets demonstrate that MPVA outperforms conventional methods by effectively approximating interventional distributions and mitigating bias. Our findings demonstrate the potential of causality-based fairness in complex ML applications and motivate future work on relaxing the classic assumptions in algorithmic fairness."},{"descriptionType":"Other","description":"Accepted by TMLR: https://openreview.net/forum?id=AwptwzGld5"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01652","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:34:26Z","registered":"2025-05-06T02:34:26Z","published":null,"updated":"2026-06-23T05:30:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01595","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01595","identifiers":[{"identifier":"2505.01595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liaoyaqi","familyName":"Wang","name":"Wang, Liaoyaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengping","familyName":"Jiang","name":"Jiang, Zhengping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anqi","familyName":"Liu","name":"Liu, Anqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Van Durme","name":"Van Durme, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Always Tell Me The Odds: Fine-grained Conditional Probability Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T21:33:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:08:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-27T17:23:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T02:03:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a state-of-the-art model for fine-grained probability estimation of propositions conditioned on context. Recent advances in large language models (LLMs) have significantly enhanced their reasoning capabilities, particularly on well-defined tasks with complete information. However, LLMs continue to struggle with making accurate and well-calibrated probabilistic predictions under uncertainty or partial information. While incorporating uncertainty into model predictions often boosts performance, obtaining reliable estimates of that uncertainty remains understudied. In particular, LLM probability estimates tend to be coarse and biased towards more frequent numbers. Through a combination of human and synthetic data creation and assessment, scaling to larger models, and better supervision, we propose a set of strong and precise probability estimation models. We conduct systematic evaluations across tasks that rely on conditional probability estimation and show that our approach consistently outperforms existing fine-tuned and prompting-based methods by a large margin."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01595","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:33:05Z","registered":"2025-05-06T02:33:05Z","published":null,"updated":"2026-04-28T04:01:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.03821","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.03821","identifiers":[{"identifier":"2505.03821","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gracjan","familyName":"Góral","name":"Góral, Gracjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alicja","familyName":"Ziarko","name":"Ziarko, Alicja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piotr","familyName":"Miłoś","name":"Miłoś, Piotr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michał","familyName":"Nauman","name":"Nauman, Michał","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Wołczyk","name":"Wołczyk, Maciej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michał","familyName":"Kosiński","name":"Kosiński, Michał","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Recognition: Evaluating Visual Perspective Taking in Vision Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T00:10:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-08T00:02:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-28T12:51:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T00:34:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the ability of Vision Language Models (VLMs) to perform visual perspective taking using a new set of visual tasks inspired by established human tests. Our approach leverages carefully controlled scenes in which a single humanoid minifigure is paired with a single object. By systematically varying spatial configurations -- such as object position relative to the minifigure and the minifigure's orientation -- and using both bird's-eye and surface-level views, we created 144 unique visual tasks. Each task is paired with a series of 7 diagnostic questions designed to assess three levels of visual cognition: scene understanding, spatial reasoning, and visual perspective taking. We evaluate several high-performing models, including Gemini Robotics-ER 1.5, Llama-3.2-11B-Vision-Instruct, and variants of Claude Sonnet, GPT-4, and Qwen3, and find that while they excel at scene understanding, performance declines markedly on spatial reasoning and deteriorates further on perspective taking. Our analysis suggests a gap between surface-level object recognition and the deeper spatial and perspective reasoning required for complex visual tasks, pointing to the need for integrating explicit geometric representations and tailored training protocols in future VLM development."},{"descriptionType":"Other","description":"Accepted at CVPR 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.03821","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":1,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-08T01:45:15Z","registered":"2025-05-08T01:45:16Z","published":null,"updated":"2026-03-31T03:57:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01399","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01399","identifiers":[{"identifier":"2505.01399","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Noah","familyName":"Trupin","name":"Trupin, Noah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixing","familyName":"Wang","name":"Wang, Zixing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed H.","familyName":"Qureshi","name":"Qureshi, Ahmed H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-Conditioned Grasping for Stable Tool Use"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T17:20:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-05T00:48:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-02T13:18:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-03T00:46:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-10T17:09:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-11T01:13:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tool use often fails not because robots misidentify tools, but because grasps cannot withstand task-induced wrench. Existing vision-language manipulation systems ground tools and contact regions from language yet select grasps under quasi-static or geometry-only assumptions. During interaction, inertial impulse and lever-arm amplification generate wrist torque and tangential loads that trigger slip and rotation. We introduce inverse Tool-use Planning (iTuP), which selects grasps by minimizing predicted interaction wrench along a task-conditioned trajectory. From rigid-body mechanics, we derive torque, slip, and alignment penalties, and train a Stable Dynamic Grasp Network (SDG-Net) to approximate these trajectory-conditioned costs for real-time scoring. Across hammering, sweeping, knocking, and reaching in simulation and on hardware, SDG-Net suppresses induced torque up to 17.6%, shifts grasps below empirically observed instability thresholds, and improves real-world success by 17.5% over a compositional baseline. Improvements concentrate where wrench amplification dominates, showing that robot tool use requires wrench-aware grasp selection, not perception alone."},{"descriptionType":"Other","description":"In submission and under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01399","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-05T01:41:03Z","registered":"2025-05-05T01:41:04Z","published":null,"updated":"2026-03-11T02:30:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01618","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01618","identifiers":[{"identifier":"2505.01618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nolan","familyName":"Dey","name":"Dey, Nolan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin Claire","familyName":"Zhang","name":"Zhang, Bin Claire","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Noci","name":"Noci, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mufan","familyName":"Li","name":"Li, Mufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blake","familyName":"Bordelon","name":"Bordelon, Blake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Bergsma","name":"Bergsma, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cengiz","familyName":"Pehlevan","name":"Pehlevan, Cengiz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boris","familyName":"Hanin","name":"Hanin, Boris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Hestness","name":"Hestness, Joel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Don't be lazy: CompleteP enables compute-efficient deep transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T22:45:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:10:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-14T17:09:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-15T00:47:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-22T21:28:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-24T00:09:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-19T19:50:08Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-21T02:43:14Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study compute efficiency of LLM training when using different parameterizations, i.e., rules for adjusting model and optimizer hyperparameters (HPs) as model size changes. Some parameterizations fail to transfer optimal base HPs (such as learning rate) across changes in model depth, requiring practitioners to either re-tune these HPs as they scale up (expensive), or accept sub-optimal training when re-tuning is prohibitive. Even when they achieve HP transfer, we develop theory to show parameterizations may still exist in the lazy learning regime where layers learn only features close to their linearization, preventing effective use of depth and nonlinearity. Finally, we identify and adopt the parameterization we call CompleteP that achieves both depth-wise HP transfer and non-lazy learning in all layers. CompleteP enables a wider range of model width/depth ratios to remain compute-efficient, unlocking shapes better suited for different hardware settings and operational contexts. Moreover, CompleteP enables 12-34% compute efficiency improvements over the prior state-of-the-art. All experiments were run on Cerebras CS-3 systems. A minimal implementation is available at https://github.com/EleutherAI/nanoGPT-mup/tree/completep."},{"descriptionType":"Other","description":"NeurIPS 2025. v4 fixes Table 1 typo to match AdamW eps to Equation 40"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01618","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:33:37Z","registered":"2025-05-06T02:33:37Z","published":null,"updated":"2026-01-21T05:57:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01592","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01592","identifiers":[{"identifier":"2505.01592","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Takyoung","familyName":"Kim","name":"Kim, Takyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Janvijay","familyName":"Singh","name":"Singh, Janvijay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhaib","familyName":"Mehri","name":"Mehri, Shuhaib","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emre Can","familyName":"Acikgoz","name":"Acikgoz, Emre Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sagnik","familyName":"Mukherjee","name":"Mukherjee, Sagnik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nimet Beyza","familyName":"Bozdag","name":"Bozdag, Nimet Beyza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sumuk","familyName":"Shashidhar","name":"Shashidhar, Sumuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gokhan","familyName":"Tur","name":"Tur, Gokhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dilek","familyName":"Hakkani-Tür","name":"Hakkani-Tür, Dilek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AURA: A Diagnostic Framework for Tracking User Satisfaction of Interactive Planning Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T21:27:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:08:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-05T03:00:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-08T01:13:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing capabilities of large language models (LLMs) in instruction-following and context-understanding lead to the era of agents with numerous applications. Among these, task planning agents have become especially prominent in realistic scenarios involving complex internal pipelines, such as context understanding, tool management, and response generation. However, existing benchmarks predominantly evaluate agent performance based on task completion as a proxy for overall effectiveness. We hypothesize that merely improving task completion is misaligned with maximizing user satisfaction, as users interact with the entire agentic process and not only the end result. To address this gap, we propose AURA, an Agent-User inteRaction Assessment framework that conceptualizes the behavioral stages of interactive task planning agents. AURA offers a comprehensive assessment of agent through a set of atomic LLM evaluation criteria, allowing researchers and practitioners to diagnose specific strengths and weaknesses within the agent's decision-making pipeline. Our analyses show that agents excel in different behavioral stages, with user satisfaction shaped by both outcomes and intermediate behaviors. We also highlight future directions, including systems that leverage multiple agents and the limitations of user simulators in task planning."},{"descriptionType":"Other","description":"NeurIPS 2025 MTI-LLM Workshop. Full version is under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01592","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:33:00Z","registered":"2025-05-06T02:33:01Z","published":null,"updated":"2025-12-08T02:44:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01406","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01406","identifiers":[{"identifier":"2505.01406","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammadreza","familyName":"Teymoorianfard","name":"Teymoorianfard, Mohammadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddarth","familyName":"Sitaraman","name":"Sitaraman, Siddarth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqing","familyName":"Ma","name":"Ma, Shiqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Houmansadr","name":"Houmansadr, Amir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VIDSTAMP: A Temporally-Aware Watermark for Ownership and Integrity in Video Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T17:35:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-05T00:48:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-19T23:24:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-21T01:10:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video diffusion models can generate realistic and temporally consistent videos. This raises concerns about provenance, ownership, and integrity. Watermarking can help address these issues by embedding metadata directly into the content. To work well, a watermark needs enough capacity for meaningful metadata. It must also stay imperceptible and remain robust to common video manipulations. Existing methods struggle with limited capacity, extra inference cost, or reduced visual quality. We introduce VidStamp, a watermarking framework that embeds frame-level messages through the decoder of a latent video diffusion model. The decoder is fine-tuned in two stages. The first stage uses static image datasets to encourage spatial message separation. The second stage uses synthesized video sequences to restore temporal consistency. This approach enables high-capacity watermarks with minimal perceptual impact. VidStamp also supports dynamic watermarking through a control signal that selects message templates during inference. This adds flexibility and creates a second channel for communication. We evaluate VidStamp on Stable Video Diffusion (I2V), OpenSora, and Wan (T2V). The system embeds 48 bits per frame while preserving visual quality and staying robust to common distortions. Compared with VideoSeal, VideoShield, and RivaGAN, it achieves lower log P-values and stronger detectability. Its frame-wise watermarking design also enables precise temporal tamper localization, with an accuracy of 0.96, which exceeds the VideoShield baseline. Code: https://github.com/SPIN-UMass/VidStamp"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01406","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-05T01:41:14Z","registered":"2025-05-05T01:41:14Z","published":null,"updated":"2025-11-21T02:59:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01812","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01812","identifiers":[{"identifier":"2505.01812","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Core Francisco","familyName":"Park","name":"Park, Core Francisco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zechen","familyName":"Zhang","name":"Zhang, Zechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hidenori","familyName":"Tanaka","name":"Tanaka, Hidenori","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$\\textit{New News}$: System-2 Fine-tuning for Robust Integration of New Knowledge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T12:49:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:25:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-27T21:44:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T00:48:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-14T15:58:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-17T01:53:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Humans and intelligent animals can internalize new information and accurately internalize their implications to perform downstream tasks. While large language models (LLMs) can achieve this through in-context learning (ICL) when the information (news) is explicitly given as context, adequately integrating the information into model weights via fine-tuning remains challenging. In this paper, we introduce New News, a dataset composed of hypothetical yet plausible news spanning multiple domains (mathematics, coding, discoveries, leaderboards, events), accompanied by downstream evaluation questions whose correct answers critically depend on understanding and internalizing the news. First, we demonstrate a substantial gap between naive fine-tuning and in-context learning (FT-ICL gap) on our dataset. To address this gap, we explore a suite of self-play data generation protocols -- paraphrases, implications, and Self-QA -- designed to distill the knowledge processed by the model with context into the weights of the model, which we term System-2 Fine-tuning (Sys2-FT). We systematically evaluate ICL and Sys2-FT performance across data domains and model scales with the Qwen 2.5 family of models. Our results demonstrate that the Self-QA protocol of Sys2-FT significantly improves models' in-weight learning of the news while preserving general capabilities. Furthermore, we discover the contextual shadowing effect, where training with the news in context followed by its rephrases or QAs catastrophically degrades learning of the news. Finally, we show preliminary evidence of an emerging scaling law of Sys2-FT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01812","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:38:14Z","registered":"2025-05-06T02:38:15Z","published":null,"updated":"2025-11-17T03:01:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01386","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01386","identifiers":[{"identifier":"2505.01386","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Irene","familyName":"Wang","name":"Wang, Irene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Newsha","familyName":"Ardalani","name":"Ardalani, Newsha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mostafa","familyName":"Elhoushi","name":"Elhoushi, Mostafa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Jiang","name":"Jiang, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Hsia","name":"Hsia, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ekin","familyName":"Sumbul","name":"Sumbul, Ekin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divya","familyName":"Mahajan","name":"Mahajan, Divya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carole-Jean","familyName":"Wu","name":"Wu, Carole-Jean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bilge","familyName":"Acun","name":"Acun, Bilge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CATransformers: Carbon Aware Transformers Through Joint Model-Hardware Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T16:49:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-05T00:47:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-08T22:21:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-12T00:10:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-22T11:03:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-23T00:39:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-11T18:06:52Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-11-12T02:03:11Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning solutions are rapidly adopted to enable a variety of key use cases, from conversational AI assistants to scientific discovery. This growing adoption is expected to increase the associated lifecycle carbon footprint, including both \\emph{operational carbon} from training and inference and \\emph{embodied carbon} from AI hardware manufacturing. We introduce \\ourframework -- the first carbon-aware co-optimization framework for Transformer-based models and hardware accelerators. By integrating both operational and embodied carbon into early-stage design space exploration, \\ourframework enables sustainability-driven model architecture and hardware accelerator co-design that reveals fundamentally different trade-offs than latency- or energy-centric approaches. Evaluated across a range of Transformer models, \\ourframework consistently demonstrates the potential to reduce total carbon emissions -- by up to 30\\% -- while maintaining accuracy and latency. We further highlight its extensibility through a focused case study on multi-modal models. Our results emphasize the need for holistic optimization methods that prioritize carbon efficiency without compromising model capability and execution time performance. The source code of \\ourframework is available at {\\small{\\href{https://github.com/facebookresearch/CATransformers}{\\texttt{https://github.com/facebookresearch/CATransformers}}}}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01386","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-05T01:40:44Z","registered":"2025-05-05T01:40:45Z","published":null,"updated":"2025-11-12T03:18:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.03824","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.03824","identifiers":[{"identifier":"2505.03824","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiarui","familyName":"Chen","name":"Chen, Jiarui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory Assisted LLM for Personalized Recommendation System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T06:24:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-08T00:02:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T09:18:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T02:24:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated significant potential in solving recommendation tasks. With proven capabilities in understanding user preferences, LLM personalization has emerged as a critical area for providing tailored responses to individuals. Current studies explore personalization through prompt design and fine-tuning, paving the way for further research in personalized LLMs. However, existing approaches are either costly and inefficient in capturing diverse user preferences or fail to account for timely updates to user history. To address these gaps, we propose the Memory-Assisted Personalized LLM (MAP). Through user interactions, we first create a history profile for each user, capturing their preferences, such as ratings for historical items. During recommendation, we extract relevant memory based on similarity, which is then incorporated into the prompts to enhance personalized recommendations. In our experiments, we define a new task that enables testing with varying memory size under two scenarios: single domain where memory and tasks are from the same category and cross-domain (e.g. memory from movies and recommendation tasks in books). The results show that MAP outperforms regular LLM-based recommenders that integrate user history directly through prompt design. Moreover, as user history grows, MAP's advantage increases in both scenarios, making it more suitable for addressing successive personalized user requests."},{"descriptionType":"Other","description":"8 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.03824","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-08T01:45:20Z","registered":"2025-05-08T01:45:20Z","published":null,"updated":"2025-11-04T04:49:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01603","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01603","identifiers":[{"identifier":"2505.01603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tom","familyName":"Kuchler","name":"Kuchler, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pinghe","familyName":"Li","name":"Li, Pinghe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhuo","familyName":"Zhang","name":"Zhang, Yazhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lazar","familyName":"Cvetković","name":"Cvetković, Lazar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boris","familyName":"Goranov","name":"Goranov, Boris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Stocker","name":"Stocker, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leon","familyName":"Thomm","name":"Thomm, Leon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Kalbermatter","name":"Kalbermatter, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tim","familyName":"Notter","name":"Notter, Tim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Lattuada","name":"Lattuada, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana","familyName":"Klimovic","name":"Klimovic, Ana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unlocking True Elasticity for the Cloud-Native Era with Dandelion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Operating Systems (cs.OS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T21:53:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:09:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-27T15:18:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T01:49:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3731569.3764803","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Elasticity is fundamental to cloud computing, as it enables quickly allocating resources to match the demand of each workload as it arrives, rather than pre-provisioning resources to meet performance objectives. However, even serverless platforms -- which boot sandboxes in 10s to 100s of milliseconds -- are not sufficiently elastic to avoid over-provisioning expensive resources. Today's FaaS platforms rely on pre-provisioning many idle sandboxes in memory to reduce the occurrence of slow, cold starts. A key obstacle for high elasticity is booting a guest OS and configuring features like networking in sandboxes, which are required to expose an isolated POSIX-like interface to user functions. Our key insight is that redesigning the interface for applications in the cloud-native era enables co-designing a much more efficient and elastic execution system. Now is a good time to rethink cloud abstractions as developers are building applications to be cloud-native. Cloud-native applications typically consist of user-provided compute logic interacting with cloud services (for storage, AI inference, query processing, etc) exposed over REST APIs. Hence, we propose Dandelion, an elastic cloud platform with a declarative programming model that expresses applications as DAGs of pure compute functions and higher-level communication functions. Dandelion can securely execute untrusted user compute functions in lightweight sandboxes that cold start in hundreds of microseconds, since pure functions do not rely on extra software environments such as a guest OS. Dandelion makes it practical to boot a sandbox on-demand for each request, decreasing performance variability by two to three orders of magnitude compared to Firecracker and reducing committed memory by 96% on average when running the Azure Functions trace."},{"descriptionType":"Other","description":"13 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01603","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-05-06T02:33:16Z","registered":"2025-05-06T02:33:17Z","published":null,"updated":"2025-10-28T03:54:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01616","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01616","identifiers":[{"identifier":"2505.01616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianxing","familyName":"Qin","name":"Qin, Jianxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingrong","familyName":"Chen","name":"Chen, Jingrong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinhao","familyName":"Kong","name":"Kong, Xinhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongji","familyName":"Wu","name":"Wu, Yongji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianjun","familyName":"Yuan","name":"Yuan, Tianjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Luo","name":"Luo, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaodong","familyName":"Wang","name":"Wang, Zhaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Zhang","name":"Zhang, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingjun","familyName":"Chen","name":"Chen, Tingjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alvin R.","familyName":"Lebeck","name":"Lebeck, Alvin R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danyang","familyName":"Zhuo","name":"Zhuo, Danyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Phantora: Maximizing Code Reuse in Simulation-based Machine Learning System Performance Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Performance (cs.PF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T22:36:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:10:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T14:01:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:55:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-09T15:58:43Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-10T01:05:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern machine learning (ML) training workloads place substantial demands on both computational and communication resources. Consequently, accurate performance estimation has become increasingly critical for guiding system design decisions, such as the selection of parallelization strategies, cluster configurations, and hardware provisioning. Existing simulation-based performance estimation requires reimplementing the ML framework in a simulator, which demands significant manual effort and is hard to maintain as ML frameworks evolve rapidly.\n This paper introduces Phantora, a hybrid GPU cluster simulator designed for performance estimation of ML training workloads. Phantora executes unmodified ML frameworks as is within a distributed, containerized environment. Each container emulates the behavior of a GPU server in a large-scale cluster, while Phantora intercepts and simulates GPU- and communication-related operations to provide high-fidelity performance estimation. We call this approach hybrid simulation of ML systems, in contrast to traditional methods that simulate static workloads. The primary advantage of hybrid simulation is that it allows direct reuse of ML framework source code in simulation, avoiding the need for reimplementation. Our evaluation shows that Phantora provides accuracy comparable to static workload simulation while supporting three state-of-the-art LLM training frameworks out-of-the-box. In addition, Phantora operates on a single GPU, eliminating the need for the resource-intensive trace collection and workload extraction steps required by traditional trace-based simulators. Phantora is open-sourced at https://github.com/QDelta/Phantora."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01616","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:33:34Z","registered":"2025-05-06T02:33:34Z","published":null,"updated":"2025-10-10T02:33:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01761","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01761","identifiers":[{"identifier":"2505.01761","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tobias","familyName":"Domhan","name":"Domhan, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Zhu","name":"Zhu, Dawei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Same evaluation, more tokens: On the effect of input length for machine translation evaluation using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T09:30:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:21:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T08:40:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:28:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurately evaluating machine-translated text remains a long-standing challenge, particularly for long documents. Recent work has shown that large language models (LLMs) can serve as reliable and interpretable sentence-level translation evaluators via MQM error span annotations. With modern LLMs supporting larger context windows, a natural question arises: can we feed entire document translations into an LLM for quality assessment? Ideally, evaluation should be invariant to text length, producing consistent error spans regardless of input granularity. However, our analysis shows that text length significantly impacts evaluation: longer texts lead to fewer error spans and reduced system ranking accuracy. To address this limitation, we evaluate several strategies, including granularity-aligned prompting, Focus Sentence Prompting (FSP), and a fine-tuning approach to better align LLMs with the evaluation task. The latter two methods largely mitigate this length bias, making LLMs more reliable for long-form translation evaluation."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 (Main Conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01761","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:37:02Z","registered":"2025-05-06T02:37:03Z","published":null,"updated":"2025-10-06T02:02:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01657","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01657","identifiers":[{"identifier":"2505.01657","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Run","familyName":"Ling","name":"Ling, Run","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenji","familyName":"Wang","name":"Wang, Wenji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Liu","name":"Liu, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guibing","familyName":"Guo","name":"Guo, Guibing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haowei","familyName":"Liu","name":"Liu, Haowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Lu","name":"Lu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanwei","familyName":"Zhang","name":"Zhang, Quanwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yexing","familyName":"Xu","name":"Xu, Yexing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Lu","name":"Lu, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Wang","name":"Wang, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihua","familyName":"Shao","name":"Shao, Yihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhanjie","familyName":"Zhang","name":"Zhang, Zhanjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Ma","name":"Ma, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linying","familyName":"Jiang","name":"Jiang, Linying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingwei","familyName":"Wang","name":"Wang, Xingwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAGAR: Retrieval Augmented Personalized Image Generation Guided by Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T02:20:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:13:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-08-13T15:02:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-08-14T00:45:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Personalized image generation is crucial for improving the user experience, as it renders reference images into preferred ones according to user visual preferences. Although effective, existing methods face two main issues. First, existing methods treat all items in the user historical sequence equally when extracting user preferences, overlooking the varying semantic similarities between historical items and the reference item. Disproportionately high weights for low-similarity items distort users' visual preferences for the reference item. Second, existing methods heavily rely on consistency between generated and reference images to optimize the generation, which leads to underfitting user preferences and hinders personalization. To address these issues, we propose Retrieval Augment Personalized Image GenerAtion guided by Recommendation (RAGAR). Our approach uses a retrieval mechanism to assign different weights to historical items according to their similarities to the reference item, thereby extracting more refined users' visual preferences for the reference item. Then we introduce a novel rank task based on the multi-modal ranking model to optimize the personalization of the generated images instead of forcing depend on consistency. Extensive experiments and human evaluations on three real-world datasets demonstrate that RAGAR achieves significant improvements in both personalization and semantic metrics compared to five baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01657","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:34:32Z","registered":"2025-05-06T02:34:33Z","published":null,"updated":"2025-08-14T01:57:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01482","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01482","identifiers":[{"identifier":"2505.01482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alice","familyName":"Rueda","name":"Rueda, Alice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed S.","familyName":"Hassan","name":"Hassan, Mohammed S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Argyrios","familyName":"Perivolaris","name":"Perivolaris, Argyrios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bazen G.","familyName":"Teferra","name":"Teferra, Bazen G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reza","familyName":"Samavi","name":"Samavi, Reza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirisha","familyName":"Rambhatla","name":"Rambhatla, Sirisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Wu","name":"Wu, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanbo","familyName":"Zhang","name":"Zhang, Yanbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Cao","name":"Cao, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divya","familyName":"Sharma","name":"Sharma, Divya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sridhar","familyName":"Krishnan","name":"Krishnan, Sridhar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkat","familyName":"Bhat","name":"Bhat, Venkat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding LLM Scientific Reasoning through Promptings and Model's Explanation on the Answers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T16:16:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:02:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-07-25T15:43:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-07-28T00:43:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated remarkable capabilities in natural language understanding, reasoning, and problem-solving across various domains. However, their ability to perform complex, multi-step reasoning task-essential for applications in science, medicine, and law-remains an area of active investigation. This paper examines the reasoning capabilities of contemporary LLMs, analyzing their strengths, limitations, and potential for improvement. The study uses prompt engineering techniques on the Graduate-Level GoogleProof Q\u0026amp;A (GPQA) dataset to assess the scientific reasoning of GPT-4o. Five popular prompt engineering techniques and two tailored promptings were tested: baseline direct answer (zero-shot), chain-of-thought (CoT), zero-shot CoT, self-ask, self-consistency, decomposition, and multipath promptings. Our findings indicate that while LLMs exhibit emergent reasoning abilities, they often rely on pattern recognition rather than true logical inference, leading to inconsistencies in complex problem-solving. The results indicated that self-consistency outperformed the other prompt engineering technique with an accuracy of 52.99%, followed by direct answer (52.23%). Zero-shot CoT (50%) outperformed multipath (48.44%), decomposition (47.77%), self-ask (46.88%), and CoT (43.75%). Self-consistency performed the second worst in explaining the answers. Simple techniques such as direct answer, CoT, and zero-shot CoT have the best scientific reasoning. We propose a research agenda aimed at bridging these gaps by integrating structured reasoning frameworks, hybrid AI approaches, and human-in-the-loop methodologies. By critically evaluating the reasoning mechanisms of LLMs, this paper contributes to the ongoing discourse on the future of artificial general intelligence and the development of more robust, trustworthy AI systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01482","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:30:18Z","registered":"2025-05-06T02:30:18Z","published":null,"updated":"2025-07-28T01:42:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01709","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01709","identifiers":[{"identifier":"2505.01709","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaidong","familyName":"Zhang","name":"Zhang, Kaidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongtao","familyName":"Xu","name":"Xu, Rongtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengzhen","familyName":"Ren","name":"Ren, Pengzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfan","familyName":"Lin","name":"Lin, Junfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hefeng","familyName":"Wu","name":"Wu, Hefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Lin","name":"Lin, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodan","familyName":"Liang","name":"Liang, Xiaodan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RoBridge: A Hierarchical Architecture Bridging Cognition and Execution for General Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T06:17:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:16:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-07T08:37:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-08T00:33:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-07-23T07:22:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-07-24T00:23:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Operating robots in open-ended scenarios with diverse tasks is a crucial research and application direction in robotics. While recent progress in natural language processing and large multimodal models has enhanced robots' ability to understand complex instructions, robot manipulation still faces the procedural skill dilemma and the declarative skill dilemma in open environments. Existing methods often compromise cognitive and executive capabilities. To address these challenges, in this paper, we propose RoBridge, a hierarchical intelligent architecture for general robotic manipulation. It consists of a high-level cognitive planner (HCP) based on a large-scale pre-trained vision-language model (VLM), an invariant operable representation (IOR) serving as a symbolic bridge, and a generalist embodied agent (GEA). RoBridge maintains the declarative skill of VLM and unleashes the procedural skill of reinforcement learning, effectively bridging the gap between cognition and execution. RoBridge demonstrates significant performance improvements over existing baselines, achieving a 75% success rate on new tasks and an 83% average success rate in sim-to-real generalization using only five real-world data samples per task. This work represents a significant step towards integrating cognitive reasoning with physical execution in robotic systems, offering a new paradigm for general robotic manipulation."},{"descriptionType":"Other","description":"project page: https://abliao.github.io/RoBridge/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01709","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:35:47Z","registered":"2025-05-06T02:35:48Z","published":null,"updated":"2025-07-24T01:57:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01729","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01729","identifiers":[{"identifier":"2505.01729","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bu","familyName":"Jin","name":"Jin, Bu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weize","familyName":"Li","name":"Li, Weize","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baihan","familyName":"Yang","name":"Yang, Baihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenxin","familyName":"Zhu","name":"Zhu, Zhenxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junpeng","familyName":"Jiang","name":"Jiang, Junpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan-ang","familyName":"Gao","name":"Gao, Huan-ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Sun","name":"Sun, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Zhan","name":"Zhan, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengtong","familyName":"Hu","name":"Hu, Hengtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyang","familyName":"Zhang","name":"Zhang, Xueyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Jia","name":"Jia, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhao","name":"Zhao, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PosePilot: Steering Camera Pose for Generative World Models with Self-supervised Depth"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T07:51:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:19:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-07-18T07:43:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-07-21T00:21:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in autonomous driving (AD) systems have highlighted the potential of world models in achieving robust and generalizable performance across both ordinary and challenging driving conditions. However, a key challenge remains: precise and flexible camera pose control, which is crucial for accurate viewpoint transformation and realistic simulation of scene dynamics. In this paper, we introduce PosePilot, a lightweight yet powerful framework that significantly enhances camera pose controllability in generative world models. Drawing inspiration from self-supervised depth estimation, PosePilot leverages structure-from-motion principles to establish a tight coupling between camera pose and video generation. Specifically, we incorporate self-supervised depth and pose readouts, allowing the model to infer depth and relative camera motion directly from video sequences. These outputs drive pose-aware frame warping, guided by a photometric warping loss that enforces geometric consistency across synthesized frames. To further refine camera pose estimation, we introduce a reverse warping step and a pose regression loss, improving viewpoint precision and adaptability. Extensive experiments on autonomous driving and general-domain video datasets demonstrate that PosePilot significantly enhances structural understanding and motion reasoning in both diffusion-based and auto-regressive world models. By steering camera pose with self-supervised depth, PosePilot sets a new benchmark for pose controllability, enabling physically consistent, reliable viewpoint synthesis in generative world models."},{"descriptionType":"Other","description":"Accepted at IEEE/RSJ IROS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01729","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:36:16Z","registered":"2025-05-06T02:36:16Z","published":null,"updated":"2025-07-21T01:42:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.02862","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.02862","identifiers":[{"identifier":"2505.02862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoming","familyName":"Yang","name":"Yang, Haoming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Ma","name":"Ma, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Jia","name":"Jia, Xiaojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingfei","familyName":"Sun","name":"Sun, Yingfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianqian","familyName":"Xu","name":"Xu, Qianqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingming","familyName":"Huang","name":"Huang, Qingming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cannot See the Forest for the Trees: Invoking Heuristics and Biases to Elicit Irrational Choices of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T05:28:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-07T00:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-06-03T14:46:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-06-04T01:03:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-06-27T08:31:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-06-30T00:26:51Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the remarkable performance of Large Language Models (LLMs), they remain vulnerable to jailbreak attacks, which can compromise their safety mechanisms. Existing studies often rely on brute-force optimization or manual design, failing to uncover potential risks in real-world scenarios. To address this, we propose a novel jailbreak attack framework, ICRT, inspired by heuristics and biases in human cognition. Leveraging the simplicity effect, we employ cognitive decomposition to reduce the complexity of malicious prompts. Simultaneously, relevance bias is utilized to reorganize prompts, enhancing semantic alignment and inducing harmful outputs effectively. Furthermore, we introduce a ranking-based harmfulness evaluation metric that surpasses the traditional binary success-or-failure paradigm by employing ranking aggregation methods such as Elo, HodgeRank, and Rank Centrality to comprehensively quantify the harmfulness of generated content. Experimental results show that our approach consistently bypasses mainstream LLMs' safety mechanisms and generates high-risk content, providing insights into jailbreak attack risks and contributing to stronger defense strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.02862","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-07T01:46:24Z","registered":"2025-05-07T01:46:24Z","published":null,"updated":"2025-06-30T01:49:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01484","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01484","identifiers":[{"identifier":"2505.01484","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pedro","familyName":"Abdalla","name":"Abdalla, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roman","familyName":"Vershynin","name":"Vershynin, Roman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Watermarking Using Mixtures and Statistical-to-Computational Gaps"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T16:36:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:02:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-06-24T18:37:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-06-26T00:03:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Given a text, can we determine whether it was generated by a large language model (LLM) or by a human? A widely studied approach to this problem is watermarking. We propose an undetectable and elementary watermarking scheme in the closed setting. Also, in the harder open setting, where the adversary has access to most of the model, we propose an unremovable watermarking scheme."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01484","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:30:20Z","registered":"2025-05-06T02:30:21Z","published":null,"updated":"2025-06-26T02:00:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01660","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01660","identifiers":[{"identifier":"2505.01660","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sicong","familyName":"Li","name":"Li, Sicong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianqian","familyName":"Xu","name":"Xu, Qianqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyong","familyName":"Yang","name":"Yang, Zhiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitai","familyName":"Wang","name":"Wang, Zitai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linchao","familyName":"Zhang","name":"Zhang, Linchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaochun","familyName":"Cao","name":"Cao, Xiaochun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingming","familyName":"Huang","name":"Huang, Qingming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Focal-SAM: Focal Sharpness-Aware Minimization for Long-Tailed Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T03:01:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:14:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-06-03T11:43:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-06-04T00:51:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world datasets often follow a long-tailed distribution, making generalization to tail classes difficult. Recent methods resorted to long-tail variants of Sharpness-Aware Minimization (SAM), such as ImbSAM and CC-SAM, to improve generalization by flattening the loss landscape. However, these attempts face a trade-off between computational efficiency and control over the loss landscape. On the one hand, ImbSAM is efficient but offers only coarse control as it excludes head classes from the SAM process. On the other hand, CC-SAM provides fine-grained control through class-dependent perturbations but at the cost of efficiency due to multiple backpropagations. Seeing this dilemma, we introduce Focal-SAM, which assigns different penalties to class-wise sharpness, achieving fine-grained control without extra backpropagations, thus maintaining efficiency. Furthermore, we theoretically analyze Focal-SAM's generalization ability and derive a sharper generalization bound. Extensive experiments on both traditional and foundation models validate the effectiveness of Focal-SAM."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01660","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:34:36Z","registered":"2025-05-06T02:34:37Z","published":null,"updated":"2025-06-04T02:35:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.02865","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.02865","identifiers":[{"identifier":"2505.02865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhihai","familyName":"Wang","name":"Wang, Zhihai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Wang","name":"Wang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jilai","familyName":"Pan","name":"Pan, Jilai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xilin","familyName":"Xia","name":"Xia, Xilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiling","familyName":"Zhen","name":"Zhen, Huiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingxuan","familyName":"Yuan","name":"Yuan, Mingxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianye","familyName":"Hao","name":"Hao, Jianye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Wu","name":"Wu, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Large Language Model Reasoning via Speculative Search"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T12:14:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-07T00:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-24T01:49:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-27T00:15:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Tree-search-based reasoning methods have significantly enhanced the reasoning capability of large language models (LLMs) by facilitating the exploration of multiple intermediate reasoning steps, i.e., thoughts. However, these methods suffer from substantial inference latency, as they have to generate numerous reasoning thoughts, severely limiting LLM applicability. To address this challenge, we propose a novel Speculative Search (SpecSearch) framework that significantly accelerates LLM reasoning by optimizing thought generation. Specifically, SpecSearch utilizes a small model to strategically collaborate with a large model at both thought and token levels, efficiently generating high-quality reasoning thoughts. The major pillar of SpecSearch is a novel quality-preserving rejection mechanism, which effectively filters out thoughts whose quality falls below that of the large model's outputs. Moreover, we show that SpecSearch preserves comparable reasoning quality to the large model. Experiments on both the Qwen and Llama models demonstrate that SpecSearch significantly outperforms state-of-the-art approaches, achieving up to 2.12$\\times$ speedup with comparable reasoning quality."},{"descriptionType":"Other","description":"Accepted by ICML2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.02865","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-07T01:46:29Z","registered":"2025-05-07T01:46:30Z","published":null,"updated":"2025-05-27T04:23:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01731","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01731","identifiers":[{"identifier":"2505.01731","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuan","familyName":"Sun","name":"Sun, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Yu","name":"Yu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhen","familyName":"Cui","name":"Cui, Lizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxiao","familyName":"Li","name":"Li, Xiaoxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Shapley Value-based Non-Uniform Pruning of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T07:57:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:19:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-13T02:13:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-14T00:17:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05-21T01:38:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-05-22T00:16:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pruning large language models (LLMs) is a promising solution for reducing model sizes and computational complexity while preserving performance. Traditional layer-wise pruning methods often adopt a uniform sparsity approach across all layers, which leads to suboptimal performance due to the varying significance of individual transformer layers within the model not being accounted for. To this end, we propose the Shapley Value-based Non-Uniform Pruning (SV-NUP) method for LLMs. This approach quantifies the contribution of each transformer layer to the overall model performance, enabling the assignment of tailored pruning budgets to different layers to retain critical parameters. To further improve efficiency, we design the Sliding Window-based Shapley Value approximation method. It substantially reduces computational overhead compared to exact SV calculation methods. Extensive experiments on various LLMs including LLaMA-v1, LLaMA-v2 and OPT demonstrate the effectiveness of the proposed approach. The results reveal that non-uniform pruning significantly enhances the performance of pruned models. Notably, SV-NUP achieves a reduction in perplexity (PPL) of 18.01% and 19.55% on LLaMA-7B and LLaMA-13B, respectively, compared to SparseGPT at 70% sparsity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01731","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:36:18Z","registered":"2025-05-06T02:36:19Z","published":null,"updated":"2025-05-22T02:29:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01742","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01742","identifiers":[{"identifier":"2505.01742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Mao","name":"Mao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingzong","familyName":"Li","name":"Li, Jingzong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Xu","name":"Xu, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tei-Wei","familyName":"Kuo","name":"Kuo, Tei-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Guan","name":"Guan, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun Jason","familyName":"Xue","name":"Xue, Chun Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Easz: An Agile Transformer-based Image Compression Framework for Resource-constrained IoTs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T08:39:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:20:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05-14T13:02:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-05-15T00:35:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural image compression, necessary in various machine-to-machine communication scenarios, suffers from its heavy encode-decode structures and inflexibility in switching between different compression levels. Consequently, it raises significant challenges in applying the neural image compression to edge devices that are developed for powerful servers with high computational and storage capacities. We take a step to solve the challenges by proposing a new transformer-based edge-compute-free image coding framework called Easz. Easz shifts the computational overhead to the server, and hence avoids the heavy encoding and model switching overhead on the edge. Easz utilizes a patch-erase algorithm to selectively remove image contents using a conditional uniform-based sampler. The erased pixels are reconstructed on the receiver side through a transformer-based framework. To further reduce the computational overhead on the receiver, we then introduce a lightweight transformer-based reconstruction structure to reduce the reconstruction load on the receiver side. Extensive evaluations conducted on a real-world testbed demonstrate multiple advantages of Easz over existing compression approaches, in terms of adaptability to different compression levels, computational efficiency, and image reconstruction quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01742","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:36:34Z","registered":"2025-05-06T02:36:35Z","published":null,"updated":"2025-05-15T01:51:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.04637","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.04637","identifiers":[{"identifier":"2505.04637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongxing","familyName":"Yu","name":"Yu, Dongxing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Token Boundaries: Integrating Human Chunking Mechanisms into Multimodal LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T09:14:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-09T00:00:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"ScholarlyArticle","resourceTypeGeneral":"Text","citeproc":"article-journal","bibtex":"article","ris":"RPRT","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5121/csit.2025.150807","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in multimodal large language models (MLLMs) have demonstrated remarkable capabilities in processing diverse data types, yet significant disparities persist between human cognitive processes and computational approaches to multimodal information integration. This research presents a systematic investigation into the parallels between human cross-modal chunking mechanisms and token representation methodologies in MLLMs. Through empirical studies comparing human performance patterns with model behaviors across visual-linguistic tasks, we demonstrate that conventional static tokenization schemes fundamentally constrain current models' capacity to simulate the dynamic, context-sensitive nature of human information processing. We propose a novel framework for dynamic cross-modal tokenization that incorporates adaptive boundaries, hierarchical representations, and alignment mechanisms grounded in cognitive science principles. Quantitative evaluations demonstrate that our approach yields statistically significant improvements over state-of-the-art models on benchmark tasks (+7.8% on Visual Question Answering, +5.3% on Complex Scene Description) while exhibiting more human-aligned error patterns and attention distributions. These findings contribute to the theoretical understanding of the relationship between human cognition and artificial intelligence, while providing empirical evidence for developing more cognitively plausible AI systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.04637","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-05-09T01:42:15Z","registered":"2025-05-09T01:42:16Z","published":null,"updated":"2025-05-09T01:42:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.03814","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.03814","identifiers":[{"identifier":"2505.03814","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ganghua","familyName":"Wang","name":"Wang, Ganghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaorun","familyName":"Chen","name":"Chen, Zhaorun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haifeng","familyName":"Xu","name":"Xu, Haifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cer-Eval: Certifiable and Cost-Efficient Evaluation Framework for LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T17:05:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-08T00:02:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As foundation models continue to scale, the size of trained models grows exponentially, presenting significant challenges for their evaluation. Current evaluation practices involve curating increasingly large datasets to assess the performance of large language models (LLMs). However, there is a lack of systematic analysis and guidance on determining the sufficiency of test data or selecting informative samples for evaluation. This paper introduces a certifiable and cost-efficient evaluation framework for LLMs. Our framework adapts to different evaluation objectives and outputs confidence intervals that contain true values with high probability. We use ``test sample complexity'' to quantify the number of test points needed for a certifiable evaluation and derive tight bounds on test sample complexity. Based on the developed theory, we develop a partition-based algorithm, named Cer-Eval, that adaptively selects test points to minimize the cost of LLM evaluation. Real-world experiments demonstrate that Cer-Eval can save 20% to 40% test points across various benchmarks, while maintaining an estimation error level comparable to the current evaluation process and providing a 95% confidence guarantee."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.03814","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-08T01:45:06Z","registered":"2025-05-08T01:45:07Z","published":null,"updated":"2025-05-08T01:45:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.02858","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.02858","identifiers":[{"identifier":"2505.02858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henry","familyName":"Tari","name":"Tari, Henry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nojus","familyName":"Sereiva","name":"Sereiva, Nojus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rishabh","familyName":"Kaushal","name":"Kaushal, Rishabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thales","familyName":"Bertaglia","name":"Bertaglia, Thales","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adriana","familyName":"Iamnitchi","name":"Iamnitchi, Adriana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards High-Fidelity Synthetic Multi-platform Social Media Datasets via Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T18:56:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-07T00:00:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Social media datasets are essential for research on a variety of topics, such as disinformation, influence operations, hate speech detection, or influencer marketing practices. However, access to social media datasets is often constrained due to costs and platform restrictions. Acquiring datasets that span multiple platforms, which is crucial for understanding the digital ecosystem, is particularly challenging. This paper explores the potential of large language models to create lexically and semantically relevant social media datasets across multiple platforms, aiming to match the quality of real data. We propose multi-platform topic-based prompting and employ various language models to generate synthetic data from two real datasets, each consisting of posts from three different social media platforms. We assess the lexical and semantic properties of the synthetic data and compare them with those of the real data. Our empirical findings show that using large language models to generate synthetic multi-platform social media data is promising, different language models perform differently in terms of fidelity, and a post-processing approach might be needed for generating high-fidelity synthetic datasets for research. In addition to the empirical evaluation of three state of the art large language models, our contributions include new fidelity metrics specific to multi-platform social media datasets."},{"descriptionType":"Other","description":"arXiv admin note: text overlap with arXiv:2407.08323"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.02858","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-07T01:46:18Z","registered":"2025-05-07T01:46:19Z","published":null,"updated":"2025-05-07T01:46:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01822","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01822","identifiers":[{"identifier":"2505.01822","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jifeng","familyName":"Hu","name":"Hu, Jifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sili","familyName":"Huang","name":"Huang, Sili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhejian","familyName":"Yang","name":"Yang, Zhejian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengchao","familyName":"Hu","name":"Hu, Shengchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Shen","name":"Shen, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hechang","familyName":"Chen","name":"Chen, Hechang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichao","familyName":"Sun","name":"Sun, Lichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Chang","name":"Chang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dacheng","familyName":"Tao","name":"Tao, Dacheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analytic Energy-Guided Policy Optimization for Offline Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T14:00:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:26:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Conditional decision generation with diffusion models has shown powerful competitiveness in reinforcement learning (RL). Recent studies reveal the relation between energy-function-guidance diffusion models and constrained RL problems. The main challenge lies in estimating the intermediate energy, which is intractable due to the log-expectation formulation during the generation process. To address this issue, we propose the Analytic Energy-guided Policy Optimization (AEPO). Specifically, we first provide a theoretical analysis and the closed-form solution of the intermediate guidance when the diffusion model obeys the conditional Gaussian transformation. Then, we analyze the posterior Gaussian distribution in the log-expectation formulation and obtain the target estimation of the log-expectation under mild assumptions. Finally, we train an intermediate energy neural network to approach the target estimation of log-expectation formulation. We apply our method in 30+ offline RL tasks to demonstrate the effectiveness of our method. Extensive experiments illustrate that our method surpasses numerous representative baselines in D4RL offline reinforcement learning benchmarks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01822","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:38:29Z","registered":"2025-05-06T02:38:30Z","published":null,"updated":"2025-05-06T02:38:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01790","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01790","identifiers":[{"identifier":"2505.01790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Markos","familyName":"Stamatakis","name":"Stamatakis, Markos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua","familyName":"Berger","name":"Berger, Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Wartena","name":"Wartena, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ralph","familyName":"Ewerth","name":"Ewerth, Ralph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anett","familyName":"Hoppe","name":"Hoppe, Anett","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing the Learning Experience: Using Vision-Language Models to Generate Questions for Educational Videos"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T11:37:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:23:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Web-based educational videos offer flexible learning opportunities and are becoming increasingly popular. However, improving user engagement and knowledge retention remains a challenge. Automatically generated questions can activate learners and support their knowledge acquisition. Further, they can help teachers and learners assess their understanding. While large language and vision-language models have been employed in various tasks, their application to question generation for educational videos remains underexplored. In this paper, we investigate the capabilities of current vision-language models for generating learning-oriented questions for educational video content. We assess (1) out-of-the-box models' performance; (2) fine-tuning effects on content-specific question generation; (3) the impact of different video modalities on question quality; and (4) in a qualitative study, question relevance, answerability, and difficulty levels of generated questions. Our findings delineate the capabilities of current vision-language models, highlighting the need for fine-tuning and addressing challenges in question diversity and relevance. We identify requirements for future multimodal datasets and outline promising research directions."},{"descriptionType":"Other","description":"12 pages (excluding references), 8 tables, 1 equation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:37:43Z","registered":"2025-05-06T02:37:44Z","published":null,"updated":"2025-05-06T02:37:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01785","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01785","identifiers":[{"identifier":"2505.01785","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayoub","familyName":"Abraich","name":"Abraich, Ayoub","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TV-SurvCaus: Dynamic Representation Balancing for Causal Survival Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T11:04:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:23:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Estimating the causal effect of time-varying treatments on survival outcomes is a challenging task in many domains, particularly in medicine where treatment protocols adapt over time. While recent advances in representation learning have improved causal inference for static treatments, extending these methods to dynamic treatment regimes with survival outcomes remains under-explored. In this paper, we introduce TV-SurvCaus, a novel framework that extends representation balancing techniques to the time-varying treatment setting for survival analysis. We provide theoretical guarantees through (1) a generalized bound for time-varying precision in estimation of heterogeneous effects, (2) variance control via sequential balancing weights, (3) consistency results for dynamic treatment regimes, (4) convergence rates for representation learning with temporal dependencies, and (5) a formal bound on the bias due to treatment-confounder feedback. Our neural architecture incorporates sequence modeling to handle temporal dependencies while balancing time-dependent representations. Through extensive experiments on both synthetic and real-world datasets, we demonstrate that TV-SurvCaus outperforms existing methods in estimating individualized treatment effects with time-varying covariates and treatments. Our framework advances the field of causal inference by enabling more accurate estimation of treatment effects in dynamic, longitudinal settings with survival outcomes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01785","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:37:36Z","registered":"2025-05-06T02:37:37Z","published":null,"updated":"2025-05-06T02:37:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01743","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01743","identifiers":[{"identifier":"2505.01743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyang","familyName":"Jiang","name":"Jiang, Siyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bufang","familyName":"Yang","name":"Yang, Bufang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lilin","familyName":"Xu","name":"Xu, Lilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mu","familyName":"Yuan","name":"Yuan, Mu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeerzhati","familyName":"Abudunuer","name":"Abudunuer, Yeerzhati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiwei","familyName":"Liu","name":"Liu, Kaiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liekang","familyName":"Zeng","name":"Zeng, Liekang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongkai","familyName":"Chen","name":"Chen, Hongkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Yan","name":"Yan, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofan","familyName":"Jiang","name":"Jiang, Xiaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoliang","familyName":"Xing","name":"Xing, Guoliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An LLM-Empowered Low-Resolution Vision System for On-Device Human Behavior Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T08:46:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:20:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancements in Large Vision Language Models (LVLMs) offer the potential to surpass conventional labeling by generating richer, more detailed descriptions of on-device human behavior understanding (HBU) in low-resolution vision systems, such as depth, thermal, and infrared. However, existing large vision language model (LVLM) approaches are unable to understand low-resolution data well as they are primarily designed for high-resolution data, such as RGB images. A quick fixing approach is to caption a large amount of low-resolution data, but it requires a significant amount of labor-intensive annotation efforts. In this paper, we propose a novel, labor-saving system, Llambda, designed to support low-resolution HBU. The core idea is to leverage limited labeled data and a large amount of unlabeled data to guide LLMs in generating informative captions, which can be combined with raw data to effectively fine-tune LVLM models for understanding low-resolution videos in HBU. First, we propose a Contrastive-Oriented Data Labeler, which can capture behavior-relevant information from long, low-resolution videos and generate high-quality pseudo labels for unlabeled data via contrastive learning. Second, we propose a Physical-Knowledge Guided Captioner, which utilizes spatial and temporal consistency checks to mitigate errors in pseudo labels. Therefore, it can improve LLMs' understanding of sequential data and then generate high-quality video captions. Finally, to ensure on-device deployability, we employ LoRA-based efficient fine-tuning to adapt LVLMs for low-resolution data. We evaluate Llambda using a region-scale real-world testbed and three distinct low-resolution datasets, and the experiments show that Llambda outperforms several state-of-the-art LVLM systems up to $40.03\\%$ on average Bert-Score."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01743","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:36:36Z","registered":"2025-05-06T02:36:36Z","published":null,"updated":"2025-05-06T02:36:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01713","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01713","identifiers":[{"identifier":"2505.01713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Congqi","familyName":"Cao","name":"Cao, Congqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanshu","familyName":"Hu","name":"Hu, Lanshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yating","familyName":"Yu","name":"Yu, Yating","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanning","familyName":"Zhang","name":"Zhang, Yanning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vision and Intention Boost Large Language Model in Long-Term Action Anticipation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T06:33:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:17:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-term action anticipation (LTA) aims to predict future actions over an extended period. Previous approaches primarily focus on learning exclusively from video data but lack prior knowledge. Recent researches leverage large language models (LLMs) by utilizing text-based inputs which suffer severe information loss. To tackle these limitations single-modality methods face, we propose a novel Intention-Conditioned Vision-Language (ICVL) model in this study that fully leverages the rich semantic information of visual data and the powerful reasoning capabilities of LLMs. Considering intention as a high-level concept guiding the evolution of actions, we first propose to employ a vision-language model (VLM) to infer behavioral intentions as comprehensive textual features directly from video inputs. The inferred intentions are then fused with visual features through a multi-modality fusion strategy, resulting in intention-enhanced visual representations. These enhanced visual representations, along with textual prompts, are fed into LLM for future action anticipation. Furthermore, we propose an effective example selection strategy jointly considers visual and textual similarities, providing more relevant and informative examples for in-context learning. Extensive experiments with state-of-the-art performance on Ego4D, EPIC-Kitchens-55, and EGTEA GAZE+ datasets fully demonstrate the effectiveness and superiority of the proposed method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:35:53Z","registered":"2025-05-06T02:35:54Z","published":null,"updated":"2025-05-06T02:35:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01706","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01706","identifiers":[{"identifier":"2505.01706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sarvesh","familyName":"Shashidhar","name":"Shashidhar, Sarvesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Ritik","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nachiketa","familyName":"Patil","name":"Patil, Nachiketa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suraj","familyName":"Racha","name":"Racha, Suraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ganesh","familyName":"Ramakrishnan","name":"Ramakrishnan, Ganesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Inducing Robustness in a 2 Dimensional Direct Preference Optimization Paradigm"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T05:59:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:16:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Direct Preference Optimisation (DPO) has emerged as a powerful method for aligning Large Language Models (LLMs) with human preferences, offering a stable and efficient alternative to approaches that use Reinforcement learning via Human Feedback. In this work, we investigate the performance of DPO using open-source preference datasets. One of the major drawbacks of DPO is that it doesn't induce granular scoring and treats all the segments of the responses with equal propensity. However, this is not practically true for human preferences since even \"good\" responses have segments that may not be preferred by the annotator. To resolve this, a 2-dimensional scoring for DPO alignment called 2D-DPO was proposed. We explore the 2D-DPO alignment paradigm and the advantages it provides over the standard DPO by comparing their win rates. It is observed that these methods, even though effective, are not robust to label/score noise. To counter this, we propose an approach of incorporating segment-level score noise robustness to the 2D-DPO algorithm. Along with theoretical backing, we also provide empirical verification in favour of the algorithm and introduce other noise models that can be present."},{"descriptionType":"Other","description":"Updated abstract, algorithm and experimental results"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01706","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:35:43Z","registered":"2025-05-06T02:35:44Z","published":null,"updated":"2025-05-06T02:35:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01695","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01695","identifiers":[{"identifier":"2505.01695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuying","familyName":"Zhao","name":"Zhao, Yuying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Yang","name":"Yang, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiyuan","familyName":"Chen","name":"Chen, Huiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiran","familyName":"Fan","name":"Fan, Xiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wang","name":"Wang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Cai","name":"Cai, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tyler","familyName":"Derr","name":"Derr, Tyler","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimAug: Enhancing Recommendation with Pretrained Language Models for Dense and Balanced Data Augmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T04:59:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:16:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Neural Networks (DNNs) are extensively used in collaborative filtering due to their impressive effectiveness. These systems depend on interaction data to learn user and item embeddings that are crucial for recommendations. However, the data often suffers from sparsity and imbalance issues: limited observations of user-item interactions can result in sub-optimal performance, and a predominance of interactions with popular items may introduce recommendation bias. To address these challenges, we employ Pretrained Language Models (PLMs) to enhance the interaction data with textual information, leading to a denser and more balanced dataset. Specifically, we propose a simple yet effective data augmentation method (SimAug) based on the textual similarity from PLMs, which can be seamlessly integrated to any systems as a lightweight, plug-and-play component in the pre-processing stage. Our experiments across nine datasets consistently demonstrate improvements in both utility and fairness when training with the augmented data generated by SimAug. The code is available at https://github.com/YuyingZhao/SimAug."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01695","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:35:27Z","registered":"2025-05-06T02:35:28Z","published":null,"updated":"2025-05-06T02:35:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01694","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01694","identifiers":[{"identifier":"2505.01694","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dazhi","familyName":"Huang","name":"Huang, Dazhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topology-Aware CLIP Few-Shot Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-03T04:58:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:16:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficiently adapting large Vision-Language Models (VLMs) like CLIP for few-shot learning poses challenges in balancing pre-trained knowledge retention and task-specific adaptation. Existing methods often overlook valuable structural information within the VLM's latent space. We introduce a topology-aware tuning approach integrating Representation Topology Divergence (RTD) into the Task Residual (TR) framework. By explicitly aligning the topological structures of visual and text representations using a combined RTD and Cross-Entropy loss, while freezing base VLM encoders, our method enhances few-shot performance. We optimize only lightweight Task Residual parameters, effectively leveraging topological information. Across 6 diverse benchmark datasets, our approach demonstrates significant gains, achieving an average accuracy improvement of 1-2\\% over relevant baseline methods in few-shot settings. This work presents an effective strategy to boost VLM few-shot capabilities by incorporating topological alignment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01694","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:35:26Z","registered":"2025-05-06T02:35:27Z","published":null,"updated":"2025-05-06T02:35:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01637","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01637","identifiers":[{"identifier":"2505.01637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel J.","familyName":"Kaufman","name":"Kaufman, Samuel J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"René","familyName":"Just","name":"Just, René","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rastislav","familyName":"Bodik","name":"Bodik, Rastislav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Morello: Compiling Fast Neural Networks with Dynamic Programming and Spatial Compression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.1.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-05-03T00:14:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:11:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"High-throughput neural network inference requires coordinating many optimization decisions, including parallel tiling, microkernel selection, and data layout. The product of these decisions forms a search space of programs which is typically intractably large. Existing approaches (e.g., auto-schedulers) often address this problem by sampling this space heuristically. In contrast, we introduce a dynamic-programming-based approach to explore more of the search space by iteratively decomposing large program specifications into smaller specifications reachable from a set of rewrites, then composing a final program from each rewrite that minimizes an affine cost model. To reduce memory requirements, we employ a novel memoization table representation, which indexes specifications by coordinates in $Z_{\\geq 0}$ and compresses identical, adjacent solutions. This approach can visit a much larger set of programs than prior work. To evaluate the approach, we developed Morello, a compiler which lowers specifications roughly equivalent to a few-node XLA computation graph to x86. Notably, we found that an affine cost model is sufficient to surface high-throughput programs. For example, Morello synthesized a collection of matrix multiplication benchmarks targeting a Zen 1 CPU, including a 1x2048x16384, bfloat16-to-float32 vector-matrix multiply, which was integrated into Google's gemma.cpp."},{"descriptionType":"Other","description":"13 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01637","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:34:04Z","registered":"2025-05-06T02:34:04Z","published":null,"updated":"2025-05-06T02:34:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01619","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01619","identifiers":[{"identifier":"2505.01619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanping","familyName":"Zhang","name":"Zhang, Hanping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhong","familyName":"Guo","name":"Guo, Yuhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Skill-based Safe Reinforcement Learning with Risk Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T22:48:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:10:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Safe Reinforcement Learning (Safe RL) aims to ensure safety when an RL agent conducts learning by interacting with real-world environments where improper actions can induce high costs or lead to severe consequences. In this paper, we propose a novel Safe Skill Planning (SSkP) approach to enhance effective safe RL by exploiting auxiliary offline demonstration data. SSkP involves a two-stage process. First, we employ PU learning to learn a skill risk predictor from the offline demonstration data. Then, based on the learned skill risk predictor, we develop a novel risk planning process to enhance online safe RL and learn a risk-averse safe policy efficiently through interactions with the online RL environment, while simultaneously adapting the skill risk predictor to the environment. We conduct experiments in several benchmark robotic simulation environments. The experimental results demonstrate that the proposed approach consistently outperforms previous state-of-the-art safe RL methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01619","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:33:38Z","registered":"2025-05-06T02:33:39Z","published":null,"updated":"2025-05-06T02:33:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01578","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01578","identifiers":[{"identifier":"2505.01578","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gabriel","familyName":"Sarch","name":"Sarch, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Balasaravanan Thoravi","familyName":"Kumaravel","name":"Kumaravel, Balasaravanan Thoravi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sahithya","familyName":"Ravi","name":"Ravi, Sahithya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vibhav","familyName":"Vineet","name":"Vineet, Vibhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew D.","familyName":"Wilson","name":"Wilson, Andrew D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Grounding Task Assistance with Multimodal Cues from a Single Demonstration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T20:43:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:08:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A person's demonstration often serves as a key reference for others learning the same task. However, RGB video, the dominant medium for representing these demonstrations, often fails to capture fine-grained contextual cues such as intent, safety-critical environmental factors, and subtle preferences embedded in human behavior. This sensory gap fundamentally limits the ability of Vision Language Models (VLMs) to reason about why actions occur and how they should adapt to individual users. To address this, we introduce MICA (Multimodal Interactive Contextualized Assistance), a framework that improves conversational agents for task assistance by integrating eye gaze and speech cues. MICA segments demonstrations into meaningful sub-tasks and extracts keyframes and captions that capture fine-grained intent and user-specific cues, enabling richer contextual grounding for visual question answering. Evaluations on questions derived from real-time chat-assisted task replication show that multimodal cues significantly improve response quality over frame-based retrieval. Notably, gaze cues alone achieves 93% of speech performance, and their combination yields the highest accuracy. Task type determines the effectiveness of implicit (gaze) vs. explicit (speech) cues, underscoring the need for adaptable multimodal models. These results highlight the limitations of frame-based context and demonstrate the value of multimodal signals for real-world AI task assistance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01578","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:39Z","registered":"2025-05-06T02:32:40Z","published":null,"updated":"2025-05-06T02:32:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01572","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01572","identifiers":[{"identifier":"2505.01572","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bradley","familyName":"McDanel","name":"McDanel, Bradley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sai Qian","familyName":"Zhang","name":"Zhang, Sai Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhai","familyName":"Hu","name":"Hu, Yunhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zining","familyName":"Liu","name":"Liu, Zining","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PipeSpec: Breaking Stage Dependencies in Hierarchical LLM Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T20:29:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:07:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Speculative decoding accelerates large language model inference by using smaller draft models to generate candidate tokens for parallel verification. However, current approaches are limited by sequential stage dependencies that prevent full hardware utilization. We present PipeSpec, a framework that generalizes speculative decoding to $k$ models arranged in a hierarchical pipeline, enabling asynchronous execution with lightweight coordination for prediction verification and rollback. Our analytical model characterizes token generation rates across pipeline stages and proves guaranteed throughput improvements over traditional decoding for any non-zero acceptance rate. We further derive closed-form expressions for steady-state verification probabilities that explain the empirical benefits of pipeline depth. Experimental results show that PipeSpec achieves up to 2.54$\\times$ speedup while outperforming state-of-the-art methods. We validate PipeSpec across text summarization and code generation tasks using LLaMA 2 and 3 models, demonstrating that pipeline efficiency increases with model depth, providing a scalable approach to accelerating LLM inference on multi-device systems."},{"descriptionType":"Other","description":"10 pages, 5 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01572","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:30Z","registered":"2025-05-06T02:32:31Z","published":null,"updated":"2025-05-06T02:32:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01563","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01563","identifiers":[{"identifier":"2505.01563","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Weitekamp","name":"Weitekamp, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Momin N.","familyName":"Siddiqui","name":"Siddiqui, Momin N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher J.","familyName":"MacLellan","name":"MacLellan, Christopher J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TutorGym: A Testbed for Evaluating AI Agents as Tutors and Students"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-05-02T20:03:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:07:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent improvements in large language model (LLM) performance on academic benchmarks, such as MATH and GSM8K, have emboldened their use as standalone tutors and as simulations of human learning. However, these new applications require more than evaluations of final solution generation. We introduce TutorGym to evaluate these applications more directly. TutorGym is a standard interface for testing artificial intelligence (AI) agents within existing intelligent tutoring systems (ITS) that have been tested and refined in classroom studies, including Cognitive Tutors (CTAT), Apprentice Tutors, and OATutors. TutorGym is more than a simple problem-solution benchmark, it situates AI agents within the interactive interfaces of existing ITSs. At each step of problem-solving, AI agents are asked what they would do as a tutor or as a learner. As tutors, AI agents are prompted to provide tutoring support -- such as generating examples, hints, and step-level correctness feedback -- which can be evaluated directly against the adaptive step-by-step support provided by existing ITSs. As students, agents directly learn from ITS instruction, and their mistakes and learning trajectories can be compared to student data. TutorGym establishes a common framework for training and evaluating diverse AI agents, including LLMs, computational models of learning, and reinforcement learning agents, within a growing suite of learning environments. Currently, TutorGym includes 223 different tutor domains. In an initial evaluation, we find that current LLMs are poor at tutoring -- none did better than chance at labeling incorrect actions, and next-step actions were correct only ~52-70% of the time -- but they could produce remarkably human-like learning curves when trained as students with in-context learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01563","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:17Z","registered":"2025-05-06T02:32:18Z","published":null,"updated":"2025-05-06T02:32:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01560","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01560","identifiers":[{"identifier":"2505.01560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vicent Briva","familyName":"Iglesias","name":"Iglesias, Vicent Briva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gokhan","familyName":"Dogru","name":"Dogru, Gokhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI agents may be worth the hype but not the resources (yet): An initial exploration of machine translation quality and costs in three language pairs in the legal and news domains"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T20:02:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:07:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) and multi-agent orchestration are touted as the next leap in machine translation (MT), but their benefits relative to conventional neural MT (NMT) remain unclear. This paper offers an empirical reality check. We benchmark five paradigms, Google Translate (strong NMT baseline), GPT-4o (general-purpose LLM), o1-preview (reasoning-enhanced LLM), and two GPT-4o-powered agentic workflows (sequential three-stage and iterative refinement), on test data drawn from a legal contract and news prose in three English-source pairs: Spanish, Catalan and Turkish. Automatic evaluation is performed with COMET, BLEU, chrF2 and TER; human evaluation is conducted with expert ratings of adequacy and fluency; efficiency with total input-plus-output token counts mapped to April 2025 pricing.\n Automatic scores still favour the mature NMT system, which ranks first in seven of twelve metric-language combinations; o1-preview ties or places second in most remaining cases, while both multi-agent workflows trail. Human evaluation reverses part of this narrative: o1-preview produces the most adequate and fluent output in five of six comparisons, and the iterative agent edges ahead once, indicating that reasoning layers capture semantic nuance undervalued by surface metrics. Yet these qualitative gains carry steep costs. The sequential agent consumes roughly five times, and the iterative agent fifteen times, the tokens used by NMT or single-pass LLMs.\n We advocate multidimensional, cost-aware evaluation protocols and highlight research directions that could tip the balance: leaner coordination strategies, selective agent activation, and hybrid pipelines combining single-pass LLMs with targeted agent intervention."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01560","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:13Z","registered":"2025-05-06T02:32:14Z","published":null,"updated":"2025-05-06T02:32:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01558","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01558","identifiers":[{"identifier":"2505.01558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anan","familyName":"Yaghmour","name":"Yaghmour, Anan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Melba M.","familyName":"Crawford","name":"Crawford, Melba M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Prasad","name":"Prasad, Saurabh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Sensor Agnostic Domain Generalization Framework for Leveraging Geospatial Foundation Models: Enhancing Semantic Segmentation viaSynergistic Pseudo-Labeling and Generative Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T19:52:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:07:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Remote sensing enables a wide range of critical applications such as land cover and land use mapping, crop yield prediction, and environmental monitoring. Advances in satellite technology have expanded remote sensing datasets, yet high-performance segmentation models remain dependent on extensive labeled data, challenged by annotation scarcity and variability across sensors, illumination, and geography. Domain adaptation offers a promising solution to improve model generalization. This paper introduces a domain generalization approach to leveraging emerging geospatial foundation models by combining soft-alignment pseudo-labeling with source-to-target generative pre-training. We further provide new mathematical insights into MAE-based generative learning for domain-invariant feature learning. Experiments with hyperspectral and multispectral remote sensing datasets confirm our method's effectiveness in enhancing adaptability and segmentation."},{"descriptionType":"Other","description":"Accepted in the 2025 CVPR Workshop on Foundation and Large Vision Models in Remote Sensing, to appear in CVPR 2025 Workshop Proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01558","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:32:10Z","registered":"2025-05-06T02:32:11Z","published":null,"updated":"2025-05-06T02:32:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01539","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01539","identifiers":[{"identifier":"2505.01539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cor","familyName":"Steging","name":"Steging, Cor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silja","familyName":"Renooij","name":"Renooij, Silja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bart","familyName":"Verheij","name":"Verheij, Bart","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parameterized Argumentation-based Reasoning Tasks for Benchmarking Generative Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T19:04:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:05:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative large language models as tools in the legal domain have the potential to improve the justice system. However, the reasoning behavior of current generative models is brittle and poorly understood, hence cannot be responsibly applied in the domains of law and evidence. In this paper, we introduce an approach for creating benchmarks that can be used to evaluate the reasoning capabilities of generative language models. These benchmarks are dynamically varied, scalable in their complexity, and have formally unambiguous interpretations. In this study, we illustrate the approach on the basis of witness testimony, focusing on the underlying argument attack structure. We dynamically generate both linear and non-linear argument attack graphs of varying complexity and translate these into reasoning puzzles about witness testimony expressed in natural language. We show that state-of-the-art large language models often fail in these reasoning puzzles, already at low complexity. Obvious mistakes are made by the models, and their inconsistent performance indicates that their reasoning capabilities are brittle. Furthermore, at higher complexity, even state-of-the-art models specifically presented for reasoning capabilities make mistakes. We show the viability of using a parametrized benchmark with varying complexity to evaluate the reasoning capabilities of generative language models. As such, the findings contribute to a better understanding of the limitations of the reasoning capabilities of generative models, which is essential when designing responsible AI systems in the legal domain."},{"descriptionType":"Other","description":"This manuscript has been accepted for presentation as a short paper at the 20th International Conference of AI \u0026amp; Law in Chicago, June 16 to 20 of 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:31:43Z","registered":"2025-05-06T02:31:43Z","published":null,"updated":"2025-05-06T02:31:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01524","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01524","identifiers":[{"identifier":"2505.01524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zexi","familyName":"Yao","name":"Yao, Zexi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nataša","familyName":"Krčo","name":"Krčo, Nataša","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgi","familyName":"Ganev","name":"Ganev, Georgi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yves-Alexandre","familyName":"de Montjoye","name":"de Montjoye, Yves-Alexandre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The DCR Delusion: Measuring the Privacy Risk of Synthetic Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T18:21:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:04:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic data has become an increasingly popular way to share data without revealing sensitive information. Though Membership Inference Attacks (MIAs) are widely considered the gold standard for empirically assessing the privacy of a synthetic dataset, practitioners and researchers often rely on simpler proxy metrics such as Distance to Closest Record (DCR). These metrics estimate privacy by measuring the similarity between the training data and generated synthetic data. This similarity is also compared against that between the training data and a disjoint holdout set of real records to construct a binary privacy test. If the synthetic data is not more similar to the training data than the holdout set is, it passes the test and is considered private. In this work we show that, while computationally inexpensive, DCR and other distance-based metrics fail to identify privacy leakage. Across multiple datasets and both classical models such as Baynet and CTGAN and more recent diffusion models, we show that datasets deemed private by proxy metrics are highly vulnerable to MIAs. We similarly find both the binary privacy test and the continuous measure based on these metrics to be uninformative of actual membership inference risk. We further show that these failures are consistent across different metric hyperparameter settings and record selection methods. Finally, we argue DCR and other distance-based metrics to be flawed by design and show a example of a simple leakage they miss in practice. With this work, we hope to motivate practitioners to move away from proxy metrics to MIAs as the rigorous, comprehensive standard of evaluating privacy of synthetic data, in particular to make claims of datasets being legally anonymous."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:31:21Z","registered":"2025-05-06T02:31:21Z","published":null,"updated":"2025-05-06T02:31:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01523","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01523","identifiers":[{"identifier":"2505.01523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Madhav","familyName":"Kotecha","name":"Kotecha, Madhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijendra Kumar","familyName":"Vaishya","name":"Vaishya, Vijendra Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Smita","familyName":"Gautam","name":"Gautam, Smita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suraj","familyName":"Racha","name":"Racha, Suraj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Subset Selection for Fine-Tuning: A Utility-Diversity Balanced Approach for Mathematical Domain Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"68T05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-05-02T18:20:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:04:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a refined approach to efficiently fine-tune large language models (LLMs) on specific domains like the mathematical domain by employing a budgeted subset selection method. Our approach combines utility and diversity metrics to select the most informative and representative training examples. The final goal is to achieve near-full dataset performance with meticulously selected data points from the entire dataset while significantly reducing computational cost and training time and achieving competitive performance as the full dataset. The utility metric incorporates both perplexity and Chain-of-Thought (CoT) loss to identify challenging examples that contribute most to model learning, while the diversity metric ensures broad coverage across mathematical subdomains. We evaluate our method on LLaMA-3 8B and Phi-3 models, comparing against several baseline approaches, including random selection, diversity-based sampling, and existing state-of-the-art subset selection techniques."},{"descriptionType":"Other","description":"9 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:31:19Z","registered":"2025-05-06T02:31:20Z","published":null,"updated":"2025-05-06T02:31:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01485","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01485","identifiers":[{"identifier":"2505.01485","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tasnim","familyName":"Ahmed","name":"Ahmed, Tasnim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salimur","familyName":"Choudhury","name":"Choudhury, Salimur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CHORUS: Zero-shot Hierarchical Retrieval and Orchestration for Generating Linear Programming Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T16:36:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-06T00:02:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Linear Programming (LP) problems aim to find the optimal solution to an objective under constraints. These problems typically require domain knowledge, mathematical skills, and programming ability, presenting significant challenges for non-experts. This study explores the efficiency of Large Language Models (LLMs) in generating solver-specific LP code. We propose CHORUS, a retrieval-augmented generation (RAG) framework for synthesizing Gurobi-based LP code from natural language problem statements. CHORUS incorporates a hierarchical tree-like chunking strategy for theoretical contents and generates additional metadata based on code examples from documentation to facilitate self-contained, semantically coherent retrieval. Two-stage retrieval approach of CHORUS followed by cross-encoder reranking further ensures contextual relevance. Finally, expertly crafted prompt and structured parser with reasoning steps improve code generation performance significantly. Experiments on the NL4Opt-Code benchmark show that CHORUS improves the performance of open-source LLMs such as Llama3.1 (8B), Llama3.3 (70B), Phi4 (14B), Deepseek-r1 (32B), and Qwen2.5-coder (32B) by a significant margin compared to baseline and conventional RAG. It also allows these open-source LLMs to outperform or match the performance of much stronger baselines-GPT3.5 and GPT4 while requiring far fewer computational resources. Ablation studies further demonstrate the importance of expert prompting, hierarchical chunking, and structured reasoning."},{"descriptionType":"Other","description":"This paper has been accepted for presentation at the 19th Learning and Intelligent Optimization Conference (LION 19)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01485","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-06T02:30:22Z","registered":"2025-05-06T02:30:23Z","published":null,"updated":"2025-05-06T02:30:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2505.01382","type":"dois","attributes":{"doi":"10.48550/arxiv.2505.01382","identifiers":[{"identifier":"2505.01382","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gen","familyName":"Li","name":"Li, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Jiao","name":"Jiao, Yuchen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Provable Efficiency of Guidance in Diffusion Models for General Data Distribution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-05-02T16:46:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-05-05T00:47:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-05","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have emerged as a powerful framework for generative modeling, with guidance techniques playing a crucial role in enhancing sample quality. Despite their empirical success, a comprehensive theoretical understanding of the guidance effect remains limited. Existing studies only focus on case studies, where the distribution conditioned on each class is either isotropic Gaussian or supported on a one-dimensional interval with some extra conditions. How to analyze the guidance effect beyond these case studies remains an open question. Towards closing this gap, we make an attempt to analyze diffusion guidance under general data distributions. Rather than demonstrating uniform sample quality improvement, which does not hold in some distributions, we prove that guidance can improve the whole sample quality, in the sense that the average reciprocal of the classifier probability decreases with the existence of guidance. This aligns with the motivation of introducing guidance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2505.01382","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-05-05T01:40:38Z","registered":"2025-05-05T01:40:39Z","published":null,"updated":"2025-05-05T01:40:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":50,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=(doi%3A%2210.48550%2Farxiv.2505.01382%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01386%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01399%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01406%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01482%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01484%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01485%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01490%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01523%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01524%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01539%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01558%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01560%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01563%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01572%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01578%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01583%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01592%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01595%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01603%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01616%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01618%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01619%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01637%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01652%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01657%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01660%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01694%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01695%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01706%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01709%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01713%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01729%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01731%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01742%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01743%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01761%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01785%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01790%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01812%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.01822%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.02858%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.02862%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.02865%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.03814%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.03818%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.03819%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.03821%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.03824%22%20OR%20doi%3A%2210.48550%2Farxiv.2505.04637%22)\u0026client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1"}}