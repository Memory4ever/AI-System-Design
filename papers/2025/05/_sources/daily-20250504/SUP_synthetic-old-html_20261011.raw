<th id="S5.T2.5.2.8" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T2.5.2.8.1" class="ltx_text ltx_font_bold">T=1 P=0.7</span></th>
<th id="S5.T2.5.2.9" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T2.5.2.9.1" class="ltx_text ltx_font_bold">T=1 P=1</span></th></tr>
