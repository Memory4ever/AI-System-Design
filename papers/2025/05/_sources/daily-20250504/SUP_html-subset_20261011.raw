<th id="S6.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S6.T1.2.1.3.1" class="ltx_text ltx_font_bold">DPP (Greedy)</span></th>
