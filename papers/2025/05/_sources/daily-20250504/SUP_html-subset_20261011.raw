<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Variants of Submodular Function</h2>

<div id="A1.p1" class="ltx_para">
<ol id="A1.I1" class="ltx_enumerate">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p"><span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Facility Location:</span>  <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="f(X)=\sum_{i\in\mathcal{V}}\max_{j\in X}s_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mrow><msub><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mi>X</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f(X)=\sum_{i\in\mathcal{V}}\max_{j\in X}s_{ij}</annotation></semantics></math></p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p"><span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Mutual Information:</span>  <math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="f(\mathcal{A};\mathcal{D}_{T})=\sum_{i\in\mathcal{D}}\max_{j\in\mathcal{A}}s_{ij}+\eta\sum_{j\in\mathcal{A}}\max_{i\in\mathcal{D}_{T}}s_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><msub><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></msub><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f(\mathcal{A};\mathcal{D}_{T})=\sum_{i\in\mathcal{D}}\max_{j\in\mathcal{A}}s_{ij}+\eta\sum_{j\in\mathcal{A}}\max_{i\in\mathcal{D}_{T}}s_{ij}</annotation></semantics></math></p>
</div></li>
<li id="A1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A1.I1.i3.p1" class="ltx_para">
<p id="A1.I1.i3.p1.1" class="ltx_p"><span id="A1.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Conditional Gain:</span>  <math id="A1.I1.i3.p1.m1" class="ltx_Math" alttext="f(\mathcal{A}\mid\mathcal{D}_{E})=\sum_{i\in\mathcal{D}}\max\left(\max_{j\in\mathcal{A}}s_{ij}-\nu\max_{k\in\mathcal{D}_{E}}s_{ik},\,0\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>E</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><mrow><mi>ν</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>E</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow></mrow><mo>,</mo><mn> 0</mn><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f(\mathcal{A}\mid\mathcal{D}_{E})=\sum_{i\in\mathcal{D}}\max\left(\max_{j\in\mathcal{A}}s_{ij}-\nu\max_{k\in\mathcal{D}_{E}}s_{ik},\,0\right)</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A1.I1.i4.p1" class="ltx_para">
<p id="A1.I1.i4.p1.1" class="ltx_p"><span id="A1.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Graph Cut:</span>  <math id="A1.I1.i4.p1.m1" class="ltx_Math" alttext="f(X)=\sum_{i\in\mathcal{V},j\in X}s_{ij}-\lambda\sum_{i,j\in X}s_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mi>X</mi></mrow></mrow></msub><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mi>X</mi></mrow></msub><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f(X)=\sum_{i\in\mathcal{V},j\in X}s_{ij}-\lambda\sum_{i,j\in X}s_{ij}</annotation></semantics></math></p>
</div></li>
<li id="A1.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A1.I1.i5.p1" class="ltx_para">
<p id="A1.I1.i5.p1.1" class="ltx_p"><span id="A1.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Log Determinant:</span>  <math id="A1.I1.i5.p1.m1" class="ltx_math_unparsed" alttext="f(X)=\log\det(S_{X})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(X)=\log\det(S_{X})</annotation></semantics></math></p>
</div></li>
</ol>
</div>
