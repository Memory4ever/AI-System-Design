<tbody id="chapter12.A2.Ex343"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex343.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex343.m2" class="ltx_Math" alttext="\displaystyle\gamma\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+\eta\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\sqrt{1+3\epsilon}\gamma^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+\eta\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\sqrt{1+3\epsilon}\gamma^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex344"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex344.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex344.m2" class="ltx_math_unparsed" alttext="\displaystyle\gamma\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}\sqrt{1+3\epsilon}\gamma^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}\tilde{d}^{-1/4}," display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><msup><mi>γ</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}\sqrt{1+3\epsilon}\gamma^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}\tilde{d}^{-1/4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.11" class="ltx_p">which implies that</p>
<table id="chapter12.A2.Ex345" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex345.m1" class="ltx_math_unparsed" alttext="\gamma^{-(t+1)}\left\|\sqrt{{\bm{Q}}}\Delta_{t+1}\right\|_{2}\leq\gamma^{-t}\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}\sqrt{1+3\epsilon}\gamma^{-1-t_{\epsilon}}B^{t_{\epsilon}}R_{0}\tilde{d}^{-1/4}." display="block" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msup><mi>γ</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><msup><mi>γ</mi><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma^{-(t+1)}\left\|\sqrt{{\bm{Q}}}\Delta_{t+1}\right\|_{2}\leq\gamma^{-t}\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}\sqrt{1+3\epsilon}\gamma^{-1-t_{\epsilon}}B^{t_{\epsilon}}R_{0}\tilde{d}^{-1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A2.p18" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p18.1" class="ltx_p">Next, we consider an arbitrary test point <math id="chapter12.A2.p18.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A2.p18.m2" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>.
Denote <math id="chapter12.A2.p18.m3" class="ltx_Math" alttext="\delta_{t}=f_{\textnormal{lin}}^{(t)}(x)-f^{(t)}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{t}=f_{\textnormal{lin}}^{(t)}(x)-f^{(t)}(x)</annotation></semantics></math>.
Then, we have</p>
<table id="chapter12.A2.Ex346" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex346.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} f_{\textnormal{lin}}^{(t+1)}(x)-f_{\textnormal{lin}}^{(t)}(x)&amp;=-\eta\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)});\\
f^{(t+1)}(x)-f^{(t)}(x)&amp;=-\eta\nabla_{\theta}f(x;\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)}).\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} f_{\textnormal{lin}}^{(t+1)}(x)-f_{\textnormal{lin}}^{(t)}(x)&amp;=-\eta\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)});\\
f^{(t+1)}(x)-f^{(t)}(x)&amp;=-\eta\nabla_{\theta}f(x;\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)}).\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p18.2" class="ltx_p">Therefore, we have</p>
<table id="chapter12.A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex347.m1" class="ltx_Math" alttext="\displaystyle\delta_{t+1}-\delta_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>δ</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\delta_{t+1}-\delta_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex347.m2" class="ltx_Math" alttext="\displaystyle\eta\left[\nabla_{\theta}f(x;\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\left[\nabla_{\theta}f(x;\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex348.m1" class="ltx_Math" alttext="\displaystyle-\eta\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\Delta_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\Delta_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p18.3" class="ltx_p">For <math id="chapter12.A2.p18.m4" class="ltx_Math" alttext="t\leq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\leq t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex349.m1" class="ltx_Math" alttext="\displaystyle\left\|\delta_{t}\right\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\delta_{t}\right\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex349.m2" class="ltx_Math" alttext="\displaystyle\eta\sum_{s=0}^{t-1}\left\|\left[\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(s)}\right\|_{2}\left\|g(\theta^{(s)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mo>[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sum_{s=0}^{t-1}\left\|\left[\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(s)}\right\|_{2}\left\|g(\theta^{(s)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex350.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(s)}\right\|_{2}\left\|\Delta_{s}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>η</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mrow><mo>‖</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>;</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mi>J</mi><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>s</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(s)}\right\|_{2}\left\|\Delta_{s}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex351"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex351.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex351.m2" class="ltx_Math" alttext="\displaystyle\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(s)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(s)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex352.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|J(\theta^{(0)})\right\|_{F}\left\|\Delta_{s}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>η</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mrow><mo>‖</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>;</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msub><msub><mrow><mo>‖</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>s</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\eta\sum_{s=0}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|J(\theta^{(0)})\right\|_{F}\left\|\Delta_{s}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex353.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex353.m2" class="ltx_math_unparsed" alttext="\displaystyle 2\eta M^{2}C_{0}\tilde{d}^{-1/4}\sum_{s=0}^{t-1}B^{s}R_{0}+\eta M^{2}\sum_{s=0}^{t-1}(2s\eta M^{2}C_{0}B^{s-1}R_{0}\tilde{d}^{-1/4})." display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>B</mi><mi>s</mi></msup><msub><mi>R</mi><mn>0</mn></msub><mo>+</mo><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mn>2</mn><mi>s</mi><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\eta M^{2}C_{0}\tilde{d}^{-1/4}\sum_{s=0}^{t-1}B^{s}R_{0}+\eta M^{2}\sum_{s=0}^{t-1}(2s\eta M^{2}C_{0}B^{s-1}R_{0}\tilde{d}^{-1/4}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p18.4" class="ltx_p">Hence, there exists a constant <math id="chapter12.A2.p18.m5" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> such that <math id="chapter12.A2.p18.m6" class="ltx_math_unparsed" alttext="\left\|\delta_{t_{\epsilon}}\right\|_{2}\leq C_{1}\tilde{d}^{-1/4}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>δ</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>C</mi><mn>1</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\left\|\delta_{t_{\epsilon}}\right\|_{2}\leq C_{1}\tilde{d}^{-1/4}</annotation></semantics></math>. Then, for <math id="chapter12.A2.p18.m7" class="ltx_Math" alttext="t&gt;t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t&gt;t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex354.m1" class="ltx_Math" alttext="\displaystyle\left\|\delta_{t}\right\|_{2}-\left\|\delta_{t_{\epsilon}}\right\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><msub><mi>δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msub><mi>δ</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\delta_{t}\right\|_{2}-\left\|\delta_{t_{\epsilon}}\right\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex354.m2" class="ltx_Math" alttext="\displaystyle\eta\sum_{s=t_{\epsilon}}^{t-1}\left\|\left[\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(s)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(s)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mo>[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sum_{s=t_{\epsilon}}^{t-1}\left\|\left[\nabla_{\theta}f(x;\tilde{\theta}^{(s)})^{\top}J(\theta^{(s)})-\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(s)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(s)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex355.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta\sum_{s=t_{\epsilon}}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(s)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}\Delta_{s}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>η</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mrow><mo>‖</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>;</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mi>J</mi><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>‖</mo></mrow><mn>2</mn></msub><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><msub><mi mathvariant="normal">Δ</mi><mi>s</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\eta\sum_{s=t_{\epsilon}}^{t-1}\left\|\nabla_{\theta}f(x;\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(s)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}\Delta_{s}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex356"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex356.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex356.m2" class="ltx_math_unparsed" alttext="\displaystyle 2\eta M^{2}C_{0}\tilde{d}^{-1/4}\sqrt{1+3\epsilon}\sum_{s=t_{\epsilon}}^{t-1}\gamma^{s-t_{\epsilon}}B^{t_{\epsilon}}R_{0}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>η</mi><mi>M</mi><msup><mrow></mrow><mn>2</mn></msup><mi>C</mi><msub><mrow></mrow><mn>0</mn></msub><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>γ</mi><msup><mrow></mrow><mrow><mi>s</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><mi>B</mi><msup><mrow></mrow><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mi>R</mi><msub><mrow></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle 2\eta M^{2}C_{0}\tilde{d}^{-1/4}\sqrt{1+3\epsilon}\sum_{s=t_{\epsilon}}^{t-1}\gamma^{s-t_{\epsilon}}B^{t_{\epsilon}}R_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex357"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex357.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta M^{2}\sqrt{1+3\epsilon}\sum_{s=t_{\epsilon}}^{t-1}\left(2\gamma^{s-t_{\epsilon}}\eta M^{2}C_{0}B^{t_{\epsilon}}R_{0}\left[t_{\epsilon}B^{-1}+\sqrt{1+3\epsilon}\gamma^{-1}(s-t_{\epsilon})\right]\tilde{d}^{-1/4}\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>(</mo><mn>2</mn><msup><mi>γ</mi><mrow><mi>s</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><msub><mi>R</mi><mn>0</mn></msub><mrow><mo>[</mo><msub><mi>t</mi><mi>ϵ</mi></msub><msup><mi>B</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta M^{2}\sqrt{1+3\epsilon}\sum_{s=t_{\epsilon}}^{t-1}\left(2\gamma^{s-t_{\epsilon}}\eta M^{2}C_{0}B^{t_{\epsilon}}R_{0}\left[t_{\epsilon}B^{-1}+\sqrt{1+3\epsilon}\gamma^{-1}(s-t_{\epsilon})\right]\tilde{d}^{-1/4}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p18.5" class="ltx_p">Note that <math id="chapter12.A2.p18.m8" class="ltx_Math" alttext="\sum_{t=0}^{\infty}t\gamma^{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{\infty}t\gamma^{t}</annotation></semantics></math> is finite as long as <math id="chapter12.A2.p18.m9" class="ltx_Math" alttext="\gamma\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in(0,1)</annotation></semantics></math>. Therefore, there is a constant <math id="chapter12.A2.p18.m10" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that for any <math id="chapter12.A2.p18.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="chapter12.A2.p18.m12" class="ltx_math_unparsed" alttext="\left\|\delta_{t}\right\|_{2}\leq C\tilde{d}^{-1/4}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>C</mi><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\left\|\delta_{t}\right\|_{2}\leq C\tilde{d}^{-1/4}</annotation></semantics></math> with probability at least <math id="chapter12.A2.p18.m13" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> for any <math id="chapter12.A2.p18.m14" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.A2.p19" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p19.1" class="ltx_p">Now, let us finish the proof of <a href="#chapter6.Thmtheorem6" title="Theorem 6.6 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.6</span></a>.</p>
</div>
<div id="chapter12.A2.p20" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p20.1" class="ltx_p"><span id="chapter12.A2.p20.1.1" class="ltx_text ltx_font_bold">Proof </span>
Consider the linearized neural network <math id="chapter12.A2.p20.m1" class="ltx_Math" alttext="f_{\textnormal{lin}}^{(t)}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\textnormal{lin}}^{(t)}(x)</annotation></semantics></math> defined in <a href="#S25.E29" title="In Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">29</span></a>.
If we view <math id="chapter12.A2.p20.m2" class="ltx_Math" alttext="{\left\{\nabla_{\theta}f^{(0)}(x_{i})\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{\nabla_{\theta}f^{(0)}(x_{i})\right\}}_{i=1}^{n}</annotation></semantics></math> as inputs and <math id="chapter12.A2.p20.m3" class="ltx_Math" alttext="{\left\{y_{i}-f^{(0)}(x_{i})+{\left\langle\theta^{(0)},\nabla_{\theta}f^{(0)}(x_{i})\right\rangle}\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{y_{i}-f^{(0)}(x_{i})+{\left\langle\theta^{(0)},\nabla_{\theta}f^{(0)}(x_{i})\right\rangle}\right\}}_{i=1}^{n}</annotation></semantics></math> as the targets, then the linearized neural network is a linear model. Thus by <a href="#chapter6.Thmtheorem4" title="Theorem 6.4 (Proof in ). ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.4</span></a>, we have the following corollary.</p>
</div>
<div id="chapter12.Thmtheorem6" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem6.2" class="ltx_text ltx_font_bold">Corollary 12.6</span></span><span id="chapter12.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem6.p1" class="ltx_para">
<p id="chapter12.Thmtheorem6.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">If <math id="chapter12.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})</annotation></semantics></math> are linearly independent, then there exists <math id="chapter12.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\eta_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{0}&gt;0</annotation></semantics></math> such that when <math id="chapter12.Thmtheorem6.p1.m3" class="ltx_Math" alttext="f_{\textnormal{lin}}^{(t)}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\textnormal{lin}}^{(t)}(x)</annotation></semantics></math> is trained with any GRW method that satisfies <a href="#chapter6.Thmtheorem3" title="Assumption 6.3. ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">6.3</span></a>, <math id="chapter12.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> converges to a unique <math id="chapter12.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> that does not depend on the sample weights <math id="chapter12.Thmtheorem6.p1.m6" class="ltx_Math" alttext="q_{i}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">q_{i}^{(t)}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter12.A2.p21" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p21.1" class="ltx_p">Let <math id="chapter12.A2.p21.m1" class="ltx_Math" alttext="\eta_{1}=\min\{\eta_{0},\eta^{*}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><msup><mi>η</mi><mo>∗</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{1}=\min\{\eta_{0},\eta^{*}\}</annotation></semantics></math>, where <math id="chapter12.A2.p21.m2" class="ltx_Math" alttext="\eta_{0}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\eta_{0}</annotation></semantics></math> is given by <a href="#chapter12.Thmtheorem6" title="Corollary 12.6. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">12.6</span></a>.
Let <math id="chapter12.A2.p21.m3" class="ltx_Math" alttext="f^{(t)}_{\textnormal{lin}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{(t)}_{\textnormal{lin}}(x)</annotation></semantics></math> and <math id="chapter12.A2.p21.m4" class="ltx_Math" alttext="f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)</annotation></semantics></math> be the linearized neural networks of <math id="chapter12.A2.p21.m5" class="ltx_Math" alttext="f^{(t)}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{(t)}(x)</annotation></semantics></math> and <math id="chapter12.A2.p21.m6" class="ltx_Math" alttext="f^{(t)}_{\textnormal{ERM}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mtext>ERM</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{(t)}_{\textnormal{ERM}}(x)</annotation></semantics></math> (which are two networks trained with GRW and ERM), respectively.
By <a href="#chapter12.Thmtheorem2" title="Lemma 12.2 (Approximation Theorem). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.2</span></a>, for any <math id="chapter12.A2.p21.m7" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, there exists <math id="chapter12.A2.p21.m8" class="ltx_Math" alttext="\tilde{D}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{D}&gt;0</annotation></semantics></math> and a constant <math id="chapter12.A2.p21.m9" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that with probability at least <math id="chapter12.A2.p21.m10" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, the following holds:</p>
<table id="chapter12.A2.Ex358" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex358.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} &amp;\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}(x)\right|\leq C\tilde{d}^{-1/4};\\
&amp;\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)-f^{(t)}_{\textnormal{ERM}}(x)\right|\leq C\tilde{d}^{-1/4}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>f</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mtext>lin</mtext></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>f</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mtext>ERM</mtext></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} &amp;\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}(x)\right|\leq C\tilde{d}^{-1/4};\\
&amp;\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)-f^{(t)}_{\textnormal{ERM}}(x)\right|\leq C\tilde{d}^{-1/4}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p21.2" class="ltx_p">By <a href="#chapter12.Thmtheorem6" title="Corollary 12.6. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">12.6</span></a>, we have</p>
<table id="chapter12.A2.Ex359" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex359.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)\right|=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}_{\textnormal{lin}\textnormal{ERM}}(x)\right|=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p21.3" class="ltx_p">Summing the above yields</p>
<table id="chapter12.A2.Ex360" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex360.m1" class="ltx_math_unparsed" alttext="\limsup_{t\rightarrow\infty}\left|f^{(t)}(x)-f^{(t)}_{\textnormal{ERM}}(x)\right|\leq 2C\tilde{d}^{-1/4}," display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim sup</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>f</mi><mtext>ERM</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mn>2</mn><mi>C</mi><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\limsup_{t\rightarrow\infty}\left|f^{(t)}(x)-f^{(t)}_{\textnormal{ERM}}(x)\right|\leq 2C\tilde{d}^{-1/4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p21.4" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter12.A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.C </span>Proof of Theorem <a href="#chapter6.Thmtheorem7" title="Theorem 6.7 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.7</span></a></h2>

<div id="chapter12.A3.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p1.1" class="ltx_p">Similar to <a href="#chapter6.Thmtheorem6" title="Theorem 6.6 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.6</span></a>, proving this result needs a slightly different approximation theorem. We start with two necessary propositions.</p>
</div>
<div id="chapter12.Thmtheorem7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem7.2" class="ltx_text ltx_font_bold">Proposition 12.7</span></span><span id="chapter12.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib77" title="" class="ltx_ref">77</a>]</cite>, Proposition 1)<span id="chapter12.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem7.p1" class="ltx_para">
<p id="chapter12.Thmtheorem7.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">If <math id="chapter12.Thmtheorem7.p1.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> is Lipschitz and <math id="chapter12.Thmtheorem7.p1.m2" class="ltx_Math" alttext="d_{l}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">d_{l}\rightarrow\infty</annotation></semantics></math> for <math id="chapter12.Thmtheorem7.p1.m3" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math> sequentially, then for all <math id="chapter12.Thmtheorem7.p1.m4" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math>, the distribution of a single element of <math id="chapter12.Thmtheorem7.p1.m5" class="ltx_Math" alttext="{\bm{h}}^{l}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mi>l</mi></msup><annotation encoding="application/x-tex">{\bm{h}}^{l}</annotation></semantics></math> converges in probability to a zero-mean Gaussian process of covariance <math id="chapter12.Thmtheorem7.p1.m6" class="ltx_Math" alttext="\Sigma^{l}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>l</mi></msup><annotation encoding="application/x-tex">\Sigma^{l}</annotation></semantics></math> that is defined recursively by:</span></p>
<table id="chapter12.A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A3.Ex361"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex361.m1" class="ltx_Math" alttext="\displaystyle\Sigma^{1}(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma^{1}(x,x^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex361.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{d_{0}}x^{\top}x^{\prime}+\beta^{2};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>d</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{d_{0}}x^{\top}x^{\prime}+\beta^{2};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex362"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex362.m1" class="ltx_Math" alttext="\displaystyle\Sigma^{l}(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma^{l}(x,x^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex362.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{f}[\sigma(f(x))\sigma(f(x^{\prime}))]+\beta^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{f}[\sigma(f(x))\sigma(f(x^{\prime}))]+\beta^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.Thmtheorem7.p1.2" class="ltx_p"><span id="chapter12.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">where <math id="chapter12.Thmtheorem7.p1.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is sampled from a zero-mean Gaussian process of covariance <math id="chapter12.Thmtheorem7.p1.m8" class="ltx_Math" alttext="\Sigma^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Sigma^{(l-1)}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter12.Thmtheorem8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem8.2" class="ltx_text ltx_font_bold">Proposition 12.8</span></span><span id="chapter12.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem8.p1" class="ltx_para">
<p id="chapter12.Thmtheorem8.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">For any positive definite symmetric matrix <math id="chapter12.Thmtheorem8.p1.m1" class="ltx_Math" alttext="{\bm{H}}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐇</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{H}}\in\mathbb{R}^{n\times n}</annotation></semantics></math>, denote its largest and smallest eigenvalues by <math id="chapter12.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\lambda_{\max}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\lambda_{\max}</annotation></semantics></math> and <math id="chapter12.Thmtheorem8.p1.m3" class="ltx_Math" alttext="\lambda_{\min}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\lambda_{\min}</annotation></semantics></math>. Then, for any positive semi-definite diagonal matrix <math id="chapter12.Thmtheorem8.p1.m4" class="ltx_Math" alttext="{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})</annotation></semantics></math>, <math id="chapter12.Thmtheorem8.p1.m5" class="ltx_Math" alttext="{\bm{H}}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐇</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">{\bm{H}}{\bm{Q}}</annotation></semantics></math> has <math id="chapter12.Thmtheorem8.p1.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> eigenvalues that all lie in <math id="chapter12.Thmtheorem8.p1.m7" class="ltx_Math" alttext="[\min_{i}q_{i}\cdot\lambda_{\min},\max_{i}q_{i}\cdot\lambda_{\max}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo>,</mo><mrow><mrow><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\min_{i}q_{i}\cdot\lambda_{\min},\max_{i}q_{i}\cdot\lambda_{\max}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter12.A3.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p2.1" class="ltx_p"><span id="chapter12.A3.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
<math id="chapter12.A3.p2.m1" class="ltx_Math" alttext="{\bm{H}}" display="inline" intent=":literal"><semantics><mi>𝑯</mi><annotation encoding="application/x-tex">{\bm{H}}</annotation></semantics></math> is a positive definite symmetric matrix, so there exists <math id="chapter12.A3.p2.m2" class="ltx_Math" alttext="{\bm{A}}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}\in\mathbb{R}^{n\times n}</annotation></semantics></math> such that <math id="chapter12.A3.p2.m3" class="ltx_Math" alttext="{\bm{H}}={\bm{A}}^{\top}{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑯</mi><mo>=</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{H}}={\bm{A}}^{\top}{\bm{A}}</annotation></semantics></math>, and <math id="chapter12.A3.p2.m4" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is full-rank. First, any eigenvalue of <math id="chapter12.A3.p2.m5" class="ltx_Math" alttext="{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}</annotation></semantics></math> is also an eigenvalue of <math id="chapter12.A3.p2.m6" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}</annotation></semantics></math>, because for any eigenvalue <math id="chapter12.A3.p2.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> of <math id="chapter12.A3.p2.m8" class="ltx_Math" alttext="{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}</annotation></semantics></math> we have some <math id="chapter12.A3.p2.m9" class="ltx_Math" alttext="{\bm{v}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{v}}\neq 0</annotation></semantics></math> such that <math id="chapter12.A3.p2.m10" class="ltx_Math" alttext="{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}{\bm{v}}=\lambda{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{Q}}{\bm{A}}^{\top}{\bm{v}}=\lambda{\bm{v}}</annotation></semantics></math>. Multiplying both sides by <math id="chapter12.A3.p2.m11" class="ltx_Math" alttext="{\bm{A}}^{\top}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⊤</mo></msup><annotation encoding="application/x-tex">{\bm{A}}^{\top}</annotation></semantics></math> on the left yields <math id="chapter12.A3.p2.m12" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}({\bm{A}}^{\top}{\bm{v}})=\lambda({\bm{A}}^{\top}{\bm{v}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}({\bm{A}}^{\top}{\bm{v}})=\lambda({\bm{A}}^{\top}{\bm{v}})</annotation></semantics></math> which implies that <math id="chapter12.A3.p2.m13" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is also an eigenvalue of <math id="chapter12.A3.p2.m14" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{A}}{\bm{Q}}</annotation></semantics></math> because <math id="chapter12.A3.p2.m15" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{v}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{v}}\neq 0</annotation></semantics></math> as <math id="chapter12.A3.p2.m16" class="ltx_Math" alttext="\lambda{\bm{v}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda{\bm{v}}\neq 0</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A3.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p3.1" class="ltx_p">Second, by condition we know that the eigenvalues of <math id="chapter12.A3.p3.m1" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{A}}</annotation></semantics></math> are all in <math id="chapter12.A3.p3.m2" class="ltx_Math" alttext="[\lambda_{\min},\lambda_{\max}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>λ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\lambda_{\min},\lambda_{\max}]</annotation></semantics></math> where <math id="chapter12.A3.p3.m3" class="ltx_Math" alttext="\lambda_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{\min}&gt;0</annotation></semantics></math>, which implies for any unit vector <math id="chapter12.A3.p3.m4" class="ltx_Math" alttext="{\bm{v}}" display="inline" intent=":literal"><semantics><mi>𝒗</mi><annotation encoding="application/x-tex">{\bm{v}}</annotation></semantics></math>, <math id="chapter12.A3.p3.m5" class="ltx_Math" alttext="{\bm{v}}^{\top}{\bm{A}}^{\top}{\bm{A}}{\bm{v}}\in[\lambda_{\min},\lambda_{\max}]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}{\bm{A}}^{\top}{\bm{A}}{\bm{v}}\in[\lambda_{\min},\lambda_{\max}]</annotation></semantics></math>, which is equivalent to <math id="chapter12.A3.p3.m6" class="ltx_Math" alttext="\left\|{\bm{A}}{\bm{v}}\right\|_{2}\in[\sqrt{\lambda_{\min}},\sqrt{\lambda_{\max}}]" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msqrt><msub><mi>λ</mi><mi>min</mi></msub></msqrt><mo>,</mo><msqrt><msub><mi>λ</mi><mi>max</mi></msub></msqrt></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{A}}{\bm{v}}\right\|_{2}\in[\sqrt{\lambda_{\min}},\sqrt{\lambda_{\max}}]</annotation></semantics></math>.
Thus, <math id="chapter12.A3.p3.m7" class="ltx_Math" alttext="{\bm{v}}^{\top}{\bm{A}}^{\top}{\bm{Q}}{\bm{A}}{\bm{v}}\in[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}{\bm{A}}^{\top}{\bm{Q}}{\bm{A}}{\bm{v}}\in[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]</annotation></semantics></math>, which implies that the eigenvalues of <math id="chapter12.A3.p3.m8" class="ltx_Math" alttext="{\bm{A}}^{\top}{\bm{Q}}{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\top}{\bm{Q}}{\bm{A}}</annotation></semantics></math> are all in <math id="chapter12.A3.p3.m9" class="ltx_Math" alttext="[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A3.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p4.1" class="ltx_p">Thus, the eigenvalues of <math id="chapter12.A3.p4.m1" class="ltx_Math" alttext="{\bm{H}}{\bm{Q}}={\bm{A}}^{\top}{\bm{A}}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑯</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{H}}{\bm{Q}}={\bm{A}}^{\top}{\bm{A}}{\bm{Q}}</annotation></semantics></math> are all in <math id="chapter12.A3.p4.m2" class="ltx_Math" alttext="[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\lambda_{\min}\min_{i}q_{i},\lambda_{\max}\max_{i}q_{i}]</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma 12.9</span></span><span id="chapter12.Thmtheorem9.3" class="ltx_text ltx_font_bold"> </span>(Approximation Theorem for Regularized GRW)<span id="chapter12.Thmtheorem9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem9.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem9.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">For a wide fully-connected neural network <math id="chapter12.Thmtheorem9.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, denote <math id="chapter12.Thmtheorem9.p1.m2" class="ltx_Math" alttext="J(\theta)=\nabla_{\theta}f({\bm{X}};\theta)\in\mathbb{R}^{p\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">J(\theta)=\nabla_{\theta}f({\bm{X}};\theta)\in\mathbb{R}^{p\times n}</annotation></semantics></math> and <math id="chapter12.Thmtheorem9.p1.m3" class="ltx_Math" alttext="g(\theta)=\nabla_{\hat{y}}\ell(f({\bm{X}};\theta),{\bm{Y}})\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">g(\theta)=\nabla_{\hat{y}}\ell(f({\bm{X}};\theta),{\bm{Y}})\in\mathbb{R}^{n}</annotation></semantics></math>. Given that the loss function <math id="chapter12.Thmtheorem9.p1.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> satisfies: <math id="chapter12.Thmtheorem9.p1.m5" class="ltx_Math" alttext="\nabla_{\theta}g(\theta)=J(\theta){\bm{U}}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi>g</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐔</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}g(\theta)=J(\theta){\bm{U}}(\theta)</annotation></semantics></math> for any <math id="chapter12.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, and <math id="chapter12.Thmtheorem9.p1.m7" class="ltx_Math" alttext="{\bm{U}}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝐔</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}(\theta)</annotation></semantics></math> is a positive semi-definite diagonal matrix whose elements are uniformly bounded, we have: for any GRW that minimizes the regularized weighted empirical risk <a href="#S25.E30" title="In Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">30</span></a> with a sufficiently small learning rate <math id="chapter12.Thmtheorem9.p1.m8" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, there is: for a sufficiently large <math id="chapter12.Thmtheorem9.p1.m9" class="ltx_Math" alttext="\tilde{d}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>d</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{d}</annotation></semantics></math>, with high probability over random initialization, on any test point <math id="chapter12.Thmtheorem9.p1.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.Thmtheorem9.p1.m11" class="ltx_Math" alttext="\|x\|_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|x\|_{2}\leq 1</annotation></semantics></math>, we have</span></p>
<table id="chapter12.A3.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.E54.m1" class="ltx_math_unparsed" alttext="\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}\textrm{reg}}(x)-f^{(t)}_{\textrm{reg}}(x)\right|\leq C\tilde{d}^{-1/4}," display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext class="ltx_mathvariant_italic">reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>f</mi><mtext class="ltx_mathvariant_italic">reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{t\geq 0}\left|f^{(t)}_{\textnormal{lin}\textrm{reg}}(x)-f^{(t)}_{\textrm{reg}}(x)\right|\leq C\tilde{d}^{-1/4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="chapter12.Thmtheorem9.p1.2" class="ltx_p"><span id="chapter12.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">where both <math id="chapter12.Thmtheorem9.p1.m12" class="ltx_Math" alttext="f^{(t)}_{\textnormal{lin}\textrm{reg}}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext class="ltx_mathvariant_italic">reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f^{(t)}_{\textnormal{lin}\textrm{reg}}</annotation></semantics></math> and <math id="chapter12.Thmtheorem9.p1.m13" class="ltx_Math" alttext="f^{(t)}_{\textrm{reg}}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mtext class="ltx_mathvariant_italic">reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f^{(t)}_{\textrm{reg}}</annotation></semantics></math> are trained by the same regularized GRW and start from the same initial point.</span></p>
</div>
</div>
<div id="chapter12.A3.p5" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p5.1" class="ltx_p"><span id="chapter12.A3.p5.1.1" class="ltx_text ltx_font_bold">Proof </span>
Without loss of generality, assume that all elements of <math id="chapter12.A3.p5.m1" class="ltx_Math" alttext="{\bm{U}}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}(\theta)</annotation></semantics></math> are in <math id="chapter12.A3.p5.m2" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> for all <math id="chapter12.A3.p5.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, and set <math id="chapter12.A3.p5.m4" class="ltx_Math" alttext="\eta\leq(\mu+\lambda_{\min}+\lambda_{\max})^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\eta\leq(\mu+\lambda_{\min}+\lambda_{\max})^{-1}</annotation></semantics></math>.
If the elements of <math id="chapter12.A3.p5.m5" class="ltx_Math" alttext="{\bm{U}}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}(\theta)</annotation></semantics></math> are bounded by <math id="chapter12.A3.p5.m6" class="ltx_Math" alttext="[0,C]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>C</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,C]</annotation></semantics></math>, then we can set <math id="chapter12.A3.p5.m7" class="ltx_Math" alttext="\eta\leq(\mu+C\lambda_{\min}+C\lambda_{\max})^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\eta\leq(\mu+C\lambda_{\min}+C\lambda_{\max})^{-1}</annotation></semantics></math> and prove the result in the same way.</p>
</div>
<div id="chapter12.A3.p6" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p6.1" class="ltx_p">With <math id="chapter12.A3.p6.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> penalty, the update rule of the GRW for the neural network is:</p>
<table id="chapter12.A3.E55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.E55.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})-\eta\mu(\theta^{(t)}-\theta^{(0)})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})-\eta\mu(\theta^{(t)}-\theta^{(0)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="chapter12.A3.p6.2" class="ltx_p">And the update rule for the linearized neural network is:</p>
<table id="chapter12.A3.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.E56.m1" class="ltx_Math" alttext="\theta^{(t+1)}_{\textnormal{lin}}=\theta^{(t)}_{\textnormal{lin}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta_{\textnormal{lin}}^{(t)})-\eta\mu(\theta_{\textnormal{lin}}^{(t)}-\theta^{(0)})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}_{\textnormal{lin}}=\theta^{(t)}_{\textnormal{lin}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta_{\textnormal{lin}}^{(t)})-\eta\mu(\theta_{\textnormal{lin}}^{(t)}-\theta^{(0)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="chapter12.A3.p6.3" class="ltx_p">By <a href="#chapter12.Thmtheorem7" title="Proposition 12.7 ([], Proposition 1). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">12.7</span></a>, <math id="chapter12.A3.p6.m2" class="ltx_Math" alttext="f(x;\theta)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x;\theta)</annotation></semantics></math> converges in probability to a zero-mean Gaussian process. Thus, for any <math id="chapter12.A3.p6.m3" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, there exists a constant <math id="chapter12.A3.p6.m4" class="ltx_Math" alttext="R_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{0}&gt;0</annotation></semantics></math> such that with probability at least <math id="chapter12.A3.p6.m5" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>, <math id="chapter12.A3.p6.m6" class="ltx_Math" alttext="\left\|g(\theta^{(0)})\right\|_{2}&lt;R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|g(\theta^{(0)})\right\|_{2}&lt;R_{0}</annotation></semantics></math>.
Let <math id="chapter12.A3.p6.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be given by <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>. Denote <math id="chapter12.A3.p6.m8" class="ltx_Math" alttext="A=\eta MR_{0}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">A=\eta MR_{0}</annotation></semantics></math>, and let <math id="chapter12.A3.p6.m9" class="ltx_Math" alttext="C_{0}=\frac{4A}{\eta\mu}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">C_{0}=\frac{4A}{\eta\mu}</annotation></semantics></math> be given by <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>. Note that <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a> only depends on the network structure, but does not depend on the update rule, so we can still use the lemma here.
By <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>, there exists <math id="chapter12.A3.p6.m10" class="ltx_Math" alttext="D_{1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>1</mn></msub><annotation encoding="application/x-tex">D_{1}</annotation></semantics></math> such that for all <math id="chapter12.A3.p6.m11" class="ltx_Math" alttext="\tilde{d}\geq D_{1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{1}</annotation></semantics></math>, with probability at least <math id="chapter12.A3.p6.m12" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>, <a href="#chapter12.A2.E45" title="In Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">45</span></a> holds.</p>
</div>
<div id="chapter12.A3.p7" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p7.1" class="ltx_p">Similar to the proof of <a href="#chapter12.Thmtheorem8" title="Proposition 12.8. ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">12.8</span></a>, we can show that for any <math id="chapter12.A3.p7.m1" class="ltx_Math" alttext="\tilde{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\theta}</annotation></semantics></math>, all the non-zero eigenvalues of <math id="chapter12.A3.p7.m2" class="ltx_Math" alttext="J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}</annotation></semantics></math> are also eigenvalues of <math id="chapter12.A3.p7.m3" class="ltx_Math" alttext="J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})</annotation></semantics></math>.
This is because for any eigenvalue <math id="chapter12.A3.p7.m4" class="ltx_Math" alttext="\lambda\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\neq 0</annotation></semantics></math> such that <math id="chapter12.A3.p7.m5" class="ltx_Math" alttext="J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}{\bm{v}}=\lambda{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}{\bm{v}}=\lambda{\bm{v}}</annotation></semantics></math> for some <math id="chapter12.A3.p7.m6" class="ltx_Math" alttext="{\bm{v}}" display="inline" intent=":literal"><semantics><mi>𝒗</mi><annotation encoding="application/x-tex">{\bm{v}}</annotation></semantics></math>, we must have <math id="chapter12.A3.p7.m7" class="ltx_Math" alttext="J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})(J(\theta^{(0)})^{\top}{\bm{v}})=\lambda(J(\theta^{(0)})^{\top}{\bm{v}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})(J(\theta^{(0)})^{\top}{\bm{v}})=\lambda(J(\theta^{(0)})^{\top}{\bm{v}})</annotation></semantics></math>, and <math id="chapter12.A3.p7.m8" class="ltx_Math" alttext="J(\theta^{(0)})^{\top}{\bm{v}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">J(\theta^{(0)})^{\top}{\bm{v}}\neq 0</annotation></semantics></math> since <math id="chapter12.A3.p7.m9" class="ltx_Math" alttext="\lambda{\bm{v}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda{\bm{v}}\neq 0</annotation></semantics></math>, so <math id="chapter12.A3.p7.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is also an eigenvalue of <math id="chapter12.A3.p7.m11" class="ltx_Math" alttext="J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})</annotation></semantics></math>.
On the other hand, by <a href="#chapter6.Thmtheorem5" title="Lemma 6.5. ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6.5</span></a>, <math id="chapter12.A3.p7.m12" class="ltx_Math" alttext="J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})</annotation></semantics></math> converges in probability to <math id="chapter12.A3.p7.m13" class="ltx_Math" alttext="\Theta{\bm{Q}}^{(t)}U(\tilde{\theta})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta{\bm{Q}}^{(t)}U(\tilde{\theta})</annotation></semantics></math> whose eigenvalues are all in <math id="chapter12.A3.p7.m14" class="ltx_Math" alttext="[0,\lambda_{\max}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,\lambda_{\max}]</annotation></semantics></math> by <a href="#chapter12.Thmtheorem8" title="Proposition 12.8. ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">12.8</span></a>.
Hence, there exists <math id="chapter12.A3.p7.m15" class="ltx_Math" alttext="D_{2}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>2</mn></msub><annotation encoding="application/x-tex">D_{2}</annotation></semantics></math> such that for all <math id="chapter12.A3.p7.m16" class="ltx_Math" alttext="\tilde{d}\geq D_{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{2}</annotation></semantics></math>, with probability at least <math id="chapter12.A3.p7.m17" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>, the eigenvalues of <math id="chapter12.A3.p7.m18" class="ltx_Math" alttext="J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta})J(\theta^{(0)})^{\top}</annotation></semantics></math> are all in <math id="chapter12.A3.p7.m19" class="ltx_Math" alttext="[0,\lambda_{\max}+\lambda_{\min}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,\lambda_{\max}+\lambda_{\min}]</annotation></semantics></math> for all <math id="chapter12.A3.p7.m20" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A3.p8" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p8.2" class="ltx_p">By union bound, with probability at least <math id="chapter12.A3.p8.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, all the above “<math id="chapter12.A3.p8.m2" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>” statements are true.
Now we prove that there exists <math id="chapter12.A3.p8.m3" class="ltx_Math" alttext="D_{0}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>0</mn></msub><annotation encoding="application/x-tex">D_{0}</annotation></semantics></math> such that for all <math id="chapter12.A3.p8.m4" class="ltx_Math" alttext="\tilde{d}\geq D_{0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{0}</annotation></semantics></math>, <math id="chapter12.A3.p8.m5" class="ltx_Math" alttext="\sup_{t\geq 0}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>sup</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><msub><mrow><mo lspace="0em">‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\sup_{t\geq 0}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}</annotation></semantics></math> is bounded with high probability. Denote <math id="chapter12.A3.p8.m6" class="ltx_Math" alttext="a_{t}=\theta^{(t)}-\theta^{(0)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">a_{t}=\theta^{(t)}-\theta^{(0)}</annotation></semantics></math>.
By <a href="#chapter12.A3.E55" title="In Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">55</span></a>, we have</p>
<table id="chapter12.A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A3.Ex363"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex363.m1" class="ltx_Math" alttext="\displaystyle a_{t+1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle a_{t+1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex363.m2" class="ltx_Math" alttext="\displaystyle(1-\eta\mu)a_{t}-\eta[J(\theta^{(t)})-J(\theta^{(0)})]{\bm{Q}}^{(t)}g(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\eta\mu)a_{t}-\eta[J(\theta^{(t)})-J(\theta^{(0)})]{\bm{Q}}^{(t)}g(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex364"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex364.m1" class="ltx_Math" alttext="\displaystyle-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}[g(\theta^{(t)})-g(\theta^{(0)})]-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta^{(0)})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}[g(\theta^{(t)})-g(\theta^{(0)})]-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta^{(0)}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p8.3" class="ltx_p">which implies that</p>
<table id="chapter12.A3.E57" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter12.A3.E57X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.E57X.m2" class="ltx_Math" alttext="\displaystyle\left\|a_{t+1}\right\|_{2}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|a_{t+1}\right\|_{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.E57X.m3" class="ltx_Math" alttext="\displaystyle\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\left\|a_{t}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\left\|a_{t}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(57)</span></td></tr>
<tr id="chapter12.A3.E57Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.E57Xa.m2" class="ltx_Math" alttext="\displaystyle+\eta\left\|J(\theta^{(t)})-J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}+\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(0)})\right\|_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta\left\|J(\theta^{(t)})-J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}+\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(0)})\right\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p8.4" class="ltx_p">where <math id="chapter12.A3.p8.m7" class="ltx_Math" alttext="\tilde{\theta}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\theta}^{(t)}</annotation></semantics></math> is some linear interpolation between <math id="chapter12.A3.p8.m8" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> and <math id="chapter12.A3.p8.m9" class="ltx_Math" alttext="\theta^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(0)}</annotation></semantics></math>. Our choice of <math id="chapter12.A3.p8.m10" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> ensures that <math id="chapter12.A3.p8.m11" class="ltx_Math" alttext="\eta\mu&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\eta\mu&lt;1</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A3.p9" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p9.1" class="ltx_p">Next, we prove by induction that <math id="chapter12.A3.p9.m1" class="ltx_Math" alttext="{\left\|a_{t}\right\|}_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|a_{t}\right\|}_{2}&lt;C_{0}</annotation></semantics></math>.
It is true for <math id="chapter12.A3.p9.m2" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.
Suppose <math id="chapter12.A3.p9.m3" class="ltx_Math" alttext="{\left\|a_{t}\right\|}_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|a_{t}\right\|}_{2}&lt;C_{0}</annotation></semantics></math>, and consider <math id="chapter12.A3.p9.m4" class="ltx_Math" alttext="a_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">a_{t+1}</annotation></semantics></math>.
Let us look at the three terms on the right-hand side of <a href="#chapter12.A3.E57" title="In Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">57</span></a>.
For the first term, we have</p>
<table id="chapter12.A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A3.Ex365"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex365.m1" class="ltx_Math" alttext="\displaystyle\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex366"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex366.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex366.m2" class="ltx_Math" alttext="\displaystyle(1-\eta\mu)\left\|{\bm{I}}-\frac{\eta}{1-\eta\mu}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\theta^{(0)})^{\top}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle(1-\eta\mu)\left\|{\bm{I}}-\frac{\eta}{1-\eta\mu}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\theta^{(0)})^{\top}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex367"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex367.m1" class="ltx_Math" alttext="\displaystyle+\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right\|_{F}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right\|_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p9.2" class="ltx_p">Since <math id="chapter12.A3.p9.m5" class="ltx_Math" alttext="\eta/(1-\eta\mu)\leq(\lambda_{\min}+\lambda_{\max})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\eta/(1-\eta\mu)\leq(\lambda_{\min}+\lambda_{\max})^{-1}</annotation></semantics></math> by our choice of <math id="chapter12.A3.p9.m6" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, we have</p>
<table id="chapter12.A3.Ex368" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex368.m1" class="ltx_Math" alttext="\left\|{\bm{I}}-\frac{\eta}{1-\eta\mu}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\theta^{(0)})^{\top}\right\|_{2}\leq 1." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mfrac><mi>η</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|{\bm{I}}-\frac{\eta}{1-\eta\mu}J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\theta^{(0)})^{\top}\right\|_{2}\leq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p9.3" class="ltx_p">On the other hand, since <math id="chapter12.A3.p9.m7" class="ltx_Math" alttext="\left\|a_{t}\right\|_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|a_{t}\right\|_{2}&lt;C_{0}</annotation></semantics></math>, we have <math id="chapter12.A3.p9.m8" class="ltx_Math" alttext="\left\|J(\theta^{(0)})\right\|_{F}\left\|J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right\|_{F}\leq\frac{M^{2}}{\sqrt[4]{\tilde{d}}}C_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>≤</mo><mrow><mfrac><msup><mi>M</mi><mn>2</mn></msup><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|J(\theta^{(0)})\right\|_{F}\left\|J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right\|_{F}\leq\frac{M^{2}}{\sqrt[4]{\tilde{d}}}C_{0}</annotation></semantics></math> by <a href="#chapter12.A2.E45" title="In Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">45</span></a>. Therefore, there exists <math id="chapter12.A3.p9.m9" class="ltx_Math" alttext="D_{3}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>3</mn></msub><annotation encoding="application/x-tex">D_{3}</annotation></semantics></math> such that for all <math id="chapter12.A3.p9.m10" class="ltx_Math" alttext="\tilde{d}\geq D_{3}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{3}</annotation></semantics></math>,</p>
<table id="chapter12.A3.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.E58.m1" class="ltx_Math" alttext="\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\leq 1-\frac{\eta\mu}{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mn>2</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\leq 1-\frac{\eta\mu}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p10" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p10.2" class="ltx_p">For the second term, we have</p>
<table id="chapter12.A3.E59" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter12.A3.E59X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.E59X.m2" class="ltx_Math" alttext="\displaystyle\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.E59X.m3" class="ltx_Math" alttext="\displaystyle\leq\left\|g(\theta^{(t)})-g(\theta^{(0)})\right\|_{2}+\left\|g(\theta^{(0)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|g(\theta^{(t)})-g(\theta^{(0)})\right\|_{2}+\left\|g(\theta^{(0)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(59)</span></td></tr>
<tr id="chapter12.A3.E59Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.E59Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|J(\tilde{\theta}^{(t)})\right\|_{2}\left\|U(\tilde{\theta}^{(t)})\right\|_{2}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}+R_{0}\leq MC_{0}+R_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo>≤</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|J(\tilde{\theta}^{(t)})\right\|_{2}\left\|U(\tilde{\theta}^{(t)})\right\|_{2}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}+R_{0}\leq MC_{0}+R_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p11" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p11.1" class="ltx_p">For the third term, we have</p>
<table id="chapter12.A3.Ex369" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex369.m1" class="ltx_Math" alttext="\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(0)})\right\|_{2}\leq\eta MR_{0}=A." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo>=</mo><mi>A</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta\left\|J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(0)})\right\|_{2}\leq\eta MR_{0}=A.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p11.2" class="ltx_p">Thus, we have</p>
<table id="chapter12.A3.Ex370" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex370.m1" class="ltx_Math" alttext="\left\|a_{t+1}\right\|_{2}\leq\left(1-\frac{\eta\mu}{2}\right)\left\|a_{t}\right\|_{2}+\frac{\eta M(MC_{0}+R_{0})}{\sqrt[4]{\tilde{d}}}+A." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mn>2</mn></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo>+</mo><mi>A</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|a_{t+1}\right\|_{2}\leq\left(1-\frac{\eta\mu}{2}\right)\left\|a_{t}\right\|_{2}+\frac{\eta M(MC_{0}+R_{0})}{\sqrt[4]{\tilde{d}}}+A.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p11.3" class="ltx_p">Thus, there exists <math id="chapter12.A3.p11.m1" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math> such that for all <math id="chapter12.A3.p11.m2" class="ltx_Math" alttext="\tilde{d}\geq D_{4}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{4}</annotation></semantics></math>, <math id="chapter12.A3.p11.m3" class="ltx_Math" alttext="\left\|a_{t+1}\right\|_{2}\leq\left(1-\frac{\eta\mu}{2}\right)\left\|a_{t}\right\|_{2}+2A" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mn>2</mn></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|a_{t+1}\right\|_{2}\leq\left(1-\frac{\eta\mu}{2}\right)\left\|a_{t}\right\|_{2}+2A</annotation></semantics></math>. This shows that if <math id="chapter12.A3.p11.m4" class="ltx_Math" alttext="\left\|a_{t}\right\|_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|a_{t}\right\|_{2}&lt;C_{0}</annotation></semantics></math> is true, then <math id="chapter12.A3.p11.m5" class="ltx_Math" alttext="\left\|a_{t+1}\right\|_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|a_{t+1}\right\|_{2}&lt;C_{0}</annotation></semantics></math> will also be true.</p>
</div>
<div id="chapter12.A3.p12" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p12.1" class="ltx_p">In conclusion, for all <math id="chapter12.A3.p12.m1" class="ltx_Math" alttext="\tilde{d}\geq D_{0}=\max\{D_{1},D_{2},D_{3},D_{4}\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>D</mi><mn>1</mn></msub><mo>,</mo><msub><mi>D</mi><mn>2</mn></msub><mo>,</mo><msub><mi>D</mi><mn>3</mn></msub><mo>,</mo><msub><mi>D</mi><mn>4</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{0}=\max\{D_{1},D_{2},D_{3},D_{4}\}</annotation></semantics></math>, <math id="chapter12.A3.p12.m2" class="ltx_Math" alttext="\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}&lt;C_{0}</annotation></semantics></math> is true for all <math id="chapter12.A3.p12.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. This also implies that for <math id="chapter12.A3.p12.m4" class="ltx_Math" alttext="C_{1}=MC_{0}+R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">C_{1}=MC_{0}+R_{0}</annotation></semantics></math>, we have <math id="chapter12.A3.p12.m5" class="ltx_Math" alttext="\left\|g(\theta^{(t)})\right\|_{2}\leq C_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\left\|g(\theta^{(t)})\right\|_{2}\leq C_{1}</annotation></semantics></math> for all <math id="chapter12.A3.p12.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> by <a href="#chapter12.A3.E59" title="In Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">59</span></a>. Similarly, we can prove that <math id="chapter12.A3.p12.m7" class="ltx_Math" alttext="\|\theta_{\textnormal{lin}}^{(t)}-\theta^{(0)}\|_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\|\theta_{\textnormal{lin}}^{(t)}-\theta^{(0)}\|_{2}&lt;C_{0}</annotation></semantics></math> for all <math id="chapter12.A3.p12.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A3.p13" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p13.1" class="ltx_p">Second, let <math id="chapter12.A3.p13.m1" class="ltx_Math" alttext="\Delta_{t}=\theta_{\textnormal{lin}}^{(t)}-\theta^{(t)}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>=</mo><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}=\theta_{\textnormal{lin}}^{(t)}-\theta^{(t)}</annotation></semantics></math>. Then, we have</p>
<table id="chapter12.A3.Ex371" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex371.m1" class="ltx_Math" alttext="\Delta_{t+1}-\Delta_{t}=\eta(J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})-J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta_{\textnormal{lin}}^{(t)})-\mu\Delta_{t})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta_{t+1}-\Delta_{t}=\eta(J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})-J(\theta^{(0)}){\bm{Q}}^{(t)}g(\theta_{\textnormal{lin}}^{(t)})-\mu\Delta_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p13.2" class="ltx_p">which implies that</p>
<table id="chapter12.A3.Ex372" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex372.m1" class="ltx_Math" alttext="\Delta_{t+1}=\left[(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right]\Delta_{t}+\eta(J(\theta^{(t)})-J(\theta^{(0)})){\bm{Q}}^{(t)}g(\theta^{(t)})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta_{t+1}=\left[(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right]\Delta_{t}+\eta(J(\theta^{(t)})-J(\theta^{(0)})){\bm{Q}}^{(t)}g(\theta^{(t)}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p13.3" class="ltx_p">where <math id="chapter12.A3.p13.m2" class="ltx_Math" alttext="\tilde{\theta}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\theta}^{(t)}</annotation></semantics></math> is some linear interpolation between <math id="chapter12.A3.p13.m3" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> and <math id="chapter12.A3.p13.m4" class="ltx_Math" alttext="\theta_{\textnormal{lin}}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\theta_{\textnormal{lin}}^{(t)}</annotation></semantics></math>. By <a href="#chapter12.A3.E58" title="In Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">58</span></a>, with probability at least <math id="chapter12.A3.p13.m5" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> for all <math id="chapter12.A3.p13.m6" class="ltx_Math" alttext="\tilde{d}\geq D_{0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{0}</annotation></semantics></math>, we have</p>
<table id="chapter12.A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A3.Ex373"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex373.m1" class="ltx_Math" alttext="\displaystyle\left\|\Delta_{t+1}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\Delta_{t+1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex373.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\left\|\Delta_{t}\right\|_{2}+\eta\left\|J(\theta^{(t)})-J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|(1-\eta\mu){\bm{I}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}U(\tilde{\theta}^{(t)})J(\tilde{\theta}^{(t)})^{\top}\right\|_{2}\left\|\Delta_{t}\right\|_{2}+\eta\left\|J(\theta^{(t)})-J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex374"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex374.m1" class="ltx_Math" alttext="\displaystyle\leq\left(1-\frac{\eta\mu}{2}\right)\left\|\Delta_{t}\right\|_{2}+\eta\frac{M}{\sqrt[4]{\tilde{d}}}C_{0}C_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>M</mi><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1-\frac{\eta\mu}{2}\right)\left\|\Delta_{t}\right\|_{2}+\eta\frac{M}{\sqrt[4]{\tilde{d}}}C_{0}C_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p14" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p14.1" class="ltx_p">Again, as <math id="chapter12.A3.p14.m1" class="ltx_Math" alttext="\Delta_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{0}=0</annotation></semantics></math>, we can prove by induction that for all <math id="chapter12.A3.p14.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,</p>
<table id="chapter12.A3.Ex375" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex375.m1" class="ltx_math_unparsed" alttext="\left\|\Delta_{t}\right\|_{2}&lt;\frac{2MC_{0}C_{1}}{\mu}\tilde{d}^{-1/4}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mi>μ</mi></mfrac><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\Delta_{t}\right\|_{2}&lt;\frac{2MC_{0}C_{1}}{\mu}\tilde{d}^{-1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p15" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p15.1" class="ltx_p">For any test point <math id="chapter12.A3.p15.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A3.p15.m2" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>, we have</p>
<table id="chapter12.A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A3.Ex376"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A3.Ex376.m1" class="ltx_Math" alttext="\displaystyle\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex376.m2" class="ltx_Math" alttext="\displaystyle=\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)}_{\textnormal{lin}})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)}_{\textnormal{lin}})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex377"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex377.m1" class="ltx_Math" alttext="\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+\left|f_{\textnormal{lin}}(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)}_{\textnormal{lin}})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+\left|f_{\textnormal{lin}}(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)}_{\textnormal{lin}})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex378"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex378.m1" class="ltx_Math" alttext="\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+\left\|\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|\theta^{(t)}-\theta_{\textnormal{lin}}^{(t)}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+\left\|\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|\theta^{(t)}-\theta_{\textnormal{lin}}^{(t)}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A3.Ex379"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A3.Ex379.m1" class="ltx_Math" alttext="\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+M\left\|\Delta_{t}\right\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|+M\left\|\Delta_{t}\right\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p16" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p16.1" class="ltx_p">For the first term, note that</p>
<table id="chapter12.A3.Ex380" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex380.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} f(x;\theta^{(t)})-f(x;\theta^{(0)})&amp;=\nabla_{\theta}f(x;\tilde{\theta}^{(t)})(\theta^{(t)}-\theta^{(0)});\\
f_{\textnormal{lin}}(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(0)})&amp;=\nabla_{\theta}f(x;\theta^{(0)})(\theta^{(t)}-\theta^{(0)}),\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} f(x;\theta^{(t)})-f(x;\theta^{(0)})&amp;=\nabla_{\theta}f(x;\tilde{\theta}^{(t)})(\theta^{(t)}-\theta^{(0)});\\
f_{\textnormal{lin}}(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(0)})&amp;=\nabla_{\theta}f(x;\theta^{(0)})(\theta^{(t)}-\theta^{(0)}),\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p16.2" class="ltx_p">where <math id="chapter12.A3.p16.m1" class="ltx_Math" alttext="\tilde{\theta}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\theta}^{(t)}</annotation></semantics></math> is some linear interpolation between <math id="chapter12.A3.p16.m2" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> and <math id="chapter12.A3.p16.m3" class="ltx_Math" alttext="\theta^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(0)}</annotation></semantics></math>. Since <math id="chapter12.A3.p16.m4" class="ltx_Math" alttext="f(x;\theta^{(0)})=f_{\textnormal{lin}}(x;\theta^{(0)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x;\theta^{(0)})=f_{\textnormal{lin}}(x;\theta^{(0)})</annotation></semantics></math>,</p>
<table id="chapter12.A3.Ex381" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex381.m1" class="ltx_Math" alttext="\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|\leq\left\|\nabla_{\theta}f(x;\tilde{\theta}^{(t)})-\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}\leq\frac{M}{\sqrt[4]{\tilde{d}}}C_{0}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mfrac><mi>M</mi><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mn>0</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|f(x;\theta^{(t)})-f_{\textnormal{lin}}(x;\theta^{(t)})\right|\leq\left\|\nabla_{\theta}f(x;\tilde{\theta}^{(t)})-\nabla_{\theta}f(x;\theta^{(0)})\right\|_{2}\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}\leq\frac{M}{\sqrt[4]{\tilde{d}}}C_{0}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p16.3" class="ltx_p">Thus, for all <math id="chapter12.A3.p16.m5" class="ltx_Math" alttext="\tilde{d}\geq D_{0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{0}</annotation></semantics></math>, with probability at least <math id="chapter12.A3.p16.m6" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> for all <math id="chapter12.A3.p16.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and all <math id="chapter12.A3.p16.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>,</p>
<table id="chapter12.A3.Ex382" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex382.m1" class="ltx_math_unparsed" alttext="\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)\right|\leq\left(MC_{0}^{2}+\frac{2M^{2}C_{0}C_{1}}{\mu}\right)\tilde{d}^{-1/4}=O(\tilde{d}^{-1/4})," display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mrow><mo>(</mo><mi>M</mi><msubsup><mi>C</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mi>μ</mi></mfrac><mo>)</mo></mrow><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)\right|\leq\left(MC_{0}^{2}+\frac{2M^{2}C_{0}C_{1}}{\mu}\right)\tilde{d}^{-1/4}=O(\tilde{d}^{-1/4}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p16.4" class="ltx_p">which proves the lemma.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma 12.10</span></span><span id="chapter12.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem10.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem10.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Suppose there exists <math id="chapter12.Thmtheorem10.p1.m1" class="ltx_Math" alttext="M_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{0}&gt;0</annotation></semantics></math> such that <math id="chapter12.Thmtheorem10.p1.m2" class="ltx_Math" alttext="\left\|\nabla_{\theta}f^{(0)}(x)\right\|_{2}\leq M_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\left\|\nabla_{\theta}f^{(0)}(x)\right\|_{2}\leq M_{0}</annotation></semantics></math> for all <math id="chapter12.Thmtheorem10.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> within the unit ball.
If the gradients <math id="chapter12.Thmtheorem10.p1.m4" class="ltx_Math" alttext="\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})</annotation></semantics></math> are linearly independent, and the empirical training risk of <math id="chapter12.Thmtheorem10.p1.m5" class="ltx_Math" alttext="f_{\textnormal{lin}\textrm{reg}}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext class="ltx_mathvariant_italic">reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{\textnormal{lin}\textrm{reg}}^{(t)}</annotation></semantics></math> satisfies <math id="chapter12.Thmtheorem10.p1.m6" class="ltx_Math" alttext="\limsup_{t\rightarrow\infty}\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim sup</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext class="ltx_mathvariant_italic">reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\limsup_{t\rightarrow\infty}\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;\epsilon</annotation></semantics></math> for some <math id="chapter12.Thmtheorem10.p1.m7" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, then for any <math id="chapter12.Thmtheorem10.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> within the unit ball, we have</span></p>
<table id="chapter12.A3.Ex383" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex383.m1" class="ltx_Math" alttext="\limsup_{t\rightarrow\infty}\left|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)\right|=O(\sqrt{\epsilon})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim sup</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext class="ltx_mathvariant_italic">reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>ϵ</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\limsup_{t\rightarrow\infty}\left|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)\right|=O(\sqrt{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter12.A3.p17" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p17.1" class="ltx_p"><span id="chapter12.A3.p17.1.1" class="ltx_text ltx_font_bold">Proof </span>
First, for all <math id="chapter12.A3.p17.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> we have <math id="chapter12.A3.p17.m2" class="ltx_Math" alttext="\theta^{(t)}-\theta^{(0)}\in{\textnormal{span}}\{\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})\}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t)}-\theta^{(0)}\in{\textnormal{span}}\{\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n})\}</annotation></semantics></math>.
Let <math id="chapter12.A3.p17.m3" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> be the interpolator in <math id="chapter12.A3.p17.m4" class="ltx_Math" alttext="{\textnormal{span}}(\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n}))" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n}))</annotation></semantics></math>, then the empirical risk of <math id="chapter12.A3.p17.m5" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is <math id="chapter12.A3.p17.m6" class="ltx_Math" alttext="\frac{1}{2n}\sum_{i=1}^{n}\langle\theta-\theta^{*},\nabla_{\theta}f^{(0)}(x_{i})\rangle^{2}=\frac{1}{2n}\left\|\nabla_{\theta}f^{(0)}({\bm{X}})^{\top}(\theta-\theta^{*})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msup><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{2n}\sum_{i=1}^{n}\langle\theta-\theta^{*},\nabla_{\theta}f^{(0)}(x_{i})\rangle^{2}=\frac{1}{2n}\left\|\nabla_{\theta}f^{(0)}({\bm{X}})^{\top}(\theta-\theta^{*})\right\|_{2}^{2}</annotation></semantics></math>.
Thus, there exists <math id="chapter12.A3.p17.m7" class="ltx_Math" alttext="T&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T&gt;0</annotation></semantics></math> such that</p>
<table id="chapter12.A3.Ex384" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex384.m1" class="ltx_Math" alttext="\left\|\nabla_{\theta}f^{(0)}({\bm{X}})^{\top}(\theta^{(t)}-\theta^{*})\right\|_{2}^{2}\leq 2n\epsilon\qquad\text{for all }t\geq T." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>≥</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\nabla_{\theta}f^{(0)}({\bm{X}})^{\top}(\theta^{(t)}-\theta^{*})\right\|_{2}^{2}\leq 2n\epsilon\qquad\text{for all }t\geq T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p18" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p18.1" class="ltx_p">Let the smallest singular value of <math id="chapter12.A3.p18.m1" class="ltx_Math" alttext="\frac{1}{\sqrt{n}}\nabla_{\theta}f^{(0)}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{n}}\nabla_{\theta}f^{(0)}({\bm{X}})</annotation></semantics></math> be <math id="chapter12.A3.p18.m2" class="ltx_Math" alttext="s_{\min}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>min</mi></msub><annotation encoding="application/x-tex">s_{\min}</annotation></semantics></math>.
Then, we have <math id="chapter12.A3.p18.m3" class="ltx_Math" alttext="s_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s_{\min}&gt;0</annotation></semantics></math>.
Note that the column space of <math id="chapter12.A3.p18.m4" class="ltx_Math" alttext="\nabla_{\theta}f^{(0)}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f^{(0)}({\bm{X}})</annotation></semantics></math> is exactly <math id="chapter12.A3.p18.m5" class="ltx_Math" alttext="{\textnormal{span}}(\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n}))" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\nabla_{\theta}f^{(0)}(x_{1}),\cdots,\nabla_{\theta}f^{(0)}(x_{n}))</annotation></semantics></math>. Define <math id="chapter12.A3.p18.m6" class="ltx_Math" alttext="{\bm{H}}\in\mathbb{R}^{p\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑯</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{H}}\in\mathbb{R}^{p\times n}</annotation></semantics></math> such that its columns form an orthonormal basis of this subspace, then there exists <math id="chapter12.A3.p18.m7" class="ltx_Math" alttext="{\bm{G}}\in R^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑮</mi><mo>∈</mo><msup><mi>R</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}\in R^{n\times n}</annotation></semantics></math> such that <math id="chapter12.A3.p18.m8" class="ltx_Math" alttext="\nabla_{\theta}f^{(0)}({\bm{X}})={\bm{H}}{\bm{G}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝑯</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑮</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f^{(0)}({\bm{X}})={\bm{H}}{\bm{G}}</annotation></semantics></math>, and the smallest singular value of <math id="chapter12.A3.p18.m9" class="ltx_Math" alttext="\frac{1}{\sqrt{n}}{\bm{G}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑮</mi></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{n}}{\bm{G}}</annotation></semantics></math> is also <math id="chapter12.A3.p18.m10" class="ltx_Math" alttext="s_{\min}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>min</mi></msub><annotation encoding="application/x-tex">s_{\min}</annotation></semantics></math>. Since <math id="chapter12.A3.p18.m11" class="ltx_Math" alttext="\theta^{(t)}-\theta^{(0)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\theta^{(t)}-\theta^{(0)}</annotation></semantics></math> is also in this subspace, there exists <math id="chapter12.A3.p18.m12" class="ltx_Math" alttext="{\bm{v}}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}\in\mathbb{R}^{n}</annotation></semantics></math> such that <math id="chapter12.A3.p18.m13" class="ltx_Math" alttext="\theta^{(t)}-\theta^{*}={\bm{H}}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><mi>𝑯</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t)}-\theta^{*}={\bm{H}}{\bm{v}}</annotation></semantics></math>. Then we have <math id="chapter12.A3.p18.m14" class="ltx_Math" alttext="\sqrt{2n\epsilon}\geq\left\|{\bm{G}}^{\top}{\bm{H}}^{\top}{\bm{H}}{\bm{v}}\right\|_{2}=\left\|{\bm{G}}^{\top}{\bm{v}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><mo>≥</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝑮</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑯</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝑮</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\sqrt{2n\epsilon}\geq\left\|{\bm{G}}^{\top}{\bm{H}}^{\top}{\bm{H}}{\bm{v}}\right\|_{2}=\left\|{\bm{G}}^{\top}{\bm{v}}\right\|_{2}</annotation></semantics></math>. Thus, <math id="chapter12.A3.p18.m15" class="ltx_Math" alttext="\left\|{\bm{v}}\right\|_{2}\leq\frac{\sqrt{2\epsilon}}{s_{\min}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝒗</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mfrac><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><msub><mi>s</mi><mi>min</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\left\|{\bm{v}}\right\|_{2}\leq\frac{\sqrt{2\epsilon}}{s_{\min}}</annotation></semantics></math>, which implies that</p>
<table id="chapter12.A3.Ex385" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex385.m1" class="ltx_Math" alttext="\left\|\theta^{(t)}-\theta^{*}\right\|_{2}\leq\frac{\sqrt{2\epsilon}}{s_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mfrac><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><msub><mi>s</mi><mi>min</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\theta^{(t)}-\theta^{*}\right\|_{2}\leq\frac{\sqrt{2\epsilon}}{s_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A3.p19" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p19.1" class="ltx_p">We have already proved in the previous results that if we minimize the unregularized risk with ERM, then <math id="chapter12.A3.p19.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> always converges to the interpolator <math id="chapter12.A3.p19.m2" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math>. So for any <math id="chapter12.A3.p19.m3" class="ltx_Math" alttext="t\geq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\geq T</annotation></semantics></math> and any test point <math id="chapter12.A3.p19.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A3.p19.m5" class="ltx_Math" alttext="\left\|x\right\|_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\left\|x\right\|_{2}\leq 1</annotation></semantics></math>, we have</p>
<table id="chapter12.A3.Ex386" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex386.m1" class="ltx_Math" alttext="|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)|=|\langle\theta^{(t)}-\theta^{*},\nabla_{\theta}f^{(0)}(x)\rangle|\leq\frac{M_{0}\sqrt{2\epsilon}}{s_{\min}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow><msub><mi>s</mi><mi>min</mi></msub></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)|=|\langle\theta^{(t)}-\theta^{*},\nabla_{\theta}f^{(0)}(x)\rangle|\leq\frac{M_{0}\sqrt{2\epsilon}}{s_{\min}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p19.2" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.A3.p20" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p20.1" class="ltx_p">Now we prove <a href="#chapter6.Thmtheorem7" title="Theorem 6.7 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.7</span></a>.</p>
</div>
<div id="chapter12.A3.p21" class="ltx_para ltx_noindent">
<p id="chapter12.A3.p21.1" class="ltx_p"><span id="chapter12.A3.p21.1.1" class="ltx_text ltx_font_bold">Proof </span>
Given that <math id="chapter12.A3.p21.m1" class="ltx_Math" alttext="\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;\epsilon</annotation></semantics></math> for sufficiently large <math id="chapter12.A3.p21.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <a href="#chapter12.Thmtheorem9" title="Lemma 12.9 (Approximation Theorem for Regularized GRW). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.9</span></a> implies that</p>
<table id="chapter12.A3.Ex387" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex387.m1" class="ltx_math_unparsed" alttext="\left|\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})-\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})\right|=O(\tilde{d}^{-1/4}\sqrt{\epsilon}+\tilde{d}^{-1/2})." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msqrt><mi>ϵ</mi></msqrt><mo>+</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})-\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})\right|=O(\tilde{d}^{-1/4}\sqrt{\epsilon}+\tilde{d}^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p21.2" class="ltx_p">Thus, for a fixed <math id="chapter12.A3.p21.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, there exists <math id="chapter12.A3.p21.m4" class="ltx_Math" alttext="D&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D&gt;0</annotation></semantics></math> such that for all <math id="chapter12.A3.p21.m5" class="ltx_Math" alttext="d\geq D" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">d\geq D</annotation></semantics></math>, for sufficiently large <math id="chapter12.A3.p21.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,</p>
<table id="chapter12.A3.Ex388" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex388.m1" class="ltx_Math" alttext="\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})&lt;\epsilon\Rightarrow\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;2\epsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi><mo stretchy="false">⇒</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})&lt;\epsilon\Rightarrow\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;2\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p21.3" class="ltx_p">By <a href="#chapter12.Thmtheorem2" title="Lemma 12.2 (Approximation Theorem). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.2</span></a> and <a href="#chapter12.Thmtheorem9" title="Lemma 12.9 (Approximation Theorem for Regularized GRW). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.9</span></a>, we have</p>
<table id="chapter12.A3.Ex389" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex389.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} &amp;\sup_{t\geq 0}\left|f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)-f_{\textnormal{ERM}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4});\\
&amp;\sup_{t\geq 0}\left|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textrm{reg}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4}).\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>f</mi><msub><mrow></mrow><mrow><mtext>lin</mtext><mtext>ERM</mtext></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msub><mrow></mrow><mtext>ERM</mtext></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="false">|</mo><mo lspace="0.167em">=</mo><mi>O</mi><mo stretchy="false">(</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>f</mi><msub><mrow></mrow><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msub><mrow></mrow><mtext>reg</mtext></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo fence="false">|</mo><mo lspace="0.167em">=</mo><mi>O</mi><mo stretchy="false">(</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} &amp;\sup_{t\geq 0}\left|f_{\textnormal{lin}\textnormal{ERM}}^{(t)}(x)-f_{\textnormal{ERM}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4});\\
&amp;\sup_{t\geq 0}\left|f_{\textnormal{lin}\textrm{reg}}^{(t)}(x)-f_{\textrm{reg}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4}).\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p21.4" class="ltx_p">Combining these with <a href="#chapter12.Thmtheorem10" title="Lemma 12.10. ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.10</span></a> yields</p>
<table id="chapter12.A3.Ex390" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A3.Ex390.m1" class="ltx_math_unparsed" alttext="\limsup_{t\rightarrow\infty}\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{ERM}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4}+\sqrt{\epsilon})." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim sup</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>f</mi><mtext>ERM</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>+</mo><msqrt><mi>ϵ</mi></msqrt><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\limsup_{t\rightarrow\infty}\left|f_{\textrm{reg}}^{(t)}(x)-f_{\textnormal{ERM}}^{(t)}(x)\right|=O(\tilde{d}^{-1/4}+\sqrt{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A3.p21.5" class="ltx_p">Letting <math id="chapter12.A3.p21.m7" class="ltx_Math" alttext="\tilde{d}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\tilde{d}\rightarrow\infty</annotation></semantics></math> leads to the result we need.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.Thmtheorem11" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem11.2" class="ltx_text ltx_font_bold">Remark 12.11</span></span><span id="chapter12.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem11.p1" class="ltx_para">
<p id="chapter12.Thmtheorem11.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">One might wonder whether <math id="chapter12.Thmtheorem11.p1.m1" class="ltx_Math" alttext="\|\nabla_{\theta}f^{(0)}(x)\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\nabla_{\theta}f^{(0)}(x)\|_{2}</annotation></semantics></math> will diverge as <math id="chapter12.Thmtheorem11.p1.m2" class="ltx_Math" alttext="\tilde{d}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\tilde{d}\rightarrow\infty</annotation></semantics></math>.
In fact, in <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>, we have proved that there exists a constant <math id="chapter12.Thmtheorem11.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> such that with high probability, for any <math id="chapter12.Thmtheorem11.p1.m4" class="ltx_Math" alttext="\tilde{d}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>d</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{d}</annotation></semantics></math> there is <math id="chapter12.Thmtheorem11.p1.m5" class="ltx_Math" alttext="\|\nabla_{\theta}f^{(0)}(x)\|_{2}\leq M" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\|\nabla_{\theta}f^{(0)}(x)\|_{2}\leq M</annotation></semantics></math> for any <math id="chapter12.Thmtheorem11.p1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.Thmtheorem11.p1.m7" class="ltx_Math" alttext="\|x\|_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|x\|_{2}\leq 1</annotation></semantics></math>. Therefore, it is fine to suppose that there exists such an <math id="chapter12.Thmtheorem11.p1.m8" class="ltx_Math" alttext="M_{0}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>0</mn></msub><annotation encoding="application/x-tex">M_{0}</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="chapter12.A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.D </span>Proof of Theorem <a href="#chapter6.Thmtheorem8" title="Theorem 6.8 (Proof in ). ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.8</span></a></h2>

<div id="chapter12.A4.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A4.p1.1" class="ltx_p"><span id="chapter12.A4.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
First, we show that <math id="chapter12.A4.p1.m1" class="ltx_Math" alttext="\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><annotation encoding="application/x-tex">\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math> is unique.
Suppose both <math id="chapter12.A4.p1.m2" class="ltx_Math" alttext="\theta_{1}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\theta_{1}</annotation></semantics></math> and <math id="chapter12.A4.p1.m3" class="ltx_Math" alttext="\theta_{2}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\theta_{2}</annotation></semantics></math> maximize <math id="chapter12.A4.p1.m4" class="ltx_Math" alttext="\min_{i}y_{i}\cdot{\left\langle\theta,{\bm{x}}_{i}\right\rangle}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\min_{i}y_{i}\cdot{\left\langle\theta,{\bm{x}}_{i}\right\rangle}</annotation></semantics></math> and <math id="chapter12.A4.p1.m5" class="ltx_Math" alttext="{\left\|\theta_{1}\right\|}_{2}={\left\|\theta_{2}\right\|}_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>θ</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><msub><mi>θ</mi><mn>2</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|\theta_{1}\right\|}_{2}={\left\|\theta_{2}\right\|}_{2}=1</annotation></semantics></math>.
If <math id="chapter12.A4.p1.m6" class="ltx_Math" alttext="\theta_{1}\neq\theta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\theta_{1}\neq\theta_{2}</annotation></semantics></math>, then we define <math id="chapter12.A4.p1.m7" class="ltx_Math" alttext="\theta=(\theta_{1}+\theta_{2})/2" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\theta=(\theta_{1}+\theta_{2})/2</annotation></semantics></math> and <math id="chapter12.A4.p1.m8" class="ltx_Math" alttext="\theta_{0}=\theta/{\left\|\theta\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>θ</mi><mo>/</mo><msub><mrow><mo>‖</mo><mi>θ</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\theta_{0}=\theta/{\left\|\theta\right\|}_{2}</annotation></semantics></math>. Obviously, <math id="chapter12.A4.p1.m9" class="ltx_Math" alttext="{\left\|\theta\right\|}_{2}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>θ</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|\theta\right\|}_{2}&lt;1</annotation></semantics></math>, and for all <math id="chapter12.A4.p1.m10" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math> there is <math id="chapter12.A4.p1.m11" class="ltx_Math" alttext="y_{i}{\left\langle\theta,{\bm{x}}_{i}\right\rangle}=(y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle}+y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle})/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">y_{i}{\left\langle\theta,{\bm{x}}_{i}\right\rangle}=(y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle}+y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle})/2</annotation></semantics></math>.
Thus, we have <math id="chapter12.A4.p1.m12" class="ltx_Math" alttext="y_{i}{\left\langle\theta_{0},{\bm{x}}_{i}\right\rangle}&gt;\min{\left\{y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle},y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{i}{\left\langle\theta_{0},{\bm{x}}_{i}\right\rangle}&gt;\min{\left\{y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle},y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle}\right\}}</annotation></semantics></math>,
which implies that <math id="chapter12.A4.p1.m13" class="ltx_Math" alttext="\min_{i}y_{i}{\left\langle\theta_{0},{\bm{x}}_{i}\right\rangle}&gt;\min{\left\{\min_{i}y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle},\min_{i}y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{i}y_{i}{\left\langle\theta_{0},{\bm{x}}_{i}\right\rangle}&gt;\min{\left\{\min_{i}y_{i}{\left\langle\theta_{1},{\bm{x}}_{i}\right\rangle},\min_{i}y_{i}{\left\langle\theta_{2},{\bm{x}}_{i}\right\rangle}\right\}}</annotation></semantics></math>, which contradicts the fact that <math id="chapter12.A4.p1.m14" class="ltx_Math" alttext="\theta_{1},\theta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\theta_{1},\theta_{2}</annotation></semantics></math> are max-margin classifiers.</p>
</div>
<div id="chapter12.A4.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A4.p2.1" class="ltx_p">Without loss of generality, let <math id="chapter12.A4.p2.m1" class="ltx_Math" alttext="({\bm{x}}_{1},y_{1}),\cdots,({\bm{x}}_{m},y_{m})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>m</mi></msub><mo>,</mo><msub><mi>y</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">({\bm{x}}_{1},y_{1}),\cdots,({\bm{x}}_{m},y_{m})</annotation></semantics></math> be the samples with the smallest margin for <math id="chapter12.A4.p2.m2" class="ltx_Math" alttext="{\bm{u}}" display="inline" intent=":literal"><semantics><mi>𝒖</mi><annotation encoding="application/x-tex">{\bm{u}}</annotation></semantics></math>, that is <math id="chapter12.A4.p2.m3" class="ltx_Math" alttext="\argmin_{i}y_{i}{\left\langle{\bm{u}},{\bm{x}}_{i}\right\rangle}={\left\{1,\cdots,m\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>i</mi></msub><mo>⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>𝐮</mi><mo>,</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>m</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\argmin_{i}y_{i}{\left\langle{\bm{u}},{\bm{x}}_{i}\right\rangle}={\left\{1,\cdots,m\right\}}</annotation></semantics></math>.
Denote <math id="chapter12.A4.p2.m4" class="ltx_Math" alttext="\gamma=\min_{i}y_{i}{\left\langle{\bm{u}},{\bm{x}}_{i}\right\rangle}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\min_{i}y_{i}{\left\langle{\bm{u}},{\bm{x}}_{i}\right\rangle}</annotation></semantics></math>; then, <math id="chapter12.A4.p2.m5" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math> since the training error converges to zero. Note that for the logistic loss, if <math id="chapter12.A4.p2.m6" class="ltx_Math" alttext="y_{i}{\left\langle\theta,{\bm{x}}_{i}\right\rangle}&lt;y_{j}{\left\langle\theta,{\bm{x}}_{j}\right\rangle}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>j</mi></msub></mrow><mo>⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{i}{\left\langle\theta,{\bm{x}}_{i}\right\rangle}&lt;y_{j}{\left\langle\theta,{\bm{x}}_{j}\right\rangle}</annotation></semantics></math>, then for any <math id="chapter12.A4.p2.m7" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math>, there exists an <math id="chapter12.A4.p2.m8" class="ltx_Math" alttext="R_{M}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>M</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{M}&gt;0</annotation></semantics></math> such that for all <math id="chapter12.A4.p2.m9" class="ltx_Math" alttext="R\geq R_{M}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><msub><mi>R</mi><mi>M</mi></msub></mrow><annotation encoding="application/x-tex">R\geq R_{M}</annotation></semantics></math>, there is <math id="chapter12.A4.p2.m10" class="ltx_Math" alttext="\frac{\nabla_{\theta}\ell(\langle R\theta,{\bm{x}}_{i}\rangle,y_{i})}{\nabla_{\theta}\ell(\langle R\theta,{\bm{x}}_{j}\rangle,y_{j})}&gt;M" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>,</mo><msub><mi>𝒙</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>&gt;</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\frac{\nabla_{\theta}\ell(\langle R\theta,{\bm{x}}_{i}\rangle,y_{i})}{\nabla_{\theta}\ell(\langle R\theta,{\bm{x}}_{j}\rangle,y_{j})}&gt;M</annotation></semantics></math>.
Since the training error converges to zero, we have <math id="chapter12.A4.p2.m11" class="ltx_Math" alttext="{\left\|\theta^{(t)}\right\|}_{2}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">{\left\|\theta^{(t)}\right\|}_{2}\rightarrow\infty</annotation></semantics></math>.
So when <math id="chapter12.A4.p2.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is sufficiently large, the impact of <math id="chapter12.A4.p2.m13" class="ltx_Math" alttext="({\bm{x}}_{j},y_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>j</mi></msub><mo>,</mo><msub><mi>y</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}}_{j},y_{j})</annotation></semantics></math> on <math id="chapter12.A4.p2.m14" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> for <math id="chapter12.A4.p2.m15" class="ltx_Math" alttext="j&gt;m" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&gt;</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">j&gt;m</annotation></semantics></math> is an infinitesimal compared to <math id="chapter12.A4.p2.m16" class="ltx_Math" alttext="j\leq m" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">j\leq m</annotation></semantics></math> since <math id="chapter12.A4.p2.m17" class="ltx_Math" alttext="\liminf_{t\rightarrow\infty}q_{j}^{(t)}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim inf</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mi>q</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\liminf_{t\rightarrow\infty}q_{j}^{(t)}&gt;0</annotation></semantics></math>.
Thus, we must have <math id="chapter12.A4.p2.m18" class="ltx_Math" alttext="{\bm{u}}\in{\textnormal{span}}{\left\{{\bm{x}}_{1},\cdots,{\bm{x}}_{m}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒙</mi><mi>m</mi></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}\in{\textnormal{span}}{\left\{{\bm{x}}_{1},\cdots,{\bm{x}}_{m}\right\}}</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A4.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A4.p3.1" class="ltx_p">Let <math id="chapter12.A4.p3.m1" class="ltx_Math" alttext="{\bm{u}}=\alpha_{1}y_{1}{\bm{x}}_{1}+\cdots+\alpha_{m}y_{m}{\bm{x}}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mn>1</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi>α</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>m</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}=\alpha_{1}y_{1}{\bm{x}}_{1}+\cdots+\alpha_{m}y_{m}{\bm{x}}_{m}</annotation></semantics></math>. Now we show that <math id="chapter12.A4.p3.m2" class="ltx_Math" alttext="\alpha_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{i}\geq 0</annotation></semantics></math> for all <math id="chapter12.A4.p3.m3" class="ltx_Math" alttext="i=1,\cdots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\cdots,m</annotation></semantics></math>.
For a sufficiently large <math id="chapter12.A4.p3.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, there is <math id="chapter12.A4.p3.m5" class="ltx_Math" alttext="\theta^{(t+1)}-\theta^{(t)}\approx\eta\sum_{i=1}^{m}\frac{q_{i}^{(t)}\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}{1+\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}y_{i}{\bm{x}}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>≈</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mfrac><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}-\theta^{(t)}\approx\eta\sum_{i=1}^{m}\frac{q_{i}^{(t)}\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}{1+\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}y_{i}{\bm{x}}_{i}</annotation></semantics></math>.
Since <math id="chapter12.A4.p3.m6" class="ltx_Math" alttext="{\left\|\theta^{(t)}\right\|}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">{\left\|\theta^{(t)}\right\|}\rightarrow\infty</annotation></semantics></math>, for all <math id="chapter12.A4.p3.m7" class="ltx_Math" alttext="i\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m]</annotation></semantics></math> we have <math id="chapter12.A4.p3.m8" class="ltx_Math" alttext="\alpha_{i}\propto\lim_{T\rightarrow\infty}\sum_{t=T_{0}}^{T}\frac{q_{i}^{(t)}\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}{1+\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}:=\lim_{T\rightarrow\infty}\alpha_{i}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo rspace="0.1389em">∝</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">lim</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><msub><mi>T</mi><mn>0</mn></msub></mrow><mi>T</mi></msubsup><mfrac><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}\propto\lim_{T\rightarrow\infty}\sum_{t=T_{0}}^{T}\frac{q_{i}^{(t)}\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}{1+\exp(y_{i}\cdot\langle\theta^{(t)},{\bm{x}}_{i}\rangle)}:=\lim_{T\rightarrow\infty}\alpha_{i}(T)</annotation></semantics></math>, where <math id="chapter12.A4.p3.m9" class="ltx_Math" alttext="T_{0}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>0</mn></msub><annotation encoding="application/x-tex">T_{0}</annotation></semantics></math> is sufficiently large.
Here the notion <math id="chapter12.A4.p3.m10" class="ltx_Math" alttext="\alpha_{i}\propto\lim_{T\rightarrow\infty}\alpha_{i}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo rspace="0.1389em">∝</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}\propto\lim_{T\rightarrow\infty}\alpha_{i}(T)</annotation></semantics></math> means that <math id="chapter12.A4.p3.m11" class="ltx_Math" alttext="\lim_{T\rightarrow\infty}\frac{\alpha_{i}(T)}{\alpha_{j}(T)}=\frac{\alpha_{i}}{\alpha_{j}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>α</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>=</mo><mfrac><msub><mi>α</mi><mi>i</mi></msub><msub><mi>α</mi><mi>j</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\lim_{T\rightarrow\infty}\frac{\alpha_{i}(T)}{\alpha_{j}(T)}=\frac{\alpha_{i}}{\alpha_{j}}</annotation></semantics></math> for any pair of <math id="chapter12.A4.p3.m12" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math> and <math id="chapter12.A4.p3.m13" class="ltx_Math" alttext="\alpha_{j}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{j}\neq 0</annotation></semantics></math>. Note that each term in the sum is non-negative. This implies that <math id="chapter12.A4.p3.m14" class="ltx_Math" alttext="\alpha_{1},\cdots,\alpha_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>α</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{1},\cdots,\alpha_{m}</annotation></semantics></math> have the same sign.
Meanwhile, <math id="chapter12.A4.p3.m15" class="ltx_Math" alttext="\sum_{i=1}^{m}\alpha_{i}\gamma=\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle=\langle{\bm{u}},{\bm{u}}\rangle&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}\alpha_{i}\gamma=\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle=\langle{\bm{u}},{\bm{u}}\rangle&gt;0</annotation></semantics></math>. Thus <math id="chapter12.A4.p3.m16" class="ltx_Math" alttext="\alpha_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{i}\geq 0</annotation></semantics></math> for all <math id="chapter12.A4.p3.m17" class="ltx_Math" alttext="i\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m]</annotation></semantics></math> and at least one is positive.
Now suppose <math id="chapter12.A4.p3.m18" class="ltx_Math" alttext="{\bm{u}}\neq\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>≠</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}\neq\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>, which means that <math id="chapter12.A4.p3.m19" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is smaller than the margin of <math id="chapter12.A4.p3.m20" class="ltx_Math" alttext="\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><annotation encoding="application/x-tex">\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>.
Then, for all <math id="chapter12.A4.p3.m21" class="ltx_Math" alttext="i=1,\cdots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\cdots,m</annotation></semantics></math>, there is <math id="chapter12.A4.p3.m22" class="ltx_Math" alttext="y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle&lt;y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},{\bm{x}}_{i}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle&lt;y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},{\bm{x}}_{i}\rangle</annotation></semantics></math>. This implies that <math id="chapter12.A4.p3.m23" class="ltx_Math" alttext="\langle{\bm{u}},{\bm{u}}\rangle=\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle&lt;\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},{\bm{x}}_{i}\rangle=\langle\hat{\theta}_{\textnormal{MM}},{\bm{u}}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝒖</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.111em">&lt;</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\langle{\bm{u}},{\bm{u}}\rangle=\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle{\bm{u}},{\bm{x}}_{i}\rangle&lt;\sum_{i=1}^{m}\alpha_{i}y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},{\bm{x}}_{i}\rangle=\langle\hat{\theta}_{\textnormal{MM}},{\bm{u}}\rangle</annotation></semantics></math>,
which is a contradiction. Thus, <math id="chapter12.A4.p3.m24" class="ltx_Math" alttext="{\bm{u}}=\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>=</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}=\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter12.A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.E </span>Proof of Theorem <a href="#chapter6.Thmtheorem10" title="Theorem 6.10 (Proof in ). ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.10</span></a></h2>

<div id="chapter12.A5.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p1.1" class="ltx_p"><span id="chapter12.A5.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Denote the largest and smallest eigenvalues of <math id="chapter12.A5.p1.m1" class="ltx_Math" alttext="{\bm{X}}^{\top}{\bm{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><annotation encoding="application/x-tex">{\bm{X}}^{\top}{\bm{X}}</annotation></semantics></math> by <math id="chapter12.A5.p1.m2" class="ltx_Math" alttext="\lambda^{\max}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>max</mi></msup><annotation encoding="application/x-tex">\lambda^{\max}</annotation></semantics></math> and <math id="chapter12.A5.p1.m3" class="ltx_Math" alttext="\lambda^{\min}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mi>min</mi></msup><annotation encoding="application/x-tex">\lambda^{\min}</annotation></semantics></math>, and by condition we have <math id="chapter12.A5.p1.m4" class="ltx_Math" alttext="\lambda^{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mi>min</mi></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda^{\min}&gt;0</annotation></semantics></math>. Let <math id="chapter12.A5.p1.m5" class="ltx_Math" alttext="\epsilon=\min\{\frac{q^{*}}{3},\frac{(q^{*}\lambda^{\min})^{2}}{192\lambda^{\max 2}}\}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mfrac><msup><mi>q</mi><mo>∗</mo></msup><mn>3</mn></mfrac><mo>,</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>192</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow></msup></mrow></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon=\min\{\frac{q^{*}}{3},\frac{(q^{*}\lambda^{\min})^{2}}{192\lambda^{\max 2}}\}</annotation></semantics></math>.
Then, similar to the proof in <a href="#chapter12.A1" title="Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">12.A</span></a>, there exists <math id="chapter12.A5.p1.m6" class="ltx_Math" alttext="t_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">t_{\epsilon}</annotation></semantics></math> such that for all <math id="chapter12.A5.p1.m7" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math> and all <math id="chapter12.A5.p1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="chapter12.A5.p1.m9" class="ltx_Math" alttext="q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)</annotation></semantics></math>. Denote <math id="chapter12.A5.p1.m10" class="ltx_Math" alttext="{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})</annotation></semantics></math>, then for all <math id="chapter12.A5.p1.m11" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, <math id="chapter12.A5.p1.m12" class="ltx_Math" alttext="{\bm{Q}}^{(t)}:={\bm{Q}}_{\epsilon}^{(t)}=\sqrt{{\bm{Q}}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{(t)}:={\bm{Q}}_{\epsilon}^{(t)}=\sqrt{{\bm{Q}}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}</annotation></semantics></math>, where we use the subscript <math id="chapter12.A5.p1.m13" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> to indicate that <math id="chapter12.A5.p1.m14" class="ltx_Math" alttext="\left\|{\bm{Q}}_{\epsilon}^{(t)}-{\bm{Q}}\right\|_{2}&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mi>𝑸</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\left\|{\bm{Q}}_{\epsilon}^{(t)}-{\bm{Q}}\right\|_{2}&lt;\epsilon</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A5.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p2.1" class="ltx_p">First, we prove that <math id="chapter12.A5.p2.m1" class="ltx_Math" alttext="F(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta)</annotation></semantics></math> is <math id="chapter12.A5.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth if <math id="chapter12.A5.p2.m3" class="ltx_Math" alttext="\|x_{i}\|_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|x_{i}\|_{2}\leq 1</annotation></semantics></math> for all <math id="chapter12.A5.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. The gradient of <math id="chapter12.A5.p2.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is</p>
<table id="chapter12.A5.Ex391" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex391.m1" class="ltx_Math" alttext="\nabla F(\theta)=\sum_{i=1}^{n}q_{i}\nabla_{\hat{y}}\ell(\langle\theta,{\bm{x}}_{i}\rangle,y_{i}){\bm{x}}_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla F(\theta)=\sum_{i=1}^{n}q_{i}\nabla_{\hat{y}}\ell(\langle\theta,{\bm{x}}_{i}\rangle,y_{i}){\bm{x}}_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A5.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p3.1" class="ltx_p">Since <math id="chapter12.A5.p3.m1" class="ltx_Math" alttext="\ell(\hat{y},y)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\hat{y},y)</annotation></semantics></math> is <math id="chapter12.A5.p3.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth in <math id="chapter12.A5.p3.m3" class="ltx_Math" alttext="\hat{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{y}</annotation></semantics></math>, for any <math id="chapter12.A5.p3.m4" class="ltx_Math" alttext="\theta_{1},\theta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\theta_{1},\theta_{2}</annotation></semantics></math> and any <math id="chapter12.A5.p3.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have</p>
<table id="chapter12.A5.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A5.Ex392"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex392.m1" class="ltx_Math" alttext="\displaystyle\ell(\langle\theta_{2},{\bm{x}}_{i}\rangle,y_{i})-\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell(\langle\theta_{2},{\bm{x}}_{i}\rangle,y_{i})-\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex393"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex393.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex393.m2" class="ltx_Math" alttext="\displaystyle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot(\langle\theta_{2},{\bm{x}}_{i}\rangle-\langle\theta_{1},{\bm{x}}_{i}\rangle)+\frac{L}{2}(\langle\theta_{2},{\bm{x}}_{i}\rangle-\langle\theta_{1},{\bm{x}}_{i}\rangle)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot(\langle\theta_{2},{\bm{x}}_{i}\rangle-\langle\theta_{1},{\bm{x}}_{i}\rangle)+\frac{L}{2}(\langle\theta_{2},{\bm{x}}_{i}\rangle-\langle\theta_{1},{\bm{x}}_{i}\rangle)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex394"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex394.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex394.m2" class="ltx_Math" alttext="\displaystyle\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}(\langle\theta_{2}-\theta_{1},{\bm{x}}_{i}\rangle)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}(\langle\theta_{2}-\theta_{1},{\bm{x}}_{i}\rangle)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex395"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex395.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex395.m2" class="ltx_Math" alttext="\displaystyle\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p3.2" class="ltx_p">Thus, we have</p>
<table id="chapter12.A5.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A5.Ex396"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex396.m1" class="ltx_Math" alttext="\displaystyle F(\theta_{2})-F(\theta_{1})=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F(\theta_{2})-F(\theta_{1})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex396.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{n}q_{i}\left[\ell(\langle\theta_{2},{\bm{x}}_{i}\rangle,y_{i})-\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{n}q_{i}\left[\ell(\langle\theta_{2},{\bm{x}}_{i}\rangle,y_{i})-\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex397"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex397.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex397.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{n}q_{i}\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\sum_{i=1}^{n}q_{i}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{n}q_{i}\langle\nabla_{\hat{y}}\ell(\langle\theta_{1},{\bm{x}}_{i}\rangle,y_{i})\cdot{\bm{x}}_{i},\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\sum_{i=1}^{n}q_{i}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex398"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex398.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex398.m2" class="ltx_Math" alttext="\displaystyle\langle\nabla F(\theta_{1}),\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\nabla F(\theta_{1}),\theta_{2}-\theta_{1}\rangle+\frac{L}{2}\left\|\theta_{2}-\theta_{1}\right\|_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p3.3" class="ltx_p">which implies that <math id="chapter12.A5.p3.m6" class="ltx_Math" alttext="F(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta)</annotation></semantics></math> is <math id="chapter12.A5.p3.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth.</p>
</div>
<div id="chapter12.A5.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p4.1" class="ltx_p">Denote <math id="chapter12.A5.p4.m1" class="ltx_Math" alttext="\tilde{g}(\theta)=\nabla_{\hat{y}}\ell(f({\bm{X}};\theta),{\bm{Y}})\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝒀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\tilde{g}(\theta)=\nabla_{\hat{y}}\ell(f({\bm{X}};\theta),{\bm{Y}})\in\mathbb{R}^{n}</annotation></semantics></math>, then <math id="chapter12.A5.p4.m2" class="ltx_Math" alttext="\nabla F(\theta^{(t)})={\bm{X}}{\bm{Q}}\tilde{g}(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla F(\theta^{(t)})={\bm{X}}{\bm{Q}}\tilde{g}(\theta^{(t)})</annotation></semantics></math>, and the update rule is</p>
<table id="chapter12.A5.E60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.E60.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="chapter12.A5.p4.2" class="ltx_p">So by <a href="#chapter6.Thmtheorem9" title="Definition 6.9. ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">6.9</span></a>, we have</p>
<table id="chapter12.A5.E61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.E61.m1" class="ltx_Math" alttext="F(\theta^{(t+1)})\leq F(\theta^{(t)})-\eta\langle{\bm{X}}{\bm{Q}}\tilde{g}(\theta^{(t)}),{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\rangle+\frac{\eta^{2}L}{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})\leq F(\theta^{(t)})-\eta\langle{\bm{X}}{\bm{Q}}\tilde{g}(\theta^{(t)}),{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\rangle+\frac{\eta^{2}L}{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
</table>
</div>
<div id="chapter12.A5.p5" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p5.1" class="ltx_p">Let <math id="chapter12.A5.p5.m1" class="ltx_Math" alttext="\eta_{1}=\frac{q^{*}\lambda^{\min}}{2L(1+3\epsilon)\lambda^{\max}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>max</mi></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta_{1}=\frac{q^{*}\lambda^{\min}}{2L(1+3\epsilon)\lambda^{\max}}</annotation></semantics></math>. Similar to the proof in <a href="#chapter12.A1" title="Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">12.A</span></a>, we can prove that for all <math id="chapter12.A5.p5.m2" class="ltx_Math" alttext="\eta\leq\eta_{1}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{1}</annotation></semantics></math>, and for all <math id="chapter12.A5.p5.m3" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A5.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A5.Ex399"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex399.m1" class="ltx_Math" alttext="\displaystyle F(\theta^{(t+1)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(\theta^{(t+1)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex399.m2" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}+\frac{\eta^{2}L}{2}\left\|{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}^{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}+\frac{\eta^{2}L}{2}\left\|{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}^{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex400"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex400.m1" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}+\frac{\eta^{2}L}{2}\left\|{\bm{X}}\right\|_{2}^{2}(1+3\epsilon)\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝑿</mi><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{2}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}+\frac{\eta^{2}L}{2}\left\|{\bm{X}}\right\|_{2}^{2}(1+3\epsilon)\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex401"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex401.m1" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{4}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*}\lambda^{\min}}{4}\left\|\sqrt{{\bm{Q}}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex402"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex402.m1" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*2}\lambda^{\min}}{4}\left\|\tilde{g}(\theta^{(t)})\right\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-\frac{\eta q^{*2}\lambda^{\min}}{4}\left\|\tilde{g}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p5.2" class="ltx_p">This implies that <math id="chapter12.A5.p5.m4" class="ltx_Math" alttext="F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})</annotation></semantics></math> is monotonically non-increasing. Since <math id="chapter12.A5.p5.m5" class="ltx_Math" alttext="F(\theta)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(\theta)\geq 0</annotation></semantics></math>, <math id="chapter12.A5.p5.m6" class="ltx_Math" alttext="F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})</annotation></semantics></math> must converge as <math id="chapter12.A5.p5.m7" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>, and we need to prove that it converges to 0. Suppose that <math id="chapter12.A5.p5.m8" class="ltx_Math" alttext="F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})</annotation></semantics></math> does not converge to 0, then there exists a constant <math id="chapter12.A5.p5.m9" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> such that <math id="chapter12.A5.p5.m10" class="ltx_Math" alttext="F(\theta^{(t)})\geq 2C" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})\geq 2C</annotation></semantics></math> for all <math id="chapter12.A5.p5.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. On the other hand, it is easy to see that there exists <math id="chapter12.A5.p5.m12" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> such that <math id="chapter12.A5.p5.m13" class="ltx_Math" alttext="\ell(\langle\theta^{*},{\bm{x}}_{i}\rangle,y_{i})&lt;C" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\ell(\langle\theta^{*},{\bm{x}}_{i}\rangle,y_{i})&lt;C</annotation></semantics></math> for all <math id="chapter12.A5.p5.m14" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
The above inequality also implies that <math id="chapter12.A5.p5.m15" class="ltx_Math" alttext="\left\|\tilde{g}(\theta^{(t)})\right\|_{2}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left\|\tilde{g}(\theta^{(t)})\right\|_{2}\rightarrow 0</annotation></semantics></math> as <math id="chapter12.A5.p5.m16" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math> because we must have <math id="chapter12.A5.p5.m17" class="ltx_Math" alttext="F(\theta^{(t)})-F(\theta^{(t+1)})\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})-F(\theta^{(t+1)})\rightarrow 0</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A5.p6" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p6.1" class="ltx_p">Note that by <a href="#chapter12.A5.E60" title="In Appendix 12.E Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">60</span></a>, we have</p>
<table id="chapter12.A5.Ex403" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex403.m1" class="ltx_Math" alttext="\left\|\theta^{(t+1)}-\theta^{*}\right\|_{2}^{2}=\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}+2\eta\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),\theta^{*}-\theta^{(t)}\rangle+\eta^{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\theta^{(t+1)}-\theta^{*}\right\|_{2}^{2}=\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}+2\eta\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),\theta^{*}-\theta^{(t)}\rangle+\eta^{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p6.2" class="ltx_p">Define <math id="chapter12.A5.p6.m1" class="ltx_Math" alttext="F_{t}(\theta)=\sum_{i=1}^{n}q_{i}^{(t)}\ell(\langle\theta,{\bm{x}}_{i}\rangle,y_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>θ</mi><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{t}(\theta)=\sum_{i=1}^{n}q_{i}^{(t)}\ell(\langle\theta,{\bm{x}}_{i}\rangle,y_{i})</annotation></semantics></math>.
<math id="chapter12.A5.p6.m2" class="ltx_Math" alttext="F_{t}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>t</mi></msub><annotation encoding="application/x-tex">F_{t}</annotation></semantics></math> is convex because <math id="chapter12.A5.p6.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is convex and <math id="chapter12.A5.p6.m4" class="ltx_Math" alttext="q_{i}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">q_{i}^{(t)}</annotation></semantics></math> are non-negative, and <math id="chapter12.A5.p6.m5" class="ltx_Math" alttext="\nabla F_{t}(\theta^{(t)})={\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla F_{t}(\theta^{(t)})={\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})</annotation></semantics></math>. Convexity guarantees that <math id="chapter12.A5.p6.m6" class="ltx_Math" alttext="F_{t}({\bm{y}})\geq F_{t}({\bm{x}})+\langle\nabla F_{t}({\bm{x}}),{\bm{y}}-{\bm{x}}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝒚</mi><mo>−</mo><mi>𝒙</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{t}({\bm{y}})\geq F_{t}({\bm{x}})+\langle\nabla F_{t}({\bm{x}}),{\bm{y}}-{\bm{x}}\rangle</annotation></semantics></math>, so for all <math id="chapter12.A5.p6.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> we have</p>
<table id="chapter12.A5.Ex404" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex404.m1" class="ltx_Math" alttext="\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),\theta^{*}-\theta^{(t)}\rangle\leq F_{t}(\theta^{*})-F_{t}(\theta^{(t)})\leq F_{t}(\theta^{*})-\frac{2}{3}F(\theta^{(t)})\leq C-\frac{4C}{3}=-\frac{C}{3}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>≤</mo><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>2</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>C</mi><mo>−</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mn>3</mn></mfrac></mrow><mo>=</mo><mrow><mo>−</mo><mfrac><mi>C</mi><mn>3</mn></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),\theta^{*}-\theta^{(t)}\rangle\leq F_{t}(\theta^{*})-F_{t}(\theta^{(t)})\leq F_{t}(\theta^{*})-\frac{2}{3}F(\theta^{(t)})\leq C-\frac{4C}{3}=-\frac{C}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p6.3" class="ltx_p">because <math id="chapter12.A5.p6.m8" class="ltx_Math" alttext="q_{i}^{(t)}\geq q_{i}-\epsilon\geq\frac{2}{3}q_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo>≥</mo><mrow><mfrac><mn>2</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}\geq q_{i}-\epsilon\geq\frac{2}{3}q_{i}</annotation></semantics></math> and <math id="chapter12.A5.p6.m9" class="ltx_Math" alttext="\sum_{i=1}^{n}q_{i}^{(t)}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}q_{i}^{(t)}=1</annotation></semantics></math>. Since <math id="chapter12.A5.p6.m10" class="ltx_Math" alttext="\left\|\tilde{g}(\theta^{(t)})\right\|_{2}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left\|\tilde{g}(\theta^{(t)})\right\|_{2}\rightarrow 0</annotation></semantics></math>, there exists <math id="chapter12.A5.p6.m11" class="ltx_Math" alttext="T&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T&gt;0</annotation></semantics></math> such that for all <math id="chapter12.A5.p6.m12" class="ltx_Math" alttext="t\geq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\geq T</annotation></semantics></math> and all <math id="chapter12.A5.p6.m13" class="ltx_Math" alttext="\eta\leq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{0}</annotation></semantics></math>,</p>
<table id="chapter12.A5.Ex405" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex405.m1" class="ltx_Math" alttext="\left\|\theta^{(t+1)}-\theta^{*}\right\|_{2}^{2}\leq\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}-\frac{\eta C}{3}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mn>3</mn></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\theta^{(t+1)}-\theta^{*}\right\|_{2}^{2}\leq\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}-\frac{\eta C}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p6.4" class="ltx_p">which means that <math id="chapter12.A5.p6.m14" class="ltx_Math" alttext="\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}\rightarrow-\infty" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\left\|\theta^{(t)}-\theta^{*}\right\|_{2}^{2}\rightarrow-\infty</annotation></semantics></math> because <math id="chapter12.A5.p6.m15" class="ltx_Math" alttext="\frac{\eta C}{3}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{\eta C}{3}</annotation></semantics></math> is a positive constant. This is a contradiction! Thus, <math id="chapter12.A5.p6.m16" class="ltx_Math" alttext="F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})</annotation></semantics></math> must converge to 0, which is result (i).</p>
</div>
<div id="chapter12.A5.p7" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p7.1" class="ltx_p">(i) immediately implies (ii) because <math id="chapter12.A5.p7.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is strictly decreasing to 0 by the condition.</p>
</div>
<div id="chapter12.A5.p8" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p8.1" class="ltx_p">Now let us prove (iii).
First of all, the uniqueness of <math id="chapter12.A5.p8.m1" class="ltx_Math" alttext="\theta_{R}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\theta_{R}</annotation></semantics></math> can be easily proved from the convexity of <math id="chapter12.A5.p8.m2" class="ltx_Math" alttext="F(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta)</annotation></semantics></math>. The condition implies that <math id="chapter12.A5.p8.m3" class="ltx_Math" alttext="y_{i}\langle\theta_{R},{\bm{x}}_{i}\rangle&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>θ</mi><mi>R</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{i}\langle\theta_{R},{\bm{x}}_{i}\rangle&gt;0</annotation></semantics></math>, i.e. <math id="chapter12.A5.p8.m4" class="ltx_Math" alttext="\theta_{R}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\theta_{R}</annotation></semantics></math> must classify all training samples correctly. If there are two different minimizers <math id="chapter12.A5.p8.m5" class="ltx_Math" alttext="\theta_{R}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\theta_{R}</annotation></semantics></math> and <math id="chapter12.A5.p8.m6" class="ltx_Math" alttext="\theta_{R}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>R</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\theta_{R}^{\prime}</annotation></semantics></math> in whose norm is at most <math id="chapter12.A5.p8.m7" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, then consider <math id="chapter12.A5.p8.m8" class="ltx_Math" alttext="\theta_{R}^{\prime\prime}=\frac{1}{2}(\theta_{R}+\theta_{R}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>R</mi></msub><mo>+</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{R}^{\prime\prime}=\frac{1}{2}(\theta_{R}+\theta_{R}^{\prime})</annotation></semantics></math>. By the convexity of <math id="chapter12.A5.p8.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, we know that <math id="chapter12.A5.p8.m10" class="ltx_Math" alttext="\theta_{R}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">\theta_{R}^{\prime\prime}</annotation></semantics></math> must also be a minimizer, and <math id="chapter12.A5.p8.m11" class="ltx_Math" alttext="\|\theta_{R}^{\prime\prime}\|_{2}&lt;R" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\|\theta_{R}^{\prime\prime}\|_{2}&lt;R</annotation></semantics></math>. Thus, <math id="chapter12.A5.p8.m12" class="ltx_Math" alttext="F(\frac{R}{\|\theta_{R}^{\prime\prime}\|_{2}}\theta_{R}^{\prime\prime})&lt;F(\theta_{R}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mi>R</mi><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\frac{R}{\|\theta_{R}^{\prime\prime}\|_{2}}\theta_{R}^{\prime\prime})&lt;F(\theta_{R}^{\prime\prime})</annotation></semantics></math> and <math id="chapter12.A5.p8.m13" class="ltx_Math" alttext="\|\frac{R}{\|\theta_{R}^{\prime\prime}\|_{2}}\theta_{R}^{\prime\prime}\|_{2}=R" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mfrac><mi>R</mi><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\|\frac{R}{\|\theta_{R}^{\prime\prime}\|_{2}}\theta_{R}^{\prime\prime}\|_{2}=R</annotation></semantics></math>, which contradicts with the fact that <math id="chapter12.A5.p8.m14" class="ltx_Math" alttext="\theta_{R}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>R</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">\theta_{R}^{\prime\prime}</annotation></semantics></math> is a minimizer.</p>
</div>
<div id="chapter12.A5.p9" class="ltx_para ltx_noindent">
<p id="chapter12.A5.p9.2" class="ltx_p">To prove the rest of (iii), look at <a href="#chapter12.A5.E61" title="In Appendix 12.E Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">61</span></a>. On one hand, for all <math id="chapter12.A5.p9.m1" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A5.Ex406" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex406.m1" class="ltx_Math" alttext="\left|\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),{\bm{X}}({\bm{Q}}^{(t)}-{\bm{Q}})\tilde{g}(\theta^{(t)})\rangle\right|\leq\lambda^{\max}\sqrt{3\epsilon}\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>𝑿</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝑸</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msup><mi>λ</mi><mi>max</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),{\bm{X}}({\bm{Q}}^{(t)}-{\bm{Q}})\tilde{g}(\theta^{(t)})\rangle\right|\leq\lambda^{\max}\sqrt{3\epsilon}\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.3" class="ltx_p">Since we chose <math id="chapter12.A5.p9.m2" class="ltx_Math" alttext="\epsilon=\min\{\frac{q^{*}}{3},\frac{(q^{*}\lambda^{\min})^{2}}{192\lambda^{\max 2}}\}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mfrac><msup><mi>q</mi><mo>∗</mo></msup><mn>3</mn></mfrac><mo>,</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>min</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>192</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow></msup></mrow></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon=\min\{\frac{q^{*}}{3},\frac{(q^{*}\lambda^{\min})^{2}}{192\lambda^{\max 2}}\}</annotation></semantics></math>, this inequality implies that</p>
<table id="chapter12.A5.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A5.Ex407"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.Ex407.m1" class="ltx_Math" alttext="\displaystyle\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex407.m2" class="ltx_Math" alttext="\displaystyle=\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq\lambda^{\min}\left\|{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq\lambda^{\min}(q^{*}-\epsilon)\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><msup><mi>λ</mi><mi>min</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><msup><mi>λ</mi><mi>min</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq\lambda^{\min}\left\|{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq\lambda^{\min}(q^{*}-\epsilon)\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A5.Ex408"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.Ex408.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{\lambda^{\min}q^{*}}{2}\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq 4\left|\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),{\bm{X}}({\bm{Q}}^{(t)}-{\bm{Q}})\tilde{g}(\theta^{(t)})\rangle\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>λ</mi><mi>min</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>𝑿</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mi>𝑸</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\lambda^{\min}q^{*}}{2}\left\|\sqrt{{\bm{Q}}^{(t)}}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\geq 4\left|\langle{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)}),{\bm{X}}({\bm{Q}}^{(t)}-{\bm{Q}})\tilde{g}(\theta^{(t)})\rangle\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.4" class="ltx_p">On the other hand, if <math id="chapter12.A5.p9.m3" class="ltx_Math" alttext="\eta\leq\eta_{2}=\frac{1}{2L}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>2</mn></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{2}=\frac{1}{2L}</annotation></semantics></math>, then we have</p>
<table id="chapter12.A5.Ex409" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex409.m1" class="ltx_Math" alttext="\frac{\eta^{2}L}{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\leq\frac{\eta}{4}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><mfrac><mi>η</mi><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\eta^{2}L}{2}\left\|{\bm{X}}{\bm{Q}}^{(t)}\tilde{g}(\theta^{(t)})\right\|_{2}^{2}\leq\frac{\eta}{4}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.5" class="ltx_p">Combining the above with <a href="#chapter12.A5.E61" title="In Appendix 12.E Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">61</span></a>, we get</p>
<table id="chapter12.A5.Ex410" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex410.m1" class="ltx_Math" alttext="F(\theta^{(t+1)})-F(\theta^{(t)})\leq-\frac{\eta}{2}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mo>−</mo><mrow><mfrac><mi>η</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})-F(\theta^{(t)})\leq-\frac{\eta}{2}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.6" class="ltx_p">Denote <math id="chapter12.A5.p9.m4" class="ltx_Math" alttext="{\bm{u}}=\lim_{R\rightarrow\infty}\frac{\theta_{R}}{\|\theta_{R}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><msub><mi>θ</mi><mi>R</mi></msub><msub><mrow><mo stretchy="false">‖</mo><msub><mi>θ</mi><mi>R</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}=\lim_{R\rightarrow\infty}\frac{\theta_{R}}{\|\theta_{R}\|_{2}}</annotation></semantics></math>. Similar to Lemma 9 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib79" title="" class="ltx_ref">79</a>]</cite>, we can prove that: for any <math id="chapter12.A5.p9.m5" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math>, there exists a constant <math id="chapter12.A5.p9.m6" class="ltx_Math" alttext="\rho(\alpha)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(\alpha)&gt;0</annotation></semantics></math> such that for any <math id="chapter12.A5.p9.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> subject to <math id="chapter12.A5.p9.m8" class="ltx_Math" alttext="\|\theta\|_{2}\geq\rho(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>θ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\theta\|_{2}\geq\rho(\alpha)</annotation></semantics></math>, the following holds for all <math id="chapter12.A5.p9.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>:</p>
<table id="chapter12.A5.Ex411" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex411.m1" class="ltx_Math" alttext="F_{t}((1+\alpha)\|\theta\|_{2}{\bm{u}})\leq F_{t}(\theta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>θ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{t}((1+\alpha)\|\theta\|_{2}{\bm{u}})\leq F_{t}(\theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.7" class="ltx_p">Let <math id="chapter12.A5.p9.m10" class="ltx_Math" alttext="t_{\alpha}\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>α</mi></msub><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t_{\alpha}\geq t_{\epsilon}</annotation></semantics></math> satisfy that for all <math id="chapter12.A5.p9.m11" class="ltx_Math" alttext="t\geq t_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\alpha}</annotation></semantics></math>, <math id="chapter12.A5.p9.m12" class="ltx_Math" alttext="\|\theta^{(t)}\|_{2}\geq\max\{\rho(\alpha),1\}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\theta^{(t)}\|_{2}\geq\max\{\rho(\alpha),1\}</annotation></semantics></math>. By the convexity of <math id="chapter12.A5.p9.m13" class="ltx_Math" alttext="F_{t}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>t</mi></msub><annotation encoding="application/x-tex">F_{t}</annotation></semantics></math>, for all <math id="chapter12.A5.p9.m14" class="ltx_Math" alttext="t\geq t_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\alpha}</annotation></semantics></math>, we have</p>
<table id="chapter12.A5.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.E62.m1" class="ltx_Math" alttext="\langle\nabla F_{t}(\theta^{(t)}),\theta^{(t)}-(1+\alpha)\|\theta^{(t)}\|_{2}{\bm{u}}\rangle\geq F_{t}(\theta^{(t)})-F_{t}((1+\alpha)\|\theta^{(t)}\|_{2}{\bm{u}})\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>≥</mo><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\langle\nabla F_{t}(\theta^{(t)}),\theta^{(t)}-(1+\alpha)\|\theta^{(t)}\|_{2}{\bm{u}}\rangle\geq F_{t}(\theta^{(t)})-F_{t}((1+\alpha)\|\theta^{(t)}\|_{2}{\bm{u}})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.8" class="ltx_p">Thus, we have</p>
<table id="chapter12.A5.E63" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter12.A5.E63X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A5.E63X.m2" class="ltx_Math" alttext="\displaystyle\langle\theta^{(t+1)}-\theta^{(t)},{\bm{u}}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\theta^{(t+1)}-\theta^{(t)},{\bm{u}}\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.E63X.m3" class="ltx_Math" alttext="\displaystyle=\langle-\eta\nabla F_{t}(\theta^{(t)}),{\bm{u}}\rangle" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo stretchy="false">⟨</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>θ</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>,</mo><mi>𝒖</mi><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\langle-\eta\nabla F_{t}(\theta^{(t)}),{\bm{u}}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(63)</span></td></tr>
<tr id="chapter12.A5.E63Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.E63Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\langle-\eta\nabla F_{t}(\theta^{(t)}),\theta^{(t)}\rangle\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mo stretchy="false">⟨</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>F</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>θ</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>,</mo><mi>θ</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\langle-\eta\nabla F_{t}(\theta^{(t)}),\theta^{(t)}\rangle\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter12.A5.E63Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.E63Xb.m2" class="ltx_Math" alttext="\displaystyle=\langle\theta^{(t+1)}-\theta^{(t)},\theta^{(t)}\rangle\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\langle\theta^{(t+1)}-\theta^{(t)},\theta^{(t)}\rangle\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter12.A5.E63Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A5.E63Xc.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{1}{2}\left\|\theta^{(t+1)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}\right)\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{1}{2}\left\|\theta^{(t+1)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}\right)\frac{1}{(1+\alpha)\|\theta^{(t)}\|_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.9" class="ltx_p">By <math id="chapter12.A5.p9.m15" class="ltx_Math" alttext="\frac{1}{2}(\|\theta^{(t+1)}\|_{2}-\|\theta^{(t)}\|_{2})^{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{1}{2}(\|\theta^{(t+1)}\|_{2}-\|\theta^{(t)}\|_{2})^{2}\geq 0</annotation></semantics></math>, we have <math id="chapter12.A5.p9.m16" class="ltx_Math" alttext="(\frac{1}{2}\left\|\theta^{(t+1)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t)}\right\|_{2}^{2})/\|\theta^{(t)}\|_{2}\geq\left\|\theta^{(t+1)}\right\|_{2}-\left\|\theta^{(t)}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≥</mo><mrow><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">(\frac{1}{2}\left\|\theta^{(t+1)}\right\|_{2}^{2}-\frac{1}{2}\left\|\theta^{(t)}\right\|_{2}^{2})/\|\theta^{(t)}\|_{2}\geq\left\|\theta^{(t+1)}\right\|_{2}-\left\|\theta^{(t)}\right\|_{2}</annotation></semantics></math>. Moreover, by <a href="#chapter12.A5.E62" title="In Appendix 12.E Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">62</span></a>, we have</p>
<table id="chapter12.A5.Ex412" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex412.m1" class="ltx_Math" alttext="\frac{\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}}{2(1+\alpha)\|\theta^{(t)}\|_{2}}\leq\frac{\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}}{2}=\frac{\eta^{2}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}}{2}\leq\eta\left(F(\theta^{(t)})-F(\theta^{(t+1)})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo>≤</mo><mfrac><msubsup><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mn>2</mn></mfrac><mo>=</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac><mo>≤</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}}{2(1+\alpha)\|\theta^{(t)}\|_{2}}\leq\frac{\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}^{2}}{2}=\frac{\eta^{2}\left\|\nabla F_{t}(\theta^{(t)})\right\|_{2}^{2}}{2}\leq\eta\left(F(\theta^{(t)})-F(\theta^{(t+1)})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.10" class="ltx_p">Summing up <a href="#chapter12.A5.E63" title="In Appendix 12.E Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">63</span></a> from <math id="chapter12.A5.p9.m17" class="ltx_Math" alttext="t=t_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">t=t_{\alpha}</annotation></semantics></math> to <math id="chapter12.A5.p9.m18" class="ltx_Math" alttext="t-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t-1</annotation></semantics></math> yields</p>
<table id="chapter12.A5.Ex413" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex413.m1" class="ltx_Math" alttext="\langle\theta^{(t)}-\theta^{(t_{\alpha})},{\bm{u}}\rangle\geq\frac{\left\|\theta^{(t)}\right\|_{2}-\left\|\theta^{(t_{\alpha})}\right\|_{2}}{1+\alpha}+\eta\left(F(\theta^{(t)})-F(\theta^{(t_{\alpha})})\right)\geq\frac{\left\|\theta^{(t)}\right\|_{2}-\left\|\theta^{(t_{\alpha})}\right\|_{2}}{1+\alpha}-\eta F(\theta^{(t_{\alpha})})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup></mrow><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>≥</mo><mrow><mfrac><mrow><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow></mfrac><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><mrow><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow></mfrac><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\langle\theta^{(t)}-\theta^{(t_{\alpha})},{\bm{u}}\rangle\geq\frac{\left\|\theta^{(t)}\right\|_{2}-\left\|\theta^{(t_{\alpha})}\right\|_{2}}{1+\alpha}+\eta\left(F(\theta^{(t)})-F(\theta^{(t_{\alpha})})\right)\geq\frac{\left\|\theta^{(t)}\right\|_{2}-\left\|\theta^{(t_{\alpha})}\right\|_{2}}{1+\alpha}-\eta F(\theta^{(t_{\alpha})}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.11" class="ltx_p">which implies that</p>
<table id="chapter12.A5.Ex414" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex414.m1" class="ltx_Math" alttext="\left\langle\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}},{\bm{u}}\right\rangle\geq\frac{1}{1+\alpha}+\frac{1}{\left\|\theta^{(t)}\right\|_{2}}\left(\langle\theta^{(t_{\alpha})},{\bm{u}}\rangle-\frac{\|\theta^{(t_{\alpha})}\|_{2}}{1+\alpha}-\eta F(\theta^{(t_{\alpha})})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>⟨</mo><mrow><mfrac><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mfrac><mo>,</mo><mi>𝒖</mi></mrow><mo>⟩</mo></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>𝒖</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow></mfrac><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\langle\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}},{\bm{u}}\right\rangle\geq\frac{1}{1+\alpha}+\frac{1}{\left\|\theta^{(t)}\right\|_{2}}\left(\langle\theta^{(t_{\alpha})},{\bm{u}}\rangle-\frac{\|\theta^{(t_{\alpha})}\|_{2}}{1+\alpha}-\eta F(\theta^{(t_{\alpha})})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.12" class="ltx_p">Since <math id="chapter12.A5.p9.m19" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\theta^{(t)}\|_{2}=\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\theta^{(t)}\|_{2}=\infty</annotation></semantics></math>, we have</p>
<table id="chapter12.A5.Ex415" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A5.Ex415.m1" class="ltx_Math" alttext="\liminf_{t\rightarrow\infty}\left\langle\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}},{\bm{u}}\right\rangle\geq\frac{1}{1+\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim inf</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mo lspace="0em">⟨</mo><mrow><mfrac><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mfrac><mo>,</mo><mi>𝒖</mi></mrow><mo>⟩</mo></mrow></mrow><mo>≥</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\liminf_{t\rightarrow\infty}\left\langle\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}},{\bm{u}}\right\rangle\geq\frac{1}{1+\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A5.p9.13" class="ltx_p">Since <math id="chapter12.A5.p9.m20" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is arbitrary, we must have <math id="chapter12.A5.p9.m21" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}}={\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow><mo>‖</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><mo>=</mo><mi>𝒖</mi></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\frac{\theta^{(t)}}{\left\|\theta^{(t)}\right\|_{2}}={\bm{u}}</annotation></semantics></math> as long as <math id="chapter12.A5.p9.m22" class="ltx_Math" alttext="\eta\leq\min\{\eta_{1},\eta_{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><msub><mi>η</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta\leq\min\{\eta_{1},\eta_{2}\}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter12.A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.F </span>Analysis of the Logistic Loss</h2>

<div id="chapter12.A6.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A6.p1.1" class="ltx_p">Here, we show that the logistic loss satisfies all the conditions in <a href="#chapter6.Thmtheorem10" title="Theorem 6.10 (Proof in ). ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.10</span></a>, and <math id="chapter12.A6.p1.m1" class="ltx_Math" alttext="\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}=\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><msub><mi>θ</mi><mi>R</mi></msub><mi>R</mi></mfrac></mrow><mo>=</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><annotation encoding="application/x-tex">\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}=\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A6.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A6.p2.1" class="ltx_p">First, for the logistic loss we have <math id="chapter12.A6.p2.m1" class="ltx_Math" alttext="\nabla^{2}_{\hat{y}}\ell(\hat{y},y)=\frac{y^{2}}{e^{y\hat{y}}+e^{-y\hat{y}}+2}\leq\max_{i}\frac{y_{i}^{2}}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∇</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mi>y</mi><mn>2</mn></msup><mrow><msup><mi>e</mi><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></mrow></mrow></msup><mo>+</mo><mn>2</mn></mrow></mfrac><mo>≤</mo><mrow><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>y</mi><mi>i</mi><mn>2</mn></msubsup><mn>4</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nabla^{2}_{\hat{y}}\ell(\hat{y},y)=\frac{y^{2}}{e^{y\hat{y}}+e^{-y\hat{y}}+2}\leq\max_{i}\frac{y_{i}^{2}}{4}</annotation></semantics></math>, so <math id="chapter12.A6.p2.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is smooth.</p>
</div>
<div id="chapter12.A6.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A6.p3.1" class="ltx_p">Second, let us analyze <math id="chapter12.A6.p3.m1" class="ltx_Math" alttext="\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><msub><mi>θ</mi><mi>R</mi></msub><mi>R</mi></mfrac></mrow><annotation encoding="application/x-tex">\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}</annotation></semantics></math>.
For the logistic loss, it is easy to show that for any <math id="chapter12.A6.p3.m2" class="ltx_Math" alttext="\hat{\theta}^{\prime}\neq\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo>≠</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><annotation encoding="application/x-tex">\hat{\theta}^{\prime}\neq\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>, there exists an <math id="chapter12.A6.p3.m3" class="ltx_Math" alttext="R(\hat{\theta}^{\prime})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R(\hat{\theta}^{\prime})&gt;0</annotation></semantics></math> and an <math id="chapter12.A6.p3.m4" class="ltx_Math" alttext="\delta(\hat{\theta}^{\prime})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta(\hat{\theta}^{\prime})&gt;0</annotation></semantics></math> such that <math id="chapter12.A6.p3.m5" class="ltx_Math" alttext="F(R\cdot\theta)&gt;F(R\cdot\hat{\theta}_{\textnormal{MM}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(R\cdot\theta)&gt;F(R\cdot\hat{\theta}_{\textnormal{MM}})</annotation></semantics></math> for all <math id="chapter12.A6.p3.m6" class="ltx_Math" alttext="R\geq R(\hat{\theta}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\geq R(\hat{\theta}^{\prime})</annotation></semantics></math> and <math id="chapter12.A6.p3.m7" class="ltx_Math" alttext="\theta\in B(\hat{\theta}^{\prime},\delta(\hat{\theta}^{\prime}))" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo>,</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\in B(\hat{\theta}^{\prime},\delta(\hat{\theta}^{\prime}))</annotation></semantics></math>.
Let <math id="chapter12.A6.p3.m8" class="ltx_Math" alttext="S=\{\theta:\|\theta\|_{2}=1\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>θ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{\theta:\|\theta\|_{2}=1\}</annotation></semantics></math>. For any <math id="chapter12.A6.p3.m9" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, <math id="chapter12.A6.p3.m10" class="ltx_Math" alttext="S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>−</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)</annotation></semantics></math> is a compact set. And for any <math id="chapter12.A6.p3.m11" class="ltx_Math" alttext="\theta\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)</annotation></semantics></math>, there exist <math id="chapter12.A6.p3.m12" class="ltx_Math" alttext="R(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(\theta)</annotation></semantics></math> and <math id="chapter12.A6.p3.m13" class="ltx_Math" alttext="\delta(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta(\theta)</annotation></semantics></math> as defined above. Thus, there must exist <math id="chapter12.A6.p3.m14" class="ltx_Math" alttext="\theta_{1},\cdots,\theta_{m}\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>θ</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{1},\cdots,\theta_{m}\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)</annotation></semantics></math> such that <math id="chapter12.A6.p3.m15" class="ltx_math_unparsed" alttext="S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)\subseteq\cup_{i=1}^{m}B(\theta_{i},\delta(\theta_{i}))" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>−</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">⊆</mo><msubsup><mo lspace="0em">∪</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>i</mi></msub><mo>,</mo><mi>δ</mi><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)\subseteq\cup_{i=1}^{m}B(\theta_{i},\delta(\theta_{i}))</annotation></semantics></math>. Let <math id="chapter12.A6.p3.m16" class="ltx_Math" alttext="R(\epsilon)=\max\{R(\theta_{1}),\cdots,R(\theta_{m})\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R(\epsilon)=\max\{R(\theta_{1}),\cdots,R(\theta_{m})\}</annotation></semantics></math>, then for all <math id="chapter12.A6.p3.m17" class="ltx_Math" alttext="R\geq R(\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\geq R(\epsilon)</annotation></semantics></math> and all <math id="chapter12.A6.p3.m18" class="ltx_Math" alttext="\theta\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mi>S</mi><mo>−</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\in S-B(\hat{\theta}_{\textnormal{MM}},\epsilon)</annotation></semantics></math>, <math id="chapter12.A6.p3.m19" class="ltx_Math" alttext="F(R\cdot\theta)&gt;F(R\cdot\hat{\theta}_{\textnormal{MM}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(R\cdot\theta)&gt;F(R\cdot\hat{\theta}_{\textnormal{MM}})</annotation></semantics></math>, which means that <math id="chapter12.A6.p3.m20" class="ltx_Math" alttext="\frac{\theta_{R}}{R}\in B(\hat{\theta}_{\textnormal{MM}},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mfrac><msub><mi>θ</mi><mi>R</mi></msub><mi>R</mi></mfrac><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\theta_{R}}{R}\in B(\hat{\theta}_{\textnormal{MM}},\epsilon)</annotation></semantics></math> for all <math id="chapter12.A6.p3.m21" class="ltx_Math" alttext="R\geq R(\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\geq R(\epsilon)</annotation></semantics></math>. Therefore, <math id="chapter12.A6.p3.m22" class="ltx_Math" alttext="\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>R</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><msub><mi>θ</mi><mi>R</mi></msub><mi>R</mi></mfrac></mrow><annotation encoding="application/x-tex">\lim_{R\rightarrow\infty}\frac{\theta_{R}}{R}</annotation></semantics></math> exists and is equal to <math id="chapter12.A6.p3.m23" class="ltx_Math" alttext="\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><annotation encoding="application/x-tex">\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="chapter12.A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.G </span>Proof of Theorem <a href="#chapter6.Thmtheorem11" title="Theorem 6.11 (Proof in ). ‣ Wide neural networks, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.11</span></a></h2>

<div id="chapter12.A7.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A7.p1.1" class="ltx_p"><span id="chapter12.A7.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter12.A7.p1.m1" class="ltx_Math" alttext="M_{0}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>0</mn></msub><annotation encoding="application/x-tex">M_{0}</annotation></semantics></math> be the bound of <math id="chapter12.A7.p1.m2" class="ltx_Math" alttext="{\left\|\nabla_{\theta}f^{(0)}(x)\right\|}_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">{\left\|\nabla_{\theta}f^{(0)}(x)\right\|}_{2}</annotation></semantics></math>.
We first consider the regularized linearized neural network <math id="chapter12.A7.p1.m3" class="ltx_Math" alttext="f_{\textnormal{lin}\textrm{reg}}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{\textnormal{lin}\textrm{reg}}^{(t)}</annotation></semantics></math>.
By <a href="#chapter12.Thmtheorem7" title="Proposition 12.7 ([], Proposition 1). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">12.7</span></a>, <math id="chapter12.A7.p1.m4" class="ltx_Math" alttext="f^{(0)}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{(0)}({\bm{x}})</annotation></semantics></math> is sampled from a zero-mean Gaussian process, so there exists a constant <math id="chapter12.A7.p1.m5" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math> such that <math id="chapter12.A7.p1.m6" class="ltx_Math" alttext="|f^{(0)}({\bm{x}}_{i})|&lt;M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">|f^{(0)}({\bm{x}}_{i})|&lt;M</annotation></semantics></math> for all <math id="chapter12.A7.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> with high probability.
Define</p>
<table id="chapter12.A7.Ex416" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex416.m1" class="ltx_Math" alttext="F(\theta)=\sum_{i=1}^{n}q_{i}\ell(\langle\theta,\nabla_{\theta}f^{(0)}({\bm{x}}_{i})\rangle+f^{(0)}({\bm{x}}_{i}),y_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>θ</mi><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta)=\sum_{i=1}^{n}q_{i}\ell(\langle\theta,\nabla_{\theta}f^{(0)}({\bm{x}}_{i})\rangle+f^{(0)}({\bm{x}}_{i}),y_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p1.2" class="ltx_p">Denote <math id="chapter12.A7.p1.m8" class="ltx_Math" alttext="\tilde{\theta}_{R}=\argmin_{\theta}\{F(R\cdot\theta):\|\theta\|_{2}\leq 1\}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>=</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>θ</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>θ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\theta}_{R}=\argmin_{\theta}\{F(R\cdot\theta):\|\theta\|_{2}\leq 1\}</annotation></semantics></math>.
when the linearized neural network is trained by GRW satisfying <a href="#chapter6.Thmtheorem3" title="Assumption 6.3. ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">6.3</span></a> with regularization, since this is convex optimization and the objective function is smooth, we can prove that with a sufficiently small learning rate, as <math id="chapter12.A7.p1.m9" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>, <math id="chapter12.A7.p1.m10" class="ltx_Math" alttext="\theta^{(t)}\rightarrow R\cdot\tilde{\theta_{R}}+\theta^{(0)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">→</mo><mrow><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><msub><mi>θ</mi><mi>R</mi></msub><mo>~</mo></mover></mrow><mo>+</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t)}\rightarrow R\cdot\tilde{\theta_{R}}+\theta^{(0)}</annotation></semantics></math> where <math id="chapter12.A7.p1.m11" class="ltx_Math" alttext="R=\lim_{t\rightarrow\infty}\|\theta^{(t)}-\theta^{(0)}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">R=\lim_{t\rightarrow\infty}\|\theta^{(t)}-\theta^{(0)}\|_{2}</annotation></semantics></math> (which is the minimizer). And define</p>
<table id="chapter12.A7.Ex417" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex417.m1" class="ltx_Math" alttext="\gamma=\min_{i=1,\cdots,n}y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},\nabla_{\theta}f^{(0)}(x_{i})\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>=</mo><mrow><mrow><munder><mi>min</mi><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma=\min_{i=1,\cdots,n}y_{i}\cdot\langle\hat{\theta}_{\textnormal{MM}},\nabla_{\theta}f^{(0)}(x_{i})\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A7.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A7.p2.1" class="ltx_p">First, we derive the lower bound of <math id="chapter12.A7.p2.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. By <a href="#chapter12.Thmtheorem9" title="Lemma 12.9 (Approximation Theorem for Regularized GRW). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.9</span></a>, with a sufficiently large <math id="chapter12.A7.p2.m2" class="ltx_Math" alttext="\tilde{d}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>d</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{d}</annotation></semantics></math>, with high probability <math id="chapter12.A7.p2.m3" class="ltx_Math" alttext="\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}(f_{\textrm{reg}}^{(t)})&lt;\epsilon</annotation></semantics></math> implies <math id="chapter12.A7.p2.m4" class="ltx_Math" alttext="\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;2\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mrow><mtext>lin</mtext><mtext>reg</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}(f_{\textnormal{lin}\textrm{reg}}^{(t)})&lt;2\epsilon</annotation></semantics></math>. By the convexity of <math id="chapter12.A7.p2.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, we have</p>
<table id="chapter12.A7.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A7.Ex418"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A7.Ex418.m1" class="ltx_Math" alttext="\displaystyle 2\epsilon" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2\epsilon</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex418.m2" class="ltx_math_unparsed" alttext="\displaystyle&gt;\frac{1}{n}\sum_{i=1}^{n}\ell(\langle R\tilde{\theta}_{R},x_{i}\rangle+f^{(0)}(x_{i}),y_{i})\geq\log\left(1+\exp\left(-\frac{1}{n}\sum_{i=1}^{n}(\langle R\tilde{\theta}_{R},{\bm{x}}_{i}\rangle+f^{(0)}(x_{i}))y_{i}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mi>R</mi><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">⟩</mo></mrow><mo>+</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mi>R</mi><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">⟩</mo></mrow><mo>+</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mi>y</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\frac{1}{n}\sum_{i=1}^{n}\ell(\langle R\tilde{\theta}_{R},x_{i}\rangle+f^{(0)}(x_{i}),y_{i})\geq\log\left(1+\exp\left(-\frac{1}{n}\sum_{i=1}^{n}(\langle R\tilde{\theta}_{R},{\bm{x}}_{i}\rangle+f^{(0)}(x_{i}))y_{i}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A7.Ex419"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex419.m1" class="ltx_math_unparsed" alttext="\displaystyle\geq\log\left(1+\exp\left(-\frac{1}{n}\sum_{i=1}^{n}R\langle\tilde{\theta}_{R},x_{i}\rangle y_{i}-M\right)\right)," display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>R</mi><mrow><mo stretchy="false">⟨</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">⟩</mo></mrow><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mi>M</mi><mo>)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\log\left(1+\exp\left(-\frac{1}{n}\sum_{i=1}^{n}R\langle\tilde{\theta}_{R},x_{i}\rangle y_{i}-M\right)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p2.2" class="ltx_p">which implies that <math id="chapter12.A7.p2.m6" class="ltx_Math" alttext="R=\Omega(-\log 2\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=\Omega(-\log 2\epsilon)</annotation></semantics></math> for all <math id="chapter12.A7.p2.m7" class="ltx_Math" alttext="\epsilon\in(0,\frac{1}{4})" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,\frac{1}{4})</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A7.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A7.p3.1" class="ltx_p">Denote <math id="chapter12.A7.p3.m1" class="ltx_Math" alttext="\delta=\|\hat{\theta}_{\textnormal{MM}}-\tilde{\theta}_{R}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>−</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\delta=\|\hat{\theta}_{\textnormal{MM}}-\tilde{\theta}_{R}\|_{2}</annotation></semantics></math>. Let <math id="chapter12.A7.p3.m2" class="ltx_Math" alttext="\theta^{\prime}=\frac{\hat{\theta}_{\textnormal{MM}}+\tilde{\theta}_{R}}{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mo>′</mo></msup><mo>=</mo><mfrac><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>+</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\theta^{\prime}=\frac{\hat{\theta}_{\textnormal{MM}}+\tilde{\theta}_{R}}{2}</annotation></semantics></math>, then we can see that <math id="chapter12.A7.p3.m3" class="ltx_Math" alttext="\|\theta^{\prime}\|_{2}=\sqrt{1-\frac{\delta^{2}}{4}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mo>′</mo></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow></msqrt></mrow><annotation encoding="application/x-tex">\|\theta^{\prime}\|_{2}=\sqrt{1-\frac{\delta^{2}}{4}}</annotation></semantics></math>. Let <math id="chapter12.A7.p3.m4" class="ltx_Math" alttext="\tilde{\theta}^{\prime}=\frac{\theta^{\prime}}{\|\theta^{\prime}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>′</mo></msup><mo>=</mo><mfrac><msup><mi>θ</mi><mo>′</mo></msup><msub><mrow><mo stretchy="false">‖</mo><msup><mi>θ</mi><mo>′</mo></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><annotation encoding="application/x-tex">\tilde{\theta}^{\prime}=\frac{\theta^{\prime}}{\|\theta^{\prime}\|_{2}}</annotation></semantics></math>. By the definition of <math id="chapter12.A7.p3.m5" class="ltx_Math" alttext="\hat{\theta}_{\textnormal{MM}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><annotation encoding="application/x-tex">\hat{\theta}_{\textnormal{MM}}</annotation></semantics></math>, there exists <math id="chapter12.A7.p3.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> such that <math id="chapter12.A7.p3.m7" class="ltx_Math" alttext="y_{j}\cdot\langle\tilde{\theta}^{\prime},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>′</mo></msup><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">y_{j}\cdot\langle\tilde{\theta}^{\prime},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle\leq\gamma</annotation></semantics></math>, which implies that</p>
<table id="chapter12.A7.Ex420" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex420.m1" class="ltx_Math" alttext="y_{j}\cdot\left\langle\frac{\hat{\theta}_{\textnormal{MM}}+\tilde{\theta}_{R}}{2}\frac{1}{\sqrt{1-\frac{\delta^{2}}{4}}},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\right\rangle\leq\gamma." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>⟨</mo><mrow><mrow><mfrac><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>+</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow></msqrt></mfrac></mrow><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>≤</mo><mi>γ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y_{j}\cdot\left\langle\frac{\hat{\theta}_{\textnormal{MM}}+\tilde{\theta}_{R}}{2}\frac{1}{\sqrt{1-\frac{\delta^{2}}{4}}},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\right\rangle\leq\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.2" class="ltx_p">Thus, we have</p>
<table id="chapter12.A7.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A7.Ex421"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A7.Ex421.m1" class="ltx_Math" alttext="\displaystyle y_{j}\cdot\langle\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}(x_{j})\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle y_{j}\cdot\langle\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}(x_{j})\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex421.m2" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{1-\frac{\delta^{2}}{4}}\gamma-y_{j}\cdot\langle\hat{\theta}_{\textnormal{MM}},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{1-\frac{\delta^{2}}{4}}\gamma-y_{j}\cdot\langle\hat{\theta}_{\textnormal{MM}},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A7.Ex422"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex422.m1" class="ltx_Math" alttext="\displaystyle\leq\left(2\sqrt{1-\frac{\delta^{2}}{4}}-1\right)\gamma" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mrow></msqrt></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(2\sqrt{1-\frac{\delta^{2}}{4}}-1\right)\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A7.Ex423"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex423.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(2(1-\frac{\delta^{2}}{8})-1\right)\gamma\qquad(\text{since }\sqrt{1-x}\leq 1-\frac{x}{2})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>(</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>8</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mi>γ</mi><mrow><mo stretchy="false">(</mo><mtext>since </mtext><msqrt><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow></msqrt><mo>≤</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mn>2</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(2(1-\frac{\delta^{2}}{8})-1\right)\gamma\qquad(\text{since }\sqrt{1-x}\leq 1-\frac{x}{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A7.Ex424"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex424.m1" class="ltx_Math" alttext="\displaystyle=(1-\frac{\delta^{2}}{4})\gamma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\frac{\delta^{2}}{4})\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.3" class="ltx_p">On the other hand, we have</p>
<table id="chapter12.A7.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A7.Ex425"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex425.m1" class="ltx_math_unparsed" alttext="\displaystyle q_{j}\log(1+\exp(-y_{j}\cdot\langle R\cdot\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle-M))\leq F(R\cdot\tilde{\theta}_{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>j</mi></msub><mi>log</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q_{j}\log(1+\exp(-y_{j}\cdot\langle R\cdot\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}({\bm{x}}_{j})\rangle-M))\leq F(R\cdot\tilde{\theta}_{R})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A7.Ex426"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A7.Ex426.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A7.Ex426.m2" class="ltx_Math" alttext="\displaystyle F(R\cdot\hat{\theta}_{\textnormal{MM}})\leq\log(1+\exp(-R\gamma+M))," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>+</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle F(R\cdot\hat{\theta}_{\textnormal{MM}})\leq\log(1+\exp(-R\gamma+M)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.4" class="ltx_p">which implies that</p>
<table id="chapter12.A7.Ex427" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex427.m1" class="ltx_Math" alttext="q^{*}\log\left(1+\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right)\right)\leq\log(1+\exp(-R\gamma+M))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mi>M</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>+</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q^{*}\log\left(1+\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right)\right)\leq\log(1+\exp(-R\gamma+M)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.5" class="ltx_p">Thus, we have</p>
<table id="chapter12.A7.Ex428" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex428.m1" class="ltx_Math" alttext="1+\exp(-R\gamma+M)\geq\left(1+\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right)\right)^{q^{*}}\geq 1+q^{*}\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>+</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mi>M</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><msup><mi>q</mi><mo>∗</mo></msup></msup><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mi>M</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">1+\exp(-R\gamma+M)\geq\left(1+\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right)\right)^{q^{*}}\geq 1+q^{*}\exp\left(-(1-\frac{\delta^{2}}{4})R\gamma-M\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.6" class="ltx_p">which is equivalent to</p>
<table id="chapter12.A7.Ex429" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex429.m1" class="ltx_Math" alttext="-R\gamma+M\geq-(1-\frac{\delta^{2}}{4})R\gamma-M+\log(q^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>+</mo><mi>M</mi></mrow><mo>≥</mo><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>δ</mi><mn>2</mn></msup><mn>4</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-R\gamma+M\geq-(1-\frac{\delta^{2}}{4})R\gamma-M+\log(q^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.7" class="ltx_p">From this, we conclude that</p>
<table id="chapter12.A7.Ex430" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex430.m1" class="ltx_math_unparsed" alttext="\delta=O(R^{-1/2})=O((-\log 2\epsilon)^{-1/2})." display="block" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>log</mi><mn>2</mn><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta=O(R^{-1/2})=O((-\log 2\epsilon)^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.8" class="ltx_p">So for any test point <math id="chapter12.A7.p3.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A7.p3.m9" class="ltx_Math" alttext="{\left\|\nabla_{\theta}f^{(0)}(x)\right\|}\leq M_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|\nabla_{\theta}f^{(0)}(x)\right\|}\leq M_{0}</annotation></semantics></math>, we have</p>
<table id="chapter12.A7.Ex431" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex431.m1" class="ltx_math_unparsed" alttext="{\left|{\left\langle\hat{\theta}_{\textnormal{MM}}-\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}(x)\right\rangle}\right|}\leq\delta M_{0}=O((-\log 2\epsilon)^{-1/2})." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mo>⟨</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mtext>MM</mtext></msub><mo>−</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>R</mi></msub><mo>,</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>δ</mi><msub><mi>M</mi><mn>0</mn></msub><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>log</mi><mn>2</mn><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left|{\left\langle\hat{\theta}_{\textnormal{MM}}-\tilde{\theta}_{R},\nabla_{\theta}f^{(0)}(x)\right\rangle}\right|}\leq\delta M_{0}=O((-\log 2\epsilon)^{-1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A7.p3.9" class="ltx_p">Combining this with <a href="#chapter12.Thmtheorem9" title="Lemma 12.9 (Approximation Theorem for Regularized GRW). ‣ Appendix 12.C Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.9</span></a>, with high probability, we have</p>
<table id="chapter12.A7.Ex432" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A7.Ex432.m1" class="ltx_math_unparsed" alttext="\limsup_{t\rightarrow\infty}|R\cdot f_{\textnormal{MM}}(x)-f_{\textrm{reg}}^{(t)}(x)|=O(R\cdot(-\log 2\epsilon)^{-1/2}+\tilde{d}^{-1/4})." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim sup</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em" stretchy="false">|</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>f</mi><mtext>MM</mtext></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>log</mi><mn>2</mn><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\limsup_{t\rightarrow\infty}|R\cdot f_{\textnormal{MM}}(x)-f_{\textrm{reg}}^{(t)}(x)|=O(R\cdot(-\log 2\epsilon)^{-1/2}+\tilde{d}^{-1/4}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A7.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A7.p4.1" class="ltx_p">Hence, there exists a constant <math id="chapter12.A7.p4.m1" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> such that: As <math id="chapter12.A7.p4.m2" class="ltx_Math" alttext="\tilde{d}\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\tilde{d}\rightarrow\infty</annotation></semantics></math>, with high probability, for all <math id="chapter12.A7.p4.m3" class="ltx_Math" alttext="\epsilon\in(0,\frac{1}{4})" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,\frac{1}{4})</annotation></semantics></math>, if <math id="chapter12.A7.p4.m4" class="ltx_math_unparsed" alttext="|f_{\textnormal{MM}}(x)|&gt;C\cdot(-\log 2\epsilon)^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>f</mi><mtext>MM</mtext></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>log</mi><mn>2</mn><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">|f_{\textnormal{MM}}(x)|&gt;C\cdot(-\log 2\epsilon)^{-1/2}</annotation></semantics></math>, then <math id="chapter12.A7.p4.m5" class="ltx_Math" alttext="f_{\textrm{reg}}^{(t)}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mtext>reg</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\textrm{reg}}^{(t)}(x)</annotation></semantics></math> will have the same sign as <math id="chapter12.A7.p4.m6" class="ltx_Math" alttext="f_{\textnormal{MM}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mtext>MM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\textnormal{MM}}(x)</annotation></semantics></math> for a sufficiently large <math id="chapter12.A7.p4.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Note that this <math id="chapter12.A7.p4.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> only depends on <math id="chapter12.A7.p4.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, <math id="chapter12.A7.p4.m10" class="ltx_Math" alttext="q^{*}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">q^{*}</annotation></semantics></math>, <math id="chapter12.A7.p4.m11" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, <math id="chapter12.A7.p4.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and <math id="chapter12.A7.p4.m13" class="ltx_Math" alttext="M_{0}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>0</mn></msub><annotation encoding="application/x-tex">M_{0}</annotation></semantics></math>, so it is a constant independent of <math id="chapter12.A7.p4.m14" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter12.A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.H </span>Proof of Proposition <a href="#chapter6.Thmtheorem16" title="Proposition 6.16 (Proof in ). ‣ Method. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.16</span></a></h2>

<div id="chapter12.A8.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A8.p1.2" class="ltx_p"><span id="chapter12.A8.p1.2.1" class="ltx_text ltx_font_bold">Proof </span>
We have</p>
<table id="chapter12.A8.E64" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter12.A8.E64X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.E64X.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>ϵ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msub><mi>P</mi><mi>train</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.E64X.m3" class="ltx_Math" alttext="\displaystyle=\inf_{P^{\prime}}\left\{{\mathcal{R}}_{D_{\beta},\rho}(\theta;P^{\prime}):\exists\tilde{P^{\prime}}\text{ s.t. }P_{\rm{train}}=(1-\epsilon)P^{\prime}+\epsilon\tilde{P^{\prime}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><msup><mi>P</mi><mo>′</mo></msup></munder><mrow><mo>{</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>,</mo><mi>ρ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo rspace="0.167em">∃</mo><mrow><mover accent="true"><msup><mi>P</mi><mo>′</mo></msup><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext> s.t. </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msup><mi>P</mi><mo>′</mo></msup><mo>~</mo></mover></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{P^{\prime}}\left\{{\mathcal{R}}_{D_{\beta},\rho}(\theta;P^{\prime}):\exists\tilde{P^{\prime}}\text{ s.t. }P_{\rm{train}}=(1-\epsilon)P^{\prime}+\epsilon\tilde{P^{\prime}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(64)</span></td></tr>
<tr id="chapter12.A8.E64Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.E64Xa.m2" class="ltx_Math" alttext="\displaystyle=\inf_{P^{\prime},\eta}\left\{c_{\beta}(\rho)\mathbb{E}_{P^{\prime}}[(\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}]^{\frac{1}{\beta_{*}}}+\eta\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>,</mo><mi>η</mi></mrow></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>c</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msup><mi>P</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mi>η</mi></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{P^{\prime},\eta}\left\{c_{\beta}(\rho)\mathbb{E}_{P^{\prime}}[(\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}]^{\frac{1}{\beta_{*}}}+\eta\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter12.A8.E64Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.E64Xb.m2" class="ltx_Math" alttext="\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\inf_{P^{\prime}}\{[\int_{\mathbb{R}_{+}}P^{\prime}((\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}&gt;u)du]^{\frac{1}{\beta_{*}}}\}+\eta\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>η</mi></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>c</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">inf</mo><msup><mi>P</mi><mo>′</mo></msup></munder><mrow><mo stretchy="false">{</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>ℝ</mi><mo>+</mo></msub></msub></mstyle><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo>&gt;</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>u</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>+</mo><mi>η</mi></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\inf_{P^{\prime}}\{[\int_{\mathbb{R}_{+}}P^{\prime}((\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}&gt;u)du]^{\frac{1}{\beta_{*}}}\}+\eta\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A8.p1.3" class="ltx_p">Since <math id="chapter12.A8.p1.m1" class="ltx_Math" alttext="P_{\rm{train}}=(1-\epsilon)P^{\prime}+\epsilon\tilde{P^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>train</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msup><mi>P</mi><mo>′</mo></msup><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\rm{train}}=(1-\epsilon)P^{\prime}+\epsilon\tilde{P^{\prime}}</annotation></semantics></math>, for all <math id="chapter12.A8.p1.m2" class="ltx_Math" alttext="\ell_{0}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\ell_{0}\in\mathbb{R}</annotation></semantics></math>, we have</p>
<table id="chapter12.A8.Ex433" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A8.Ex433.m1" class="ltx_Math" alttext="P^{\prime}(\ell(\theta;Z)\leq\ell_{0})\leq\min\left\{1,\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\ell_{0})\right\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mn>1</mn><mo>,</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P^{\prime}(\ell(\theta;Z)\leq\ell_{0})\leq\min\left\{1,\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\ell_{0})\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A8.p1.4" class="ltx_p">and we can show that there exists a <math id="chapter12.A8.p1.m3" class="ltx_Math" alttext="P^{*}=P^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo>=</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P^{*}=P^{\prime}</annotation></semantics></math> that attains the equality for all <math id="chapter12.A8.p1.m4" class="ltx_Math" alttext="\ell_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\ell_{0}</annotation></semantics></math>.
This is because <math id="chapter12.A8.p1.m5" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;z))" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;z))</annotation></semantics></math> is a continuous function of <math id="chapter12.A8.p1.m6" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> for any fixed <math id="chapter12.A8.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> since both <math id="chapter12.A8.p1.m8" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> and <math id="chapter12.A8.p1.m9" class="ltx_Math" alttext="P_{\rm{train}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>train</mi></msub><annotation encoding="application/x-tex">P_{\rm{train}}</annotation></semantics></math> are continuous, so there exists an <math id="chapter12.A8.p1.m10" class="ltx_Math" alttext="\ell^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\ell^{*}</annotation></semantics></math> such that <math id="chapter12.A8.p1.m11" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)&gt;\ell^{*})=\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)&gt;\ell^{*})=\epsilon</annotation></semantics></math>.
Hence, we can define</p>
<table id="chapter12.A8.Ex434" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A8.Ex434.m1" class="ltx_Math" alttext="P^{*}(z)=\left\{\begin{array}[]{cc}\frac{1}{1-\epsilon}P_{\rm{train}}(z)&amp;,\ell(\theta;z)\leq\ell^{*};\\
0&amp;,\ell(\theta;z)&gt;\ell^{*}.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>z</mi><mo stretchy="false">)</mo><mo>≤</mo><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>z</mi><mo stretchy="false">)</mo><mo>&gt;</mo><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">P^{*}(z)=\left\{\begin{array}[]{cc}\frac{1}{1-\epsilon}P_{\rm{train}}(z)&amp;,\ell(\theta;z)\leq\ell^{*};\\
0&amp;,\ell(\theta;z)&gt;\ell^{*}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A8.p1.5" class="ltx_p">For this <math id="chapter12.A8.p1.m12" class="ltx_Math" alttext="P^{*}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">P^{*}</annotation></semantics></math>, we have <math id="chapter12.A8.p1.m13" class="ltx_Math" alttext="\int_{{\mathcal{X}}\times{\mathcal{Y}}}P^{*}(z)dz=\frac{1}{1-\epsilon}\int_{\ell(\theta;z)&lt;\ell^{*}}P_{\rm{train}}(z)dz=\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∫</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow></msub><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>z</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\int_{{\mathcal{X}}\times{\mathcal{Y}}}P^{*}(z)dz=\frac{1}{1-\epsilon}\int_{\ell(\theta;z)&lt;\ell^{*}}P_{\rm{train}}(z)dz=\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})=1</annotation></semantics></math> because <math id="chapter12.A8.p1.m14" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})=0</annotation></semantics></math>, which means that <math id="chapter12.A8.p1.m15" class="ltx_Math" alttext="P^{*}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">P^{*}</annotation></semantics></math> is a proper probability density function.</p>
</div>
<div id="chapter12.A8.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A8.p2.1" class="ltx_p">Let <math id="chapter12.A8.p2.m1" class="ltx_Math" alttext="v=u^{\frac{1}{\beta_{*}}}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><msup><mi>u</mi><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><annotation encoding="application/x-tex">v=u^{\frac{1}{\beta_{*}}}</annotation></semantics></math>. Plugging <math id="chapter12.A8.p2.m2" class="ltx_Math" alttext="P^{*}(\ell(\theta;Z)\leq\ell_{0})=\min\left\{1,\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\ell_{0})\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mn>1</mn><mo>,</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{*}(\ell(\theta;Z)\leq\ell_{0})=\min\left\{1,\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\ell_{0})\right\}</annotation></semantics></math> into <a href="#chapter12.A8.E64" title="In Appendix 12.H Proof of Proposition ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">64</span></a> produces</p>
<table id="chapter12.A8.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A8.Ex435"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex435.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>ϵ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msub><mi>P</mi><mi>train</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex435.m2" class="ltx_Math" alttext="\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{\mathbb{R}_{+}}[1-P^{*}((\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}\leq v^{\beta_{*}})]dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>η</mi></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>c</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>ℝ</mi><mo>+</mo></msub></msub></mstyle><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo>≤</mo><msup><mi>v</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow></mrow><mo>]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mi>η</mi></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{\mathbb{R}_{+}}[1-P^{*}((\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}\leq v^{\beta_{*}})]dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex436"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex436.m1" class="ltx_Math" alttext="\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{\mathbb{R}_{+}}[1-\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\eta+v)]_{+}dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>η</mi></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>c</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>ℝ</mi><mo>+</mo></msub></msub></mstyle><mrow><msub><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>η</mi><mo>+</mo><mi>v</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow></mrow><mo>]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mi>η</mi></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{\mathbb{R}_{+}}[1-\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)\leq\eta+v)]_{+}dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex437"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex437.m1" class="ltx_Math" alttext="\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{0}^{(\ell^{*}-\eta)_{+}}\frac{1}{1-\epsilon}[(1-\epsilon)-P_{\rm{train}}(\ell(\theta;Z)\leq\eta+v)]_{+}dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>η</mi></munder><mrow><mo>{</mo><mrow><mrow><msub><mi>c</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>η</mi><mo>+</mo><mi>v</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow></mrow><mo>]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mi>η</mi></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{\eta}\left\{c_{\beta}(\rho)\left[\int_{0}^{(\ell^{*}-\eta)_{+}}\frac{1}{1-\epsilon}[(1-\epsilon)-P_{\rm{train}}(\ell(\theta;Z)\leq\eta+v)]_{+}dv^{\beta_{*}}\right]^{\frac{1}{\beta_{*}}}+\eta\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A8.p2.2" class="ltx_p">On the other hand, we have</p>
<table id="chapter12.A8.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A8.Ex438"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex438.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{P_{\rm{train}}}[(\ell-\eta)_{+}^{\beta_{*}}\mid P_{Z^{\prime}\sim P_{\rm{train}}}(\ell(\theta;Z^{\prime})&gt;\ell(\theta;Z))\geq\epsilon]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi>train</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mrow><msub><mi>P</mi><mrow><msup><mi>Z</mi><mo>′</mo></msup><mo>∼</mo><msub><mi>P</mi><mi>train</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{P_{\rm{train}}}[(\ell-\eta)_{+}^{\beta_{*}}\mid P_{Z^{\prime}\sim P_{\rm{train}}}(\ell(\theta;Z^{\prime})&gt;\ell(\theta;Z))\geq\epsilon]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex439"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex439.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex439.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\epsilon}\int_{0}^{\ell^{*}}(u-\eta)_{+}^{\beta_{*}}d(P_{\rm{train}}(\ell\leq u))" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></msubsup></mstyle><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\epsilon}\int_{0}^{\ell^{*}}(u-\eta)_{+}^{\beta_{*}}d(P_{\rm{train}}(\ell\leq u))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex440"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex440.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex440.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\epsilon}\left\{\left[(u-\eta)_{+}^{\beta_{*}}P_{\rm{train}}(\ell\leq u)\right]_{0}^{\ell^{*}}-\int_{0}^{\ell^{*}}P_{\rm{train}}(\ell\leq u)d((u-\eta)_{+}^{\beta_{*}})\right\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msubsup><mrow><mo>[</mo><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mn>0</mn><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></msubsup></mstyle><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\epsilon}\left\{\left[(u-\eta)_{+}^{\beta_{*}}P_{\rm{train}}(\ell\leq u)\right]_{0}^{\ell^{*}}-\int_{0}^{\ell^{*}}P_{\rm{train}}(\ell\leq u)d((u-\eta)_{+}^{\beta_{*}})\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex441"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex441.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex441.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\epsilon}\left\{(\ell^{*}-\eta)_{+}^{\beta_{*}}(1-\epsilon)-\int_{0}^{\ell^{*}}P_{\rm{train}}(\ell\leq u)d((u-\eta)_{+}^{\beta_{*}})\right\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></msubsup></mstyle><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\epsilon}\left\{(\ell^{*}-\eta)_{+}^{\beta_{*}}(1-\epsilon)-\int_{0}^{\ell^{*}}P_{\rm{train}}(\ell\leq u)d((u-\eta)_{+}^{\beta_{*}})\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex442"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex442.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex442.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\epsilon}\left\{\int_{0}^{(\ell^{*}-\eta)_{+}}(1-\epsilon)dv^{\beta_{*}}-\int_{0}^{(\ell^{*}-\eta)_{+}}P_{\rm{train}}(\ell\leq\eta+w)dw^{\beta_{*}}\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></msubsup></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></msubsup></mstyle><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mrow><mi>η</mi><mo>+</mo><mi>w</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><msub><mi>β</mi><mo>∗</mo></msub></msup></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\epsilon}\left\{\int_{0}^{(\ell^{*}-\eta)_{+}}(1-\epsilon)dv^{\beta_{*}}-\int_{0}^{(\ell^{*}-\eta)_{+}}P_{\rm{train}}(\ell\leq\eta+w)dw^{\beta_{*}}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A8.p2.3" class="ltx_p">where <math id="chapter12.A8.p2.m3" class="ltx_Math" alttext="w=(u-\eta)_{+}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">w=(u-\eta)_{+}</annotation></semantics></math>. This completes the proof.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.Thmtheorem12" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem12.2" class="ltx_text ltx_font_bold">Remark 12.12</span></span><span id="chapter12.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem12.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem12.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">We can prove a similar dual formula even if <math id="chapter12.Thmtheorem12.p1.m1" class="ltx_Math" alttext="P_{\rm{train}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>train</mi></msub><annotation encoding="application/x-tex">P_{\rm{train}}</annotation></semantics></math> is not continuous.
For any <math id="chapter12.Thmtheorem12.p1.m2" class="ltx_Math" alttext="P_{\rm{train}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>train</mi></msub><annotation encoding="application/x-tex">P_{\rm{train}}</annotation></semantics></math>, there exists an <math id="chapter12.Thmtheorem12.p1.m3" class="ltx_Math" alttext="\ell^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\ell^{*}</annotation></semantics></math> such that <math id="chapter12.Thmtheorem12.p1.m4" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)&gt;\ell^{*})\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)&gt;\ell^{*})\leq\epsilon</annotation></semantics></math> and <math id="chapter12.Thmtheorem12.p1.m5" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})\leq 1-\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})\leq 1-\epsilon</annotation></semantics></math>.
If <math id="chapter12.Thmtheorem12.p1.m6" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})=0</annotation></semantics></math>, then we still define <math id="chapter12.Thmtheorem12.p1.m7" class="ltx_Math" alttext="P^{*}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">P^{*}</annotation></semantics></math> the same as in the above proof.
If <math id="chapter12.Thmtheorem12.p1.m8" class="ltx_Math" alttext="P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})&gt;0</annotation></semantics></math>, then we define</span></p>
<table id="chapter12.A8.Ex443" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A8.Ex443.m1" class="ltx_Math" alttext="P^{*}(z)=\left\{\begin{array}[]{cc}\frac{1}{1-\epsilon}P_{\rm{train}}(z)&amp;,\ell(\theta;z)&lt;\ell^{*};\\
\left[1-\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})\right]/P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})&amp;,\ell(\theta;z)=\ell^{*};\\
0&amp;,\ell(\theta;z)&gt;\ell^{*},\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>z</mi><mo stretchy="false">)</mo><mo>&lt;</mo><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo>[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo>/</mo><msub><mi>P</mi><mi>train</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>;</mo></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>z</mi><mo stretchy="false">)</mo><mo>&gt;</mo><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">P^{*}(z)=\left\{\begin{array}[]{cc}\frac{1}{1-\epsilon}P_{\rm{train}}(z)&amp;,\ell(\theta;z)&lt;\ell^{*};\\
\left[1-\frac{1}{1-\epsilon}P_{\rm{train}}(\ell(\theta;Z)&lt;\ell^{*})\right]/P_{\rm{train}}(\ell(\theta;Z)=\ell^{*})&amp;,\ell(\theta;z)=\ell^{*};\\
0&amp;,\ell(\theta;z)&gt;\ell^{*},\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.Thmtheorem12.p1.2" class="ltx_p"><span id="chapter12.Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">with which the dual formula becomes</span></p>
<table id="chapter12.A8.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A8.Ex444"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex444.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>ϵ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msub><mi>P</mi><mi>train</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{R}}_{D_{\beta},\rho,\epsilon}(\theta;P_{\rm{train}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="chapter12.A8.Ex445"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A8.Ex445.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex445.m2" class="ltx_math_unparsed" alttext="\displaystyle\inf_{\eta}\{c_{\beta}(\rho)(\frac{P_{\rm{train}}(\ell&lt;\ell^{*})}{1-\epsilon}\mathbb{E}_{Z}[(\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}\mid P_{Z^{\prime}}(\ell(\theta;Z^{\prime})&gt;\ell(\theta;Z))&gt;\epsilon]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mi>η</mi></munder><mrow><mo lspace="0em" stretchy="false">{</mo><msub><mi>c</mi><mi>β</mi></msub><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mi>Z</mi></msub><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>P</mi><msup><mi>Z</mi><mo>′</mo></msup></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>;</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>ϵ</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\inf_{\eta}\{c_{\beta}(\rho)(\frac{P_{\rm{train}}(\ell&lt;\ell^{*})}{1-\epsilon}\mathbb{E}_{Z}[(\ell(\theta;Z)-\eta)_{+}^{\beta_{*}}\mid P_{Z^{\prime}}(\ell(\theta;Z^{\prime})&gt;\ell(\theta;Z))&gt;\epsilon]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A8.Ex446"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A8.Ex446.m1" class="ltx_math_unparsed" alttext="\displaystyle+\frac{1-P_{\rm{train}}(\ell&lt;\ell^{*})}{1-\epsilon}(\ell^{*}-\eta)_{+}^{\beta_{*}})^{\frac{1}{\beta_{*}}}+\eta\}." display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>P</mi><mi>train</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mstyle><msubsup><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msup><mo>−</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup><mo>+</mo><mi>η</mi><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1-P_{\rm{train}}(\ell&lt;\ell^{*})}{1-\epsilon}(\ell^{*}-\eta)_{+}^{\beta_{*}})^{\frac{1}{\beta_{*}}}+\eta\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="chapter12.A9" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.I </span>Proof of Theorem <a href="#chapter6.Thmtheorem17" title="Theorem 6.17 (Proof in ). ‣ Theoretical guarantee. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.17</span></a></h2>

<div id="chapter12.A9.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A9.p1.1" class="ltx_p">The proof relies on the following key technical lemma.</p>
</div>
<div id="chapter12.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma 12.13</span></span><span id="chapter12.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem13.p1" class="ltx_para">
<p id="chapter12.Thmtheorem13.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">For any distributions <math id="chapter12.Thmtheorem13.p1.m1" class="ltx_Math" alttext="P,P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P,P^{\prime}</annotation></semantics></math>, non-negative loss function <math id="chapter12.Thmtheorem13.p1.m2" class="ltx_Math" alttext="l(\cdot,Z)" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l(\cdot,Z)</annotation></semantics></math> and <math id="chapter12.Thmtheorem13.p1.m3" class="ltx_Math" alttext="1\leq\beta_{*}&lt;2k" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><msub><mi>β</mi><mo>∗</mo></msub><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq\beta_{*}&lt;2k</annotation></semantics></math>, such that <math id="chapter12.Thmtheorem13.p1.m4" class="ltx_Math" alttext="\mathbb{E}_{P}[l(\theta,Z)^{2k}]&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}_{P}[l(\theta,Z)^{2k}]&lt;\infty</annotation></semantics></math>, we have</span></p>
<table id="chapter12.A9.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A9.Ex447"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex447.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}\leq</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex448"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex448.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}+\mathbb{E}_{P}[(l(\theta,Z)-\eta)_{+}^{2k}]^{\frac{1}{2k}}\textnormal{TV}(P,P^{\prime})^{\left(\frac{1}{\beta_{*}}-\frac{1}{2k}\right)}\beta_{*}^{-\frac{1}{2k}}\cdot\left(\frac{2k}{2k-\beta_{*}}\right)^{\frac{1}{\beta_{*}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mo>∗</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></mfrac></mstyle><mo>)</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}+\mathbb{E}_{P}[(l(\theta,Z)-\eta)_{+}^{2k}]^{\frac{1}{2k}}\textnormal{TV}(P,P^{\prime})^{\left(\frac{1}{\beta_{*}}-\frac{1}{2k}\right)}\beta_{*}^{-\frac{1}{2k}}\cdot\left(\frac{2k}{2k-\beta_{*}}\right)^{\frac{1}{\beta_{*}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter12.A9.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A9.p2.1" class="ltx_p"><span id="chapter12.A9.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
By the definition of the total variation distance, we have <math id="chapter12.A9.p2.m1" class="ltx_Math" alttext="P(\ell(\theta;Z)&gt;u)-P^{\prime}(\ell(\theta;Z^{\prime})&gt;u)\leq\textnormal{TV}(P,P^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>Z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(\ell(\theta;Z)&gt;u)-P^{\prime}(\ell(\theta;Z^{\prime})&gt;u)\leq\textnormal{TV}(P,P^{\prime})</annotation></semantics></math> for all <math id="chapter12.A9.p2.m2" class="ltx_Math" alttext="u\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u\geq 0</annotation></semantics></math>.
Let <math id="chapter12.A9.p2.m3" class="ltx_Math" alttext="s_{2k}:=\mathbb{E}[(\ell-\eta)_{+}^{2k}]^{\frac{1}{2k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>:=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">s_{2k}:=\mathbb{E}[(\ell-\eta)_{+}^{2k}]^{\frac{1}{2k}}</annotation></semantics></math>.
By Markov’s inequality and the non-negativity of <math id="chapter12.A9.p2.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, we have</p>
<table id="chapter12.A9.E65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A9.E65.m1" class="ltx_Math" alttext="P(\ell-\eta&gt;u)\leq\frac{\mathbb{E}[(\ell-\eta)_{+}^{2k}]}{u^{2k}}:=(\frac{s_{2k}}{u})^{2k}\qquad\text{for all }\eta\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>&gt;</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><msup><mi>u</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mfrac><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>u</mi></mfrac><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\ell-\eta&gt;u)\leq\frac{\mathbb{E}[(\ell-\eta)_{+}^{2k}]}{u^{2k}}:=(\frac{s_{2k}}{u})^{2k}\qquad\text{for all }\eta\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.2" class="ltx_p">Using integration by parts, we have</p>
<table id="chapter12.A9.Ex449" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A9.Ex449.m1" class="ltx_Math" alttext="\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]=\int_{\eta}^{\infty}\beta_{*}(t-\eta)^{(\beta_{*}-1)}P(\ell\geq t)dt=\int_{0}^{\infty}\beta_{*}u^{(\beta_{*}-1)}P(\ell-\eta\geq u)du." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mi>η</mi><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]=\int_{\eta}^{\infty}\beta_{*}(t-\eta)^{(\beta_{*}-1)}P(\ell\geq t)dt=\int_{0}^{\infty}\beta_{*}u^{(\beta_{*}-1)}P(\ell-\eta\geq u)du.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.3" class="ltx_p">This implies that</p>
<table id="chapter12.A9.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A9.Ex450"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A9.Ex450.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]-\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]-\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex450.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex451"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex451.m1" class="ltx_math_unparsed" alttext="\displaystyle=\left(\int_{0}^{M}+\int_{M}^{\infty}\right)\left(\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>M</mi></msubsup></mstyle><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>M</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mo>)</mo></mrow><mrow><mo>(</mo><msub><mi>β</mi><mo>∗</mo></msub><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mrow><mo>(</mo><mi>P</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi><mo>≥</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>P</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi><mo>≥</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mi>d</mi><mi>u</mi><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\int_{0}^{M}+\int_{M}^{\infty}\right)\left(\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.4" class="ltx_p">Here, <math id="chapter12.A9.p2.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a positive parameter whose value will be determined later. For the first integral, we have</p>
<table id="chapter12.A9.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A9.Ex452"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A9.Ex452.m1" class="ltx_Math" alttext="\displaystyle\int_{0}^{M}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>M</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{M}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex452.m2" class="ltx_Math" alttext="\displaystyle\leq\int_{0}^{M}\beta_{*}u^{(\beta_{*}-1)}\textnormal{TV}(P,P^{\prime})du" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mi>M</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{0}^{M}\beta_{*}u^{(\beta_{*}-1)}\textnormal{TV}(P,P^{\prime})du</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex453"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex453.m1" class="ltx_Math" alttext="\displaystyle=M^{\beta_{*}}\textnormal{TV}(P,P^{\prime})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>M</mi><msub><mi>β</mi><mo>∗</mo></msub></msup><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=M^{\beta_{*}}\textnormal{TV}(P,P^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.5" class="ltx_p">For the second integral, by <a href="#chapter12.A9.E65" title="In Appendix 12.I Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">65</span></a>, we have</p>
<table id="chapter12.A9.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A9.Ex454"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A9.Ex454.m1" class="ltx_Math" alttext="\displaystyle\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>M</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(P(\ell-\eta\geq u)-P^{\prime}(\ell-\eta\geq u)\right)du</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex454.m2" class="ltx_Math" alttext="\displaystyle\leq\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}P(\ell-\eta\geq u)du" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>M</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo>≥</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}P(\ell-\eta\geq u)du</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex455"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex455.m1" class="ltx_Math" alttext="\displaystyle\leq\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(\frac{s_{2k}}{u}\right)^{2k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>M</mi><mi mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>u</mi></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{M}^{\infty}\beta_{*}u^{(\beta_{*}-1)}\left(\frac{s_{2k}}{u}\right)^{2k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex456"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex456.m1" class="ltx_Math" alttext="\displaystyle=\frac{s_{2k}^{2k}}{2k-\beta_{*}}\cdot\frac{1}{M^{2k-\beta_{*}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>M</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{s_{2k}^{2k}}{2k-\beta_{*}}\cdot\frac{1}{M^{2k-\beta_{*}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.6" class="ltx_p">Therefore, by setting <math id="chapter12.A9.p2.m6" class="ltx_math_unparsed" alttext="M=s_{2k}(\textnormal{TV}(P,P^{\prime})\beta_{*})^{-1/2k}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><msup><mrow><mo stretchy="false">(</mo><mtext>TV</mtext><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><msub><mi>β</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M=s_{2k}(\textnormal{TV}(P,P^{\prime})\beta_{*})^{-1/2k}</annotation></semantics></math> which minimizes the sum of two terms, we have</p>
<table id="chapter12.A9.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A9.Ex457"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex457.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]-\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]-\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]\leq</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A9.Ex458"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A9.Ex458.m1" class="ltx_Math" alttext="\displaystyle\inf_{M&gt;0}\left(M^{\beta_{*}}\textnormal{TV}(P,P^{\prime})+\frac{s_{2k}^{2k}}{2k-\beta_{*}}\cdot\frac{1}{M^{2k-\beta_{*}}}\right)=s_{2k}^{\beta_{*}}\textnormal{TV}(P,P^{\prime})^{1-\frac{\beta_{*}}{2k}}\beta_{*}^{-\frac{\beta_{*}}{2k}}\cdot\frac{2k}{2k-\beta_{*}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow></munder><mrow><mo lspace="0em">(</mo><mrow><mrow><msup><mi>M</mi><msub><mi>β</mi><mo>∗</mo></msub></msup><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>M</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></msup></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><msub><mi>β</mi><mo>∗</mo></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mo>∗</mo><mrow><mo>−</mo><mfrac><msub><mi>β</mi><mo>∗</mo></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\inf_{M&gt;0}\left(M^{\beta_{*}}\textnormal{TV}(P,P^{\prime})+\frac{s_{2k}^{2k}}{2k-\beta_{*}}\cdot\frac{1}{M^{2k-\beta_{*}}}\right)=s_{2k}^{\beta_{*}}\textnormal{TV}(P,P^{\prime})^{1-\frac{\beta_{*}}{2k}}\beta_{*}^{-\frac{\beta_{*}}{2k}}\cdot\frac{2k}{2k-\beta_{*}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.7" class="ltx_p">Using the inequality <math id="chapter12.A9.p2.m7" class="ltx_Math" alttext="(A+B)^{\frac{1}{\beta_{*}}}\leq A^{\frac{1}{\beta_{*}}}+B^{\frac{1}{\beta_{*}}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup><mo>≤</mo><mrow><msup><mi>A</mi><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup><mo>+</mo><msup><mi>B</mi><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">(A+B)^{\frac{1}{\beta_{*}}}\leq A^{\frac{1}{\beta_{*}}}+B^{\frac{1}{\beta_{*}}}</annotation></semantics></math> when <math id="chapter12.A9.p2.m8" class="ltx_Math" alttext="\beta_{*}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mo>∗</mo></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{*}\geq 1</annotation></semantics></math>, we have</p>
<table id="chapter12.A9.Ex459" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A9.Ex459.m1" class="ltx_Math" alttext="\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}\leq\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}+s_{2k}\textnormal{TV}(P,P^{\prime})^{\left(\frac{1}{\beta_{*}}-\frac{1}{2k}\right)}\beta_{*}^{-\frac{1}{2k}}\cdot\left(\frac{2k}{2k-\beta_{*}}\right)^{\frac{1}{\beta_{*}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>≤</mo><mrow><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>β</mi><mo>∗</mo></msub></msubsup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow><mo>+</mo><mrow><mrow><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mo>∗</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mfrac></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>β</mi><mo>∗</mo></msub></mrow></mfrac><mo>)</mo></mrow><mfrac><mn>1</mn><msub><mi>β</mi><mo>∗</mo></msub></mfrac></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{P}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}\leq\mathbb{E}_{P^{\prime}}[(\ell-\eta)^{\beta_{*}}_{+}]^{\frac{1}{\beta_{*}}}+s_{2k}\textnormal{TV}(P,P^{\prime})^{\left(\frac{1}{\beta_{*}}-\frac{1}{2k}\right)}\beta_{*}^{-\frac{1}{2k}}\cdot\left(\frac{2k}{2k-\beta_{*}}\right)^{\frac{1}{\beta_{*}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p2.8" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.A9.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A9.p3.1" class="ltx_p">Now we prove <a href="#chapter6.Thmtheorem17" title="Theorem 6.17 (Proof in ). ‣ Theoretical guarantee. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.17</span></a>.</p>
</div>
<div id="chapter12.A9.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A9.p4.1" class="ltx_p"><span id="chapter12.A9.p4.1.1" class="ltx_text ltx_font_bold">Proof </span>
By Lemma <a href="#chapter12.Thmtheorem13" title="Lemma 12.13. ‣ Appendix 12.I Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.13</span></a>, for any <math id="chapter12.A9.p4.m1" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> such that <math id="chapter12.A9.p4.m2" class="ltx_Math" alttext="\textnormal{TV}(P,P^{\prime})\leq\frac{\epsilon}{1-\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\textnormal{TV}(P,P^{\prime})\leq\frac{\epsilon}{1-\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A9.Ex460" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A9.Ex460.m1" class="ltx_Math" alttext="\textnormal{CVaR}_{\alpha}(\theta;P)-\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})\leq 2\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textnormal{CVaR}_{\alpha}(\theta;P)-\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})\leq 2\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p4.2" class="ltx_p">By <a href="#chapter6.Thmtheorem13" title="Corollary 6.13. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">6.13</span></a>, if <math id="chapter12.A9.p4.m3" class="ltx_Math" alttext="{\mathcal{R}}_{\max}(\theta;P)&gt;3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{R}}_{\max}(\theta;P)&gt;3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}</annotation></semantics></math>, then <math id="chapter12.A9.p4.m4" class="ltx_Math" alttext="\textnormal{CVaR}_{\alpha}(\theta;P)&gt;3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">\textnormal{CVaR}_{\alpha}(\theta;P)&gt;3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}</annotation></semantics></math>, which implies that</p>
<table id="chapter12.A9.Ex461" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A9.Ex461.m1" class="ltx_Math" alttext="\frac{\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})}{{\mathcal{R}}_{\max}(\theta;P)}\geq\frac{\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})}{\textnormal{CVaR}_{\alpha}(\theta;P)}=1-\frac{\delta}{\textnormal{CVaR}_{\alpha}(\theta;P)}\geq 1-\frac{2\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}}{3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}}=\frac{1}{3}" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>≥</mo><mfrac><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>δ</mi><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></msqrt></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></msqrt></mrow></mfrac></mrow><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\frac{\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})}{{\mathcal{R}}_{\max}(\theta;P)}\geq\frac{\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})}{\textnormal{CVaR}_{\alpha}(\theta;P)}=1-\frac{\delta}{\textnormal{CVaR}_{\alpha}(\theta;P)}\geq 1-\frac{2\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}}{3\alpha^{-1}\sigma\sqrt{\frac{\epsilon}{1-\epsilon}}}=\frac{1}{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A9.p4.3" class="ltx_p">holds for any <math id="chapter12.A9.p4.m5" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> such that <math id="chapter12.A9.p4.m6" class="ltx_Math" alttext="\textnormal{TV}(P,P^{\prime})\leq\frac{\epsilon}{1-\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mi>ϵ</mi><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\textnormal{TV}(P,P^{\prime})\leq\frac{\epsilon}{1-\epsilon}</annotation></semantics></math>. By <a href="#chapter6.Thmtheorem15" title="Lemma 6.15. ‣ Method. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6.15</span></a>, taking the infimum over <math id="chapter12.A9.p4.m7" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> yields the first inequality of <a href="#S27.E35" title="In Theorem 6.17 (Proof in ). ‣ Theoretical guarantee. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">35</span></a>.
And by <a href="#chapter6.Thmtheorem13" title="Corollary 6.13. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">6.13</span></a>, we have <math id="chapter12.A9.p4.m8" class="ltx_Math" alttext="D_{\chi^{2},\rho}(\theta;P^{\prime})\geq\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mrow><msup><mi>χ</mi><mn>2</mn></msup><mo>,</mo><mi>ρ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mtext>CVaR</mtext><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\chi^{2},\rho}(\theta;P^{\prime})\geq\textnormal{CVaR}_{\alpha}(\theta;P^{\prime})</annotation></semantics></math> for all <math id="chapter12.A9.p4.m9" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="chapter12.A9.p4.m10" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math>.
This combined with the above inequality yields the second inequality of <a href="#S27.E35" title="In Theorem 6.17 (Proof in ). ‣ Theoretical guarantee. ‣ 27 Distributionally and Outlier Robust Optimization ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">35</span></a>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
