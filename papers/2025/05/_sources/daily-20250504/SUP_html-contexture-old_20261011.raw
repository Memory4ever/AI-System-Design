</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              Set Gram matrix <math id="alg1.l11.m1" class="ltx_Math" alttext="{\bm{G}}\in\mathbb{R}^{m\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝑮</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}\in\mathbb{R}^{m\times m}</annotation></semantics></math> as <math id="alg1.l11.m2" class="ltx_Math" alttext="{\bm{G}}[p,q]=k(x_{p},x_{q}^{j-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>p</mi></msub><mo>,</mo><msubsup><mi>x</mi><mi>q</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}[p,q]=k(x_{p},x_{q}^{j-1})</annotation></semantics></math>; <math id="alg1.l11.m3" class="ltx_Math" alttext="{\bm{B}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑮</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}</annotation></semantics></math>
  
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg1.l12.m1" class="ltx_Math" alttext="k\leftarrow{k_{X}^{+}}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mmultiscripts><mi>k</mi><mi>X</mi><mo>+</mo><mi>j</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">k\leftarrow{k_{X}^{+}}_{j}</annotation></semantics></math>; <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l12.m2" class="ltx_Math" alttext="i\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m]</annotation></semantics></math> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">do</span> <math id="alg1.l12.m3" class="ltx_Math" alttext="x_{i}^{j}\leftarrow x_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mi>j</mi></msubsup><mo stretchy="false">←</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">x_{i}^{j}\leftarrow x_{i}</annotation></semantics></math> <span id="alg1.l12.5" class="ltx_text" style="float:right;"><math id="alg1.l12.m4" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> reset <math id="alg1.l12.m5" class="ltx_Math" alttext="x_{i}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>i</mi><mi>j</mi></msubsup><annotation encoding="application/x-tex">x_{i}^{j}</annotation></semantics></math> to the original input
</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
             <span id="alg1.l13.3" class="ltx_text ltx_font_bold">else<span id="alg1.l13.3.1" class="ltx_text ltx_font_medium" style="float:right;"><math id="alg1.l13.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg1.l13.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to context <math id="alg1.l13.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>
</span></span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              Sample <math id="alg1.l14.m1" class="ltx_math_unparsed" alttext="a_{i}^{j}\sim P_{j}^{+}(\cdot|x_{i}^{j-1}),\;x_{i}^{j}\sim Q_{j}^{+}(\cdot|a_{i}^{j})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup><mo>∼</mo><msubsup><mi>P</mi><mi>j</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>x</mi><mi>i</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.447em">,</mo><msubsup><mi>x</mi><mi>i</mi><mi>j</mi></msubsup><mo>∼</mo><msubsup><mi>Q</mi><mi>j</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mi>i</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a_{i}^{j}\sim P_{j}^{+}(\cdot|x_{i}^{j-1}),\;x_{i}^{j}\sim Q_{j}^{+}(\cdot|a_{i}^{j})</annotation></semantics></math>
  
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
