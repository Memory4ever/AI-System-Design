<td id="S23.T8.2.5.6" class="ltx_td ltx_nopad_r ltx_align_center">1.45</td></tr>
<tr id="S23.T8.2.6" class="ltx_tr">
<th id="S23.T8.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Amazon - Photos</th>
<th id="S23.T8.2.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">8</th>
