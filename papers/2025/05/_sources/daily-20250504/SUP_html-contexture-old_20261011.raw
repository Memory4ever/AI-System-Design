<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex342.m2" class="ltx_Math" alttext="\displaystyle\left\|{\bm{A}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mi>𝑨</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{A}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}\Delta_{t}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
