             Set Gram matrix <math id="alg1.l18.m1" class="ltx_Math" alttext="{\bm{G}}\in\mathbb{R}^{m\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝑮</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}\in\mathbb{R}^{m\times m}</annotation></semantics></math> as <math id="alg1.l18.m2" class="ltx_Math" alttext="{\bm{G}}[p,q]=k(x_{p},x_{q}^{r-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>p</mi></msub><mo>,</mo><msubsup><mi>x</mi><mi>q</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}[p,q]=k(x_{p},x_{q}^{r-1})</annotation></semantics></math>; <math id="alg1.l18.m3" class="ltx_Math" alttext="{\bm{B}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑮</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}</annotation></semantics></math>
 
