<td id="S23.T8.2.6.4" class="ltx_td ltx_align_center">238,162</td>
<td id="S23.T8.2.6.5" class="ltx_td ltx_align_center">2.09</td>
<td id="S23.T8.2.6.6" class="ltx_td ltx_nopad_r ltx_align_center">2.09</td></tr>
<tr id="S23.T8.2.7" class="ltx_tr">
<th id="S23.T8.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Coauthor - CS</th>
<th id="S23.T8.2.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">15</th>
<td id="S23.T8.2.7.3" class="ltx_td ltx_align_center">18,333</td>
<td id="S23.T8.2.7.4" class="ltx_td ltx_align_center">163,788</td>
<td id="S23.T8.2.7.5" class="ltx_td ltx_align_center">1.64</td>
<td id="S23.T8.2.7.6" class="ltx_td ltx_nopad_r ltx_align_center">1.64</td></tr>
<tr id="S23.T8.2.8" class="ltx_tr">
<th id="S23.T8.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Coauthor - Physics</th>
<th id="S23.T8.2.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">5</th>
<td id="S23.T8.2.8.3" class="ltx_td ltx_align_center">34,493</td>
<td id="S23.T8.2.8.4" class="ltx_td ltx_align_center">495,924</td>
<td id="S23.T8.2.8.5" class="ltx_td ltx_align_center">0.29</td>
<td id="S23.T8.2.8.6" class="ltx_td ltx_nopad_r ltx_align_center">0.29</td></tr>
<tr id="S23.T8.2.9" class="ltx_tr">
<th id="S23.T8.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DBLP</th>
<th id="S23.T8.2.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">4</th>
<td id="S23.T8.2.9.3" class="ltx_td ltx_align_center">17,716</td>
<td id="S23.T8.2.9.4" class="ltx_td ltx_align_center">105,734</td>
<td id="S23.T8.2.9.5" class="ltx_td ltx_align_center">0.45</td>
<td id="S23.T8.2.9.6" class="ltx_td ltx_nopad_r ltx_align_center">0.45</td></tr>
<tr id="S23.T8.2.10" class="ltx_tr">
<th id="S23.T8.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">CoraFull</th>
<th id="S23.T8.2.10.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">70</th>
<td id="S23.T8.2.10.3" class="ltx_td ltx_align_center ltx_border_bb">19,793</td>
<td id="S23.T8.2.10.4" class="ltx_td ltx_align_center ltx_border_bb">126,842</td>
<td id="S23.T8.2.10.5" class="ltx_td ltx_align_center ltx_border_bb">7.07</td>
