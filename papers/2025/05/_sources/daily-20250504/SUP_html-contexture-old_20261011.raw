               <span id="alg3.l6.3" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l6.m1" class="ltx_Math" alttext="p=q,\cdots,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>=</mo><mi>q</mi></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=q,\cdots,2</annotation></semantics></math> <span id="alg3.l6.4" class="ltx_text ltx_font_bold">do</span> <math id="alg3.l6.m2" class="ltx_Math" alttext="{\bm{v}}\leftarrow\frac{{\bm{G}}_{k}{\bm{v}}}{m+n}+\pi_{p}\tilde{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo stretchy="false">←</mo><mrow><mfrac><mrow><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>+</mo><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}\leftarrow\frac{{\bm{G}}_{k}{\bm{v}}}{m+n}+\pi_{p}\tilde{{\bm{\alpha}}}</annotation></semantics></math>

</div>
<div id="alg3.l7" class="ltx_listingline">
