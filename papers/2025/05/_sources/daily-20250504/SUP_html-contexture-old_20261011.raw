</table>
</div>
<div id="chapter8.A2.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A2.p2.1" class="ltx_p">Denote <math id="chapter8.A2.p2.m1" class="ltx_Math" alttext="{\bm{W}}=(w_{ij})_{1\leq i\leq d_{A},1\leq j\leq d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>d</mi><mi>A</mi></msub></mrow><mo>,</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>d</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{W}}=(w_{ij})_{1\leq i\leq d_{A},1\leq j\leq d}</annotation></semantics></math>. We have</p>
<table id="chapter8.A2.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A2.Ex109.m1" class="ltx_Math" alttext="\frac{\partial{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]}," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mrow><mo>∂</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mfrac><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><msub><mi>A</mi><mi>i</mi></msub><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\partial{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A2.p2.2" class="ltx_p">which implies that for a fixed <math id="chapter8.A2.p2.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, the minimizer of <math id="chapter8.A2.p2.m3" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> satisfies</p>
<table id="chapter8.A2.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A2.Ex110.m1" class="ltx_Math" alttext="w_{ij}=\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><msub><mi>A</mi><mi>i</mi></msub><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w_{ij}=\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter8.A2.p3" class="ltx_para ltx_noindent">
<p id="chapter8.A2.p3.1" class="ltx_p">Combining the minimizer of <math id="chapter8.A2.p3.m1" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> with <math id="chapter8.A2.p3.m2" class="ltx_Math" alttext="{\mathcal{R}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">{\mathcal{R}}</annotation></semantics></math>, it suffices to maximize</p>
<table id="chapter8.A2.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A2.Ex111.m1" class="ltx_Math" alttext="{\mathcal{R}}^{\prime}=\sum_{i,j}{\left[\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]}^{2}=\iint\sum_{j}\Phi_{j}(x_{1})\Phi_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>′</mo></msup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msup><mrow><mo>[</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>A</mi><mi>i</mi></msub><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}^{\prime}=\sum_{i,j}{\left[\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;\frac{A_{i}}{\sqrt{{P_{\mathcal{A}}}(A)}}\Phi_{j}(X)\right]}^{2}=\iint\sum_{j}\Phi_{j}(x_{1})\Phi_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A2.p3.2" class="ltx_p">where</p>
<table id="chapter8.A2.Ex112" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A2.Ex112X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A2.Ex112X.m2" class="ltx_Math" alttext="\displaystyle\hat{k}(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{k}(x_{1},x_{2})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A2.Ex112X.m3" class="ltx_Math" alttext="\displaystyle=\iint\frac{{\left\langle a_{1},a_{2}\right\rangle}}{\sqrt{{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})}}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>⟨</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint\frac{{\left\langle a_{1},a_{2}\right\rangle}}{\sqrt{{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})}}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A2.Ex112Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A2.Ex112Xa.m2" class="ltx_Math" alttext="\displaystyle=\iint\frac{{\mathbb{I}}[a_{1}=a_{2}]}{\sqrt{{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})}}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝕀</mi><mo stretchy="false">[</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo>=</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint\frac{{\mathbb{I}}[a_{1}=a_{2}]}{\sqrt{{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})}}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A2.Ex112Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A2.Ex112Xb.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{P^{+}(a|x_{1})P^{+}(a|x_{2})}{{P_{\mathcal{A}}}(a)}dy." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>y</mi></mrow></mrow></mrow></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{P^{+}(a|x_{1})P^{+}(a|x_{2})}{{P_{\mathcal{A}}}(a)}dy.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A2.p3.3" class="ltx_p">Thus <math id="chapter8.A2.p3.m3" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> is a minimizer of <math id="chapter8.A2.p3.m4" class="ltx_Math" alttext="{\mathcal{R}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Phi)</annotation></semantics></math> if <math id="chapter8.A2.p3.m5" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> extracts the top-<math id="chapter8.A2.p3.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="chapter8.A2.p3.m7" class="ltx_Math" alttext="\hat{k}(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{k}(x_{1},x_{2})</annotation></semantics></math>. Combining with <a href="#chapter1.Thmtheorem3" title="Definition 1.3. ‣ 3 Spectral Properties of a Context ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definitions</span> <span class="ltx_text ltx_ref_tag">1.3</span></a> and <a href="#chapter1.Thmtheorem7" title="Definition 1.7. ‣ 3 Spectral Properties of a Context ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.7</span></a> yields the desired results.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter8.A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.C </span>Proof of Theorem <a href="#chapter2.Thmtheorem6" title="Theorem 2.6 (Proof in ). ‣ Regression tasks. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a></h2>

<div id="chapter8.A3.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A3.p1.1" class="ltx_p"><span id="chapter8.A3.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
If the linear predictor is unbiased, then the proof is the same as <a href="#chapter8.A1" title="Appendix 8.A Proof of Theorem ‣ Chapter 8 Proofs for Chapter 2 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">8.A</span></a>.
Consider the case where the linear predictor is biased. Then the pretraining objective can be rewritten as</p>
<table id="chapter8.A3.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A3.Ex113.m1" class="ltx_Math" alttext="{\mathcal{R}}(\Phi,{\bm{W}},{\bm{b}})=\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}+{\left\|\hat{\bm{b}}\right\|}_{2}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mi>𝑾</mi><mo>,</mo><mi>𝒃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>𝒃</mi><mo>^</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Phi,{\bm{W}},{\bm{b}})=\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}+{\left\|\hat{\bm{b}}\right\|}_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A3.p1.2" class="ltx_p">where <math id="chapter8.A3.p1.m1" class="ltx_Math" alttext="\hat{\bm{b}}={\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]-\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]+{\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝒃</mi><mo>^</mo></mover><mo>=</mo><mrow><mrow><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{b}}={\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]-\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]+{\bm{b}}</annotation></semantics></math>.
Thus, if <math id="chapter8.A3.p1.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> and <math id="chapter8.A3.p1.m3" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> are fixed, then the optimal <math id="chapter8.A3.p1.m4" class="ltx_Math" alttext="{\bm{b}}^{*}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]-{\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒃</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{b}}^{*}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]-{\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]</annotation></semantics></math>.</p>
</div>
<div id="chapter8.A3.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A3.p2.1" class="ltx_p">Assuming, without loss of generality, that <math id="chapter8.A3.p2.m1" class="ltx_Math" alttext="\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\tilde{\Phi}_{i}\tilde{\Phi}_{j}]=\delta_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\tilde{\Phi}_{i}\tilde{\Phi}_{j}]=\delta_{ij}</annotation></semantics></math>; otherwise we can perform Gram-Schmidt process on <math id="chapter8.A3.p2.m2" class="ltx_Math" alttext="\tilde{\phi}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{\phi}_{i}</annotation></semantics></math> and change <math id="chapter8.A3.p2.m3" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> accordingly. Then, it amounts to minimize</p>
<table id="chapter8.A3.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A3.Ex114.m1" class="ltx_Math" alttext="{\mathcal{R}}(\Phi,{\bm{W}},{\bm{b}}^{*})={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left\langle\tilde{A},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mi>𝑾</mi><mo>,</mo><msup><mi>𝒃</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mrow><mo>‖</mo><mi>𝑾</mi><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>,</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Phi,{\bm{W}},{\bm{b}}^{*})={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left\langle\tilde{A},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A3.p2.2" class="ltx_p">for which we have</p>
<table id="chapter8.A3.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A3.Ex115.m1" class="ltx_Math" alttext="\frac{\partial{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mrow><mo>∂</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mfrac><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A3.p2.3" class="ltx_p">Thus, the optimal <math id="chapter8.A3.p2.m4" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> is given by <math id="chapter8.A3.p2.m5" class="ltx_Math" alttext="w^{*}_{ij}=\mathbb{E}_{(X,A)\sim P^{+}}{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w^{*}_{ij}=\mathbb{E}_{(X,A)\sim P^{+}}{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}</annotation></semantics></math>. Note that <math id="chapter8.A3.p2.m6" class="ltx_Math" alttext="\mathbb{E}_{A\sim{P_{\mathcal{A}}}}{\left\|\tilde{A}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}_{A\sim{P_{\mathcal{A}}}}{\left\|\tilde{A}\right\|}_{2}^{2}</annotation></semantics></math> is a constant.
Thus, minimizing <math id="chapter8.A3.p2.m7" class="ltx_Math" alttext="{\mathcal{R}}(\Phi,{\bm{W}}^{*},{\bm{b}}^{*})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>𝑾</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>𝒃</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Phi,{\bm{W}}^{*},{\bm{b}}^{*})</annotation></semantics></math> is equivalent to maximizing</p>
<table id="chapter8.A3.Ex116" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A3.Ex116X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A3.Ex116X.m2" class="ltx_Math" alttext="\displaystyle{\mathcal{J}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒥</mi><annotation encoding="application/x-tex">\displaystyle{\mathcal{J}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A3.Ex116X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}{\left[\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><msup><mrow><mo>[</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}{\left[\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A3.Ex116Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A3.Ex116Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2}){\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{X}}}(x_{1})P^{+}(a_{1}|x_{1}){P_{\mathcal{X}}}(x_{2})P^{+}(a_{2}|x_{2})dx_{1}da_{1}dx_{2}da_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2}){\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{X}}}(x_{1})P^{+}(a_{1}|x_{1}){P_{\mathcal{X}}}(x_{2})P^{+}(a_{2}|x_{2})dx_{1}da_{1}dx_{2}da_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A3.Ex116Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A3.Ex116Xb.m2" class="ltx_Math" alttext="\displaystyle=\iint\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder></mstyle><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A3.p2.4" class="ltx_p">where</p>
<table id="chapter8.A3.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A3.Ex117.m1" class="ltx_Math" alttext="\hat{k}(x_{1},x_{2})=\iint{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{k}(x_{1},x_{2})=\iint{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A3.p2.5" class="ltx_p">Then, we can complete the proof in the same way as <a href="#chapter8.A1" title="Appendix 8.A Proof of Theorem ‣ Chapter 8 Proofs for Chapter 2 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">8.A</span></a>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter8.A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.D </span>Proof of Theorem <a href="#chapter2.Thmtheorem8" title="Theorem 2.8 (Proof in ). ‣ Graphs. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.8</span></a></h2>

<div id="chapter8.A4.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A4.p1.1" class="ltx_p"><span id="chapter8.A4.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Without loss of generality, suppose <math id="chapter8.A4.p1.m1" class="ltx_Math" alttext="\bar{\Phi}={\bm{0}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>¯</mo></mover><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\bar{\Phi}={\bm{0}}</annotation></semantics></math>.
We have</p>
<table id="chapter8.A4.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A4.Ex118.m1" class="ltx_Math" alttext="{\left(T_{P^{+}}f\right)}(u)=\sum_{v}f(v)\frac{w(u,v)}{D(u)};\quad{\left\langle T_{P^{+}}f,g\right\rangle}_{{P_{\mathcal{X}}}}=\sum_{u,v}f(u)g(v)\frac{w(u,v)}{D_{\textnormal{sum}}}={\left\langle f,T_{P^{+}}g\right\rangle}_{{P_{\mathcal{X}}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>v</mi></munder><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo rspace="1.167em">;</mo><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>g</mi></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>D</mi><mtext>sum</mtext></msub></mfrac></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left(T_{P^{+}}f\right)}(u)=\sum_{v}f(v)\frac{w(u,v)}{D(u)};\quad{\left\langle T_{P^{+}}f,g\right\rangle}_{{P_{\mathcal{X}}}}=\sum_{u,v}f(u)g(v)\frac{w(u,v)}{D_{\textnormal{sum}}}={\left\langle f,T_{P^{+}}g\right\rangle}_{{P_{\mathcal{X}}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A4.p1.2" class="ltx_p">which implies that <math id="chapter8.A4.p1.m2" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> is self-adjoint.
Therefore, the eigenfunctions of <math id="chapter8.A4.p1.m3" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> are the same as those of <math id="chapter8.A4.p1.m4" class="ltx_Math" alttext="T_{P^{+}}^{*}T_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">T_{P^{+}}^{*}T_{P^{+}}</annotation></semantics></math>, with square root eigenvalues.</p>
</div>
<div id="chapter8.A4.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A4.p2.1" class="ltx_p">For the objective of <a href="#S6.E4" title="In Graphs. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">4</span></a>, we have</p>
<table id="chapter8.A4.Ex119" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A4.Ex119X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A4.Ex119X.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbb{E}_{(u,v)\sim P^{+}}{\left[{\left\|\Phi(u)-\Phi(v)\right\|}_{2}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbb{E}_{(u,v)\sim P^{+}}{\left[{\left\|\Phi(u)-\Phi(v)\right\|}_{2}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A4.Ex119X.m3" class="ltx_Math" alttext="\displaystyle=\underset{(u,v)\sim P_{w}}{\mathbb{E}}{\left[{\left\|\Phi(u)\right\|}_{2}^{2}-{\left\langle\Phi(u),\Phi(v)\right\rangle}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">u</mi><mo>,</mo><mi mathsize="0.700em">v</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi mathsize="0.710em">w</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{(u,v)\sim P_{w}}{\mathbb{E}}{\left[{\left\|\Phi(u)\right\|}_{2}^{2}-{\left\langle\Phi(u),\Phi(v)\right\rangle}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A4.Ex119Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A4.Ex119Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{d}{\left({\left\|\phi_{i}\right\|}_{P_{\mathcal{X}}}^{2}-{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>(</mo><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{d}{\left({\left\|\phi_{i}\right\|}_{P_{\mathcal{X}}}^{2}-{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A4.Ex119Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A4.Ex119Xb.m2" class="ltx_Math" alttext="\displaystyle=d-\sum_{i=1}^{d}{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>d</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msub><mrow><mo>⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=d-\sum_{i=1}^{d}{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A4.p2.2" class="ltx_p">Note that <math id="chapter8.A4.p2.m1" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math> and <math id="chapter8.A4.p2.m2" class="ltx_Math" alttext="(v,u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,u)</annotation></semantics></math> can be drawn from <math id="chapter8.A4.p2.m3" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math> with equal probability.
We conclude that <math id="chapter8.A4.p2.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> extracts the top-<math id="chapter8.A4.p2.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="chapter8.A4.p2.m6" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, which are the same as the top-<math id="chapter8.A4.p2.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="chapter8.A4.p2.m8" class="ltx_Math" alttext="T_{P^{+}}^{*}T_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">T_{P^{+}}^{*}T_{P^{+}}</annotation></semantics></math>. This implies that <math id="chapter8.A4.p2.m9" class="ltx_Math" alttext="\tilde{\Phi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Phi}</annotation></semantics></math> learns the contexture of <math id="chapter8.A4.p2.m10" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter8.A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.E </span>Proof of Theorem <a href="#chapter2.Thmtheorem9" title="Theorem 2.9 (Proof in ). ‣ Self-supervised learning (SSL) with random transformations. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.9</span></a></h2>

<div id="chapter8.A5.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A5.p1.1" class="ltx_p"><span id="chapter8.A5.p1.1.1" class="ltx_text ltx_font_bold">Proof </span></p>
<ol id="chapter8.A5.I1" class="ltx_enumerate">
<li id="chapter8.A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="chapter8.A5.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A5.I1.i1.p1.1" class="ltx_p">The spectral contrastive loss is</p>
<table id="chapter8.A5.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex120.m1" class="ltx_Math" alttext="{\mathcal{R}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}+\frac{1}{2}\underset{A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}\right]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><msup><mi mathsize="0.700em">A</mi><mo mathsize="0.710em">−</mo></msup><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}+\frac{1}{2}\underset{A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i1.p1.2" class="ltx_p">Suppose <math id="chapter8.A5.I1.i1.p1.m1" class="ltx_Math" alttext="\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}</annotation></semantics></math> where <math id="chapter8.A5.I1.i1.p1.m2" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="chapter8.A5.I1.i1.p1.m3" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> in <a href="#chapter1.Thmtheorem4" title="Lemma 1.4 (Duality property). ‣ 3 Spectral Properties of a Context ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">1.4</span></a>. Since <math id="chapter8.A5.I1.i1.p1.m4" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="chapter8.A5.I1.i1.p1.m5" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> and <math id="chapter8.A5.I1.i1.p1.m6" class="ltx_Math" alttext="\nu_{0}\equiv 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>0</mn></msub><mo>≡</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\nu_{0}\equiv 1</annotation></semantics></math>, we can get for <math id="chapter8.A5.I1.i1.p1.m7" class="ltx_Math" alttext="j\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j\geq 1</annotation></semantics></math>, <math id="chapter8.A5.I1.i1.p1.m8" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ν</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}=0</annotation></semantics></math>. Thus we can get <math id="chapter8.A5.I1.i1.p1.m9" class="ltx_Math" alttext="\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}</annotation></semantics></math>.</p>
</div>
<div id="chapter8.A5.I1.i1.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A5.I1.i1.p2.1" class="ltx_p">Denote matrix <math id="chapter8.A5.I1.i1.p2.m1" class="ltx_Math" alttext="{\bm{C}}=(c_{ij})_{1\leq i\leq d,j\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>𝑪</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{C}}=(c_{ij})_{1\leq i\leq d,j\geq 1}</annotation></semantics></math>, matrix <math id="chapter8.A5.I1.i1.p2.m2" class="ltx_Math" alttext="{\bm{B}}=(b_{ij}):={\bm{C}}^{\top}{\bm{C}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><msup><mi>𝑪</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑪</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}=(b_{ij}):={\bm{C}}^{\top}{\bm{C}}</annotation></semantics></math>, and matrix <math id="chapter8.A5.I1.i1.p2.m3" class="ltx_Math" alttext="{\bm{D}}={\textnormal{diag}}(s_{1}^{2},s_{2}^{2},\cdots)" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{D}}={\textnormal{diag}}(s_{1}^{2},s_{2}^{2},\cdots)</annotation></semantics></math> where <math id="chapter8.A5.I1.i1.p2.m4" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math> is the singular value of <math id="chapter8.A5.I1.i1.p2.m5" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>. We have</p>
<table id="chapter8.A5.Ex121" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A5.Ex121X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex121X.m2" class="ltx_Math" alttext="\displaystyle\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex121Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex121Xa.m2" class="ltx_Math" alttext="\displaystyle=\iiint{\left\langle\tilde{\Psi}(a),\tilde{\Psi}(a^{+})\right\rangle}P^{+}(a|x)P^{+}(a^{+}|x){P_{\mathcal{X}}}(x)dxdada^{+}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∭</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>+</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iiint{\left\langle\tilde{\Psi}(a),\tilde{\Psi}(a^{+})\right\rangle}P^{+}(a|x)P^{+}(a^{+}|x){P_{\mathcal{X}}}(x)dxdada^{+}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex121Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex121Xb.m2" class="ltx_Math" alttext="\displaystyle=\int{\left\langle\int\tilde{\Psi}(a)P^{+}(a|x)dy,\int\tilde{\Psi}(a^{+})P^{+}(a^{+}|x)da^{+}\right\rangle}p(x)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mo lspace="0em">∫</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo rspace="0em">,</mo><mrow><mo>∫</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>+</mo></msup></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle\int\tilde{\Psi}(a)P^{+}(a|x)dy,\int\tilde{\Psi}(a^{+})P^{+}(a^{+}|x)da^{+}\right\rangle}p(x)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex121Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex121Xc.m2" class="ltx_Math" alttext="\displaystyle=\int{\left\langle T_{P^{+}}\tilde{\Psi}(x),T_{P^{+}}\tilde{\Psi}(x)\right\rangle}p(x)dx=\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle T_{P^{+}}\tilde{\Psi}(x),T_{P^{+}}\tilde{\Psi}(x)\right\rangle}p(x)dx=\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex121Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex121Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i}s_{i}^{2}b_{ii};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i}s_{i}^{2}b_{ii};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i1.p2.2" class="ltx_p">and</p>
<table id="chapter8.A5.Ex122" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A5.Ex122X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A5.Ex122X.m2" class="ltx_Math" alttext="\displaystyle\underset{A,A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mrow><msup><mi mathsize="0.700em">A</mi><mo mathsize="0.710em">−</mo></msup><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{A,A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex122X.m3" class="ltx_Math" alttext="\displaystyle=\iint{\left[\sum_{i=1}^{d}\tilde{\psi}_{i}(a)\tilde{\psi}_{i}(a^{-})\right]}^{2}d{P_{\mathcal{A}}}(a)d{P_{\mathcal{A}}}(a^{-})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint{\left[\sum_{i=1}^{d}\tilde{\psi}_{i}(a)\tilde{\psi}_{i}(a^{-})\right]}^{2}d{P_{\mathcal{A}}}(a)d{P_{\mathcal{A}}}(a^{-})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex122Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex122Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{1\leq i,j\leq d}{\left[\int\tilde{\psi}_{i}(a)\tilde{\psi}_{j}(a)d{P_{\mathcal{A}}}(a)\right]}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≤</mo><mi>d</mi></mrow></mrow></munder></mstyle><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{1\leq i,j\leq d}{\left[\int\tilde{\psi}_{i}(a)\tilde{\psi}_{j}(a)d{P_{\mathcal{A}}}(a)\right]}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A5.Ex122Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A5.Ex122Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}b_{ij}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><msubsup><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}b_{ij}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i1.p2.3" class="ltx_p">Thus, we have</p>
<table id="chapter8.A5.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex123.m1" class="ltx_math_unparsed" alttext="{\mathcal{R}}(\Psi)=-\sum_{i}s_{i}^{2}b_{ii}+\frac{1}{2}\sum_{i,j}b_{ij}^{2}\\
=\|{\bm{B}}-{\bm{D}}\|_{F}^{2}-\|{\bm{D}}\|_{F}^{2}." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝑩</mi><mo>−</mo><mi>𝑫</mi><msubsup><mo lspace="0em" rspace="0em">∥</mo><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝑫</mi><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mi>F</mi><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Psi)=-\sum_{i}s_{i}^{2}b_{ii}+\frac{1}{2}\sum_{i,j}b_{ij}^{2}\\
=\|{\bm{B}}-{\bm{D}}\|_{F}^{2}-\|{\bm{D}}\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i1.p2.4" class="ltx_p">So if suffices to minimize <math id="chapter8.A5.I1.i1.p2.m6" class="ltx_Math" alttext="\|{\bm{B}}-{\bm{D}}\|_{F}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑩</mi><mo>−</mo><mi>𝑫</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|{\bm{B}}-{\bm{D}}\|_{F}^{2}</annotation></semantics></math> where <math id="chapter8.A5.I1.i1.p2.m7" class="ltx_Math" alttext="\text{rank}({\bm{B}})\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>rank</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\text{rank}({\bm{B}})\leq d</annotation></semantics></math>. By Eckart-Young-Mirsky Theorem, we know the minimizer of <math id="chapter8.A5.I1.i1.p2.m8" class="ltx_Math" alttext="{\bm{B}}" display="inline" intent=":literal"><semantics><mi>𝑩</mi><annotation encoding="application/x-tex">{\bm{B}}</annotation></semantics></math> is <math id="chapter8.A5.I1.i1.p2.m9" class="ltx_Math" alttext="{\bm{B}}^{*}=\text{diag}(s_{1}^{2},\cdots,s_{d}^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑩</mi><mo>∗</mo></msup><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}^{*}=\text{diag}(s_{1}^{2},\cdots,s_{d}^{2})</annotation></semantics></math>. Thus the minimizer of <math id="chapter8.A5.I1.i1.p2.m10" class="ltx_Math" alttext="{\bm{C}}" display="inline" intent=":literal"><semantics><mi>𝑪</mi><annotation encoding="application/x-tex">{\bm{C}}</annotation></semantics></math> should be <math id="chapter8.A5.I1.i1.p2.m11" class="ltx_Math" alttext="{\bm{C}}^{*}={\bm{U}}{\textnormal{diag}}(s_{1},\cdots,s_{d})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑪</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>s</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}^{*}={\bm{U}}{\textnormal{diag}}(s_{1},\cdots,s_{d})</annotation></semantics></math> where <math id="chapter8.A5.I1.i1.p2.m12" class="ltx_Math" alttext="{\bm{U}}\in{\mathbb{R}}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{U}}\in{\mathbb{R}}^{d\times d}</annotation></semantics></math> is an orthonormal matrix. This indicates the minimizer <math id="chapter8.A5.I1.i1.p2.m13" class="ltx_Math" alttext="\tilde{\Psi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Psi}^{*}</annotation></semantics></math> extracts the top-<math id="chapter8.A5.I1.i1.p2.m14" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions of <math id="chapter8.A5.I1.i1.p2.m15" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, and hence <math id="chapter8.A5.I1.i1.p2.m16" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="chapter8.A5.I1.i1.p2.m17" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="chapter8.A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="chapter8.A5.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A5.I1.i2.p1.1" class="ltx_p">Non-contrastive learning is done by minimizing</p>
<table id="chapter8.A5.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex124.m1" class="ltx_Math" alttext="{\mathcal{R}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\|\Psi(A)-\Psi(A^{+})\right\|}_{2}^{2}\right]}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\|\Psi(A)-\Psi(A^{+})\right\|}_{2}^{2}\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i2.p1.2" class="ltx_p">subject to <math id="chapter8.A5.I1.i2.p1.m1" class="ltx_Math" alttext="\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi mathvariant="normal">Ψ</mi><mo>]</mo></mrow></mrow><mo>=</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}</annotation></semantics></math>.
This amounts to minimizing <math id="chapter8.A5.I1.i2.p1.m2" class="ltx_Math" alttext="F(\Psi)=-\mathbb{E}_{A,A^{+}}[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>+</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\Psi)=-\mathbb{E}_{A,A^{+}}[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}]</annotation></semantics></math>, because <math id="chapter8.A5.I1.i2.p1.m3" class="ltx_Math" alttext="{\mathcal{R}}(\Psi)-2F(\Psi)=2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Psi)-2F(\Psi)=2</annotation></semantics></math> is a constant under the constraint <math id="chapter8.A5.I1.i2.p1.m4" class="ltx_Math" alttext="\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi mathvariant="normal">Ψ</mi><mo>]</mo></mrow></mrow><mo>=</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}</annotation></semantics></math>.
Suppose <math id="chapter8.A5.I1.i2.p1.m5" class="ltx_Math" alttext="\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}</annotation></semantics></math> where <math id="chapter8.A5.I1.i2.p1.m6" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="chapter8.A5.I1.i2.p1.m7" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> in <a href="#chapter1.Thmtheorem5" title="Lemma 1.5 (Spectral decomposition). ‣ 3 Spectral Properties of a Context ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">1.5</span></a>. Since <math id="chapter8.A5.I1.i2.p1.m8" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ν</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}</annotation></semantics></math>, we can get <math id="chapter8.A5.I1.i2.p1.m9" class="ltx_Math" alttext="\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}</annotation></semantics></math>.</p>
</div>
<div id="chapter8.A5.I1.i2.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A5.I1.i2.p2.1" class="ltx_p">Using the same calculation as in (i), we have</p>
<table id="chapter8.A5.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex125.m1" class="ltx_math_unparsed" alttext="F(\Psi)=-\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}=-\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}=-\sum_{i}s_{i}^{2}b_{ii}." display="block" intent=":literal"><semantics><mrow><mi>F</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mrow><mo>⟨</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow><mo>]</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\Psi)=-\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}=-\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}=-\sum_{i}s_{i}^{2}b_{ii}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i2.p2.2" class="ltx_p">By <math id="chapter8.A5.I1.i2.p2.m1" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}{\left[\tilde{\psi}_{i}\tilde{\psi}_{j}\right]}=\delta_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}{\left[\tilde{\psi}_{i}\tilde{\psi}_{j}\right]}=\delta_{ij}</annotation></semantics></math>, we have</p>
<table id="chapter8.A5.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex126.m1" class="ltx_Math" alttext="\sum_{i}b_{ii}=\sum_{i,j}c_{ij}^{2}=d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow><mo>=</mo><mi>d</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i}b_{ii}=\sum_{i,j}c_{ij}^{2}=d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i2.p2.3" class="ltx_p">Since <math id="chapter8.A5.I1.i2.p2.m2" class="ltx_Math" alttext="\nu_{i}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\nu_{i}</annotation></semantics></math> is an ONB of <math id="chapter8.A5.I1.i2.p2.m3" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math>, <math id="chapter8.A5.I1.i2.p2.m4" class="ltx_Math" alttext="\tilde{\psi}_{1},\cdots,\tilde{\psi}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{1},\cdots,\tilde{\psi}_{d}</annotation></semantics></math> are orthogonal, we have</p>
<table id="chapter8.A5.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.E37.m1" class="ltx_Math" alttext="b_{ii}=\sum_{j=1}^{d}c_{ji}^{2}=\sum_{j=1}^{d}{\left\langle\tilde{\psi}_{j},\nu_{i}\right\rangle}_{{P_{\mathcal{A}}}}^{2}\leq\|\nu_{i}\|_{{P_{\mathcal{A}}}}^{2}=1." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>c</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>ν</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b_{ii}=\sum_{j=1}^{d}c_{ji}^{2}=\sum_{j=1}^{d}{\left\langle\tilde{\psi}_{j},\nu_{i}\right\rangle}_{{P_{\mathcal{A}}}}^{2}\leq\|\nu_{i}\|_{{P_{\mathcal{A}}}}^{2}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i2.p2.4" class="ltx_p">Thus, we conclude that</p>
<table id="chapter8.A5.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A5.Ex127.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)+\sum_{i=1}^{d}s_{i}^{2}=\sum_{i=1}^{d}s_{i}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{i}^{2}b_{ii}\geq\sum_{i=1}^{d}s_{d}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{d}^{2}b_{ii}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>d</mi></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>d</mi></mrow></munder><mrow><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)+\sum_{i=1}^{d}s_{i}^{2}=\sum_{i=1}^{d}s_{i}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{i}^{2}b_{ii}\geq\sum_{i=1}^{d}s_{d}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{d}^{2}b_{ii}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A5.I1.i2.p2.5" class="ltx_p">which implies that <math id="chapter8.A5.I1.i2.p2.m5" class="ltx_math_unparsed" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)\geq-\sum_{i=1}^{d}s_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">≥</mo><mo lspace="0em" rspace="0.055em">−</mo><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)\geq-\sum_{i=1}^{d}s_{i}^{2}</annotation></semantics></math>. To attain equality, we will have <math id="chapter8.A5.I1.i2.p2.m6" class="ltx_Math" alttext="b_{ii}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">b_{ii}=1</annotation></semantics></math> for <math id="chapter8.A5.I1.i2.p2.m7" class="ltx_Math" alttext="i=1,\cdots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i=1,\cdots,d</annotation></semantics></math>, and <math id="chapter8.A5.I1.i2.p2.m8" class="ltx_Math" alttext="b_{ii}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b_{ii}=0</annotation></semantics></math> for <math id="chapter8.A5.I1.i2.p2.m9" class="ltx_Math" alttext="i\geq d+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\geq d+1</annotation></semantics></math>. By <a href="#chapter8.A5.E37" title="In Item (ii) ‣ Appendix 8.E Proof of Theorem ‣ Chapter 8 Proofs for Chapter 2 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">37</span></a>, we can know <math id="chapter8.A5.I1.i2.p2.m10" class="ltx_Math" alttext="\Psi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Psi^{*}</annotation></semantics></math> extracts the span of <math id="chapter8.A5.I1.i2.p2.m11" class="ltx_Math" alttext="\nu_{1},\cdots,\nu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ν</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\nu_{1},\cdots,\nu_{d}</annotation></semantics></math>, indicating that <math id="chapter8.A5.I1.i2.p2.m12" class="ltx_Math" alttext="\tilde{\Psi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Psi}^{*}</annotation></semantics></math> extracts the top-<math id="chapter8.A5.I1.i2.p2.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions of <math id="chapter8.A5.I1.i2.p2.m14" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> and <math id="chapter8.A5.I1.i2.p2.m15" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="chapter8.A5.I1.i2.p2.m16" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</p>
</div></li>
</ol><span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;">
</div>
</section>
<section id="chapter8.A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.F </span>Proof of Theorem <a href="#chapter2.Thmtheorem11" title="Theorem 2.11 (Proof in ). ‣ 7 General Objectives: SVME and KISE ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.11</span></a></h2>

<div id="chapter8.A6.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A6.p1.1" class="ltx_p"><span id="chapter8.A6.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
We first show that when <math id="chapter8.A6.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is fixed in SVME, the optimal <math id="chapter8.A6.p1.m2" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> that minimizes the objective is <math id="chapter8.A6.p1.m3" class="ltx_Math" alttext="\Psi=T_{P^{+}}^{*}\Phi" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ψ</mi><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi></mrow></mrow><annotation encoding="application/x-tex">\Psi=T_{P^{+}}^{*}\Phi</annotation></semantics></math>.
The SVME objective is</p>
<table id="chapter8.A6.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A6.Ex128.m1" class="ltx_Math" alttext="{\mathcal{L}}=\underset{(X,A)\sim P^{+}}{\mathbb{E}}{\left[{\left\|\Phi(X)\right\|}_{2}^{2}+\Psi(A)^{\top}{\left(\Psi(A)-2\Phi(X)\right)}\right]}=\sum_{i=1}^{d}{\left\{{\left\|\phi_{i}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\langle\psi_{i},\psi_{i}-2T_{P^{+}}^{*}\phi_{i}\right\rangle}_{{P_{\mathcal{A}}}}\right\}}," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mo>{</mo><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><msub><mrow><mo>⟨</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}=\underset{(X,A)\sim P^{+}}{\mathbb{E}}{\left[{\left\|\Phi(X)\right\|}_{2}^{2}+\Psi(A)^{\top}{\left(\Psi(A)-2\Phi(X)\right)}\right]}=\sum_{i=1}^{d}{\left\{{\left\|\phi_{i}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\langle\psi_{i},\psi_{i}-2T_{P^{+}}^{*}\phi_{i}\right\rangle}_{{P_{\mathcal{A}}}}\right\}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A6.p1.2" class="ltx_p">which implies that</p>
<table id="chapter8.A6.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A6.Ex129.m1" class="ltx_Math" alttext="\frac{\partial{\mathcal{L}}}{\partial\psi_{i}}=2\psi_{i}-2T_{P^{+}}^{*}\phi_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow></mfrac><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial{\mathcal{L}}}{\partial\psi_{i}}=2\psi_{i}-2T_{P^{+}}^{*}\phi_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A6.p1.3" class="ltx_p">Setting it to zero yields <math id="chapter8.A6.p1.m4" class="ltx_Math" alttext="\psi_{i}=T_{P^{+}}^{*}\phi_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}=T_{P^{+}}^{*}\phi_{i}</annotation></semantics></math>. With this, the SVME objective becomes</p>
<table id="chapter8.A6.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A6.Ex130.m1" class="ltx_Math" alttext="{\mathcal{L}}(\Phi)=\sum_{i=1}^{d}{\left\{{\left\|\phi_{i}\right\|}_{{P_{\mathcal{X}}}}^{2}-{\left\|T_{P^{+}}^{*}\phi_{i}\right\|}_{{P_{\mathcal{A}}}}^{2}\right\}}=\sum_{i=1}^{d}{\left\langle\phi_{i},\phi_{i}-T_{P^{+}}T_{P^{+}}^{*}\phi_{i}\right\rangle}_{{P_{\mathcal{X}}}}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mo>{</mo><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>}</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msub><mrow><mo>⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}(\Phi)=\sum_{i=1}^{d}{\left\{{\left\|\phi_{i}\right\|}_{{P_{\mathcal{X}}}}^{2}-{\left\|T_{P^{+}}^{*}\phi_{i}\right\|}_{{P_{\mathcal{A}}}}^{2}\right\}}=\sum_{i=1}^{d}{\left\langle\phi_{i},\phi_{i}-T_{P^{+}}T_{P^{+}}^{*}\phi_{i}\right\rangle}_{{P_{\mathcal{X}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A6.p1.4" class="ltx_p">because <math id="chapter8.A6.p1.m5" class="ltx_Math" alttext="T_{P^{+}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><annotation encoding="application/x-tex">T_{P^{+}}^{*}</annotation></semantics></math> is the adjoint of <math id="chapter8.A6.p1.m6" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>. This <math id="chapter8.A6.p1.m7" class="ltx_Math" alttext="{\mathcal{L}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">{\mathcal{L}}</annotation></semantics></math> is exactly the objective of KISE.
Under the orthonormality constraint, minimizing <math id="chapter8.A6.p1.m8" class="ltx_Math" alttext="{\mathcal{L}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}(\Phi)</annotation></semantics></math> is equivalent to maximizing <math id="chapter8.A6.p1.m9" class="ltx_Math" alttext="\sum_{i=1}^{d}{\left\langle\phi_{i},T_{{k_{X}^{+}}}\phi_{i}\right\rangle}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msub><mrow><mo lspace="0em">⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{d}{\left\langle\phi_{i},T_{{k_{X}^{+}}}\phi_{i}\right\rangle}_{{P_{\mathcal{X}}}}</annotation></semantics></math>.
Then, we can use the proof of <a href="#chapter2.Thmtheorem9" title="Theorem 2.9 (Proof in ). ‣ Self-supervised learning (SSL) with random transformations. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2.9</span></a> (ii) to show that when <math id="chapter8.A6.p1.m10" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> is the optimal solution, <math id="chapter8.A6.p1.m11" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="chapter8.A6.p1.m12" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter8.A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.G </span>Proof of Theorem <a href="#chapter2.Thmtheorem14" title="Theorem 2.14 (Proof in ). ‣ 10 Extracting Exact Eigenfunctions and Eigenvalues ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.14</span></a></h2>

<div id="chapter8.A7.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A7.p1.1" class="ltx_p"><span id="chapter8.A7.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Without loss of generality assume that <math id="chapter8.A7.p1.m1" class="ltx_Math" alttext="T_{{k_{X}^{+}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><annotation encoding="application/x-tex">T_{{k_{X}^{+}}}</annotation></semantics></math> has at least <math id="chapter8.A7.p1.m2" class="ltx_Math" alttext="d+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d+1</annotation></semantics></math> positive eigenvalues (including <math id="chapter8.A7.p1.m3" class="ltx_Math" alttext="\lambda_{0}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\lambda_{0}</annotation></semantics></math>).
First we prove a simple result in linear algebra: For any positive definite matrix <math id="chapter8.A7.p1.m4" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>, if vectors <math id="chapter8.A7.p1.m5" class="ltx_Math" alttext="{\bm{u}}_{1},\cdots,{\bm{u}}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}_{1},\cdots,{\bm{u}}_{k}</annotation></semantics></math> are pairwise orthogonal and satisfy <math id="chapter8.A7.p1.m6" class="ltx_Math" alttext="{\bm{u}}_{i}^{\top}{\bm{A}}{\bm{u}}_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒖</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\bm{u}}_{i}^{\top}{\bm{A}}{\bm{u}}_{i}=1</annotation></semantics></math> for all <math id="chapter8.A7.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, then <math id="chapter8.A7.p1.m8" class="ltx_Math" alttext="{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{k}\right\|}_{2}^{2}\leq\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>k</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>λ</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{k}\right\|}_{2}^{2}\leq\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1}</annotation></semantics></math>, where <math id="chapter8.A7.p1.m9" class="ltx_Math" alttext="0&lt;\lambda_{1}\leq\lambda_{2}\leq\cdots" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>λ</mi><mn>2</mn></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">0&lt;\lambda_{1}\leq\lambda_{2}\leq\cdots</annotation></semantics></math> are the eigenvalues of <math id="chapter8.A7.p1.m10" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>.
To prove this, let <math id="chapter8.A7.p1.m11" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math> be the matrix whose columns are <math id="chapter8.A7.p1.m12" class="ltx_Math" alttext="{\bm{u}}_{1},\cdots,{\bm{u}}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}_{1},\cdots,{\bm{u}}_{k}</annotation></semantics></math>. Then, <math id="chapter8.A7.p1.m13" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{U}}</annotation></semantics></math> is a diagonal matrix and all elements on the diagonal of <math id="chapter8.A7.p1.m14" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{A}}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{A}}{\bm{U}}</annotation></semantics></math> are <math id="chapter8.A7.p1.m15" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
Denote the sorted diagonal elements of <math id="chapter8.A7.p1.m16" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{U}}</annotation></semantics></math> by <math id="chapter8.A7.p1.m17" class="ltx_Math" alttext="d_{1}\geq d_{2}\geq\cdots\geq d_{k}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>d</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>d</mi><mi>k</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{1}\geq d_{2}\geq\cdots\geq d_{k}\geq 0</annotation></semantics></math>.
Let <math id="chapter8.A7.p1.m18" class="ltx_Math" alttext="{\bm{Q}}={\bm{U}}{\bm{U}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\bm{U}}{\bm{U}}^{\top}</annotation></semantics></math>.
A freshman linear algebra exercise states that the eigenvalues of <math id="chapter8.A7.p1.m19" class="ltx_Math" alttext="{\bm{Q}}^{2}" display="inline" intent=":literal"><semantics><msup><mi>𝑸</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\bm{Q}}^{2}</annotation></semantics></math> are <math id="chapter8.A7.p1.m20" class="ltx_Math" alttext="d_{1}^{2},\cdots,d_{k}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>d</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>d</mi><mi>k</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">d_{1}^{2},\cdots,d_{k}^{2}</annotation></semantics></math>, and the rest are all zeros.
Now consider <math id="chapter8.A7.p1.m21" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{A}}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{A}}{\bm{U}}</annotation></semantics></math>. It is easy to see that the diagonal elements of this matrix are <math id="chapter8.A7.p1.m22" class="ltx_Math" alttext="d_{1},d_{2},\cdots,d_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>d</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">d_{1},d_{2},\cdots,d_{k}</annotation></semantics></math>. This implies that <math id="chapter8.A7.p1.m23" class="ltx_Math" alttext="\Tr({\bm{U}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{A}}{\bm{U}})=\Tr({\bm{U}}^{\top}{\bm{U}})=d_{1}+\cdots+d_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{U}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{A}}{\bm{U}})=\Tr({\bm{U}}^{\top}{\bm{U}})=d_{1}+\cdots+d_{k}</annotation></semantics></math>.
Thus, <math id="chapter8.A7.p1.m24" class="ltx_Math" alttext="\Tr({\bm{Q}}^{2}{\bm{A}})=\Tr({\bm{Q}})=d_{1}+\cdots+d_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑸</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{Q}}^{2}{\bm{A}})=\Tr({\bm{Q}})=d_{1}+\cdots+d_{k}</annotation></semantics></math>, because <math id="chapter8.A7.p1.m25" class="ltx_Math" alttext="\Tr({\bm{A}}{\bm{B}})=\Tr({\bm{B}}{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{A}}{\bm{B}})=\Tr({\bm{B}}{\bm{A}})</annotation></semantics></math>.
By von Neumann’s trace inequality, there is <math id="chapter8.A7.p1.m26" class="ltx_Math" alttext="\Tr({\bm{Q}}^{2}{\bm{A}})\geq\lambda_{1}d_{1}^{2}+\cdots+\lambda_{k}d_{k}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{Q}}^{2}{\bm{A}})\geq\lambda_{1}d_{1}^{2}+\cdots+\lambda_{k}d_{k}^{2}</annotation></semantics></math>.
So by Cauchy-Schwarz inequality, <math id="chapter8.A7.p1.m27" class="ltx_Math" alttext="(d_{1}+\cdots+d_{k})^{2}\leq(\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1})\Tr({\bm{Q}}^{2}{\bm{A}})=(\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1})(d_{1}+\cdots+d_{k})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>λ</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>λ</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(d_{1}+\cdots+d_{k})^{2}\leq(\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1})\Tr({\bm{Q}}^{2}{\bm{A}})=(\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1})(d_{1}+\cdots+d_{k})</annotation></semantics></math>, which implies that <math id="chapter8.A7.p1.m28" class="ltx_Math" alttext="{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{k}\right\|}_{2}^{2}=d_{1}+\cdots+d_{k}\leq\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>k</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>k</mi></msub></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>λ</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{k}\right\|}_{2}^{2}=d_{1}+\cdots+d_{k}\leq\lambda_{1}^{-1}+\cdots+\lambda_{k}^{-1}</annotation></semantics></math>. The equality is only attained when the Cauchy-Schwarz inequality attains equality, that is <math id="chapter8.A7.p1.m29" class="ltx_Math" alttext="d_{i}=\lambda_{i}^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>λ</mi><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">d_{i}=\lambda_{i}^{-1}</annotation></semantics></math> for all <math id="chapter8.A7.p1.m30" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
<div id="chapter8.A7.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A7.p2.1" class="ltx_p">For simplicity, we assume that the eigenvalues of <math id="chapter8.A7.p2.m1" class="ltx_Math" alttext="T_{{k_{X}^{+}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><annotation encoding="application/x-tex">T_{{k_{X}^{+}}}</annotation></semantics></math> satisfy <math id="chapter8.A7.p2.m2" class="ltx_Math" alttext="\lambda_{1}&gt;\lambda_{2}&gt;\cdots&gt;\lambda_{d}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>&gt;</mo><msub><mi>λ</mi><mn>2</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mi>λ</mi><mi>d</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}&gt;\lambda_{2}&gt;\cdots&gt;\lambda_{d}&gt;0</annotation></semantics></math>. If an eigenvalue has more multiplicity, the proof will be the same but much more verbose.
Then, <math id="chapter8.A7.p2.m3" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d}</annotation></semantics></math> are fixed. Let <math id="chapter8.A7.p2.m4" class="ltx_Math" alttext="\tilde{\phi}^{*}_{i}=\sum_{k}u_{ik}\mu_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi><mo>∗</mo></msubsup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\phi}^{*}_{i}=\sum_{k}u_{ik}\mu_{k}</annotation></semantics></math>.
Then, <a href="#S10.E13" title="In 10 Extracting Exact Eigenfunctions and Eigenvalues ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">13</span></a> is equivalent to the following optimization problem:</p>
<table id="chapter8.A7.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter8.A7.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A7.Ex131.m1" class="ltx_Math" alttext="\displaystyle\underset{u_{ik}}{\text{maximize}}\qquad" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mtext>maximize</mtext><msub><mi mathsize="0.700em">u</mi><mrow><mi mathsize="0.710em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">k</mi></mrow></msub></munder><mspace style="width:2em;" width="2em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle\underset{u_{ik}}{\text{maximize}}\qquad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A7.Ex131.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{d}\sum_{k}\lambda_{k}u_{ik}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{d}\sum_{k}\lambda_{k}u_{ik}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A7.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="chapter8.A7.Ex132.1.1" class="ltx_text ltx_markedasmath">s.t.</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A7.Ex132.m2" class="ltx_Math" alttext="\displaystyle\forall i\in[d]:\;\sum_{k}u_{ik}^{2}=1;" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.558em">:</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><msubsup><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall i\in[d]:\;\sum_{k}u_{ik}^{2}=1;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A7.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A7.Ex133.m1" class="ltx_Math" alttext="\displaystyle\forall 1\leq i&lt;j\leq d:\;\sum_{k}\lambda_{k}u_{ik}u_{jk}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mn>1</mn></mrow><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mi>d</mi><mo lspace="0.278em" rspace="0.558em">:</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall 1\leq i&lt;j\leq d:\;\sum_{k}\lambda_{k}u_{ik}u_{jk}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter8.A7.p3" class="ltx_para ltx_noindent">
<p id="chapter8.A7.p3.1" class="ltx_p">Obviously, for any <math id="chapter8.A7.p3.m1" class="ltx_Math" alttext="\lambda_{k}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{k}=0</annotation></semantics></math>, the optimal <math id="chapter8.A7.p3.m2" class="ltx_Math" alttext="u_{ik}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">u_{ik}</annotation></semantics></math> should be zero. So without loss of generality, we assume that all <math id="chapter8.A7.p3.m3" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> in the above problem are positive. Define matrix <math id="chapter8.A7.p3.m4" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math> whose <math id="chapter8.A7.p3.m5" class="ltx_Math" alttext="(i,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,k)</annotation></semantics></math>-th element is <math id="chapter8.A7.p3.m6" class="ltx_Math" alttext="\sqrt{\lambda_{k}}u_{ik}" display="inline" intent=":literal"><semantics><mrow><msqrt><msub><mi>λ</mi><mi>k</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\sqrt{\lambda_{k}}u_{ik}</annotation></semantics></math>. Denote the rows of <math id="chapter8.A7.p3.m7" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math> by <math id="chapter8.A7.p3.m8" class="ltx_Math" alttext="{\bm{u}}_{1},\cdots,{\bm{u}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}_{1},\cdots,{\bm{u}}_{d}</annotation></semantics></math>.
Let <math id="chapter8.A7.p3.m9" class="ltx_Math" alttext="{\bm{D}}={\textnormal{diag}}{\left\{\lambda_{1}^{-1},\lambda_{2}^{-1},\cdots\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>2</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{D}}={\textnormal{diag}}{\left\{\lambda_{1}^{-1},\lambda_{2}^{-1},\cdots\right\}}</annotation></semantics></math>.
Then, the constraints of the above problem become <math id="chapter8.A7.p3.m10" class="ltx_Math" alttext="{\bm{u}}_{i}^{\top}{\bm{D}}{\bm{u}}_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒖</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\bm{u}}_{i}^{\top}{\bm{D}}{\bm{u}}_{i}=1</annotation></semantics></math> for all <math id="chapter8.A7.p3.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="chapter8.A7.p3.m12" class="ltx_Math" alttext="{\bm{u}}_{1},\cdots,{\bm{u}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}_{1},\cdots,{\bm{u}}_{d}</annotation></semantics></math> are pairwise orthogonal.
Thus, by the result we have just proved, the objective of this problem satisfies <math id="chapter8.A7.p3.m13" class="ltx_Math" alttext="{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{d}\right\|}_{2}^{2}\leq\lambda_{1}+\cdots+\lambda_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>d</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{1}\right\|}_{2}^{2}+\cdots+{\left\|{\bm{u}}_{d}\right\|}_{2}^{2}\leq\lambda_{1}+\cdots+\lambda_{d}</annotation></semantics></math>. The equality is only attained when <math id="chapter8.A7.p3.m14" class="ltx_Math" alttext="{\left\|{\bm{u}}_{i}\right\|}_{2}^{2}=\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{i}\right\|}_{2}^{2}=\lambda_{i}</annotation></semantics></math> for all <math id="chapter8.A7.p3.m15" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>, assuming that <math id="chapter8.A7.p3.m16" class="ltx_Math" alttext="{\left\|{\bm{u}}_{1}\right\|}_{2}\geq\cdots\geq{\left\|{\bm{u}}_{d}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝒖</mi><mn>1</mn></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>d</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{1}\right\|}_{2}\geq\cdots\geq{\left\|{\bm{u}}_{d}\right\|}_{2}</annotation></semantics></math>.
This is only possible when <math id="chapter8.A7.p3.m17" class="ltx_Math" alttext="u_{11}^{2}=u_{22}^{2}=\cdots=u_{dd}^{2}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mn>11</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mi>u</mi><mn>22</mn><mn>2</mn></msubsup><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msubsup><mi>u</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mn>2</mn></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">u_{11}^{2}=u_{22}^{2}=\cdots=u_{dd}^{2}=1</annotation></semantics></math>, which proves the result.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter8.A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 8.H </span>Proof of Theorem <a href="#chapter2.Thmtheorem12" title="Theorem 2.12 (Proof in ). ‣ Supervised learning with a feature map. ‣ 9 Learning from a Mixture of Contexts ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.12</span></a></h2>

<div id="chapter8.A8.p1" class="ltx_para ltx_noindent">
<p id="chapter8.A8.p1.1" class="ltx_p"><span id="chapter8.A8.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
It suffices to show that <math id="chapter8.A8.p1.m1" class="ltx_Math" alttext="T_{\Omega}^{*}T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi mathvariant="normal">Ω</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub></mrow><annotation encoding="application/x-tex">T_{\Omega}^{*}T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}</annotation></semantics></math> is the integral kernel operator of</p>
<table id="chapter8.A8.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A8.Ex134.m1" class="ltx_Math" alttext="k(\omega,\omega^{\prime})=\iint k_{\Lambda}(y,y^{\prime})P_{Y|\omega}(y|\omega)P_{Y|\omega}(y^{\prime}|\omega^{\prime})dydy^{\prime}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo>,</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><msub><mi>k</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">k(\omega,\omega^{\prime})=\iint k_{\Lambda}(y,y^{\prime})P_{Y|\omega}(y|\omega)P_{Y|\omega}(y^{\prime}|\omega^{\prime})dydy^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p1.2" class="ltx_p">After that, we can follow the proof in <a href="#chapter8.A1" title="Appendix 8.A Proof of Theorem ‣ Chapter 8 Proofs for Chapter 2 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">8.A</span></a> to prove the result.</p>
</div>
<div id="chapter8.A8.p2" class="ltx_para ltx_noindent">
<p id="chapter8.A8.p2.1" class="ltx_p">Since <math id="chapter8.A8.p2.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> determines <math id="chapter8.A8.p2.m2" class="ltx_Math" alttext="\omega,y" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\omega,y</annotation></semantics></math> at the same time, we have <math id="chapter8.A8.p2.m3" class="ltx_Math" alttext="y\perp\omega|x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>y</mi><mo>⟂</mo><mi>ω</mi></mrow><mo fence="false">|</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">y\perp\omega|x</annotation></semantics></math>. This implies that</p>
<table id="chapter8.A8.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A8.Ex135.m1" class="ltx_Math" alttext="P(\omega|x)=P(\omega|x,y),\quad P(y|x)=P(y|x,\omega)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\omega|x)=P(\omega|x,y),\quad P(y|x)=P(y|x,\omega).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p2.2" class="ltx_p">By definition, we have</p>
<table id="chapter8.A8.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter8.A8.Ex136.m1" class="ltx_Math" alttext="(T_{\Omega}h)(x^{\prime})=\int h(\omega^{\prime})P(\omega^{\prime}|x^{\prime})d\omega^{\prime}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(T_{\Omega}h)(x^{\prime})=\int h(\omega^{\prime})P(\omega^{\prime}|x^{\prime})d\omega^{\prime},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p2.3" class="ltx_p">which implies that</p>
<table id="chapter8.A8.Ex137" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A8.Ex137X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A8.Ex137X.m2" class="ltx_Math" alttext="\displaystyle(T_{P^{+}}^{*}T_{\Omega}h)(y^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(T_{P^{+}}^{*}T_{\Omega}h)(y^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex137X.m3" class="ltx_Math" alttext="\displaystyle=\int(T_{\Omega}h)(x^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}=\iint h(\omega^{\prime})P(\omega^{\prime}|x^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}d\omega^{\prime}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>X</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow></mrow></mstyle><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>X</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int(T_{\Omega}h)(x^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}=\iint h(\omega^{\prime})P(\omega^{\prime}|x^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}d\omega^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex137Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex137Xa.m2" class="ltx_Math" alttext="\displaystyle=\iint h(\omega^{\prime})P(\omega^{\prime}|x^{\prime},y^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}d\omega^{\prime}=\int h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})d\omega^{\prime}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>X</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>ω</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint h(\omega^{\prime})P(\omega^{\prime}|x^{\prime},y^{\prime})P_{X|Y}(x^{\prime}|y^{\prime})dx^{\prime}d\omega^{\prime}=\int h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})d\omega^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p2.4" class="ltx_p">Thus, we have</p>
<table id="chapter8.A8.Ex138" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A8.Ex138X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A8.Ex138X.m2" class="ltx_Math" alttext="\displaystyle(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex138X.m3" class="ltx_Math" alttext="\displaystyle=\int(T_{P^{+}}^{*}T_{\Omega}h)(y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})dy^{\prime}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo mathsize="0.700em">,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int(T_{P^{+}}^{*}T_{\Omega}h)(y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})dy^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex138Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex138Xa.m2" class="ltx_Math" alttext="\displaystyle=\iint h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})d\omega^{\prime}dy^{\prime}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>ω</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})d\omega^{\prime}dy^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p2.5" class="ltx_p">This implies that</p>
<table id="chapter8.A8.Ex139" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter8.A8.Ex139X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter8.A8.Ex139X.m2" class="ltx_Math" alttext="\displaystyle(T_{\Omega}^{*}T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}h)(\omega)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><mi mathvariant="normal">Ω</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(T_{\Omega}^{*}T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}h)(\omega)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139X.m3" class="ltx_Math" alttext="\displaystyle=\int(T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}h)(x)P(x|\omega)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int(T_{P^{+}}\Lambda T_{P^{+}}^{*}T_{\Omega}h)(x)P(x|\omega)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex139Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139Xa.m2" class="ltx_Math" alttext="\displaystyle=\iint(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P(y|x)P_{X|\omega}(x|\omega)dydx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>X</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P(y|x)P_{X|\omega}(x|\omega)dydx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex139Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139Xb.m2" class="ltx_Math" alttext="\displaystyle=\iint(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P(y|x,\omega)P_{X|\omega}(x|\omega)dydx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>X</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P(y|x,\omega)P_{X|\omega}(x|\omega)dydx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex139Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139Xc.m2" class="ltx_Math" alttext="\displaystyle=\int(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P_{Y|\omega}(y|\omega)dy" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi mathvariant="normal">Ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int(\Lambda T_{P^{+}}^{*}T_{\Omega}h)(y)P_{Y|\omega}(y|\omega)dy</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex139Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139Xd.m2" class="ltx_Math" alttext="\displaystyle=\iiint h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})P_{Y|\omega}(y|\omega)d\omega^{\prime}dy^{\prime}dy" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∭</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>ω</mi><mo fence="false">|</mo><mi>Y</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>Y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iiint h(\omega^{\prime})P_{\omega|Y}(\omega^{\prime}|y^{\prime})k_{\Lambda}(y,y^{\prime}){P_{Y}}(y^{\prime})P_{Y|\omega}(y|\omega)d\omega^{\prime}dy^{\prime}dy</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter8.A8.Ex139Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A8.Ex139Xe.m2" class="ltx_Math" alttext="\displaystyle=\iiint h(\omega^{\prime})k_{\Lambda}(y,y^{\prime})P_{Y|\omega}(y|w)P_{Y|\omega}(y^{\prime}|w^{\prime})P_{\omega}(\omega^{\prime})dydy^{\prime}d\omega^{\prime}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∭</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo fence="false">|</mo><mi>ω</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>w</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>y</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mo>′</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iiint h(\omega^{\prime})k_{\Lambda}(y,y^{\prime})P_{Y|\omega}(y|w)P_{Y|\omega}(y^{\prime}|w^{\prime})P_{\omega}(\omega^{\prime})dydy^{\prime}d\omega^{\prime},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter8.A8.p2.6" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
</section>
<section id="chapter9" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 9 </span>Proofs for Chapter 3</h2>

<section id="chapter9.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 9.A </span>Proof of Theorem <a href="#chapter3.Thmtheorem2" title="Theorem 3.2 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a></h2>

<div id="chapter9.A1.p1" class="ltx_para ltx_noindent">
<p id="chapter9.A1.p1.1" class="ltx_p"><span id="chapter9.A1.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter9.A1.p1.m1" class="ltx_Math" alttext="f^{*}=\sum u_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}=\sum u_{i}\mu_{i}</annotation></semantics></math>, and <math id="chapter9.A1.p1.m2" class="ltx_Math" alttext="g^{*}=\sum s_{i}u_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{*}=\sum s_{i}u_{i}\nu_{i}</annotation></semantics></math>.
For this <math id="chapter9.A1.p1.m3" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math>, the maximum in <a href="#S12.E14" title="In Definition 3.1. ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">14</span></a> is attained by <math id="chapter9.A1.p1.m4" class="ltx_Math" alttext="g^{*}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">g^{*}</annotation></semantics></math>, so it suffices to show that <math id="chapter9.A1.p1.m5" class="ltx_Math" alttext="g^{*}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">g^{*}</annotation></semantics></math> satisfies <a href="#S12.E16" title="In Theorem 3.2 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">16</span></a>. By Bayes rule, we have</p>
<table id="chapter9.A1.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter9.A1.Ex140.m1" class="ltx_Math" alttext="P^{+}(A^{\prime}|A=a)=\int P^{+}(A^{\prime}|X=x)P^{+}(x|A^{\prime}=a)dx," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>A</mi><mo>′</mo></msup><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P^{+}(A^{\prime}|A=a)=\int P^{+}(A^{\prime}|X=x)P^{+}(x|A^{\prime}=a)dx,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter9.A1.p1.2" class="ltx_p">which implies that <math id="chapter9.A1.p1.m6" class="ltx_Math" alttext="P^{+}(A^{\prime}=a^{\prime}|A=a)={k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>A</mi><mo>′</mo></msup><mo>=</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{+}(A^{\prime}=a^{\prime}|A=a)={k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})</annotation></semantics></math>. Therefore, we have</p>
<table id="chapter9.A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter9.A1.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter9.A1.Ex141.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{A,A^{\prime}\sim P^{+}(\cdot|X)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}\mathbb{E}_{A^{\prime}\sim P(\cdot|A)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>,</mo><mi>A</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>P</mi><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><msub><mi>𝔼</mi><mrow><mi>A</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>P</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{A,A^{\prime}\sim P^{+}(\cdot|X)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}\mathbb{E}_{A^{\prime}\sim P(\cdot|A)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter9.A1.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter9.A1.Ex142.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter9.A1.Ex142.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime})P(a^{\prime}|A)da^{\prime}\right]}=\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime}){k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})da^{\prime}\right]}={\left\langle g^{*},T_{{k_{A}^{+}}}g^{*}\right\rangle}_{P_{\mathcal{A}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><mo>]</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>,</mo><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime})P(a^{\prime}|A)da^{\prime}\right]}=\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime}){k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})da^{\prime}\right]}={\left\langle g^{*},T_{{k_{A}^{+}}}g^{*}\right\rangle}_{P_{\mathcal{A}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter9.A1.p1.3" class="ltx_p">Since <math id="chapter9.A1.p1.m7" class="ltx_Math" alttext="T_{{k_{A}^{+}}}g^{*}=T_{P^{+}}^{*}T_{P^{+}}g^{*}=\sum s_{i}^{3}u_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{{k_{A}^{+}}}g^{*}=T_{P^{+}}^{*}T_{P^{+}}g^{*}=\sum s_{i}^{3}u_{i}\nu_{i}</annotation></semantics></math>, <a href="#S12.E16" title="In Theorem 3.2 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">16</span></a> is equivalent to <math id="chapter9.A1.p1.m8" class="ltx_Math" alttext="\sum(s_{i}^{2}-s_{i}^{4})u_{i}^{2}\leq 2\epsilon\sum s_{i}^{2}u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mi>i</mi><mn>4</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum(s_{i}^{2}-s_{i}^{4})u_{i}^{2}\leq 2\epsilon\sum s_{i}^{2}u_{i}^{2}</annotation></semantics></math>.
Meanwhile, we have <math id="chapter9.A1.p1.m9" class="ltx_Math" alttext="\sum s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum u_{i}^{2}\geq(1-2\epsilon)\sum u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum u_{i}^{2}\geq(1-2\epsilon)\sum u_{i}^{2}</annotation></semantics></math>. By Cauchy-Schwarz inequality, we have <math id="chapter9.A1.p1.m10" class="ltx_Math" alttext="(\sum s_{i}^{4}u_{i}^{2})(\sum u_{i}^{2})\geq(\sum s_{i}^{2}u_{i}^{2})^{2}\geq(1-2\epsilon)(\sum u_{i}^{2})(\sum s_{i}^{2}u_{i}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\sum s_{i}^{4}u_{i}^{2})(\sum u_{i}^{2})\geq(\sum s_{i}^{2}u_{i}^{2})^{2}\geq(1-2\epsilon)(\sum u_{i}^{2})(\sum s_{i}^{2}u_{i}^{2})</annotation></semantics></math>, which proves <a href="#S12.E16" title="In Theorem 3.2 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">16</span></a>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter9.A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 9.B </span>Proof of Theorem <a href="#chapter3.Thmtheorem4" title="Theorem 3.4 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a></h2>

<div id="chapter9.A2.p1" class="ltx_para ltx_noindent">
<p id="chapter9.A2.p1.1" class="ltx_p"><span id="chapter9.A2.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Since <math id="chapter9.A2.p1.m1" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math> is at most rank-<math id="chapter9.A2.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, thus there exists <math id="chapter9.A2.p1.m3" class="ltx_Math" alttext="f_{1}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math> with <math id="chapter9.A2.p1.m4" class="ltx_Math" alttext="\|f_{1}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{1}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math> that is orthogonal to <math id="chapter9.A2.p1.m5" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math>. Thus there exists <math id="chapter9.A2.p1.m6" class="ltx_Math" alttext="f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math> with <math id="chapter9.A2.p1.m7" class="ltx_Math" alttext="\|f_{1}\|_{P_{\mathcal{X}}}=\|f_{2}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{1}\|_{P_{\mathcal{X}}}=\|f_{2}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math>, <math id="chapter9.A2.p1.m8" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is orthogonal to <math id="chapter9.A2.p1.m9" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math> and <math id="chapter9.A2.p1.m10" class="ltx_Math" alttext="f_{2}\in{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{2}\in{\textnormal{span}}(\Phi)</annotation></semantics></math> (thus <math id="chapter9.A2.p1.m11" class="ltx_Math" alttext="f_{1}\perp f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>⟂</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{1}\perp f_{2}</annotation></semantics></math>), and <math id="chapter9.A2.p1.m12" class="ltx_Math" alttext="\mu_{1}\in{\textnormal{span}}\{f_{1},f_{2}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{1}\in{\textnormal{span}}\{f_{1},f_{2}\}</annotation></semantics></math>.
Suppose <math id="chapter9.A2.p1.m13" class="ltx_Math" alttext="\mu_{1}=\alpha_{1}f_{1}+\alpha_{2}f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{1}=\alpha_{1}f_{1}+\alpha_{2}f_{2}</annotation></semantics></math> (without loss of generosity, assuming <math id="chapter9.A2.p1.m14" class="ltx_Math" alttext="\alpha_{1},\alpha_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2}\in[0,1]</annotation></semantics></math>) and denote <math id="chapter9.A2.p1.m15" class="ltx_Math" alttext="f_{0}=\alpha_{2}f_{1}-\alpha_{1}f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}=\alpha_{2}f_{1}-\alpha_{1}f_{2}</annotation></semantics></math>. Then <math id="chapter9.A2.p1.m16" class="ltx_Math" alttext="\|f_{0}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{0}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math> and <math id="chapter9.A2.p1.m17" class="ltx_Math" alttext="\langle\mu_{1},f_{0}\rangle_{P_{\mathcal{X}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle\mu_{1},f_{0}\rangle_{P_{\mathcal{X}}}=0</annotation></semantics></math>. Since <math id="chapter9.A2.p1.m18" class="ltx_Math" alttext="f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math>, we have <math id="chapter9.A2.p1.m19" class="ltx_Math" alttext="f_{0}\in{\textnormal{span}}\{\mu_{2},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}\in{\textnormal{span}}\{\mu_{2},\cdots,\mu_{d+1}\}</annotation></semantics></math> and thus <math id="chapter9.A2.p1.m20" class="ltx_Math" alttext="\mathbb{E}[f_{0}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[f_{0}]=0</annotation></semantics></math>.</p>
</div>
<div id="chapter9.A2.p2" class="ltx_para ltx_noindent">
<p id="chapter9.A2.p2.1" class="ltx_p">Consider <math id="chapter9.A2.p2.m1" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}f_{0}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}f_{0}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math> where <math id="chapter9.A2.p2.m2" class="ltx_Math" alttext="\beta_{1}^{2}+\beta_{2}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{1}^{2}+\beta_{2}^{2}=1</annotation></semantics></math>, <math id="chapter9.A2.p2.m3" class="ltx_Math" alttext="\beta_{1},\beta_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}\in[0,1]</annotation></semantics></math>.
Denote <math id="chapter9.A2.p2.m4" class="ltx_Math" alttext="f=\sum_{i\geq 1}u_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum_{i\geq 1}u_{i}\mu_{i}</annotation></semantics></math>
Then, we have <math id="chapter9.A2.p2.m5" class="ltx_Math" alttext="\sum_{i}u_{i}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}u_{i}^{2}=1</annotation></semantics></math> and</p>
<table id="chapter9.A2.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter9.A2.Ex143.m1" class="ltx_Math" alttext="\beta_{2}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\implies\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})\beta_{2}^{2}\geq(1-{\epsilon})^{2}\sum_{i}u_{i}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo rspace="0.111em" stretchy="false">⟹</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\beta_{2}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\implies\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})\beta_{2}^{2}\geq(1-{\epsilon})^{2}\sum_{i}u_{i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter9.A2.p2.2" class="ltx_p">Since <math id="chapter9.A2.p2.m6" class="ltx_Math" alttext="f=(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})f_{1}+(\alpha_{2}\beta_{1}-\alpha_{1}\beta_{2})f_{2}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})f_{1}+(\alpha_{2}\beta_{1}-\alpha_{1}\beta_{2})f_{2}</annotation></semantics></math>, the approximation error of <math id="chapter9.A2.p2.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is <math id="chapter9.A2.p2.m8" class="ltx_Math" alttext="(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}</annotation></semantics></math>.
Define a function <math id="chapter9.A2.p2.m9" class="ltx_Math" alttext="F(\alpha_{1})=\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2}=\alpha_{1}\beta_{1}+\sqrt{1-\alpha_{1}^{2}}\beta_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mn>1</mn><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\alpha_{1})=\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2}=\alpha_{1}\beta_{1}+\sqrt{1-\alpha_{1}^{2}}\beta_{2}</annotation></semantics></math> (<math id="chapter9.A2.p2.m10" class="ltx_Math" alttext="\alpha_{1}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1}\in[0,1]</annotation></semantics></math>).
We can show that dis function first increases and then decreases with <math id="chapter9.A2.p2.m11" class="ltx_Math" alttext="\alpha_{1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\alpha_{1}</annotation></semantics></math>.
Thus, <math id="chapter9.A2.p2.m12" class="ltx_Math" alttext="F(\alpha_{1})^{2}\geq\min\{F(0)^{2},F(1)^{2}\}=\min\{\beta_{1}^{2},\beta_{2}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\alpha_{1})^{2}\geq\min\{F(0)^{2},F(1)^{2}\}=\min\{\beta_{1}^{2},\beta_{2}^{2}\}</annotation></semantics></math>.
If <math id="chapter9.A2.p2.m13" class="ltx_Math" alttext="\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\leq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\leq\frac{1}{2}</annotation></semantics></math>, then the approximation error is always at least <math id="chapter9.A2.p2.m14" class="ltx_Math" alttext="\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><annotation encoding="application/x-tex">\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>.
To attain this lower bound, we must have <math id="chapter9.A2.p2.m15" class="ltx_Math" alttext="\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}=s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}=s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}</annotation></semantics></math>. This implies that <math id="chapter9.A2.p2.m16" class="ltx_Math" alttext="f_{1}=\mu_{d+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">f_{1}=\mu_{d+1}</annotation></semantics></math>, indicating that <math id="chapter9.A2.p2.m17" class="ltx_Math" alttext="{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})</annotation></semantics></math>. Thus, <math id="chapter9.A2.p2.m18" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> must learn the contexture of <math id="chapter9.A2.p2.m19" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>.</p>
</div>
<div id="chapter9.A2.p3" class="ltx_para ltx_noindent">
<p id="chapter9.A2.p3.1" class="ltx_p">On the other hand, if <math id="chapter9.A2.p3.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture, then the approximation of <math id="chapter9.A2.p3.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> on <math id="chapter9.A2.p3.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> will be <math id="chapter9.A2.p3.m4" class="ltx_Math" alttext="A:=\sum_{i\geq d+1}u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo rspace="0.111em">:=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">A:=\sum_{i\geq d+1}u_{i}^{2}</annotation></semantics></math>.
Then, we have</p>
<table id="chapter9.A2.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter9.A2.Ex144.m1" class="ltx_Math" alttext="(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq s_{1}^{2}\sum_{i=1}^{d}u_{i}^{2}+s_{d+1}^{2}\sum_{i\geq d+1}u_{i}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})A," display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow></munder><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq s_{1}^{2}\sum_{i=1}^{d}u_{i}^{2}+s_{d+1}^{2}\sum_{i\geq d+1}u_{i}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})A,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter9.A2.p3.2" class="ltx_p">and this implies that</p>
<table id="chapter9.A2.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter9.A2.Ex145.m1" class="ltx_Math" alttext="A=\min_{{\bm{w}}\in\mathbb{R}^{d},\;b\in\mathbb{R}}\;{\left\|{\bm{w}}^{\top}\Phi+b-f\right\|}_{P_{\mathcal{X}}}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>=</mo><mrow><munder><mi>min</mi><mrow><mrow><mi>𝒘</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo rspace="0.447em">,</mo><mrow><mi>b</mi><mo>∈</mo><mi>ℝ</mi></mrow></mrow></munder><mo>⁡</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi></mrow><mo>+</mo><mi>b</mi></mrow><mo>−</mo><mi>f</mi></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=\min_{{\bm{w}}\in\mathbb{R}^{d},\;b\in\mathbb{R}}\;{\left\|{\bm{w}}^{\top}\Phi+b-f\right\|}_{P_{\mathcal{X}}}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter9.A2.p3.3" class="ltx_p">When <math id="chapter9.A2.p3.m5" class="ltx_Math" alttext="u_{1}^{2}=1-\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}},u_{d+1}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mn>1</mn><mn>2</mn></msubsup><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow><mo>,</mo><mrow><msubsup><mi>u</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">u_{1}^{2}=1-\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}},u_{d+1}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>, the equality holds.
Thus, the lower bound <math id="chapter9.A2.p3.m6" class="ltx_Math" alttext="\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><annotation encoding="application/x-tex">\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math> is attained if and only if <math id="chapter9.A2.p3.m7" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture.</p>
</div>
<div id="chapter9.A2.p4" class="ltx_para ltx_noindent">
<p id="chapter9.A2.p4.1" class="ltx_p">The converse part is obvious because for any <math id="chapter9.A2.p4.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> we can simply choose <math id="chapter9.A2.p4.m2" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}f_{0}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}f_{0}</annotation></semantics></math> as defined above.
Then, we have <math id="chapter9.A2.p4.m3" class="ltx_Math" alttext="f\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>, and the approximation error of <math id="chapter9.A2.p4.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> on this <math id="chapter9.A2.p4.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is at least <math id="chapter9.A2.p4.m6" class="ltx_Math" alttext="\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><annotation encoding="application/x-tex">\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
</section>
<section id="chapter10" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 10 </span>Proofs for Chapter 4</h2>

<section id="chapter10.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 10.A </span>Proof of Theorem <a href="#chapter4.Thmtheorem4" title="Theorem 4.4 (Proof in ). ‣ 16 Convex Combination ‣ Chapter 4 Mixing Multiple Contexts ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a></h2>

<div id="chapter10.A1.p1" class="ltx_para ltx_noindent">
<p id="chapter10.A1.p1.1" class="ltx_p"><span id="chapter10.A1.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
By the proof of <a href="#chapter2.Thmtheorem11" title="Theorem 2.11 (Proof in ). ‣ 7 General Objectives: SVME and KISE ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2.11</span></a>, <math id="chapter10.A1.p1.m1" class="ltx_Math" alttext="{\mathcal{R}}_{j}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\mathcal{R}}_{j}</annotation></semantics></math> can be written as</p>
<table id="chapter10.A1.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A1.Ex146.m1" class="ltx_Math" alttext="{\mathcal{R}}_{j}=d-\mathbb{E}_{A_{j}}{\left\|{\left(T_{P^{+}}^{*}\tilde{\Phi}\right)}(A_{j})\right\|}_{2}^{2}=d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},T_{k_{j}}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>j</mi></msub><mo>=</mo><mrow><mi>d</mi><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mi>A</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mi>d</mi><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msub><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}_{j}=d-\mathbb{E}_{A_{j}}{\left\|{\left(T_{P^{+}}^{*}\tilde{\Phi}\right)}(A_{j})\right\|}_{2}^{2}=d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},T_{k_{j}}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A1.p1.2" class="ltx_p">Therefore, the weighted sum <math id="chapter10.A1.p1.m2" class="ltx_Math" alttext="{\mathcal{L}}=\sum_{j}w_{j}{\mathcal{R}}_{j}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}=\sum_{j}w_{j}{\mathcal{R}}_{j}</annotation></semantics></math> is equivalent to</p>
<table id="chapter10.A1.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A1.Ex147.m1" class="ltx_Math" alttext="{\mathcal{L}}=\sum_{j=1}^{r}w_{j}{\left(d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},T_{k_{j}}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}}\right)}=d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},\sum_{j=1}^{r}{\left(w_{j}T_{k_{j}}\right)}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}}," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>d</mi><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msub><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>d</mi><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msub><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub><mo rspace="0em">,</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mrow><mo>(</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}=\sum_{j=1}^{r}w_{j}{\left(d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},T_{k_{j}}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}}\right)}=d-\sum_{i=1}^{d}{\left\langle\tilde{\phi}_{i},\sum_{j=1}^{r}{\left(w_{j}T_{k_{j}}\right)}\tilde{\phi}_{i}\right\rangle}_{{P_{\mathcal{X}}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A1.p1.3" class="ltx_p">where <math id="chapter10.A1.p1.m3" class="ltx_Math" alttext="\sum_{j}w_{j}T_{k_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{j}w_{j}T_{k_{j}}</annotation></semantics></math> is equal to the integral operator of the linearly combined kernel <math id="chapter10.A1.p1.m4" class="ltx_Math" alttext="\sum_{j}w_{j}k_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{j}w_{j}k_{j}</annotation></semantics></math>.
Thus, minimizing this <math id="chapter10.A1.p1.m5" class="ltx_Math" alttext="{\mathcal{L}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">{\mathcal{L}}</annotation></semantics></math> subject to the orthonormality constraint will make <math id="chapter10.A1.p1.m6" class="ltx_Math" alttext="\tilde{\Phi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Phi}</annotation></semantics></math> learn the contexture, as shown in <a href="#chapter2.Thmtheorem11" title="Theorem 2.11 (Proof in ). ‣ 7 General Objectives: SVME and KISE ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2.11</span></a>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter10.A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 10.B </span>Proof of Theorem <a href="#chapter4.Thmtheorem9" title="Theorem 4.9 (Proof in ). ‣ 16 Convex Combination ‣ Chapter 4 Mixing Multiple Contexts ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a></h2>

<figure id="alg6" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg6.3" class="ltx_text ltx_font_bold">Algorithm 6</span> </span> Solving the game <a href="#S16.E19" title="In 16 Convex Combination ‣ Chapter 4 Mixing Multiple Contexts ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">19</span></a> (Rewritten)</figcaption>
<div id="alg6.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg6.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Embedding dimension <math id="alg6.l1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, priors <math id="alg6.l1.m2" class="ltx_Math" alttext="P_{1}^{+},\cdots,P_{r}^{+}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>P</mi><mi>r</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P_{1}^{+},\cdots,P_{r}^{+}</annotation></semantics></math>, step size <math id="alg6.l1.m3" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>

</div>
<div id="alg6.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            Initialize: <math id="alg6.l2.m1" class="ltx_Math" alttext="{\mathbf{L}}^{0}\leftarrow[0,\cdots,0]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐋</mi><mn>0</mn></msup><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{L}}^{0}\leftarrow[0,\cdots,0]</annotation></semantics></math>, <math id="alg6.l2.m2" class="ltx_Math" alttext="\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>, <math id="alg6.l2.m3" class="ltx_Math" alttext="\Psi_{k}:{\mathcal{A}}_{k}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>k</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>k</mi></msub><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Psi_{k}:{\mathcal{A}}_{k}\rightarrow\mathbb{R}^{d}</annotation></semantics></math> for <math id="alg6.l2.m4" class="ltx_Math" alttext="k\in[r]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[r]</annotation></semantics></math>

</div>
<div id="alg6.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg6.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg6.l3.m1" class="ltx_Math" alttext="t=1,\cdots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\cdots,T</annotation></semantics></math> <span id="alg6.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg6.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
             <math id="alg6.l4.m1" class="ltx_Math" alttext="W^{t}=\sum_{k}\exp(\eta{\mathbf{L}}^{t-1}_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mi>t</mi></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐋</mi><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{t}=\sum_{k}\exp(\eta{\mathbf{L}}^{t-1}_{i})</annotation></semantics></math>; <math id="alg6.l4.m2" class="ltx_Math" alttext="{\textnormal{w}}^{t}_{k}=\frac{\exp(\eta{\mathbf{L}}^{t-1}_{k})}{W^{t}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo>=</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐋</mi><mi>k</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>W</mi><mi>t</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">{\textnormal{w}}^{t}_{k}=\frac{\exp(\eta{\mathbf{L}}^{t-1}_{k})}{W^{t}}</annotation></semantics></math>

</div>
<div id="alg6.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
             <math id="alg6.l5.m1" class="ltx_Math" alttext="\Phi^{t},\Psi^{t}_{1},\cdots,\Psi^{t}_{r}\leftarrow\arg\min\sum_{k}{\textnormal{w}}^{t}_{k}{\mathcal{R}}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>t</mi></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mn>1</mn><mi>t</mi></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msubsup><mi mathvariant="normal">Ψ</mi><mi>r</mi><mi>t</mi></msubsup><mo stretchy="false">←</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{t},\Psi^{t}_{1},\cdots,\Psi^{t}_{r}\leftarrow\arg\min\sum_{k}{\textnormal{w}}^{t}_{k}{\mathcal{R}}_{k}</annotation></semantics></math>, and get corresponding loss <math id="alg6.l5.m2" class="ltx_Math" alttext="{\mathcal{R}}^{t}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{R}}^{t}_{k}</annotation></semantics></math>, <math id="alg6.l5.m3" class="ltx_Math" alttext="l^{t}=\sum_{k}{\textnormal{w}}^{t}_{k}{\mathcal{R}}^{t}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mi>t</mi></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">l^{t}=\sum_{k}{\textnormal{w}}^{t}_{k}{\mathcal{R}}^{t}_{k}</annotation></semantics></math>

</div>
<div id="alg6.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
             Update the loss vector <math id="alg6.l6.m1" class="ltx_Math" alttext="{\mathbf{L}}^{t}\leftarrow{\mathbf{L}}^{t-1}+{\mathcal{R}}^{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐋</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi>𝐋</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{L}}^{t}\leftarrow{\mathbf{L}}^{t-1}+{\mathcal{R}}^{t}</annotation></semantics></math>

</div>
</div>
</figure>
<div id="chapter10.A2.p1" class="ltx_para ltx_noindent">
<p id="chapter10.A2.p1.1" class="ltx_p">For ease of reading and better use of notations, we restate our algorithm in <a href="#alg6" title="In Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">6</span></a> and use the notation defined there in our proof. It is easy to verify that they are equivalent. We first prove the following lemma.</p>
</div>
<div id="chapter10.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter10.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 10.1</span></span><span id="chapter10.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter10.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="chapter10.Thmtheorem1.p1.1" class="ltx_p"><span id="chapter10.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="chapter10.Thmtheorem1.p1.m1" class="ltx_Math" alttext="{\mathcal{R}}^{t}_{k}\leq C" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo>≤</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">{\mathcal{R}}^{t}_{k}\leq C</annotation></semantics></math> holds for all <math id="chapter10.Thmtheorem1.p1.m2" class="ltx_Math" alttext="t,k" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">t,k</annotation></semantics></math>, for some constant <math id="chapter10.Thmtheorem1.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. If <math id="chapter10.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\eta C&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\eta C&lt;1</annotation></semantics></math>, then for any <math id="chapter10.Thmtheorem1.p1.m5" class="ltx_Math" alttext="{\bm{w}}\in\Delta^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝐰</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{w}}\in\Delta^{r}</annotation></semantics></math>,</span></p>
<table id="chapter10.A2.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.E38.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{t}l^{t}\leq C^{2}T\eta+\frac{1}{\eta}\log r." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo lspace="0em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msup><mi>l</mi><mi>t</mi></msup></mrow></mrow><mo>≤</mo><mrow><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{t}l^{t}\leq C^{2}T\eta+\frac{1}{\eta}\log r.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="chapter10.Thmtheorem1.p1.2" class="ltx_p"><span id="chapter10.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">Moreover, suppose <math id="chapter10.Thmtheorem1.p1.m6" class="ltx_Math" alttext="T&gt;\log r" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">T&gt;\log r</annotation></semantics></math> and <math id="chapter10.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\eta=\frac{\sqrt{\log r}}{C\sqrt{T}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mfrac><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></msqrt><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta=\frac{\sqrt{\log r}}{C\sqrt{T}}</annotation></semantics></math>, <a href="#chapter10.A2.E38" title="In Lemma 10.1. ‣ Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">38</span></a> becomes</span></p>
<table id="chapter10.A2.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex148.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{T}l^{t}\leq 2C\sqrt{T\log r}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo lspace="0em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msup><mi>l</mi><mi>t</mi></msup></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{T}l^{t}\leq 2C\sqrt{T\log r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter10.A2.p2" class="ltx_para ltx_noindent">
<p id="chapter10.A2.p2.1" class="ltx_p"><span id="chapter10.A2.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
Consider the following potential function:</p>
<table id="chapter10.A2.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex149.m1" class="ltx_Math" alttext="\Omega(t)=\frac{1}{\eta}\log(W^{t})=\frac{1}{\eta}\log\left(\sum_{k=1}^{r}\exp(\eta{\mathbf{L}}_{k}^{t})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐋</mi><mi>k</mi><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega(t)=\frac{1}{\eta}\log(W^{t})=\frac{1}{\eta}\log\left(\sum_{k=1}^{r}\exp(\eta{\mathbf{L}}_{k}^{t})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.2" class="ltx_p">Since <math id="chapter10.A2.p2.m1" class="ltx_Math" alttext="\mathrm{e}^{x}\leq 1+x+x^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{e}^{x}\leq 1+x+x^{2}</annotation></semantics></math> when <math id="chapter10.A2.p2.m2" class="ltx_Math" alttext="x\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x\leq 1</annotation></semantics></math>, thus we have</p>
<table id="chapter10.A2.Ex150" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter10.A2.Ex150X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter10.A2.Ex150X.m2" class="ltx_Math" alttext="\displaystyle\Omega(t)-\Omega(t-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Omega(t)-\Omega(t-1)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta}\log\frac{W^{t}}{W^{t-1}}=\frac{1}{\eta}\log\left(\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}\exp(\eta{\mathcal{R}}^{t}_{k})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mi>W</mi><mi>t</mi></msup><msup><mi>W</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta}\log\frac{W^{t}}{W^{t-1}}=\frac{1}{\eta}\log\left(\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}\exp(\eta{\mathcal{R}}^{t}_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex150Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\eta}\log\left(\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[1+\eta{\mathcal{R}}^{t}_{k}+(\eta{\mathcal{R}}^{t}_{k})^{2}]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\eta}\log\left(\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[1+\eta{\mathcal{R}}^{t}_{k}+(\eta{\mathcal{R}}^{t}_{k})^{2}]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex150Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta}\log\left(1+\eta\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[{\mathcal{R}}^{t}_{k}+\eta({\mathcal{R}}^{t}_{k})^{2}]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta}\log\left(1+\eta\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[{\mathcal{R}}^{t}_{k}+\eta({\mathcal{R}}^{t}_{k})^{2}]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex150Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[{\mathcal{R}}^{t}_{k}+\eta({\mathcal{R}}^{t}_{k})^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}[{\mathcal{R}}^{t}_{k}+\eta({\mathcal{R}}^{t}_{k})^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex150Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}^{t}_{k}+\eta\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}({\mathcal{R}}^{t}_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}^{t}_{k}+\eta\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}({\mathcal{R}}^{t}_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex150Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex150Xe.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}^{t}_{k}+C^{2}\eta=l^{t}+C^{2}\eta." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>+</mo><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>=</mo><mrow><msup><mi>l</mi><mi>t</mi></msup><mo>+</mo><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}^{t}_{k}+C^{2}\eta=l^{t}+C^{2}\eta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.3" class="ltx_p">Summing over <math id="chapter10.A2.p2.m3" class="ltx_Math" alttext="t=1,\cdots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\cdots,T</annotation></semantics></math> and we can get</p>
<table id="chapter10.A2.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.E39.m1" class="ltx_Math" alttext="\Omega(T)-\Omega(0)\leq\sum_{t=1}^{t}l^{t}+C^{2}T\eta." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msup><mi>l</mi><mi>t</mi></msup></mrow><mo>+</mo><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega(T)-\Omega(0)\leq\sum_{t=1}^{t}l^{t}+C^{2}T\eta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.4" class="ltx_p">On the other hand, we know that for any <math id="chapter10.A2.p2.m4" class="ltx_Math" alttext="k\in[r]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[r]</annotation></semantics></math>, there is</p>
<table id="chapter10.A2.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex151.m1" class="ltx_Math" alttext="\Omega(T)\geq{\mathbf{L}}_{k}^{T}=\sum_{t=1}^{T}{\mathcal{R}}_{k}^{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msubsup><mi>𝐋</mi><mi>k</mi><mi>T</mi></msubsup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega(T)\geq{\mathbf{L}}_{k}^{T}=\sum_{t=1}^{T}{\mathcal{R}}_{k}^{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.5" class="ltx_p">Thus we can get for any <math id="chapter10.A2.p2.m5" class="ltx_Math" alttext="{\bm{w}}\in\Delta^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝒘</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{w}}\in\Delta^{r}</annotation></semantics></math>,</p>
<table id="chapter10.A2.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.E40.m1" class="ltx_Math" alttext="\Omega(T)\geq\sum_{k=1}^{r}w_{k}{\mathbf{L}}_{k}^{T}=\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐋</mi><mi>k</mi><mi>T</mi></msubsup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega(T)\geq\sum_{k=1}^{r}w_{k}{\mathbf{L}}_{k}^{T}=\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.6" class="ltx_p">Since <math id="chapter10.A2.p2.m6" class="ltx_Math" alttext="\Omega(0)=\frac{1}{\eta}\log r" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega(0)=\frac{1}{\eta}\log r</annotation></semantics></math>, combining (<a href="#chapter10.A2.E39" title="Equation 39 ‣ Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>) and (<a href="#chapter10.A2.E40" title="Equation 40 ‣ Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>) yields</p>
<table id="chapter10.A2.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex152.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{t}l^{t}\leq C^{2}T\eta+\frac{1}{\eta}\log r" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo lspace="0em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msup><mi>l</mi><mi>t</mi></msup></mrow></mrow><mo>≤</mo><mrow><mrow><msup><mi>C</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{t}l^{t}\leq C^{2}T\eta+\frac{1}{\eta}\log r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p2.7" class="ltx_p">for any <math id="chapter10.A2.p2.m7" class="ltx_Math" alttext="w\in\Delta^{r}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">w\in\Delta^{r}</annotation></semantics></math>.</p>
</div>
<div id="chapter10.A2.p3" class="ltx_para ltx_noindent">
<p id="chapter10.A2.p3.1" class="ltx_p">Moreover, take <math id="chapter10.A2.p3.m1" class="ltx_Math" alttext="\eta=\frac{\sqrt{\log r}}{C\sqrt{T}}&lt;\frac{1}{C}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mfrac><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></msqrt><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac><mo>&lt;</mo><mfrac><mn>1</mn><mi>C</mi></mfrac></mrow><annotation encoding="application/x-tex">\eta=\frac{\sqrt{\log r}}{C\sqrt{T}}&lt;\frac{1}{C}</annotation></semantics></math> and <a href="#chapter10.A2.E38" title="In Lemma 10.1. ‣ Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">38</span></a> becomes</p>
<table id="chapter10.A2.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex153.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{T}l^{t}\leq 2C\sqrt{T\log r}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo lspace="0em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msup><mi>l</mi><mi>t</mi></msup></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)-\sum_{t=1}^{T}l^{t}\leq 2C\sqrt{T\log r},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p3.2" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter10.A2.p4" class="ltx_para ltx_noindent">
<p id="chapter10.A2.p4.1" class="ltx_p">Now, we finish the proof of <a href="#chapter4.Thmtheorem9" title="Theorem 4.9 (Proof in ). ‣ 16 Convex Combination ‣ Chapter 4 Mixing Multiple Contexts ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.9</span></a>.</p>
</div>
<div id="chapter10.A2.p5" class="ltx_para ltx_noindent">
<p id="chapter10.A2.p5.1" class="ltx_p"><span id="chapter10.A2.p5.1.1" class="ltx_text ltx_font_bold">Proof </span>
For any <math id="chapter10.A2.p5.m1" class="ltx_Math" alttext="\hat{\Phi},\hat{\Psi}_{1},\cdots,\hat{\Psi}_{r}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">\hat{\Phi},\hat{\Psi}_{1},\cdots,\hat{\Psi}_{r}</annotation></semantics></math>, by the optimality of <math id="chapter10.A2.p5.m2" class="ltx_Math" alttext="\Phi^{t},\Psi^{t}_{1},\cdots,\Psi^{t}_{r}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>t</mi></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mn>1</mn><mi>t</mi></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mi>r</mi><mi>t</mi></msubsup></mrow><annotation encoding="application/x-tex">\Phi^{t},\Psi^{t}_{1},\cdots,\Psi^{t}_{r}</annotation></semantics></math>, we have</p>
<table id="chapter10.A2.Ex154" class="ltx_equationgroup ltx_eqn_table">

<tbody id="chapter10.A2.Ex154X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter10.A2.Ex154X.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}l_{t}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>l</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}l_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex154X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{T}\sum_{t=1}^{T}\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}_{k}^{t}\leq\frac{1}{T}\sum_{t=1}^{T}\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>T</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>r</mi></msup><mtext>w</mtext><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>T</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>r</mi></msup><mtext>w</mtext><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>Y</mi><mo>∼</mo><mi>P</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{T}\sum_{t=1}^{T}\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}{\mathcal{R}}_{k}^{t}\leq\frac{1}{T}\sum_{t=1}^{T}\sum_{k=1}^{r}{\textnormal{w}}_{k}^{t}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex154Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex154Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1}^{r}\frac{\sum_{t=1}^{T}{\textnormal{w}}_{k}^{t}}{T}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>r</mi></msup><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><msubsup><mtext>w</mtext><mi>k</mi><mi>t</mi></msubsup></mrow><mi>T</mi></mfrac></mstyle><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>Y</mi><mo>∼</mo><mi>P</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1}^{r}\frac{\sum_{t=1}^{T}{\textnormal{w}}_{k}^{t}}{T}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter10.A2.Ex154Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter10.A2.Ex154Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>r</mi></msup><mi>w</mi><msub><mrow></mrow><mi>k</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>Y</mi><mo>∼</mo><mi>P</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{Y\sim P_{k}^{+}(\cdot|X)}\|\hat{\Phi}(X)-\hat{\Psi}_{k}(Y)\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p5.2" class="ltx_p">This implies that</p>
<table id="chapter10.A2.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex155.m1" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=1}^{T}l_{t}\leq\min_{\Phi,\Psi}\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msub><mi>l</mi><mi>t</mi></msub></mrow></mrow><mo>≤</mo><mrow><munder><mi>min</mi><mrow><mi mathvariant="normal">Φ</mi><mo>,</mo><mi mathvariant="normal">Ψ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mprescripts></mprescripts><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msub><mi>w</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=1}^{T}l_{t}\leq\min_{\Phi,\Psi}\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p5.3" class="ltx_p">On the other hand, for any <math id="chapter10.A2.p5.m3" class="ltx_Math" alttext="w\in\Delta^{r}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">w\in\Delta^{r}</annotation></semantics></math>,</p>
<table id="chapter10.A2.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex156.m1" class="ltx_Math" alttext="{\mathcal{L}}(w)=\frac{1}{T}\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>t</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}(w)=\frac{1}{T}\sum_{t=1}^{T}\left(\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}^{t}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p5.4" class="ltx_p">Applying <a href="#chapter10.A2.Ex148" title="Lemma 10.1. ‣ Appendix 10.B Proof of Theorem ‣ Chapter 10 Proofs for Chapter 4 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">10.1</span></a>, we can get</p>
<table id="chapter10.A2.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter10.A2.Ex157.m1" class="ltx_Math" alttext="{\mathcal{L}}(w)\leq\frac{1}{T}\sum_{t=1}^{T}l_{t}+\frac{2C\sqrt{\log r}}{\sqrt{T}}\leq\min_{\Phi,\Psi}\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}+\frac{2C\sqrt{\log r}}{\sqrt{T}}={\mathcal{L}}^{*}+\frac{2C\sqrt{\log r}}{\sqrt{T}}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msub><mi>l</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mrow><mo>≤</mo><mrow><mrow><munder><mi>min</mi><mrow><mi mathvariant="normal">Φ</mi><mo>,</mo><mi mathvariant="normal">Ψ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mprescripts></mprescripts><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msub><mi>w</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mrow><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>∗</mo></msup><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>r</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}(w)\leq\frac{1}{T}\sum_{t=1}^{T}l_{t}+\frac{2C\sqrt{\log r}}{\sqrt{T}}\leq\min_{\Phi,\Psi}\max_{w\in\Delta^{r}}\sum_{k=1}^{r}w_{k}{\mathcal{R}}_{k}+\frac{2C\sqrt{\log r}}{\sqrt{T}}={\mathcal{L}}^{*}+\frac{2C\sqrt{\log r}}{\sqrt{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter10.A2.p5.5" class="ltx_p">for any <math id="chapter10.A2.p5.m4" class="ltx_Math" alttext="w\in\Delta^{r}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">w\in\Delta^{r}</annotation></semantics></math>, completing our proof.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
</section>
<section id="chapter11" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 11 </span>Proofs for Chapter 5</h2>

<section id="chapter11.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.A </span>Context Complexity of Masking</h2>

<div id="chapter11.Thmtheorem1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem1.2" class="ltx_text ltx_font_bold">Example 11.1</span></span><span id="chapter11.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem1.p1" class="ltx_para">
<p id="chapter11.Thmtheorem1.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Consider a <em id="chapter11.Thmtheorem1.p1.1.1.1" class="ltx_emph ltx_font_upright">random masking</em> augmentation, i.e. for any <math id="chapter11.Thmtheorem1.p1.m1" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>, each coordinate <math id="chapter11.Thmtheorem1.p1.m2" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> is randomly and independently masked to be <math id="chapter11.Thmtheorem1.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> (i.e. <math id="chapter11.Thmtheorem1.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> denotes the <span id="chapter11.Thmtheorem1.p1.1.1.2" class="ltx_text ltx_font_typewriter">[MASK]</span> token)
with probability <math id="chapter11.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math> .
Then, its context complexity is given by <math id="chapter11.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\kappa_{r}^{2}=(2-\alpha)^{d_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>r</mi><mn>2</mn></msubsup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{r}^{2}=(2-\alpha)^{d_{\mathcal{X}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter11.A1.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A1.p1.1" class="ltx_p"><span id="chapter11.A1.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
We know that
<math id="chapter11.A1.p1.m1" class="ltx_Math" alttext="\kappa^{2}\geq\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo rspace="0.111em">≥</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>a</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa^{2}\geq\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da</annotation></semantics></math>, whose right-hand side is a constant for all <math id="chapter11.A1.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> by symmetry.
Given an <math id="chapter11.A1.p1.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, suppose <math id="chapter11.A1.p1.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> has <math id="chapter11.A1.p1.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> coordinates masked and <math id="chapter11.A1.p1.m6" class="ltx_Math" alttext="(d_{{\mathcal{X}}}-r)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d_{{\mathcal{X}}}-r)</annotation></semantics></math> coordinates unmasked.
Then, there are <math id="chapter11.A1.p1.m7" class="ltx_Math" alttext="2^{r}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>r</mi></msup><annotation encoding="application/x-tex">2^{r}</annotation></semantics></math> possible <math id="chapter11.A1.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> that can be masked to become <math id="chapter11.A1.p1.m9" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.
For each of these <math id="chapter11.A1.p1.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="chapter11.A1.p1.m11" class="ltx_Math" alttext="P^{+}(a|x)=\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>α</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">P^{+}(a|x)=\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}</annotation></semantics></math>.
So <math id="chapter11.A1.p1.m12" class="ltx_Math" alttext="p(a)=\int P^{+}(a|x){P_{\mathcal{X}}}(x)dx=2^{r-d_{{\mathcal{X}}}}\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mrow><msup><mn>2</mn><mrow><mi>r</mi><mo>−</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">p(a)=\int P^{+}(a|x){P_{\mathcal{X}}}(x)dx=2^{r-d_{{\mathcal{X}}}}\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter11.A1.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A1.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A1.Ex158.m1" class="ltx_Math" alttext="\displaystyle\kappa^{2}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\kappa^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex158.m2" class="ltx_Math" alttext="\displaystyle=\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da=\sum_{r=0}^{d_{\mathcal{X}}}\binom{d_{\mathcal{X}}}{r}\frac{\alpha^{2r}(1-\alpha)^{2d_{{\mathcal{X}}}-2r}}{2^{r-d_{{\mathcal{X}}}}\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>a</mi></mrow></mrow></mrow></mstyle><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></munderover></mstyle><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mi>r</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>α</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup></mrow><mrow><msup><mn>2</mn><mrow><mi>r</mi><mo>−</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da=\sum_{r=0}^{d_{\mathcal{X}}}\binom{d_{\mathcal{X}}}{r}\frac{\alpha^{2r}(1-\alpha)^{2d_{{\mathcal{X}}}-2r}}{2^{r-d_{{\mathcal{X}}}}\alpha^{r}(1-\alpha)^{d_{{\mathcal{X}}}-r}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A1.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex159.m1" class="ltx_Math" alttext="\displaystyle=\sum_{r=0}^{d_{\mathcal{X}}}\binom{d_{\mathcal{X}}}{r}\alpha^{r}(2-2\alpha)^{d_{\mathcal{X}}-r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></munderover></mstyle><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mi>r</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{r=0}^{d_{\mathcal{X}}}\binom{d_{\mathcal{X}}}{r}\alpha^{r}(2-2\alpha)^{d_{\mathcal{X}}-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A1.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex160.m1" class="ltx_Math" alttext="\displaystyle=(\alpha+2-2\alpha)^{d_{\mathcal{X}}}=(2-\alpha)^{d_{\mathcal{X}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>α</mi><mo>+</mo><mn>2</mn></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\alpha+2-2\alpha)^{d_{\mathcal{X}}}=(2-\alpha)^{d_{\mathcal{X}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A1.p1.2" class="ltx_p">which completes the proof.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.Thmtheorem2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem2.2" class="ltx_text ltx_font_bold">Example 11.2</span></span><span id="chapter11.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem2.p1" class="ltx_para">
<p id="chapter11.Thmtheorem2.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Consider <em id="chapter11.Thmtheorem2.p1.1.1.1" class="ltx_emph ltx_font_upright">random block masking</em>,
i.e. masking <math id="chapter11.Thmtheorem2.p1.m1" class="ltx_Math" alttext="x^{(i)},x^{(i+1)},\cdots,x^{(i+r-1)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>r</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x^{(i)},x^{(i+1)},\cdots,x^{(i+r-1)}</annotation></semantics></math> for <math id="chapter11.Thmtheorem2.p1.m2" class="ltx_Math" alttext="r=\lceil\alpha d_{{\mathcal{X}}}\rceil" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">r=\lceil\alpha d_{{\mathcal{X}}}\rceil</annotation></semantics></math> and a uniformly random <math id="chapter11.Thmtheorem2.p1.m3" class="ltx_Math" alttext="i\in[d_{{\mathcal{X}}}-r]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d_{{\mathcal{X}}}-r]</annotation></semantics></math>, for any <math id="chapter11.Thmtheorem2.p1.m4" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>.
Then, <math id="chapter11.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\kappa_{c}^{2}\leq[2^{(1-\alpha)}]^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>c</mi><mn>2</mn></msubsup><mo>≤</mo><msup><mrow><mo stretchy="false">[</mo><msup><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{c}^{2}\leq[2^{(1-\alpha)}]^{d_{{\mathcal{X}}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter11.A1.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A1.p2.1" class="ltx_p"><span id="chapter11.A1.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
For any <math id="chapter11.A1.p2.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, we have <math id="chapter11.A1.p2.m2" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)=\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)=\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}</annotation></semantics></math>, and <math id="chapter11.A1.p2.m3" class="ltx_Math" alttext="P^{+}(a|x)=\frac{1}{d_{\mathcal{X}}-r+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">P^{+}(a|x)=\frac{1}{d_{\mathcal{X}}-r+1}</annotation></semantics></math> if <math id="chapter11.A1.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is a masked version of <math id="chapter11.A1.p2.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
So there always is <math id="chapter11.A1.p2.m6" class="ltx_Math" alttext="\frac{P^{+}(a|x)}{{P_{\mathcal{A}}}(a)}=2^{d_{\mathcal{X}}-r}\leq 2^{(1-\alpha)d_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup><mo>≤</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\frac{P^{+}(a|x)}{{P_{\mathcal{A}}}(a)}=2^{d_{\mathcal{X}}-r}\leq 2^{(1-\alpha)d_{\mathcal{X}}}</annotation></semantics></math>. Thus, we have <math id="chapter11.A1.p2.m7" class="ltx_Math" alttext="\kappa^{2}\leq 2^{(1-\alpha)d_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo>≤</mo><msup><mn>2</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\kappa^{2}\leq 2^{(1-\alpha)d_{\mathcal{X}}}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.Thmtheorem3" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem3.2" class="ltx_text ltx_font_bold">Example 11.3</span></span><span id="chapter11.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem3.p1" class="ltx_para">
<p id="chapter11.Thmtheorem3.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Consider <em id="chapter11.Thmtheorem3.p1.1.1.1" class="ltx_emph ltx_font_upright">random block masking with flipping</em>, where for any <math id="chapter11.Thmtheorem3.p1.m1" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>,
first mask <math id="chapter11.Thmtheorem3.p1.m2" class="ltx_Math" alttext="x^{(i)},\cdots,x^{(i+r-1)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>r</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x^{(i)},\cdots,x^{(i+r-1)}</annotation></semantics></math> to be <math id="chapter11.Thmtheorem3.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>
for <math id="chapter11.Thmtheorem3.p1.m4" class="ltx_Math" alttext="r=\lceil\alpha d_{{\mathcal{X}}}\rceil" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">r=\lceil\alpha d_{{\mathcal{X}}}\rceil</annotation></semantics></math> and a uniformly random <math id="chapter11.Thmtheorem3.p1.m5" class="ltx_Math" alttext="i\in[d_{{\mathcal{X}}}-r]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d_{{\mathcal{X}}}-r]</annotation></semantics></math>,
then randomly flip the sign of each remaining coordinate independently with probability <math id="chapter11.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\frac{\alpha}{2}" display="inline" intent=":literal"><semantics><mfrac><mi>α</mi><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{\alpha}{2}</annotation></semantics></math>.
Then, its context complexity is bounded by <math id="chapter11.Thmtheorem3.p1.m7" class="ltx_Math" alttext="\kappa_{b}^{2}\leq\left[(\alpha^{2}-2\alpha+2)^{(1-\alpha/2)}\right]^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>b</mi><mn>2</mn></msubsup><mo>≤</mo><msup><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo>]</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{b}^{2}\leq\left[(\alpha^{2}-2\alpha+2)^{(1-\alpha/2)}\right]^{d_{{\mathcal{X}}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter11.A1.p3" class="ltx_para ltx_noindent">
<p id="chapter11.A1.p3.1" class="ltx_p"><span id="chapter11.A1.p3.1.1" class="ltx_text ltx_font_bold">Proof </span>
For any <math id="chapter11.A1.p3.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, we have <math id="chapter11.A1.p3.m2" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)=\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)=\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}</annotation></semantics></math>.
Suppose <math id="chapter11.A1.p3.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is a masked version of <math id="chapter11.A1.p3.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, and among the unmasked <math id="chapter11.A1.p3.m5" class="ltx_Math" alttext="(d_{\mathcal{X}}-r)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d_{\mathcal{X}}-r)</annotation></semantics></math> coordinates, <math id="chapter11.A1.p3.m6" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="chapter11.A1.p3.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> have <math id="chapter11.A1.p3.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> disagreeing coordinates.
For a given <math id="chapter11.A1.p3.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,
there are <math id="chapter11.A1.p3.m10" class="ltx_Math" alttext="(d_{\mathcal{X}}-r+1)\binom{d_{\mathcal{X}}-r}{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mi>k</mi></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(d_{\mathcal{X}}-r+1)\binom{d_{\mathcal{X}}-r}{k}</annotation></semantics></math> possible <math id="chapter11.A1.p3.m11" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>,
and we have <math id="chapter11.A1.p3.m12" class="ltx_Math" alttext="P^{+}(a|x)=\frac{1}{d_{\mathcal{X}}-r+1}(\frac{\alpha}{2})^{k}(1-\frac{\alpha}{2})^{d_{\mathcal{X}}-r-k}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>α</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>α</mi><mn>2</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">P^{+}(a|x)=\frac{1}{d_{\mathcal{X}}-r+1}(\frac{\alpha}{2})^{k}(1-\frac{\alpha}{2})^{d_{\mathcal{X}}-r-k}</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter11.A1.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A1.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A1.Ex161.m1" class="ltx_Math" alttext="\displaystyle\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>a</mi></mrow></mrow></mrow></mstyle><annotation encoding="application/x-tex">\displaystyle\int\frac{P^{+}(a|x)^{2}}{{P_{\mathcal{A}}}(a)}da</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex161.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{d_{\mathcal{X}}-r}(d_{\mathcal{X}}-r+1)\binom{d_{\mathcal{X}}-r}{k}\frac{\frac{1}{(d_{\mathcal{X}}-r+1)^{2}}(\frac{\alpha}{2})^{2k}(1-\frac{\alpha}{2})^{2d_{\mathcal{X}}-2r-2k}}{\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>α</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>α</mi><mn>2</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></msup></mrow><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mfrac></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{d_{\mathcal{X}}-r}(d_{\mathcal{X}}-r+1)\binom{d_{\mathcal{X}}-r}{k}\frac{\frac{1}{(d_{\mathcal{X}}-r+1)^{2}}(\frac{\alpha}{2})^{2k}(1-\frac{\alpha}{2})^{2d_{\mathcal{X}}-2r-2k}}{\frac{1}{d_{\mathcal{X}}-r+1}\frac{1}{2^{d_{\mathcal{X}}-r}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A1.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex162.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{d_{\mathcal{X}}-r}\binom{d_{\mathcal{X}}-r}{k}2^{d_{\mathcal{X}}-r}\left(\frac{\alpha^{2}}{4}\right)^{k}\left(1-\alpha+\frac{\alpha^{2}}{4}\right)^{d_{\mathcal{X}}-r-k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>α</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>α</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{d_{\mathcal{X}}-r}\binom{d_{\mathcal{X}}-r}{k}2^{d_{\mathcal{X}}-r}\left(\frac{\alpha^{2}}{4}\right)^{k}\left(1-\alpha+\frac{\alpha^{2}}{4}\right)^{d_{\mathcal{X}}-r-k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A1.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex163.m1" class="ltx_Math" alttext="\displaystyle=2^{d_{\mathcal{X}}-r}\left(\frac{\alpha^{2}}{4}+1-\alpha+\frac{\alpha^{2}}{4}\right)^{d_{\mathcal{X}}-r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mn>2</mn><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>α</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>α</mi><mn>2</mn></msup><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2^{d_{\mathcal{X}}-r}\left(\frac{\alpha^{2}}{4}+1-\alpha+\frac{\alpha^{2}}{4}\right)^{d_{\mathcal{X}}-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A1.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A1.Ex164.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\alpha^{2}-2\alpha+2\right)^{d_{\mathcal{X}}-r}\leq\left(\alpha^{2}-2\alpha+2\right)^{(1-\alpha/2)d_{{\mathcal{X}}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow></msup><mo>≤</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\alpha^{2}-2\alpha+2\right)^{d_{\mathcal{X}}-r}\leq\left(\alpha^{2}-2\alpha+2\right)^{(1-\alpha/2)d_{{\mathcal{X}}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A1.p3.2" class="ltx_p">which proves the bound.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.B </span>Proof of Lemma <a href="#chapter5.Thmtheorem10" title="Lemma 5.10 (Proof in ). ‣ Approximation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.10</span></a></h2>

<div id="chapter11.A2.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A2.p1.1" class="ltx_p"><span id="chapter11.A2.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter11.A2.p1.m1" class="ltx_Math" alttext="f_{i}=\sum_{j}u_{ij}s_{j}\mu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}=\sum_{j}u_{ij}s_{j}\mu_{j}</annotation></semantics></math>, and <math id="chapter11.A2.p1.m2" class="ltx_Math" alttext="{\bm{U}}=(u_{ij})=[{\bm{u}}_{1},\cdots,{\bm{u}}_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}=(u_{ij})=[{\bm{u}}_{1},\cdots,{\bm{u}}_{d}]</annotation></semantics></math>.
<math id="chapter11.A2.p1.m3" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math> is a matrix with <math id="chapter11.A2.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> columns and infinitely many rows.
Then, since <math id="chapter11.A2.p1.m5" class="ltx_math_unparsed" alttext="{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>=</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]</annotation></semantics></math>, we have <math id="chapter11.A2.p1.m6" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}</annotation></semantics></math>.
Let <math id="chapter11.A2.p1.m7" class="ltx_Math" alttext="{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x),\cdots]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x),\cdots]</annotation></semantics></math>, and for a set of samples <math id="chapter11.A2.p1.m8" class="ltx_Math" alttext="S={\left\{x_{1},\cdots,x_{m}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">S={\left\{x_{1},\cdots,x_{m}\right\}}</annotation></semantics></math> denote <math id="chapter11.A2.p1.m9" class="ltx_Math" alttext="{\bm{M}}_{j}={\bm{M}}(x_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑴</mi><mi>j</mi></msub><mo>=</mo><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}_{j}={\bm{M}}(x_{j})</annotation></semantics></math>.
Then, we have</p>
<table id="chapter11.A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A2.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A2.Ex165.m1" class="ltx_Math" alttext="\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex165.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{F\in{\mathcal{F}}_{d}}\frac{1}{m}\sum_{j=1}^{m}\sigma_{i}F(x_{j})\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{F\in{\mathcal{F}}_{d}}\frac{1}{m}\sum_{j=1}^{m}\sigma_{i}F(x_{j})\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex166.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\frac{1}{m}\sum_{j=1}^{m}\sum_{i=1}^{d}\sigma_{j}{\bm{u}}_{i}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{u}}_{i}\right|}\right]}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝑼</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msub><mi>σ</mi><mi>j</mi></msub><msubsup><mi>𝒖</mi><mi>i</mi><mo>⊤</mo></msubsup><msub><mi>𝑴</mi><mi>j</mi></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><msub><mi>𝒖</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\frac{1}{m}\sum_{j=1}^{m}\sum_{i=1}^{d}\sigma_{j}{\bm{u}}_{i}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{u}}_{i}\right|}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex167.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\bm{U}}^{\top}{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}\right\}}\right|}\right]}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝑼</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mi>Tr</mi><mrow><mo>{</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mi>σ</mi><mi>j</mi></msub><msub><mi>𝑴</mi><mi>j</mi></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mi>𝑼</mi><mo>}</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\bm{U}}^{\top}{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}\right\}}\right|}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex168.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}{\bm{U}}^{\top}\right\}}\right|}\right]}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mrow><mo>[</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝑼</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mi>Tr</mi><mrow><mo>{</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mi>σ</mi><mi>j</mi></msub><msub><mi>𝑴</mi><mi>j</mi></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mi>𝑼</mi><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo>}</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}{\bm{U}}^{\top}\right\}}\right|}\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A2.p1.2" class="ltx_p">where <math id="chapter11.A2.p1.m10" class="ltx_Math" alttext="\sigma_{1},\cdots,\sigma_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\sigma_{1},\cdots,\sigma_{m}</annotation></semantics></math> are Rademacher variables, which are <span id="chapter11.A2.p1.2.1" class="ltx_text ltx_font_italic">i.i.d.</span> uniform random variables taking values in <math id="chapter11.A2.p1.m11" class="ltx_Math" alttext="{\left\{-1,+1\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">{\left\{-1,+1\right\}}</annotation></semantics></math>.
Let <math id="chapter11.A2.p1.m12" class="ltx_Math" alttext="\beta_{1}\geq\beta_{2}\geq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>β</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\beta_{1}\geq\beta_{2}\geq\cdots</annotation></semantics></math> be the singular values of <math id="chapter11.A2.p1.m13" class="ltx_Math" alttext="\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}</annotation></semantics></math>.
For any <math id="chapter11.A2.p1.m14" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="chapter11.A2.p1.m15" class="ltx_Math" alttext="{\bm{M}}(x)^{\top}{\bm{M}}(x)=\sum s_{i}^{2}\mu_{i}^{2}(x)\leq\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\bm{M}}(x)^{\top}{\bm{M}}(x)=\sum s_{i}^{2}\mu_{i}^{2}(x)\leq\kappa^{2}</annotation></semantics></math>, which implies that <math id="chapter11.A2.p1.m16" class="ltx_Math" alttext="{\bm{M}}_{j}^{\top}{\bm{M}}_{j}\leq\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\bm{M}}_{j}^{\top}{\bm{M}}_{j}\leq\kappa^{2}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A2.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A2.p2.1" class="ltx_p">For any <math id="chapter11.A2.p2.m1" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math>, the singular values of <math id="chapter11.A2.p2.m2" class="ltx_Math" alttext="{\bm{U}}{\bm{U}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{U}}{\bm{U}}^{\top}</annotation></semantics></math> are <math id="chapter11.A2.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> ones and lots of zeros.
Moreover, <math id="chapter11.A2.p2.m4" class="ltx_Math" alttext="{\left\|\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}^{2}=\sum_{i=1}^{\infty}\beta_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}^{2}=\sum_{i=1}^{\infty}\beta_{i}^{2}</annotation></semantics></math>.
So by von Neumann’s trace inequality, we have</p>
<table id="chapter11.A2.Ex169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A2.Ex169.m1" class="ltx_math_unparsed" alttext="\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}{\bm{U}}^{\top}\right\}}\right|}\leq\sum_{i=1}^{d}\beta_{i}\leq\sqrt{d\sum_{i=1}^{d}\beta_{i}^{2}}\leq\frac{\sqrt{d}}{m}{\left\|\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝑼</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><mi>Tr</mi><mrow><mo>{</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>m</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>σ</mi><mi>j</mi></msub><msub><mi>𝑴</mi><mi>j</mi></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mi>𝑼</mi><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo>}</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em" rspace="0.111em">≤</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msub><mi>β</mi><mi>i</mi></msub><mo>≤</mo><msqrt><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></msqrt><mo>≤</mo><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac><msub><mrow><mo>‖</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>σ</mi><mi>j</mi></msub><msub><mi>𝑴</mi><mi>j</mi></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{{\bm{U}}:{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}}{\left|\Tr{\left\{{\left(\frac{1}{m}\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}{\bm{U}}{\bm{U}}^{\top}\right\}}\right|}\leq\sum_{i=1}^{d}\beta_{i}\leq\sqrt{d\sum_{i=1}^{d}\beta_{i}^{2}}\leq\frac{\sqrt{d}}{m}{\left\|\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A2.p3" class="ltx_para ltx_noindent">
<p id="chapter11.A2.p3.1" class="ltx_p">Thus, for any <math id="chapter11.A2.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, we have</p>
<table id="chapter11.A2.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A2.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A2.Ex170.m1" class="ltx_Math" alttext="\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex170.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\sqrt{d}}{m}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[{\left\|\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sqrt{d}}{m}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[{\left\|\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex171.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{d}}{m}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\Tr{\left\{{\left(\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}^{\top}{\left(\sum_{l=1}^{m}\sigma_{l}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right\}}^{1/2}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>Tr</mi><mo>⁡</mo><msup><mrow><mo>{</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{d}}{m}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\Tr{\left\{{\left(\sum_{j=1}^{m}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}^{\top}{\left(\sum_{l=1}^{m}\sigma_{l}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right\}}^{1/2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex172.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{\sqrt{d}}{m}\sqrt{\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\Tr{\left(\sum_{j,l=1}^{m}\sigma_{j}\sigma_{l}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right]}}\qquad(\textrm{Jensen})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><msqrt><mrow><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></msqrt><mrow><mo stretchy="false">(</mo><mtext>Jensen</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sqrt{d}}{m}\sqrt{\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\Tr{\left(\sum_{j,l=1}^{m}\sigma_{j}\sigma_{l}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right]}}\qquad(\textrm{Jensen})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex173.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{d}}{m}\sqrt{\Tr{\left(\sum_{j,l=1}^{m}\mathbb{E}[\sigma_{j}\sigma_{l}]{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>l</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{d}}{m}\sqrt{\Tr{\left(\sum_{j,l=1}^{m}\mathbb{E}[\sigma_{j}\sigma_{l}]{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A2.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A2.Ex174.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{d}}{m}\sqrt{\Tr{\left(\sum_{j=1}^{m}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}}=\frac{\sqrt{d}}{m}\sqrt{\sum_{j=1}^{m}{\left({\bm{M}}_{j}^{\top}{\bm{M}}_{j}\right)}^{2}}\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{d}}{m}\sqrt{\Tr{\left(\sum_{j=1}^{m}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}}=\frac{\sqrt{d}}{m}\sqrt{\sum_{j=1}^{m}{\left({\bm{M}}_{j}^{\top}{\bm{M}}_{j}\right)}^{2}}\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A2.p3.2" class="ltx_p">Since <math id="chapter11.A2.p3.m2" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}}_{d})=\mathbb{E}_{S}[\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}}_{d})=\mathbb{E}_{S}[\hat{\mathfrak{R}}_{S}({\mathcal{F}}_{d})]</annotation></semantics></math>, we have <math id="chapter11.A2.p3.m3" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}}_{d})\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><msqrt><mi>d</mi></msqrt><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}}_{d})\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.C </span>Proof of Lemma <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.13</span></a></h2>

<div id="chapter11.A3.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A3.p1.1" class="ltx_p"><span id="chapter11.A3.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter11.A3.p1.m1" class="ltx_Math" alttext="f_{1}=\sum u_{i}s_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1}=\sum u_{i}s_{i}\mu_{i}</annotation></semantics></math> and <math id="chapter11.A3.p1.m2" class="ltx_Math" alttext="f_{2}=\sum v_{i}s_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{2}=\sum v_{i}s_{i}\mu_{i}</annotation></semantics></math>.
Let <math id="chapter11.A3.p1.m3" class="ltx_Math" alttext="{\bm{u}}=[u_{1},u_{2},\cdots]" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}=[u_{1},u_{2},\cdots]</annotation></semantics></math> and <math id="chapter11.A3.p1.m4" class="ltx_Math" alttext="{\bm{v}}=[v_{1},v_{2},\cdots]" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}=[v_{1},v_{2},\cdots]</annotation></semantics></math>.
Then, <math id="chapter11.A3.p1.m5" class="ltx_Math" alttext="{\left\|{\bm{u}}\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝒖</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}\right\|}_{2}\leq 1</annotation></semantics></math> and <math id="chapter11.A3.p1.m6" class="ltx_Math" alttext="{\left\|{\bm{v}}\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝒗</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|{\bm{v}}\right\|}_{2}\leq 1</annotation></semantics></math>.
For any <math id="chapter11.A3.p1.m7" class="ltx_Math" alttext="S={\left\{x_{1},\cdots,x_{n}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">S={\left\{x_{1},\cdots,x_{n}\right\}}</annotation></semantics></math>, let <math id="chapter11.A3.p1.m8" class="ltx_Math" alttext="{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x)]</annotation></semantics></math> and <math id="chapter11.A3.p1.m9" class="ltx_Math" alttext="{\bm{M}}_{j}={\bm{M}}(x_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑴</mi><mi>j</mi></msub><mo>=</mo><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}_{j}={\bm{M}}(x_{j})</annotation></semantics></math>. Then, we have</p>
<table id="chapter11.A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A3.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A3.Ex175.m1" class="ltx_Math" alttext="\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\mathfrak{R}}_{S}({\mathcal{F}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A3.Ex175.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\sup_{{\left\|{\bm{u}}\right\|}_{2}\leq 1,{\left\|{\bm{v}}\right\|}_{2}\leq 1}{\left|\frac{1}{n}\sum_{j=1}^{n}\sigma_{j}{\bm{u}}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{v}}\right|}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mrow><msub><mrow><mo>‖</mo><mi>𝒖</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mrow><mo>‖</mo><mi>𝒗</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow></mrow></munder><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\sup_{{\left\|{\bm{u}}\right\|}_{2}\leq 1,{\left\|{\bm{v}}\right\|}_{2}\leq 1}{\left|\frac{1}{n}\sum_{j=1}^{n}\sigma_{j}{\bm{u}}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{v}}\right|}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A3.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A3.Ex176.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[{\left\|\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{2}\right]}\leq\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[{\left\|\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[{\left\|\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{2}\right]}\leq\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[{\left\|\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\|}_{F}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A3.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A3.Ex177.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\Tr{\left\{{\left(\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}^{\top}{\left(\sum_{l=1}^{n}\sigma_{l}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right\}}^{1/2}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>Tr</mi><mo>⁡</mo><msup><mrow><mo>{</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\Tr{\left\{{\left(\sum_{j=1}^{n}\sigma_{j}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right)}^{\top}{\left(\sum_{l=1}^{n}\sigma_{l}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right)}\right\}}^{1/2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A3.Ex178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A3.Ex178.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{n}\sqrt{\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\Tr{\left\{\sum_{j,l=1}^{n}\sigma_{j}\sigma_{l}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right\}}\right]}}\qquad(\text{Jensen})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><msqrt><mrow><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></msqrt><mrow><mo stretchy="false">(</mo><mtext>Jensen</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{n}\sqrt{\mathbb{E}_{\sigma_{1},\cdots,\sigma_{n}}{\left[\Tr{\left\{\sum_{j,l=1}^{n}\sigma_{j}\sigma_{l}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right\}}\right]}}\qquad(\text{Jensen})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A3.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A3.Ex179.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sqrt{\Tr{\left\{\sum_{j,l=1}^{n}\mathbb{E}{\left[\sigma_{j}\sigma_{l}\right]}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right\}}}=\frac{1}{n}\sqrt{\Tr{\left\{\sum_{j=1}^{n}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\}}}\leq\frac{1}{n}\sqrt{n\kappa^{4}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>l</mi></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>}</mo></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>}</mo></mrow></mrow></msqrt></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sqrt{\Tr{\left\{\sum_{j,l=1}^{n}\mathbb{E}{\left[\sigma_{j}\sigma_{l}\right]}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{l}{\bm{M}}_{l}^{\top}\right\}}}=\frac{1}{n}\sqrt{\Tr{\left\{\sum_{j=1}^{n}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}{\bm{M}}_{j}{\bm{M}}_{j}^{\top}\right\}}}\leq\frac{1}{n}\sqrt{n\kappa^{4}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A3.p1.2" class="ltx_p">Here the first line is not equality because of the absolute value. Since this holds for any <math id="chapter11.A3.p1.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, we have <math id="chapter11.A3.p1.m11" class="ltx_Math" alttext="\mathfrak{R}_{n}({\mathcal{F}})=\mathbb{E}_{s}[\hat{\mathfrak{R}}_{S}({\mathcal{F}})]\leq\frac{\kappa^{2}}{\sqrt{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℜ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{n}({\mathcal{F}})=\mathbb{E}_{s}[\hat{\mathfrak{R}}_{S}({\mathcal{F}})]\leq\frac{\kappa^{2}}{\sqrt{n}}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A3.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A3.p2.1" class="ltx_p">By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib148" title="" class="ltx_ref">148</a>, Theorem 4.10]</cite>, for any <math id="chapter11.A3.p2.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter11.A3.p2.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, both of the following hold simultaneously for any <math id="chapter11.A3.p2.m3" class="ltx_Math" alttext="f\in{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f\in{\mathcal{F}}</annotation></semantics></math>:</p>
<table id="chapter11.A3.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A3.Ex180.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} &{\left|\frac{1}{n}\sum_{i=1}^{n}f(\tilde{x}_{i})-\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[f(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)};\\
&{\left|\frac{1}{n}\sum_{i=1}^{m}f(x_{i})-\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[f(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{m}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} &amp;{\left|\frac{1}{n}\sum_{i=1}^{n}f(\tilde{x}_{i})-\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[f(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)};\\
&amp;{\left|\frac{1}{n}\sum_{i=1}^{m}f(x_{i})-\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[f(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{m}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A3.p2.2" class="ltx_p">For any unit vector <math id="chapter11.A3.p2.m4" class="ltx_Math" alttext="{\bm{u}}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{u}}\in\mathbb{R}^{d}</annotation></semantics></math>, let <math id="chapter11.A3.p2.m5" class="ltx_Math" alttext="f_{\bm{u}}(x)={\bm{u}}^{\top}\Phi(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>𝒖</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{u}}(x)={\bm{u}}^{\top}\Phi(x)</annotation></semantics></math>. Then, <math id="chapter11.A3.p2.m6" class="ltx_Math" alttext="{\left\|f_{\bm{u}}\right\|}_{{{\mathcal{H}}_{k}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mi>𝒖</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f_{\bm{u}}\right\|}_{{{\mathcal{H}}_{k}}}=1</annotation></semantics></math>, so <math id="chapter11.A3.p2.m7" class="ltx_Math" alttext="f_{\bm{u}}^{2}\in{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>𝒖</mi><mn>2</mn></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f_{\bm{u}}^{2}\in{\mathcal{F}}</annotation></semantics></math>.
Moreover, we have</p>
<table id="chapter11.A3.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A3.Ex181.m1" class="ltx_Math" alttext="\sum_{i=1}^{m}f_{\bm{u}}(x_{i})^{2}={\left\|{\bm{G}}[{\bm{v}}_{1},\cdots,{\bm{v}}_{d}]{\bm{u}}\right\|}_{2}^{2}=\sum_{i=1}^{d}\lambda_{i}u_{i}^{2}\geq\lambda_{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>f</mi><mi>𝒖</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mi>𝑮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒗</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒗</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}f_{\bm{u}}(x_{i})^{2}={\left\|{\bm{G}}[{\bm{v}}_{1},\cdots,{\bm{v}}_{d}]{\bm{u}}\right\|}_{2}^{2}=\sum_{i=1}^{d}\lambda_{i}u_{i}^{2}\geq\lambda_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A3.p2.3" class="ltx_p">Thus, using the above inequalities, assuming that <math id="chapter11.A3.p2.m8" class="ltx_Math" alttext="m\geq n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\geq n</annotation></semantics></math>, we obtain</p>
<table id="chapter11.A3.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A3.Ex182.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{j=1}^{n}f(\tilde{x}_{j})^{2}\geq\frac{\lambda_{d}}{m}-\frac{\kappa^{2}}{\sqrt{n}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><msub><mi>λ</mi><mi>d</mi></msub><mi>m</mi></mfrac><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{j=1}^{n}f(\tilde{x}_{j})^{2}\geq\frac{\lambda_{d}}{m}-\frac{\kappa^{2}}{\sqrt{n}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A3.p2.4" class="ltx_p">which implies the result since <math id="chapter11.A3.p2.m9" class="ltx_Math" alttext="{\left\|{\bm{\Phi}}{\bm{u}}\right\|}_{2}^{2}=\sum_{j=1}^{n}f(\tilde{x}_{j})^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{\Phi}}{\bm{u}}\right\|}_{2}^{2}=\sum_{j=1}^{n}f(\tilde{x}_{j})^{2}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.D </span>Proof of Corollary <a href="#chapter5.Thmtheorem14" title="Corollary 5.14 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.14</span></a></h2>

<div id="chapter11.A4.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A4.p1.1" class="ltx_p"><span id="chapter11.A4.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Denote <math id="chapter11.A4.p1.m1" class="ltx_Math" alttext="F=f^{*}-f_{\Phi}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">F=f^{*}-f_{\Phi}</annotation></semantics></math>. Then, <math id="chapter11.A4.p1.m2" class="ltx_Math" alttext="{\bm{y}}-{\bm{y}}_{\Phi}=[F(\tilde{x}_{1}),\cdots,F(\tilde{x}_{n})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}-{\bm{y}}_{\Phi}=[F(\tilde{x}_{1}),\cdots,F(\tilde{x}_{n})]</annotation></semantics></math>, and <math id="chapter11.A4.p1.m3" class="ltx_Math" alttext="\frac{F^{2}}{{\left\|F\right\|}_{{{\mathcal{H}}_{k}}}^{2}}\in{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mi>F</mi><mn>2</mn></msup><msubsup><mrow><mo>‖</mo><mi>F</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mfrac><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">\frac{F^{2}}{{\left\|F\right\|}_{{{\mathcal{H}}_{k}}}^{2}}\in{\mathcal{F}}</annotation></semantics></math>, where <math id="chapter11.A4.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> was defined in <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>.
Therefore, by <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>, we have</p>
<table id="chapter11.A4.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A4.Ex183.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{j=1}^{n}F(\tilde{x}_{j})\leq\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[F(X)^{2}]+{\left\|F\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mrow><mo>‖</mo><mi>F</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{j=1}^{n}F(\tilde{x}_{j})\leq\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[F(X)^{2}]+{\left\|F\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A4.p1.2" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.E </span>Proof of Theorem <a href="#chapter5.Thmtheorem22" title="Theorem 5.22 (Proof in ). ‣ 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a></h2>

<div id="chapter11.A5.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p1.1" class="ltx_p"><span id="chapter11.A5.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter11.A5.p1.m1" class="ltx_Math" alttext="\mu_{1},\mu_{2},\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\mu_{1},\mu_{2},\cdots</annotation></semantics></math> be the eigenfunctions of <math id="chapter11.A5.p1.m2" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>.
First, let us show that <math id="chapter11.A5.p1.m3" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math> must be an RKHS.
since <math id="chapter11.A5.p1.m4" class="ltx_Math" alttext="\mu_{1}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mu_{1}</annotation></semantics></math> is the common top-<math id="chapter11.A5.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> eigenfunction of <math id="chapter11.A5.p1.m6" class="ltx_Math" alttext="T_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">T_{k^{p}}</annotation></semantics></math> for all <math id="chapter11.A5.p1.m7" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, we have <math id="chapter11.A5.p1.m8" class="ltx_Math" alttext="r_{k^{p}}(\mu_{1})\geq r_{k^{p}}(f)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>r</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{k^{p}}(\mu_{1})\geq r_{k^{p}}(f)</annotation></semantics></math> for all <math id="chapter11.A5.p1.m9" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{k}}</annotation></semantics></math>.
By the condition of preserving relative smoothness, this implies that for all <math id="chapter11.A5.p1.m10" class="ltx_Math" alttext="f\in{\mathcal{H}}_{t}\subset{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{t}\subset{{\mathcal{H}}_{k}}</annotation></semantics></math>, we have <math id="chapter11.A5.p1.m11" class="ltx_Math" alttext="r_{t}(\mu_{1})\geq r_{t}(f)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{t}(\mu_{1})\geq r_{t}(f)</annotation></semantics></math>.
Let <math id="chapter11.A5.p1.m12" class="ltx_Math" alttext="C_{0}=r_{t}(\mu_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{0}=r_{t}(\mu_{1})</annotation></semantics></math>. Then, for any <math id="chapter11.A5.p1.m13" class="ltx_Math" alttext="f\in{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{t}</annotation></semantics></math>, we have <math id="chapter11.A5.p1.m14" class="ltx_Math" alttext="{\left\|f\right\|}_{{P_{\mathcal{X}}}}\leq\sqrt{C_{0}}{\left\|f\right\|}_{{\mathcal{H}}_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>≤</mo><mrow><msqrt><msub><mi>C</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{P_{\mathcal{X}}}}\leq\sqrt{C_{0}}{\left\|f\right\|}_{{\mathcal{H}}_{t}}</annotation></semantics></math>.
In other words, <math id="chapter11.A5.p1.m15" class="ltx_Math" alttext="{\left\|\cdot\right\|}_{{\mathcal{H}}_{t}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">{\left\|\cdot\right\|}_{{\mathcal{H}}_{t}}</annotation></semantics></math> is a stronger norm than <math id="chapter11.A5.p1.m16" class="ltx_Math" alttext="{\left\|\cdot\right\|}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><annotation encoding="application/x-tex">{\left\|\cdot\right\|}_{{P_{\mathcal{X}}}}</annotation></semantics></math> on <math id="chapter11.A5.p1.m17" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math>.
Thus, for any sequence <math id="chapter11.A5.p1.m18" class="ltx_Math" alttext="(h_{i})\in{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">(h_{i})\in{\mathcal{H}}_{t}</annotation></semantics></math> such that <math id="chapter11.A5.p1.m19" class="ltx_Math" alttext="{\left\|h_{i}-h\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><mi>h</mi></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0</annotation></semantics></math>: first, we have <math id="chapter11.A5.p1.m20" class="ltx_Math" alttext="h\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">h\in{{\mathcal{H}}_{k}}</annotation></semantics></math> because <math id="chapter11.A5.p1.m21" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> is a Hilbert space; second, we have <math id="chapter11.A5.p1.m22" class="ltx_Math" alttext="{\left\|h_{i}-h\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><mi>h</mi></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0</annotation></semantics></math>.
Similarly, if <math id="chapter11.A5.p1.m23" class="ltx_Math" alttext="{\left\|h_{i}-h^{\prime}\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h^{\prime}\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0</annotation></semantics></math>, then <math id="chapter11.A5.p1.m24" class="ltx_Math" alttext="{\left\|h_{i}-h^{\prime}\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h^{\prime}\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A5.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p2.1" class="ltx_p">Consider the inclusion map <math id="chapter11.A5.p2.m1" class="ltx_Math" alttext="I:{\mathcal{H}}_{t}\rightarrow{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">I:{\mathcal{H}}_{t}\rightarrow{{\mathcal{H}}_{k}}</annotation></semantics></math>, where <math id="chapter11.A5.p2.m2" class="ltx_Math" alttext="Ih=h" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>=</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">Ih=h</annotation></semantics></math>.
For any sequence <math id="chapter11.A5.p2.m3" class="ltx_Math" alttext="(h_{i})\in{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">(h_{i})\in{\mathcal{H}}_{t}</annotation></semantics></math> such that <math id="chapter11.A5.p2.m4" class="ltx_Math" alttext="{\left\|h_{i}-h\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><mi>h</mi></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0</annotation></semantics></math> and <math id="chapter11.A5.p2.m5" class="ltx_Math" alttext="{\left\|h_{i}-h^{\prime}\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|h_{i}-h^{\prime}\right\|}_{{{\mathcal{H}}_{k}}}\rightarrow 0</annotation></semantics></math>, <math id="chapter11.A5.p2.m6" class="ltx_Math" alttext="h_{i}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>i</mi></msub><annotation encoding="application/x-tex">h_{i}</annotation></semantics></math> converges to both <math id="chapter11.A5.p2.m7" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> and <math id="chapter11.A5.p2.m8" class="ltx_Math" alttext="h^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>′</mo></msup><annotation encoding="application/x-tex">h^{\prime}</annotation></semantics></math> under <math id="chapter11.A5.p2.m9" class="ltx_Math" alttext="{\left\|\cdot\right\|}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><annotation encoding="application/x-tex">{\left\|\cdot\right\|}_{{P_{\mathcal{X}}}}</annotation></semantics></math>, so we must have <math id="chapter11.A5.p2.m10" class="ltx_Math" alttext="h^{\prime}=h=Ih" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>′</mo></msup><mo>=</mo><mi>h</mi><mo>=</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">h^{\prime}=h=Ih</annotation></semantics></math>.
This means that the graph of <math id="chapter11.A5.p2.m11" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> is closed, so the closed graph theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>, Chapter 2]</cite> guarantees that <math id="chapter11.A5.p2.m12" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> must be a bounded operator, meaning that there exists a constant <math id="chapter11.A5.p2.m13" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that <math id="chapter11.A5.p2.m14" class="ltx_Math" alttext="{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq C{\left\|f\right\|}_{{\mathcal{H}}_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq C{\left\|f\right\|}_{{\mathcal{H}}_{t}}</annotation></semantics></math> for all <math id="chapter11.A5.p2.m15" class="ltx_Math" alttext="f\in{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{t}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A5.p3" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p3.1" class="ltx_p">Let <math id="chapter11.A5.p3.m1" class="ltx_Math" alttext="\delta_{x}:f\mapsto f(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>x</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>f</mi><mo stretchy="false">↦</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{x}:f\mapsto f(x)</annotation></semantics></math> be the evaluation functional at point <math id="chapter11.A5.p3.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
Since <math id="chapter11.A5.p3.m3" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> is an RKHS, there exists a constant <math id="chapter11.A5.p3.m4" class="ltx_Math" alttext="M_{x}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>x</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{x}&gt;0</annotation></semantics></math> such that <math id="chapter11.A5.p3.m5" class="ltx_Math" alttext="|f(x)|\leq M_{x}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">|f(x)|\leq M_{x}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}</annotation></semantics></math> for all <math id="chapter11.A5.p3.m6" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{k}}</annotation></semantics></math>.
Thus, for any <math id="chapter11.A5.p3.m7" class="ltx_Math" alttext="f\in{\mathcal{H}}_{t}\subset{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{t}\subset{{\mathcal{H}}_{k}}</annotation></semantics></math>, we have <math id="chapter11.A5.p3.m8" class="ltx_Math" alttext="|f(x)|\leq M_{x}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq M_{x}C{\left\|f\right\|}_{{\mathcal{H}}_{t}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">|f(x)|\leq M_{x}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq M_{x}C{\left\|f\right\|}_{{\mathcal{H}}_{t}}</annotation></semantics></math>. Thus, by <a href="#chapter5.Thmtheorem20" title="Proposition 5.20. ‣ 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">5.20</span></a>, <math id="chapter11.A5.p3.m9" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math> is also an RKHS.
Let <math id="chapter11.A5.p3.m10" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math> be the reproducing kernel of <math id="chapter11.A5.p3.m11" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math>.
From now on, we will use <math id="chapter11.A5.p3.m12" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math> to denote <math id="chapter11.A5.p3.m13" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A5.p4" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p4.1" class="ltx_p">Second, we prove by induction that <math id="chapter11.A5.p4.m1" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d}</annotation></semantics></math> are the top-<math id="chapter11.A5.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="chapter11.A5.p4.m3" class="ltx_Math" alttext="T_{{k_{s}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">T_{{k_{s}}}</annotation></semantics></math>, and <math id="chapter11.A5.p4.m4" class="ltx_Math" alttext="{\left\langle\mu_{i},\mu_{j}\right\rangle}_{{{\mathcal{H}}_{{k_{s}}}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>j</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\langle\mu_{i},\mu_{j}\right\rangle}_{{{\mathcal{H}}_{{k_{s}}}}}=0</annotation></semantics></math> for any <math id="chapter11.A5.p4.m5" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>.
We have already shown that <math id="chapter11.A5.p4.m6" class="ltx_Math" alttext="\mu_{1}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mu_{1}</annotation></semantics></math> maximizes <math id="chapter11.A5.p4.m7" class="ltx_Math" alttext="r_{{{\mathcal{H}}_{{k_{s}}}}}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{{{\mathcal{H}}_{{k_{s}}}}}(f)</annotation></semantics></math> over all <math id="chapter11.A5.p4.m8" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.
Thus, <math id="chapter11.A5.p4.m9" class="ltx_Math" alttext="\mu_{1}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mu_{1}</annotation></semantics></math> must be the top-<math id="chapter11.A5.p4.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> eigenfunction of <math id="chapter11.A5.p4.m11" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.
Suppose <math id="chapter11.A5.p4.m12" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>, and <math id="chapter11.A5.p4.m13" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d-1}</annotation></semantics></math> are the top-<math id="chapter11.A5.p4.m14" class="ltx_Math" alttext="(d-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d-1)</annotation></semantics></math> eigenfunctions and are orthogonal to each other in <math id="chapter11.A5.p4.m15" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.
Let <math id="chapter11.A5.p4.m16" class="ltx_math_unparsed" alttext="{\mathcal{H}}_{0}={\left\{h\;\middle|\;\forall i\in[d-1]:{\left\langle h,\mu_{i}\right\rangle}_{{P_{\mathcal{X}}}}=0\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub><mo>=</mo><mrow><mo>{</mo><mi>h</mi><mo rspace="0.447em" stretchy="true">|</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo>−</mo><mn>1</mn><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><msub><mrow><mo>⟨</mo><mi>h</mi><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{0}={\left\{h\;\middle|\;\forall i\in[d-1]:{\left\langle h,\mu_{i}\right\rangle}_{{P_{\mathcal{X}}}}=0\right\}}</annotation></semantics></math>.
Obviously, <math id="chapter11.A5.p4.m17" class="ltx_Math" alttext="{\mathcal{H}}_{0}\cap{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{0}\cap{\mathcal{H}}_{k^{p}}</annotation></semantics></math> is a closed subspace of <math id="chapter11.A5.p4.m18" class="ltx_Math" alttext="{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{p}}</annotation></semantics></math> for any <math id="chapter11.A5.p4.m19" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>.
Moreover, for any <math id="chapter11.A5.p4.m20" class="ltx_Math" alttext="f\in{\mathcal{H}}_{0}\cap{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{0}\cap{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math> and any <math id="chapter11.A5.p4.m21" class="ltx_Math" alttext="i\in[d-1]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d-1]</annotation></semantics></math>, we have <math id="chapter11.A5.p4.m22" class="ltx_Math" alttext="{\left\langle f,\mu_{i}\right\rangle}_{{{\mathcal{H}}_{{k_{s}}}}}=s_{i}^{-1}{\left\langle f,\mu_{i}\right\rangle}_{{P_{\mathcal{X}}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></msub><mo>=</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\langle f,\mu_{i}\right\rangle}_{{{\mathcal{H}}_{{k_{s}}}}}=s_{i}^{-1}{\left\langle f,\mu_{i}\right\rangle}_{{P_{\mathcal{X}}}}=0</annotation></semantics></math>, where <math id="chapter11.A5.p4.m23" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math> is the eigenvalue of <math id="chapter11.A5.p4.m24" class="ltx_Math" alttext="T_{{k_{s}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">T_{{k_{s}}}</annotation></semantics></math> corresponding to <math id="chapter11.A5.p4.m25" class="ltx_Math" alttext="\mu_{i}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mu_{i}</annotation></semantics></math>.
Thus, <math id="chapter11.A5.p4.m26" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}\cap{\mathcal{H}}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}\cap{\mathcal{H}}_{0}</annotation></semantics></math> is a closed subspace of <math id="chapter11.A5.p4.m27" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.
By the condition of preserving relative smoothness, <math id="chapter11.A5.p4.m28" class="ltx_Math" alttext="\mu_{d}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mu_{d}</annotation></semantics></math> maximizes <math id="chapter11.A5.p4.m29" class="ltx_Math" alttext="r_{{{\mathcal{H}}_{{k_{s}}}}}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{{{\mathcal{H}}_{{k_{s}}}}}(f)</annotation></semantics></math> over <math id="chapter11.A5.p4.m30" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{{k_{s}}}}\cap{\mathcal{H}}_{0}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{{k_{s}}}}\cap{\mathcal{H}}_{0}</annotation></semantics></math>. Thus, <math id="chapter11.A5.p4.m31" class="ltx_Math" alttext="\mu_{d}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mu_{d}</annotation></semantics></math> is the <math id="chapter11.A5.p4.m32" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-th eigenfunction of <math id="chapter11.A5.p4.m33" class="ltx_Math" alttext="T_{{k_{s}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">T_{{k_{s}}}</annotation></semantics></math>, and is orthogonal to <math id="chapter11.A5.p4.m34" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d-1}</annotation></semantics></math> in <math id="chapter11.A5.p4.m35" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A5.p5" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p5.1" class="ltx_p">Third, we prove by contradiction that <math id="chapter11.A5.p5.m1" class="ltx_Math" alttext="s_{i}\leq M\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">s_{i}\leq M\lambda_{i}</annotation></semantics></math> for all <math id="chapter11.A5.p5.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
If this is false, then obviously one can find <math id="chapter11.A5.p5.m3" class="ltx_Math" alttext="t_{1}&lt;t_{2}&lt;\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>t</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">t_{1}&lt;t_{2}&lt;\cdots</annotation></semantics></math> such that <math id="chapter11.A5.p5.m4" class="ltx_Math" alttext="s_{t_{i}}\geq 1\cdot\lambda_{t_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo>≥</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>λ</mi><msub><mi>t</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">s_{t_{i}}\geq 1\cdot\lambda_{t_{i}}</annotation></semantics></math> for all <math id="chapter11.A5.p5.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
Consider <math id="chapter11.A5.p5.m6" class="ltx_Math" alttext="f=\sum_{i=1}^{\infty}\sqrt{i^{-1}\cdot\lambda_{t_{i}}}\mu_{t_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msqrt><mrow><msup><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>λ</mi><msub><mi>t</mi><mi>i</mi></msub></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><msub><mi>t</mi><mi>i</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum_{i=1}^{\infty}\sqrt{i^{-1}\cdot\lambda_{t_{i}}}\mu_{t_{i}}</annotation></semantics></math>.
Then, <math id="chapter11.A5.p5.m7" class="ltx_Math" alttext="{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum_{i}i^{-1}=+\infty" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msup><mi>i</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum_{i}i^{-1}=+\infty</annotation></semantics></math>.
Since <math id="chapter11.A5.p5.m8" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}\subset{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}\subset{{\mathcal{H}}_{k}}</annotation></semantics></math>, this implies that <math id="chapter11.A5.p5.m9" class="ltx_Math" alttext="{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}=+\infty=\sum_{i}\frac{\lambda_{t_{i}}}{i\cdot s_{t_{i}}}\leq\sum_{i}\frac{1}{i^{2}}&lt;+\infty" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mfrac><msub><mi>λ</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mrow><mi>i</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>s</mi><msub><mi>t</mi><mi>i</mi></msub></msub></mrow></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mfrac><mn>1</mn><msup><mi>i</mi><mn>2</mn></msup></mfrac></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}=+\infty=\sum_{i}\frac{\lambda_{t_{i}}}{i\cdot s_{t_{i}}}\leq\sum_{i}\frac{1}{i^{2}}&lt;+\infty</annotation></semantics></math>, which is a contradiction.</p>
</div>
<div id="chapter11.A5.p6" class="ltx_para ltx_noindent">
<p id="chapter11.A5.p6.1" class="ltx_p">Fourth, we find a function <math id="chapter11.A5.p6.m1" class="ltx_Math" alttext="s(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)</annotation></semantics></math> that satisfies the conditions in the theorem to interpolate <math id="chapter11.A5.p6.m2" class="ltx_Math" alttext="(\lambda_{i},s_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{i},s_{i})</annotation></semantics></math> for all <math id="chapter11.A5.p6.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
We first point out that we can without loss of generality assume that <math id="chapter11.A5.p6.m4" class="ltx_Math" alttext="\lambda_{i}&lt;2\lambda_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i}&lt;2\lambda_{i+1}</annotation></semantics></math> for all <math id="chapter11.A5.p6.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>:
If there is an <math id="chapter11.A5.p6.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> that does not satisfy this condition, we simply insert some new <math id="chapter11.A5.p6.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>’s between <math id="chapter11.A5.p6.m8" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> and <math id="chapter11.A5.p6.m9" class="ltx_Math" alttext="\lambda_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i+1}</annotation></semantics></math>,
whose corresponding <math id="chapter11.A5.p6.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>’s are the linear interpolations between <math id="chapter11.A5.p6.m11" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math> and <math id="chapter11.A5.p6.m12" class="ltx_Math" alttext="s_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{i+1}</annotation></semantics></math>, so that <math id="chapter11.A5.p6.m13" class="ltx_Math" alttext="s_{i}\leq M\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">s_{i}\leq M\lambda_{i}</annotation></semantics></math> still holds.
With this assumption, it suffices to construct a series of bump functions <math id="chapter11.A5.p6.m14" class="ltx_Math" alttext="\{f_{i}\}_{i=1}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\{f_{i}\}_{i=1}^{\infty}</annotation></semantics></math>,
where <math id="chapter11.A5.p6.m15" class="ltx_Math" alttext="f_{i}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}\equiv 0</annotation></semantics></math> if <math id="chapter11.A5.p6.m16" class="ltx_Math" alttext="\lambda_{i}=\lambda_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\lambda_{i}=\lambda_{i+1}</annotation></semantics></math>;
otherwise, <math id="chapter11.A5.p6.m17" class="ltx_Math" alttext="f_{i}(\lambda)=s_{i}-s_{i+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>−</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">f_{i}(\lambda)=s_{i}-s_{i+1}</annotation></semantics></math> for <math id="chapter11.A5.p6.m18" class="ltx_Math" alttext="\lambda\geq\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\lambda\geq\lambda_{i}</annotation></semantics></math> and <math id="chapter11.A5.p6.m19" class="ltx_Math" alttext="f_{i}(\lambda)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}(\lambda)=0</annotation></semantics></math> for <math id="chapter11.A5.p6.m20" class="ltx_Math" alttext="\lambda\leq\lambda_{i+1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≤</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\lambda\leq\lambda_{i+1}</annotation></semantics></math>.
Such bump functions are <math id="chapter11.A5.p6.m21" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> and monotonically non-decreasing.
Then, define <math id="chapter11.A5.p6.m22" class="ltx_Math" alttext="s(\lambda)=\sum_{i}f_{i}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)=\sum_{i}f_{i}(\lambda)</annotation></semantics></math> for <math id="chapter11.A5.p6.m23" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>, and <math id="chapter11.A5.p6.m24" class="ltx_Math" alttext="s(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s(0)=0</annotation></semantics></math>.
This sum of bump functions converges everywhere on <math id="chapter11.A5.p6.m25" class="ltx_Math" alttext="(0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,+\infty)</annotation></semantics></math>, since it is a finite sum locally everywhere.
Clearly this <math id="chapter11.A5.p6.m26" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is monotonic, interpolates all the points, continuous on <math id="chapter11.A5.p6.m27" class="ltx_math_unparsed" alttext="[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,+\infty)</annotation></semantics></math> and <math id="chapter11.A5.p6.m28" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> on <math id="chapter11.A5.p6.m29" class="ltx_Math" alttext="(0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,+\infty)</annotation></semantics></math>.
And for all <math id="chapter11.A5.p6.m30" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> that is not <math id="chapter11.A5.p6.m31" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math>, for instance <math id="chapter11.A5.p6.m32" class="ltx_Math" alttext="\lambda\in(\lambda_{i+1},\lambda_{i})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in(\lambda_{i+1},\lambda_{i})</annotation></semantics></math>,
there is <math id="chapter11.A5.p6.m33" class="ltx_Math" alttext="s(\lambda)\leq s(\lambda_{i})\leq M\lambda_{i}\leq 2M\lambda_{i+1}\leq 2M\lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)\leq s(\lambda_{i})\leq M\lambda_{i}\leq 2M\lambda_{i+1}\leq 2M\lambda</annotation></semantics></math>.
Thus, <math id="chapter11.A5.p6.m34" class="ltx_Math" alttext="s(\lambda)=O(\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)=O(\lambda)</annotation></semantics></math> for <math id="chapter11.A5.p6.m35" class="ltx_math_unparsed" alttext="\lambda\in[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[0,+\infty)</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.Thmtheorem4" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem4.2" class="ltx_text ltx_font_bold">Remark 11.4</span></span><span id="chapter11.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem4.p1" class="ltx_para">
<p id="chapter11.Thmtheorem4.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">In general, we cannot guarantee that <math id="chapter11.Thmtheorem4.p1.m1" class="ltx_Math" alttext="s(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)</annotation></semantics></math> is differentiable at <math id="chapter11.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math>.
Here is a counterexample: <math id="chapter11.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\lambda_{i}=3^{-i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><msup><mn>3</mn><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda_{i}=3^{-i}</annotation></semantics></math>, and <math id="chapter11.Thmtheorem4.p1.m4" class="ltx_Math" alttext="s_{i}=3^{-i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>=</mo><msup><mn>3</mn><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{i}=3^{-i}</annotation></semantics></math> if <math id="chapter11.Thmtheorem4.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is odd and <math id="chapter11.Thmtheorem4.p1.m6" class="ltx_Math" alttext="2\cdot 3^{-i}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>3</mn><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">2\cdot 3^{-i}</annotation></semantics></math> if <math id="chapter11.Thmtheorem4.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is even.
Were <math id="chapter11.Thmtheorem4.p1.m8" class="ltx_Math" alttext="s(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)</annotation></semantics></math> to be differentiable at <math id="chapter11.Thmtheorem4.p1.m9" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math>, its derivative would be <math id="chapter11.Thmtheorem4.p1.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and also would be <math id="chapter11.Thmtheorem4.p1.m11" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, a contradiction.</span></p>
</div>
</div>
</section>
<section id="chapter11.A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.F </span>Proof of Theorem <a href="#chapter5.Thmtheorem25" title="Theorem 5.25 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.25</span></a></h2>

<div id="chapter11.A6.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p1.1" class="ltx_p"><span id="chapter11.A6.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter11.A6.p1.m1" class="ltx_Math" alttext="\hat{\lambda}_{1}\geq\cdots\geq\hat{\lambda}_{m+n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{1}\geq\cdots\geq\hat{\lambda}_{m+n}</annotation></semantics></math> be the eigenvalues of <math id="chapter11.A6.p1.m2" class="ltx_Math" alttext="\frac{{\bm{G}}_{k}}{m+n}" display="inline" intent=":literal"><semantics><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><annotation encoding="application/x-tex">\frac{{\bm{G}}_{k}}{m+n}</annotation></semantics></math>.
It is easy to show that <math id="chapter11.A6.p1.m3" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi>𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math> has the same eigenvectors as <math id="chapter11.A6.p1.m4" class="ltx_Math" alttext="\frac{{\bm{G}}_{k}}{m+n}" display="inline" intent=":literal"><semantics><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><annotation encoding="application/x-tex">\frac{{\bm{G}}_{k}}{m+n}</annotation></semantics></math>, with eigenvalues <math id="chapter11.A6.p1.m5" class="ltx_Math" alttext="g(\hat{\lambda}_{1}),\cdots,g(\hat{\lambda}_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(\hat{\lambda}_{1}),\cdots,g(\hat{\lambda}_{2})</annotation></semantics></math>.
By <a href="#chapter5.Thmtheorem29" title="Lemma 5.29 ([], Theorem 2). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.29</span></a> and Borel-Cantelli lemma, as <math id="chapter11.A6.p1.m6" class="ltx_Math" alttext="n\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\rightarrow\infty</annotation></semantics></math>, <math id="chapter11.A6.p1.m7" class="ltx_Math" alttext="\hat{\lambda}_{1}\xrightarrow{\textit{a.s.}}\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mover accent="true"><mo>→</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em">a.s.</mtext></mover><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{1}\xrightarrow{\textit{a.s.}}\lambda_{1}</annotation></semantics></math>.
For simplicity, let us assume that <math id="chapter11.A6.p1.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is slightly larger than <math id="chapter11.A6.p1.m9" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math>, so almost surely there is <math id="chapter11.A6.p1.m10" class="ltx_Math" alttext="\hat{\lambda}_{1}\leq\lambda" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>≤</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{1}\leq\lambda</annotation></semantics></math>.
Then, all eigenvalues of <math id="chapter11.A6.p1.m11" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi>𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math> are in <math id="chapter11.A6.p1.m12" class="ltx_Math" alttext="[\rho_{\min},\rho_{\max}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>ρ</mi><mi>min</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\rho_{\min},\rho_{\max}]</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A6.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p2.2" class="ltx_p">The first part of this proof is to bound <math id="chapter11.A6.p2.m1" class="ltx_Math" alttext="{\left\|{\bm{u}}_{t}\right\|}_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msub><mi>𝒖</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">{\left\|{\bm{u}}_{t}\right\|}_{2}</annotation></semantics></math>, where <math id="chapter11.A6.p2.m2" class="ltx_Math" alttext="{\bm{u}}_{t}:=(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mi>t</mi></msub><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}_{t}:=(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})</annotation></semantics></math>.
Let <math id="chapter11.A6.p2.m3" class="ltx_Math" alttext="{\bm{\theta}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{t}</annotation></semantics></math> be the <math id="chapter11.A6.p2.m4" class="ltx_Math" alttext="{\bm{\theta}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">{\bm{\theta}}</annotation></semantics></math> at iteration <math id="chapter11.A6.p2.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, and <math id="chapter11.A6.p2.m6" class="ltx_Math" alttext="{\bm{\theta}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{*}</annotation></semantics></math> be the optimal solution. Since <math id="chapter11.A6.p2.m7" class="ltx_Math" alttext="{\bm{\theta}}_{0}={\bm{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜽</mi><mn>0</mn></msub><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{\theta}}_{0}={\bm{0}}</annotation></semantics></math>, we have</p>
<table id="chapter11.A6.E41" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter11.A6.E41X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.E41X.m2" class="ltx_Math" alttext="\displaystyle{\bm{\theta}}_{*}-{\bm{\theta}}_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\theta}}_{*}-{\bm{\theta}}_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.E41X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\left[{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\bm{\theta}}_{*}+\gamma\tilde{{\bm{y}}}\right]}" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\left[{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\bm{\theta}}_{*}+\gamma\tilde{{\bm{y}}}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(41)</span></td></tr>
<tr id="chapter11.A6.E41Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.E41Xa.m2" class="ltx_Math" alttext="\displaystyle-{\left[{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\bm{\theta}}_{t-1}+\gamma\tilde{{\bm{y}}}\right]}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-{\left[{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\bm{\theta}}_{t-1}+\gamma\tilde{{\bm{y}}}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter11.A6.E41Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.E41Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.E41Xb.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\left({\bm{\theta}}_{*}-{\bm{\theta}}_{t-1}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}{\left({\bm{\theta}}_{*}-{\bm{\theta}}_{t-1}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter11.A6.E41Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.E41Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.E41Xc.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}^{t}{\bm{\theta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}^{t}{\bm{\theta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A6.p3" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p3.1" class="ltx_p">Note that</p>
<table id="chapter11.A6.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A6.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex184.m1" class="ltx_Math" alttext="\displaystyle{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}}\right]}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex185.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex185.m2" class="ltx_Math" alttext="\displaystyle{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}+n\beta_{n}{\bm{Q}}\right]}\right)}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left({\bm{I}}_{m+n}-\gamma{\left[(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}+n\beta_{n}{\bm{Q}}\right]}\right)}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A6.p4" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p4.1" class="ltx_p">Thus, by propagating <math id="chapter11.A6.p4.m1" class="ltx_Math" alttext="{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}</annotation></semantics></math> from left to right, we get</p>
<table id="chapter11.A6.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex186.m1" class="ltx_Math" alttext="{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})={\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})={\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p4.2" class="ltx_p">where <math id="chapter11.A6.p4.m2" class="ltx_Math" alttext="{\bm{R}}:=(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}+n\beta_{n}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo>:=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}:=(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}+n\beta_{n}{\bm{Q}}</annotation></semantics></math> is a <span id="chapter11.A6.p4.2.1" class="ltx_text ltx_font_italic">p.s.d.</span> matrix.
Denote the smallest and largest eigenvalues of <math id="chapter11.A6.p4.m3" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> by <math id="chapter11.A6.p4.m4" class="ltx_Math" alttext="\tilde{\lambda}_{\min}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>min</mi></msub><annotation encoding="application/x-tex">\tilde{\lambda}_{\min}</annotation></semantics></math> and <math id="chapter11.A6.p4.m5" class="ltx_Math" alttext="\tilde{\lambda}_{\max}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>max</mi></msub><annotation encoding="application/x-tex">\tilde{\lambda}_{\max}</annotation></semantics></math>.
Then, <math id="chapter11.A6.p4.m6" class="ltx_Math" alttext="\tilde{\lambda}_{\min}\geq n\beta_{n}\rho_{\min}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>min</mi></msub><mo>≥</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\lambda}_{\min}\geq n\beta_{n}\rho_{\min}</annotation></semantics></math>.
In terms of <math id="chapter11.A6.p4.m7" class="ltx_Math" alttext="\tilde{\lambda}_{\max}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>max</mi></msub><annotation encoding="application/x-tex">\tilde{\lambda}_{\max}</annotation></semantics></math>, we have</p>
<table id="chapter11.A6.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex187.m1" class="ltx_Math" alttext="(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}={\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{\frac{r-1}{2}}{\left({\bm{G}}_{k}^{\frac{1}{2}}\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}^{\frac{1}{2}}\right)}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{\frac{r-1}{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mfrac><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑮</mi><mi>k</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mfrac><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}={\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{\frac{r-1}{2}}{\left({\bm{G}}_{k}^{\frac{1}{2}}\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}^{\frac{1}{2}}\right)}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{\frac{r-1}{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A6.p5" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p5.1" class="ltx_p">By Sylvester’s theorem, all non-zero eigenvalues of <math id="chapter11.A6.p5.m1" class="ltx_Math" alttext="{\bm{G}}_{k}^{\frac{1}{2}}\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑮</mi><mi>k</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup></mrow><annotation encoding="application/x-tex">{\bm{G}}_{k}^{\frac{1}{2}}\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}^{\frac{1}{2}}</annotation></semantics></math> are the eigenvalues of <math id="chapter11.A6.p5.m2" class="ltx_Math" alttext="\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}\tilde{{\bm{I}}}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{{\bm{I}}}_{n}{\bm{G}}_{k}\tilde{{\bm{I}}}_{n}</annotation></semantics></math>,
<span id="chapter11.A6.p5.1.1" class="ltx_text ltx_font_italic">i.e.</span> the non-zero eigenvalues of <math id="chapter11.A6.p5.m3" class="ltx_Math" alttext="{\bm{G}}_{K,n}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mrow><mi>K</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{G}}_{K,n}</annotation></semantics></math>.
By <a href="#chapter5.Thmtheorem29" title="Lemma 5.29 ([], Theorem 2). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.29</span></a>, <math id="chapter11.A6.p5.m4" class="ltx_Math" alttext="\frac{1}{n}{\left\|{\bm{G}}_{K,n}\right\|}_{2}\xrightarrow{\textit{a.s.}}\lambda_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>𝑮</mi><mrow><mi>K</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mover accent="true"><mo>→</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em">a.s.</mtext></mover><msub><mi>λ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\frac{1}{n}{\left\|{\bm{G}}_{K,n}\right\|}_{2}\xrightarrow{\textit{a.s.}}\lambda_{1}</annotation></semantics></math>,
so suppose <math id="chapter11.A6.p5.m5" class="ltx_Math" alttext="{\left\|{\bm{G}}_{K,n}\right\|}_{2}\leq n\lambda" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝑮</mi><mrow><mi>K</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{G}}_{K,n}\right\|}_{2}\leq n\lambda</annotation></semantics></math>.
Then, <math id="chapter11.A6.p5.m6" class="ltx_Math" alttext="\tilde{\lambda}_{\max}\leq n\lambda^{r}+n\beta_{n}\rho_{\max}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>max</mi></msub><mo>≤</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\lambda}_{\max}\leq n\lambda^{r}+n\beta_{n}\rho_{\max}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A6.p6" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p6.1" class="ltx_p">Since <math id="chapter11.A6.p6.m1" class="ltx_Math" alttext="{\bm{M}}{\bm{\theta}}_{*}=\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{M}}{\bm{\theta}}_{*}=\tilde{{\bm{y}}}</annotation></semantics></math>, and <math id="chapter11.A6.p6.m2" class="ltx_Math" alttext="{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{M}}={\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi></mrow><mo>=</mo><mrow><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{M}}={\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}</annotation></semantics></math>, we have <math id="chapter11.A6.p6.m3" class="ltx_Math" alttext="{\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}={\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}={\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}</annotation></semantics></math>.
Note that <math id="chapter11.A6.p6.m4" class="ltx_Math" alttext="{\bm{R}}({\bm{I}}_{m+n}-\gamma{\bm{R}})=({\bm{I}}_{m+n}-\gamma{\bm{R}}){\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}({\bm{I}}_{m+n}-\gamma{\bm{R}})=({\bm{I}}_{m+n}-\gamma{\bm{R}}){\bm{R}}</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter11.A6.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A6.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex188.m1" class="ltx_Math" alttext="\displaystyle{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex188.m2" class="ltx_Math" alttext="\displaystyle={\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex189.m1" class="ltx_Math" alttext="\displaystyle={\bm{R}}^{-1}({\bm{I}}_{m+n}-\gamma{\bm{R}})^{t}{\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝑹</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{R}}^{-1}({\bm{I}}_{m+n}-\gamma{\bm{R}})^{t}{\bm{R}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{\theta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
