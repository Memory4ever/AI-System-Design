              <span id="alg4.l3.3" class="ltx_text ltx_font_bold">while</span> True <span id="alg4.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
              <span id="alg4.l4.3" class="ltx_text ltx_font_italic"># Compute <math id="alg4.l4.m1" class="ltx_Math" alttext="{\bm{u}}={\bm{M}}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>=</mo><mrow><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝛉</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}={\bm{M}}{\bm{\theta}}</annotation></semantics></math></span>

</div>
<div id="alg4.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
               <math id="alg4.l5.m1" class="ltx_Math" alttext="{\bm{v}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}</annotation></semantics></math>

</div>
<div id="alg4.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
               <span id="alg4.l6.3" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l6.m1" class="ltx_Math" alttext="p=q-1,\cdots,0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>=</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=q-1,\cdots,0</annotation></semantics></math> <span id="alg4.l6.4" class="ltx_text ltx_font_bold">do</span> <math id="alg4.l6.m2" class="ltx_Math" alttext="{\bm{v}}\leftarrow\frac{{\bm{G}}_{k}{\bm{v}}}{m+n}+\xi_{p}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo stretchy="false">←</mo><mrow><mfrac><mrow><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>+</mo><mrow><msub><mi>ξ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}\leftarrow\frac{{\bm{G}}_{k}{\bm{v}}}{m+n}+\xi_{p}{\bm{\theta}}</annotation></semantics></math>

</div>
<div id="alg4.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
                
                
               <math id="alg4.l7.m1" class="ltx_math_unparsed" alttext="{\bm{u}}\leftarrow{\left[{\left(\frac{{\bm{G}}_{k}^{r}}{(m+n)^{r-1}}{\bm{\theta}}\right)}[1:n],{\bm{0}}_{m}\right]}^{\top}+n\beta_{n}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo stretchy="false">←</mo><msup><mrow><mo>[</mo><mrow><mo>(</mo><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mi>r</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac><mi>𝜽</mi><mo>)</mo></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><msub><mn>𝟎</mn><mi>m</mi></msub><mo>]</mo></mrow><mo>⊤</mo></msup><mo>+</mo><mi>n</mi><msub><mi>β</mi><mi>n</mi></msub><mi>𝒗</mi></mrow><annotation encoding="application/x-tex">{\bm{u}}\leftarrow{\left[{\left(\frac{{\bm{G}}_{k}^{r}}{(m+n)^{r-1}}{\bm{\theta}}\right)}[1:n],{\bm{0}}_{m}\right]}^{\top}+n\beta_{n}{\bm{v}}</annotation></semantics></math>

</div>
<div id="alg4.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
               <math id="alg4.l8.m1" class="ltx_Math" alttext="{\bm{a}}\leftarrow{\bm{u}}-\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒂</mi><mo stretchy="false">←</mo><mrow><mi>𝒖</mi><mo>−</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">{\bm{a}}\leftarrow{\bm{u}}-\tilde{{\bm{y}}}</annotation></semantics></math>, <math id="alg4.l8.m2" class="ltx_Math" alttext="{\bm{\theta}}\leftarrow{\bm{\theta}}-\gamma{\bm{a}}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo stretchy="false">←</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒂</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\theta}}\leftarrow{\bm{\theta}}-\gamma{\bm{a}}</annotation></semantics></math>

</div>
<div id="alg4.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                
                
               <span id="alg4.l9.3" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l9.m1" class="ltx_Math" alttext="\|{\bm{a}}\|_{2}&lt;\epsilon\|{\bm{y}}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝒂</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\bm{a}}\|_{2}&lt;\epsilon\|{\bm{y}}\|_{2}</annotation></semantics></math> <span id="alg4.l9.4" class="ltx_text ltx_font_bold">then return</span> <math id="alg4.l9.m2" class="ltx_Math" alttext="{\bm{\theta}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">{\bm{\theta}}</annotation></semantics></math>

</div>
</div>
</figure></div></div>
</figure>
<div id="S22.p7" class="ltx_para ltx_noindent">
<p id="S22.p7.1" class="ltx_p">The next question is, given <math id="S22.p7.m1" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}</annotation></semantics></math>, how to efficiently compute <math id="S22.p7.m2" class="ltx_Math" alttext="\hat{f}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x)</annotation></semantics></math> for a test input <math id="S22.p7.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>?
We do not want to compute <math id="S22.p7.m4" class="ltx_Math" alttext="{\bm{v}}_{{\hat{k}_{s}},n}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{{\hat{k}_{s}},n}(x)</annotation></semantics></math>, which involves another set of matrix-vector multiplications.
An efficient way is that we can store the <math id="S22.p7.m5" class="ltx_Math" alttext="{\bm{v}}" display="inline" intent=":literal"><semantics><mi>𝒗</mi><annotation encoding="application/x-tex">{\bm{v}}</annotation></semantics></math> computed in line 4 of <a href="#alg3" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">3</span></a> in the memory.
Then, <math id="S22.p7.m6" class="ltx_Math" alttext="\hat{f}(x)=\sum_{i=1}^{m+n}k(x_{i},x){\bm{v}}[i]+\pi_{1}\sum_{j=1}^{n}k(\tilde{x}_{j},x)\hat{{\bm{\alpha}}}[j]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msubsup><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x)=\sum_{i=1}^{m+n}k(x_{i},x){\bm{v}}[i]+\pi_{1}\sum_{j=1}^{n}k(\tilde{x}_{j},x)\hat{{\bm{\alpha}}}[j]</annotation></semantics></math> for any <math id="S22.p7.m7" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>, which only needs <math id="S22.p7.m8" class="ltx_Math" alttext="O(m+n)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(m+n)</annotation></semantics></math> time to compute.</p>
</div>
<div id="S22.p8" class="ltx_para ltx_noindent">
<p id="S22.p8.1" class="ltx_p">For scenario (ii) where <math id="S22.p8.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> could be complex but <math id="S22.p8.m2" class="ltx_Math" alttext="s^{-1}(\lambda)=\sum_{p=0}^{q-1}\xi_{p}\lambda^{p-r}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>ξ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mi>p</mi><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">s^{-1}(\lambda)=\sum_{p=0}^{q-1}\xi_{p}\lambda^{p-r}</annotation></semantics></math> is simple, we can no longer estimate <math id="S22.p8.m3" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}},n}{\bm{\alpha}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}},n}{\bm{\alpha}}</annotation></semantics></math>.
However, we can do the following transformation:
Let <math id="S22.p8.m4" class="ltx_Math" alttext="{\bm{Q}}=\sum_{p=0}^{q-1}\xi_{p}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>ξ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>p</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}=\sum_{p=0}^{q-1}\xi_{p}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}</annotation></semantics></math>.
Then, we have <math id="S22.p8.m5" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}}}{\bm{Q}}=(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑮</mi><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>r</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}}}{\bm{Q}}=(m+n){\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}</annotation></semantics></math>, where <math id="S22.p8.m6" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}}}\in\mathbb{R}^{(m+n)\times(m+n)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}}}\in\mathbb{R}^{(m+n)\times(m+n)}</annotation></semantics></math> is the Gram matrix of <math id="S22.p8.m7" class="ltx_Math" alttext="{\hat{k}_{s}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><annotation encoding="application/x-tex">{\hat{k}_{s}}</annotation></semantics></math> on all <math id="S22.p8.m8" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples.
Therefore, we can efficiently compute <math id="S22.p8.m9" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}}}{\bm{Q}}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}}}{\bm{Q}}{\bm{x}}</annotation></semantics></math> for any vector <math id="S22.p8.m10" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math>, and this motivates us to find a <math id="S22.p8.m11" class="ltx_Math" alttext="{\bm{\theta}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{\theta}}\in\mathbb{R}^{m+n}</annotation></semantics></math> such that <math id="S22.p8.m12" class="ltx_Math" alttext="{\bm{Q}}{\bm{\theta}}=[\hat{{\bm{\alpha}}},{\bm{0}}_{m}]^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>,</mo><msub><mn>𝟎</mn><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}{\bm{\theta}}=[\hat{{\bm{\alpha}}},{\bm{0}}_{m}]^{\top}</annotation></semantics></math>.
To solve for <math id="S22.p8.m13" class="ltx_Math" alttext="{\bm{\theta}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">{\bm{\theta}}</annotation></semantics></math>, we need <math id="S22.p8.m14" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> linear equations.
The last <math id="S22.p8.m15" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> elements of <math id="S22.p8.m16" class="ltx_Math" alttext="{\bm{Q}}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">{\bm{Q}}{\bm{\theta}}</annotation></semantics></math> are all zero, which provides us with <math id="S22.p8.m17" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> linear equations.
Since <math id="S22.p8.m18" class="ltx_Math" alttext="{\bm{A}}\hat{{\bm{\alpha}}}={\bm{y}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow><mo>=</mo><mi>𝒚</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}\hat{{\bm{\alpha}}}={\bm{y}}</annotation></semantics></math>, the first <math id="S22.p8.m19" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> elements of <math id="S22.p8.m20" class="ltx_Math" alttext="{\bm{A}}{\bm{Q}}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{Q}}{\bm{\theta}}</annotation></semantics></math> must be <math id="S22.p8.m21" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>, which provides us with another <math id="S22.p8.m22" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> linear equations.
Overall, we can find <math id="S22.p8.m23" class="ltx_Math" alttext="{\bm{\theta}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">{\bm{\theta}}</annotation></semantics></math> by solving <math id="S22.p8.m24" class="ltx_Math" alttext="{\bm{M}}\theta=\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{M}}\theta=\tilde{{\bm{y}}}</annotation></semantics></math>, where</p>
<table id="S22.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex71.m1" class="ltx_Math" alttext="{\bm{M}}=(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}},\quad\tilde{{\bm{y}}}=[{\bm{y}},{\bm{0}}_{m}]^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑴</mi><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>r</mi></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mn>𝟎</mn><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{M}}=(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}+n\beta_{n}{\bm{Q}},\quad\tilde{{\bm{y}}}=[{\bm{y}},{\bm{0}}_{m}]^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p8.2" class="ltx_p">Here, <math id="S22.p8.m25" class="ltx_Math" alttext="\tilde{{\bm{I}}}_{n}={\textnormal{diag}}{\left\{1,\cdots,1,0,\cdots,0\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{I}}}_{n}={\textnormal{diag}}{\left\{1,\cdots,1,0,\cdots,0\right\}}</annotation></semantics></math>, with <math id="S22.p8.m26" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> ones and <math id="S22.p8.m27" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> zeros.
Once again, we can solve for <math id="S22.p8.m28" class="ltx_Math" alttext="{\bm{\theta}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">{\bm{\theta}}</annotation></semantics></math> using Richardson iteration.
The algorithm is listed in <a href="#alg4" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">4</span></a>.
After running this algorithm, we can store <math id="S22.p8.m29" class="ltx_Math" alttext="{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r-1}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow><annotation encoding="application/x-tex">{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r-1}{\bm{\theta}}</annotation></semantics></math> in the memory.
Then, for any test input <math id="S22.p8.m30" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, we can compute <math id="S22.p8.m31" class="ltx_Math" alttext="\hat{f}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x)</annotation></semantics></math> with <math id="S22.p8.m32" class="ltx_Math" alttext="\hat{f}(x)={\bm{v}}_{k}(x)^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r-1}{\bm{\theta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x)={\bm{v}}_{k}(x)^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r-1}{\bm{\theta}}</annotation></semantics></math> in <math id="S22.p8.m33" class="ltx_Math" alttext="O(m+n)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(m+n)</annotation></semantics></math> time.</p>
</div>
<div id="S22.p9" class="ltx_para ltx_noindent">
<p id="S22.p9.1" class="ltx_p">Next, let us study the time complexity of these two algorithms.
Assume that computing <math id="S22.p9.m1" class="ltx_Math" alttext="k(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">k(x,x^{\prime})</annotation></semantics></math> for any <math id="S22.p9.m2" class="ltx_Math" alttext="x,x^{\prime}\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x,x^{\prime}\in{\mathcal{X}}</annotation></semantics></math> takes <math id="S22.p9.m3" class="ltx_Math" alttext="O(1)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1)</annotation></semantics></math> time.
To start with, let us review a classical result about Richardson iteration.</p>
</div>
<div id="chapter5.Thmtheorem24" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem24.2" class="ltx_text ltx_font_bold">Lemma 5.24</span></span><span id="chapter5.Thmtheorem24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem24.p1" class="ltx_para">
<p id="chapter5.Thmtheorem24.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem24.p1.1.1" class="ltx_text ltx_font_italic">Consider solving <math id="chapter5.Thmtheorem24.p1.m1" class="ltx_Math" alttext="{\bm{A}}{\bm{x}}={\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>=</mo><mi>𝐛</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{x}}={\bm{b}}</annotation></semantics></math> with Richardson iteration, where <math id="chapter5.Thmtheorem24.p1.m2" class="ltx_Math" alttext="{\bm{A}}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}\in\mathbb{R}^{n\times n}</annotation></semantics></math> is positive definite, and <math id="chapter5.Thmtheorem24.p1.m3" class="ltx_Math" alttext="{\bm{x}},{\bm{b}}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐛</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{x}},{\bm{b}}\in\mathbb{R}^{n}</annotation></semantics></math>.
Let <math id="chapter5.Thmtheorem24.p1.m4" class="ltx_Math" alttext="\lambda_{\max}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\lambda_{\max}</annotation></semantics></math> and <math id="chapter5.Thmtheorem24.p1.m5" class="ltx_Math" alttext="\lambda_{\min}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\lambda_{\min}</annotation></semantics></math> be the largest and smallest eigenvalue of <math id="chapter5.Thmtheorem24.p1.m6" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>, and let <math id="chapter5.Thmtheorem24.p1.m7" class="ltx_Math" alttext="\tau=\frac{\lambda_{\max}}{\lambda_{\min}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mfrac><msub><mi>λ</mi><mi>max</mi></msub><msub><mi>λ</mi><mi>min</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">\tau=\frac{\lambda_{\max}}{\lambda_{\min}}</annotation></semantics></math> be the condition number of <math id="chapter5.Thmtheorem24.p1.m8" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>.
Then, by choosing <math id="chapter5.Thmtheorem24.p1.m9" class="ltx_Math" alttext="\gamma=\frac{2}{\lambda_{\max}+\lambda_{\min}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>2</mn><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma=\frac{2}{\lambda_{\max}+\lambda_{\min}}</annotation></semantics></math> and setting the stop criterion as <math id="chapter5.Thmtheorem24.p1.m10" class="ltx_Math" alttext="{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}&lt;\epsilon{\left\|{\bm{b}}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>𝐛</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}&lt;\epsilon{\left\|{\bm{b}}\right\|}_{2}</annotation></semantics></math>, the iteration stops in <math id="chapter5.Thmtheorem24.p1.m11" class="ltx_Math" alttext="O{\left(\tau\log\frac{1}{\epsilon}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>τ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O{\left(\tau\log\frac{1}{\epsilon}\right)}</annotation></semantics></math> steps.</span></p>
</div>
</div>
<div id="S22.p10" class="ltx_para ltx_noindent">
<p id="S22.p10.1" class="ltx_p"><span id="S22.p10.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="S22.p10.m1" class="ltx_Math" alttext="{\bm{x}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝒙</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\bm{x}}^{*}</annotation></semantics></math> be the solution such that <math id="S22.p10.m2" class="ltx_Math" alttext="{\bm{A}}{\bm{x}}^{*}={\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mo>∗</mo></msup></mrow><mo>=</mo><mi>𝒃</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{x}}^{*}={\bm{b}}</annotation></semantics></math>.
By <math id="S22.p10.m3" class="ltx_Math" alttext="{\bm{x}}^{(t+1)}={\bm{x}}^{(t)}+\gamma({\bm{b}}-{\bm{A}}{\bm{x}}^{(t)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒃</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}^{(t+1)}={\bm{x}}^{(t)}+\gamma({\bm{b}}-{\bm{A}}{\bm{x}}^{(t)})</annotation></semantics></math>, we have <math id="S22.p10.m4" class="ltx_Math" alttext="{\bm{x}}^{(t+1)}-{\bm{x}}^{*}=({\bm{I}}_{n}-\gamma{\bm{A}})({\bm{x}}^{(t)}-{\bm{x}}^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mi>n</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}^{(t+1)}-{\bm{x}}^{*}=({\bm{I}}_{n}-\gamma{\bm{A}})({\bm{x}}^{(t)}-{\bm{x}}^{*})</annotation></semantics></math>.
If we start with <math id="S22.p10.m5" class="ltx_Math" alttext="{\bm{x}}^{(0)}={\bm{0}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{x}}^{(0)}={\bm{0}}</annotation></semantics></math>, then this implies that <math id="S22.p10.m6" class="ltx_Math" alttext="{\bm{x}}^{*}-{\bm{x}}^{(t)}=({\bm{I}}_{n}-\gamma{\bm{A}})^{t}{\bm{x}}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mi>n</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}^{*}-{\bm{x}}^{(t)}=({\bm{I}}_{n}-\gamma{\bm{A}})^{t}{\bm{x}}^{*}</annotation></semantics></math>.
When <math id="S22.p10.m7" class="ltx_Math" alttext="\gamma=\frac{2}{\lambda_{\max}+\lambda_{\min}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>2</mn><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma=\frac{2}{\lambda_{\max}+\lambda_{\min}}</annotation></semantics></math>, we have</p>
<table id="S22.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex72.m1" class="ltx_Math" alttext="{\left\|{\bm{x}}^{*}-{\bm{x}}^{(t)}\right\|}_{2}\leq{\left\|{\bm{I}}_{n}-\gamma{\bm{A}}\right\|}_{2}^{t}{\left\|{\bm{x}}^{*}\right\|}_{2}={\left(1-\frac{2\lambda_{\min}}{\lambda_{\max}+\lambda_{\min}}\right)}^{t}{\left\|{\bm{x}}^{*}\right\|}_{2}\leq\exp{\left(-\frac{2\lambda_{\min}t}{\lambda_{\max}+\lambda_{\min}}\right)}{\left\|{\bm{x}}^{*}\right\|}_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msub><mi>𝑰</mi><mi>n</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|{\bm{x}}^{*}-{\bm{x}}^{(t)}\right\|}_{2}\leq{\left\|{\bm{I}}_{n}-\gamma{\bm{A}}\right\|}_{2}^{t}{\left\|{\bm{x}}^{*}\right\|}_{2}={\left(1-\frac{2\lambda_{\min}}{\lambda_{\max}+\lambda_{\min}}\right)}^{t}{\left\|{\bm{x}}^{*}\right\|}_{2}\leq\exp{\left(-\frac{2\lambda_{\min}t}{\lambda_{\max}+\lambda_{\min}}\right)}{\left\|{\bm{x}}^{*}\right\|}_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p10.2" class="ltx_p">This implies that <math id="S22.p10.m8" class="ltx_Math" alttext="{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}\leq 2\exp{\left(-\frac{2\lambda_{\min}t}{\lambda_{\max}+\lambda_{\min}}\right)}{\left\|{\bm{x}}^{*}\right\|}_{2}\leq 2\exp(-\frac{t}{\tau}){\left\|{\bm{x}}^{*}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mi>t</mi><mi>τ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}\leq 2\exp{\left(-\frac{2\lambda_{\min}t}{\lambda_{\max}+\lambda_{\min}}\right)}{\left\|{\bm{x}}^{*}\right\|}_{2}\leq 2\exp(-\frac{t}{\tau}){\left\|{\bm{x}}^{*}\right\|}_{2}</annotation></semantics></math>.
Thus, the iteration stops when <math id="S22.p10.m9" class="ltx_Math" alttext="t=O{\left(\tau\log\frac{1}{\epsilon}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>τ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t=O{\left(\tau\log\frac{1}{\epsilon}\right)}</annotation></semantics></math>.
Moreover, when the iteration stops, we have <math id="S22.p10.m10" class="ltx_Math" alttext="{\left\|{\bm{A}}{\bm{x}}^{(t)}-b\right\|}_{2}=\gamma^{-1}{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}&lt;\gamma^{-1}\epsilon{\left\|{\bm{b}}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>−</mo><mi>b</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mrow><msup><mi>γ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>𝒃</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{A}}{\bm{x}}^{(t)}-b\right\|}_{2}=\gamma^{-1}{\left\|{\bm{x}}^{(t+1)}-{\bm{x}}^{(t)}\right\|}_{2}&lt;\gamma^{-1}\epsilon{\left\|{\bm{b}}\right\|}_{2}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="S22.p11" class="ltx_para ltx_noindent">
<p id="S22.p11.1" class="ltx_p">Let <math id="S22.p11.m1" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> be the largest eigenvalue of <math id="S22.p11.m2" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>.
When <math id="S22.p11.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and <math id="S22.p11.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> are sufficiently large, the largest eigenvalue of <math id="S22.p11.m5" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}},n}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}},n}</annotation></semantics></math> is close to <math id="S22.p11.m6" class="ltx_Math" alttext="ns(\lambda_{1})" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ns(\lambda_{1})</annotation></semantics></math>.
Meanwhile, the smallest eigenvalue of <math id="S22.p11.m7" class="ltx_Math" alttext="{\bm{A}}={\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}</annotation></semantics></math> is at least <math id="S22.p11.m8" class="ltx_Math" alttext="n\beta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">n\beta_{n}</annotation></semantics></math>.
Therefore, <math id="S22.p11.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> can be upper bounded by <math id="S22.p11.m10" class="ltx_Math" alttext="O(\beta_{n}^{-1}s(\lambda_{1}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\beta_{n}^{-1}s(\lambda_{1}))</annotation></semantics></math>.
Moreover, each iteration in <a href="#alg3" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">3</span></a> has a time complexity of <math id="S22.p11.m11" class="ltx_Math" alttext="O((m+n)^{2}q)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O((m+n)^{2}q)</annotation></semantics></math>.
Thus, the overall time complexity of <a href="#alg3" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">3</span></a> is <math id="S22.p11.m12" class="ltx_Math" alttext="O((m+n)^{2}q\beta_{n}^{-1}s(\lambda_{1})\log\frac{1}{\epsilon})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O((m+n)^{2}q\beta_{n}^{-1}s(\lambda_{1})\log\frac{1}{\epsilon})</annotation></semantics></math>.</p>
</div>
<div id="S22.p12" class="ltx_para ltx_noindent">
<p id="S22.p12.1" class="ltx_p">For <a href="#alg4" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">4</span></a>, the analysis is similar but much more complex. We have the following result regarding its time complexity.</p>
</div>
<div id="chapter5.Thmtheorem25" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem25.2" class="ltx_text ltx_font_bold">Theorem 5.25</span></span><span id="chapter5.Thmtheorem25.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A6" title="Appendix 11.F Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.F</span></a>)<span id="chapter5.Thmtheorem25.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem25.p1" class="ltx_para">
<p id="chapter5.Thmtheorem25.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem25.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem25.p1.m1" class="ltx_Math" alttext="\rho(\lambda)=\frac{\lambda^{r}}{s(\lambda)}=\sum_{p=0}^{q-1}\xi_{p}\lambda_{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mi>λ</mi><mi>r</mi></msup><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>ξ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>p</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho(\lambda)=\frac{\lambda^{r}}{s(\lambda)}=\sum_{p=0}^{q-1}\xi_{p}\lambda_{p}</annotation></semantics></math>, where <math id="chapter5.Thmtheorem25.p1.m2" class="ltx_Math" alttext="\rho(0)=\xi_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>ξ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho(0)=\xi_{0}&gt;0</annotation></semantics></math>.
Then, <math id="chapter5.Thmtheorem25.p1.m3" class="ltx_Math" alttext="\rho(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(\lambda)</annotation></semantics></math> is a continuous function on <math id="chapter5.Thmtheorem25.p1.m4" class="ltx_math_unparsed" alttext="[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,+\infty)</annotation></semantics></math>.
Denote its maximum and minimum on <math id="chapter5.Thmtheorem25.p1.m5" class="ltx_Math" alttext="[0,\lambda_{1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,\lambda_{1}]</annotation></semantics></math> by <math id="chapter5.Thmtheorem25.p1.m6" class="ltx_Math" alttext="\rho_{\max}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\rho_{\max}</annotation></semantics></math> and <math id="chapter5.Thmtheorem25.p1.m7" class="ltx_Math" alttext="\rho_{\min}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\rho_{\min}</annotation></semantics></math>.
Then, with <math id="chapter5.Thmtheorem25.p1.m8" class="ltx_Math" alttext="\gamma=(n\lambda_{1}^{r})^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mn>1</mn><mi>r</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\gamma=(n\lambda_{1}^{r})^{-1}</annotation></semantics></math>, <a href="#alg4" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">4</span></a> has a total time complexity of <math id="chapter5.Thmtheorem25.p1.m9" class="ltx_Math" alttext="O{\left((m+n)^{2}\frac{\max{\left\{q,r\right\}}\lambda_{1}^{r}\beta_{n}^{-1}}{\rho_{\min}}\log{\left[\max{\left\{\frac{1}{\epsilon},\frac{\lambda_{1}^{r}\rho_{\max}{\left\|{\bm{y}}\right\|}_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}{\left\|\hat{{\bm{\alpha}}}_{*}\right\|}_{2}}\right\}}\right]}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mi>q</mi><mo>,</mo><mi>r</mi><mo>}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mn>1</mn><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><msub><mi>ρ</mi><mi>min</mi></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mfrac><mn>1</mn><mi>ϵ</mi></mfrac><mo>,</mo><mfrac><mrow><msubsup><mi>λ</mi><mn>1</mn><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>𝐲</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ρ</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mover accent="true"><mi>𝛂</mi><mo>^</mo></mover><mo>∗</mo></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O{\left((m+n)^{2}\frac{\max{\left\{q,r\right\}}\lambda_{1}^{r}\beta_{n}^{-1}}{\rho_{\min}}\log{\left[\max{\left\{\frac{1}{\epsilon},\frac{\lambda_{1}^{r}\rho_{\max}{\left\|{\bm{y}}\right\|}_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}{\left\|\hat{{\bm{\alpha}}}_{*}\right\|}_{2}}\right\}}\right]}\right)}</annotation></semantics></math>, where <math id="chapter5.Thmtheorem25.p1.m10" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}_{*}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛂</mi><mo>^</mo></mover><mo>∗</mo></msub><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}_{*}</annotation></semantics></math> is the exact solution.</span></p>
</div>
</div>
<div id="S22.p13" class="ltx_para ltx_noindent">
<p id="S22.p13.1" class="ltx_p">We have seen how to implement STKR when <math id="S22.p13.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is a polynomial.
Now let us derive the generalization bound for the general STKR.
Define the following function class:</p>
<table id="S22.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex73.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\epsilon}({{\mathcal{H}}_{{k_{s}}}})={\left\{f\in{{\mathcal{H}}_{{k_{s}}}}\;\middle|\;{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}\leq\epsilon{\left\|f\right\|}_{{P_{\mathcal{X}}}}^{2}\right\}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\epsilon}({{\mathcal{H}}_{{k_{s}}}})={\left\{f\in{{\mathcal{H}}_{{k_{s}}}}\;\middle|\;{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}\leq\epsilon{\left\|f\right\|}_{{P_{\mathcal{X}}}}^{2}\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p13.2" class="ltx_p">This class is similar to <math id="S22.p13.m2" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math>, and it contains functions with smoothness at least <math id="S22.p13.m3" class="ltx_Math" alttext="\epsilon^{-1}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\epsilon^{-1}</annotation></semantics></math> <span id="S22.p13.2.1" class="ltx_text ltx_font_italic">w.r.t.</span> <math id="S22.p13.m4" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>.
Our result consists of an approximation error bound and an estimation error bound.
Recall the definition of <math id="S22.p13.m5" class="ltx_Math" alttext="\tilde{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{f}</annotation></semantics></math> and <math id="S22.p13.m6" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math> in <a href="#S22.E25" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">25</span></a>.
The approximation error is the gap between <math id="S22.p13.m7" class="ltx_Math" alttext="\tilde{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{f}</annotation></semantics></math> and <math id="S22.p13.m8" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math>, and the estimation error is the gap between <math id="S22.p13.m9" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math> and <math id="S22.p13.m10" class="ltx_Math" alttext="\tilde{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{f}</annotation></semantics></math>.
The approximation error can be bounded by the result in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>.</p>
</div>
<div id="chapter5.Thmtheorem26" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem26.2" class="ltx_text ltx_font_bold">Theorem 5.26</span></span><span id="chapter5.Thmtheorem26.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A7" title="Appendix 11.G Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.G</span></a>)<span id="chapter5.Thmtheorem26.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem26.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem26.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem26.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem26.p1.m1" class="ltx_Math" alttext="\lambda_{1}\geq\lambda_{2}\geq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>λ</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}\geq\lambda_{2}\geq\cdots</annotation></semantics></math> be the eigenvalues of <math id="chapter5.Thmtheorem26.p1.m2" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>.
Let <math id="chapter5.Thmtheorem26.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be given by <a href="#chapter5.Thmtheorem22" title="Theorem 5.22 (Proof in ). ‣ 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.22</span></a>.
Suppose the moment condition <a href="#S20.E22" title="In Estimation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">22</span></a> holds, and the eigenvalues decay by order <math id="chapter5.Thmtheorem26.p1.m4" class="ltx_Math" alttext="p^{-1}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">p^{-1}</annotation></semantics></math> for some <math id="chapter5.Thmtheorem26.p1.m5" class="ltx_Math" alttext="p\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">p\in(0,1]</annotation></semantics></math>, that is <math id="chapter5.Thmtheorem26.p1.m6" class="ltx_Math" alttext="s(\lambda_{i})=O(i^{-\frac{1}{p}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mi>p</mi></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s(\lambda_{i})=O(i^{-\frac{1}{p}})</annotation></semantics></math> for all <math id="chapter5.Thmtheorem26.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
Choose <math id="chapter5.Thmtheorem26.p1.m8" class="ltx_Math" alttext="\beta_{n}=\Theta(n^{-\frac{1}{1+p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>n</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{n}=\Theta(n^{-\frac{1}{1+p}})</annotation></semantics></math>.
Then, there exists a constant <math id="chapter5.Thmtheorem26.p1.m9" class="ltx_Math" alttext="c_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{0}&gt;0</annotation></semantics></math> independent of <math id="chapter5.Thmtheorem26.p1.m10" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="chapter5.Thmtheorem26.p1.m11" class="ltx_Math" alttext="\tau\geq\kappa^{-1}M^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>≥</mo><mrow><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\tau\geq\kappa^{-1}M^{-\frac{1}{2}}</annotation></semantics></math> (recall that <math id="chapter5.Thmtheorem26.p1.m12" class="ltx_Math" alttext="\kappa^{2}={\left\|k\right\|}_{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo>=</mo><msub><mrow><mo>‖</mo><mi>k</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\kappa^{2}={\left\|k\right\|}_{\infty}</annotation></semantics></math>), such that</span></p>
<table id="S22.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex74.m1" class="ltx_Math" alttext="{\left\|\tilde{f}-f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq c_{0}\tau^{2}\kappa^{2}M{\left[{\left(\epsilon{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}+\sigma^{2}\right)}n^{-\frac{1}{1+p}}+\max{\left\{L^{2},\kappa^{2}M\epsilon{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}\right\}}n^{-\frac{1+2p}{1+p}}\right]}" display="block" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><msup><mi>L</mi><mn>2</mn></msup><mo>,</mo><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}-f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq c_{0}\tau^{2}\kappa^{2}M{\left[{\left(\epsilon{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}+\sigma^{2}\right)}n^{-\frac{1}{1+p}}+\max{\left\{L^{2},\kappa^{2}M\epsilon{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}\right\}}n^{-\frac{1+2p}{1+p}}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter5.Thmtheorem26.p1.2" class="ltx_p"><span id="chapter5.Thmtheorem26.p1.2.1" class="ltx_text ltx_font_italic">holds for all <math id="chapter5.Thmtheorem26.p1.m13" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{\epsilon}({{\mathcal{H}}_{{k_{s}}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{\epsilon}({{\mathcal{H}}_{{k_{s}}}})</annotation></semantics></math> with probability at least <math id="chapter5.Thmtheorem26.p1.m14" class="ltx_Math" alttext="1-4e^{-\tau}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>τ</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">1-4e^{-\tau}</annotation></semantics></math>, given that <math id="chapter5.Thmtheorem26.p1.m15" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is sufficiently large.</span></p>
</div>
</div>
<div id="chapter5.Thmtheorem27" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem27.2" class="ltx_text ltx_font_bold">Remark 5.27</span></span><span id="chapter5.Thmtheorem27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem27.p1" class="ltx_para">
<p id="chapter5.Thmtheorem27.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="chapter5.Thmtheorem27.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib41" title="" class="ltx_ref">41</a><span id="chapter5.Thmtheorem27.p1.1.2" class="ltx_text ltx_font_italic">]</span></cite><span id="chapter5.Thmtheorem27.p1.1.3" class="ltx_text ltx_font_italic"> showed that the learning rate <math id="chapter5.Thmtheorem27.p1.m1" class="ltx_Math" alttext="O(n^{-\frac{1}{1+p}})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(n^{-\frac{1}{1+p}})</annotation></semantics></math> is minimax optimal, which means that one can construct an example where the learning rate is at most <math id="chapter5.Thmtheorem27.p1.m2" class="ltx_Math" alttext="O(n^{-\frac{1}{1+p}})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(n^{-\frac{1}{1+p}})</annotation></semantics></math>.
When <math id="chapter5.Thmtheorem27.p1.m3" class="ltx_Math" alttext="\kappa^{2}={\left\|k\right\|}_{\infty}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo>=</mo><msub><mrow><mo>‖</mo><mi>k</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\kappa^{2}={\left\|k\right\|}_{\infty}&lt;\infty</annotation></semantics></math>, one can always choose <math id="chapter5.Thmtheorem27.p1.m4" class="ltx_Math" alttext="p=1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=1</annotation></semantics></math> because <math id="chapter5.Thmtheorem27.p1.m5" class="ltx_Math" alttext="i\cdot s(\lambda_{i})\leq\sum_{j=1}^{i}s(\lambda_{j})\leq M\sum\lambda_{j}\leq M\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><msub><mi>λ</mi><mi>j</mi></msub></mrow></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">i\cdot s(\lambda_{i})\leq\sum_{j=1}^{i}s(\lambda_{j})\leq M\sum\lambda_{j}\leq M\kappa^{2}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S22.p14" class="ltx_para ltx_noindent">
<p id="S22.p14.1" class="ltx_p">Regarding the estimation error, we prove the following result.</p>
</div>
<div id="chapter5.Thmtheorem28" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem28.2" class="ltx_text ltx_font_bold">Theorem 5.28</span></span><span id="chapter5.Thmtheorem28.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A8" title="Appendix 11.H Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.H</span></a>)<span id="chapter5.Thmtheorem28.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem28.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem28.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem28.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem28.p1.m1" class="ltx_Math" alttext="\hat{\lambda}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\hat{\lambda}_{1}</annotation></semantics></math> be the largest eigenvalue of <math id="chapter5.Thmtheorem28.p1.m2" class="ltx_Math" alttext="\frac{{\bm{G}}_{k}}{m+n}" display="inline" intent=":literal"><semantics><mfrac><msub><mi>𝐆</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><annotation encoding="application/x-tex">\frac{{\bm{G}}_{k}}{m+n}</annotation></semantics></math>, and denote <math id="chapter5.Thmtheorem28.p1.m3" class="ltx_Math" alttext="\lambda_{\max}=\max{\left\{\lambda_{1},\hat{\lambda}_{1}\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\max}=\max{\left\{\lambda_{1},\hat{\lambda}_{1}\right\}}</annotation></semantics></math>.
Then, for any <math id="chapter5.Thmtheorem28.p1.m4" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter5.Thmtheorem28.p1.m5" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</span></p>
<table id="S22.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex75.m1" class="ltx_Math" alttext="{\left\|\hat{f}-\tilde{f}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq 8s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{{\left\|{\bm{y}}\right\|}_{2}^{2}}{n}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msub><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mrow><mo>‖</mo><mi>𝒚</mi><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\hat{f}-\tilde{f}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq 8s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{{\left\|{\bm{y}}\right\|}_{2}^{2}}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S22.p15" class="ltx_para ltx_noindent">
<p id="S22.p15.1" class="ltx_p">This result requires <math id="S22.p15.m1" class="ltx_Math" alttext="\hat{\lambda}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\hat{\lambda}_{1}</annotation></semantics></math>, for which there is the following result.</p>
</div>
<div id="chapter5.Thmtheorem29" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem29.2" class="ltx_text ltx_font_bold">Lemma 5.29</span></span><span id="chapter5.Thmtheorem29.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib125" title="" class="ltx_ref">125</a>]</cite>, Theorem 2)<span id="chapter5.Thmtheorem29.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem29.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem29.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem29.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="chapter5.Thmtheorem29.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter5.Thmtheorem29.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</span></p>
<table id="S22.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex76.m1" class="ltx_Math" alttext="\hat{\lambda}_{1}\leq\lambda_{1}+\frac{\kappa^{2}}{\sqrt{m+n}}{\left[2\sqrt{2}+\sqrt{19\log\frac{2(m+n+1)}{\delta}}\right]}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>≤</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>+</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow><mo>+</mo><msqrt><mrow><mn>19</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{1}\leq\lambda_{1}+\frac{\kappa^{2}}{\sqrt{m+n}}{\left[2\sqrt{2}+\sqrt{19\log\frac{2(m+n+1)}{\delta}}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S22.p16" class="ltx_para ltx_noindent">
<p id="S22.p16.1" class="ltx_p">The key to prove <a href="#chapter5.Thmtheorem28" title="Theorem 5.28 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.28</span></a> is using the complexity of <math id="S22.p16.m1" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math> to prove a uniform deviation bound for <math id="S22.p16.m2" class="ltx_Math" alttext="{\left|{\hat{k}_{s}}(x,x_{i})-{k_{s}}(x,x_{i})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">{\left|{\hat{k}_{s}}(x,x_{i})-{k_{s}}(x,x_{i})\right|}</annotation></semantics></math> for all <math id="S22.p16.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S22.p16.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
Thus, we can see why we only used the <math id="S22.p16.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> unlabeled samples to extract the top-<math id="S22.p16.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace, but can use all <math id="S22.p16.m7" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples in STKR.
The reason is that for uniform deviation bounds, the function class must be independent of the training samples.
For the top-<math id="S22.p16.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions, the downstream function class is the span of <math id="S22.p16.m9" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math>, and the proof of <a href="#chapter5.Thmtheorem12" title="Theorem 5.12. ‣ Part (i) Estimation error bound for kernel ridge regression. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.12</span></a> was based on this function class.
This function class depends on the <math id="S22.p16.m10" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> unlabeled samples.
If the <math id="S22.p16.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> labeled samples were also used, then the uniform deviation bound would not hold.
On the other hand, in <a href="#chapter5.Thmtheorem28" title="Theorem 5.28 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.28</span></a>, the function class if <math id="S22.p16.m12" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>, which is independent of all <math id="S22.p16.m13" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples.
Hence, we can use all the <math id="S22.p16.m14" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples in STKR.</p>
</div>
</section>
<section id="S23" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">23 </span>Empirical Study of Contexture Learning and STKR</h3>

<div id="S23.p1" class="ltx_para ltx_noindent">
<p id="S23.p1.1" class="ltx_p">This section conducts some experiments on STKR with the following goals:</p>
<ol id="S23.I1" class="ltx_enumerate">
<li id="S23.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S23.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S23.I1.i1.p1.1" class="ltx_p">Verify that STKR-Prop (<a href="#alg3" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithms</span> <span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#alg4" title="Algorithm 4 ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) works with general polynomial <math id="S23.I1.i1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, such as the inverse Laplacian, and compare them to label propagation (Label-Prop).</p>
</div></li>
<li id="S23.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S23.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S23.I1.i2.p1.1" class="ltx_p">Explore possible reasons why the inverse Laplacian works so well in practice, by examining the effect of <math id="S23.I1.i2.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> on the performance when using STKR with <math id="S23.I1.i2.p1.m2" class="ltx_Math" alttext="s(\lambda)=\lambda^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>λ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">s(\lambda)=\lambda^{p}</annotation></semantics></math>.</p>
</div></li>
<li id="S23.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S23.I1.i3.p1" class="ltx_para">
<p id="S23.I1.i3.p1.1" class="ltx_p">Compare extracting the top-<math id="S23.I1.i3.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace with STKR and Label-Prop.</p>
</div></li>
</ol>
</div>
<div id="S23.p2" class="ltx_para ltx_noindent">
<p id="S23.p2.1" class="ltx_p">The experiments here focus on graph node classification tasks.
The datasets used are listed in <a href="#S23.T8" title="In 23 Empirical Study of Contexture Learning and STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">8</span></a>, and they all come from the <span id="S23.p2.1.1" class="ltx_text ltx_font_italic">PyTorch Geometric</span> library <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite>.
Each dataset is split into four sets: train, validation (val), test and other.
Among them, train and val contain labeled samples,
while test and other contain unlabeled samples.
Both the transductive and the inductive settings are tested.</p>
</div>
<figure id="S23.T8" class="ltx_table">
<table id="S23.T8.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S23.T8.2.1" class="ltx_tr">
<th id="S23.T8.2.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
