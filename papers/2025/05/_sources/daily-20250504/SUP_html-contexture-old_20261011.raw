              <math id="alg1.l9.m1" class="ltx_Math" alttext="{\bm{B}}\leftarrow{\left[\Phi(x_{1}^{j-1}),\cdots,\Phi(x_{m}^{j-1})\right]}\in\mathbb{R}^{d\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo stretchy="false">←</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>1</mn><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>m</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{B}}\leftarrow{\left[\Phi(x_{1}^{j-1}),\cdots,\Phi(x_{m}^{j-1})\right]}\in\mathbb{R}^{d\times m}</annotation></semantics></math>

</div>
