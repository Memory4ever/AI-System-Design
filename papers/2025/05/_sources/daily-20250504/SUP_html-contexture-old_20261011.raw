             <span id="alg1.l6.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="j=1,\cdots,r-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j=1,\cdots,r-1</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">do</span>

</div>
