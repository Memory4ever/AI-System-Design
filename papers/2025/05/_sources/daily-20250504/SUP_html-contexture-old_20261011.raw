               <math id="alg3.l5.m1" class="ltx_Math" alttext="\tilde{{\bm{\alpha}}}\leftarrow\frac{1}{m+n}{\bm{F}}\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑭</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{\alpha}}}\leftarrow\frac{1}{m+n}{\bm{F}}\hat{{\bm{\alpha}}}</annotation></semantics></math>, <math id="alg3.l5.m2" class="ltx_Math" alttext="{\bm{v}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}</annotation></semantics></math>

</div>
