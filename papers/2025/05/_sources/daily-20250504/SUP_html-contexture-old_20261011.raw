reignobject_container"><span class="ltx_foreignobject_content"><span id="S23.F19.pic1.5" class="ltx_text">8</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 -4.55)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m1" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 12.09)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m2" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 28.72)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m3" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn>0.6</mn><annotation encoding="application/x-tex">0.6<