pan class="ltx_foreignobject_content"><span id="S23.F19.pic1.17" class="ltx_text">6</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 71.95 -18.56)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S23.F19.pic1.18" class="ltx_text">8</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 -3.51)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m10" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 12.89)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m11" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 29.29)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m12" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn>0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.42 45.69)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m13" class="ltx_Math" alttext="0.8" display="inline" intent=":literal"><semantics><mn>0.8</mn><annotation encoding="application/x-tex">0.8</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp49"><path d="M -7.54 -4.76 L 82.95 -4.76 L 82.95 52.32 L -7.54 52.32 Z"></path></clipPath><g clip-path="url(#pgfcp49)"><g><path style="fill:none" d="M 0 1.7 L 18.85 9.31 L 37.7 38.83 L 56.56 42.66 L 75.41 43.74"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 0 1.7 L 0 3.39"></path><g transform="matrix(0.0 1.0 -1.0 0.0 2.77 3.39)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 0 1.7 L 0 0"></path><g transform="matrix(0.0 -1.0 1.0 0.0 -2.77 0)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 18.85 9.31 L 18.85 12.3"></path><g transform="matrix(0.0 1.0 -1.0 0.0 21.62 12.3)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 18.85 9.31 L 18.85 6.33"></path><g transform="matrix(0.0 -1.0 1.0 0.0 16.08 6.33)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 37.7 38.83 L 37.7 42.75"></path><g transform="matrix(0.0 1.0 -1.0 0.0 40.47 42.75)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 37.7 38.83 L 37.7 34.9"></path><g transform="matrix(0.0 -1.0 1.0 0.0 34.94 34.9)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 56.56 42.66 L 56.56 46.4"></path><g transform="matrix(0.0 1.0 -1.0 0.0 59.32 46.4)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 56.56 42.66 L 56.56 38.91"></path><g transform="matrix(0.0 -1.0 1.0 0.0 53.79 38.91)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 75.41 43.74 L 75.41 47.56"></path><g transform="matrix(0.0 1.0 -1.0 0.0 78.18 47.56)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g><path style="fill:none" d="M 75.41 43.74 L 75.41 39.92"></path><g transform="matrix(0.0 -1.0 1.0 0.0 72.64 39.92)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(0,2.77)"><path style="fill:none" d="M 0 2.77 L 0 -2.77"></path></g></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 34.22 -34.02)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.19em;font-size:10pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="6.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.F19.pic1.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 12.05 65.51)"><foreignObject style="--ltx-fo-width:3.71em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="51.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S23.F19.pic1.19" class="ltx_text">PubMed</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 19: </span>Performance of STKR-Prop with <math id="S23.F19.m3" class="ltx_Math" alttext="s(\lambda)=\lambda^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>λ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">s(\lambda)=\lambda^{p}</annotation></semantics></math> and 8 iterations. The best <math id="S23.F19.m4" class="ltx_Math" alttext="\beta_{n}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\beta_{n}</annotation></semantics></math> with the highest test accuracy is selected. Each experiment is run with 10 random seeds.</figcaption>
</figure>
<div id="S23.p6" class="ltx_para ltx_noindent">
<p id="S23.p6.1" class="ltx_p">In conclusion, this chapter first derived generalization bounds for contexture learning, that is extracting the top-<math id="S23.p6.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace with finite samples.
The key quantity is the context complexity, which reflects the smoothness of the eigenfunctions.
Next, this chapter introduced a more general formulation called STKR, and presented its implementation as well as generalization bounds.
The key takeaway from this chapter is how the context affects the sample complexity of representation learning.</p>
</div>
</section>
</section>
<section id="chapter6" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 6 </span>Generalization Under Distribution Shift</h2>

<div id="chapter6.p1" class="ltx_para ltx_noindent">
<p id="chapter6.p1.1" class="ltx_p">The contexture theory characterizes the mechanism of representation learning, thereby advancing the science of foundation models.
However, one main assumption of the contexture theory is that the data distribution <math id="chapter6.p1.m1" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math> is fixed.
This is a very strong assumption that is hardly true in practice.
In reality, the distributions of the pretrain data and the downstream data are always different.
Whether a model trained on one distribution can still achieve good performance on another distribution is called the problem of <span id="chapter6.p1.1.1" class="ltx_text ltx_font_bold">out-of-distribution (OOD) generalization</span>.
The main takeaway from this chapter is that OOD generalization is extremely hard, both in theory and in practice.</p>
</div>
<div id="chapter6.p2" class="ltx_para ltx_noindent">
<p id="chapter6.p2.1" class="ltx_p">There is a rich body of work on OOD generalization in machine learning, statistics, applied probability and optimization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib128" title="" class="ltx_ref">128</a>, <a href="#bib.bib68" title="" class="ltx_ref">68</a>, <a href="#bib.bib12" title="" class="ltx_ref">12</a>, <a href="#bib.bib115" title="" class="ltx_ref">115</a>]</cite>.
In deep learning, there are two types of research on OOD generalization.
The first type studies how to transfer a model trained on one domain to another domain, also known as transfer learning <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib111" title="" class="ltx_ref">111</a>]</cite> or domain adaptation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib151" title="" class="ltx_ref">151</a>]</cite>.
The second type studies how to train robust models against distribution shift, that is preserving the model’s performance on the new distribution.
Such research is valuable in safety-critical applications or domains where the data is constantly changing, such as finance.
Both types of research are relevant to foundation models.
For example, how to apply an LLM trained on Wikipedia to a dataset of Python codes is the first type of research.
How to make sure that an LLM always generates proper responses to prompts it has never seen is the second type of research.
The first type is more related to the fine-tuning stage rather than the representation learning stage of foundation model training.
Therefore, this chapter focuses on the second type.</p>
</div>
<div id="chapter6.p3" class="ltx_para ltx_noindent">
<p id="chapter6.p3.1" class="ltx_p">In representation learning, a foundation model is pretrained on one distribution <math id="chapter6.p3.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, and then applied to another distribution <math id="chapter6.p3.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.
This chapter studies an easier problem, which is the standard problem in the literature:
A predictor is trained on <math id="chapter6.p3.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and then evaluated on <math id="chapter6.p3.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.
We assume that the distribution shift only contains <span id="chapter6.p3.1.1" class="ltx_text ltx_font_bold">covariate shift</span>, where the ground truth target function is always fixed, and only the distribution of <math id="chapter6.p3.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> changes.
In practice, there are two types of covariate shift <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib88" title="" class="ltx_ref">88</a>]</cite>.</p>
<ul id="S23.I4" class="ltx_itemize">
<li id="S23.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S23.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S23.I4.i1.p1.1" class="ltx_p">In <span id="S23.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">domain generalization</span>, the support of <math id="S23.I4.i1.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> might contain samples that are not in the support of <math id="S23.I4.i1.p1.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>. This is the typical scenario in domain adaptation.</p>
</div></li>
<li id="S23.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S23.I4.i2.p1" class="ltx_para">
<p id="S23.I4.i2.p1.1" class="ltx_p">In <span id="S23.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">subpopulation shift</span>, the support of <math id="S23.I4.i2.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is a subset of the support of <math id="S23.I4.i2.p1.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>. Alternatively we can write <math id="S23.I4.i2.p1.m3" class="ltx_Math" alttext="Q\ll P" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>≪</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">Q\ll P</annotation></semantics></math>, that is <math id="S23.I4.i2.p1.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is absolutely continuous to <math id="S23.I4.i2.p1.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>. Mathematically this means that for any set <math id="S23.I4.i2.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, <math id="S23.I4.i2.p1.m7" class="ltx_Math" alttext="P(A)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">P(A)=0</annotation></semantics></math> implies <math id="S23.I4.i2.p1.m8" class="ltx_Math" alttext="Q(A)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q(A)=0</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="chapter6.p4" class="ltx_para ltx_noindent">
<p id="chapter6.p4.1" class="ltx_p">In the context of foundation models, it suffices to study subpopulation shift.
There are two main reasons.
First, the pretraining set is very large, so it is very unlikely to have test samples that do not appear in the pretraining set.
Second, even in domain adaptation, the common practice is to fine-tune the foundation model on the new distribution before using it.
It is rarely the case that a model is used on a completely new distribution without any fine-tuning.
For these reasons, this chapter focuses on subpopulation shift exclusively.</p>
</div>
<section id="S24" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">24 </span>Reweighting and DRO</h3>

<div id="S24.p1" class="ltx_para ltx_noindent">
<p id="S24.p1.1" class="ltx_p">In subpopulation shift, <math id="S24.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S24.p1.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> are different distributions on the same set of samples.
Thus, one can view <math id="S24.p1.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> as assigning different weights to the samples than <math id="S24.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
For example, given a training set <math id="S24.p1.m5" class="ltx_Math" alttext="{\left\{(x_{i},y_{i})\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{(x_{i},y_{i})\right\}}_{i=1}^{n}</annotation></semantics></math>, <math id="S24.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is usually defined as the uniform distribution over the <math id="S24.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples, while <math id="S24.p1.m8" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> gives different weights to these samples.
Since the model is evaluated on <math id="S24.p1.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, we care more about those samples where <math id="S24.p1.m10" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> place larger weights than <math id="S24.p1.m11" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, because these samples have greater impact on the evaluation. We call them <span id="S24.p1.1.1" class="ltx_text ltx_font_bold">upweighted samples</span>.</p>
</div>
<div id="S24.p2" class="ltx_para ltx_noindent">
<p id="S24.p2.1" class="ltx_p">Empirical risk minimization (ERM) is the standard training algorithm in deep learning. It assumes that the training samples are <span id="S24.p2.1.1" class="ltx_text ltx_font_italic">i.i.d.</span> sampled from the data distribution, and minimizes the average model risk over the training samples.
Let <math id="S24.p2.m1" class="ltx_Math" alttext="\ell(\hat{y},y)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\hat{y},y)</annotation></semantics></math> be the loss function. Then, ERM minimizes the following empirical risk:</p>
<table id="S24.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex79.m1" class="ltx_Math" alttext="\hat{{\mathcal{R}}}_{\textnormal{ERM}}(f)=\frac{1}{n}\sum_{i=1}^{n}\ell(f(x_{i}),y_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mtext>ERM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}_{\textnormal{ERM}}(f)=\frac{1}{n}\sum_{i=1}^{n}\ell(f(x_{i}),y_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S24.p3" class="ltx_para ltx_noindent">
<p id="S24.p3.1" class="ltx_p">However, if <math id="S24.p3.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S24.p3.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> give different weights to the samples, then ERM could achieve low performance on <math id="S24.p3.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> if its risk on the upweighted samples on higher than average <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">67</a>, <a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib137" title="" class="ltx_ref">137</a>]</cite>.
One common example of this is <span id="S24.p3.1.1" class="ltx_text ltx_font_bold">class imbalance</span>, which was briefly discussed in <a href="#S6" title="6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">6</span></a>.
In a classification task, if some classes are significantly smaller than the other classes, then a model trained via ERM will typically have high risk on these small classes.
However, the model is required to have good performance on every class, meaning that <math id="S24.p3.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> places larger weights on these small classes than <math id="S24.p3.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
As a result, the ERM model is poor in the class imbalance situation.</p>
</div>
<div id="S24.p4" class="ltx_para ltx_noindent">
<p id="S24.p4.1" class="ltx_p">Given the above discussion,
the most straightforward way to tackle the subpopulation shift is reweighting, also known as <span id="S24.p4.1.1" class="ltx_text ltx_font_bold">importance weighting</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib128" title="" class="ltx_ref">128</a>]</cite>.
The idea is to assign a different weight <math id="S24.p4.m1" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> to the samples in the training loss, such that <math id="S24.p4.m2" class="ltx_Math" alttext="P^{\prime}=Q" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">P^{\prime}=Q</annotation></semantics></math>.
The importance weighting (IW) empirical risk is</p>
<table id="S24.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex80.m1" class="ltx_Math" alttext="\hat{{\mathcal{R}}}_{\textnormal{IW}}(f)=\frac{1}{n}\sum_{i=1}^{n}\frac{Q(x_{i})}{P(x_{i})}\ell(f(x_{i}),y_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mtext>IW</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}_{\textnormal{IW}}(f)=\frac{1}{n}\sum_{i=1}^{n}\frac{Q(x_{i})}{P(x_{i})}\ell(f(x_{i}),y_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.p4.2" class="ltx_p">Note that <math id="S24.p4.m3" class="ltx_Math" alttext="P(x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(x)</annotation></semantics></math> and <math id="S24.p4.m4" class="ltx_Math" alttext="Q(x)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(x)</annotation></semantics></math> are the weights of <math id="S24.p4.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, and they are not necessarily the density functions.
For example, in class imbalance, <math id="S24.p4.m6" class="ltx_Math" alttext="P(x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(x)</annotation></semantics></math> is proportional to the size of the class of <math id="S24.p4.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
If the goal is to have good performance on every class, then <math id="S24.p4.m8" class="ltx_Math" alttext="Q(x)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(x)</annotation></semantics></math> is the same for all <math id="S24.p4.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
Consequently, <math id="S24.p4.m10" class="ltx_Math" alttext="{\mathcal{R}}_{\textnormal{IW}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mtext>IW</mtext></msub><annotation encoding="application/x-tex">{\mathcal{R}}_{\textnormal{IW}}</annotation></semantics></math> divides the loss on each sample by its class size, thereby assigning larger weights to samples in smaller classes.
Note that this is different from <a href="#S6.E2" title="In Classification tasks. ‣ 6 Three Illustrative Examples ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">2</span></a>, which divides the sample loss by the square root of its class size.</p>
</div>
<div id="S24.p5" class="ltx_para ltx_noindent">
<p id="S24.p5.1" class="ltx_p">Importance weighting assumes that we know <math id="S24.p5.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> at train time.
What if <math id="S24.p5.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is unknown?
This is the more common case in training foundation models.
The pretraining dataset is a very large and comprehensive dataset, while the downstream task usually focuses on only one domain, that is a small part of the pretraining data.
However, since we may not know the downstream task at pretrain time, we do not know which data it will focus on.</p>
</div>
<div id="S24.p6" class="ltx_para ltx_noindent">
<p id="S24.p6.1" class="ltx_p"><span id="S24.p6.1.1" class="ltx_text ltx_font_bold">Distributionally robust optimization (DRO)</span> is the most popular approach when <math id="S24.p6.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is unknown.
It aims to minimize the model risk on the worst <math id="S24.p6.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> whose distance to <math id="S24.p6.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is bounded by some <math id="S24.p6.m4" class="ltx_Math" alttext="\rho&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho&gt;0</annotation></semantics></math>.
The distance from one distribution to another is also known as a divergence function, and is denoted by <math id="S24.p6.m5" class="ltx_math_unparsed" alttext="D(Q\parallel P)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(Q\parallel P)</annotation></semantics></math>.
Note that <math id="S24.p6.m6" class="ltx_math_unparsed" alttext="D(Q\parallel P)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(Q\parallel P)</annotation></semantics></math> might not be symmetric, that is we could have <math id="S24.p6.m7" class="ltx_math_unparsed" alttext="D(Q\parallel P)\neq D(P\parallel Q)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>P</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(Q\parallel P)\neq D(P\parallel Q)</annotation></semantics></math>.
The DRO risk is defined as</p>
<table id="S24.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.E26.m1" class="ltx_math_unparsed" alttext="{\mathcal{R}}_{D,\rho}(f;P)=\sup_{Q}{\left\{\mathbb{E}_{(X,Y)\sim Q}[\ell{\left(f(X),Y\right)}]\;\middle|\;D(Q\parallel P)\leq\rho\right\}}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi>D</mi><mo>,</mo><mi>ρ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>;</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mi>Q</mi></munder><mrow><mo>{</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>Q</mi></mrow></msub><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>Y</mi><mo>)</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="true">|</mo><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>ρ</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{R}}_{D,\rho}(f;P)=\sup_{Q}{\left\{\mathbb{E}_{(X,Y)\sim Q}[\ell{\left(f(X),Y\right)}]\;\middle|\;D(Q\parallel P)\leq\rho\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="S24.p6.2" class="ltx_p">The constraint <math id="S24.p6.m8" class="ltx_math_unparsed" alttext="D(Q\parallel P)\leq\rho" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">D(Q\parallel P)\leq\rho</annotation></semantics></math> comes from our prior knowledge about <math id="S24.p6.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.
The following are two examples of DRO.</p>
</div>
<div id="chapter6.Thmtheorem1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Example 6.1</span></span><span id="chapter6.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter6.Thmtheorem1.p1" class="ltx_para">
<p id="chapter6.Thmtheorem1.p1.1" class="ltx_p"><span id="chapter6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Conditional value at risk (CVaR)<span id="chapter6.Thmtheorem1.p1.1.1.1" class="ltx_text ltx_font_medium"> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>, Example 3]</cite> aims to maximize the model’s performance on the worst <math id="chapter6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathvariant="normal">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> fraction of the data, for some fixed <math id="chapter6.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math>.
For example, CVaR is widely used in finance, where the model needs to perform well when the market is at its lowest point.
In this scenario, we have <math id="chapter6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="Q(x)\leq\alpha^{-1}P(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi mathvariant="normal">α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q(x)\leq\alpha^{-1}P(x)</annotation></semantics></math> for all <math id="chapter6.Thmtheorem1.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi mathvariant="normal">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, that is the sample weight under <math id="chapter6.Thmtheorem1.p1.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi mathvariant="normal">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is at least <math id="chapter6.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathvariant="normal">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> times the weight under <math id="chapter6.Thmtheorem1.p1.m7" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>. Thus, <math id="chapter6.Thmtheorem1.p1.m8" class="ltx_math_unparsed" alttext="D(Q\parallel P)=\sup\frac{Q(x)}{P(x)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">D</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">P</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.167em">sup</mo><mfrac><mrow><mi mathvariant="normal">Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi mathvariant="normal">P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">D(Q\parallel P)=\sup\frac{Q(x)}{P(x)}</annotation></semantics></math>, and <math id="chapter6.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\rho=\alpha^{-1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ρ</mi><mo>=</mo><msup><mi mathvariant="normal">α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\rho=\alpha^{-1}</annotation></semantics></math>.</span></span></p>
</div>
</div>
<div id="chapter6.Thmtheorem2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter6.Thmtheorem2.2" class="ltx_text ltx_font_bold">Example 6.2</span></span><span id="chapter6.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter6.Thmtheorem2.p1" class="ltx_para">
<p id="chapter6.Thmtheorem2.p1.1" class="ltx_p"><span id="chapter6.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">In <span id="chapter6.Thmtheorem2.p1.1.1.1" class="ltx_text ltx_font_bold">group DRO (GDRO)</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib121" title="" class="ltx_ref">121</a>]</cite>, the data is divided into a number of groups, and the model is required to perform well on the worst group.
This is a common scenario in the field of machine learning fairness.
For example, a credit approval model is required to be fair across all races.
Then, the groups are defined by the races.
In this case, <math id="chapter6.Thmtheorem2.p1.m1" class="ltx_Math" alttext="P(x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(x)</annotation></semantics></math> and <math id="chapter6.Thmtheorem2.p1.m2" class="ltx_Math" alttext="Q(x)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(x)</annotation></semantics></math> are the weights on the group of <math id="chapter6.Thmtheorem2.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="chapter6.Thmtheorem2.p1.m4" class="ltx_math_unparsed" alttext="D(Q\parallel P)=\sup\frac{Q(x)}{P(x)}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.167em">sup</mo><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">D(Q\parallel P)=\sup\frac{Q(x)}{P(x)}</annotation></semantics></math>, and <math id="chapter6.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is the number of groups.</span></p>
</div>
</div>
<div id="S24.p7" class="ltx_para ltx_noindent">
<p id="S24.p7.1" class="ltx_p">Both reweighting and DRO are quite heuristic, but do they actually work in practice?
The results are mixed.
For example, balancing the classes can usually give the model higher performance on small classes, but at the cost of the average performance.
Meanwhile, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib121" title="" class="ltx_ref">121</a>]</cite> showed that reweighting and DRO methods can overfit very easily, and they usually require much stronger regularization than ERM, or early stopping.
Furthermore, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite> conducted a large-scale empirical study, and showed the surprising negative result that reweighting are not better than ERM on most real datasets.
The authors argued that reweighting were reported better in prior work only because the ERM baseline had not been sufficiently tuned.</p>
</div>
<div id="S24.p8" class="ltx_para ltx_noindent">
<p id="S24.p8.1" class="ltx_p">The rest of this chapter will show two reasons why reweighting and DRO might fail.
The first reason is related to the training dynamics of these methods.
The second reason is related to their sensitivity to the outliers in the dataset.
Possible solutions to each failure mode will be discussed.
These analyses are based on my work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib165" title="" class="ltx_ref">165</a>, <a href="#bib.bib166" title="" class="ltx_ref">166</a>, <a href="#bib.bib164" title="" class="ltx_ref">164</a>]</cite>.</p>
</div>
</section>
<section id="S25" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">25 </span>Generalized Reweighting (GRW) Versus ERM</h3>

<div id="S25.p1" class="ltx_para ltx_noindent">
<p id="S25.p1.1" class="ltx_p">Let the input space be <math id="S25.p1.m1" class="ltx_Math" alttext="{\mathcal{X}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>⊆</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\mathcal{X}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}</annotation></semantics></math>, and we assume that all <math id="S25.p1.m2" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math> satisfies <math id="S25.p1.m3" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>.
Consider learning a target function <math id="S25.p1.m4" class="ltx_Math" alttext="f^{*}:{\mathcal{X}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f^{*}:{\mathcal{X}}\rightarrow\mathbb{R}</annotation></semantics></math> using a training set <math id="S25.p1.m5" class="ltx_Math" alttext="{\left\{(x_{i},y_{i})\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{(x_{i},y_{i})\right\}}_{i=1}^{n}</annotation></semantics></math>.
Denote <math id="S25.p1.m6" class="ltx_Math" alttext="{\bm{X}}=(x_{1},\cdots,x_{n})\in\mathbb{R}^{d_{{\mathcal{X}}}\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{X}}=(x_{1},\cdots,x_{n})\in\mathbb{R}^{d_{{\mathcal{X}}}\times n}</annotation></semantics></math>, and <math id="S25.p1.m7" class="ltx_Math" alttext="{\bm{Y}}=(y_{1},\cdots,y_{n})\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{Y}}=(y_{1},\cdots,y_{n})\in\mathbb{R}^{n}</annotation></semantics></math>. For any function <math id="S25.p1.m8" class="ltx_Math" alttext="g:{\mathcal{X}}\mapsto\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">↦</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">g:{\mathcal{X}}\mapsto\mathbb{R}^{m}</annotation></semantics></math>, we overload notation and denote <math id="S25.p1.m9" class="ltx_Math" alttext="g({\bm{X}})=(g(x_{1}),\cdots,g(x_{n}))\in\mathbb{R}^{m\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">g({\bm{X}})=(g(x_{1}),\cdots,g(x_{n}))\in\mathbb{R}^{m\times n}</annotation></semantics></math>.</p>
</div>
<div id="S25.p2" class="ltx_para ltx_noindent">
<p id="S25.p2.1" class="ltx_p">The difference between reweighting and DRO is that <math id="S25.p2.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is fixed in reweighting are fixed, while it is not in DRO.
Here we present a general formulation called <span id="S25.p2.1.1" class="ltx_text ltx_font_bold">generalized reweighting (GRW)</span>.
At training step <math id="S25.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, GRW minimizes the following weighted empirical risk:</p>
<table id="S25.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S25.E27.m1" class="ltx_Math" alttext="\hat{{\mathcal{R}}}_{{\bm{q}}^{(t)}}(f)=\sum_{i=1}^{n}q_{i}^{(t)}\ell(f(x_{i}),y_{i})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}_{{\bm{q}}^{(t)}}(f)=\sum_{i=1}^{n}q_{i}^{(t)}\ell(f(x_{i}),y_{i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="S25.p2.2" class="ltx_p">where <math id="S25.p2.m3" class="ltx_Math" alttext="{\bm{q}}^{(t)}=(q_{1}^{(t)},\cdots,q_{n}^{(t)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>q</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{q}}^{(t)}=(q_{1}^{(t)},\cdots,q_{n}^{(t)})</annotation></semantics></math> is the sample weight vector, such that <math id="S25.p2.m4" class="ltx_Math" alttext="q_{1}^{(t)}+\cdots+q_{n}^{(t)}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>q</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q_{1}^{(t)}+\cdots+q_{n}^{(t)}=1</annotation></semantics></math>.
If <math id="S25.p2.m5" class="ltx_Math" alttext="{\bm{q}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{q}}^{(t)}</annotation></semantics></math> does not change with <math id="S25.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we call it static GRW;
if <math id="S25.p2.m7" class="ltx_Math" alttext="{\bm{q}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{q}}^{(t)}</annotation></semantics></math> can change with <math id="S25.p2.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we call it dynamic GRW.
Note that ERM is a special case of static GRW.</p>
</div>
<div id="S25.p3" class="ltx_para ltx_noindent">
<p id="S25.p3.1" class="ltx_p">Importance weighting is obviously an example of static GRW.
Group DRO is an example of dynamic GRW, and here is how it is usually implemented.
Let there be <math id="S25.p3.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> groups.
Denote the empirical risk over group <math id="S25.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> by <math id="S25.p3.m3" class="ltx_Math" alttext="\hat{{\mathcal{R}}}_{k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}_{k}(f)</annotation></semantics></math>, and the model at time <math id="S25.p3.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> by <math id="S25.p3.m5" class="ltx_Math" alttext="f^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(t)}</annotation></semantics></math>.
For all <math id="S25.p3.m6" class="ltx_Math" alttext="k\in[K]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[K]</annotation></semantics></math>, group DRO iteratively sets <math id="S25.p3.m7" class="ltx_Math" alttext="q_{i}^{(t)}=g_{k}^{(t)}/n_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>/</mo><msub><mi>n</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}=g_{k}^{(t)}/n_{k}</annotation></semantics></math> for all <math id="S25.p3.m8" class="ltx_Math" alttext="(x_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},y_{i})</annotation></semantics></math> in group <math id="S25.p3.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, where <math id="S25.p3.m10" class="ltx_Math" alttext="g_{k}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">g_{k}^{(t)}</annotation></semantics></math> is the group weight that is updated by</p>
<table id="S25.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S25.Ex81.m1" class="ltx_Math" alttext="g_{k}^{(t)}\propto g_{k}^{(t-1)}\exp{\left[\nu\hat{{\mathcal{R}}}_{k}{\left(f^{(t-1)}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∝</mo><mrow><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{k}^{(t)}\propto g_{k}^{(t-1)}\exp{\left[\nu\hat{{\mathcal{R}}}_{k}{\left(f^{(t-1)}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S25.p3.2" class="ltx_p">for some <math id="S25.p3.m11" class="ltx_Math" alttext="\nu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nu&gt;0</annotation></semantics></math>. The group weights are normalized so that <math id="S25.p3.m12" class="ltx_Math" alttext="q_{1}^{(t)}+\cdots+q_{n}^{(t)}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>q</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q_{1}^{(t)}+\cdots+q_{n}^{(t)}=1</annotation></semantics></math>.
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib121" title="" class="ltx_ref">121</a>, Proposition 2]</cite> showed that for convex settings, the Group DRO risk of iterates converges to the global minimum with the rate <math id="S25.p3.m13" class="ltx_math_unparsed" alttext="O(t^{-1/2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(t^{-1/2})</annotation></semantics></math> if <math id="S25.p3.m14" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> is sufficiently small.</p>
</div>
<div id="S25.p4" class="ltx_para ltx_noindent">
<p id="S25.p4.1" class="ltx_p">The key result of this section is that GRW cannot improve over ERM, because the models they produce are too similar.
It relies on two key assumptions.
First, the model is over-parameterized, meaning that the number of parameters is (much) greater than the number of samples. This is the usual case in deep learning.
Second, the optimizer is gradient descent with a sufficiently small learning rate. Our results also hold for other gradient methods such as momentum SGD and Adam, as long as the training loss converges to zero.</p>
</div>
<div id="S25.p5" class="ltx_para ltx_noindent">
<p id="S25.p5.1" class="ltx_p">Let us first gain some insights from linear models, using an analysis similar to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">52</a>]</cite>.
Then, we will study neural networks.</p>
</div>
<section id="S25.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Insights from linear models.</h4>

<div id="S25.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S25.SS0.SSS0.Px1.p1.1" class="ltx_p">Consider a regression task, where the loss <math id="S25.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\ell(\hat{y},y)=\frac{1}{2}(\hat{y}-y)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\ell(\hat{y},y)=\frac{1}{2}(\hat{y}-y)^{2}</annotation></semantics></math> is the squared loss.
Consider using a linear model denoted by <math id="S25.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="f(x)={\left\langle\theta,x\right\rangle}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>⟨</mo><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">f(x)={\left\langle\theta,x\right\rangle}</annotation></semantics></math> for <math id="S25.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\theta\in\mathbb{R}^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\theta\in\mathbb{R}^{d_{{\mathcal{X}}}}</annotation></semantics></math>.
We assume that the model is over-parameterized, that is <math id="S25.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="d_{{\mathcal{X}}}&gt;n" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>&gt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d_{{\mathcal{X}}}&gt;n</annotation></semantics></math>.
The weight update rule of GRW under gradient descent (GD) is the following:</p>
<table id="S25.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S25.E28.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}^{(t)}\nabla_{\theta}\ell(f^{(t)}(x_{i}),y_{i})=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}^{(t)}(f^{(t)}(x_{i})-y_{i})x_{i}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}^{(t)}\nabla_{\theta}\ell(f^{(t)}(x_{i}),y_{i})=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}^{(t)}(f^{(t)}(x_{i})-y_{i})x_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="S25.SS0.SSS0.Px1.p1.2" class="ltx_p">where <math id="S25.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math> is the learning rate.
We now show that, under some assumptions, as <math id="S25.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>, <math id="S25.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> must converge to a common <math id="S25.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> for all GRW and ERM methods.
The proof consists of two steps.
First, we prove that the training loss will converge to zero.
In this case, as long as <math id="S25.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math> are linearly independent, <math id="S25.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> must be an interpolator, which means that <math id="S25.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\langle\theta^{*},x_{i}\rangle=y_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\langle\theta^{*},x_{i}\rangle=y_{i}</annotation></semantics></math> for all <math id="S25.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>.
Second, we prove that there is a unique interpolator <math id="S25.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math>. The interpolator only depends on the starting point <math id="S25.SS0.SSS0.Px1.p1.m14" class="ltx_Math" alttext="\theta^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(0)}</annotation></semantics></math> and the training samples, but it does not depend on the sample weights <math id="S25.SS0.SSS0.Px1.p1.m15" class="ltx_Math" alttext="{\bm{q}}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>𝒒</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{q}}^{(t)}</annotation></semantics></math>.
These results require the following assumption about the sample weights.</p>
</div>
<div id="chapter6.Thmtheorem3" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter6.Thmtheorem3.2" class="ltx_text ltx_font_bold">Assumption 6.3</span></span><span id="chapter6.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter6.Thmtheorem3.p1" class="ltx_para">
<p id="chapter6.Thmtheorem3.p1.1" class="ltx_p"><span id="chapter6.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">There are constants <math id="chapter6.Thmtheorem3.p1.m1" class="ltx_Math" alttext="q_{1},\cdots,q_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">q_{1},\cdots,q_{n}</annotation></semantics></math> such that for all <math id="chapter6.Thmtheorem3.p1.m2" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>, there is <math id="chapter6.Thmtheorem3.p1.m3" class="ltx_Math" alttext="q_{i}^{(t)}\rightarrow q_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}\rightarrow q_{i}</annotation></semantics></math> as <math id="chapter6.Thmtheorem3.p1.m4" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>.
Moreover, <math id="chapter6.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\min_{i}q_{i}=q^{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><mo>=</mo><msup><mi>q</mi><mo>∗</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\min_{i}q_{i}=q^{*}&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S25.SS0.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="S25.SS0.SSS0.Px1.p2.1" class="ltx_p">This assumption says two things.
First, the sample weights become stable after a sufficient amount of training. It guarantees that the training loss will not change too much between two consecutive training steps.
Second, all samples have positive weights, which means that no sample is deleted from the training set.
This is important because the unique <math id="S25.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> depends on the training samples.
If samples were deleted, <math id="S25.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> would not be the same.
The following theorem shows that the training loss will converge to zero.</p>
</div>
<div id="chapter6.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter6.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 6.4</span></span><span id="chapter6.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter12.A1" title="Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">12.A</span></a>)<span id="chapter6.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter6.Thmtheorem4.p1" class="ltx_para">
<p id="chapter6.Thmtheorem4.p1.1" class="ltx_p"><span id="chapter6.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">If <math id="chapter6.Thmtheorem4.p1.m1" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math> are linearly independent, then there exists a constant <math id="chapter6.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\eta_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{0}&gt;0</annotation></semantics></math> such that: For any GRW algorithm satisfying <a href="#chapter6.Thmtheorem3" title="Assumption 6.3. ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">6.3</span></a>, under the update rule <a href="#S25.E28" title="In Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">28</span></a> with <math id="chapter6.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\eta\leq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{0}</annotation></semantics></math>, the empirical ERM risk <math id="chapter6.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\hat{{\mathcal{R}}}_{\textnormal{ERM}}(f^{(t)})\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mtext>ERM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\hat{{\mathcal{R}}}_{\textnormal{ERM}}(f^{(t)})\rightarrow 0</annotation></semantics></math> as <math id="chapter6.Thmtheorem4.p1.m5" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S25.SS0.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="S25.SS0.SSS0.Px1.p3.1" class="ltx_p">When <math id="S25.SS0.SSS0.Px1.p3.m1" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math> are linearly independent,
<a href="#S25.E28" title="In Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">28</span></a> implies that <math id="S25.SS0.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\theta^{(t+1)}-\theta^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}-\theta^{(t)}</annotation></semantics></math> is always a linear combination of <math id="S25.SS0.SSS0.Px1.p3.m3" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math>.
As a result, for all <math id="S25.SS0.SSS0.Px1.p3.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="S25.SS0.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\theta^{(t)}-\theta^{(0)}\in{\textnormal{span}}{\left\{x_{1},\cdots,x_{n}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t)}-\theta^{(0)}\in{\textnormal{span}}{\left\{x_{1},\cdots,x_{n}\right\}}</annotation></semantics></math>.
This is an <math id="S25.SS0.SSS0.Px1.p3.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional subspace of <math id="S25.SS0.SSS0.Px1.p3.m7" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>.
By Cramer’s rule, there is exactly one <math id="S25.SS0.SSS0.Px1.p3.m8" class="ltx_Math" alttext="\tilde{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\theta}</annotation></semantics></math> in this subspace such that <math id="S25.SS0.SSS0.Px1.p3.m9" class="ltx_Math" alttext="\langle\tilde{\theta}+\theta^{(0)},x_{i}\rangle=y_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>+</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\langle\tilde{\theta}+\theta^{(0)},x_{i}\rangle=y_{i}</annotation></semantics></math> for all <math id="S25.SS0.SSS0.Px1.p3.m10" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>.
Therefore, <math id="S25.SS0.SSS0.Px1.p3.m11" class="ltx_Math" alttext="\theta^{*}=\tilde{\theta}+\theta^{(0)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>=</mo><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>+</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{*}=\tilde{\theta}+\theta^{(0)}</annotation></semantics></math> is unique and independent of the sample weights.
It only relies on <math id="S25.SS0.SSS0.Px1.p3.m12" class="ltx_Math" alttext="\theta^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(0)}</annotation></semantics></math> and <math id="S25.SS0.SSS0.Px1.p3.m13" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math>.</p>
</div>
<div id="S25.SS0.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="S25.SS0.SSS0.Px1.p4.1" class="ltx_p">Finally, note that ERM is a special case of GRW.
Thus, GRW produces the exact same model as ERM, so it cannot improve over ERM.
One way to solve this problem is adding regularization.
The regularization has two effects: (i) moving <math id="S25.SS0.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\theta^{(t+1)}-\theta^{(t)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}-\theta^{(t)}</annotation></semantics></math> out of the span of <math id="S25.SS0.SSS0.Px1.p4.m2" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math>; (ii) preventing the model from achieving zero loss, that is interpolating the training samples.
Another solution is to add some new samples to (via data augmentation for example), or delete som samples from the dataset.</p>
</div>
<div id="S25.SS0.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="S25.SS0.SSS0.Px1.p5.1" class="ltx_p">Let us demonstrate this result with a simple experiment.
The experiment is conducted on a training set of six MNIST images, five of which are digit 0 and one is digit 1.
The two different digits define two groups.
We use a 784-dimensional linear model and run ERM, importance weighting and group DRO (with <math id="S25.SS0.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\nu=1" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\nu=1</annotation></semantics></math>).
The results are reported in <a href="#S25.F20" title="In Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">20</span></a>, in which (a) and (b) are the results when no regularization is applied.
From (a) we can see that the three models will converge to the same <math id="S25.SS0.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>;
from (b) we can see that the training loss of all three models will converge to zero.
Then, we apply <math id="S25.SS0.SSS0.Px1.p5.m3" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> regularization and run the experiment again. From (c) and (d) we can see that when the regularization is small, the training loss will still converge to zero, and the three models will still converge to the same <math id="S25.SS0.SSS0.Px1.p5.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>.
From (e) and (f) we can see that the three models converge to different points only when the regularization is so large that the training loss does not converge to zero.</p>
</div>
<figure id="S25.F20" class="ltx_figure"><span class="ltx_inline-block"><svg id="S25.F20.pic1" class="ltx_picture ltx_centering" height="346.51" overflow="visible" version="1.1" viewBox="0 0 488.4 346.51" width="488.4"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,346.51) matrix(1 0 0 -1 0 0) translate(31.37,0) translate(0,248.16)"><g transform="matrix(1.0 0.0 0.0 1.0 -23.66 -26.84)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(23.66,0) translate(0,26.85)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 2.77 0 L 2.77 5.91 M 30.42 0 L 30.42 5.91 M 58.07 0 L 58.07 5.91 M 85.72 0 L 85.72 5.91 M 2.77 57.07 L 2.77 51.17 M 30.42 57.07 L 30.42 51.17 M 58.07 57.07 L 58.07 51.17 M 85.72 57.07 L 85.72 51.17"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 0 L 5.91 0 M 0 14.27 L 5.91 14.27 M 0 28.54 L 5.91 28.54 M 0 42.81 L 5.91 42.81 M 0 57.07 L 5.91 57.07 M 85.72 0 L 79.82 0 M 85.72 14.27 L 79.82 14.27 M 85.72 28.54 L 79.82 28.54 M 85.72 42.81 L 79.82 42.81 M 85.72 57.07 L 79.82 57.07"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M 0 0 L 0 57.07 L 85.72 57.07 L 85.72 0 L 0 0 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -0.69 -13.81)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F20.pic1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 14.66 -13.81)"><foreignObject style="--ltx-fo-width:2.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="31.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F20.pic1.m2" class="ltx_Math" alttext="1{,}000" display="inline" intent=":literal"><semantics><mn>1,000</mn><annotation encoding="application/x-tex">1{,}000</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.31 -13.81)"><foreignObject style="--ltx-fo-width:2.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="31.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F20.pic1.m3" class="ltx_Math" alttext="2{,}000" display="inline" intent=":literal"><semantics><mn>2,000</mn><annotation encoding="application/x-tex">2{,}000</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 69.96 -13.81)"><foreignObject style="--ltx-fo-width:2.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="31.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F20.pic1.m4" class="ltx_Math