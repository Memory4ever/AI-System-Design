<td id="S23.T9.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S23.T9.m1" class="ltx_Math" alttext="79.07_{2.19}" display="inline" intent=":literal"><semantics><msub><mn>79.07</mn><mn>2.19</mn></msub><annotation encoding="application/x-tex">79.07_{2.19}</annotation></semantics></math></td>
