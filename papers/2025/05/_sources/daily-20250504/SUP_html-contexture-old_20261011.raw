ix(1 0 0 -1 0 9.61)" width="74.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S19.F14.pic1.39" class="ltx_text">Mask Ratio <math id="S19.F14.pic1.m7" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 56.94 9.92 h 117.79 v 44.8 h -117.79 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 57.63 18.16)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 43.42)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.61)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-dasharray="1.6pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="1.6pt" transform="matrix(1 0 0 -1 0 0) translate(1.11,0)"><path style="fill:none" d="M 0 0 C 0 0 4.27 0 5.91 0 C 7.54 0 11.81 0 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 14.03 0) translate(-0.22,0) matrix(0.8 0.0 0.0 0.8 2.44 -2.74)"><foreignObject style="--ltx-fo-width:3.95em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="54.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F14.pic1.m8" class="ltx_Math" alttext="y_{1}=2-\alpha" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mrow><mn>2</mn><mo>−</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">y_{1}=2-\alpha</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.77)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="1.6pt" transform="matrix(1 0 0 -1 0 0) translate(1.11,0)"><path style="fill:none" d="M 0 0 C 0 0 4.27 0 5.91 0 C 7.54 0 11.81 0 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 14.03 0) translate(-0.22,0) matrix(0.8 0.0 0.0 0.8 2.44 -3.68)"><foreignObject style="--ltx-fo-width:3.77em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.19em;font-size:10pt;" height="13.95" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="52.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F14.pic1.m9" class="ltx_Math" alttext="y_{2}=2^{1-\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>=</mo><msup><mn>2</mn><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msup></mrow><annotation encoding="application/x-tex">y_{2}=2^{1-\alpha}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 35.87)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="1.6pt" transform="matrix(1 0 0 -1 0 0) translate(1.11,0)"><path style="fill:none" d="M 0 0 C 0 0 4.27 0 5.91 0 C 7.54 0 11.81 0 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 14.03 0) translate(-0.22,0) matrix(0.8 0.0 0.0 0.8 2.44 -3.68)"><foreignObject style="--ltx-fo-width:8.83em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="122.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F14.pic1.m10" class="ltx_Math" alttext="y_{3}=(\alpha^{2}-2\alpha+2)^{1-\frac{\alpha}{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>3</mn></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mi>α</mi><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">y_{3}=(\alpha^{2}-2\alpha+2)^{1-\frac{\alpha}{2}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 14: </span><span id="S19.F14.4" class="ltx_text ltx_font_bold">Left:</span> Three mask-type data augmentations on the hypercube data model. <span id="S19.F14.5" class="ltx_text ltx_font_bold">Right:</span> Their theoretical <math id="S19.F14.m3" class="ltx_Math" alttext="\kappa^{2/d_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mrow><mn>2</mn><mo>/</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup><annotation encoding="application/x-tex">\kappa^{2/d_{\mathcal{X}}}</annotation></semantics></math> with different mask ratio <math id="S19.F14.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</figcaption>
</figure>
<div id="chapter5.Thmtheorem2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem2.2" class="ltx_text ltx_font_bold">Example 5.2</span></span><span id="chapter5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem2.p1" class="ltx_para">
<p id="chapter5.Thmtheorem2.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Consider a <em id="chapter5.Thmtheorem2.p1.1.1.1" class="ltx_emph ltx_font_upright">random masking</em> augmentation, i.e. for any <math id="chapter5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>, each coordinate <math id="chapter5.Thmtheorem2.p1.m2" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> is randomly and independently masked to be <math id="chapter5.Thmtheorem2.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> (i.e. <math id="chapter5.Thmtheorem2.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> denotes the <span id="chapter5.Thmtheorem2.p1.1.1.2" class="ltx_text ltx_font_typewriter">[MASK]</span> token)
with probability <math id="chapter5.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math> .
Then, its context complexity is given by <math id="chapter5.Thmtheorem2.p1.m6" class="ltx_Math" alttext="\kappa_{r}^{2}=(2-\alpha)^{d_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>r</mi><mn>2</mn></msubsup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{r}^{2}=(2-\alpha)^{d_{\mathcal{X}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter5.Thmtheorem3" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem3.2" class="ltx_text ltx_font_bold">Example 5.3</span></span><span id="chapter5.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem3.p1" class="ltx_para">
<p id="chapter5.Thmtheorem3.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Consider <em id="chapter5.Thmtheorem3.p1.1.1.1" class="ltx_emph ltx_font_upright">random block masking</em>,
i.e. masking <math id="chapter5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="x^{(i)},x^{(i+1)},\cdots,x^{(i+r-1)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>r</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x^{(i)},x^{(i+1)},\cdots,x^{(i+r-1)}</annotation></semantics></math> for <math id="chapter5.Thmtheorem3.p1.m2" class="ltx_Math" alttext="r=\lceil\alpha d_{{\mathcal{X}}}\rceil" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">r=\lceil\alpha d_{{\mathcal{X}}}\rceil</annotation></semantics></math> and a uniformly random <math id="chapter5.Thmtheorem3.p1.m3" class="ltx_Math" alttext="i\in[d_{{\mathcal{X}}}-r]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d_{{\mathcal{X}}}-r]</annotation></semantics></math>, for any <math id="chapter5.Thmtheorem3.p1.m4" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>.
Then, <math id="chapter5.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\kappa_{c}^{2}\leq[2^{(1-\alpha)}]^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>c</mi><mn>2</mn></msubsup><mo>≤</mo><msup><mrow><mo stretchy="false">[</mo><msup><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{c}^{2}\leq[2^{(1-\alpha)}]^{d_{{\mathcal{X}}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter5.Thmtheorem4" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Example 5.4</span></span><span id="chapter5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem4.p1" class="ltx_para">
<p id="chapter5.Thmtheorem4.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Consider <em id="chapter5.Thmtheorem4.p1.1.1.1" class="ltx_emph ltx_font_upright">random block masking with flipping</em>, where for any <math id="chapter5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>,
first mask <math id="chapter5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="x^{(i)},\cdots,x^{(i+r-1)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo>+</mo><mi>r</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x^{(i)},\cdots,x^{(i+r-1)}</annotation></semantics></math> to be <math id="chapter5.Thmtheorem4.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>
for <math id="chapter5.Thmtheorem4.p1.m4" class="ltx_Math" alttext="r=\lceil\alpha d_{{\mathcal{X}}}\rceil" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">r=\lceil\alpha d_{{\mathcal{X}}}\rceil</annotation></semantics></math> and a uniformly random <math id="chapter5.Thmtheorem4.p1.m5" class="ltx_Math" alttext="i\in[d_{{\mathcal{X}}}-r]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d_{{\mathcal{X}}}-r]</annotation></semantics></math>,
then randomly flip the sign of each remaining coordinate independently with probability <math id="chapter5.Thmtheorem4.p1.m6" class="ltx_Math" alttext="\frac{\alpha}{2}" display="inline" intent=":literal"><semantics><mfrac><mi>α</mi><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{\alpha}{2}</annotation></semantics></math>.
Then, its context complexity is bounded by <math id="chapter5.Thmtheorem4.p1.m7" class="ltx_Math" alttext="\kappa_{b}^{2}\leq\left[(\alpha^{2}-2\alpha+2)^{(1-\alpha/2)}\right]^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>κ</mi><mi>b</mi><mn>2</mn></msubsup><mo>≤</mo><msup><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo>]</mo></mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">\kappa_{b}^{2}\leq\left[(\alpha^{2}-2\alpha+2)^{(1-\alpha/2)}\right]^{d_{{\mathcal{X}}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S19.SS0.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="S19.SS0.SSS0.Px1.p2.1" class="ltx_p">See <a href="#chapter11.A1" title="Appendix 11.A Context Complexity of Masking ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.A</span></a> for the derivation of the above <math id="S19.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>.
<a href="#S19.F14" title="In Hypercube data model. ‣ 19 Context Complexity ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">14</span></a> (right) plots the <math id="S19.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\kappa^{2/d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mrow><mn>2</mn><mo>/</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup><annotation encoding="application/x-tex">\kappa^{2/d_{{\mathcal{X}}}}</annotation></semantics></math> for all three examples.
We can see that <math id="S19.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> becomes lower as the mask ratio <math id="S19.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> increases.
Moreover, when <math id="S19.SS0.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math> is fixed, Cutout-like masking has a lower <math id="S19.SS0.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> than independent random masking, and BERT-like masking has a lower <math id="S19.SS0.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> than Cutout-like masking.
Cutout has a weaker association than random masking, and BERT has an even weaker association.
Thus, these examples show that <math id="S19.SS0.SSS0.Px1.p2.m8" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is lower when the association is weaker.</p>
</div>
<div id="S19.SS0.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="S19.SS0.SSS0.Px1.p3.1" class="ltx_p">Another observation is that all three <math id="S19.SS0.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> have an exponential dependency on <math id="S19.SS0.SSS0.Px1.p3.m2" class="ltx_Math" alttext="d_{{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">d_{{\mathcal{X}}}</annotation></semantics></math>.
This is a manifestation of the typical curse of dimensionality in high-dimensional statistics.
One way to make <math id="S19.SS0.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> polynomial in <math id="S19.SS0.SSS0.Px1.p3.m4" class="ltx_Math" alttext="d_{{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">d_{{\mathcal{X}}}</annotation></semantics></math> is to use a context with very weak association, such as a very strong data augmentation.
For example, if <math id="S19.SS0.SSS0.Px1.p3.m5" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> is a finite set with a small size, then <math id="S19.SS0.SSS0.Px1.p3.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> will be polynomial.
However, contexts with such weak association usually lead to substantially worse performance in practice.
The bounds to be proved in this chapter depend on <math id="S19.SS0.SSS0.Px1.p3.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> polynomially, meaning that they are not really useful in the high-dimensional scenario.
In practice, however, representation learning can still achieve good performances when the data dimension is high.
How to address this discrepancy is posed as an open problem.</p>
</div>
</section>
<section id="S19.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Real language models.</h4>

<div id="S19.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S19.SS0.SSS0.Px2.p1.1" class="ltx_p">Now let us estimate the <math id="S19.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> of some real language models.
We use the NLP dataset <span id="S19.SS0.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_typewriter">wikipedia-simple</span>, and consider the context of masking tokens, where <math id="S19.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a complete text whereas <math id="S19.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is a masked version of <math id="S19.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
Recall that <math id="S19.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\kappa^{2}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\kappa^{2}</annotation></semantics></math> is an upper bound of <math id="S19.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="{k_{X}^{+}}(x,x)=\int\frac{P^{+}(x|a)P^{+}(a|x)}{{P_{\mathcal{X}}}(x)}da" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>a</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{k_{X}^{+}}(x,x)=\int\frac{P^{+}(x|a)P^{+}(a|x)}{{P_{\mathcal{X}}}(x)}da</annotation></semantics></math>.
For a fixed <math id="S19.SS0.SSS0.Px2.p1.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, this integration can be estimated with Monte Carlo (by sampling a set of <math id="S19.SS0.SSS0.Px2.p1.m8" class="ltx_math_unparsed" alttext="a\sim P^{+}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a\sim P^{+}(\cdot|x)</annotation></semantics></math>), and then <math id="S19.SS0.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\kappa^{2}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\kappa^{2}</annotation></semantics></math> can be estimated by its maximum over <math id="S19.SS0.SSS0.Px2.p1.m10" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>.
For <math id="S19.SS0.SSS0.Px2.p1.m11" class="ltx_Math" alttext="x=[x^{(1)},\cdots,x^{(l)}]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x=[x^{(1)},\cdots,x^{(l)}]</annotation></semantics></math> where <math id="S19.SS0.SSS0.Px2.p1.m12" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> is the <math id="S19.SS0.SSS0.Px2.p1.m13" class="ltx_Math" alttext="i^{th}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">i^{th}</annotation></semantics></math> token, we have</p>
<table id="S19.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S19.Ex41.m1" class="ltx_math_unparsed" alttext="\log P^{+}\left(x\middle|a\right)=\log P^{+}\left(x^{(1)}\middle|a\right)+\log P^{+}\left(x^{(2)}\middle|a,x^{(1)}\right)+\cdots+\log P^{+}\left(x^{(l)}\middle|a,x^{(1)},\cdots,x^{(l-1)}\right)." display="block" intent=":literal"><semantics><mrow><mi>log</mi><msup><mi>P</mi><mo>+</mo></msup><mrow><mo>(</mo><mi>x</mi><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>a</mi><mo>)</mo></mrow><mo>=</mo><mi>log</mi><msup><mi>P</mi><mo>+</mo></msup><mrow><mo>(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>a</mi><mo>)</mo></mrow><mo>+</mo><mi>log</mi><msup><mi>P</mi><mo>+</mo></msup><mrow><mo>(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>a</mi><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>log</mi><msup><mi>P</mi><mo>+</mo></msup><mrow><mo>(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>a</mi><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log P^{+}\left(x\middle|a\right)=\log P^{+}\left(x^{(1)}\middle|a\right)+\log P^{+}\left(x^{(2)}\middle|a,x^{(1)}\right)+\cdots+\log P^{+}\left(x^{(l)}\middle|a,x^{(1)},\cdots,x^{(l-1)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S19.SS0.SSS0.Px2.p1.2" class="ltx_p">We can leverage a bi-directional masked language model such as a BERT, and then compute <math id="S19.SS0.SSS0.Px2.p1.m14" class="ltx_Math" alttext="P^{+}(x^{(i)}|a,x^{(&lt;i)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>a</mi><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>&lt;</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(x^{(i)}|a,x^{(&lt;i)})</annotation></semantics></math> auto-regressively:
For each <math id="S19.SS0.SSS0.Px2.p1.m15" class="ltx_Math" alttext="i\in[l]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[l]</annotation></semantics></math>, use the BERT to output <math id="S19.SS0.SSS0.Px2.p1.m16" class="ltx_Math" alttext="P^{+}(x^{(i)}|a,x^{(&lt;i)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>a</mi><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>&lt;</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(x^{(i)}|a,x^{(&lt;i)})</annotation></semantics></math>, and then replace <math id="S19.SS0.SSS0.Px2.p1.m17" class="ltx_Math" alttext="a^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">a^{(i)}</annotation></semantics></math> with <math id="S19.SS0.SSS0.Px2.p1.m18" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> for <math id="S19.SS0.SSS0.Px2.p1.m19" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math>.
As such, we can estimate <math id="S19.SS0.SSS0.Px2.p1.m20" class="ltx_Math" alttext="P^{+}(x|a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(x|a)</annotation></semantics></math>, and <math id="S19.SS0.SSS0.Px2.p1.m21" class="ltx_Math" alttext="{P_{\mathcal{X}}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{X}}}(x)</annotation></semantics></math> can be estimated by <math id="S19.SS0.SSS0.Px2.p1.m22" class="ltx_Math" alttext="P^{+}(x|a_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>a</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(x|a_{0})</annotation></semantics></math> where <math id="S19.SS0.SSS0.Px2.p1.m23" class="ltx_Math" alttext="a_{0}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>0</mn></msub><annotation encoding="application/x-tex">a_{0}</annotation></semantics></math> is a fully masked text.</p>
</div>
