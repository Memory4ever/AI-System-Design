L 185.56 39.24 L 186.18 39.15 L 186.79 39.14 L 187.41 39.11 L 188.03 39.08 L 188.65 39.03 L 189.27 38.93 L 189.89 38.88 L 190.5 38.74 L 191.12 38.68 L 191.74 38.54 L 192.36 38.46 L 192.98 38.38 L 193.6 38.36 L 194.22 38.36 L 194.83 38.35 L 195.45 38.33 L 196.07 38.22 L 196.69 38.15 L 197.31 38.14 L 197.93 38.06 L 198.55 37.85 L 199.16 37.82 L 199.78 37.8 L 200.4 37.78 L 201.02 37.71 L 201.64 37.67 L 202.26 37.65 L 202.88 37.54 L 203.49 37.49 L 204.11 37.45 L 204.73 37.17 L 205.35 37.14 L 205.97 37.07 L 206.59 37.04 L 207.21 37.02 L 207.82 37.01 L 208.44 36.83 L 209.06 36.81 L 209.68 36.7 L 210.3 36.64 L 210.92 36.6 L 211.53 36.49 L 212.15 36.45 L 212.77 36.37 L 213.39 36.31 L 214.01 36.28 L 214.63 36.2 L 215.25 36.19 L 215.86 36.17 L 216.48 36.01 L 217.1 35.94 L 217.72 35.84 L 218.34 35.81 L 218.96 35.77 L 219.58 35.73 L 220.19 35.71 L 220.81 35.7 L 221.43 35.6 L 222.05 35.59 L 222.67 35.55 L 223.29 35.46 L 223.91 35.34 L 224.52 35.31 L 225.14 35.1 L 225.76 35.07 L 226.38 35.03 L 227 34.99 L 227.62 34.95 L 228.23 34.93 L 228.85 34.84 L 229.47 34.82 L 230.09 34.7 L 230.71 34.66 L 231.33 34.64 L 231.95 34.45 L 232.56 34.45 L 233.18 34.39 L 233.8 34.39 L 234.42 34.34 L 235.04 34.26 L 235.66 34.23 L 236.28 34.15 L 236.89 34.13 L 237.51 34.09 L 238.13 34.02 L 238.75 34.01 L 239.37 33.88 L 239.99 33.8 L 240.61 33.79 L 241.22 33.79 L 241.84 33.62 L 242.46 33.62 L 243.08 33.51 L 243.7 33.51 L 244.32 33.41 L 244.93 33.34 L 245.55 33.24 L 246.17 33.17 L 246.79 33.17 L 247.41 33.16 L 248.03 33.12 L 248.65 33.11 L 249.26 33.1 L 249.88 33.08 L 250.5 32.95 L 251.12 32.85 L 251.74 32.83 L 252.36 32.72 L 252.98 32.55 L 253.59 32.43 L 254.21 32.39 L 254.83 32.33 L 255.45 32.29 L 256.07 32.24 L 256.69 32.22 L 257.31 32.2 L 257.92 32.19 L 258.54 32.16 L 259.16 32.12 L 259.78 32.08 L 260.4 32.05 L 261.02 31.93 L 261.64 31.78 L 262.25 31.75 L 262.87 31.75 L 263.49 31.72 L 264.11 31.66 L 264.73 31.56 L 265.35 31.54 L 265.96 31.48 L 266.58 31.47 L 267.2 31.41 L 267.82 31.36 L 268.44 31.32 L 269.06 31.26 L 269.68 31.25 L 270.29 31.1 L 270.91 31.08 L 271.53 31.04 L 272.15 31.01 L 272.77 30.95 L 273.39 30.92 L 274.01 30.83 L 274.62 30.81 L 275.24 30.72 L 275.86 30.71 L 276.48 30.53 L 277.1 30.53 L 277.72 30.5 L 278.34 30.46 L 278.95 30.36 L 279.57 30.36 L 280.19 30.35 L 280.81 30.2 L 281.43 30.17 L 282.05 30.14 L 282.66 30.12 L 283.28 30.09 L 283.9 30.06 L 284.52 30.04 L 285.14 29.99 L 285.76 29.89 L 286.38 29.87 L 286.99 29.86 L 287.61 29.82 L 288.23 29.8 L 288.85 29.72 L 289.47 29.65 L 290.09 29.59 L 290.71 29.52 L 291.32 29.51 L 291.94 29.49 L 292.56 29.48 L 293.18 29.44 L 293.8 29.25 L 294.42 29.24 L 295.04 29.23 L 295.65 29.19 L 296.27 29.15 L 296.89 29.03 L 297.51 28.98 L 298.13 28.9 L 298.75 28.89 L 299.36 28.79 L 299.98 28.73 L 300.6 28.68 L 301.22 28.64 L 301.84 28.61 L 302.46 28.55 L 303.08 28.55 L 303.69 28.53 L 304.31 28.5 L 304.93 28.46 L 305.55 28.3 L 306.17 28.26 L 306.79 28.22 L 307.41 28.19 L 308.02 27.98 L 308.64 27.88 L 309.26 27.87 L 309.88 27.86 L 310.5 27.82 L 311.12 27.79 L 311.74 27.73 L 312.35 27.69 L 312.97 27.68 L 313.59 27.67 L 314.21 27.59 L 314.83 27.53 L 315.45 27.45 L 316.07 27.39"></path></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 53.28 6.13)"><foreignObject style="--ltx-fo-width:0.34em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.13" overflow="visible" transform="matrix(1 0 0 -1 0 9.13)" width="4.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m23" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 1.69 56.45)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.34" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m24" class="ltx_Math" alttext="s_{i}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">s_{i}^{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -35.09 -25.52)"><foreignObject style="--ltx-fo-width:9.51em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="131.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.3" class="ltx_text">(c) Strong association</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>The association between <math id="S3.F2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S3.F2.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> determines the shape of the spectrum.</figcaption>
</figure>
<div id="S3.p9" class="ltx_para ltx_noindent">
<p id="S3.p9.1" class="ltx_p">The set of eigenvalues <math id="S3.p9.m1" class="ltx_Math" alttext="{\left\{s_{0}^{2},s_{1}^{2},\cdots\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msubsup><mi>s</mi><mn>0</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>}</mo></mrow><annotation encoding="application/x-tex">{\left\{s_{0}^{2},s_{1}^{2},\cdots\right\}}</annotation></semantics></math> is called the <span id="S3.p9.1.1" class="ltx_text ltx_font_bold">spectrum</span> of the context.
The shape of the spectrum, or more precisely the decay rate of the eigenvalues, is determined by the strength of association between <math id="S3.p9.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S3.p9.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, which we also call the <span id="S3.p9.1.2" class="ltx_text ltx_font_bold">association of the context</span>.
In general, the stronger the association, the slower the decay.
Consider two extreme cases: (i) When <math id="S3.p9.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S3.p9.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are independent, the association is the weakest; (ii) When <math id="S3.p9.m6" class="ltx_Math" alttext="A=X" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">A=X</annotation></semantics></math>, the association is the strongest.
In case (i), only <math id="S3.p9.m7" class="ltx_Math" alttext="s_{0}^{2}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>0</mn><mn>2</mn></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s_{0}^{2}=1</annotation></semantics></math> is positive, and all other eigenvalues are <math id="S3.p9.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, so the eigenvalues decay the fastest.
In case (ii), all eigenvalues are <math id="S3.p9.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, so there is no decay at all (in fact, in this case <math id="S3.p9.m10" class="ltx_Math" alttext="T_{{k_{X}^{+}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><annotation encoding="application/x-tex">T_{{k_{X}^{+}}}</annotation></semantics></math> is not Hilbert-Schmidt if <math id="S3.p9.m11" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> and <math id="S3.p9.m12" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> are infinite sets).
<a href="#S3.F2" title="In 3 Spectral Properties of a Context ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2</span></a> illustrates the spectrum on different association levels.</p>
</div>
<div id="S3.p10" class="ltx_para ltx_noindent">
<p id="S3.p10.1" class="ltx_p">There are two key results in the contexture theory.
First, a useful context should have a moderate association, and its eigenvalues should decay neither too fast nor too slowly.
Obviously, the context in either extreme case above is useless, since <math id="S3.p10.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> provide no additional information.
Second, given a context, among all <math id="S3.p10.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional encoders, the “optimal” one (“optimal” to be formally defined later) should recover the linear space spanned by <math id="S3.p10.m3" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d}</annotation></semantics></math>, for which we say that the encoder learns the contexture of <math id="S3.p10.m4" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</p>
</div>
<div id="chapter1.Thmtheorem7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem7.2" class="ltx_text ltx_font_bold">Definition 1.7</span></span><span id="chapter1.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem7.p1" class="ltx_para">
<p id="chapter1.Thmtheorem7.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">A deterministic <math id="chapter1.Thmtheorem7.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional encoder <math id="chapter1.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\Phi=[\phi_{1},\cdots,\phi_{d}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi=[\phi_{1},\cdots,\phi_{d}]</annotation></semantics></math> <span id="chapter1.Thmtheorem7.p1.1.1.1" class="ltx_text ltx_font_bold">learns the contexture</span> of <math id="chapter1.Thmtheorem7.p1.m3" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>, if there exists a set of top-<math id="chapter1.Thmtheorem7.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions <math id="chapter1.Thmtheorem7.p1.m5" class="ltx_Math" alttext="{\left\{\mu_{1},\cdots,\mu_{d}\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub><mo>}</mo></mrow><annotation encoding="application/x-tex">{\left\{\mu_{1},\cdots,\mu_{d}\right\}}</annotation></semantics></math> of <math id="chapter1.Thmtheorem7.p1.m6" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> (excluding <math id="chapter1.Thmtheorem7.p1.m7" class="ltx_Math" alttext="\mu_{0}\equiv 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>≡</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mu_{0}\equiv 1</annotation></semantics></math>), such that <math id="chapter1.Thmtheorem7.p1.m8" class="ltx_Math" alttext="{\textnormal{span}}{\left\{\phi_{1},\cdots,\phi_{d}\right\}}={\textnormal{span}}{\left\{\mu_{1},\cdots,\mu_{d}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>}</mo></mrow></mrow><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}{\left\{\phi_{1},\cdots,\phi_{d}\right\}}={\textnormal{span}}{\left\{\mu_{1},\cdots,\mu_{d}\right\}}</annotation></semantics></math>.
If the multiplicity of <math id="chapter1.Thmtheorem7.p1.m9" class="ltx_Math" alttext="s_{d}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>d</mi></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s_{d}&gt;1</annotation></semantics></math>, then any set of top-<math id="chapter1.Thmtheorem7.p1.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions suffices. We also say that such a <math id="chapter1.Thmtheorem7.p1.m11" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> <span id="chapter1.Thmtheorem7.p1.1.1.2" class="ltx_text ltx_font_bold">extracts the top-<math id="chapter1.Thmtheorem7.p1.m12" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>𝐝</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace of <math id="chapter1.Thmtheorem7.p1.m13" class="ltx_Math" alttext="T_{{k_{X}^{+}}}" display="inline" intent=":literal"><semantics><msub><mi>𝐓</mi><msubsup><mi>𝐤</mi><mi>𝐗</mi><mo>+</mo></msubsup></msub><annotation encoding="application/x-tex">T_{{k_{X}^{+}}}</annotation></semantics></math></span>.</span></p>
</div>
</div>
<div id="chapter1.Thmtheorem8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem8.2" class="ltx_text ltx_font_bold">Definition 1.8</span></span><span id="chapter1.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem8.p1" class="ltx_para">
<p id="chapter1.Thmtheorem8.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">A randomized <math id="chapter1.Thmtheorem8.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional encoder <math id="chapter1.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\Phi=[\phi_{1},\cdots,\phi_{d}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi=[\phi_{1},\cdots,\phi_{d}]</annotation></semantics></math> <span id="chapter1.Thmtheorem8.p1.1.1.1" class="ltx_text ltx_font_bold">learns the contexture</span> of <math id="chapter1.Thmtheorem8.p1.m3" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math> (or extracts the top-<math id="chapter1.Thmtheorem8.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace of <math id="chapter1.Thmtheorem8.p1.m5" class="ltx_Math" alttext="T_{{k_{X}^{+}}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><annotation encoding="application/x-tex">T_{{k_{X}^{+}}}</annotation></semantics></math>), if it learns the contexture almost surely.</span></p>
</div>
</div>
<div id="chapter1.Thmtheorem9" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem9.2" class="ltx_text ltx_font_bold">Remark 1.9</span></span><span id="chapter1.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem9.p1" class="ltx_para">
<p id="chapter1.Thmtheorem9.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">In this definition, <math id="chapter1.Thmtheorem9.p1.m1" class="ltx_Math" alttext="\mu_{0}\equiv 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>≡</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mu_{0}\equiv 1</annotation></semantics></math> is excluded, because the bias term <math id="chapter1.Thmtheorem9.p1.m2" class="ltx_Math" alttext="{\bm{b}}" display="inline" intent=":literal"><semantics><mi>𝐛</mi><annotation encoding="application/x-tex">{\bm{b}}</annotation></semantics></math> in the downstream linear probe implicitly includes <math id="chapter1.Thmtheorem9.p1.m3" class="ltx_Math" alttext="\mu_{0}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mu_{0}</annotation></semantics></math>, so there is no reason to waste one dimension to encode <math id="chapter1.Thmtheorem9.p1.m4" class="ltx_Math" alttext="\mu_{0}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mu_{0}</annotation></semantics></math>.
Note that extracting the top-<math id="chapter1.Thmtheorem9.p1.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace only requires recovering the linear span, so any invertible linear transformation on <math id="chapter1.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> makes no difference.
A harder task is extracting the exact top-<math id="chapter1.Thmtheorem9.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions, which requires estimating every function <math id="chapter1.Thmtheorem9.p1.m8" class="ltx_Math" alttext="\mu_{i}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mu_{i}</annotation></semantics></math> for <math id="chapter1.Thmtheorem9.p1.m9" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>.
Although <math id="chapter1.Thmtheorem9.p1.m10" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> is independent of <math id="chapter1.Thmtheorem9.p1.m11" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>, the contexture of <math id="chapter1.Thmtheorem9.p1.m12" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math> depends on <math id="chapter1.Thmtheorem9.p1.m13" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>, since <math id="chapter1.Thmtheorem9.p1.m14" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d}</annotation></semantics></math> are defined w.r.t. <math id="chapter1.Thmtheorem9.p1.m15" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>. Thus, the same <math id="chapter1.Thmtheorem9.p1.m16" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> leads to different contextures when there is a distribution shift in <math id="chapter1.Thmtheorem9.p1.m17" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>, in which case we say that <span id="chapter1.Thmtheorem9.p1.1.1.1" class="ltx_text ltx_font_bold">the contexture is skewed</span>.</span></p>
</div>
</div>
<div id="S3.p11" class="ltx_para ltx_noindent">
<p id="S3.p11.1" class="ltx_p">The intuition why learning the contexture is ideal is that such a representation keeps the most information (variance) of the context, which is analogous to principal component analysis (PCA) in the finite-dimensional case.
Consider the case where <math id="S3.p11.m1" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> and <math id="S3.p11.m2" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> are both finite sets.
Let <math id="S3.p11.m3" class="ltx_Math" alttext="N=|{\mathcal{X}}|" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">N=|{\mathcal{X}}|</annotation></semantics></math> and <math id="S3.p11.m4" class="ltx_Math" alttext="M=|{\mathcal{A}}|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M=|{\mathcal{A}}|</annotation></semantics></math>.
Then, a function <math id="S3.p11.m5" class="ltx_Math" alttext="f\in{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math> is a vector in <math id="S3.p11.m6" class="ltx_Math" alttext="\mathbb{R}^{N}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{N}</annotation></semantics></math>, <math id="S3.p11.m7" class="ltx_Math" alttext="g\in{L^{2}(P_{\mathcal{A}})}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g\in{L^{2}(P_{\mathcal{A}})}</annotation></semantics></math> is a vector in <math id="S3.p11.m8" class="ltx_Math" alttext="\mathbb{R}^{M}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>M</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{M}</annotation></semantics></math>, and <math id="S3.p11.m9" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> is essentially a matrix <math id="S3.p11.m10" class="ltx_Math" alttext="{\bm{T}}\in\mathbb{R}^{N\times M}" display="inline" intent=":literal"><semantics><mrow><mi>𝑻</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{T}}\in\mathbb{R}^{N\times M}</annotation></semantics></math>.
Suppose we want to learn a <math id="S3.p11.m11" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional embedding <math id="S3.p11.m12" class="ltx_Math" alttext="{\bm{E}}\in\mathbb{R}^{N\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑬</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{E}}\in\mathbb{R}^{N\times d}</annotation></semantics></math> for the <math id="S3.p11.m13" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> samples in <math id="S3.p11.m14" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math>, and it should preserve the information of <math id="S3.p11.m15" class="ltx_Math" alttext="{\bm{T}}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">{\bm{T}}</annotation></semantics></math> as much as possible, then what should we do?
PCA states that we should use the top-<math id="S3.p11.m16" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> left singular vectors of <math id="S3.p11.m17" class="ltx_Math" alttext="{\bm{T}}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">{\bm{T}}</annotation></semantics></math> as <math id="S3.p11.m18" class="ltx_Math" alttext="{\bm{E}}" display="inline" intent=":literal"><semantics><mi>𝑬</mi><annotation encoding="application/x-tex">{\bm{E}}</annotation></semantics></math>, which are equivalent to the top-<math id="S3.p11.m19" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenvectors of <math id="S3.p11.m20" class="ltx_Math" alttext="{\bm{T}}{\bm{T}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑻</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑻</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{T}}{\bm{T}}^{\top}</annotation></semantics></math>, because they maximize the explained variance.
Similarly, functional spaces are essentially infinite-dimensional vector spaces, so the <math id="S3.p11.m21" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional embedding of <math id="S3.p11.m22" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> that preserves the most information of <math id="S3.p11.m23" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> consists of the top-<math id="S3.p11.m24" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> left singular functions of <math id="S3.p11.m25" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, or equivalently the top-<math id="S3.p11.m26" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="S3.p11.m27" class="ltx_Math" alttext="T_{P^{+}}T_{P^{+}}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">T_{P^{+}}T_{P^{+}}^{*}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Three Types of Access and Example Contexts</h3>

<div id="S4.p1" class="ltx_para ltx_noindent">
<p id="S4.p1.1" class="ltx_p">In reality, contexts can be provided in a variety of ways.
Let us analyze the examples in <a href="#S2" title="2 Contexts: Definition and Examples ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>.
Labels are usually provided one alongside each sample, that is the training set is <math id="S4.p1.m1" class="ltx_Math" alttext="{\left\{(x_{i},a_{i})\right\}}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">{\left\{(x_{i},a_{i})\right\}}_{i=1}^{m}</annotation></semantics></math>.
Random transformations are provided as subroutines, which can be called infinitely many times for the same input.
A graph is provided as either an adjacency list or an adjacency matrix; the former allows one to sample a neighbor of <math id="S4.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, and the latter can be viewed as a kernel.
Finally, when given a teacher model, we might not even know what space <math id="S4.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> it was trained on.</p>
</div>
<div id="S4.p2" class="ltx_para ltx_noindent">
<p id="S4.p2.1" class="ltx_p">Generally speaking, there are three types of access we can have to a context.
For the context of labels, we have <span id="S4.p2.1.1" class="ltx_text ltx_font_bold">pair access</span>.
For random transformations, we have <span id="S4.p2.1.2" class="ltx_text ltx_font_bold">transformation access</span>.
For a graph, if it is given by an adjacency matrix, then we have <span id="S4.p2.1.3" class="ltx_text ltx_font_bold">kernel access</span>; if it is given by an adjacency list, then we have transformation access.
As for the teacher model, we will show that we have kernel access to its context in <a href="#S8" title="8 Distilling Knowledge from Teacher Models ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">8</span></a>.</p>
</div>
<div id="chapter1.Thmtheorem10" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem10.2" class="ltx_text ltx_font_bold">Definition 1.10</span></span><span id="chapter1.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem10.p1" class="ltx_para">
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S4.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">We say that a context has </span><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">pair access</span><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, if we have access to a dataset of </span><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="{\left\{(x_{i},a_{i})\right\}}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">{\left\{(x_{i},a_{i})\right\}}_{i=1}^{m}</annotation></semantics></math><span id="S4.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> that is i.i.d. sampled from </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math><span id="S4.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S4.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">We say that a context has </span><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">kernel access</span><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> (</span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>𝒌</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I1.i2.p1.1.4" class="ltx_text ltx_font_bold ltx_font_italic">-access</span><span id="S4.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">), if we have access to a kernel </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="k:{\mathcal{X}}\times{\mathcal{X}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">k:{\mathcal{X}}\times{\mathcal{X}}\rightarrow\mathbb{R}</annotation></semantics></math><span id="S4.I1.i2.p1.1.6" class="ltx_text ltx_font_italic"> that approximates the dual kernel of the context. We do not need to know the space </span><math id="S4.I1.i2.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math><span id="S4.I1.i2.p1.1.7" class="ltx_text ltx_font_italic"> to have </span><math id="S4.I1.i2.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I1.i2.p1.1.8" class="ltx_text ltx_font_italic">-access.</span></p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">We say that a context has </span><span id="S4.I1.i3.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">transformation access</span><span id="S4.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> (</span><math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="S4.I1.i3.p1.1.4" class="ltx_text ltx_font_bold ltx_font_italic">-access</span><span id="S4.I1.i3.p1.1.5" class="ltx_text ltx_font_italic">), if for any </span><math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math><span id="S4.I1.i3.p1.1.6" class="ltx_text ltx_font_italic">, one can sample </span><math id="S4.I1.i3.p1.m3" class="ltx_math_unparsed" alttext="a\sim P^{+}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a\sim P^{+}(\cdot|x)</annotation></semantics></math><span id="S4.I1.i3.p1.1.7" class="ltx_text ltx_font_italic"> for arbitrarily many times.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.p3" class="ltx_para ltx_noindent">
<p id="S4.p3.1" class="ltx_p">In practice, for a context with <math id="S4.p3.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access, after randomly transforming an input <math id="S4.p3.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> to <math id="S4.p3.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, we usually want to map it back to the input space <math id="S4.p3.m4" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math>.
For example, after we apply random cropping to an image, we usually map it back to the original dimension by either stretching the crop or padding it with white pixels;
after masking a sentence, we fill in the masked position with a special token <span id="S4.p3.1.1" class="ltx_text ltx_font_typewriter">[MASK]</span>.
Such a mapping is called the heuristic inverse of <math id="S4.p3.m5" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>, which we denote by <math id="S4.p3.m6" class="ltx_Math" alttext="Q^{+}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>+</mo></msup><annotation encoding="application/x-tex">Q^{+}</annotation></semantics></math>.
Its expectation operator <math id="S4.p3.m7" class="ltx_Math" alttext="T_{Q^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>Q</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{Q^{+}}</annotation></semantics></math> is normally different from <math id="S4.p3.m8" class="ltx_Math" alttext="T_{P^{+}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><annotation encoding="application/x-tex">T_{P^{+}}^{*}</annotation></semantics></math>, because <math id="S4.p3.m9" class="ltx_Math" alttext="T_{P^{+}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><annotation encoding="application/x-tex">T_{P^{+}}^{*}</annotation></semantics></math> depends on <math id="S4.p3.m10" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math> while <math id="S4.p3.m11" class="ltx_Math" alttext="T_{Q^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>Q</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{Q^{+}}</annotation></semantics></math> in most cases does not depend on <math id="S4.p3.m12" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>.</p>
</div>
<div id="chapter1.Thmtheorem11" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem11.2" class="ltx_text ltx_font_bold">Definition 1.11</span></span><span id="chapter1.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem11.p1" class="ltx_para">
<p id="chapter1.Thmtheorem11.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">A user-defined conditional distribution <math id="chapter1.Thmtheorem11.p1.m1" class="ltx_Math" alttext="Q^{+}(x|a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>Q</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{+}(x|a)</annotation></semantics></math> that maps <math id="chapter1.Thmtheorem11.p1.m2" class="ltx_Math" alttext="a\in{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in{\mathcal{A}}</annotation></semantics></math> back to the input space <math id="chapter1.Thmtheorem11.p1.m3" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> is called the <span id="chapter1.Thmtheorem11.p1.1.1.1" class="ltx_text ltx_font_bold">heuristic inverse</span> of <math id="chapter1.Thmtheorem11.p1.m4" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.p4" class="ltx_para ltx_noindent">
<p id="S4.p4.1" class="ltx_p"><math id="S4.p4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access is stronger than pair access. For example, in supervised learning, the context has pair access but not <math id="S4.p4.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access, because the label of any <math id="S4.p4.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> outside the training set is not given, so we cannot sample <math id="S4.p4.m4" class="ltx_math_unparsed" alttext="A\sim P^{+}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A\sim P^{+}(\cdot|x)</annotation></semantics></math> for such <math id="S4.p4.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
As an exercise, the reader can think about what type of access each context in <a href="#S2.T1" title="In 2 Contexts: Definition and Examples ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a> has.</p>
</div>
<div id="S4.p5" class="ltx_para ltx_noindent">
<p id="S4.p5.1" class="ltx_p">Contexts with different types of access require different representation learning methods.
For example, contrastive learning <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite> needs to sample two views <math id="S4.p5.m1" class="ltx_math_unparsed" alttext="A,A^{+}\sim P^{+}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>+</mo></msup><mo>∼</mo><msup><mi>P</mi><mo>+</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A,A^{+}\sim P^{+}(\cdot|x)</annotation></semantics></math> for each training sample <math id="S4.p5.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, and this requires <math id="S4.p5.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access. If we only have pair access, then we might only have one <math id="S4.p5.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> for each <math id="S4.p5.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
In the next chapter, we will show how to learn the contexture for each type of access.</p>
</div>
<div id="S4.p6" class="ltx_para ltx_noindent">
<p id="S4.p6.1" class="ltx_p">In what follows, we analyze the three example contexts above in greater detail, and calculate their dual kernels.</p>
</div>
<div id="chapter1.Thmtheorem12" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem12.2" class="ltx_text ltx_font_bold">Example 1.12</span></span><span id="chapter1.Thmtheorem12.3" class="ltx_text ltx_font_bold"> </span>(Classification tasks)<span id="chapter1.Thmtheorem12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem12.p1" class="ltx_para">
<p id="chapter1.Thmtheorem12.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter1.Thmtheorem12.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}={\left\{1,2,\cdots,C\right\}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>C</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}={\left\{1,2,\cdots,C\right\}}</annotation></semantics></math> be a finite set of labels. The label is deterministic, meaning that each <math id="chapter1.Thmtheorem12.p1.m2" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math> is mapped to one label with probability <math id="chapter1.Thmtheorem12.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> by <math id="chapter1.Thmtheorem12.p1.m4" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>. Denote the label of <math id="chapter1.Thmtheorem12.p1.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> by <math id="chapter1.Thmtheorem12.p1.m6" class="ltx_Math" alttext="a_{x}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>x</mi></msub><annotation encoding="application/x-tex">a_{x}</annotation></semantics></math>.
The training set is <math id="chapter1.Thmtheorem12.p1.m7" class="ltx_Math" alttext="{\left\{(x_{i},a_{x_{i}})\right\}}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><msub><mi>x</mi><mi>i</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">{\left\{(x_{i},a_{x_{i}})\right\}}_{i=1}^{m}</annotation></semantics></math>, so this context has pair access.
For this context, <math id="chapter1.Thmtheorem12.p1.m8" class="ltx_math_unparsed" alttext="{k_{X}^{+}}(x,x^{\prime})={\mathbb{I}}[a_{x}=a_{x^{\prime}}]{P_{\mathcal{A}}}(A=a_{x})^{-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mi>x</mi></msub><mo>=</mo><msub><mi>a</mi><msup><mi>x</mi><mo>′</mo></msup></msub><mo stretchy="false">]</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>=</mo><msub><mi>a</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{k_{X}^{+}}(x,x^{\prime})={\mathbb{I}}[a_{x}=a_{x^{\prime}}]{P_{\mathcal{A}}}(A=a_{x})^{-1}</annotation></semantics></math>, <math id="chapter1.Thmtheorem12.p1.m9" class="ltx_Math" alttext="s_{0}=\cdots=s_{C-1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi>s</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s_{0}=\cdots=s_{C-1}=1</annotation></semantics></math>, and all other singular values are <math id="chapter1.Thmtheorem12.p1.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
The span of <math id="chapter1.Thmtheorem12.p1.m11" class="ltx_Math" alttext="\mu_{0},\cdots,\mu_{C-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>C</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mu_{0},\cdots,\mu_{C-1}</annotation></semantics></math> is the same as <math id="chapter1.Thmtheorem12.p1.m12" class="ltx_Math" alttext="{\textnormal{span}}{\left\{f_{1},\cdots,f_{C}\right\}}" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><mi>C</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}{\left\{f_{1},\cdots,f_{C}\right\}}</annotation></semantics></math>, where <math id="chapter1.Thmtheorem12.p1.m13" class="ltx_math_unparsed" alttext="f_{i}(x)={\mathbb{I}}[a_{x}=i]" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>a</mi><mi>x</mi></msub><mo>=</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">f_{i}(x)={\mathbb{I}}[a_{x}=i]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter1.Thmtheorem13" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem13.2" class="ltx_text ltx_font_bold">Example 1.13</span></span><span id="chapter1.Thmtheorem13.3" class="ltx_text ltx_font_bold"> </span>(Graphs)<span id="chapter1.Thmtheorem13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem13.p1" class="ltx_para">
<p id="chapter1.Thmtheorem13.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter1.Thmtheorem13.p1.m1" class="ltx_Math" alttext="{\mathcal{G}}=({\mathcal{V}},{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}=({\mathcal{V}},{\mathcal{E}})</annotation></semantics></math> be an undirected graph, where each edge <math id="chapter1.Thmtheorem13.p1.m2" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math> has a non-negative weight <math id="chapter1.Thmtheorem13.p1.m3" class="ltx_Math" alttext="w(u,v)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(u,v)</annotation></semantics></math> such that <math id="chapter1.Thmtheorem13.p1.m4" class="ltx_Math" alttext="w(u,v)=w(v,u)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w(u,v)=w(v,u)</annotation></semantics></math>.
Let <math id="chapter1.Thmtheorem13.p1.m5" class="ltx_Math" alttext="w(u,v)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w(u,v)=0</annotation></semantics></math> if <math id="chapter1.Thmtheorem13.p1.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="chapter1.Thmtheorem13.p1.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> are not connected.
Let the degree of node <math id="chapter1.Thmtheorem13.p1.m8" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> be <math id="chapter1.Thmtheorem13.p1.m9" class="ltx_Math" alttext="D(u)=\sum_{v\in{\mathcal{V}}}w(u,v)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D(u)=\sum_{v\in{\mathcal{V}}}w(u,v)</annotation></semantics></math>, and let <math id="chapter1.Thmtheorem13.p1.m10" class="ltx_Math" alttext="D_{\textnormal{sum}}=\sum_{u\in{\mathcal{V}}}D(u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mtext>sum</mtext></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\textnormal{sum}}=\sum_{u\in{\mathcal{V}}}D(u)</annotation></semantics></math>.
Let <math id="chapter1.Thmtheorem13.p1.m11" class="ltx_Math" alttext="{P_{\mathcal{X}}}(u)=\frac{D(u)}{D_{\textnormal{sum}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>D</mi><mtext>sum</mtext></msub></mfrac></mrow><annotation encoding="application/x-tex">{P_{\mathcal{X}}}(u)=\frac{D(u)}{D_{\textnormal{sum}}}</annotation></semantics></math>, and <math id="chapter1.Thmtheorem13.p1.m12" class="ltx_Math" alttext="P^{+}(v|u)=\frac{w(u,v)}{D(u)}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo lspace="0em" rspace="0em">|</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P^{+}(v|u)=\frac{w(u,v)}{D(u)}</annotation></semantics></math>, where <math id="chapter1.Thmtheorem13.p1.m13" class="ltx_Math" alttext="{\mathcal{A}}={\mathcal{X}}={\mathcal{V}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">{\mathcal{A}}={\mathcal{X}}={\mathcal{V}}</annotation></semantics></math>.
Then, it can be shown that <math id="chapter1.Thmtheorem13.p1.m14" class="ltx_Math" alttext="{P_{\mathcal{A}}}={P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo>=</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}={P_{\mathcal{X}}}</annotation></semantics></math>, and <math id="chapter1.Thmtheorem13.p1.m15" class="ltx_Math" alttext="{k_{X}^{+}}(x,x^{\prime})=\frac{D_{\textnormal{sum}}}{D(x)D(x^{\prime})}\sum_{u\in{\mathcal{V}}}\frac{w(x,u)w(x^{\prime},u)}{D(u)}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msub><mi>D</mi><mtext>sum</mtext></msub><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mfrac><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">{k_{X}^{+}}(x,x^{\prime})=\frac{D_{\textnormal{sum}}}{D(x)D(x^{\prime})}\sum_{u\in{\mathcal{V}}}\frac{w(x,u)w(x^{\prime},u)}{D(u)}</annotation></semantics></math>.
This graph is given by an adjacency list, and this context has <math id="chapter1.Thmtheorem13.p1.m16" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access.</span></p>
</div>
</div>
<div id="chapter1.Thmtheorem14" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter1.Thmtheorem14.2" class="ltx_text ltx_font_bold">Example 1.14</span></span><span id="chapter1.Thmtheorem14.3" class="ltx_text ltx_font_bold"> </span>(Random transformations on a finite input space)<span id="chapter1.Thmtheorem14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter1.Thmtheorem14.p1" class="ltx_para ltx_noindent">
<p id="chapter1.Thmtheorem14.p1.1" class="ltx_p"><span id="chapter1.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter1.Thmtheorem14.p1.m1" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> be a finite set, and let the context be given by a random transformation.
For example, if <math id="chapter1.Thmtheorem14.p1.m2" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> is the set of all text of up to <math id="chapter1.Thmtheorem14.p1.m3" class="ltx_Math" alttext="512" display="inline" intent=":literal"><semantics><mn>512</mn><annotation encoding="application/x-tex">512</annotation></semantics></math> tokens on a vocabulary of size <math id="chapter1.Thmtheorem14.p1.m4" class="ltx_Math" alttext="30,000" display="inline" intent=":literal"><semantics><mn>30,000</mn><annotation encoding="application/x-tex">30,000</annotation></semantics></math>, then <math id="chapter1.Thmtheorem14.p1.m5" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math> is a finite set.
Let <math id="chapter1.Thmtheorem14.p1.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> be the size of <math id="chapter1.Thmtheorem14.p1.m7" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math>.
Without loss of generality, assume that <math id="chapter1.Thmtheorem14.p1.m8" class="ltx_Math" alttext="{P_{\mathcal{X}}}(x)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{P_{\mathcal{X}}}(x)&gt;0</annotation></semantics></math> for every <math id="chapter1.Thmtheorem14.p1.m9" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>.
This context has <math id="chapter1.Thmtheorem14.p1.m10" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access.</span></p>
</div>
<div id="chapter1.Thmtheorem14.p2" class="ltx_para ltx_noindent">
<p id="chapter1.Thmtheorem14.p2.1" class="ltx_p"><span id="chapter1.Thmtheorem14.p2.1.1" class="ltx_text ltx_font_italic">The <span id="chapter1.Thmtheorem14.p2.1.1.1" class="ltx_text ltx_font_bold">transformation graph</span> <math id="chapter1.Thmtheorem14.p2.m1" class="ltx_Math" alttext="{\mathcal{G}}=({\mathcal{V}},{\mathcal{E}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}=({\mathcal{V}},{\mathcal{E}})</annotation></semantics></math> is defined as <math id="chapter1.Thmtheorem14.p2.m2" class="ltx_Math" alttext="{\mathcal{V}}={\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">{\mathcal{V}}={\mathcal{X}}</annotation></semantics></math>, and <math id="chapter1.Thmtheorem14.p2.m3" class="ltx_Math" alttext="(x_{1},x_{2})\in{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">(x_{1},x_{2})\in{\mathcal{E}}</annotation></semantics></math> if they can be transformed to the same <math id="chapter1.Thmtheorem14.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.
<a href="#S4.F3" title="In 4 Three Types of Access and Example Contexts ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a> gives an illustration of a transformation graph, which was originally introduced as the augmentation graph by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>]</cite> in the context of self-supervised learning based on data augmentation.</span></p>
</div>
<div id="chapter1.Thmtheorem14.p3" class="ltx_para">
<p id="chapter1.Thmtheorem14.p3.1" class="ltx_p"><span id="chapter1.Thmtheorem14.p3.1.1" class="ltx_text ltx_font_italic">Define matrix <math id="chapter1.Thmtheorem14.p3.m1" class="ltx_Math" alttext="{\bm{W}}\in\mathbb{R}^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>𝐖</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\mathbb{R}^{N\times N}</annotation></semantics></math> as <math id="chapter1.Thmtheorem14.p3.m2" class="ltx_Math" alttext="{\bm{W}}[i,j]=P^{+}(x_{i},x_{j})=\int P^{+}(x_{i}|a)P^{+}(x_{j}|a)d{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐖</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}[i,j]=P^{+}(x_{i},x_{j})=\int P^{+}(x_{i}|a)P^{+}(x_{j}|a)d{P_{\mathcal{A}}}(a)</annotation></semantics></math>, which is the weight of edge <math id="chapter1.Thmtheorem14.p3.m3" class="ltx_Math" alttext="(x_{i},x_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},x_{j})</annotation></semantics></math>.
Then, the degree of node <math id="chapter1.Thmtheorem14.p3.m4" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> is <math id="chapter1.Thmtheorem14.p3.m5" class="ltx_Math" alttext="\sum_{x}P^{+}(x_{i},x)={P_{\mathcal{X}}}(x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>x</mi></msub><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{x}P^{+}(x_{i},x)={P_{\mathcal{X}}}(x_{i})</annotation></semantics></math>.
Define matrix <math id="chapter1.Thmtheorem14.p3.m6" class="ltx_Math" alttext="{\bm{D}}\in\mathbb{R}^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{D}}\in\mathbb{R}^{N\times N}</annotation></semantics></math> as <math id="chapter1.Thmtheorem14.p3.m7" class="ltx_Math" alttext="{\bm{D}}={\textnormal{diag}}{\left\{{P_{\mathcal{X}}}(x_{1}),\cdots,{P_{\mathcal{X}}}(x_{N})\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{D}}={\textnormal{diag}}{\left\{{P_{\mathcal{X}}}(x_{1}),\cdots,{P_{\mathcal{X}}}(x_{N})\right\}}</annotation></semantics></math>. The singular function <math id="chapter1.Thmtheorem14.p3.m8" class="ltx_Math" alttext="\mu_{i}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mu_{i}</annotation></semantics></math> is now an <math id="chapter1.Thmtheorem14.p3.m9" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>-dimensional vector.
It is easy to see that <math id="chapter1.Thmtheorem14.p3.m10" class="ltx_Math" alttext="{\bm{W}}\mu_{i}=s_{i}^{2}{\bm{D}}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}\mu_{i}=s_{i}^{2}{\bm{D}}\mu_{i}</annotation></semantics></math>, that is <math id="chapter1.Thmtheorem14.p3.m11" class="ltx_Math" alttext="(s_{i}^{2},\mu_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s_{i}^{2},\mu_{i})</annotation></semantics></math> is a pair of generalized eigenvalue and eigenfunction.
We can also rewrite it as <math id="chapter1.Thmtheorem14.p3.m12" class="ltx_Math" alttext="({\bm{D}}-{\bm{W}})\mu_{i}=(1-s_{i}^{2}){\bm{D}}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐃</mi><mo>−</mo><mi>𝐖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">({\bm{D}}-{\bm{W}})\mu_{i}=(1-s_{i}^{2}){\bm{D}}\mu_{i}</annotation></semantics></math>, where <math id="chapter1.Thmtheorem14.p3.m13" class="ltx_Math" alttext="{\bm{D}}-{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>−</mo><mi>𝐖</mi></mrow><annotation encoding="application/x-tex">{\bm{D}}-{\bm{W}}</annotation></semantics></math> is the (unnormalized) Laplacian matrix of the transformation graph <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite>.
Thus, <math id="chapter1.Thmtheorem14.p3.m14" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d}</annotation></semantics></math> are the bottom eigenvectors of the graph Laplacian.</span></p>
</div>
</div>
