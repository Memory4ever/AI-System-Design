" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-dasharray="1.6pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="1.6pt" transform="matrix(1 0 0 -1 0 0) translate(1.11,0)"><path style="fill:none" d="M 0 0 L 5.91 0 L 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 14.03 0) translate(-0.19,0) matrix(0.7 0.0 0.0 0.7 2.13 -3.22)"><foreignObject style="--ltx-fo-width:4.46em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.19em;font-size:10pt;" height="13.95" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="61.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S26.F23.pic1.m35" class="ltx_Math" alttext="\chi^{2}" display="inline" intent=":literal"><semantics><msup><mi>χ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\chi^{2}</annotation></semantics></math><span id="S26.F23.pic1.30" class="ltx_text">-DORO</span></span></span></foreignObject></g></g></g></g></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 272.51 -246)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(58.28,0) translate(0,57.44)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 -5.15 L 0 0.75 M 36.63 -5.15 L 36.63 0.75 M 73.26 -5.15 L 73.26 0.75 M 0 56.7 L 0 50.79 M 36.63 56.7 L 36.63 50.79 M 73.26 56.7 L 73.26 50.79"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -7.14 6.59 L -1.24 6.59 M -7.14 30.97 L -1.24 30.97 M -7.14 55.35 L -1.24 55.35 M 78.58 6.59 L 72.67 6.59 M 78.58 30.97 L 72.67 30.97 M 78.58 55.35 L 72.67 55.35"></path></g><g style="--ltx-stroke-color:#000000;--ltx-f