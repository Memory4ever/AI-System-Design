;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 20.04 -12.02)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="16.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m26" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 34.31 -12.02)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="16.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m27" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 48.58 -12.02)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="16.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m28" class="ltx_Math" alttext="0.8" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.8</mn><annotation encoding="application/x-tex">0.8</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#0