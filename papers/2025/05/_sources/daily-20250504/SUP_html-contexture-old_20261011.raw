<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex190.m1" class="ltx_Math" alttext="\displaystyle={\bm{R}}^{-1}({\bm{I}}_{m+n}-\gamma{\bm{R}})^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝑹</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{R}}^{-1}({\bm{I}}_{m+n}-\gamma{\bm{R}})^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A6.p7" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p7.1" class="ltx_p">Now we bound <math id="chapter11.A6.p7.m1" class="ltx_Math" alttext="\|{\bm{u}}_{t}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝒖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\bm{u}}_{t}\|_{2}</annotation></semantics></math>.
First, note that for any matrices <math id="chapter11.A6.p7.m2" class="ltx_Math" alttext="{\bm{A}},{\bm{B}}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo>,</mo><mi>𝑩</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}},{\bm{B}}\in\mathbb{R}^{d\times d}</annotation></semantics></math> where <math id="chapter11.A6.p7.m3" class="ltx_Math" alttext="{\bm{B}}" display="inline" intent=":literal"><semantics><mi>𝑩</mi><annotation encoding="application/x-tex">{\bm{B}}</annotation></semantics></math> is <span id="chapter11.A6.p7.1.1" class="ltx_text ltx_font_italic">p.s.d.</span>,
there is <math id="chapter11.A6.p7.m4" class="ltx_Math" alttext="{\bm{u}}^{\top}{\bm{A}}^{\top}{\bm{B}}{\bm{A}}{\bm{u}}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}{\bm{u}}\|_{2}^{2}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}^{\top}{\bm{A}}\|_{2}\|{\bm{u}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝑩</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝑩</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝒖</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\top}{\bm{A}}^{\top}{\bm{B}}{\bm{A}}{\bm{u}}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}{\bm{u}}\|_{2}^{2}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}^{\top}{\bm{A}}\|_{2}\|{\bm{u}}\|_{2}^{2}</annotation></semantics></math> for any <math id="chapter11.A6.p7.m5" class="ltx_Math" alttext="{\bm{u}}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{u}}\in\mathbb{R}^{d}</annotation></semantics></math>,
so <math id="chapter11.A6.p7.m6" class="ltx_Math" alttext="\|{\bm{A}}^{\top}{\bm{B}}{\bm{A}}\|_{2}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}^{\top}{\bm{A}}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝑩</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\bm{A}}^{\top}{\bm{B}}{\bm{A}}\|_{2}\leq\|{\bm{B}}\|_{2}\|{\bm{A}}^{\top}{\bm{A}}\|_{2}</annotation></semantics></math>.
Second, note that the last <math id="chapter11.A6.p7.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> elements of <math id="chapter11.A6.p7.m8" class="ltx_Math" alttext="\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\bm{y}}}</annotation></semantics></math> are zeros,
which means that <math id="chapter11.A6.p7.m9" class="ltx_Math" alttext="\tilde{{\bm{y}}}=\tilde{{\bm{I}}}_{n}\tilde{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{y}}}=\tilde{{\bm{I}}}_{n}\tilde{{\bm{y}}}</annotation></semantics></math>. Thus, we have</p>
<table id="chapter11.A6.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A6.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex191.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{u}}_{t}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝒖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|{\bm{u}}_{t}\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex191.m2" class="ltx_Math" alttext="\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex192.m1" class="ltx_Math" alttext="\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑹</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{y}}}\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex193.m1" class="ltx_Math" alttext="\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}\tilde{{\bm{y}}}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑹</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r/2}\tilde{{\bm{I}}}_{n}\tilde{{\bm{y}}}\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex194.m1" class="ltx_Math" alttext="\displaystyle\leq{\left\|{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}\right\|}_{2}{\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}\tilde{{\bm{I}}}_{n}\right\|}_{2}{\left\|\tilde{{\bm{y}}}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑹</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\left\|{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}{\bm{R}}^{-1}{\left({\bm{I}}_{m+n}-\gamma{\bm{R}}\right)}^{t/2}\right\|}_{2}{\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}\tilde{{\bm{I}}}_{n}\right\|}_{2}{\left\|\tilde{{\bm{y}}}\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex195.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\tilde{\lambda}_{\min}}{\left\|{\bm{I}}_{m+n}-\gamma{\bm{R}}\right\|}_{2}^{t}(n\lambda_{1}^{r})\|{\bm{y}}\|_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>min</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mn>1</mn><mi>r</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\tilde{\lambda}_{\min}}{\left\|{\bm{I}}_{m+n}-\gamma{\bm{R}}\right\|}_{2}^{t}(n\lambda_{1}^{r})\|{\bm{y}}\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p7.2" class="ltx_p">where the last step is because we have already proved <math id="chapter11.A6.p7.m10" class="ltx_Math" alttext="{\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}\tilde{{\bm{I}}}_{n}\right\|}_{2}\leq n\lambda_{1}^{r}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑰</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mn>1</mn><mi>r</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|(m+n)\tilde{{\bm{I}}}_{n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{r}\tilde{{\bm{I}}}_{n}\right\|}_{2}\leq n\lambda_{1}^{r}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A6.p8" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p8.1" class="ltx_p">Now, for <math id="chapter11.A6.p8.m1" class="ltx_Math" alttext="\gamma=\frac{1}{n\lambda^{r}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\gamma=\frac{1}{n\lambda^{r}}</annotation></semantics></math>, when <math id="chapter11.A6.p8.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is sufficiently large it is less than <math id="chapter11.A6.p8.m3" class="ltx_Math" alttext="\frac{2}{\tilde{\lambda}_{\max}+\tilde{\lambda}_{\min}}" display="inline" intent=":literal"><semantics><mfrac><mn>2</mn><mrow><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>max</mi></msub><mo>+</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>min</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{2}{\tilde{\lambda}_{\max}+\tilde{\lambda}_{\min}}</annotation></semantics></math>, because <math id="chapter11.A6.p8.m4" class="ltx_Math" alttext="\beta_{n}=o(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{n}=o(1)</annotation></semantics></math>.
Thus, <math id="chapter11.A6.p8.m5" class="ltx_Math" alttext="{\left\|{\bm{I}}_{m+n}-\gamma{\bm{R}}\right\|}_{2}\leq 1-\frac{\tilde{\lambda}_{\min}}{n\lambda^{r}}\leq 1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>min</mi></msub><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow></mfrac></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{I}}_{m+n}-\gamma{\bm{R}}\right\|}_{2}\leq 1-\frac{\tilde{\lambda}_{\min}}{n\lambda^{r}}\leq 1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}</annotation></semantics></math>.
Thus, we have</p>
</div>
<div id="chapter11.A6.p9" class="ltx_para ltx_noindent">
<table id="chapter11.A6.Ex196" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex196.m1" class="ltx_Math" alttext="\|{\bm{u}}_{t}\|_{2}\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\frac{\lambda^{r}}{\beta_{n}\rho_{\min}}\|{\bm{y}}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝒖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>λ</mi><mi>r</mi></msup><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|{\bm{u}}_{t}\|_{2}\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\frac{\lambda^{r}}{\beta_{n}\rho_{\min}}\|{\bm{y}}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A6.p10" class="ltx_para ltx_noindent">
<p id="chapter11.A6.p10.1" class="ltx_p">The second part of this proof is to bound <math id="chapter11.A6.p10.m1" class="ltx_Math" alttext="\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\|_{2}</annotation></semantics></math>.
Let us return to <a href="#chapter11.A6.E41" title="In Appendix 11.F Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqn.</span> <span class="ltx_text ltx_ref_tag">41</span></a>, which says that</p>
<table id="chapter11.A6.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A6.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex197.m1" class="ltx_Math" alttext="\displaystyle{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t+1})\right\|}_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t+1})\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex197.m2" class="ltx_Math" alttext="\displaystyle={\left\|{\left({\bm{I}}_{m+n}-\gamma n\beta_{n}{\bm{Q}}\right)}{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})-\gamma{\bm{Q}}{\bm{u}}_{t}\right\|}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑰</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>t</mi></msub></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|{\left({\bm{I}}_{m+n}-\gamma n\beta_{n}{\bm{Q}}\right)}{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})-\gamma{\bm{Q}}{\bm{u}}_{t}\right\|}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex198.m1" class="ltx_Math" alttext="\displaystyle\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}+\frac{\rho_{\max}}{n\lambda^{r}}\|{\bm{u}}_{t}\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>ρ</mi><mi>max</mi></msub><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝒖</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}+\frac{\rho_{\max}}{n\lambda^{r}}\|{\bm{u}}_{t}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p10.2" class="ltx_p">Here again, we assume that <math id="chapter11.A6.p10.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is large enough so that <math id="chapter11.A6.p10.m3" class="ltx_Math" alttext="\lambda^{r}&gt;\beta_{n}\rho_{\min}" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mi>r</mi></msup><mo>&gt;</mo><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda^{r}&gt;\beta_{n}\rho_{\min}</annotation></semantics></math>. This implies that</p>
<table id="chapter11.A6.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A6.Ex199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex199.m1" class="ltx_Math" alttext="\displaystyle{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t+1})\right\|}_{2}-t{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t+1})\right\|}_{2}-t{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex200.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex200.m2" class="ltx_Math" alttext="\displaystyle{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}{\left[{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}-(t-1){\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t-1}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}\right]}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}{\left[{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}-(t-1){\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t-1}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A6.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A6.Ex201.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A6.Ex201.m2" class="ltx_Math" alttext="\displaystyle\cdots\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}{\left[{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}\right]}." display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdots\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}{\left[{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p10.3" class="ltx_p">Thus, there is <math id="chapter11.A6.p10.m4" class="ltx_Math" alttext="{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+t{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t-1}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+t{\left(1-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\right)}^{t-1}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}</annotation></semantics></math>.
Using <math id="chapter11.A6.p10.m5" class="ltx_Math" alttext="1-x\leq e^{-x}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>x</mi></mrow></msup></mrow><annotation encoding="application/x-tex">1-x\leq e^{-x}</annotation></semantics></math>, we have</p>
<table id="chapter11.A6.Ex202" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex202.m1" class="ltx_Math" alttext="{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\exp{\left(-\frac{\beta_{n}\rho_{\min}t}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+t\exp{\left(-\frac{\beta_{n}\rho_{\min}(t-1)}{\lambda^{r}}\right)}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\exp{\left(-\frac{\beta_{n}\rho_{\min}t}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+t\exp{\left(-\frac{\beta_{n}\rho_{\min}(t-1)}{\lambda^{r}}\right)}\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p10.4" class="ltx_p">When <math id="chapter11.A6.p10.m6" class="ltx_Math" alttext="t=t_{0}:=\frac{4\lambda^{r}}{\beta_{n}\rho_{\min}}\log\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub><mo>:=</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ρ</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">t=t_{0}:=\frac{4\lambda^{r}}{\beta_{n}\rho_{\min}}\log\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}</annotation></semantics></math>, by <math id="chapter11.A6.p10.m7" class="ltx_Math" alttext="\log(2x)\leq x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\log(2x)\leq x</annotation></semantics></math> for <math id="chapter11.A6.p10.m8" class="ltx_Math" alttext="x&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x&gt;0</annotation></semantics></math>, we have</p>
<table id="chapter11.A6.Ex203" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex203.m1" class="ltx_Math" alttext="\exp{\left(\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\frac{t}{2}\right)}\geq{\left(\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\right)}^{2}\geq\frac{4\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\log{\left(\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>t</mi><mn>2</mn></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ρ</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ρ</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ρ</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\exp{\left(\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}\frac{t}{2}\right)}\geq{\left(\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\right)}^{2}\geq\frac{4\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\log{\left(\frac{2\lambda^{r}\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}^{2}\rho_{\min}^{2}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p10.5" class="ltx_p">Let <math id="chapter11.A6.p10.m9" class="ltx_Math" alttext="F(t):=\exp{\left(\frac{\beta_{n}\rho_{\min}}{2\lambda^{r}}t\right)}-\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t):=\exp{\left(\frac{\beta_{n}\rho_{\min}}{2\lambda^{r}}t\right)}-\frac{\rho_{\max}\|{\bm{y}}\|_{2}}{n\beta_{n}\rho_{\min}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}}t</annotation></semantics></math>. Then we have <math id="chapter11.A6.p10.m10" class="ltx_Math" alttext="F(t_{0})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(t_{0})\geq 0</annotation></semantics></math>.
And it is easy to show that for all <math id="chapter11.A6.p10.m11" class="ltx_Math" alttext="t\geq\frac{t_{0}}{2}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mfrac><msub><mi>t</mi><mn>0</mn></msub><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">t\geq\frac{t_{0}}{2}</annotation></semantics></math>, there is <math id="chapter11.A6.p10.m12" class="ltx_Math" alttext="F^{\prime}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>F</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F^{\prime}(t)\geq 0</annotation></semantics></math>.
This means that when <math id="chapter11.A6.p10.m13" class="ltx_Math" alttext="t\geq t_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t\geq t_{0}</annotation></semantics></math>, there is <math id="chapter11.A6.p10.m14" class="ltx_Math" alttext="F(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(t)\geq 0</annotation></semantics></math>, so we have</p>
<table id="chapter11.A6.Ex204" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A6.Ex204.m1" class="ltx_Math" alttext="{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\exp{\left(-\frac{\beta_{n}\rho_{\min}t}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+\exp{\left(-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}{\left(\frac{t}{2}-1\right)}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mfrac><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><msup><mi>λ</mi><mi>r</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>t</mi><mn>2</mn></mfrac><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\exp{\left(-\frac{\beta_{n}\rho_{\min}t}{\lambda^{r}}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}+\exp{\left(-\frac{\beta_{n}\rho_{\min}}{\lambda^{r}}{\left(\frac{t}{2}-1\right)}\right)}\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A6.p10.6" class="ltx_p">Hence, when <math id="chapter11.A6.p10.m15" class="ltx_Math" alttext="t\geq\max{\left\{\frac{2\lambda^{r}}{\beta_{n}\rho_{\min}}\log\frac{2}{\epsilon}+2,t_{0}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>r</mi></msup></mrow><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>ϵ</mi></mfrac></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>,</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\geq\max{\left\{\frac{2\lambda^{r}}{\beta_{n}\rho_{\min}}\log\frac{2}{\epsilon}+2,t_{0}\right\}}</annotation></semantics></math>, we have <math id="chapter11.A6.p10.m16" class="ltx_Math" alttext="{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\epsilon\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝜽</mi><mo>∗</mo></msub><mo>−</mo><msub><mi>𝜽</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mo>∗</mo></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}({\bm{\theta}}_{*}-{\bm{\theta}}_{t})\right\|}_{2}\leq\epsilon\|{\bm{Q}}{\bm{\theta}}_{*}\|_{2}</annotation></semantics></math>, which implies that the relative estimation error of <math id="chapter11.A6.p10.m17" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}</annotation></semantics></math> is less than <math id="chapter11.A6.p10.m18" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.G </span>Proof of Theorem <a href="#chapter5.Thmtheorem26" title="Theorem 5.26 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.26</span></a></h2>

<div id="chapter11.A7.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A7.p1.1" class="ltx_p"><span id="chapter11.A7.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let us look at the three conditions used in <a href="#chapter5.Thmtheorem12" title="Theorem 5.12. ‣ Part (i) Estimation error bound for kernel ridge regression. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.12</span></a>.</p>
<ul id="chapter11.A7.I1" class="ltx_itemize">
<li id="chapter11.A7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="chapter11.A7.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A7.I1.i1.p1.1" class="ltx_p"><span id="chapter11.A7.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Eigenvalue decay (EVD):</span> This is a condition of the theorem.</p>
</div></li>
<li id="chapter11.A7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="chapter11.A7.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A7.I1.i2.p1.1" class="ltx_p"><span id="chapter11.A7.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Embedding condition (EMB):</span> For any <math id="chapter11.A7.I1.i2.p1.m1" class="ltx_Math" alttext="f=\sum u_{i}\mu_{i}\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f=\sum u_{i}\mu_{i}\in{{\mathcal{H}}_{k}}</annotation></semantics></math>, for <math id="chapter11.A7.I1.i2.p1.m2" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>-almost all <math id="chapter11.A7.I1.i2.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> we have <math id="chapter11.A7.I1.i2.p1.m4" class="ltx_Math" alttext="f(x)^{2}={\left(\sum u_{i}\mu_{i}(x)\right)}^{2}\leq{\left(\sum\frac{u_{i}^{2}}{\lambda_{i}}\right)}{\left(\sum\lambda_{i}\mu_{i}(x)^{2}\right)}\leq{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}\kappa^{2}\leq\kappa^{2}M{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><msup><mrow><mo>(</mo><mrow><mo lspace="0em">∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mo lspace="0em">∑</mo><mfrac><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup><msub><mi>λ</mi><mi>i</mi></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo lspace="0em">∑</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">f(x)^{2}={\left(\sum u_{i}\mu_{i}(x)\right)}^{2}\leq{\left(\sum\frac{u_{i}^{2}}{\lambda_{i}}\right)}{\left(\sum\lambda_{i}\mu_{i}(x)^{2}\right)}\leq{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}\kappa^{2}\leq\kappa^{2}M{\left\|f\right\|}_{{{\mathcal{H}}_{{k_{s}}}}}^{2}</annotation></semantics></math>. Thus, EMB holds with <math id="chapter11.A7.I1.i2.p1.m5" class="ltx_Math" alttext="c_{2}=\kappa\sqrt{M}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>M</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">c_{2}=\kappa\sqrt{M}</annotation></semantics></math>.</p>
</div></li>
<li id="chapter11.A7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="chapter11.A7.I1.i3.p1" class="ltx_para">
<p id="chapter11.A7.I1.i3.p1.1" class="ltx_p"><span id="chapter11.A7.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Source condition (SRC):</span> This holds with <math id="chapter11.A7.I1.i3.p1.m1" class="ltx_Math" alttext="c_{3}=\sqrt{\epsilon}{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>=</mo><mrow><msqrt><mi>ϵ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">c_{3}=\sqrt{\epsilon}{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="chapter11.A7.p1.2" class="ltx_p">Thus, the theorem can be proved using the result in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter11.A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 11.H </span>Proof of Theorem <a href="#chapter5.Thmtheorem28" title="Theorem 5.28 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.28</span></a></h2>

<div id="chapter11.Thmtheorem5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem5.2" class="ltx_text ltx_font_bold">Proposition 11.5</span></span><span id="chapter11.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem5.p1" class="ltx_para">
<p id="chapter11.Thmtheorem5.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">For any p.s.d. matrices <math id="chapter11.Thmtheorem5.p1.m1" class="ltx_Math" alttext="{\bm{A}},{\bm{B}}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐀</mi><mo>,</mo><mi>𝐁</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}},{\bm{B}}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, we have <math id="chapter11.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\Tr({\bm{A}}{\bm{B}})\leq{\left\|{\bm{A}}\right\|}_{2}\Tr({\bm{B}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mi>𝐀</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐁</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{A}}{\bm{B}})\leq{\left\|{\bm{A}}\right\|}_{2}\Tr({\bm{B}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter11.A8.p1" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p1.1" class="ltx_p"><span id="chapter11.A8.p1.1.1" class="ltx_text ltx_font_bold">Proof </span>
An elementary proof can be found at <a href="https://math.stackexchange.com/questions/2241879/reference-for-trace-norm-inequality" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://math.stackexchange.com/questions/2241879/reference-for-trace-norm-inequality</a>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma 11.6</span></span><span id="chapter11.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem6.p1" class="ltx_para ltx_noindent">
<p id="chapter11.Thmtheorem6.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="chapter11.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter11.Thmtheorem6.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> the following holds for all <math id="chapter11.Thmtheorem6.p1.m3" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>:</span></p>
<table id="chapter11.A8.Ex205" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex205.m1" class="ltx_Math" alttext="{\left|{\hat{k}^{p}}(x,x_{j})-k^{p}(x,x_{j})\right|}\leq{\left(p-1\right)}\lambda_{\max}^{p-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\quad\text{for all }j\in[m+n],x\in{\mathcal{X}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left|{\hat{k}^{p}}(x,x_{j})-k^{p}(x,x_{j})\right|}\leq{\left(p-1\right)}\lambda_{\max}^{p-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\quad\text{for all }j\in[m+n],x\in{\mathcal{X}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.Thmtheorem6.p1.2" class="ltx_p"><span id="chapter11.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">which implies that</span></p>
<table id="chapter11.A8.Ex206" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex206.m1" class="ltx_Math" alttext="{\left|{\hat{k}_{s}}(x,x_{j})-{k_{s}}(x,x_{j})\right|}\leq\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left|{\hat{k}_{s}}(x,x_{j})-{k_{s}}(x,x_{j})\right|}\leq\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter11.A8.p2" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p2.1" class="ltx_p"><span id="chapter11.A8.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
For any <math id="chapter11.A8.p2.m1" class="ltx_Math" alttext="x^{\prime}\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x^{\prime}\in{\mathcal{X}}</annotation></semantics></math> and any <math id="chapter11.A8.p2.m2" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, we have</p>
<table id="chapter11.A8.Ex207" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex207.m1" class="ltx_Math" alttext="{\left\|k^{p}(\cdot,x^{\prime})\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\sum_{i}\lambda_{i}^{p}\mu_{i}(x^{\prime})\mu_{i}(\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum_{i}\frac{\lambda_{i}^{2p}\mu_{i}(x^{\prime})^{2}}{\lambda_{i}}\leq\lambda_{1}^{2p-2}\kappa^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msubsup><mi>λ</mi><mi>i</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mfrac><mrow><msubsup><mi>λ</mi><mi>i</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>i</mi></msub></mfrac></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|k^{p}(\cdot,x^{\prime})\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\sum_{i}\lambda_{i}^{p}\mu_{i}(x^{\prime})\mu_{i}(\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum_{i}\frac{\lambda_{i}^{2p}\mu_{i}(x^{\prime})^{2}}{\lambda_{i}}\leq\lambda_{1}^{2p-2}\kappa^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p2.2" class="ltx_p">Let <math id="chapter11.A8.p2.m3" class="ltx_Math" alttext="F_{p}(x)={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{p}(x)={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k}(x)</annotation></semantics></math>, where <math id="chapter11.A8.p2.m4" class="ltx_Math" alttext="{\bm{u}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{u}}\in\mathbb{R}^{m+n}</annotation></semantics></math> satisfies <math id="chapter11.A8.p2.m5" class="ltx_Math" alttext="{\left\|{\bm{u}}\right\|}_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝒖</mi><mo>‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|{\bm{u}}\right\|}_{1}\leq 1</annotation></semantics></math>.
Since <math id="chapter11.A8.p2.m6" class="ltx_Math" alttext="{\left\langle k(x_{i},\cdot),k(x_{j},\cdot)\right\rangle}_{{{\mathcal{H}}_{k}}}=k(x_{i},x_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\langle k(x_{i},\cdot),k(x_{j},\cdot)\right\rangle}_{{{\mathcal{H}}_{k}}}=k(x_{i},x_{j})</annotation></semantics></math>, we have <math id="chapter11.A8.p2.m7" class="ltx_Math" alttext="{\left\langle{\bm{v}}_{k},{\bm{v}}_{k}\right\rangle}_{{{\mathcal{H}}_{k}}}={\bm{G}}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝒗</mi><mi>k</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><msub><mi>𝑮</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{\left\langle{\bm{v}}_{k},{\bm{v}}_{k}\right\rangle}_{{{\mathcal{H}}_{k}}}={\bm{G}}_{k}</annotation></semantics></math>. Thus,</p>
<table id="chapter11.A8.Ex208" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex208.m1" class="ltx_Math" alttext="{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\langle{\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k},{\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k}\right\rangle}_{{{\mathcal{H}}_{k}}}={\bm{u}}^{\top}\frac{{\bm{G}}_{k}^{2p+1}}{(m+n)^{2p}}{\bm{u}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>F</mi><mi>p</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\langle{\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k},{\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k}\right\rangle}_{{{\mathcal{H}}_{k}}}={\bm{u}}^{\top}\frac{{\bm{G}}_{k}^{2p+1}}{(m+n)^{2p}}{\bm{u}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p2.3" class="ltx_p">Since <math id="chapter11.A8.p2.m8" class="ltx_Math" alttext="{\bm{G}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{G}}_{k}</annotation></semantics></math> is <span id="chapter11.A8.p2.3.1" class="ltx_text ltx_font_italic">p.s.d.</span>, we can define <math id="chapter11.A8.p2.m9" class="ltx_Math" alttext="{\bm{G}}_{k}^{1/2}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><annotation encoding="application/x-tex">{\bm{G}}_{k}^{1/2}</annotation></semantics></math>.
Using <a href="#chapter11.Thmtheorem5" title="Proposition 11.5. ‣ Appendix 11.H Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">11.5</span></a>, we have</p>
<table id="chapter11.A8.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex209.m1" class="ltx_Math" alttext="\displaystyle{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><msub><mi>F</mi><mi>p</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex209.m2" class="ltx_Math" alttext="\displaystyle={\bm{u}}^{\top}\frac{{\bm{G}}_{k}^{2p+1}}{(m+n)^{2p}}{\bm{u}}=\Tr{\left\{{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{2p}{\bm{G}}_{k}^{1/2}{\bm{u}}\right\}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{u}}^{\top}\frac{{\bm{G}}_{k}^{2p+1}}{(m+n)^{2p}}{\bm{u}}=\Tr{\left\{{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{2p}{\bm{G}}_{k}^{1/2}{\bm{u}}\right\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex210.m1" class="ltx_Math" alttext="\displaystyle=\Tr{\left\{{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{2p}{\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right\}}\leq\hat{\lambda}_{1}^{2p}\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo>}</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Tr{\left\{{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{2p}{\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right\}}\leq\hat{\lambda}_{1}^{2p}\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p2.4" class="ltx_p">Moreover, <math id="chapter11.A8.p2.m10" class="ltx_Math" alttext="\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}\right)}={\bm{u}}^{\top}{\bm{G}}_{k}{\bm{u}}=\sum_{i,j=1}^{m+n}u_{i}u_{j}k(x_{i},x_{j})\leq\sum_{i,j=1}^{m+n}{\left|u_{i}u_{j}k(x_{i},x_{j})\right|}\leq\kappa^{2}{\left\|{\bm{u}}\right\|}_{1}^{2}\leq\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msubsup><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msubsup><mrow><mo>|</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝒖</mi><mo>‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}\right)}={\bm{u}}^{\top}{\bm{G}}_{k}{\bm{u}}=\sum_{i,j=1}^{m+n}u_{i}u_{j}k(x_{i},x_{j})\leq\sum_{i,j=1}^{m+n}{\left|u_{i}u_{j}k(x_{i},x_{j})\right|}\leq\kappa^{2}{\left\|{\bm{u}}\right\|}_{1}^{2}\leq\kappa^{2}</annotation></semantics></math>. Thus, we have <math id="chapter11.A8.p2.m11" class="ltx_Math" alttext="{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}\leq\hat{\lambda}_{1}^{p}\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>F</mi><mi>p</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|F_{p}\right\|}_{{{\mathcal{H}}_{k}}}\leq\hat{\lambda}_{1}^{p}\kappa</annotation></semantics></math> for all <math id="chapter11.A8.p2.m12" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A8.p3" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p3.1" class="ltx_p">For any <math id="chapter11.A8.p3.m1" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, define <math id="chapter11.A8.p3.m2" class="ltx_Math" alttext="{\bm{v}}_{k^{p}}(x)\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k^{p}}(x)\in\mathbb{R}^{m+n}</annotation></semantics></math> as <math id="chapter11.A8.p3.m3" class="ltx_Math" alttext="{\bm{v}}_{k^{p}}(x)[i]=k^{p}(x,x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k^{p}}(x)[i]=k^{p}(x,x_{i})</annotation></semantics></math> for <math id="chapter11.A8.p3.m4" class="ltx_Math" alttext="i\in[m+n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m+n]</annotation></semantics></math>. Then,</p>
<table id="chapter11.A8.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex211.m1" class="ltx_Math" alttext="\displaystyle{\left|k^{p}(x,x_{j})-{\hat{k}^{p}}(x,x_{j})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|k^{p}(x,x_{j})-{\hat{k}^{p}}(x,x_{j})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex212.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex212.m2" class="ltx_Math" alttext="\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{(m+n)^{p-1}}{\bm{v}}_{k}(x)^{\top}{\bm{G}}_{k}^{p-2}{\bm{v}}_{k}(x_{j})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{(m+n)^{p-1}}{\bm{v}}_{k}(x)^{\top}{\bm{G}}_{k}^{p-2}{\bm{v}}_{k}(x_{j})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex213.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex213.m2" class="ltx_Math" alttext="\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{m+n}{\bm{v}}_{k^{p-1}}(x)^{\top}{\bm{v}}_{k}(x_{j})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{m+n}{\bm{v}}_{k^{p-1}}(x)^{\top}{\bm{v}}_{k}(x_{j})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex214.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{q=1}^{p-2}\frac{1}{(m+n)^{q}}{\left|{\bm{v}}_{k^{p-q}}(x)^{\top}{\bm{G}}_{k}^{q-1}{\bm{v}}_{k}(x_{j})-{\bm{v}}_{k^{p-q-1}}(x)^{\top}\frac{{\bm{G}}_{k}^{q}}{m+n}{\bm{v}}_{k}(x_{j})\right|}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mfrac></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow></msup></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>𝒗</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mi>q</mi></msubsup><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><msub><mi>𝒗</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{q=1}^{p-2}\frac{1}{(m+n)^{q}}{\left|{\bm{v}}_{k^{p-q}}(x)^{\top}{\bm{G}}_{k}^{q-1}{\bm{v}}_{k}(x_{j})-{\bm{v}}_{k^{p-q-1}}(x)^{\top}\frac{{\bm{G}}_{k}^{q}}{m+n}{\bm{v}}_{k}(x_{j})\right|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p3.2" class="ltx_p">Since <math id="chapter11.A8.p3.m5" class="ltx_Math" alttext="f(z)=k^{p-1}(x,z)k(x_{j},z)\in{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f(z)=k^{p-1}(x,z)k(x_{j},z)\in{\mathcal{F}}</annotation></semantics></math>, where <math id="chapter11.A8.p3.m6" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> was defined in <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>,
the first term can be bounded as</p>
<table id="chapter11.A8.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex215.m1" class="ltx_Math" alttext="\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{m+n}{\bm{v}}_{k^{p-1}}(x)^{\top}{\bm{v}}_{k}(x_{j})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|k^{p}(x,x_{j})-\frac{1}{m+n}{\bm{v}}_{k^{p-1}}(x)^{\top}{\bm{v}}_{k}(x_{j})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex216.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex216.m2" class="ltx_Math" alttext="\displaystyle{\left|\int k^{p-1}(x,z)k(x_{j},z)d{P_{\mathcal{X}}}(z)-\frac{1}{m+n}\sum_{i=1}^{m+n}k^{p-1}(x,x_{i})k(x_{j},x_{i})\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|\int k^{p-1}(x,z)k(x_{j},z)d{P_{\mathcal{X}}}(z)-\frac{1}{m+n}\sum_{i=1}^{m+n}k^{p-1}(x,x_{i})k(x_{j},x_{i})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex217.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex217.m2" class="ltx_Math" alttext="\displaystyle\lambda_{1}^{p-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{1}^{p-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p3.3" class="ltx_p">where the last step uses <math id="chapter11.A8.p3.m7" class="ltx_Math" alttext="{\left\|k^{p-1}(x,\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\lambda_{1}^{p-2}\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|k^{p-1}(x,\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\lambda_{1}^{p-2}\kappa</annotation></semantics></math>, and <math id="chapter11.A8.p3.m8" class="ltx_Math" alttext="{\left\|k(x_{j},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">{\left\|k(x_{j},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\kappa</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A8.p4" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p4.1" class="ltx_p">For the second term, since <math id="chapter11.A8.p4.m1" class="ltx_Math" alttext="{\bm{v}}_{k}(x_{j})={\bm{G}}_{k}{\bm{e}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k}(x_{j})={\bm{G}}_{k}{\bm{e}}_{j}</annotation></semantics></math> where <math id="chapter11.A8.p4.m2" class="ltx_Math" alttext="{\bm{e}}_{j}=[0,\cdots,0,1,0,\cdots,0]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒆</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{e}}_{j}=[0,\cdots,0,1,0,\cdots,0]</annotation></semantics></math>, we have</p>
<table id="chapter11.A8.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex218.m1" class="ltx_Math" alttext="\displaystyle\sum_{q=1}^{p-2}\frac{1}{(m+n)^{q}}{\left|{\bm{v}}_{k^{p-q}}(x)^{\top}{\bm{G}}_{k}^{q-1}{\bm{v}}_{k}(x_{j})-{\bm{v}}_{k^{p-q-1}}(x)^{\top}\frac{{\bm{G}}_{k}^{q}}{m+n}{\bm{v}}_{k}(x_{j})\right|}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mi>q</mi></msubsup><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{q=1}^{p-2}\frac{1}{(m+n)^{q}}{\left|{\bm{v}}_{k^{p-q}}(x)^{\top}{\bm{G}}_{k}^{q-1}{\bm{v}}_{k}(x_{j})-{\bm{v}}_{k^{p-q-1}}(x)^{\top}\frac{{\bm{G}}_{k}^{q}}{m+n}{\bm{v}}_{k}(x_{j})\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex219.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex219.m2" class="ltx_Math" alttext="\displaystyle{\left|\int k^{p-q-1}(x,z){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}(z)\right]}d{P_{\mathcal{X}}}(z)-\frac{1}{m+n}\sum_{j=1}^{m+n}k^{p-q-1}(x,x_{j}){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}(x_{j})\right]}\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></munderover></mstyle><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\left|\int k^{p-q-1}(x,z){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}(z)\right]}d{P_{\mathcal{X}}}(z)-\frac{1}{m+n}\sum_{j=1}^{m+n}k^{p-q-1}(x,x_{j}){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}(x_{j})\right]}\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex220.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex220.m2" class="ltx_Math" alttext="\displaystyle\lambda_{1}^{p-q-2}\hat{\lambda}_{1}^{q}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mi>q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{1}^{p-q-2}\hat{\lambda}_{1}^{q}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p4.2" class="ltx_p">where the last step uses <math id="chapter11.A8.p4.m3" class="ltx_Math" alttext="{\left\|k^{p-q-1}(x,\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\lambda_{1}^{p-q-2}\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mi>p</mi><mo>−</mo><mi>q</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|k^{p-q-1}(x,\cdot)\right\|}_{{{\mathcal{H}}_{k}}}\leq\lambda_{1}^{p-q-2}\kappa</annotation></semantics></math>, and <math id="chapter11.A8.p4.m4" class="ltx_Math" alttext="{\left\|{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}\right\|}_{{{\mathcal{H}}_{k}}}\leq\hat{\lambda}_{1}^{q}\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mi>q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q}{\bm{v}}_{k}\right\|}_{{{\mathcal{H}}_{k}}}\leq\hat{\lambda}_{1}^{q}\kappa</annotation></semantics></math> since <math id="chapter11.A8.p4.m5" class="ltx_Math" alttext="{\left\|{\bm{e}}_{j}\right\|}_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝒆</mi><mi>j</mi></msub><mo>‖</mo></mrow><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|{\bm{e}}_{j}\right\|}_{1}=1</annotation></semantics></math>.
Finally, note that <math id="chapter11.A8.p4.m6" class="ltx_Math" alttext="\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}=\sum_{p=1}^{\infty}\pi_{p}(p-1)\lambda^{p-2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}=\sum_{p=1}^{\infty}\pi_{p}(p-1)\lambda^{p-2}</annotation></semantics></math>. Combining all of the above yields the result.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.Thmtheorem7" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter11.Thmtheorem7.2" class="ltx_text ltx_font_bold">Corollary 11.7</span></span><span id="chapter11.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter11.Thmtheorem7.p1" class="ltx_para">
<p id="chapter11.Thmtheorem7.p1.1" class="ltx_p"><span id="chapter11.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Under the settings of <a href="#chapter11.Thmtheorem6" title="Lemma 11.6. ‣ Appendix 11.H Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">11.6</span></a>, we have</span></p>
<table id="chapter11.A8.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex221.m1" class="ltx_Math" alttext="\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|+\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>k</mi><msup><mi>s</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|+\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex222.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex222.m2" class="ltx_Math" alttext="\displaystyle 2s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.Thmtheorem7.p1.2" class="ltx_p"><span id="chapter11.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">holds for all <math id="chapter11.Thmtheorem7.p1.m1" class="ltx_Math" alttext="i,j\in[m+n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[m+n]</annotation></semantics></math>, where <math id="chapter11.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\lambda_{\max}=\max{\left\{\lambda_{1},\hat{\lambda}_{1}\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\max}=\max{\left\{\lambda_{1},\hat{\lambda}_{1}\right\}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter11.A8.p5" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p5.1" class="ltx_p"><span id="chapter11.A8.p5.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="chapter11.A8.p5.m1" class="ltx_Math" alttext="F_{p,q}(x)={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k^{q}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><msup><mi>k</mi><mi>q</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{p,q}(x)={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{v}}_{k^{q}}(x)</annotation></semantics></math>
for any <math id="chapter11.A8.p5.m2" class="ltx_Math" alttext="\|{\bm{u}}\|_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝒖</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|{\bm{u}}\|_{1}\leq 1</annotation></semantics></math> and any <math id="chapter11.A8.p5.m3" class="ltx_Math" alttext="p\geq 0,q\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>≥</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>q</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p\geq 0,q\geq 1</annotation></semantics></math>.
By <a href="#chapter11.Thmtheorem5" title="Proposition 11.5. ‣ Appendix 11.H Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">11.5</span></a>, we have</p>
<table id="chapter11.A8.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex223.m1" class="ltx_Math" alttext="\displaystyle\|F_{p,q}\|_{{\mathcal{H}}_{k}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>F</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|F_{p,q}\|_{{\mathcal{H}}_{k}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex223.m2" class="ltx_Math" alttext="\displaystyle={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{G}}_{k^{2q-1}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{u}}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{G}}_{k^{2q-1}}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p}{\bm{u}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex224.m1" class="ltx_Math" alttext="\displaystyle=\Tr{\left({\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1/2}\frac{{\bm{G}}_{k^{2q-1}}}{m+n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1/2}{\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Tr{\left({\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1/2}\frac{{\bm{G}}_{k^{2q-1}}}{m+n}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1/2}{\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex225.m1" class="ltx_Math" alttext="\displaystyle\leq\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\Tr{\left({\bm{G}}_{k}^{1/2}{\bm{u}}{\bm{u}}^{\top}{\bm{G}}_{k}^{1/2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex226"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex226.m1" class="ltx_Math" alttext="\displaystyle=\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}{\bm{u}}^{\top}{\bm{G}}_{k}{\bm{u}}\leq\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\kappa^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}{\bm{u}}^{\top}{\bm{G}}_{k}{\bm{u}}\leq\hat{\lambda}_{1}^{2p-1}{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\kappa^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A8.p6" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p6.1" class="ltx_p">For any unit vector <math id="chapter11.A8.p6.m1" class="ltx_Math" alttext="{\bm{w}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒘</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{w}}\in\mathbb{R}^{m+n}</annotation></semantics></math>, we have</p>
<table id="chapter11.A8.Ex227" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex227.m1" class="ltx_Math" alttext="\hat{\lambda}_{1}\geq{\bm{w}}^{\top}\frac{{\bm{G}}_{k}}{m+n}{\bm{w}}=\frac{1}{m+n}\sum_{i,j=1}^{m+n}w_{i}w_{j}K(x_{i},x_{j})=\frac{1}{m+n}\sum_{t}\lambda_{t}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub><mo>≥</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></munderover><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>t</mi></munder><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{1}\geq{\bm{w}}^{\top}\frac{{\bm{G}}_{k}}{m+n}{\bm{w}}=\frac{1}{m+n}\sum_{i,j=1}^{m+n}w_{i}w_{j}K(x_{i},x_{j})=\frac{1}{m+n}\sum_{t}\lambda_{t}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p6.2" class="ltx_p">where <math id="chapter11.A8.p6.m2" class="ltx_Math" alttext="{\bm{M}}_{t}\in\mathbb{R}^{(m+n)\times(m+n)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑴</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{M}}_{t}\in\mathbb{R}^{(m+n)\times(m+n)}</annotation></semantics></math> is defined as <math id="chapter11.A8.p6.m3" class="ltx_Math" alttext="{\bm{M}}_{t}[i,j]=\mu_{t}(x_{i})\mu_{t}(x_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑴</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}_{t}[i,j]=\mu_{t}(x_{i})\mu_{t}(x_{j})</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter11.A8.Ex228" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.Ex228.m1" class="ltx_Math" alttext="{\bm{w}}^{\top}\frac{{\bm{G}}_{k^{2q-1}}}{m+n}{\bm{w}}=\frac{1}{m+n}\sum_{t}\lambda_{t}^{2q-1}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}}\leq\lambda_{1}^{2q-2}\frac{1}{m+n}\sum_{t}\lambda_{t}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>t</mi></munder><mrow><msubsup><mi>λ</mi><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>t</mi></munder><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{w}}^{\top}\frac{{\bm{G}}_{k^{2q-1}}}{m+n}{\bm{w}}=\frac{1}{m+n}\sum_{t}\lambda_{t}^{2q-1}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}}\leq\lambda_{1}^{2q-2}\frac{1}{m+n}\sum_{t}\lambda_{t}{\bm{w}}^{\top}{\bm{M}}_{t}{\bm{w}}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p6.3" class="ltx_p">which implies that <math id="chapter11.A8.p6.m4" class="ltx_Math" alttext="{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mfrac><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|\frac{{\bm{G}}_{k^{2q-1}}}{m+n}\right\|}_{2}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1}</annotation></semantics></math>. Thus, <math id="chapter11.A8.p6.m5" class="ltx_Math" alttext="\|F_{p,q}\|_{{\mathcal{H}}_{k}}^{2}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1}^{2p}\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>F</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\|F_{p,q}\|_{{\mathcal{H}}_{k}}^{2}\leq\lambda_{1}^{2q-2}\hat{\lambda}_{1}^{2p}\kappa^{2}</annotation></semantics></math>.</p>
</div>
<div id="chapter11.A8.p7" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p7.1" class="ltx_p">Note that <math id="chapter11.A8.p7.m1" class="ltx_Math" alttext="\langle{\bm{v}}_{k},{\bm{v}}_{k}\rangle_{P_{\mathcal{X}}}={\bm{G}}_{k^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝒗</mi><mi>k</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mn>2</mn></msup></msub></mrow><annotation encoding="application/x-tex">\langle{\bm{v}}_{k},{\bm{v}}_{k}\rangle_{P_{\mathcal{X}}}={\bm{G}}_{k^{2}}</annotation></semantics></math>. So for any <math id="chapter11.A8.p7.m2" class="ltx_Math" alttext="p,q\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p,q\geq 1</annotation></semantics></math> and any <math id="chapter11.A8.p7.m3" class="ltx_Math" alttext="i,j\in[m+n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[m+n]</annotation></semantics></math>, there is:</p>
<table id="chapter11.A8.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex229.m1" class="ltx_Math" alttext="\displaystyle\left|k^{p+q}(x_{i},x_{j})-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right|=\left|{\bm{e}}_{i}^{\top}{\bm{G}}_{k^{p+q}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{q+1}}{\bm{e}}_{j}\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>k</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|k^{p+q}(x_{i},x_{j})-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right|=\left|{\bm{e}}_{i}^{\top}{\bm{G}}_{k^{p+q}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{q+1}}{\bm{e}}_{j}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex230.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex230.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{p-1}\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-t}}{(m+n)^{p-t}}{\bm{G}}_{k^{q+t}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-t-1}}{(m+n)^{p-t-1}}{\bm{G}}_{k^{q+t+1}}{\bm{e}}_{j}\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>t</mi></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mi>t</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mi>t</mi></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{p-1}\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-t}}{(m+n)^{p-t}}{\bm{G}}_{k^{q+t}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-t-1}}{(m+n)^{p-t-1}}{\bm{G}}_{k^{q+t+1}}{\bm{e}}_{j}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex231.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex231.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{t=1}^{p-1}\left|\frac{1}{m+n}\sum_{l=1}^{m+n}{\left[{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-t-1}{\bm{v}}_{k}\right]}(x_{l}){\left[{\bm{e}}_{j}^{\top}{\bm{v}}_{k^{q+t}}\right]}(x_{l})\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></munderover></mstyle><mrow><mo>[</mo><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><mi>k</mi></msub><mo>]</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mi>t</mi></mrow></msup></msub><mo>]</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{p-1}\left|\frac{1}{m+n}\sum_{l=1}^{m+n}{\left[{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-t-1}{\bm{v}}_{k}\right]}(x_{l}){\left[{\bm{e}}_{j}^{\top}{\bm{v}}_{k^{q+t}}\right]}(x_{l})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex232.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.-{\left\langle{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-t-1}{\bm{v}}_{k},{\bm{e}}_{j}^{\top}{\bm{v}}_{k^{q+t}}\right\rangle}_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mrow><mo>⟨</mo><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mi>t</mi></mrow></msup></msub><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.-{\left\langle{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-t-1}{\bm{v}}_{k},{\bm{e}}_{j}^{\top}{\bm{v}}_{k^{q+t}}\right\rangle}_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex233.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex233.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{p-1}\lambda_{1}^{q+t-1}\hat{\lambda}_{1}^{p-t-1}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\leq(p-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mrow><mi>q</mi><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mi>p</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{p-1}\lambda_{1}^{q+t-1}\hat{\lambda}_{1}^{p-t-1}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\leq(p-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A8.p8" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p8.1" class="ltx_p">Thus, we have</p>
<table id="chapter11.A8.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex234"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex234.m1" class="ltx_Math" alttext="\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>k</mi><msup><mi>s</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex234.m2" class="ltx_Math" alttext="\displaystyle=\sum_{p,q=1}^{\infty}\left|\pi_{p}\pi_{q}{\left(k^{p+q}(x_{i},x_{j})-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right)}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mo>|</mo><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>k</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{p,q=1}^{\infty}\left|\pi_{p}\pi_{q}{\left(k^{p+q}(x_{i},x_{j})-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right)}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex235.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(p-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(p-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter11.A8.p9" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p9.1" class="ltx_p">Similarly, we can show that:</p>
<table id="chapter11.A8.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex236.m1" class="ltx_Math" alttext="\displaystyle\left|{\left\langle\hat{k}^{p}(x_{i},\cdot),\hat{k}^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>k</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|{\left\langle\hat{k}^{p}(x_{i},\cdot),\hat{k}^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex237.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex237.m2" class="ltx_Math" alttext="\displaystyle\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{2}}\frac{{\bm{G}}_{k}^{q-1}}{(m+n)^{q-1}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{q+1}}{\bm{e}}_{j}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{2}}\frac{{\bm{G}}_{k}^{q-1}}{(m+n)^{q-1}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{q+1}}{\bm{e}}_{j}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex238.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex238.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{q-1}\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{t+1}}\frac{{\bm{G}}_{k}^{q-t}}{(m+n)^{q-t}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{t+2}}\frac{{\bm{G}}_{k}^{q-t-1}}{(m+n)^{q-t-1}}{\bm{e}}_{j}\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>|</mo><mrow><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>q</mi><mo>−</mo><mi>t</mi></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo>−</mo><mi>t</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><msup><mi>k</mi><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>q</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mi>j</mi></msub></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{q-1}\left|{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{t+1}}\frac{{\bm{G}}_{k}^{q-t}}{(m+n)^{q-t}}{\bm{e}}_{j}-{\bm{e}}_{i}^{\top}\frac{{\bm{G}}_{k}^{p-1}}{(m+n)^{p-1}}{\bm{G}}_{k^{t+2}}\frac{{\bm{G}}_{k}^{q-t-1}}{(m+n)^{q-t-1}}{\bm{e}}_{j}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex239.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex239.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{t=1}^{q-1}\left|\frac{1}{m+n}\sum_{l=1}^{m+n}{\left[{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1}{\bm{v}}_{k^{t+1}}\right]}(x_{l}){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q-t-1}{\bm{v}}_{k}\right]}(x_{l})\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></munderover></mstyle><mrow><mo>[</mo><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>q</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><mi>k</mi></msub><mo>]</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{q-1}\left|\frac{1}{m+n}\sum_{l=1}^{m+n}{\left[{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1}{\bm{v}}_{k^{t+1}}\right]}(x_{l}){\left[{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q-t-1}{\bm{v}}_{k}\right]}(x_{l})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex240.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.-{\left\langle{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1}{\bm{v}}_{k^{t+1}},{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q-t-1}{\bm{v}}_{k}\right\rangle}_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mrow><mo>⟨</mo><msubsup><mi>𝒆</mi><mi>i</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><msup><mi>k</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo>,</mo><msubsup><mi>𝒆</mi><mi>j</mi><mo>⊤</mo></msubsup><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝑮</mi><mi>k</mi></msub><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mrow><mi>q</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>𝒗</mi><mi>k</mi></msub><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.-{\left\langle{\bm{e}}_{i}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{p-1}{\bm{v}}_{k^{t+1}},{\bm{e}}_{j}^{\top}{\left(\frac{{\bm{G}}_{k}}{m+n}\right)}^{q-t-1}{\bm{v}}_{k}\right\rangle}_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex241.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex241.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{q-1}\lambda_{1}^{t}\hat{\lambda}_{1}^{p+q-t-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\leq(q-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>λ</mi><mn>1</mn><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>1</mn><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mi>t</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{q-1}\lambda_{1}^{t}\hat{\lambda}_{1}^{p+q-t-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\leq(q-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p9.2" class="ltx_p">which implies that</p>
<table id="chapter11.A8.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex242.m1" class="ltx_Math" alttext="\displaystyle\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex243"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex243.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex243.m2" class="ltx_Math" alttext="\displaystyle\sum_{p,q=1}^{\infty}\left|\pi_{p}\pi_{q}{\left({\left\langle\hat{k}^{p}(x_{i},\cdot),\hat{k}^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right)}\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mo>|</mo><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>k</mi><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{p,q=1}^{\infty}\left|\pi_{p}\pi_{q}{\left({\left\langle\hat{k}^{p}(x_{i},\cdot),\hat{k}^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}-{\left\langle\hat{k}^{p}(x_{i},\cdot),k^{q}(x_{j},\cdot)\right\rangle}_{P_{\mathcal{X}}}\right)}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex244"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex244.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex244.m2" class="ltx_Math" alttext="\displaystyle\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(q-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(q-1)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p9.3" class="ltx_p">Combining the above inequalities, we obtain</p>
<table id="chapter11.A8.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex245"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex245.m1" class="ltx_Math" alttext="\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|+\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>k</mi><msup><mi>s</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>−</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|{k_{s^{2}}}(x_{i},x_{j})-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|+\left|\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}-\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex246"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex246.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex246.m2" class="ltx_Math" alttext="\displaystyle\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(p+q-2)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{p,q=1}^{\infty}\pi_{p}\pi_{q}(p+q-2)\lambda_{\max}^{p+q-2}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex247"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex247.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex247.m2" class="ltx_Math" alttext="\displaystyle\lambda_{\max}\left.\nabla_{\lambda}{\left(\frac{s(\lambda)^{2}}{\lambda^{2}}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>4</mn></msup><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{\max}\left.\nabla_{\lambda}{\left(\frac{s(\lambda)^{2}}{\lambda^{2}}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p9.4" class="ltx_p">so we get the result by expanding the derivative.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter11.A8.p10" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p10.1" class="ltx_p">We now prove <a href="#chapter5.Thmtheorem28" title="Theorem 5.28 (Proof in ). ‣ 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.28</span></a>.</p>
</div>
<div id="chapter11.A8.p11" class="ltx_para ltx_noindent">
<p id="chapter11.A8.p11.1" class="ltx_p"><span id="chapter11.A8.p11.1.1" class="ltx_text ltx_font_bold">Proof </span>
Define <math id="chapter11.A8.p11.m1" class="ltx_Math" alttext="{\bm{v}}_{{k_{s}},n}(x)\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}_{{k_{s}},n}(x)\in\mathbb{R}^{n}</annotation></semantics></math> such that <math id="chapter11.A8.p11.m2" class="ltx_Math" alttext="{\bm{v}}_{{k_{s}},n}(x)[i]={k_{s}}(x,x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{{k_{s}},n}(x)[i]={k_{s}}(x,x_{i})</annotation></semantics></math>.
Define <math id="chapter11.A8.p11.m3" class="ltx_Math" alttext="{\bm{v}}_{{\hat{k}_{s}},n}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{{\hat{k}_{s}},n}(x)</annotation></semantics></math> similarly.
Recall the formulas <math id="chapter11.A8.p11.m4" class="ltx_Math" alttext="\tilde{f}=\tilde{{\bm{\alpha}}}^{\top}{\bm{v}}_{{k_{s}},n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>=</mo><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{f}=\tilde{{\bm{\alpha}}}^{\top}{\bm{v}}_{{k_{s}},n}</annotation></semantics></math> and <math id="chapter11.A8.p11.m5" class="ltx_Math" alttext="\hat{f}=\hat{{\bm{\alpha}}}^{\top}{\bm{v}}_{{\hat{k}_{s}},n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{f}=\hat{{\bm{\alpha}}}^{\top}{\bm{v}}_{{\hat{k}_{s}},n}</annotation></semantics></math>.
Define <math id="chapter11.A8.p11.m6" class="ltx_Math" alttext="f^{\dagger}:=\hat{{\bm{\alpha}}}^{\top}{\bm{v}}_{{k_{s}},n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>†</mo></msup><mo>:=</mo><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">f^{\dagger}:=\hat{{\bm{\alpha}}}^{\top}{\bm{v}}_{{k_{s}},n}</annotation></semantics></math>.
Since <math id="chapter11.A8.p11.m7" class="ltx_Math" alttext="{\bm{G}}_{{\hat{k}_{s}},n}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{G}}_{{\hat{k}_{s}},n}</annotation></semantics></math> is <span id="chapter11.A8.p11.1.2" class="ltx_text ltx_font_italic">p.s.d.</span>, we can see that <math id="chapter11.A8.p11.m8" class="ltx_Math" alttext="\|\hat{{\bm{\alpha}}}\|_{2}\leq\frac{\|{\bm{y}}\|_{2}}{n\beta_{n}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\|\hat{{\bm{\alpha}}}\|_{2}\leq\frac{\|{\bm{y}}\|_{2}}{n\beta_{n}}</annotation></semantics></math>,
and <math id="chapter11.A8.p11.m9" class="ltx_Math" alttext="\|\hat{{\bm{\alpha}}}\|_{1}\leq\sqrt{n}\|\hat{{\bm{\alpha}}}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|\hat{{\bm{\alpha}}}\|_{1}\leq\sqrt{n}\|\hat{{\bm{\alpha}}}\|_{2}</annotation></semantics></math>.
So by <a href="#chapter11.Thmtheorem7" title="Corollary 11.7. ‣ Appendix 11.H Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">11.7</span></a>, we have</p>
<table id="chapter11.A8.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex248.m1" class="ltx_Math" alttext="\displaystyle{\left\|\hat{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|\hat{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex248.m2" class="ltx_Math" alttext="\displaystyle=\hat{{\bm{\alpha}}}^{\top}{\left\langle{\bm{v}}_{{\hat{k}_{s}},n}-{\bm{v}}_{{k_{s}},n},{\bm{v}}_{{\hat{k}_{s}},n}-{\bm{v}}_{{k_{s}},n}\right\rangle}_{P_{\mathcal{X}}}\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>⟨</mo><mrow><mrow><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>,</mo><mrow><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{{\bm{\alpha}}}^{\top}{\left\langle{\bm{v}}_{{\hat{k}_{s}},n}-{\bm{v}}_{{k_{s}},n},{\bm{v}}_{{\hat{k}_{s}},n}-{\bm{v}}_{{k_{s}},n}\right\rangle}_{P_{\mathcal{X}}}\hat{{\bm{\alpha}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex249"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex249.m1" class="ltx_Math" alttext="\displaystyle=\hat{{\bm{\alpha}}}^{\top}{\left(\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}+{k_{s^{2}}}(x_{i},x_{j})-2\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right)}\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>+</mo><mrow><msub><mi>k</mi><msup><mi>s</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{{\bm{\alpha}}}^{\top}{\left(\langle{\hat{k}_{s}}(x_{i},\cdot),{\hat{k}_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}+{k_{s^{2}}}(x_{i},x_{j})-2\langle{\hat{k}_{s}}(x_{i},\cdot),{k_{s}}(x_{j},\cdot)\rangle_{P_{\mathcal{X}}}\right)}\hat{{\bm{\alpha}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex250"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex250.m1" class="ltx_Math" alttext="\displaystyle\leq 2s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p11.2" class="ltx_p">By the definitions of <math id="chapter11.A8.p11.m10" class="ltx_Math" alttext="\tilde{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\bm{\alpha}}}</annotation></semantics></math> and <math id="chapter11.A8.p11.m11" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}</annotation></semantics></math>, we can also see that:</p>
<table id="chapter11.A8.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter11.A8.E42.m1" class="ltx_Math" alttext="{\left({\bm{G}}_{{k_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}={\left({\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right)}\hat{{\bm{\alpha}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left({\bm{G}}_{{k_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}={\left({\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right)}\hat{{\bm{\alpha}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="chapter11.A8.p11.3" class="ltx_p">Note that <math id="chapter11.A8.p11.m12" class="ltx_Math" alttext="{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}\leq n{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{\max}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>‖</mo></mrow><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}\leq n{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{\max}</annotation></semantics></math>.
Here <math id="chapter11.A8.p11.m13" class="ltx_Math" alttext="{\left\|{\bm{M}}\right\|}_{\max}=\max{\left|{\bm{M}}[i,j]\right|}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>𝑴</mi><mo>‖</mo></mrow><mi>max</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>|</mo><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\|{\bm{M}}\right\|}_{\max}=\max{\left|{\bm{M}}[i,j]\right|}</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter11.A8.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex251"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex251.m1" class="ltx_Math" alttext="\displaystyle{\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex251.m2" class="ltx_Math" alttext="\displaystyle={\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\bm{G}}_{{k_{s}},n}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\bm{G}}_{{k_{s}},n}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex252"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex252.m1" class="ltx_Math" alttext="\displaystyle={\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\left({\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right)}\hat{{\bm{\alpha}}}-n\beta_{n}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow><mo>−</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\left({\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right)}\hat{{\bm{\alpha}}}-n\beta_{n}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}^{\top}{\left(\hat{{\bm{\alpha}}}-\tilde{{\bm{\alpha}}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex253"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex253.m1" class="ltx_Math" alttext="\displaystyle\leq{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}+{\left\|\tilde{{\bm{\alpha}}}\right\|}_{2}{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}-0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>−</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}+{\left\|\tilde{{\bm{\alpha}}}\right\|}_{2}{\left\|{\bm{G}}_{{k_{s}},n}-{\bm{G}}_{{\hat{k}_{s}},n}\right\|}_{2}{\left\|\hat{{\bm{\alpha}}}\right\|}_{2}-0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex254"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex254.m1" class="ltx_Math" alttext="\displaystyle\leq 2\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p11.4" class="ltx_p">And note that we have <math id="chapter11.A8.p11.m14" class="ltx_Math" alttext="{\left\|\tilde{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}\leq s(\lambda_{1}){\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}\leq s(\lambda_{\max}){\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}\leq s(\lambda_{1}){\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}\leq s(\lambda_{\max}){\left\|\tilde{f}-f^{\dagger}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}</annotation></semantics></math>. Thus,</p>
<table id="chapter11.A8.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter11.A8.Ex255"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter11.A8.Ex255.m1" class="ltx_Math" alttext="\displaystyle{\left\|\hat{f}-\tilde{f}\right\|}_{P_{\mathcal{X}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|\hat{f}-\tilde{f}\right\|}_{P_{\mathcal{X}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex255.m2" class="ltx_Math" alttext="\displaystyle\leq 2{\left({\left\|\hat{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}+{\left\|\tilde{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>†</mo></msup></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2{\left({\left\|\hat{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}+{\left\|\tilde{f}-f^{\dagger}\right\|}_{P_{\mathcal{X}}}^{2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter11.A8.Ex256"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter11.A8.Ex256.m1" class="ltx_Math" alttext="\displaystyle\leq 8s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>λ</mi></msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>λ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>β</mi><mi>n</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow><msqrt><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 8s(\lambda_{\max})\left.\nabla_{\lambda}{\left(\frac{s(\lambda)}{\lambda}\right)}\right|_{\lambda=\lambda_{\max}}\frac{\beta_{n}^{-2}\kappa^{4}}{\sqrt{m+n}}{\left(2+\sqrt{2\log\frac{1}{\delta}}\right)}\frac{\|{\bm{y}}\|_{2}^{2}}{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter11.A8.p11.5" class="ltx_p">as desired.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
</section>
<section id="chapter12" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 12 </span>Proofs for Chapter 6</h2>

<section id="chapter12.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.A </span>Proof of Theorem <a href="#chapter6.Thmtheorem4" title="Theorem 6.4 (Proof in ). ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a></h2>

<div id="chapter12.A1.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A1.p1.1" class="ltx_p">We need the following classical result in convex optimization.</p>
</div>
<div id="chapter12.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 12.1</span></span><span id="chapter12.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib141" title="" class="ltx_ref">141</a>]</cite>, p. 16)<span id="chapter12.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem1.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter12.Thmtheorem1.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> be a convex and <math id="chapter12.Thmtheorem1.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth function (<a href="#chapter6.Thmtheorem9" title="Definition 6.9. ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">6.9</span></a>) on <math id="chapter12.Thmtheorem1.p1.m3" class="ltx_Math" alttext="{\mathcal{D}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⊆</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\mathcal{D}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}</annotation></semantics></math>.
Suppose it has a unique finite minimizer <math id="chapter12.Thmtheorem1.p1.m4" class="ltx_Math" alttext="x^{*}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">x^{*}</annotation></semantics></math>.
If one minimizes <math id="chapter12.Thmtheorem1.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> with gradient descent <math id="chapter12.Thmtheorem1.p1.m6" class="ltx_math_unparsed" alttext="x_{t+1}=x_{t}-\eta\nabla f(x_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mi>η</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x_{t+1}=x_{t}-\eta\nabla f(x_{t})</annotation></semantics></math>, staring from <math id="chapter12.Thmtheorem1.p1.m7" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math> with a fixed learning rate <math id="chapter12.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\eta\leq\frac{1}{L}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><mfrac><mn>1</mn><mi>L</mi></mfrac></mrow><annotation encoding="application/x-tex">\eta\leq\frac{1}{L}</annotation></semantics></math>, then we have</span></p>
<table id="chapter12.A1.Ex257" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex257.m1" class="ltx_Math" alttext="f(x_{T})\leq f(x^{*})+\frac{1}{\eta T}{\left\|x_{0}-x^{*}\right\|}_{2}^{2}\qquad\text{for all }T&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>−</mo><msup><mi>x</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(x_{T})\leq f(x^{*})+\frac{1}{\eta T}{\left\|x_{0}-x^{*}\right\|}_{2}^{2}\qquad\text{for all }T&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter12.A1.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A1.p2.1" class="ltx_p">Now let us prove <a href="#chapter6.Thmtheorem4" title="Theorem 6.4 (Proof in ). ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.4</span></a>.</p>
</div>
<div id="chapter12.A1.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A1.p3.1" class="ltx_p"><span id="chapter12.A1.p3.1.1" class="ltx_text ltx_font_bold">Proof </span>
<span id="chapter12.A1.p3.1.2" class="ltx_text ltx_font_bold">Static GRW.</span>  We first prove the result for static GRW where <math id="chapter12.A1.p3.m1" class="ltx_Math" alttext="q_{i}^{(t)}=q_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msub><mi>q</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}=q_{i}&gt;0</annotation></semantics></math> for all <math id="chapter12.A1.p3.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Let <math id="chapter12.A1.p3.m3" class="ltx_Math" alttext="q^{*}=\min_{i}q_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">q^{*}=\min_{i}q_{i}</annotation></semantics></math>. The minimization objective is <math id="chapter12.A1.p3.m4" class="ltx_Math" alttext="F(\theta)=\sum_{i=1}^{n}q_{i}(x_{i}^{\top}\theta-y_{i})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>x</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\theta)=\sum_{i=1}^{n}q_{i}(x_{i}^{\top}\theta-y_{i})^{2}</annotation></semantics></math>, whose Hessian is <math id="chapter12.A1.p3.m5" class="ltx_Math" alttext="\nabla_{\theta}^{2}F(\theta)=2\sum_{i=1}^{n}q_{i}x_{i}x_{i}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}^{2}F(\theta)=2\sum_{i=1}^{n}q_{i}x_{i}x_{i}^{\top}</annotation></semantics></math>. Let <math id="chapter12.A1.p3.m6" class="ltx_Math" alttext="A=\sum_{i=1}^{n}{\left\|x_{i}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mrow><mo>‖</mo><msub><mi>x</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">A=\sum_{i=1}^{n}{\left\|x_{i}\right\|}_{2}^{2}</annotation></semantics></math>.
Since <math id="chapter12.A1.p3.m7" class="ltx_Math" alttext="q_{i}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q_{i}\in[0,1]</annotation></semantics></math>, for any unit vector <math id="chapter12.A1.p3.m8" class="ltx_Math" alttext="{\bm{v}}\in\mathbb{R}^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}\in\mathbb{R}^{d_{{\mathcal{X}}}}</annotation></semantics></math>, we have</p>
<table id="chapter12.A1.Ex258" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex258.m1" class="ltx_Math" alttext="{\bm{v}}^{\top}\nabla_{\theta}^{2}F(\theta){\bm{v}}=2\sum_{i=1}^{n}q_{i}(x_{i}^{\top}{\bm{v}})^{2}\leq 2\sum_{i=1}^{n}q_{i}{\left\|x_{i}\right\|}_{2}^{2}\leq 2A," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>θ</mi><mn>2</mn></msubsup><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>x</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}\nabla_{\theta}^{2}F(\theta){\bm{v}}=2\sum_{i=1}^{n}q_{i}(x_{i}^{\top}{\bm{v}})^{2}\leq 2\sum_{i=1}^{n}q_{i}{\left\|x_{i}\right\|}_{2}^{2}\leq 2A,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p3.2" class="ltx_p">which by <a href="#chapter6.Thmtheorem9" title="Definition 6.9. ‣ Linear models, classification tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">6.9</span></a> implies that <math id="chapter12.A1.p3.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is <math id="chapter12.A1.p3.m10" class="ltx_Math" alttext="2A" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">2A</annotation></semantics></math>-smooth. Thus, we have</p>
<table id="chapter12.A1.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.E43.m1" class="ltx_Math" alttext="F(\theta_{2})\leq F(\theta_{1})+{\left\langle\nabla_{\theta}F(\theta_{1}),\theta_{2}-\theta_{1}\right\rangle}+A{\left\|\theta_{2}-\theta_{1}\right\|}_{2}^{2}\qquad\text{for all }\theta_{1},\theta_{2}\in\mathbb{R}^{d_{{\mathcal{X}}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta_{2})\leq F(\theta_{1})+{\left\langle\nabla_{\theta}F(\theta_{1}),\theta_{2}-\theta_{1}\right\rangle}+A{\left\|\theta_{2}-\theta_{1}\right\|}_{2}^{2}\qquad\text{for all }\theta_{1},\theta_{2}\in\mathbb{R}^{d_{{\mathcal{X}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="chapter12.A1.p3.3" class="ltx_p">Denote <math id="chapter12.A1.p3.m11" class="ltx_Math" alttext="g(\theta^{(t)})={\bm{X}}^{\top}\theta^{(t)}-{\bm{Y}}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>−</mo><mi>𝒀</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">g(\theta^{(t)})={\bm{X}}^{\top}\theta^{(t)}-{\bm{Y}}\in\mathbb{R}^{n}</annotation></semantics></math>.
Let <math id="chapter12.A1.p3.m12" class="ltx_Math" alttext="\sqrt{{\bm{Q}}}={\textnormal{diag}}{\left(\sqrt{q_{1}},\cdots,\sqrt{q_{n}}\right)}" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>𝑸</mi></msqrt><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><msub><mi>q</mi><mn>1</mn></msub></msqrt><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msqrt><msub><mi>q</mi><mi>n</mi></msub></msqrt><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sqrt{{\bm{Q}}}={\textnormal{diag}}{\left(\sqrt{q_{1}},\cdots,\sqrt{q_{n}}\right)}</annotation></semantics></math>.
Then, we have <math id="chapter12.A1.p3.m13" class="ltx_Math" alttext="F(\theta^{(t)})={\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})={\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}</annotation></semantics></math>,
which implies that <math id="chapter12.A1.p3.m14" class="ltx_Math" alttext="\nabla F(\theta^{(t)})=2{\bm{X}}{\bm{Q}}g(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla F(\theta^{(t)})=2{\bm{X}}{\bm{Q}}g(\theta^{(t)})</annotation></semantics></math>.
The update rule of static GRW with gradient descent is thus given by</p>
<table id="chapter12.A1.Ex259" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex259.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}x_{i}{\left(f^{(t)}(x_{i})-y_{i}\right)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}g(\theta^{(t)})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta\sum_{i=1}^{n}q_{i}x_{i}{\left(f^{(t)}(x_{i})-y_{i}\right)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}g(\theta^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p3.4" class="ltx_p">By <a href="#chapter12.A1.E43" title="In Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">43</span></a>, we have</p>
<table id="chapter12.A1.Ex260" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex260.m1" class="ltx_Math" alttext="F(\theta^{(t+1)})\leq F(\theta^{(t)})-2\eta g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})+A{\left\|\eta{\bm{X}}{\bm{Q}}g(\theta^{(t)})\right\|}_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})\leq F(\theta^{(t)})-2\eta g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})+A{\left\|\eta{\bm{X}}{\bm{Q}}g(\theta^{(t)})\right\|}_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p3.5" class="ltx_p">Since <math id="chapter12.A1.p3.m15" class="ltx_Math" alttext="x_{1},\cdots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{n}</annotation></semantics></math> are linearly independent, <math id="chapter12.A1.p3.m16" class="ltx_Math" alttext="{\bm{X}}^{\top}{\bm{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><annotation encoding="application/x-tex">{\bm{X}}^{\top}{\bm{X}}</annotation></semantics></math> is a positive definite matrix. Let its smallest eigenvalue be <math id="chapter12.A1.p3.m17" class="ltx_Math" alttext="\lambda_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{\min}&gt;0</annotation></semantics></math>.
Note that <math id="chapter12.A1.p3.m18" class="ltx_Math" alttext="{\left\|{\bm{Q}}g(\theta^{(t)})\right\|}_{2}\geq\sqrt{q^{*}}{\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}=\sqrt{q^{*}F(\theta^{(t)})}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mrow><msqrt><msup><mi>q</mi><mo>∗</mo></msup></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><msqrt><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}g(\theta^{(t)})\right\|}_{2}\geq\sqrt{q^{*}}{\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}=\sqrt{q^{*}F(\theta^{(t)})}</annotation></semantics></math>. Thus, we have <math id="chapter12.A1.p3.m19" class="ltx_Math" alttext="g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})\geq q^{*}\lambda_{\min}F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})\geq q^{*}\lambda_{\min}F(\theta^{(t)})</annotation></semantics></math>. So we have</p>
<table id="chapter12.A1.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A1.Ex261"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A1.Ex261.m1" class="ltx_Math" alttext="\displaystyle F(\theta^{(t+1)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(\theta^{(t+1)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex261.m2" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\sqrt{{\bm{Q}}}\right\|}_{2}^{2}{\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\sqrt{{\bm{Q}}}\right\|}_{2}^{2}{\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex262"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex262.m1" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\sqrt{{\bm{Q}}}\right\|}_{F}^{2}F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\sqrt{{\bm{Q}}}\right\|}_{F}^{2}F(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex263"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex263.m1" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\right\|}_{F}^{2}F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝑿</mi><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-2\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}{\left\|{\bm{X}}\right\|}_{F}^{2}F(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex264"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex264.m1" class="ltx_Math" alttext="\displaystyle={\left(1-2\eta q^{*}\lambda_{\min}+A^{2}\eta^{2}\right)}F(\theta^{(t)})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\left(1-2\eta q^{*}\lambda_{\min}+A^{2}\eta^{2}\right)}F(\theta^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p3.6" class="ltx_p">Let <math id="chapter12.A1.p3.m20" class="ltx_Math" alttext="\eta_{0}=\frac{q^{*}\lambda_{\min}}{A^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><msup><mi>A</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\eta_{0}=\frac{q^{*}\lambda_{\min}}{A^{2}}</annotation></semantics></math>.
For any <math id="chapter12.A1.p3.m21" class="ltx_Math" alttext="\eta\leq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{0}</annotation></semantics></math>, we have <math id="chapter12.A1.p3.m22" class="ltx_Math" alttext="F(\theta^{(t+1)})\leq(1-\eta q^{*}\lambda_{\min})F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})\leq(1-\eta q^{*}\lambda_{\min})F(\theta^{(t)})</annotation></semantics></math> for all <math id="chapter12.A1.p3.m23" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, which implies that <math id="chapter12.A1.p3.m24" class="ltx_Math" alttext="F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t)})</annotation></semantics></math> must converge to zero.
Since every <math id="chapter12.A1.p3.m25" class="ltx_Math" alttext="q_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q_{i}&gt;0</annotation></semantics></math>, this implies that the ERM risk must converge to zero.</p>
</div>
<div id="chapter12.A1.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A1.p4.1" class="ltx_p"><span id="chapter12.A1.p4.1.1" class="ltx_text ltx_font_bold">Dynamic GRW.</span>  By <a href="#chapter6.Thmtheorem3" title="Assumption 6.3. ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">6.3</span></a>, for any <math id="chapter12.A1.p4.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, there exists <math id="chapter12.A1.p4.m2" class="ltx_Math" alttext="t_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">t_{\epsilon}</annotation></semantics></math> such that for all <math id="chapter12.A1.p4.m3" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, we have <math id="chapter12.A1.p4.m4" class="ltx_Math" alttext="q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)</annotation></semantics></math> for all <math id="chapter12.A1.p4.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Let <math id="chapter12.A1.p4.m6" class="ltx_Math" alttext="\lambda_{\max}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\lambda_{\max}</annotation></semantics></math> and <math id="chapter12.A1.p4.m7" class="ltx_Math" alttext="\lambda_{\min}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\lambda_{\min}</annotation></semantics></math> be the largest and smallest eigenvalues of <math id="chapter12.A1.p4.m8" class="ltx_Math" alttext="{\bm{X}}^{\top}{\bm{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><annotation encoding="application/x-tex">{\bm{X}}^{\top}{\bm{X}}</annotation></semantics></math>, where <math id="chapter12.A1.p4.m9" class="ltx_Math" alttext="\lambda_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{\min}&gt;0</annotation></semantics></math>.
Fix <math id="chapter12.A1.p4.m10" class="ltx_Math" alttext="\epsilon=\min{\left\{\frac{q^{*}}{3},\frac{(q^{*}\lambda_{\min})^{2}}{12\lambda_{\max}^{2}}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mfrac><msup><mi>q</mi><mo>∗</mo></msup><mn>3</mn></mfrac><mo>,</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon=\min{\left\{\frac{q^{*}}{3},\frac{(q^{*}\lambda_{\min})^{2}}{12\lambda_{\max}^{2}}\right\}}</annotation></semantics></math>. Then, <math id="chapter12.A1.p4.m11" class="ltx_Math" alttext="t_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">t_{\epsilon}</annotation></semantics></math> is also fixed.</p>
</div>
<div id="chapter12.A1.p5" class="ltx_para ltx_noindent">
<p id="chapter12.A1.p5.1" class="ltx_p">Denote <math id="chapter12.A1.p5.m1" class="ltx_Math" alttext="{\bm{Q}}={\textnormal{diag}}{\left(q_{1},\cdots,q_{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\textnormal{diag}}{\left(q_{1},\cdots,q_{n}\right)}</annotation></semantics></math>. When <math id="chapter12.A1.p5.m2" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, the update rule of dynamic GRW is <math id="chapter12.A1.p5.m3" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}_{\epsilon}^{(t)}{\left({\bm{X}}^{\top}\theta^{(t)}-{\bm{Y}}\right)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>−</mo><mi>𝒀</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta{\bm{X}}{\bm{Q}}_{\epsilon}^{(t)}{\left({\bm{X}}^{\top}\theta^{(t)}-{\bm{Y}}\right)}</annotation></semantics></math>. We use the subscript <math id="chapter12.A1.p5.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> to indicate that <math id="chapter12.A1.p5.m5" class="ltx_Math" alttext="{\left\|{\bm{Q}}_{\epsilon}^{(t)}-{\bm{Q}}\right\|}_{2}&lt;\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mi>𝑸</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}_{\epsilon}^{(t)}-{\bm{Q}}\right\|}_{2}&lt;\epsilon</annotation></semantics></math>.
Because <math id="chapter12.A1.p5.m6" class="ltx_Math" alttext="q_{i}+\epsilon\sqrt{(q_{i}+3\epsilon)q_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">q_{i}+\epsilon\sqrt{(q_{i}+3\epsilon)q_{i}}</annotation></semantics></math> and <math id="chapter12.A1.p5.m7" class="ltx_Math" alttext="q_{i}-\epsilon\geq\sqrt{(q_{i}-\epsilon)q_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo>≥</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msqrt></mrow><annotation encoding="application/x-tex">q_{i}-\epsilon\geq\sqrt{(q_{i}-\epsilon)q_{i}}</annotation></semantics></math> for all <math id="chapter12.A1.p5.m8" class="ltx_Math" alttext="\epsilon\leq\frac{q_{i}}{3}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≤</mo><mfrac><msub><mi>q</mi><mi>i</mi></msub><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\epsilon\leq\frac{q_{i}}{3}</annotation></semantics></math>, we can rewrite <math id="chapter12.A1.p5.m9" class="ltx_Math" alttext="{\bm{Q}}_{\epsilon}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\bm{Q}}_{\epsilon}^{(t)}</annotation></semantics></math> as <math id="chapter12.A1.p5.m10" class="ltx_Math" alttext="{\bm{Q}}_{\epsilon}^{(t)}=\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{\epsilon}^{(t)}=\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}</annotation></semantics></math>.
So by <a href="#chapter12.A1.E43" title="In Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">43</span></a>, we have</p>
<table id="chapter12.A1.Ex265" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex265.m1" class="ltx_Math" alttext="F(\theta^{(t+1)})\leq F(\theta^{(t)})-2\eta g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})+A{\left\|\eta{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})\leq F(\theta^{(t)})-2\eta g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})+A{\left\|\eta{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|}_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p5.2" class="ltx_p">For all <math id="chapter12.A1.p5.m11" class="ltx_Math" alttext="\epsilon&lt;\frac{q_{i}}{3}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mfrac><msub><mi>q</mi><mi>i</mi></msub><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\epsilon&lt;\frac{q_{i}}{3}</annotation></semantics></math>, we have <math id="chapter12.A1.p5.m12" class="ltx_Math" alttext="\sqrt{q_{i}+3\epsilon}-\sqrt{q_{i}}\leq\sqrt{3\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo>−</mo><msqrt><msub><mi>q</mi><mi>i</mi></msub></msqrt></mrow><mo>≤</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sqrt{q_{i}+3\epsilon}-\sqrt{q_{i}}\leq\sqrt{3\epsilon}</annotation></semantics></math> and <math id="chapter12.A1.p5.m13" class="ltx_Math" alttext="\sqrt{q_{i}}-\sqrt{q_{i}-3\epsilon}\leq\sqrt{3\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><msub><mi>q</mi><mi>i</mi></msub></msqrt><mo>−</mo><msqrt><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt></mrow><mo>≤</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sqrt{q_{i}}-\sqrt{q_{i}-3\epsilon}\leq\sqrt{3\epsilon}</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter12.A1.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A1.Ex266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex266.m1" class="ltx_Math" alttext="\displaystyle\left|g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\sqrt{{\bm{Q}}}g(\theta^{(t)})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>−</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\sqrt{{\bm{Q}}}g(\theta^{(t)})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex267"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A1.Ex267.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex267.m2" class="ltx_Math" alttext="\displaystyle\left\|\sqrt{{\bm{Q}}}^{\top}{\bm{X}}^{\top}{\bm{X}}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><msqrt><mi>𝑸</mi></msqrt><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>−</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\sqrt{{\bm{Q}}}^{\top}{\bm{X}}^{\top}{\bm{X}}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex268"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A1.Ex268.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex268.m2" class="ltx_Math" alttext="\displaystyle\left\|\sqrt{{\bm{Q}}}\right\|_{2}\left\|{\bm{X}}^{\top}{\bm{X}}\right\|_{2}\left\|\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>−</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\sqrt{{\bm{Q}}}\right\|_{2}\left\|{\bm{X}}^{\top}{\bm{X}}\right\|_{2}\left\|\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex269"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A1.Ex269.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex269.m2" class="ltx_Math" alttext="\displaystyle\lambda_{\max}\sqrt{3\epsilon}F(\theta^{(t)})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{\max}\sqrt{3\epsilon}F(\theta^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p5.3" class="ltx_p">Since <math id="chapter12.A1.p5.m14" class="ltx_Math" alttext="g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})\geq q^{*}\lambda_{\min}F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}{\bm{Q}}g(\theta^{(t)})\geq q^{*}\lambda_{\min}F(\theta^{(t)})</annotation></semantics></math>, and <math id="chapter12.A1.p5.m15" class="ltx_Math" alttext="\epsilon\leq\frac{(q^{*}\lambda_{\min})^{2}}{12\lambda_{\max}^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≤</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>max</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\epsilon\leq\frac{(q^{*}\lambda_{\min})^{2}}{12\lambda_{\max}^{2}}</annotation></semantics></math>, we have</p>
<table id="chapter12.A1.Ex270" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A1.Ex270.m1" class="ltx_Math" alttext="g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})\geq\left(q^{*}\lambda_{\min}-\lambda_{\max}\sqrt{3\epsilon}\right)F(\theta^{(t)})\geq\frac{1}{2}q^{*}\lambda_{\min}F(\theta^{(t)})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mo>(</mo><mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g(\theta^{(t)})^{\top}{\bm{Q}}^{\top}{\bm{X}}^{\top}{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}g(\theta^{(t)})\geq\left(q^{*}\lambda_{\min}-\lambda_{\max}\sqrt{3\epsilon}\right)F(\theta^{(t)})\geq\frac{1}{2}q^{*}\lambda_{\min}F(\theta^{(t)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p5.4" class="ltx_p">Thus, for all <math id="chapter12.A1.p5.m16" class="ltx_Math" alttext="\epsilon\leq\frac{1}{3}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≤</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\epsilon\leq\frac{1}{3}</annotation></semantics></math>, we have</p>
<table id="chapter12.A1.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A1.Ex271"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A1.Ex271.m1" class="ltx_Math" alttext="\displaystyle F(\theta^{(t+1)})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(\theta^{(t+1)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex271.m2" class="ltx_Math" alttext="\displaystyle\leq F(\theta^{(t)})-\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}\left\|{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}^{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq F(\theta^{(t)})-\eta q^{*}\lambda_{\min}F(\theta^{(t)})+A\eta^{2}\left\|{\bm{X}}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}^{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex272"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex272.m1" class="ltx_Math" alttext="\displaystyle\leq(1-\eta q^{*}\lambda_{\min}+A^{2}\eta^{2}(1+3\epsilon))F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\eta q^{*}\lambda_{\min}+A^{2}\eta^{2}(1+3\epsilon))F(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A1.Ex273"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A1.Ex273.m1" class="ltx_Math" alttext="\displaystyle\leq(1-\eta q^{*}\lambda_{\min}+2A^{2}\eta^{2})F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\eta q^{*}\lambda_{\min}+2A^{2}\eta^{2})F(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A1.p5.5" class="ltx_p">Let <math id="chapter12.A1.p5.m17" class="ltx_Math" alttext="\eta_{0}=\frac{q^{*}\lambda_{\min}}{4A^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta_{0}=\frac{q^{*}\lambda_{\min}}{4A^{2}}</annotation></semantics></math>. For any <math id="chapter12.A1.p5.m18" class="ltx_Math" alttext="\eta\leq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{0}</annotation></semantics></math>, we have <math id="chapter12.A1.p5.m19" class="ltx_Math" alttext="F(\theta^{(t+1)})\leq(1-\eta q^{*}\lambda_{\min}/2)F(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\theta^{(t+1)})\leq(1-\eta q^{*}\lambda_{\min}/2)F(\theta^{(t)})</annotation></semantics></math> for all <math id="chapter12.A1.p5.m20" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, which implies that <math id="chapter12.A1.p5.m21" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}F(\theta^{(t)})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}F(\theta^{(t)})=0</annotation></semantics></math>. Thus, the ERM risk converges to 0.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
</section>
<section id="chapter12.A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 12.B </span>Proof of Theorem <a href="#chapter6.Thmtheorem6" title="Theorem 6.6 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a></h2>

<div id="chapter12.A2.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p1.1" class="ltx_p">The proof of this theorem is largely based on the following result.</p>
</div>
<div id="chapter12.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma 12.2</span></span><span id="chapter12.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Approximation Theorem)<span id="chapter12.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem2.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For a wide NN <math id="chapter12.Thmtheorem2.p1.m1" class="ltx_Math" alttext="f^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(t)}</annotation></semantics></math> trained by any GRW satisfying <a href="#chapter6.Thmtheorem3" title="Assumption 6.3. ‣ Insights from linear models. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">6.3</span></a> with the squared loss, let <math id="chapter12.Thmtheorem2.p1.m2" class="ltx_Math" alttext="f^{(t)}_{\textnormal{lin}}(x)=f^{(0)}(x)+{\left\langle\theta^{(t)}-\theta^{(0)},\nabla_{\theta}f^{(0)}(x)\right\rangle}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{(t)}_{\textnormal{lin}}(x)=f^{(0)}(x)+{\left\langle\theta^{(t)}-\theta^{(0)},\nabla_{\theta}f^{(0)}(x)\right\rangle}</annotation></semantics></math> be its linearized neural network trained by the same GRW (i.e. <math id="chapter12.Thmtheorem2.p1.m3" class="ltx_Math" alttext="q_{i}^{(t)}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">q_{i}^{(t)}</annotation></semantics></math> are the same for both networks for any <math id="chapter12.Thmtheorem2.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="chapter12.Thmtheorem2.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>).
Under the conditions of <a href="#chapter6.Thmtheorem6" title="Theorem 6.6 (Proof in ). ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.6</span></a>, with a sufficiently small learning rate, for any <math id="chapter12.Thmtheorem2.p1.m6" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, there exist constants <math id="chapter12.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\tilde{D}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{D}&gt;0</annotation></semantics></math> and <math id="chapter12.Thmtheorem2.p1.m8" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> such that as long as <math id="chapter12.Thmtheorem2.p1.m9" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>, with probability at least <math id="chapter12.Thmtheorem2.p1.m10" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> over random initialization we have: for any test point <math id="chapter12.Thmtheorem2.p1.m11" class="ltx_Math" alttext="x\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{d}</annotation></semantics></math> such that <math id="chapter12.Thmtheorem2.p1.m12" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>,</span></p>
<table id="chapter12.A2.Ex274" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex274.m1" class="ltx_math_unparsed" alttext="\sup_{t\geq 0}{\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}(x)\right|}\leq C\tilde{d}^{-1/4}" display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em">|</mo><msubsup><mi>f</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><mi>C</mi><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\sup_{t\geq 0}{\left|f^{(t)}_{\textnormal{lin}}(x)-f^{(t)}(x)\right|}\leq C\tilde{d}^{-1/4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter12.A2.p2" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p2.1" class="ltx_p"><span id="chapter12.A2.p2.1.1" class="ltx_text ltx_font_bold">Proof </span>
We will use the following short-hand in the proof:</p>
<table id="chapter12.A2.Ex275" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex275.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} g(\theta^{(t)})&amp;=f^{(t)}({\bm{X}})-{\bm{Y}}\\
J(\theta^{(t)})&amp;=\nabla_{\theta}f({\bm{X}};\theta^{(t)})\in\mathbb{R}^{p\times n}\\
\Theta^{(t)}&amp;=J(\theta^{(t)})^{\top}J(\theta^{(t)})\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒀</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo mathsize="0.700em">,</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} g(\theta^{(t)})&amp;=f^{(t)}({\bm{X}})-{\bm{Y}}\\
J(\theta^{(t)})&amp;=\nabla_{\theta}f({\bm{X}};\theta^{(t)})\in\mathbb{R}^{p\times n}\\
\Theta^{(t)}&amp;=J(\theta^{(t)})^{\top}J(\theta^{(t)})\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="chapter12.A2.p3" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p3.1" class="ltx_p">For any <math id="chapter12.A2.p3.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, there exists <math id="chapter12.A2.p3.m2" class="ltx_Math" alttext="t_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">t_{\epsilon}</annotation></semantics></math> such that for all <math id="chapter12.A2.p3.m3" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math> and all <math id="chapter12.A2.p3.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="chapter12.A2.p3.m5" class="ltx_Math" alttext="q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>q</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{i}^{(t)}\in(q_{i}-\epsilon,q_{i}+\epsilon)</annotation></semantics></math>.
Let <math id="chapter12.A2.p3.m6" class="ltx_Math" alttext="{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>q</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\textnormal{diag}}(q_{1},\cdots,q_{n})</annotation></semantics></math>.
Similar to <a href="#chapter12.A1" title="Appendix 12.A Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">12.A</span></a>, we can rewrite <math id="chapter12.A2.p3.m7" class="ltx_Math" alttext="{\bm{Q}}^{(t)}={\bm{Q}}^{(t)}_{\epsilon}=\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msubsup><mi>𝑸</mi><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{(t)}={\bm{Q}}^{(t)}_{\epsilon}=\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\sqrt{{\bm{Q}}}</annotation></semantics></math>.
The update rule of GRW of wide NN is</p>
<table id="chapter12.A2.Ex276" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex276.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p3.2" class="ltx_p">and when <math id="chapter12.A2.p3.m8" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, this can be rewritten as</p>
<table id="chapter12.A2.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.E44.m1" class="ltx_Math" alttext="\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}g(\theta^{(t)})\right]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}=\theta^{(t)}-\eta J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}g(\theta^{(t)})\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
</div>
<div id="chapter12.A2.p4" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p4.1" class="ltx_p">Next, we need three lemmas.</p>
</div>
<div id="chapter12.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 12.3</span></span><span id="chapter12.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib147" title="" class="ltx_ref">147</a>]</cite>, Corollary 5.35)<span id="chapter12.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem3.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="chapter12.Thmtheorem3.p1.m1" class="ltx_Math" alttext="{\bm{A}}\in\mathbb{R}^{p\times q}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}\in\mathbb{R}^{p\times q}</annotation></semantics></math> is a random matrix whose entries are independent standard normal random variables, then for every <math id="chapter12.Thmtheorem3.p1.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>, with probability at least <math id="chapter12.Thmtheorem3.p1.m3" class="ltx_math_unparsed" alttext="1-2\exp(-t^{2}/2)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mn>2</mn><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msup><mi>t</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1-2\exp(-t^{2}/2)</annotation></semantics></math>,</span></p>
<table id="chapter12.A2.Ex277" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex277.m1" class="ltx_Math" alttext="\sqrt{p}-\sqrt{q}-t\leq\lambda_{\min}({\bm{A}})\leq\lambda_{\max}({\bm{A}})\leq\sqrt{p}+\sqrt{q}+t." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mi>p</mi></msqrt><mo>−</mo><msqrt><mi>q</mi></msqrt><mo>−</mo><mi>t</mi></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>p</mi></msqrt><mo>+</mo><msqrt><mi>q</mi></msqrt><mo>+</mo><mi>t</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{p}-\sqrt{q}-t\leq\lambda_{\min}({\bm{A}})\leq\lambda_{\max}({\bm{A}})\leq\sqrt{p}+\sqrt{q}+t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter12.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma 12.4</span></span><span id="chapter12.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Local Lipschitzness of the Jacobian)<span id="chapter12.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem4.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">There exists a constant <math id="chapter12.Thmtheorem4.p1.m1" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math> such that for any <math id="chapter12.Thmtheorem4.p1.m2" class="ltx_Math" alttext="C_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{0}&gt;0</annotation></semantics></math> and any <math id="chapter12.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, there exists a <math id="chapter12.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> such that: If <math id="chapter12.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>, then with probability at least <math id="chapter12.Thmtheorem4.p1.m6" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> over random initialization, for any <math id="chapter12.Thmtheorem4.p1.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.Thmtheorem4.p1.m8" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>, we have</span></p>
<table id="chapter12.A2.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.E45.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} \left\|\nabla_{\theta}f(x;\theta)-\nabla_{\theta}f(x;\tilde{\theta})\right\|_{2}&amp;\leq\frac{M}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}\\
\left\|\nabla_{\theta}f(x;\theta)\right\|_{2}&amp;\leq M\\
\left\|J(\theta)-J(\tilde{\theta})\right\|_{F}&amp;\leq\frac{M}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}\\
\left\|J(\theta)\right\|_{F}&amp;\leq M\end{aligned}\right.,\qquad\forall\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0})," display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo mathsize="0.700em">,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo mathsize="0.700em">,</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mi>M</mi><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo mathsize="0.700em">,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mi>M</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mi>M</mi><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mi>M</mi></mrow></mtd></mtr></mtable><mo rspace="2.167em">,</mo><mo rspace="0.167em">∀</mo><mi>θ</mi><mo>,</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>∈</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} \left\|\nabla_{\theta}f(x;\theta)-\nabla_{\theta}f(x;\tilde{\theta})\right\|_{2}&amp;\leq\frac{M}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}\\
\left\|\nabla_{\theta}f(x;\theta)\right\|_{2}&amp;\leq M\\
\left\|J(\theta)-J(\tilde{\theta})\right\|_{F}&amp;\leq\frac{M}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}\\
\left\|J(\theta)\right\|_{F}&amp;\leq M\end{aligned}\right.,\qquad\forall\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="chapter12.Thmtheorem4.p1.2" class="ltx_p"><span id="chapter12.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="chapter12.Thmtheorem4.p1.m9" class="ltx_Math" alttext="B(\theta^{(0)},R)={\left\{\theta:{\left\|\theta-\theta^{(0)}\right\|}_{2}&lt;R\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>R</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B(\theta^{(0)},R)={\left\{\theta:{\left\|\theta-\theta^{(0)}\right\|}_{2}&lt;R\right\}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter12.A2.p5" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p5.1" class="ltx_p"><span id="chapter12.A2.p5.1.1" class="ltx_text ltx_font_bold">Proof </span>
By <a href="#chapter12.Thmtheorem3" title="Lemma 12.3 ([], Corollary 5.35). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.3</span></a>, for any <math id="chapter12.A2.p5.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, there exists <math id="chapter12.A2.p5.m2" class="ltx_Math" alttext="\tilde{D}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{D}&gt;0</annotation></semantics></math> and <math id="chapter12.A2.p5.m3" class="ltx_Math" alttext="M_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{1}&gt;0</annotation></semantics></math> such that if <math id="chapter12.A2.p5.m4" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>, then with probability at least <math id="chapter12.A2.p5.m5" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, the following holds for all <math id="chapter12.A2.p5.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> such that <math id="chapter12.A2.p5.m7" class="ltx_Math" alttext="{\left\|\theta-\theta^{(0)}\right\|}_{2}&lt;C_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|\theta-\theta^{(0)}\right\|}_{2}&lt;C_{0}</annotation></semantics></math>:</p>
<table id="chapter12.A2.Ex278" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex278.m1" class="ltx_Math" alttext="\forall 0\leq l\leq L-1:{\left\|{\bm{W}}^{l}\right\|}_{2}\leq 3\sqrt{\tilde{d}};\quad{\left\|{\bm{W}}^{L}\right\|}_{2}\leq C_{0}\leq 3\tilde{d}^{1/4};\quad\forall 0\leq l\leq L:{\left\|\beta{\bm{b}}^{l}\right\|}\leq M_{1}\sqrt{\tilde{d}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mn>0</mn></mrow><mo>≤</mo><mi>l</mi><mo>≤</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo>‖</mo><msup><mi>𝑾</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow></mrow><mo rspace="1.167em">;</mo><mrow><msub><mrow><mo>‖</mo><msup><mi>𝑾</mi><mi>L</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>C</mi><mn>0</mn></msub><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><mo rspace="1.167em">;</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mn>0</mn></mrow><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>‖</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\forall 0\leq l\leq L-1:{\left\|{\bm{W}}^{l}\right\|}_{2}\leq 3\sqrt{\tilde{d}};\quad{\left\|{\bm{W}}^{L}\right\|}_{2}\leq C_{0}\leq 3\tilde{d}^{1/4};\quad\forall 0\leq l\leq L:{\left\|\beta{\bm{b}}^{l}\right\|}\leq M_{1}\sqrt{\tilde{d}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p5.2" class="ltx_p">With these inequalities, for any <math id="chapter12.A2.p5.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A2.p5.m9" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex279"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex279.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{h}}^{1}\right\|_{2}=\left\|\frac{1}{\sqrt{d_{0}}}{\bm{W}}^{0}x+\beta{\bm{b}}^{0}\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{W}}^{0}\right\|_{2}\left\|x\right\|_{2}+\left\|\beta{\bm{b}}^{0}\right\|_{2}\leq(\frac{3}{\sqrt{d_{0}}}+M_{1})\sqrt{\tilde{d}};" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒉</mi><mn>1</mn></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝑾</mi><mn>0</mn></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mn>0</mn></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo>+</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{h}}^{1}\right\|_{2}=\left\|\frac{1}{\sqrt{d_{0}}}{\bm{W}}^{0}x+\beta{\bm{b}}^{0}\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{W}}^{0}\right\|_{2}\left\|x\right\|_{2}+\left\|\beta{\bm{b}}^{0}\right\|_{2}\leq(\frac{3}{\sqrt{d_{0}}}+M_{1})\sqrt{\tilde{d}};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex280"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex280.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{h}}^{l+1}\right\|_{2}=\left\|\frac{1}{\sqrt{\tilde{d}}}{\bm{W}}^{l}{\bm{x}}^{l}+\beta{\bm{b}}^{l}\right\|_{2}\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}\right\|_{2}\left\|{\bm{x}}^{l}\right\|_{2}+\left\|\beta{\bm{b}}^{l}\right\|_{2}\qquad(\forall l\geq 1);" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒉</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mi>l</mi></msup></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mi>l</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝑾</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{h}}^{l+1}\right\|_{2}=\left\|\frac{1}{\sqrt{\tilde{d}}}{\bm{W}}^{l}{\bm{x}}^{l}+\beta{\bm{b}}^{l}\right\|_{2}\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}\right\|_{2}\left\|{\bm{x}}^{l}\right\|_{2}+\left\|\beta{\bm{b}}^{l}\right\|_{2}\qquad(\forall l\geq 1);</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex281"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex281.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{x}}^{l}\right\|_{2}=\left\|\sigma({\bm{h}}^{l})-\sigma({\bm{0}}^{l})+\sigma({\bm{0}}^{l})\right\|_{2}\leq L_{0}\left\|{\bm{h}}^{l}\right\|_{2}+\sigma(0)\sqrt{\tilde{d}}\qquad(\forall l\geq 1)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mn>𝟎</mn><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mn>𝟎</mn><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{x}}^{l}\right\|_{2}=\left\|\sigma({\bm{h}}^{l})-\sigma({\bm{0}}^{l})+\sigma({\bm{0}}^{l})\right\|_{2}\leq L_{0}\left\|{\bm{h}}^{l}\right\|_{2}+\sigma(0)\sqrt{\tilde{d}}\qquad(\forall l\geq 1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p5.3" class="ltx_p">Here, <math id="chapter12.A2.p5.m10" class="ltx_Math" alttext="L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">L_{0}</annotation></semantics></math> is the Lipschitz constant of <math id="chapter12.A2.p5.m11" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> and <math id="chapter12.A2.p5.m12" class="ltx_Math" alttext="\sigma({\bm{0}}^{l})=(\sigma(0),\cdots,\sigma(0))\in\mathbb{R}^{d_{l}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mn>𝟎</mn><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>l</mi></msub></msup></mrow><annotation encoding="application/x-tex">\sigma({\bm{0}}^{l})=(\sigma(0),\cdots,\sigma(0))\in\mathbb{R}^{d_{l}}</annotation></semantics></math>.
Thus, we can prove by induction that there exists an <math id="chapter12.A2.p5.m13" class="ltx_Math" alttext="M_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{2}&gt;0</annotation></semantics></math> such that <math id="chapter12.A2.p5.m14" class="ltx_Math" alttext="\left\|{\bm{x}}^{l}\right\|_{2}\leq M_{2}\sqrt{\tilde{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{x}}^{l}\right\|_{2}\leq M_{2}\sqrt{\tilde{d}}</annotation></semantics></math> and <math id="chapter12.A2.p5.m15" class="ltx_Math" alttext="\left\|{\bm{h}}^{l}\right\|_{2}\leq M_{2}\sqrt{\tilde{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{h}}^{l}\right\|_{2}\leq M_{2}\sqrt{\tilde{d}}</annotation></semantics></math> for all <math id="chapter12.A2.p5.m16" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p6" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p6.1" class="ltx_p">Denote <math id="chapter12.A2.p6.m1" class="ltx_Math" alttext="{\bm{\alpha}}^{l}=\nabla_{{\bm{h}}^{l}}f(x)=\nabla_{{\bm{h}}^{l}}{\bm{h}}^{L+1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mi>l</mi></msup><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝒉</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝒉</mi><mi>l</mi></msup></msub><msup><mi>𝒉</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{l}=\nabla_{{\bm{h}}^{l}}f(x)=\nabla_{{\bm{h}}^{l}}{\bm{h}}^{L+1}</annotation></semantics></math>. For all <math id="chapter12.A2.p6.m2" class="ltx_Math" alttext="1\leq l\leq L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">1\leq l\leq L</annotation></semantics></math>, we have <math id="chapter12.A2.p6.m3" class="ltx_Math" alttext="{\bm{\alpha}}^{l}={\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}{\bm{\alpha}}^{l+1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mi>l</mi></msup><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>𝑾</mi><mrow><mi>l</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{l}={\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}{\bm{\alpha}}^{l+1}</annotation></semantics></math>, <math id="chapter12.A2.p6.m4" class="ltx_Math" alttext="{\bm{\alpha}}^{L+1}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{L+1}=1</annotation></semantics></math> and <math id="chapter12.A2.p6.m5" class="ltx_Math" alttext="\left\|{\bm{\alpha}}^{L}\right\|_{2}=\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{L}))\frac{{\bm{W}}^{L\top}}{\sqrt{\tilde{d}}}\right\|_{2}\leq\frac{3}{\sqrt[4]{\tilde{d}}}L_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mi>L</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>L</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>𝑾</mi><mrow><mi>L</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><mn>3</mn><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{\alpha}}^{L}\right\|_{2}=\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{L}))\frac{{\bm{W}}^{L\top}}{\sqrt{\tilde{d}}}\right\|_{2}\leq\frac{3}{\sqrt[4]{\tilde{d}}}L_{0}</annotation></semantics></math>.
Since <math id="chapter12.A2.p6.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> is <math id="chapter12.A2.p6.m7" class="ltx_Math" alttext="L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">L_{0}</annotation></semantics></math>-Lipschitz, we have <math id="chapter12.A2.p6.m8" class="ltx_Math" alttext="\dot{\sigma}(x)\leq L_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>L</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\dot{\sigma}(x)\leq L_{0}</annotation></semantics></math> for all <math id="chapter12.A2.p6.m9" class="ltx_Math" alttext="x\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}</annotation></semantics></math>.
Thus, we can prove by induction that there exists an <math id="chapter12.A2.p6.m10" class="ltx_Math" alttext="M_{3}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>3</mn></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{3}&gt;1</annotation></semantics></math> such that <math id="chapter12.A2.p6.m11" class="ltx_Math" alttext="\left\|{\bm{\alpha}}^{l}\right\|_{2}\leq M_{3}/\sqrt[4]{\tilde{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>M</mi><mn>3</mn></msub><mo>/</mo><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{\alpha}}^{l}\right\|_{2}\leq M_{3}/\sqrt[4]{\tilde{d}}</annotation></semantics></math> for all <math id="chapter12.A2.p6.m12" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math> (note that this is not true for <math id="chapter12.A2.p6.m13" class="ltx_Math" alttext="L+1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L+1</annotation></semantics></math> because <math id="chapter12.A2.p6.m14" class="ltx_Math" alttext="{\bm{\alpha}}^{L+1}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{L+1}=1</annotation></semantics></math>).</p>
</div>
<div id="chapter12.A2.p7" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p7.1" class="ltx_p">For <math id="chapter12.A2.p7.m1" class="ltx_Math" alttext="l=0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l=0</annotation></semantics></math>, <math id="chapter12.A2.p7.m2" class="ltx_Math" alttext="\nabla_{{\bm{W}}^{0}}f(x)=\frac{1}{\sqrt{d_{0}}}{\bm{x}}^{0}{\bm{\alpha}}^{1\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msup><mi>𝑾</mi><mn>0</mn></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mn>1</mn><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{W}}^{0}}f(x)=\frac{1}{\sqrt{d_{0}}}{\bm{x}}^{0}{\bm{\alpha}}^{1\top}</annotation></semantics></math>, so <math id="chapter12.A2.p7.m3" class="ltx_Math" alttext="\left\|\nabla_{{\bm{W}}^{l}}f(x)\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{x}}^{0}\right\|_{2}\left\|{\bm{\alpha}}^{1}\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}M_{3}/\sqrt[4]{\tilde{d}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝑾</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mn>0</mn></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mn>1</mn></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow><mo>/</mo><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mrow></mrow><annotation encoding="application/x-tex">\left\|\nabla_{{\bm{W}}^{l}}f(x)\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{x}}^{0}\right\|_{2}\left\|{\bm{\alpha}}^{1}\right\|_{2}\leq\frac{1}{\sqrt{d_{0}}}M_{3}/\sqrt[4]{\tilde{d}}</annotation></semantics></math>.
And for any <math id="chapter12.A2.p7.m4" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math>, <math id="chapter12.A2.p7.m5" class="ltx_Math" alttext="\nabla_{{\bm{W}}^{l}}f(x)=\frac{1}{\sqrt{\tilde{d}}}{\bm{x}}^{l}{\bm{\alpha}}^{l+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msup><mi>𝑾</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{W}}^{l}}f(x)=\frac{1}{\sqrt{\tilde{d}}}{\bm{x}}^{l}{\bm{\alpha}}^{l+1}</annotation></semantics></math>, so <math id="chapter12.A2.p7.m6" class="ltx_Math" alttext="\left\|\nabla_{{\bm{W}}^{l}}f(x)\right\|_{2}\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{x}}^{l}\right\|_{2}\left\|{\bm{\alpha}}^{l+1}\right\|_{2}\leq M_{2}M_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝑾</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|\nabla_{{\bm{W}}^{l}}f(x)\right\|_{2}\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{x}}^{l}\right\|_{2}\left\|{\bm{\alpha}}^{l+1}\right\|_{2}\leq M_{2}M_{3}</annotation></semantics></math>. (Note that if <math id="chapter12.A2.p7.m7" class="ltx_Math" alttext="M_{3}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>3</mn></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{3}&gt;1</annotation></semantics></math>, then <math id="chapter12.A2.p7.m8" class="ltx_Math" alttext="\left\|{\bm{\alpha}}^{L+1}\right\|_{2}\leq M_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>M</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\left\|{\bm{\alpha}}^{L+1}\right\|_{2}\leq M_{3}</annotation></semantics></math>; and since <math id="chapter12.A2.p7.m9" class="ltx_Math" alttext="\tilde{d}\geq 1" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tilde{d}\geq 1</annotation></semantics></math>, there is <math id="chapter12.A2.p7.m10" class="ltx_Math" alttext="\left\|{\bm{\alpha}}^{l}\right\|_{2}\leq M_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>𝜶</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>M</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\left\|{\bm{\alpha}}^{l}\right\|_{2}\leq M_{3}</annotation></semantics></math> for <math id="chapter12.A2.p7.m11" class="ltx_Math" alttext="l\leq L" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l\leq L</annotation></semantics></math>.) Moreover, for <math id="chapter12.A2.p7.m12" class="ltx_Math" alttext="l=0,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=0,\cdots,L</annotation></semantics></math>, <math id="chapter12.A2.p7.m13" class="ltx_Math" alttext="\nabla_{{\bm{b}}^{l}}f({\bm{x}})=\beta{\bm{\alpha}}^{l+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msup><mi>𝒃</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{b}}^{l}}f({\bm{x}})=\beta{\bm{\alpha}}^{l+1}</annotation></semantics></math>, so <math id="chapter12.A2.p7.m14" class="ltx_Math" alttext="\left\|\nabla_{{\bm{b}}^{l}}f(x)\right\|_{2}\leq\beta M_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝒃</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|\nabla_{{\bm{b}}^{l}}f(x)\right\|_{2}\leq\beta M_{3}</annotation></semantics></math>. Thus, there exists an <math id="chapter12.A2.p7.m15" class="ltx_Math" alttext="M_{4}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>4</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{4}&gt;0</annotation></semantics></math>, such that <math id="chapter12.A2.p7.m16" class="ltx_Math" alttext="\left\|\nabla_{\theta}f(x)\right\|_{2}\leq M_{4}/\sqrt{n}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>M</mi><mn>4</mn></msub><mo>/</mo><msqrt><mi>n</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\left\|\nabla_{\theta}f(x)\right\|_{2}\leq M_{4}/\sqrt{n}</annotation></semantics></math>. And since <math id="chapter12.A2.p7.m17" class="ltx_Math" alttext="\left\|{\bm{x}}_{i}\right\|_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\left\|{\bm{x}}_{i}\right\|_{2}\leq 1</annotation></semantics></math> for all <math id="chapter12.A2.p7.m18" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, so <math id="chapter12.A2.p7.m19" class="ltx_Math" alttext="\left\|J(\theta)\right\|_{F}\leq M_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><msub><mi>M</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\left\|J(\theta)\right\|_{F}\leq M_{4}</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p8" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p8.1" class="ltx_p">Next, we consider the difference in <math id="chapter12.A2.p8.m1" class="ltx_Math" alttext="\nabla_{\theta}f(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f(x)</annotation></semantics></math> between <math id="chapter12.A2.p8.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="chapter12.A2.p8.m3" class="ltx_Math" alttext="\tilde{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\theta}</annotation></semantics></math>. Let <math id="chapter12.A2.p8.m4" class="ltx_Math" alttext="\tilde{f},\tilde{{\bm{W}}},\tilde{{\bm{b}}},\tilde{{\bm{x}}},\tilde{{\bm{h}}},\tilde{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒃</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{f},\tilde{{\bm{W}}},\tilde{{\bm{b}}},\tilde{{\bm{x}}},\tilde{{\bm{h}}},\tilde{{\bm{\alpha}}}</annotation></semantics></math> be the function and the values corresponding to <math id="chapter12.A2.p8.m5" class="ltx_Math" alttext="\tilde{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\theta}</annotation></semantics></math>. We have</p>
<table id="chapter12.A2.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex282"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex282.m1" class="ltx_Math" alttext="\displaystyle\begin{aligned} \left\|{\bm{h}}^{1}-\tilde{{\bm{h}}}^{1}\right\|_{2}&amp;=\left\|\frac{1}{\sqrt{d_{0}}}({\bm{W}}^{0}-\tilde{{\bm{W}}}^{0})x+\beta({\bm{b}}^{0}-\tilde{{\bm{b}}}^{0})\right\|_{2}\\
&amp;\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{W}}^{0}-\tilde{{\bm{W}}}^{0}\right\|_{2}\left\|x\right\|_{2}+\beta\left\|{\bm{b}}^{0}-\tilde{{\bm{b}}}^{0}\right\|_{2}\leq\left(\frac{1}{\sqrt{d_{0}}}+\beta\right)\left\|\theta-\tilde{\theta}\right\|_{2}\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒉</mi><mn>1</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mn>1</mn></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mn>0</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mn>0</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒃</mi><mn>0</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝒃</mi><mo>~</mo></mover><mn>0</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝑾</mi><mn>0</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mn>0</mn></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒃</mi><mn>0</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝒃</mi><mo>~</mo></mover><mn>0</mn></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo>+</mo><mi>β</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \left\|{\bm{h}}^{1}-\tilde{{\bm{h}}}^{1}\right\|_{2}&amp;=\left\|\frac{1}{\sqrt{d_{0}}}({\bm{W}}^{0}-\tilde{{\bm{W}}}^{0})x+\beta({\bm{b}}^{0}-\tilde{{\bm{b}}}^{0})\right\|_{2}\\
&amp;\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{W}}^{0}-\tilde{{\bm{W}}}^{0}\right\|_{2}\left\|x\right\|_{2}+\beta\left\|{\bm{b}}^{0}-\tilde{{\bm{b}}}^{0}\right\|_{2}\leq\left(\frac{1}{\sqrt{d_{0}}}+\beta\right)\left\|\theta-\tilde{\theta}\right\|_{2}\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex283.m1" class="ltx_Math" alttext="\displaystyle\begin{aligned} \left\|{\bm{h}}^{l+1}-\tilde{{\bm{h}}}^{l+1}\right\|_{2}&amp;=\left\|\frac{1}{\sqrt{\tilde{d}}}{\bm{W}}^{l}({\bm{x}}^{l}-\tilde{{\bm{x}}}^{l})+\frac{1}{\sqrt{\tilde{d}}}({\bm{W}}^{l}-\tilde{{\bm{W}}}^{l})\tilde{{\bm{x}}}^{l}+\beta({\bm{b}}^{l}-\tilde{{\bm{b}}}^{l})\right\|_{2}\\
&amp;\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}\right\|_{2}\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}+\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}-\tilde{{\bm{W}}}^{l}\right\|_{2}\left\|\tilde{{\bm{x}}}^{l}\right\|_{2}+\beta\left\|{\bm{b}}^{l}-\tilde{{\bm{b}}}^{l}\right\|_{2}\\
&amp;\leq 3\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}+(M_{2}+\beta)\left\|\theta-\tilde{\theta}\right\|_{2}\qquad(\forall l\geq 1)\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒉</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒙</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>+</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒃</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒃</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>𝑾</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝑾</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒃</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒃</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>≤</mo><mn>3</mn><mo>‖</mo><mi>𝒙</mi><msup><mrow></mrow><mi>l</mi></msup><mo>−</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><msup><mrow></mrow><mi>l</mi></msup><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>+</mo><mo stretchy="false">(</mo><mi>M</mi><msub><mrow></mrow><mn>2</mn></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mo>‖</mo><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mo rspace="0.167em">∀</mo><mi>l</mi><mo>≥</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \left\|{\bm{h}}^{l+1}-\tilde{{\bm{h}}}^{l+1}\right\|_{2}&amp;=\left\|\frac{1}{\sqrt{\tilde{d}}}{\bm{W}}^{l}({\bm{x}}^{l}-\tilde{{\bm{x}}}^{l})+\frac{1}{\sqrt{\tilde{d}}}({\bm{W}}^{l}-\tilde{{\bm{W}}}^{l})\tilde{{\bm{x}}}^{l}+\beta({\bm{b}}^{l}-\tilde{{\bm{b}}}^{l})\right\|_{2}\\
&amp;\leq\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}\right\|_{2}\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}+\frac{1}{\sqrt{\tilde{d}}}\left\|{\bm{W}}^{l}-\tilde{{\bm{W}}}^{l}\right\|_{2}\left\|\tilde{{\bm{x}}}^{l}\right\|_{2}+\beta\left\|{\bm{b}}^{l}-\tilde{{\bm{b}}}^{l}\right\|_{2}\\
&amp;\leq 3\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}+(M_{2}+\beta)\left\|\theta-\tilde{\theta}\right\|_{2}\qquad(\forall l\geq 1)\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex284"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex284.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}=\left\|\sigma({\bm{h}}^{l})-\sigma(\tilde{{\bm{h}}}^{l})\right\|_{2}\leq L_{0}\left\|{\bm{h}}^{l}-\tilde{{\bm{h}}}^{l}\right\|_{2}\qquad(\forall l\geq 1)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>L</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒉</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}=\left\|\sigma({\bm{h}}^{l})-\sigma(\tilde{{\bm{h}}}^{l})\right\|_{2}\leq L_{0}\left\|{\bm{h}}^{l}-\tilde{{\bm{h}}}^{l}\right\|_{2}\qquad(\forall l\geq 1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p8.2" class="ltx_p">Thus, we can prove by induction that there exists an <math id="chapter12.A2.p8.m6" class="ltx_Math" alttext="M_{5}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>5</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{5}&gt;0</annotation></semantics></math> such that <math id="chapter12.A2.p8.m7" class="ltx_Math" alttext="\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}\leq M_{5}\left\|\theta-\tilde{\theta}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>M</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}\leq M_{5}\left\|\theta-\tilde{\theta}\right\|_{2}</annotation></semantics></math> for all <math id="chapter12.A2.p8.m8" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p9" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p9.2" class="ltx_p">For <math id="chapter12.A2.p9.m1" class="ltx_Math" alttext="{\bm{\alpha}}^{l}" display="inline" intent=":literal"><semantics><msup><mi>𝜶</mi><mi>l</mi></msup><annotation encoding="application/x-tex">{\bm{\alpha}}^{l}</annotation></semantics></math>, we have <math id="chapter12.A2.p9.m2" class="ltx_Math" alttext="{\bm{\alpha}}^{L+1}=\tilde{{\bm{\alpha}}}^{L+1}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{L+1}=\tilde{{\bm{\alpha}}}^{L+1}=1</annotation></semantics></math>, and for all <math id="chapter12.A2.p9.m3" class="ltx_Math" alttext="l\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\geq 1</annotation></semantics></math>,</p>
<table id="chapter12.A2.E46" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="chapter12.A2.E46X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.E46X.m2" class="ltx_Math" alttext="\displaystyle\left\|{\bm{\alpha}}^{l}-\tilde{{\bm{\alpha}}}^{l}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mi>𝜶</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{\alpha}}^{l}-\tilde{{\bm{\alpha}}}^{l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E46X.m3" class="ltx_Math" alttext="\displaystyle=\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}{\bm{\alpha}}^{l+1}-{\textnormal{diag}}(\dot{\sigma}(\tilde{{\bm{h}}}^{l}))\frac{\tilde{{\bm{W}}}^{l\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑾</mi><mrow><mi>l</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mrow><mi>l</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}{\bm{\alpha}}^{l+1}-{\textnormal{diag}}(\dot{\sigma}(\tilde{{\bm{h}}}^{l}))\frac{\tilde{{\bm{W}}}^{l\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(46)</span></td></tr>
<tr id="chapter12.A2.E46Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E46Xa.m2" class="ltx_Math" alttext="\displaystyle\begin{aligned} \leq\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}({\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1})\right\|_{2}&amp;+\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{({\bm{W}}^{l}-\tilde{{\bm{W}}}^{l})^{\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\\
&amp;+\left\|{\textnormal{diag}}((\dot{\sigma}({\bm{h}}^{l})-\dot{\sigma}(\tilde{{\bm{h}}}^{l})))\frac{\tilde{{\bm{W}}}^{l\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑾</mi><mrow><mi>l</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑾</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒉</mi><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒉</mi><mo>~</mo></mover><mi>l</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mrow><mi>l</mi><mo lspace="0.222em">⊤</mo></mrow></msup><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \leq\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{{\bm{W}}^{l\top}}{\sqrt{\tilde{d}}}({\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1})\right\|_{2}&amp;+\left\|{\textnormal{diag}}(\dot{\sigma}({\bm{h}}^{l}))\frac{({\bm{W}}^{l}-\tilde{{\bm{W}}}^{l})^{\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\\
&amp;+\left\|{\textnormal{diag}}((\dot{\sigma}({\bm{h}}^{l})-\dot{\sigma}(\tilde{{\bm{h}}}^{l})))\frac{\tilde{{\bm{W}}}^{l\top}}{\sqrt{\tilde{d}}}\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="chapter12.A2.E46Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E46Xb.m2" class="ltx_Math" alttext="\displaystyle\leq 3L_{0}\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}+\left(M_{3}L_{0}\tilde{d}^{-1/2}+3M_{3}M_{5}L_{1}\tilde{d}^{-1/4}\right)\left\|\theta-\tilde{\theta}\right\|_{2}," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>3</mn><mi>L</mi><msub><mrow></mrow><mn>0</mn></msub><mo>‖</mo><mi>𝜶</mi><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>+</mo><mo>(</mo><mi>M</mi><msub><mrow></mrow><mn>3</mn></msub><mi>L</mi><msub><mrow></mrow><mn>0</mn></msub><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><mi>M</mi><msub><mrow></mrow><mn>3</mn></msub><mi>M</mi><msub><mrow></mrow><mn>5</mn></msub><mi>L</mi><msub><mrow></mrow><mn>1</mn></msub><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>)</mo><mo>‖</mo><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3L_{0}\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}+\left(M_{3}L_{0}\tilde{d}^{-1/2}+3M_{3}M_{5}L_{1}\tilde{d}^{-1/4}\right)\left\|\theta-\tilde{\theta}\right\|_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p9.3" class="ltx_p">where <math id="chapter12.A2.p9.m4" class="ltx_Math" alttext="L_{1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>1</mn></msub><annotation encoding="application/x-tex">L_{1}</annotation></semantics></math> is the Lipschitz constant of <math id="chapter12.A2.p9.m5" class="ltx_Math" alttext="\dot{\sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><annotation encoding="application/x-tex">\dot{\sigma}</annotation></semantics></math>. In particular, for <math id="chapter12.A2.p9.m6" class="ltx_Math" alttext="l=L" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=L</annotation></semantics></math>, though <math id="chapter12.A2.p9.m7" class="ltx_Math" alttext="\tilde{{\bm{\alpha}}}^{L+1}=1" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tilde{{\bm{\alpha}}}^{L+1}=1</annotation></semantics></math>, since <math id="chapter12.A2.p9.m8" class="ltx_Math" alttext="\left\|\tilde{{\bm{W}}}^{L}\right\|_{2}\leq 3\tilde{d}^{1/4}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>L</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left\|\tilde{{\bm{W}}}^{L}\right\|_{2}\leq 3\tilde{d}^{1/4}</annotation></semantics></math>, <a href="#chapter12.A2.E46" title="In Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">46</span></a> is still true. Thus, we can prove by induction that there exists an <math id="chapter12.A2.p9.m9" class="ltx_Math" alttext="M_{6}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>6</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{6}&gt;0</annotation></semantics></math> such that <math id="chapter12.A2.p9.m10" class="ltx_Math" alttext="\left\|{\bm{\alpha}}^{l}-\tilde{{\bm{\alpha}}}^{l}\right\|_{2}\leq\frac{M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝜶</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><msub><mi>M</mi><mn>6</mn></msub><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{\alpha}}^{l}-\tilde{{\bm{\alpha}}}^{l}\right\|_{2}\leq\frac{M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}</annotation></semantics></math> for all <math id="chapter12.A2.p9.m11" class="ltx_Math" alttext="l\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l\geq 1</annotation></semantics></math> (note that this is also true for <math id="chapter12.A2.p9.m12" class="ltx_Math" alttext="l=L+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=L+1</annotation></semantics></math>).</p>
</div>
<div id="chapter12.A2.p10" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p10.1" class="ltx_p">Thus, for all <math id="chapter12.A2.p10.m1" class="ltx_Math" alttext="\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0})</annotation></semantics></math>, and any <math id="chapter12.A2.p10.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="chapter12.A2.p10.m3" class="ltx_Math" alttext="{\left\|x\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>x</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|x\right\|}_{2}\leq 1</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex285"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex285.m1" class="ltx_Math" alttext="\displaystyle\left\|\nabla_{{\bm{W}}^{0}}f(x)-\nabla_{\tilde{{\bm{W}}}^{0}}\tilde{f}(x)\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝑾</mi><mn>0</mn></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mn>0</mn></msup></msub><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\nabla_{{\bm{W}}^{0}}f(x)-\nabla_{\tilde{{\bm{W}}}^{0}}\tilde{f}(x)\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex285.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{d_{0}}}\left\|x{\bm{\alpha}}^{1\top}-x\tilde{{\bm{\alpha}}}^{1\top}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mn>1</mn><mo lspace="0.222em">⊤</mo></mrow></msup></mrow><mo>−</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mn>1</mn><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{d_{0}}}\left\|x{\bm{\alpha}}^{1\top}-x\tilde{{\bm{\alpha}}}^{1\top}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex286"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex286.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{\alpha}}^{1}-\tilde{{\bm{\alpha}}}^{1}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝜶</mi><mn>1</mn></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mn>1</mn></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sqrt{d_{0}}}\left\|{\bm{\alpha}}^{1}-\tilde{{\bm{\alpha}}}^{1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex287"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex287.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sqrt{d_{0}}}\frac{M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>M</mi><mn>6</mn></msub><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sqrt{d_{0}}}\frac{M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p10.2" class="ltx_p">and for <math id="chapter12.A2.p10.m4" class="ltx_Math" alttext="l=1,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\cdots,L</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex288"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex288.m1" class="ltx_Math" alttext="\displaystyle\left\|\nabla_{{\bm{W}}^{l}}f(x)-\nabla_{\tilde{{\bm{W}}}^{l}}\tilde{f}(x)\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>𝑾</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>l</mi></msup></msub><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\nabla_{{\bm{W}}^{l}}f(x)-\nabla_{\tilde{{\bm{W}}}^{l}}\tilde{f}(x)\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex288.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\tilde{d}}}\left\|x^{l}{\bm{\alpha}}^{l+1\top}-\tilde{x}^{l}\tilde{{\bm{\alpha}}}^{l+1\top}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>x</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.222em">⊤</mo></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\tilde{d}}}\left\|x^{l}{\bm{\alpha}}^{l+1\top}-\tilde{x}^{l}\tilde{{\bm{\alpha}}}^{l+1\top}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex289"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex289.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sqrt{\tilde{d}}}\left(\left\|{\bm{x}}^{l}\right\|_{2}\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}+\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}\left\|\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mrow><mo>‖</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝒙</mi><mi>l</mi></msup><mo>−</mo><msup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>l</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sqrt{\tilde{d}}}\left(\left\|{\bm{x}}^{l}\right\|_{2}\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}+\left\|{\bm{x}}^{l}-\tilde{{\bm{x}}}^{l}\right\|_{2}\left\|\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex290"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex290.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{M_{2}M_{6}}{\sqrt[4]{\tilde{d}}}+\frac{M_{5}M_{3}}{\sqrt{\tilde{d}}}\right)\left\|\theta-\tilde{\theta}\right\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>6</mn></msub></mrow><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow><msqrt><mover accent="true"><mi>d</mi><mo>~</mo></mover></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{M_{2}M_{6}}{\sqrt[4]{\tilde{d}}}+\frac{M_{5}M_{3}}{\sqrt{\tilde{d}}}\right)\left\|\theta-\tilde{\theta}\right\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p10.3" class="ltx_p">Moreover, for any <math id="chapter12.A2.p10.m5" class="ltx_Math" alttext="l=0,\cdots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=0,\cdots,L</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.Ex291" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex291.m1" class="ltx_Math" alttext="\left\|\nabla_{b^{l}}f(x)-\nabla_{\tilde{b}^{l}}\tilde{f}(x)\right\|_{2}=\beta\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\leq\frac{\beta M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>b</mi><mi>l</mi></msup></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msup><mover accent="true"><mi>b</mi><mo>~</mo></mover><mi>l</mi></msup></msub><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>𝜶</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>6</mn></msub></mrow><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\nabla_{b^{l}}f(x)-\nabla_{\tilde{b}^{l}}\tilde{f}(x)\right\|_{2}=\beta\left\|{\bm{\alpha}}^{l+1}-\tilde{{\bm{\alpha}}}^{l+1}\right\|_{2}\leq\frac{\beta M_{6}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p10.4" class="ltx_p">Combining all the above, we can see that there exists a constant <math id="chapter12.A2.p10.m6" class="ltx_Math" alttext="M_{7}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>7</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{7}&gt;0</annotation></semantics></math> such that <math id="chapter12.A2.p10.m7" class="ltx_Math" alttext="\left\|\nabla_{\theta}f(x)-\nabla_{\tilde{\theta}}\tilde{f}(x)\right\|_{2}\leq\frac{M_{7}}{\sqrt{n}\cdot\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></msub><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mfrac><msub><mi>M</mi><mn>7</mn></msub><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0.222em" rspace="0.222em">⋅</mo><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|\nabla_{\theta}f(x)-\nabla_{\tilde{\theta}}\tilde{f}(x)\right\|_{2}\leq\frac{M_{7}}{\sqrt{n}\cdot\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}</annotation></semantics></math>, so that <math id="chapter12.A2.p10.m8" class="ltx_Math" alttext="\left\|J(\theta)-J(\tilde{\theta})\right\|_{F}\leq\frac{M_{7}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mfrac><msub><mi>M</mi><mn>7</mn></msub><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>θ</mi><mo>−</mo><mover accent="true"><mi>θ</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|J(\theta)-J(\tilde{\theta})\right\|_{F}\leq\frac{M_{7}}{\sqrt[4]{\tilde{d}}}\left\|\theta-\tilde{\theta}\right\|_{2}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter12.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma 12.5</span></span><span id="chapter12.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter12.Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="chapter12.Thmtheorem5.p1.1" class="ltx_p"><span id="chapter12.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">There exist constants <math id="chapter12.Thmtheorem5.p1.m1" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math> and <math id="chapter12.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\epsilon_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{0}&gt;0</annotation></semantics></math> such that for all <math id="chapter12.Thmtheorem5.p1.m3" class="ltx_Math" alttext="\epsilon\in(0,\epsilon_{0}]" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,\epsilon_{0}]</annotation></semantics></math>, <math id="chapter12.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\eta\leq\eta^{*}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msup><mi>η</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\eta\leq\eta^{*}</annotation></semantics></math> and any <math id="chapter12.Thmtheorem5.p1.m5" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, there exist <math id="chapter12.Thmtheorem5.p1.m6" class="ltx_Math" alttext="R_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{0}&gt;0</annotation></semantics></math>, <math id="chapter12.Thmtheorem5.p1.m7" class="ltx_Math" alttext="\tilde{D}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{D}&gt;0</annotation></semantics></math> and <math id="chapter12.Thmtheorem5.p1.m8" class="ltx_Math" alttext="B&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">B&gt;1</annotation></semantics></math> such that for any <math id="chapter12.Thmtheorem5.p1.m9" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>, the following (i) and (ii) hold with probability at least <math id="chapter12.Thmtheorem5.p1.m10" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math> over random initialization when applying gradient descent with learning rate <math id="chapter12.Thmtheorem5.p1.m11" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>:</span></p>
<ol id="chapter12.A2.I1" class="ltx_enumerate">
<li id="chapter12.A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="chapter12.A2.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="chapter12.A2.I1.i1.p1.1" class="ltx_p"><span id="chapter12.A2.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="chapter12.A2.I1.i1.p1.m1" class="ltx_Math" alttext="t\leq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\leq t_{\epsilon}</annotation></semantics></math><span id="chapter12.A2.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">, there is</span></p>
<table id="chapter12.A2.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E47.m2" class="ltx_Math" alttext="\displaystyle\left\|g(\theta^{(t)})\right\|_{2}\leq B^{t}R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msup><mi>B</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|g(\theta^{(t)})\right\|_{2}\leq B^{t}R_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
<tbody id="chapter12.A2.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E48.m2" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{t}\left\|\theta^{(j)}-\theta^{(j-1)}\right\|_{2}\leq\eta MR_{0}\sum_{j=1}^{t}B^{j-1}&lt;\frac{MB^{t_{\epsilon}}R_{0}}{B-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><mi>B</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{t}\left\|\theta^{(j)}-\theta^{(j-1)}\right\|_{2}\leq\eta MR_{0}\sum_{j=1}^{t}B^{j-1}&lt;\frac{MB^{t_{\epsilon}}R_{0}}{B-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
</div></li>
<li id="chapter12.A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="chapter12.A2.I1.i2.p1" class="ltx_para">
<p id="chapter12.A2.I1.i2.p1.1" class="ltx_p"><span id="chapter12.A2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="chapter12.A2.I1.i2.p1.m1" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math><span id="chapter12.A2.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, we have</span></p>
<table id="chapter12.A2.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E49.m2" class="ltx_Math" alttext="\displaystyle\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}\leq\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}\leq\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
<tbody id="chapter12.A2.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.E50.m2" class="ltx_Math" alttext="\displaystyle\begin{aligned} \sum_{j=t_{\epsilon}+1}^{t}\left\|\theta^{(j)}-\theta^{(j-1)}\right\|_{2}&amp;\leq\eta\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}\sum_{j=t_{\epsilon}+1}^{t}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{j-t_{\epsilon}}\\
&amp;&lt;\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><msub><mi>t</mi><mi>ϵ</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><msub><mi>t</mi><mi>ϵ</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>j</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \sum_{j=t_{\epsilon}+1}^{t}\left\|\theta^{(j)}-\theta^{(j-1)}\right\|_{2}&amp;\leq\eta\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}\sum_{j=t_{\epsilon}+1}^{t}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{j-t_{\epsilon}}\\
&amp;&lt;\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="chapter12.A2.p11" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p11.1" class="ltx_p"><span id="chapter12.A2.p11.1.1" class="ltx_text ltx_font_bold">Proof </span>
Note that for any <math id="chapter12.A2.p11.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="chapter12.A2.p11.m2" class="ltx_Math" alttext="f^{(0)}(x)=\beta{\bm{b}}^{L}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒃</mi><mi>L</mi></msup></mrow></mrow><annotation encoding="application/x-tex">f^{(0)}(x)=\beta{\bm{b}}^{L}</annotation></semantics></math> where <math id="chapter12.A2.p11.m3" class="ltx_Math" alttext="{\bm{b}}^{L}" display="inline" intent=":literal"><semantics><msup><mi>𝒃</mi><mi>L</mi></msup><annotation encoding="application/x-tex">{\bm{b}}^{L}</annotation></semantics></math> is sampled from the standard Gaussian distribution. Thus, for any <math id="chapter12.A2.p11.m4" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, there exists a constant <math id="chapter12.A2.p11.m5" class="ltx_Math" alttext="R_{0}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>0</mn></msub><annotation encoding="application/x-tex">R_{0}</annotation></semantics></math> such that with probability at least <math id="chapter12.A2.p11.m6" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math> over random initialization, we have <math id="chapter12.A2.p11.m7" class="ltx_Math" alttext="{\left\|g(\theta^{(0)})\right\|}_{2}&lt;R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|g(\theta^{(0)})\right\|}_{2}&lt;R_{0}</annotation></semantics></math>.
And by <a href="#chapter6.Thmtheorem5" title="Lemma 6.5. ‣ Wide neural networks, regression tasks. ‣ 25 Generalized Reweighting (GRW) Versus ERM ‣ Chapter 6 Generalization Under Distribution Shift ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6.5</span></a>, there exists <math id="chapter12.A2.p11.m8" class="ltx_Math" alttext="D_{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>2</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{2}\geq 0</annotation></semantics></math> such that for any <math id="chapter12.A2.p11.m9" class="ltx_Math" alttext="\tilde{d}\geq D_{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{2}</annotation></semantics></math>, with probability at least <math id="chapter12.A2.p11.m10" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>, we have <math id="chapter12.A2.p11.m11" class="ltx_Math" alttext="{\left\|\Theta-\Theta^{(0)}\right\|}\leq\frac{q^{*}\lambda_{\min}}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mo>≤</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">{\left\|\Theta-\Theta^{(0)}\right\|}\leq\frac{q^{*}\lambda_{\min}}{3}</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p12" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p12.1" class="ltx_p">Let <math id="chapter12.A2.p12.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be the constant in <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>. Let <math id="chapter12.A2.p12.m2" class="ltx_Math" alttext="\epsilon_{0}=\frac{(q^{*}\lambda_{\min})^{2}}{108M^{4}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>108</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>4</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\epsilon_{0}=\frac{(q^{*}\lambda_{\min})^{2}}{108M^{4}}</annotation></semantics></math>, <math id="chapter12.A2.p12.m3" class="ltx_Math" alttext="B=1+\eta^{*}M^{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>η</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">B=1+\eta^{*}M^{2}</annotation></semantics></math>, and <math id="chapter12.A2.p12.m4" class="ltx_Math" alttext="C_{0}=\frac{MB^{t_{\epsilon}}R_{0}}{B-1}+\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mrow><mfrac><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><mi>B</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C_{0}=\frac{MB^{t_{\epsilon}}R_{0}}{B-1}+\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}</annotation></semantics></math>.
By <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>, there exists <math id="chapter12.A2.p12.m5" class="ltx_Math" alttext="D_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{1}&gt;0</annotation></semantics></math> such that with probability at least <math id="chapter12.A2.p12.m6" class="ltx_Math" alttext="(1-\delta/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>3</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta/3)</annotation></semantics></math>, for any <math id="chapter12.A2.p12.m7" class="ltx_Math" alttext="\tilde{d}\geq D_{1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><msub><mi>D</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{d}\geq D_{1}</annotation></semantics></math>, <a href="#chapter12.A2.E45" title="In Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">45</span></a> is true for all <math id="chapter12.A2.p12.m8" class="ltx_Math" alttext="\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>,</mo><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta,\tilde{\theta}\in B(\theta^{(0)},C_{0})</annotation></semantics></math>.
By union bound, with probability at least <math id="chapter12.A2.p12.m9" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, all the three above inequalities holds.</p>
</div>
<div id="chapter12.A2.p13" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p13.1" class="ltx_p">Let us prove <a href="#chapter12.A2.E47" title="In Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">47</span></a> and <a href="#chapter12.A2.E48" title="Equation 48 ‣ Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a> by induction. They are obviously true for <math id="chapter12.A2.p13.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.
Suppose they are true for <math id="chapter12.A2.p13.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
Then, for <math id="chapter12.A2.p13.m3" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex292.m1" class="ltx_Math" alttext="\displaystyle\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex292.m2" class="ltx_Math" alttext="\displaystyle\leq\eta\left\|J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\left\|g(\theta^{(t)})\right\|_{2}\leq\eta\left\|J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\left\|J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\left\|g(\theta^{(t)})\right\|_{2}\leq\eta\left\|J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex293.m1" class="ltx_Math" alttext="\displaystyle\leq\eta\left\|J(\theta^{(t)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}\leq M\eta B^{t}R_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\left\|J(\theta^{(t)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}\leq M\eta B^{t}R_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p13.2" class="ltx_p">which means that <a href="#chapter12.A2.E48" title="In Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">48</span></a> is also true for <math id="chapter12.A2.p13.m4" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>. In terms of <a href="#chapter12.A2.E47" title="In Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">47</span></a>, we have</p>
<table id="chapter12.A2.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex294.m1" class="ltx_Math" alttext="\displaystyle\left\|g(\theta^{(t+1)})\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|g(\theta^{(t+1)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex294.m2" class="ltx_Math" alttext="\displaystyle=\left\|g(\theta^{(t+1)})-g(\theta^{(t)})+g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|g(\theta^{(t+1)})-g(\theta^{(t)})+g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex295.m1" class="ltx_Math" alttext="\displaystyle=\left\|J(\tilde{\theta}^{(t)})^{\top}(\theta^{(t+1)}-\theta^{(t)})+g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|J(\tilde{\theta}^{(t)})^{\top}(\theta^{(t+1)}-\theta^{(t)})+g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex296.m1" class="ltx_Math" alttext="\displaystyle=\left\|-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})+g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})+g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex297.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|{\bm{I}}-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|{\bm{I}}-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex298.m1" class="ltx_Math" alttext="\displaystyle\leq\left(1+\left\|\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\right)\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1+\left\|\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}\right\|_{2}\right)\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex299.m1" class="ltx_Math" alttext="\displaystyle\leq\left(1+\eta\left\|J(\tilde{\theta}^{(t)})\right\|_{F}\left\|J(\theta^{(t)})\right\|_{F}\right)\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(1+\eta\left\|J(\tilde{\theta}^{(t)})\right\|_{F}\left\|J(\theta^{(t)})\right\|_{F}\right)\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex300"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex300.m1" class="ltx_Math" alttext="\displaystyle\leq(1+\eta^{*}M^{2})\left\|g(\theta^{(t)})\right\|_{2}\leq B^{t+1}R_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>η</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msup><mi>B</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+\eta^{*}M^{2})\left\|g(\theta^{(t)})\right\|_{2}\leq B^{t+1}R_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p13.3" class="ltx_p">Hence, <a href="#chapter12.A2.E47" title="In Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">47</span></a> and <a href="#chapter12.A2.E48" title="Equation 48 ‣ Item (i) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a> are true for all <math id="chapter12.A2.p13.m5" class="ltx_Math" alttext="t\leq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\leq t_{\epsilon}</annotation></semantics></math>, which implies that <math id="chapter12.A2.p13.m6" class="ltx_Math" alttext="\left\|\sqrt{{\bm{Q}}}g(\theta^{(t_{\epsilon})})\right\|_{2}\leq\left\|g(\theta^{(t_{\epsilon})})\right\|_{2}\leq B^{t_{\epsilon}}R_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left\|\sqrt{{\bm{Q}}}g(\theta^{(t_{\epsilon})})\right\|_{2}\leq\left\|g(\theta^{(t_{\epsilon})})\right\|_{2}\leq B^{t_{\epsilon}}R_{0}</annotation></semantics></math>.
Thus, <a href="#chapter12.A2.E49" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">49</span></a> is true for <math id="chapter12.A2.p13.m7" class="ltx_Math" alttext="t=t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t=t_{\epsilon}</annotation></semantics></math>.
And <a href="#chapter12.A2.E50" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">50</span></a> is obviously true for <math id="chapter12.A2.p13.m8" class="ltx_Math" alttext="t=t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t=t_{\epsilon}</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p14" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p14.1" class="ltx_p">Next, let us prove <a href="#chapter12.A2.E49" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">49</span></a> and <a href="#chapter12.A2.E50" title="Equation 50 ‣ Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a> by induction. Suppose they are true for <math id="chapter12.A2.p14.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. By <a href="#chapter12.A2.E44" title="In Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">44</span></a>, for <math id="chapter12.A2.p14.m2" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> we have</p>
<table id="chapter12.A2.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex301"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex301.m1" class="ltx_Math" alttext="\displaystyle\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\theta^{(t+1)}-\theta^{(t)}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex301.m2" class="ltx_Math" alttext="\displaystyle\leq\eta\left\|J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\left\|J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex302"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex302.m1" class="ltx_Math" alttext="\displaystyle\leq\eta\left\|J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{F}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\left\|J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{F}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex303.m1" class="ltx_Math" alttext="\displaystyle\leq\eta\sqrt{1+3\epsilon}\left\|J(\theta^{(t)})\right\|_{F}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\sqrt{1+3\epsilon}\left\|J(\theta^{(t)})\right\|_{F}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex304"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex304.m1" class="ltx_Math" alttext="\displaystyle\leq M\eta\sqrt{1+3\epsilon}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq M\eta\sqrt{1+3\epsilon}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t-t_{\epsilon}}B^{t_{\epsilon}}R_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.2" class="ltx_p">which implies that <a href="#chapter12.A2.E50" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">50</span></a> holds for <math id="chapter12.A2.p14.m3" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>. In terms of <a href="#chapter12.A2.E49" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">49</span></a>, we have</p>
<table id="chapter12.A2.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex305"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex305.m1" class="ltx_Math" alttext="\displaystyle\left\|\sqrt{{\bm{Q}}}g(\theta^{(t+1)})\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\sqrt{{\bm{Q}}}g(\theta^{(t+1)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex305.m2" class="ltx_Math" alttext="\displaystyle=\left\|\sqrt{{\bm{Q}}}g(\theta^{(t+1)})-\sqrt{{\bm{Q}}}g(\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\sqrt{{\bm{Q}}}g(\theta^{(t+1)})-\sqrt{{\bm{Q}}}g(\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex306"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex306.m1" class="ltx_Math" alttext="\displaystyle=\left\|\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}(\theta^{(t+1)}-\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}(\theta^{(t+1)}-\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex307"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex307.m1" class="ltx_Math" alttext="\displaystyle=\left\|-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})+\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex308"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex308.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left\|\sqrt{{\bm{Q}}}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex309"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex309.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t}R_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\left(1-\frac{\eta q^{*}\lambda_{\min}}{3}\right)^{t}R_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.3" class="ltx_p">where <math id="chapter12.A2.p14.m4" class="ltx_Math" alttext="\tilde{\theta}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\theta}^{(t)}</annotation></semantics></math> is some linear interpolation between <math id="chapter12.A2.p14.m5" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> and <math id="chapter12.A2.p14.m6" class="ltx_Math" alttext="\theta^{(t+1)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t+1)}</annotation></semantics></math>. Now we prove that</p>
<table id="chapter12.A2.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.E51.m1" class="ltx_Math" alttext="\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.4" class="ltx_p">For any unit vector <math id="chapter12.A2.p14.m7" class="ltx_Math" alttext="{\bm{v}}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝒗</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}\in\mathbb{R}^{n}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.Ex310" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex310.m1" class="ltx_Math" alttext="{\bm{v}}^{\top}({\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}){\bm{v}}=1-\eta{\bm{v}}^{\top}\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}{\bm{v}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}({\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}){\bm{v}}=1-\eta{\bm{v}}^{\top}\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}{\bm{v}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.5" class="ltx_p">where <math id="chapter12.A2.p14.m8" class="ltx_Math" alttext="\left\|\sqrt{{\bm{Q}}}{\bm{v}}\right\|_{2}\in[\sqrt{q^{*}},1]" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msqrt><msup><mi>q</mi><mo>∗</mo></msup></msqrt><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\left\|\sqrt{{\bm{Q}}}{\bm{v}}\right\|_{2}\in[\sqrt{q^{*}},1]</annotation></semantics></math>, so for any <math id="chapter12.A2.p14.m9" class="ltx_Math" alttext="\eta\leq\eta^{*}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msup><mi>η</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\eta\leq\eta^{*}</annotation></semantics></math>, <math id="chapter12.A2.p14.m10" class="ltx_Math" alttext="{\bm{v}}^{\top}({\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}){\bm{v}}\in[0,1-\eta\lambda_{\min}q^{*}]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}({\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}){\bm{v}}\in[0,1-\eta\lambda_{\min}q^{*}]</annotation></semantics></math>, which implies that <math id="chapter12.A2.p14.m11" class="ltx_Math" alttext="\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}\leq 1-\eta\lambda_{\min}q^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}\leq 1-\eta\lambda_{\min}q^{*}</annotation></semantics></math>. Thus, we have</p>
<table id="chapter12.A2.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex311"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex311.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex312"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex312.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex312.m2" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}))\sqrt{{\bm{Q}}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}))\sqrt{{\bm{Q}}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex313.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex313.m2" class="ltx_Math" alttext="\displaystyle 1-\eta\lambda_{\min}q^{*}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{F}+\eta\left\|\sqrt{{\bm{Q}}}(J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}))\sqrt{{\bm{Q}}}\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\eta\lambda_{\min}q^{*}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{F}+\eta\left\|\sqrt{{\bm{Q}}}(J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}))\sqrt{{\bm{Q}}}\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex314.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex314.m2" class="ltx_Math" alttext="\displaystyle 1-\eta\lambda_{\min}q^{*}+\eta\left\|\Theta-\Theta^{(0)}\right\|_{F}+\eta\left\|J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\eta\lambda_{\min}q^{*}+\eta\left\|\Theta-\Theta^{(0)}\right\|_{F}+\eta\left\|J(\theta^{(0)})^{\top}J(\theta^{(0)})-J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex315"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex315.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex315.m2" class="ltx_Math" alttext="\displaystyle 1-\eta\lambda_{\min}q^{*}+\frac{\eta q^{*}\lambda_{\min}}{3}+\frac{\eta M^{2}}{\sqrt[4]{\tilde{d}}}\left(\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}+\left\|\tilde{\theta}^{(t)}-\theta^{(0)}\right\|_{2}\right)\leq 1-\frac{\eta q^{*}\lambda_{\min}}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><mroot><mover accent="true"><mi>d</mi><mo>~</mo></mover><mn>4</mn></mroot></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\eta\lambda_{\min}q^{*}+\frac{\eta q^{*}\lambda_{\min}}{3}+\frac{\eta M^{2}}{\sqrt[4]{\tilde{d}}}\left(\left\|\theta^{(t)}-\theta^{(0)}\right\|_{2}+\left\|\tilde{\theta}^{(t)}-\theta^{(0)}\right\|_{2}\right)\leq 1-\frac{\eta q^{*}\lambda_{\min}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.6" class="ltx_p">for all <math id="chapter12.A2.p14.m12" class="ltx_Math" alttext="\tilde{d}\geq\max\left\{D_{1},D_{2},\left(\frac{12M^{2}C_{0}}{q^{*}\lambda_{\min}}\right)^{4}\right\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msub><mi>D</mi><mn>1</mn></msub><mo>,</mo><msub><mi>D</mi><mn>2</mn></msub><mo>,</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac><mo>)</mo></mrow><mn>4</mn></msup><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\max\left\{D_{1},D_{2},\left(\frac{12M^{2}C_{0}}{q^{*}\lambda_{\min}}\right)^{4}\right\}</annotation></semantics></math>. This implies that</p>
<table id="chapter12.A2.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex316"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex316.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex317.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex317.m2" class="ltx_Math" alttext="\displaystyle 1-\frac{\eta q^{*}\lambda_{\min}}{2}+\left\|\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>−</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle 1-\frac{\eta q^{*}\lambda_{\min}}{2}+\left\|\eta\sqrt{{\bm{Q}}}J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex318.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex318.m2" class="ltx_Math" alttext="\displaystyle 1-\frac{\eta q^{*}\lambda_{\min}}{2}+\eta M^{2}\sqrt{3\epsilon}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\frac{\eta q^{*}\lambda_{\min}}{2}+\eta M^{2}\sqrt{3\epsilon}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p14.7" class="ltx_p">holds for all <math id="chapter12.A2.p14.m13" class="ltx_Math" alttext="\epsilon\leq\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≤</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\epsilon\leq\epsilon_{0}</annotation></semantics></math>. Thus, <a href="#chapter12.A2.E49" title="In Item (ii) ‣ Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">49</span></a> holds for <math id="chapter12.A2.p14.m14" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="chapter12.A2.p15" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p15.1" class="ltx_p">Now let us return to the proof of <a href="#chapter12.Thmtheorem2" title="Lemma 12.2 (Approximation Theorem). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.2</span></a>.
Choose and fix an <math id="chapter12.A2.p15.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> such that <math id="chapter12.A2.p15.m2" class="ltx_Math" alttext="\epsilon&lt;\min\{\epsilon_{0},\frac{1}{3}\left(\frac{q^{*}\lambda_{\min}}{3\lambda_{\max}+q^{*}\lambda_{\min}}\right)^{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo>,</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo>+</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon&lt;\min\{\epsilon_{0},\frac{1}{3}\left(\frac{q^{*}\lambda_{\min}}{3\lambda_{\max}+q^{*}\lambda_{\min}}\right)^{2}\}</annotation></semantics></math>, where <math id="chapter12.A2.p15.m3" class="ltx_Math" alttext="\epsilon_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\epsilon_{0}</annotation></semantics></math> is given by Theorem <a href="#chapter12.Thmtheorem5" title="Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.5</span></a>.
Then, <math id="chapter12.A2.p15.m4" class="ltx_Math" alttext="t_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">t_{\epsilon}</annotation></semantics></math> is also fixed. There exists <math id="chapter12.A2.p15.m5" class="ltx_Math" alttext="\tilde{D}\geq 0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>D</mi><mo>~</mo></mover><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{D}\geq 0</annotation></semantics></math> such that for any <math id="chapter12.A2.p15.m6" class="ltx_Math" alttext="\tilde{d}\geq\tilde{D}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>≥</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{d}\geq\tilde{D}</annotation></semantics></math>, with probability at least <math id="chapter12.A2.p15.m7" class="ltx_Math" alttext="(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\delta)</annotation></semantics></math>,
the inequalities in <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">12.4</span></a> and <a href="#chapter12.Thmtheorem5" title="Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.5</span></a> hold, and <math id="chapter12.A2.p15.m8" class="ltx_Math" alttext="{\left\|\Theta-\Theta^{(0)}\right\|}_{F}\leq\frac{q^{*}\lambda_{\min}}{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">{\left\|\Theta-\Theta^{(0)}\right\|}_{F}\leq\frac{q^{*}\lambda_{\min}}{3}</annotation></semantics></math>.
This implies that</p>
<table id="chapter12.A2.Ex319" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex319.m1" class="ltx_Math" alttext="{\left\|\Theta^{(0)}\right\|}_{2}\leq{\left\|\Theta\right\|}_{2}+{\left\|\Theta-\Theta^{(0)}\right\|}_{F}\leq\lambda_{\max}+\frac{q^{*}\lambda_{\min}}{3}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mi mathvariant="normal">Θ</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>≤</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\Theta^{(0)}\right\|}_{2}\leq{\left\|\Theta\right\|}_{2}+{\left\|\Theta-\Theta^{(0)}\right\|}_{F}\leq\lambda_{\max}+\frac{q^{*}\lambda_{\min}}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p15.2" class="ltx_p">We still denote <math id="chapter12.A2.p15.m9" class="ltx_Math" alttext="B=1+\eta^{*}M^{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>η</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">B=1+\eta^{*}M^{2}</annotation></semantics></math> and <math id="chapter12.A2.p15.m10" class="ltx_Math" alttext="C_{0}=\frac{MB^{t_{\epsilon}}R_{0}}{B-1}+\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mrow><mfrac><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><mi>B</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C_{0}=\frac{MB^{t_{\epsilon}}R_{0}}{B-1}+\frac{3\sqrt{1+3\epsilon}MB^{t_{\epsilon}}R_{0}}{q^{*}\lambda_{\min}}</annotation></semantics></math>.
<a href="#chapter12.Thmtheorem5" title="Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.5</span></a> guarantees that for all <math id="chapter12.A2.p15.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have <math id="chapter12.A2.p15.m12" class="ltx_Math" alttext="\theta^{(t)}\in B(\theta^{(0)},C_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t)}\in B(\theta^{(0)},C_{0})</annotation></semantics></math>.
Thus, we have</p>
<table id="chapter12.A2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex320"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex320.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex320.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>−</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta\sqrt{{\bm{Q}}}\right\|_{2}+\eta\left\|\sqrt{{\bm{Q}}}(\Theta-\Theta^{(0)})\sqrt{{\bm{Q}}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex321"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex321.m1" class="ltx_Math" alttext="\displaystyle\leq 1-\eta\lambda_{\min}q^{*}+\frac{\eta q^{*}\lambda_{\min}}{3}=1-\frac{2\eta q^{*}\lambda_{\min}}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1-\eta\lambda_{\min}q^{*}+\frac{\eta q^{*}\lambda_{\min}}{3}=1-\frac{2\eta q^{*}\lambda_{\min}}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p15.3" class="ltx_p">It follows that</p>
<table id="chapter12.A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex322"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex322.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex322.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}}\right\|_{2}+\left\|\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo>−</mo><msqrt><mi>𝑸</mi></msqrt></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}}\right\|_{2}+\left\|\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\left(\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}-\sqrt{{\bm{Q}}}\right)\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex323"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex323.m1" class="ltx_Math" alttext="\displaystyle\leq 1-\frac{2\eta q^{*}\lambda_{\min}}{3}+\eta(\lambda_{\max}+\frac{q^{*}\lambda_{\min}}{3})\sqrt{3\epsilon}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1-\frac{2\eta q^{*}\lambda_{\min}}{3}+\eta(\lambda_{\max}+\frac{q^{*}\lambda_{\min}}{3})\sqrt{3\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p15.4" class="ltx_p">Thus, for all <math id="chapter12.A2.p15.m13" class="ltx_Math" alttext="\epsilon&lt;\frac{1}{3}\left(\frac{q^{*}\lambda_{\min}}{3\lambda_{\max}+q^{*}\lambda_{\min}}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>max</mi></msub></mrow><mo>+</mo><mrow><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\epsilon&lt;\frac{1}{3}\left(\frac{q^{*}\lambda_{\min}}{3\lambda_{\max}+q^{*}\lambda_{\min}}\right)^{2}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.E52.m1" class="ltx_Math" alttext="\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|{\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\right\|_{2}\leq 1-\frac{\eta q^{*}\lambda_{\min}}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
</div>
<div id="chapter12.A2.p16" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p16.1" class="ltx_p">The update rule of the GRW for the linearized neural network is:</p>
<table id="chapter12.A2.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.E53.m1" class="ltx_Math" alttext="\theta^{(t+1)}_{\textnormal{lin}}=\theta^{(t)}_{\textnormal{lin}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta^{(t+1)}_{\textnormal{lin}}=\theta^{(t)}_{\textnormal{lin}}-\eta J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="chapter12.A2.p16.2" class="ltx_p">where we use the subscript “lin” to denote the linearized neural network, and with a slight abuse of notion denote <math id="chapter12.A2.p16.m1" class="ltx_Math" alttext="g_{\textnormal{lin}}(\theta^{(t)})=g(\theta^{(t)}_{\textnormal{lin}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mtext>lin</mtext><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{\textnormal{lin}}(\theta^{(t)})=g(\theta^{(t)}_{\textnormal{lin}})</annotation></semantics></math>.</p>
</div>
<div id="chapter12.A2.p17" class="ltx_para ltx_noindent">
<p id="chapter12.A2.p17.1" class="ltx_p">First, let us consider the training data <math id="chapter12.A2.p17.m1" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>. Denote <math id="chapter12.A2.p17.m2" class="ltx_Math" alttext="\Delta_{t}=g_{\textnormal{lin}}(\theta^{(t)})-g(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}=g_{\textnormal{lin}}(\theta^{(t)})-g(\theta^{(t)})</annotation></semantics></math>. We have</p>
<table id="chapter12.A2.Ex324" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex324.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} g_{\textnormal{lin}}(\theta^{(t+1)})-g_{\textnormal{lin}}(\theta^{(t)})&amp;=-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)})\\
g(\theta^{(t+1)})-g(\theta^{(t)})&amp;=-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mtext>lin</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} g_{\textnormal{lin}}(\theta^{(t+1)})-g_{\textnormal{lin}}(\theta^{(t)})&amp;=-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}g_{\textnormal{lin}}(\theta^{(t)})\\
g(\theta^{(t+1)})-g(\theta^{(t)})&amp;=-\eta J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)}){\bm{Q}}^{(t)}g(\theta^{(t)})\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.2" class="ltx_p">where <math id="chapter12.A2.p17.m3" class="ltx_Math" alttext="\tilde{\theta}^{(t)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{\theta}^{(t)}</annotation></semantics></math> is some linear interpolation between <math id="chapter12.A2.p17.m4" class="ltx_Math" alttext="\theta^{(t)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t)}</annotation></semantics></math> and <math id="chapter12.A2.p17.m5" class="ltx_Math" alttext="\theta^{(t+1)}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\theta^{(t+1)}</annotation></semantics></math>. Thus, we have</p>
<table id="chapter12.A2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex325"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex325.m1" class="ltx_Math" alttext="\displaystyle\Delta_{t+1}-\Delta_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{t+1}-\Delta_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex325.m2" class="ltx_Math" alttext="\displaystyle\eta\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex326"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex326.m1" class="ltx_Math" alttext="\displaystyle-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\Delta_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\Delta_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.3" class="ltx_p">By <a href="#chapter12.Thmtheorem4" title="Lemma 12.4 (Local Lipschitzness of the Jacobian). ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.4</span></a>, we have</p>
<table id="chapter12.A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex327"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex327.m1" class="ltx_Math" alttext="\displaystyle\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex328"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex328.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex328.m2" class="ltx_Math" alttext="\displaystyle\left\|\left(J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right)^{\top}J(\theta^{(t)})\right\|_{F}+\left\|J(\theta^{(0)})^{\top}\left(J(\theta^{(t)})-J(\theta^{(0)})\right)\right\|_{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\left(J(\tilde{\theta}^{(t)})-J(\theta^{(0)})\right)^{\top}J(\theta^{(t)})\right\|_{F}+\left\|J(\theta^{(0)})^{\top}\left(J(\theta^{(t)})-J(\theta^{(0)})\right)\right\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex329"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex329.m1" class="ltx_Math" alttext="\displaystyle\leq\;" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex329.m2" class="ltx_math_unparsed" alttext="\displaystyle 2M^{2}C_{0}\tilde{d}^{-1/4}," display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>M</mi><msup><mrow></mrow><mn>2</mn></msup><mi>C</mi><msub><mrow></mrow><mn>0</mn></msub><mover accent="true"><mi>d</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2M^{2}C_{0}\tilde{d}^{-1/4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.4" class="ltx_p">which implies that for all <math id="chapter12.A2.p17.m6" class="ltx_Math" alttext="t&lt;t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t&lt;t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex330"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex330.m1" class="ltx_Math" alttext="\displaystyle\left\|\Delta_{t+1}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\Delta_{t+1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex331"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex331.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex331.m2" class="ltx_Math" alttext="\displaystyle\left\|\left[{\bm{I}}-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\right]\Delta_{t}\right\|_{2}+\left\|\eta\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mo>[</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\left[{\bm{I}}-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\right]\Delta_{t}\right\|_{2}+\left\|\eta\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]{\bm{Q}}^{(t)}g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex332"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex332.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex332.m2" class="ltx_Math" alttext="\displaystyle\left\|{\bm{I}}-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\right\|_{F}\left\|\Delta_{t}\right\|_{2}+\eta\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bm{I}}-\eta J(\theta^{(0)})^{\top}J(\theta^{(0)}){\bm{Q}}^{(t)}\right\|_{F}\left\|\Delta_{t}\right\|_{2}+\eta\left\|J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right\|_{F}\left\|g(\theta^{(t)})\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex333"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex333.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex333.m2" class="ltx_math_unparsed" alttext="\displaystyle(1+\eta M^{2})\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{t}R_{0}\tilde{d}^{-1/4}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mi>t</mi></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle(1+\eta M^{2})\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{t}R_{0}\tilde{d}^{-1/4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex334"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex334.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex334.m2" class="ltx_math_unparsed" alttext="\displaystyle B\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{t}R_{0}\tilde{d}^{-1/4}." display="inline" intent=":literal"><semantics><mrow><mi>B</mi><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mi>t</mi></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle B\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{t}R_{0}\tilde{d}^{-1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.5" class="ltx_p">This implies that</p>
<table id="chapter12.A2.Ex335" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex335.m1" class="ltx_math_unparsed" alttext="B^{-(t+1)}\left\|\Delta_{t+1}\right\|_{2}\leq B^{-t}\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{-1}R_{0}\tilde{d}^{-1/4}." display="block" intent=":literal"><semantics><mrow><msup><mi>B</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msup><mi>B</mi><mrow><mo>−</mo><mi>t</mi></mrow></msup><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mn>2</mn><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B^{-(t+1)}\left\|\Delta_{t+1}\right\|_{2}\leq B^{-t}\left\|\Delta_{t}\right\|_{2}+2\eta M^{2}C_{0}B^{-1}R_{0}\tilde{d}^{-1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.6" class="ltx_p">Since <math id="chapter12.A2.p17.m7" class="ltx_Math" alttext="\Delta_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{0}=0</annotation></semantics></math>, it follows that for all <math id="chapter12.A2.p17.m8" class="ltx_Math" alttext="t\leq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\leq t_{\epsilon}</annotation></semantics></math>, we have</p>
<table id="chapter12.A2.Ex336" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex336.m1" class="ltx_math_unparsed" alttext="\left\|\Delta_{t}\right\|_{2}\leq 2t\eta M^{2}C_{0}B^{t-1}R_{0}\tilde{d}^{-1/4}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>2</mn><mi>t</mi><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\Delta_{t}\right\|_{2}\leq 2t\eta M^{2}C_{0}B^{t-1}R_{0}\tilde{d}^{-1/4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.7" class="ltx_p">and in particular, we have</p>
<table id="chapter12.A2.Ex337" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex337.m1" class="ltx_math_unparsed" alttext="\left\|\sqrt{{\bm{Q}}}\Delta_{t_{\epsilon}}\right\|_{2}\leq\left\|\Delta_{t_{\epsilon}}\right\|_{2}\leq 2t_{\epsilon}\eta M^{2}C_{0}B^{t_{\epsilon}-1}R_{0}\tilde{d}^{-1/4}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msqrt><mi>𝑸</mi></msqrt><msub><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mi>ϵ</mi></msub></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>2</mn><msub><mi>t</mi><mi>ϵ</mi></msub><mi>η</mi><msup><mi>M</mi><mn>2</mn></msup><msub><mi>C</mi><mn>0</mn></msub><msup><mi>B</mi><mrow><msub><mi>t</mi><mi>ϵ</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><msub><mi>R</mi><mn>0</mn></msub><msup><mover accent="true"><mi>d</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\sqrt{{\bm{Q}}}\Delta_{t_{\epsilon}}\right\|_{2}\leq\left\|\Delta_{t_{\epsilon}}\right\|_{2}\leq 2t_{\epsilon}\eta M^{2}C_{0}B^{t_{\epsilon}-1}R_{0}\tilde{d}^{-1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.8" class="ltx_p">For <math id="chapter12.A2.p17.m9" class="ltx_Math" alttext="t\geq t_{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>t</mi><mi>ϵ</mi></msub></mrow><annotation encoding="application/x-tex">t\geq t_{\epsilon}</annotation></semantics></math>, by <a href="#chapter12.A2.E44" title="In Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">44</span></a>, we have</p>
<table id="chapter12.A2.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex338"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="chapter12.A2.Ex338.m1" class="ltx_Math" alttext="\displaystyle\sqrt{{\bm{Q}}}\Delta_{t+1}-\sqrt{{\bm{Q}}}\Delta_{t}=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{{\bm{Q}}}\Delta_{t+1}-\sqrt{{\bm{Q}}}\Delta_{t}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex338.m2" class="ltx_Math" alttext="\displaystyle\eta\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}g(\theta^{(t)})\right]" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}g(\theta^{(t)})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="chapter12.A2.Ex339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex339.m1" class="ltx_Math" alttext="\displaystyle-\eta\sqrt{{\bm{Q}}}J(\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}\Delta_{t}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\eta\sqrt{{\bm{Q}}}J(\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left[\sqrt{{\bm{Q}}}\Delta_{t}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.9" class="ltx_p">Let <math id="chapter12.A2.p17.m10" class="ltx_Math" alttext="{\bm{A}}={\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}={\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow><mo>=</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{I}}-\eta\sqrt{{\bm{Q}}}J(\theta^{(0)})^{\top}J(\theta^{(0)})\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}={\bm{I}}-\eta\sqrt{{\bm{Q}}}\Theta^{(0)}\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}</annotation></semantics></math>. Then, we have</p>
<table id="chapter12.A2.Ex340" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="chapter12.A2.Ex340.m1" class="ltx_Math" alttext="\sqrt{{\bm{Q}}}\Delta_{t+1}={\bm{A}}\sqrt{{\bm{Q}}}\Delta_{t}+\eta\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left(\sqrt{{\bm{Q}}}g(\theta^{(t)})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi>𝑸</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{{\bm{Q}}}\Delta_{t+1}={\bm{A}}\sqrt{{\bm{Q}}}\Delta_{t}+\eta\sqrt{{\bm{Q}}}\left[J(\tilde{\theta}^{(t)})^{\top}J(\theta^{(t)})-J(\theta^{(0)})^{\top}J(\theta^{(0)})\right]\sqrt{{\bm{Q}}_{3\epsilon}^{(t)}}\left(\sqrt{{\bm{Q}}}g(\theta^{(t)})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter12.A2.p17.10" class="ltx_p">Let <math id="chapter12.A2.p17.m11" class="ltx_Math" alttext="\gamma=1-\frac{\eta q^{*}\lambda_{\min}}{3}&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>min</mi></msub></mrow><mn>3</mn></mfrac></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=1-\frac{\eta q^{*}\lambda_{\min}}{3}&lt;1</annotation></semantics></math>.
Combining the above with <a href="#chapter12.Thmtheorem5" title="Lemma 12.5. ‣ Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12.5</span></a> and <a href="#chapter12.A2.E52" title="In Appendix 12.B Proof of Theorem ‣ Chapter 12 Proofs for Chapter 6 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">52</span></a>, we have</p>
<table id="chapter12.A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="chapter12.A2.Ex341"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter12.A2.Ex341.m1" class="ltx_Math" alttext="\displaystyle\left\|\sqrt{{\bm{Q}}}\Delta_{t+1}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msqrt><mi>𝑸</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\sqrt{{\bm{Q}}}\Delta_{t+1}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
