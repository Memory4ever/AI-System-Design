<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
             Set Gram matrix <math id="alg1.l20.m1" class="ltx_Math" alttext="{\bm{G}}_{r}\in\mathbb{R}^{m\times m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><mi>r</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}_{r}\in\mathbb{R}^{m\times m}</annotation></semantics></math> as <math id="alg1.l20.m2" class="ltx_Math" alttext="{\bm{G}}_{r}[p,q]={k_{X}^{+}}_{r}(x_{p},x_{q})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑮</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mmultiscripts><mi>k</mi><mi>X</mi><mo>+</mo><mi>r</mi><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>p</mi></msub><mo>,</mo><msub><mi>x</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}_{r}[p,q]={k_{X}^{+}}_{r}(x_{p},x_{q})</annotation></semantics></math>; <math id="alg1.l20.m3" class="ltx_Math" alttext="{\bm{C}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}_{r}\in\mathbb{R}^{d\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝑪</mi><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑮</mi><mi>r</mi></msub></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{C}}\leftarrow\frac{1}{m}{\bm{B}}{\bm{G}}_{r}\in\mathbb{R}^{d\times m}</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
