<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
              <math id="alg4.l1.m1" class="ltx_Math" alttext="{\bm{G}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{G}}_{k}</annotation></semantics></math>, <math id="alg4.l1.m2" class="ltx_Math" alttext="s^{-1}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s^{-1}(\lambda)</annotation></semantics></math>, <math id="alg4.l1.m3" class="ltx_Math" alttext="\beta_{n}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\beta_{n}</annotation></semantics></math>, <math id="alg4.l1.m4" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>, <math id="alg4.l1.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, <math id="alg4.l1.m6" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>

</div>
<div id="alg4.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
              Initialize: <math id="alg4.l2.m1" class="ltx_Math" alttext="{\bm{\theta}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{\theta}}\leftarrow{\bm{0}}\in\mathbb{R}^{m+n}</annotation></semantics></math>, <math id="alg4.l2.m2" class="ltx_Math" alttext="\tilde{{\bm{y}}}\leftarrow[{\bm{y}},{\bm{0}}_{m}]^{\top}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">←</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mi>𝒚</mi><mo>,</mo><msub><mn>𝟎</mn><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\tilde{{\bm{y}}}\leftarrow[{\bm{y}},{\bm{0}}_{m}]^{\top}</annotation></semantics></math>

