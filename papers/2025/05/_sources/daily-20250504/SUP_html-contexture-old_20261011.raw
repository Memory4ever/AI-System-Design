sub><mi>x</mi><mn>5</mn></msub><annotation encoding="application/x-tex">x_{5}</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 85.37 39.37 C 85.37 47.38 78.88 53.87 70.87 53.87 C 62.86 53.87 56.36 47.38 56.36 39.37 C 56.36 31.36 62.86 24.87 70.87 24.87 C 78.88 24.87 85.37 31.36 85.37 39.37 Z M 70.87 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 63.81 37.43)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m5" class="ltx_Math" alttext="x_{6}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>6</mn></msub><annotation encoding="application/x-tex">x_{6}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 108.99 0 C 108.99 8.01 102.5 14.5 94.49 14.5 C 86.48 14.5 79.99 8.01 79.99 0 C 79.99 -8.01 86.48 -14.5 94.49 -14.5 C 102.5 -14.5 108.99 -8.01 108.99 0 Z M 94.49 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 87.43 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m6" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 7.75 12.91 L 15.88 26.46"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 39.5 65.83 L 31.37 52.28"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 39.5 12.91 L 31.37 26.46"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 54.99 65.83 L 63.12 52.28"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 54.99 12.91 L 63.12 26.46"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 78.61 26.46 L 86.74 12.91"></path></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 211.35 0 C 211.35 8.01 204.86 14.5 196.85 14.5 C 188.84 14.5 182.35 8.01 182.35 0 C 182.35 -8.01 188.84 -14.5 196.85 -14.5 C 204.86 -14.5 211.35 -8.01 211.35 0 Z M 196.85 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 189.79 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m7" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 258.6 78.74 C 258.6 86.75 252.1 93.24 244.09 93.24 C 236.08 93.24 229.59 86.75 229.59 78.74 C 229.59 70.73 236.08 64.24 244.09 64.24 C 252.1 64.24 258.6 70.73 258.6 78.74 Z M 244.09 78.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 237.04 76.8)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m8" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 305.84 0 C 305.84 8.01 299.35 14.5 291.34 14.5 C 283.33 14.5 276.84 8.01 276.84 0 C 276.84 -8.01 283.33 -14.5 291.34 -14.5 C 299.35 -14.5 305.84 -8.01 305.84 0 Z M 291.34 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 284.28 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m9" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 408.2 0 C 408.2 8.01 401.71 14.5 393.7 14.5 C 385.69 14.5 379.2 8.01 379.2 0 C 379.2 -8.01 385.69 -14.5 393.7 -14.5 C 401.71 -14.5 408.2 -8.01 408.2 0 Z M 393.7 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 386.64 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m10" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 455.45 78.74 C 455.45 86.75 448.95 93.24 440.94 93.24 C 432.94 93.24 426.44 86.75 426.44 78.74 C 426.44 70.73 432.94 64.24 440.94 64.24 C 448.95 64.24 455.45 70.73 455.45 78.74 Z M 440.94 78.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 433.89 76.8)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m11" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 502.69 0 C 502.69 8.01 496.2 14.5 488.19 14.5 C 480.18 14.5 473.69 8.01 473.69 0 C 473.69 -8.01 480.18 -14.5 488.19 -14.5 C 496.2 -14.5 502.69 -8.01 502.69 0 Z M 488.19 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 481.13 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m12" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 431.83 39.37 C 431.83 47.38 425.33 53.87 417.32 53.87 C 409.31 53.87 402.82 47.38 402.82 39.37 C 402.82 31.36 409.31 24.87 417.32 24.87 C 425.33 24.87 431.83 31.36 431.83 39.37 Z M 417.32 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 410.27 37.43)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m13" class="ltx_Math" alttext="x_{4}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>4</mn></msub><annotation encoding="application/x-tex">x_{4}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 479.07 39.37 C 479.07 47.38 472.58 53.87 464.57 53.87 C 456.56 53.87 450.06 47.38 450.06 39.37 C 450.06 31.36 456.56 24.87 464.57 24.87 C 472.58 24.87 479.07 31.36 479.07 39.37 Z M 464.57 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 457.51 37.43)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m14" class="ltx_Math" alttext="x_{6}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>6</mn></msub><annotation encoding="application/x-tex">x_{6}</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 401.45 12.91 L 433.2 65.83"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 448.69 65.83 L 480.44 12.91"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 400.59 39.37 C 390.22 39.37 380.15 23.47 385.34 14.49"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(1.0 0.0 0.0 1.0 400.59 39.37)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(0.5 -0.86603 0.86603 0.5 385.34 14.49)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 424.21 78.74 C 413.84 78.74 403.77 62.84 408.96 53.86"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(1.0 0.0 0.0 1.0 424.21 78.74)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(0.5 -0.86603 0.86603 0.5 408.96 53.86)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 481.3 39.37 C 491.67 39.37 501.74 23.47 496.55 14.49"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(-1.0 0.0 0.0 -1.0 481.3 39.37)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(-0.5 -0.86603 0.86603 -0.5 496.55 14.49)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 457.67 78.74 C 468.05 78.74 478.12 62.84 472.93 53.86"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(-1.0 0.0 0.0 -1.0 457.67 78.74)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.28pt" transform="matrix(-0.5 -0.86603 0.86603 -0.5 472.93 53.86)"><path style="fill:none" d="M -3.15 4.21 C -2.89 2.63 0 0.26 0.79 0 C 0 -0.26 -2.89 -2.63 -3.15 -4.21"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 38.4 -34.96)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S21.F17.pic1.1" class="ltx_text">(a)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 234.87 -34.96)"><foreignObject style="--ltx-fo-width:1.33em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="18.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S21.F17.pic1.2" class="ltx_text">(b)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 432.49 -34.96)"><foreignObject style="--ltx-fo-width:1.22em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="16.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S21.F17.pic1.3" class="ltx_text">(c)</span></span></span></foreignObject></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 17: </span>(a) A graph example where the kernel is the adjacency matrix. Shaded nodes are labeled and white nodes are unlabeled. (b) In KRR, the unlabeled nodes are useless and can be removed, so the graph becomes three isolated nodes. (c) With a two-step random walk <math id="S21.F17.m6" class="ltx_Math" alttext="k^{2}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mn>2</mn></msup><annotation encoding="application/x-tex">k^{2}</annotation></semantics></math>, <math id="S21.F17.m7" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> and <math id="S21.F17.m8" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> are connected, and <math id="S21.F17.m9" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> and <math id="S21.F17.m10" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math> are connected.</figcaption>
</figure>
<div id="S21.p3" class="ltx_para ltx_noindent">
<p id="S21.p3.1" class="ltx_p">STKR is extremely useful in a semi-supervised learning setting where there are much more unlabeled samples than labeled samples.
One might ask what is the point of using an STK or extracting the top-<math id="S21.p3.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace, instead of directly performing kernel ridge regression with <math id="S21.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
The answer is that in many cases, regression with <math id="S21.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> would fail, but with <math id="S21.p3.m4" class="ltx_Math" alttext="k_{s}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">k_{s}</annotation></semantics></math> it would not.
This can be demonstrated with a concrete example.
Consider the graph in <a href="#S21.F17" title="In 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">17</span></a> (a), where the shaded nodes are labeled but the white nodes are not, and the context is that connected nodes are similar. Then, <math id="S21.p3.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> can be the adjacency matrix of this graph.
Let <math id="S21.p3.m6" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> be the RKHS of <math id="S21.p3.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
Recall that given a labeled dataset <math id="S21.p3.m8" class="ltx_Math" alttext="{\left\{(\tilde{x}_{i},y_{i})\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{(\tilde{x}_{i},y_{i})\right\}}_{i=1}^{n}</annotation></semantics></math>,
kernel ridge regression (KRR) with <math id="S21.p3.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is given by</p>
<table id="S21.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex67.m1" class="ltx_Math" alttext="\hat{f}\in\argmin_{f\in{{\mathcal{H}}_{k}}}\;{\left\{\frac{1}{n}\sum_{i=1}^{n}{\left(f(\tilde{x}_{i})-y_{i}\right)}^{2}+\beta_{n}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}\right\}}," display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>∈</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo>(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{f}\in\argmin_{f\in{{\mathcal{H}}_{k}}}\;{\left\{\frac{1}{n}\sum_{i=1}^{n}{\left(f(\tilde{x}_{i})-y_{i}\right)}^{2}+\beta_{n}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}\right\}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.p3.2" class="ltx_p">for which there is a classical <span id="S21.p3.2.1" class="ltx_text ltx_font_bold">Representer Theorem</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib124" title="" class="ltx_ref">124</a>, Theorem 4.2]</cite>:</p>
</div>
<div id="chapter5.Thmtheorem17" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem17.2" class="ltx_text ltx_font_bold">Theorem 5.17</span></span><span id="chapter5.Thmtheorem17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem17.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem17.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">All minimizers of KRR admit the form <math id="chapter5.Thmtheorem17.p1.m1" class="ltx_Math" alttext="\hat{f}^{*}(x)=\sum_{j=1}^{n}\alpha_{i}^{*}k(x,\tilde{x}_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msubsup><mi>α</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}^{*}(x)=\sum_{j=1}^{n}\alpha_{i}^{*}k(x,\tilde{x}_{j})</annotation></semantics></math>, where</span></p>
<table id="S21.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex68.m1" class="ltx_Math" alttext="{\bm{\alpha}}^{*}\in\arginf_{{\bm{\alpha}}\in\mathbb{R}^{n}}\;{\left\{\frac{1}{n}\sum_{i=1}^{n}{\left[\sum_{j=1}^{n}\alpha_{j}k(\tilde{x}_{i},\tilde{x}_{j})-y_{i}\right]}^{2}+\beta_{n}\sum_{i,j=1}^{n}\alpha_{i}\alpha_{j}k(\tilde{x}_{i},\tilde{x}_{j})\right\}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜶</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>inf</mi></mrow><mrow><mi>𝜶</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></msub><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo>[</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>α</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}^{*}\in\arginf_{{\bm{\alpha}}\in\mathbb{R}^{n}}\;{\left\{\frac{1}{n}\sum_{i=1}^{n}{\left[\sum_{j=1}^{n}\alpha_{j}k(\tilde{x}_{i},\tilde{x}_{j})-y_{i}\right]}^{2}+\beta_{n}\sum_{i,j=1}^{n}\alpha_{i}\alpha_{j}k(\tilde{x}_{i},\tilde{x}_{j})\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S21.p4" class="ltx_para ltx_noindent">
<p id="S21.p4.1" class="ltx_p">What this theorem implies is that KRR only uses the labeled samples, and the large number of unlabeled samples are not used at all.
This means that in <a href="#S21.F17" title="In 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">17</span></a> (a), the white nodes are not used by KRR.
When all the white nodes are removed, the graph becomes (b)—a graph with three isolated nodes, which is a useless context.</p>
</div>
<div id="S21.p5" class="ltx_para ltx_noindent">
<p id="S21.p5.1" class="ltx_p">So what goes wrong here?
The key is that the graph only says that <math id="S21.p5.m1" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> and <math id="S21.p5.m2" class="ltx_Math" alttext="x_{4}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>4</mn></msub><annotation encoding="application/x-tex">x_{4}</annotation></semantics></math> are similar, and <math id="S21.p5.m3" class="ltx_Math" alttext="x_{4}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>4</mn></msub><annotation encoding="application/x-tex">x_{4}</annotation></semantics></math> and <math id="S21.p5.m4" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> are similar. However, it does not say that <math id="S21.p5.m5" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> and <math id="S21.p5.m6" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> are similar, that is it cannot imply the transitivity of similarity on its own.
Therefore, in the eyes of this graph, <math id="S21.p5.m7" class="ltx_Math" alttext="x_{1},x_{2},x_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">x_{1},x_{2},x_{3}</annotation></semantics></math> are three completely independent nodes, which is why the graph is useless in KRR.
However, STKR assumes that similarity is transitive, and this allows us to start at any point <math id="S21.p5.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and do a random walk up to some number of steps, and the node we land on is still similar to <math id="S21.p5.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
For example, if we allow random walks up to two steps, then the graph becomes <a href="#S21.F17" title="In 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">17</span></a> (c), which no longer consists of three isolated nodes.</p>
</div>
<div id="S21.p6" class="ltx_para ltx_noindent">
<p id="S21.p6.1" class="ltx_p">To formalize this idea of random walk, define the following power spaces.</p>
</div>
<div id="chapter5.Thmtheorem18" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem18.2" class="ltx_text ltx_font_bold">Definition 5.18</span></span><span id="chapter5.Thmtheorem18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem18.p1" class="ltx_para">
<p id="chapter5.Thmtheorem18.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem18.p1.1.1" class="ltx_text ltx_font_italic">A <span id="chapter5.Thmtheorem18.p1.1.1.1" class="ltx_text ltx_font_bold">power space</span> is an RKHS associated with <math id="chapter5.Thmtheorem18.p1.m1" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> for any <math id="chapter5.Thmtheorem18.p1.m2" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, where</span></p>
<table id="S21.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S21.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S21.Ex69.m1" class="ltx_Math" alttext="\displaystyle k^{p}(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle k^{p}(x,x^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S21.Ex69.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{\infty}\lambda_{i}^{p}\mu_{i}(x)\mu_{i}(x^{\prime});" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><msubsup><mi>λ</mi><mi>i</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{\infty}\lambda_{i}^{p}\mu_{i}(x)\mu_{i}(x^{\prime});</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S21.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S21.Ex70.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">\displaystyle{\mathcal{H}}_{k^{p}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S21.Ex70.m2" class="ltx_Math" alttext="\displaystyle={\left\{f=\sum u_{i}\mu_{i}\;\middle|\;\sum\frac{u_{i}^{2}}{\lambda_{i}^{p}}&lt;\infty\right\}},\;{\left\langle\sum u_{i}\mu_{i},\sum v_{i}\mu_{i}\right\rangle}_{{\mathcal{H}}_{k^{p}}}=\sum\frac{u_{i}v_{i}}{\lambda_{i}^{p}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mrow><mi>f</mi><mo>=</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mstyle></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mfrac><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup><msubsup><mi>λ</mi><mi>i</mi><mi>p</mi></msubsup></mfrac></mrow></mstyle><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo>}</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mrow><mo>⟨</mo><mrow><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mstyle><mo>,</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mstyle></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></msub><mo>=</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mfrac><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><msubsup><mi>λ</mi><mi>i</mi><mi>p</mi></msubsup></mfrac></mrow></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\left\{f=\sum u_{i}\mu_{i}\;\middle|\;\sum\frac{u_{i}^{2}}{\lambda_{i}^{p}}&lt;\infty\right\}},\;{\left\langle\sum u_{i}\mu_{i},\sum v_{i}\mu_{i}\right\rangle}_{{\mathcal{H}}_{k^{p}}}=\sum\frac{u_{i}v_{i}}{\lambda_{i}^{p}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S21.p7" class="ltx_para ltx_noindent">
<p id="S21.p7.1" class="ltx_p">The proof of the following proposition is left as an exercise.</p>
</div>
<div id="chapter5.Thmtheorem19" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem19.2" class="ltx_text ltx_font_bold">Proposition 5.19</span></span><span id="chapter5.Thmtheorem19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem19.p1" class="ltx_para">
<p id="chapter5.Thmtheorem19.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem19.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="chapter5.Thmtheorem19.p1.m1" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, there is <math id="chapter5.Thmtheorem19.p1.m2" class="ltx_Math" alttext="k^{p+1}(x,x^{\prime})=\int k^{p}(x,z)k(z,x^{\prime})d{P_{\mathcal{X}}}(z)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>k</mi><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{p+1}(x,x^{\prime})=\int k^{p}(x,z)k(z,x^{\prime})d{P_{\mathcal{X}}}(z)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.p8" class="ltx_para ltx_noindent">
<p id="S21.p8.1" class="ltx_p">This formula shows that when <math id="S21.p8.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is an integer, <math id="S21.p8.m2" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> can be viewed as a <math id="S21.p8.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-step random walk.
When <math id="S21.p8.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is a real number, <math id="S21.p8.m5" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> is essentially a continuous random walk, which is called a <span id="S21.p8.1.1" class="ltx_text ltx_font_bold">diffusion process</span>.
This definition requires <math id="S21.p8.m6" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, because when <math id="S21.p8.m7" class="ltx_Math" alttext="p&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&lt;1</annotation></semantics></math>, <math id="S21.p8.m8" class="ltx_Math" alttext="{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{p}}</annotation></semantics></math> is not necessarily an RKHS, due to the following classical result <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib124" title="" class="ltx_ref">124</a>, p. 36]</cite>.</p>
</div>
<div id="chapter5.Thmtheorem20" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem20.2" class="ltx_text ltx_font_bold">Proposition 5.20</span></span><span id="chapter5.Thmtheorem20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem20.p1" class="ltx_para">
<p id="chapter5.Thmtheorem20.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem20.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem20.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">{\mathcal{H}}</annotation></semantics></math> be a Hilbert space of real-valued functions on <math id="chapter5.Thmtheorem20.p1.m2" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math>. For any <math id="chapter5.Thmtheorem20.p1.m3" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>, define an evaluation functional <math id="chapter5.Thmtheorem20.p1.m4" class="ltx_Math" alttext="L_{x}:{\mathcal{H}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>x</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">L_{x}:{\mathcal{H}}\rightarrow\mathbb{R}</annotation></semantics></math> as <math id="chapter5.Thmtheorem20.p1.m5" class="ltx_Math" alttext="(L_{x}f)=f(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(L_{x}f)=f(x)</annotation></semantics></math>.
Then, <math id="chapter5.Thmtheorem20.p1.m6" class="ltx_Math" alttext="{\mathcal{H}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">{\mathcal{H}}</annotation></semantics></math> is an RKHS if and only if for all <math id="chapter5.Thmtheorem20.p1.m7" class="ltx_Math" alttext="x\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{X}}</annotation></semantics></math>, <math id="chapter5.Thmtheorem20.p1.m8" class="ltx_Math" alttext="L_{x}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>x</mi></msub><annotation encoding="application/x-tex">L_{x}</annotation></semantics></math> is a continuous operator, that is there exists a constant <math id="chapter5.Thmtheorem20.p1.m9" class="ltx_Math" alttext="M_{x}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>x</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{x}&gt;0</annotation></semantics></math> such that <math id="chapter5.Thmtheorem20.p1.m10" class="ltx_Math" alttext="|f(x)|\leq M_{x}{\left\|f\right\|}_{{\mathcal{H}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|f(x)|\leq M_{x}{\left\|f\right\|}_{{\mathcal{H}}}</annotation></semantics></math> for all <math id="chapter5.Thmtheorem20.p1.m11" class="ltx_Math" alttext="f\in{\mathcal{H}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}</annotation></semantics></math>. (Note: <math id="chapter5.Thmtheorem20.p1.m12" class="ltx_Math" alttext="\sup_{x}M_{x}=\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mi>x</mi></msub><msub><mi>M</mi><mi>x</mi></msub></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sup_{x}M_{x}=\infty</annotation></semantics></math> is allowed.)</span></p>
</div>
</div>
<div id="S21.p9" class="ltx_para ltx_noindent">
<p id="S21.p9.1" class="ltx_p">In the last section, it has been shown that <math id="S21.p9.m1" class="ltx_Math" alttext="M_{x}=\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>x</mi></msub><mo>=</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">M_{x}=\kappa</annotation></semantics></math> when <math id="S21.p9.m2" class="ltx_Math" alttext="p=1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=1</annotation></semantics></math>.
Obviously, for any <math id="S21.p9.m3" class="ltx_Math" alttext="p&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&gt;1</annotation></semantics></math> and <math id="S21.p9.m4" class="ltx_Math" alttext="f\in{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}_{k^{p}}</annotation></semantics></math>, we have <math id="S21.p9.m5" class="ltx_Math" alttext="{\left\|f\right\|}_{{\mathcal{H}}_{k^{p}}}^{2}\geq\lambda_{1}^{1-p}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mn>2</mn></msubsup><mo>≥</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{\mathcal{H}}_{k^{p}}}^{2}\geq\lambda_{1}^{1-p}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}^{2}</annotation></semantics></math>. Thus, <math id="S21.p9.m6" class="ltx_Math" alttext="{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{p}}</annotation></semantics></math> is still an RKHS when <math id="S21.p9.m7" class="ltx_Math" alttext="p&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&gt;1</annotation></semantics></math>.
However, when <math id="S21.p9.m8" class="ltx_Math" alttext="p&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p&lt;1</annotation></semantics></math>, it is easy to construct an example where <math id="S21.p9.m9" class="ltx_Math" alttext="{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{p}}</annotation></semantics></math> is not an RKHS.</p>
</div>
<figure id="S21.F18" class="ltx_figure"><span class="ltx_inline-block"><svg id="S21.F18.pic1" class="ltx_picture ltx_centering" height="95.32" overflow="visible" version="1.1" viewBox="0 0 315.79 95.32" width="315.79"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,95.32) matrix(1 0 0 -1 0 0) translate(0.42,0) translate(0,0.42)"><g stroke-width="0.6pt"><path style="fill:none" d="M 0 0 M 0 5.53 L 0 88.95 C 0 92.01 2.48 94.49 5.53 94.49 L 309.43 94.49 C 312.48 94.49 314.96 92.01 314.96 88.95 L 314.96 5.53 C 314.96 2.48 312.48 0 309.43 0 L 5.53 0 C 2.48 0 0 2.48 0 5.53 Z M 314.96 94.49"></path></g><g stroke-width="0.6pt"><path style="fill:none" d="M 59.06 7.87 M 59.06 13.41 L 59.06 81.08 C 59.06 84.14 61.53 86.61 64.59 86.61 L 301.55 86.61 C 304.61 86.61 307.09 84.14 307.09 81.08 L 307.09 13.41 C 307.09 10.35 304.61 7.87 301.55 7.87 L 64.59 7.87 C 61.53 7.87 59.06 10.35 59.06 13.41 Z M 307.09 86.61"></path></g><g stroke-width="0.6pt"><path style="fill:none" d="M 118.11 15.75 M 118.11 21.28 L 118.11 73.21 C 118.11 76.26 120.59 78.74 123.65 78.74 L 293.68 78.74 C 296.73 78.74 299.21 76.26 299.21 73.21 L 299.21 21.28 C 299.21 18.23 296.73 15.75 293.68 15.75 L 123.65 15.75 C 120.59 15.75 118.11 18.23 118.11 21.28 Z M 299.21 78.74"></path></g><g stroke-width="0.6pt"><path style="fill:none" d="M 236.22 31.5 M 236.22 37.03 L 236.22 57.46 C 236.22 60.51 238.7 62.99 241.76 62.99 L 277.93 62.99 C 280.99 62.99 283.46 60.51 283.46 57.46 L 283.46 37.03 C 283.46 33.97 280.99 31.5 277.93 31.5 L 241.76 31.5 C 238.7 31.5 236.22 33.97 236.22 37.03 Z M 283.46 62.99"></path></g><g stroke-width="1.6pt"><path style="fill:none" d="M 177.17 23.62 M 177.17 29.16 L 177.17 65.33 C 177.17 68.39 179.64 70.87 182.7 70.87 L 285.8 70.87 C 288.86 70.87 291.34 68.39 291.34 65.33 L 291.34 29.16 C 291.34 26.1 288.86 23.62 285.8 23.62 L 182.7 23.62 C 179.64 23.62 177.17 26.1 177.17 29.16 Z M 291.34 70.87"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 6.86 43.55)"><foreignObject style="--ltx-fo-width:1.24em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F18.pic1.m1" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 65.91 44.45)"><foreignObject style="--ltx-fo-width:2.17em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.28em;font-size:10pt;" height="13.32" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="30.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F18.pic1.m2" class="ltx_Math" alttext="{\mathcal{H}}_{k^{1.5}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>1.5</mn></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{1.5}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 124.97 44.45)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.28em;font-size:10pt;" height="13.32" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F18.pic1.m3" class="ltx_Math" alttext="{\mathcal{H}}_{k^{2}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>2</mn></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{2}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 243.08 44.45)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.28em;font-size:10pt;" height="13.32" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F18.pic1.m4" class="ltx_Math" alttext="{\mathcal{H}}_{k^{3}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>3</mn></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{3}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 184.02 44.25)"><foreignObject style="--ltx-fo-width:1.35em;--ltx-fo-height:0.59em;--ltx-fo-depth:0.22em;font-size:11.5pt;" height="12.91" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="21.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F18.pic1.m5" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝓗</mi><msub><mi>𝒌</mi><mi>𝒔</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 18: </span>Illustration of the multiscale smoothness induced by diffusion, producing the chain <math id="S21.F18.m5" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}\supseteq{\mathcal{H}}_{k^{1.5}}\supseteq{\mathcal{H}}_{k^{2}}\supseteq{\mathcal{H}}_{k^{3}}\supseteq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mo>⊇</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>1.5</mn></msup></msub><mo>⊇</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>2</mn></msup></msub><mo>⊇</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>3</mn></msup></msub><mo rspace="0.1389em">⊇</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}\supseteq{\mathcal{H}}_{k^{1.5}}\supseteq{\mathcal{H}}_{k^{2}}\supseteq{\mathcal{H}}_{k^{3}}\supseteq\cdots</annotation></semantics></math>. The RKHS of the spectrally transformed kernel <math id="S21.F18.m6" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math> is <math id="S21.F18.m7" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math> marked in bold, which is in this chain but not necessarily equal to any <math id="S21.F18.m8" class="ltx_Math" alttext="{\mathcal{H}}_{k^{p}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{k^{p}}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S21.p10" class="ltx_para ltx_noindent">
<p id="S21.p10.1" class="ltx_p"><math id="S21.p10.m1" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> is an example of an STK, and <math id="S21.p10.m2" class="ltx_Math" alttext="{\left\{k^{p}\right\}}_{p\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>k</mi><mi>p</mi></msup><mo>}</mo></mrow><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\left\{k^{p}\right\}}_{p\geq 1}</annotation></semantics></math> forms a chain of function classes: <math id="S21.p10.m3" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}\supset{\mathcal{H}}_{k^{1}}\supset{\mathcal{H}}_{k^{1.5}}\supset{\mathcal{H}}_{k^{2}}\supset\cdots" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊃</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>1</mn></msup></msub><mo>⊃</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>1.5</mn></msup></msub><mo>⊃</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mn>2</mn></msup></msub><mo rspace="0.1389em">⊃</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}\supset{\mathcal{H}}_{k^{1}}\supset{\mathcal{H}}_{k^{1.5}}\supset{\mathcal{H}}_{k^{2}}\supset\cdots</annotation></semantics></math>, as illustrated in <a href="#S21.F18" title="In 21 Spectrally Transformed Kernel Regression ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">18</span></a>.
We say that any function <math id="S21.p10.m4" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math> is <span id="S21.p10.1.1" class="ltx_text ltx_font_bold">smooth</span> <span id="S21.p10.1.2" class="ltx_text ltx_font_italic">w.r.t.</span> the kernel <math id="S21.p10.m5" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math>, and the diffusion process induces <span id="S21.p10.1.3" class="ltx_text ltx_font_bold">multiscale smoothness</span>.
The kernel metric of <math id="S21.p10.m6" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> is <math id="S21.p10.m7" class="ltx_Math" alttext="d_{k^{p}}(x,x^{\prime})={\left\|k^{p}(x,\cdot)-k^{p}(x^{\prime},\cdot)\right\|}_{{\mathcal{H}}_{k^{p}}}=\sum\lambda_{i}^{p}(\mu_{i}(x)-\mu_{i}(x^{\prime}))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><msup><mi>k</mi><mi>p</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>k</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>λ</mi><mi>i</mi><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{k^{p}}(x,x^{\prime})={\left\|k^{p}(x,\cdot)-k^{p}(x^{\prime},\cdot)\right\|}_{{\mathcal{H}}_{k^{p}}}=\sum\lambda_{i}^{p}(\mu_{i}(x)-\mu_{i}(x^{\prime}))^{2}</annotation></semantics></math>, which is equivalent to the diffusion distance defined in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">29</a>]</cite>.</p>
</div>
<div id="S21.p11" class="ltx_para ltx_noindent">
<p id="S21.p11.1" class="ltx_p">The key result of this section is the generality of STK. Suppose the target function is smooth <span id="S21.p11.1.1" class="ltx_text ltx_font_italic">w.r.t.</span> a certain measure of smoothness.
Then, under some mild conditions, the class of all smooth functions under this measure must be the RKHS of some STK.
This is a quite insightful result because it essentially says that if we know how to deal with <math id="S21.p11.m1" class="ltx_Math" alttext="{{\mathcal{H}}_{{k_{s}}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{{k_{s}}}}</annotation></semantics></math>, then we can deal with almost any kind of downstream task.</p>
</div>
<div id="S21.p12" class="ltx_para ltx_noindent">
<p id="S21.p12.1" class="ltx_p">Specifically speaking, each <math id="S21.p12.m1" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> defines a measure of smoothness.
We are interested in a certain measure of smoothness called the <span id="S21.p12.1.1" class="ltx_text ltx_font_bold">target smoothness</span>,
which satisfies the following condition:
For any two functions <math id="S21.p12.m2" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> and <math id="S21.p12.m3" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math>, if all <math id="S21.p12.m4" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> say that <math id="S21.p12.m5" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is smoother than <math id="S21.p12.m6" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math>, then the target smoothness must also say that <math id="S21.p12.m7" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is smoother than <math id="S21.p12.m8" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math>.
This is called the condition of <span id="S21.p12.1.2" class="ltx_text ltx_font_bold">preserving relative smoothness</span>.
This is a weak condition, because usually <math id="S21.p12.m9" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is smoother at some scale <math id="S21.p12.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> while <math id="S21.p12.m11" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math> is smoother at some other scale <math id="S21.p12.m12" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.
However, if <math id="S21.p12.m13" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is smoother at all scales, then it must also be smoother under the target smoothness.
In addition, there are two more assumptions: (i) All smooth functions under the target smoothness form a Hilbert space <math id="S21.p12.m14" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math>;
(ii) <math id="S21.p12.m15" class="ltx_Math" alttext="{\mathcal{H}}_{t}\subseteq{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{t}\subseteq{{\mathcal{H}}_{k}}</annotation></semantics></math>.</p>
</div>
<div id="S21.p13" class="ltx_para ltx_noindent">
<p id="S21.p13.1" class="ltx_p">To prove the result, we need to formally define the term “smoothness”.</p>
</div>
<div id="chapter5.Thmtheorem21" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem21.2" class="ltx_text ltx_font_bold">Definition 5.21</span></span><span id="chapter5.Thmtheorem21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem21.p1" class="ltx_para">
<p id="chapter5.Thmtheorem21.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem21.p1.1.1" class="ltx_text ltx_font_italic">For any Hilbert space <math id="chapter5.Thmtheorem21.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}\subset{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⊂</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}\subset{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>, the <span id="chapter5.Thmtheorem21.p1.1.1.1" class="ltx_text ltx_font_bold">smoothness</span> of <math id="chapter5.Thmtheorem21.p1.m2" class="ltx_Math" alttext="f\in{\mathcal{H}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">f\in{\mathcal{H}}</annotation></semantics></math> w.r.t. <math id="chapter5.Thmtheorem21.p1.m3" class="ltx_Math" alttext="{\mathcal{H}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">{\mathcal{H}}</annotation></semantics></math> is defined as <math id="chapter5.Thmtheorem21.p1.m4" class="ltx_Math" alttext="r_{{\mathcal{H}}}(f)=\frac{{\left\|\tilde{f}\right\|}_{P_{\mathcal{X}}}^{2}}{{\left\|\tilde{f}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup></mfrac></mrow><annotation encoding="application/x-tex">r_{{\mathcal{H}}}(f)=\frac{{\left\|\tilde{f}\right\|}_{P_{\mathcal{X}}}^{2}}{{\left\|\tilde{f}\right\|}_{{\mathcal{H}}_{{k_{s}}}}^{2}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.p14" class="ltx_para ltx_noindent">
<p id="S21.p14.1" class="ltx_p">Smoothness is an alias of compatibility, because <math id="S21.p14.m1" class="ltx_Math" alttext="r_{{\mathcal{H}}}(f)\geq(1-\epsilon)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">r_{{\mathcal{H}}}(f)\geq(1-\epsilon)^{2}</annotation></semantics></math> is equivalent to <math id="S21.p14.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> being <math id="S21.p14.m3" class="ltx_Math" alttext="(1-\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\epsilon)</annotation></semantics></math>-compatible with <math id="S21.p14.m4" class="ltx_Math" alttext="{\mathcal{H}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">{\mathcal{H}}</annotation></semantics></math> as per <a href="#chapter5.Thmtheorem6" title="Definition 5.6. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">5.6</span></a>.
The key result is as follows.</p>
</div>
<div id="chapter5.Thmtheorem22" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem22.2" class="ltx_text ltx_font_bold">Theorem 5.22</span></span><span id="chapter5.Thmtheorem22.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A5" title="Appendix 11.E Proof of Theorem ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.E</span></a>)<span id="chapter5.Thmtheorem22.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem22.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem22.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem22.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="chapter5.Thmtheorem22.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}_{t}\subseteq{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{t}\subseteq{{\mathcal{H}}_{k}}</annotation></semantics></math> preserves relative smoothness: for any <math id="chapter5.Thmtheorem22.p1.m2" class="ltx_Math" alttext="f_{1},f_{2}\in{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}\in{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>, if <math id="chapter5.Thmtheorem22.p1.m3" class="ltx_Math" alttext="r_{{\mathcal{H}}_{k^{p}}}(f_{1})\geq r_{{\mathcal{H}}_{k^{p}}}(f_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>k</mi><mi>p</mi></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{{\mathcal{H}}_{k^{p}}}(f_{1})\geq r_{{\mathcal{H}}_{k^{p}}}(f_{2})</annotation></semantics></math> for all <math id="chapter5.Thmtheorem22.p1.m4" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, then <math id="chapter5.Thmtheorem22.p1.m5" class="ltx_Math" alttext="r_{{\mathcal{H}}_{t}}(f_{1})\geq r_{{\mathcal{H}}_{t}}(f_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>r</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{{\mathcal{H}}_{t}}(f_{1})\geq r_{{\mathcal{H}}_{t}}(f_{2})</annotation></semantics></math>.
Then, <math id="chapter5.Thmtheorem22.p1.m6" class="ltx_Math" alttext="{\mathcal{H}}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{t}</annotation></semantics></math> is an RKHS, whose reproducing kernel is an STK for a transformation function <math id="chapter5.Thmtheorem22.p1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> such that:</span></p>
<ol id="S21.I1" class="ltx_enumerate">
<li id="S21.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S21.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S21.I1.i1.p1.1" class="ltx_p"><math id="S21.I1.i1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math><span id="S21.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> is monotonically non-decreasing;</span></p>
</div></li>
<li id="S21.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S21.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S21.I1.i2.p1.1" class="ltx_p"><math id="S21.I1.i2.p1.m1" class="ltx_Math" alttext="s(\lambda)\leq M\lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)\leq M\lambda</annotation></semantics></math><span id="S21.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> for some constant </span><math id="S21.I1.i2.p1.m2" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math><span id="S21.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S21.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S21.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="S21.I1.i3.p1.1" class="ltx_p"><math id="S21.I1.i3.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math><span id="S21.I1.i3.p1.1.1" class="ltx_text ltx_font_italic"> is continuous on </span><math id="S21.I1.i3.p1.m2" class="ltx_math_unparsed" alttext="[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,+\infty)</annotation></semantics></math><span id="S21.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S21.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iv)</span> 
<div id="S21.I1.i4.p1" class="ltx_para">
<p id="S21.I1.i4.p1.1" class="ltx_p"><math id="S21.I1.i4.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math><span id="S21.I1.i4.p1.1.1" class="ltx_text ltx_font_italic"> is </span><math id="S21.I1.i4.p1.m2" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math><span id="S21.I1.i4.p1.1.2" class="ltx_text ltx_font_italic"> on </span><math id="S21.I1.i4.p1.m3" class="ltx_Math" alttext="(0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,+\infty)</annotation></semantics></math><span id="S21.I1.i4.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S21.p15" class="ltx_para ltx_noindent">
<p id="S21.p15.1" class="ltx_p">STKR is the generalization of contexture learning from representation learning to semi-supervised learning.
In semi-supervised learning, STKR is usually much more efficient than extracting the top-<math id="S21.p15.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace.
The following is a popular example.</p>
</div>
<div id="chapter5.Thmtheorem23" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem23.2" class="ltx_text ltx_font_bold">Example 5.23</span></span><span id="chapter5.Thmtheorem23.3" class="ltx_text ltx_font_bold"> </span>(Inverse Laplacian)<span id="chapter5.Thmtheorem23.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem23.p1" class="ltx_para">
<p id="chapter5.Thmtheorem23.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem23.p1.1.1" class="ltx_text ltx_font_italic">For <math id="chapter5.Thmtheorem23.p1.m1" class="ltx_Math" alttext="\eta\in(0,\lambda_{1}^{-1})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mi>λ</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in(0,\lambda_{1}^{-1})</annotation></semantics></math>, define <math id="chapter5.Thmtheorem23.p1.m2" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math> such that <math id="chapter5.Thmtheorem23.p1.m3" class="ltx_Math" alttext="{k_{s}}^{-1}(x,x^{\prime})=k^{-1}(x,x^{\prime})-\eta k^{0}(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mmultiscripts><mi>k</mi><mi>s</mi><mrow></mrow><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{k_{s}}^{-1}(x,x^{\prime})=k^{-1}(x,x^{\prime})-\eta k^{0}(x,x^{\prime})</annotation></semantics></math>. <math id="chapter5.Thmtheorem23.p1.m4" class="ltx_Math" alttext="k^{-1}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">k^{-1}</annotation></semantics></math> and <math id="chapter5.Thmtheorem23.p1.m5" class="ltx_Math" alttext="k^{0}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mn>0</mn></msup><annotation encoding="application/x-tex">k^{0}</annotation></semantics></math> are STKs with <math id="chapter5.Thmtheorem23.p1.m6" class="ltx_Math" alttext="s(\lambda)=\lambda^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">s(\lambda)=\lambda^{-1}</annotation></semantics></math> and <math id="chapter5.Thmtheorem23.p1.m7" class="ltx_Math" alttext="s(\lambda)=\lambda^{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>λ</mi><mn>0</mn></msup></mrow><annotation encoding="application/x-tex">s(\lambda)=\lambda^{0}</annotation></semantics></math>.
Then, the reciprocal of <math id="chapter5.Thmtheorem23.p1.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is given by <math id="chapter5.Thmtheorem23.p1.m9" class="ltx_Math" alttext="s^{-1}(\lambda)=\lambda^{-1}-\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mi>η</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s^{-1}(\lambda)=\lambda^{-1}-\eta&gt;0</annotation></semantics></math> for <math id="chapter5.Thmtheorem23.p1.m10" class="ltx_Math" alttext="\lambda\in(0,\lambda_{1}]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>λ</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in(0,\lambda_{1}]</annotation></semantics></math>,
which means that <math id="chapter5.Thmtheorem23.p1.m11" class="ltx_Math" alttext="s(\lambda)=\frac{\lambda}{1-\eta\lambda}=\sum_{p=1}^{\infty}\eta^{p-1}\lambda^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mi>λ</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msup><mi>η</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>p</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)=\frac{\lambda}{1-\eta\lambda}=\sum_{p=1}^{\infty}\eta^{p-1}\lambda^{p}</annotation></semantics></math>,
and <math id="chapter5.Thmtheorem23.p1.m12" class="ltx_Math" alttext="\|f\|_{{\mathcal{H}}_{{k_{s}}}}^{2}=\|f\|_{{\mathcal{H}}_{k}}^{2}-\eta\|f\|_{P_{\mathcal{X}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>f</mi><mo stretchy="false">‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>k</mi><mi>s</mi></msub></msub><mn>2</mn></msubsup><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>f</mi><mo stretchy="false">‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>f</mi><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\|f\|_{{\mathcal{H}}_{{k_{s}}}}^{2}=\|f\|_{{\mathcal{H}}_{k}}^{2}-\eta\|f\|_{P_{\mathcal{X}}}^{2}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.p16" class="ltx_para ltx_noindent">
<p id="S21.p16.1" class="ltx_p">The inverse Laplacian used to be very popular for semi-supervised learning, because it can be implemented very efficiently via a method called label propagation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib171" title="" class="ltx_ref">171</a>, <a href="#bib.bib170" title="" class="ltx_ref">170</a>]</cite>.</p>
</div>
</section>
<section id="S22" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">22 </span>Implementation and Generalization Analysis of STKR</h3>

<div id="S22.p1" class="ltx_para ltx_noindent">
<p id="S22.p1.1" class="ltx_p">Now we develop the algorithms for STKR for a wide variety of STKs, including the inverse Laplacian.
After that, we derive generalization bounds for the algorithms.
In particular, we consider polynomial STKs with <math id="S22.p1.m1" class="ltx_Math" alttext="s(\lambda)=\sum_{p=1}^{\infty}\pi_{p}\lambda^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>p</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">s(\lambda)=\sum_{p=1}^{\infty}\pi_{p}\lambda^{p}</annotation></semantics></math>, where <math id="S22.p1.m2" class="ltx_Math" alttext="\pi_{p}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>p</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi_{p}\geq 0</annotation></semantics></math> for all <math id="S22.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</p>
</div>
<div id="S22.p2" class="ltx_para ltx_noindent">
<p id="S22.p2.1" class="ltx_p">Since <math id="S22.p2.m1" class="ltx_Math" alttext="{k_{s}}=\sum_{p=1}^{\infty}\pi_{p}k^{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>s</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mi>p</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{k_{s}}=\sum_{p=1}^{\infty}\pi_{p}k^{p}</annotation></semantics></math>, it suffices to show how to estimate <math id="S22.p2.m2" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math>.
For example, when <math id="S22.p2.m3" class="ltx_Math" alttext="p=2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=2</annotation></semantics></math>, we have <math id="S22.p2.m4" class="ltx_Math" alttext="k^{2}(x,x^{\prime})=\int k(x,z)k(x^{\prime},z)d{P_{\mathcal{X}}}(z)\approx\frac{1}{m+n}\sum_{i=1}^{m+n}k(x,x_{i})k(x^{\prime},x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≈</mo><mrow><mfrac><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msubsup><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{2}(x,x^{\prime})=\int k(x,z)k(x^{\prime},z)d{P_{\mathcal{X}}}(z)\approx\frac{1}{m+n}\sum_{i=1}^{m+n}k(x,x_{i})k(x^{\prime},x_{i})</annotation></semantics></math>, that is we estimate <math id="S22.p2.m5" class="ltx_Math" alttext="k^{2}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mn>2</mn></msup><annotation encoding="application/x-tex">k^{2}</annotation></semantics></math> by Monte Carlo.
Here, <math id="S22.p2.m6" class="ltx_Math" alttext="x_{m+i}=\tilde{x}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>m</mi><mo>+</mo><mi>i</mi></mrow></msub><mo>=</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">x_{m+i}=\tilde{x}_{i}</annotation></semantics></math>.
Recall that KRR does not use the <math id="S22.p2.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> unlabeled samples at all, but here we can make use of the unlabeled samples when estimating <math id="S22.p2.m8" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math>.
Similarly, we can estimate <math id="S22.p2.m9" class="ltx_Math" alttext="k^{p}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mi>p</mi></msup><annotation encoding="application/x-tex">k^{p}</annotation></semantics></math> for all positive integer <math id="S22.p2.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> as follows:</p>
<ol id="S22.I1" class="ltx_enumerate">
<li id="S22.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S22.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S22.I1.i1.p1.1" class="ltx_p">Compute Gram matrix <math id="S22.I1.i1.p1.m1" class="ltx_Math" alttext="{\bm{G}}_{k}\in\mathbb{R}^{(m+n)\times(m+n)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><mi>k</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}_{k}\in\mathbb{R}^{(m+n)\times(m+n)}</annotation></semantics></math>, where <math id="S22.I1.i1.p1.m2" class="ltx_Math" alttext="{\bm{G}}_{k}[i,j]=k(x_{i},x_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑮</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}_{k}[i,j]=k(x_{i},x_{j})</annotation></semantics></math>.</p>
</div></li>
<li id="S22.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S22.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S22.I1.i2.p1.1" class="ltx_p">Let <math id="S22.I1.i2.p1.m1" class="ltx_Math" alttext="\hat{k}^{1}=k" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mn>1</mn></msup><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\hat{k}^{1}=k</annotation></semantics></math>. Define <math id="S22.I1.i2.p1.m2" class="ltx_Math" alttext="{\bm{v}}_{k}(x)\in\mathbb{R}^{m+n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k}(x)\in\mathbb{R}^{m+n}</annotation></semantics></math> as <math id="S22.I1.i2.p1.m3" class="ltx_Math" alttext="{\bm{v}}_{k}(x)[i]=k(x,x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k}(x)[i]=k(x,x_{i})</annotation></semantics></math>.</p>
</div></li>
<li id="S22.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S22.I1.i3.p1" class="ltx_para">
<p id="S22.I1.i3.p1.1" class="ltx_p">Compute <math id="S22.I1.i3.p1.m1" class="ltx_Math" alttext="{\hat{k}^{p}}(x,x^{\prime})=\frac{{\bm{v}}_{k}(x)^{\top}{\bm{G}}_{k}^{p-2}{\bm{v}}_{k}(x^{\prime})}{(m+n)^{p-1}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑮</mi><mi>k</mi><mrow><mi>p</mi><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow><annotation encoding="application/x-tex">{\hat{k}^{p}}(x,x^{\prime})=\frac{{\bm{v}}_{k}(x)^{\top}{\bm{G}}_{k}^{p-2}{\bm{v}}_{k}(x^{\prime})}{(m+n)^{p-1}}</annotation></semantics></math> iteratively for <math id="S22.I1.i3.p1.m2" class="ltx_Math" alttext="p=2,3,\cdots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>3</mn><mo>,</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">p=2,3,\cdots</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S22.p3" class="ltx_para ltx_noindent">
<p id="S22.p3.1" class="ltx_p">Then, an estimate of <math id="S22.p3.m1" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math> is given by <math id="S22.p3.m2" class="ltx_Math" alttext="{\hat{k}_{s}}=\sum_{p=1}^{\infty}\pi_{p}{\hat{k}^{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>π</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>p</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\hat{k}_{s}}=\sum_{p=1}^{\infty}\pi_{p}{\hat{k}^{p}}</annotation></semantics></math>.
One difference is that previously we only use the <math id="S22.p3.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> unlabeled samples to estimate the top-<math id="S22.p3.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions, but here we use all <math id="S22.p3.m5" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples to estimate <math id="S22.p3.m6" class="ltx_Math" alttext="{\hat{k}_{s}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><annotation encoding="application/x-tex">{\hat{k}_{s}}</annotation></semantics></math>.
This difference is small in practice provided that <math id="S22.p3.m7" class="ltx_Math" alttext="m\gg n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≫</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\gg n</annotation></semantics></math>.
Later we will see why we can use all <math id="S22.p3.m8" class="ltx_Math" alttext="(m+n)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m+n)</annotation></semantics></math> samples in this situation.</p>
</div>
<div id="S22.p4" class="ltx_para ltx_noindent">
<p id="S22.p4.1" class="ltx_p">We use <math id="S22.p4.m1" class="ltx_Math" alttext="{\bm{G}}_{k,n}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{G}}_{k,n}\in\mathbb{R}^{n\times n}</annotation></semantics></math> to denote the Gram matrix on the <math id="S22.p4.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> labeled samples,
and define <math id="S22.p4.m3" class="ltx_Math" alttext="{\bm{v}}_{k,n}(x)\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k,n}(x)\in\mathbb{R}^{n}</annotation></semantics></math> as <math id="S22.p4.m4" class="ltx_Math" alttext="{\bm{v}}_{k,n}(x)[i]=k(x,\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{k,n}(x)[i]=k(x,\tilde{x}_{i})</annotation></semantics></math>.
Similarly, define <math id="S22.p4.m5" class="ltx_Math" alttext="{\bm{G}}_{{k_{s}},n},{\bm{v}}_{{k_{s}},n},{\bm{G}}_{{\hat{k}_{s}},n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑮</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>,</mo><msub><mi>𝒗</mi><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>,</mo><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{G}}_{{k_{s}},n},{\bm{v}}_{{k_{s}},n},{\bm{G}}_{{\hat{k}_{s}},n}</annotation></semantics></math> and <math id="S22.p4.m6" class="ltx_Math" alttext="{\bm{v}}_{{\hat{k}_{s}},n}" display="inline" intent=":literal"><semantics><msub><mi>𝒗</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{v}}_{{\hat{k}_{s}},n}</annotation></semantics></math>.
Let <math id="S22.p4.m7" class="ltx_Math" alttext="\tilde{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{f}</annotation></semantics></math> and <math id="S22.p4.m8" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math> be the predictor obtained from KRR with <math id="S22.p4.m9" class="ltx_Math" alttext="{k_{s}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">{k_{s}}</annotation></semantics></math> and <math id="S22.p4.m10" class="ltx_Math" alttext="{\hat{k}_{s}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><annotation encoding="application/x-tex">{\hat{k}_{s}}</annotation></semantics></math>, respectively. The following closed-form formulas can be derived from the Representer Theorem:</p>
<table id="S22.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.E25.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} &amp;\tilde{f}(x)={\bm{v}}_{{k_{s}},n}(x)^{\top}\tilde{{\bm{\alpha}}},\quad\tilde{{\bm{\alpha}}}={\left({\bm{G}}_{{k_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}^{-1}{\bm{y}};\\
&amp;\hat{f}(x)={\bm{v}}_{{\hat{k}_{s}},n}(x)^{\top}\hat{{\bm{\alpha}}},\quad\hat{{\bm{\alpha}}}={\left({\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}^{-1}{\bm{y}}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>𝒗</mi><msub><mrow></mrow><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mo rspace="1.167em">,</mo><mover accent="true"><mi>𝜶</mi><mo>~</mo></mover><mo>=</mo><mo>(</mo><mi>𝑮</mi><msub><mrow></mrow><mrow><msub><mi>k</mi><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mi>n</mi><mi>β</mi><msub><mrow></mrow><mi>n</mi></msub><mi>𝑰</mi><msub><mrow></mrow><mi>n</mi></msub><mo>)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>𝒚</mi><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>𝒗</mi><msub><mrow></mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo rspace="1.167em">,</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo>=</mo><mo>(</mo><mi>𝑮</mi><msub><mrow></mrow><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mi>n</mi><mi>β</mi><msub><mrow></mrow><mi>n</mi></msub><mi>𝑰</mi><msub><mrow></mrow><mi>n</mi></msub><mo>)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>𝒚</mi><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} &amp;\tilde{f}(x)={\bm{v}}_{{k_{s}},n}(x)^{\top}\tilde{{\bm{\alpha}}},\quad\tilde{{\bm{\alpha}}}={\left({\bm{G}}_{{k_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}^{-1}{\bm{y}};\\
&amp;\hat{f}(x)={\bm{v}}_{{\hat{k}_{s}},n}(x)^{\top}\hat{{\bm{\alpha}}},\quad\hat{{\bm{\alpha}}}={\left({\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}\right)}^{-1}{\bm{y}}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
<div id="S22.p5" class="ltx_para ltx_noindent">
<p id="S22.p5.1" class="ltx_p">Here, <math id="S22.p5.m1" class="ltx_Math" alttext="{\bm{y}}=[y_{1},\cdots,y_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}=[y_{1},\cdots,y_{n}]</annotation></semantics></math>.
To obtain <math id="S22.p5.m2" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math>, it suffices to solve <math id="S22.p5.m3" class="ltx_Math" alttext="{\bm{A}}\hat{{\bm{\alpha}}}={\bm{y}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover></mrow><mo>=</mo><mi>𝒚</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}\hat{{\bm{\alpha}}}={\bm{y}}</annotation></semantics></math> for <math id="S22.p5.m4" class="ltx_Math" alttext="{\bm{A}}={\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><msub><mi>𝑮</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n}</annotation></semantics></math>.
Let us consider two scenarios: (i) <math id="S22.p5.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is simple: For some <math id="S22.p5.m6" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S22.p5.m7" class="ltx_Math" alttext="\pi_{p}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>p</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi_{p}=0</annotation></semantics></math> for all <math id="S22.p5.m8" class="ltx_Math" alttext="p&gt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&gt;q</annotation></semantics></math>;
(ii) <math id="S22.p5.m9" class="ltx_Math" alttext="s^{-1}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">s^{-1}</annotation></semantics></math> is simple: <math id="S22.p5.m10" class="ltx_Math" alttext="s^{-1}(\lambda)=\sum_{p=0}^{q-1}\xi_{p}\lambda^{p-r}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>s</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>ξ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mi>p</mi><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">s^{-1}(\lambda)=\sum_{p=0}^{q-1}\xi_{p}\lambda^{p-r}</annotation></semantics></math>, such as the inverse Laplacian.
Here “simple” means that the polynomial contains only a few terms.</p>
</div>
<div id="S22.p6" class="ltx_para ltx_noindent">
<p id="S22.p6.1" class="ltx_p">For scenario (i), directly computing <math id="S22.p6.m1" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is slow because it involves lots of matrix-matrix multiplications.
A faster alternative is iterative methods, such as Richardson iteration <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib119" title="" class="ltx_ref">119</a>]</cite>, which solves a linear system <math id="S22.p6.m2" class="ltx_Math" alttext="{\bm{A}}{\bm{x}}={\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><mo>=</mo><mi>𝒃</mi></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{x}}={\bm{b}}</annotation></semantics></math> by iteratively computing <math id="S22.p6.m3" class="ltx_Math" alttext="{\bm{x}}^{(t+1)}={\bm{x}}^{(t)}+\gamma({\bm{b}}-{\bm{A}}{\bm{x}}^{(t)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒃</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}^{(t+1)}={\bm{x}}^{(t)}+\gamma({\bm{b}}-{\bm{A}}{\bm{x}}^{(t)})</annotation></semantics></math> for some <math id="S22.p6.m4" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math>.
Richardson iteration is guaranteed to converge to the solution when <math id="S22.p6.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is chosen correctly.
While computing <math id="S22.p6.m6" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is slow, computing <math id="S22.p6.m7" class="ltx_Math" alttext="{\bm{A}}{\bm{x}}^{(t)}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒙</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{x}}^{(t)}</annotation></semantics></math> is very efficient because it only involves matrix-vector multiplication.
This method is called STKR propagation (STKR-Prop), because it is a generalization of label propagation (Label-Prop) for the inverse Laplacian.
Define <math id="S22.p6.m8" class="ltx_Math" alttext="{\bm{F}}\in\mathbb{R}^{(m+n)\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑭</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{F}}\in\mathbb{R}^{(m+n)\times n}</annotation></semantics></math> as <math id="S22.p6.m9" class="ltx_Math" alttext="{\bm{F}}[i,j]=k(x_{i},\tilde{x}_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑭</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{F}}[i,j]=k(x_{i},\tilde{x}_{j})</annotation></semantics></math>.
The algorithm is listed in <a href="#alg3" title="In 22 Implementation and Generalization Analysis of STKR ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<figure id="S22.fig1" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="alg3" class="ltx_float ltx_figure_panel ltx_float_algorithm ltx_minipage ltx_align_top ltx_framed ltx_framed_top" style="width:172.5pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> STKR-Prop for simple <math id="alg3.m2" class="ltx_Math" alttext="s^{\phantom{0}}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mphantom></mphantom></msup><annotation encoding="application/x-tex">s^{\phantom{0}}</annotation></semantics></math> </figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
              <math id="alg3.l1.m1" class="ltx_Math" alttext="{\bm{G}}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{\bm{G}}_{k}</annotation></semantics></math>, <math id="alg3.l1.m2" class="ltx_Math" alttext="{\bm{G}}_{k,n}" display="inline" intent=":literal"><semantics><msub><mi>𝑮</mi><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{G}}_{k,n}</annotation></semantics></math>, <math id="alg3.l1.m3" class="ltx_Math" alttext="{\bm{F}}" display="inline" intent=":literal"><semantics><mi>𝑭</mi><annotation encoding="application/x-tex">{\bm{F}}</annotation></semantics></math>, <math id="alg3.l1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, <math id="alg3.l1.m5" class="ltx_Math" alttext="\beta_{n}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\beta_{n}</annotation></semantics></math>, <math id="alg3.l1.m6" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>, <math id="alg3.l1.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, <math id="alg3.l1.m8" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
              Initialize: <math id="alg3.l2.m1" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}\leftarrow{\bm{0}}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}\leftarrow{\bm{0}}\in\mathbb{R}^{n}</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
              <span id="alg3.l3.3" class="ltx_text ltx_font_bold">while</span> True <span id="alg3.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
              <span id="alg3.l4.3" class="ltx_text ltx_font_italic"># Compute <math id="alg3.l4.m1" class="ltx_Math" alttext="{\bm{u}}=({\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n})\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐆</mi><mrow><msub><mover accent="true"><mi>k</mi><mo>^</mo></mover><mi>s</mi></msub><mo>,</mo><mi>n</mi></mrow></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝛂</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}=({\bm{G}}_{{\hat{k}_{s}},n}+n\beta_{n}{\bm{I}}_{n})\hat{{\bm{\alpha}}}</annotation></semantics></math></span>

