<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="chapter8.A2.Ex108Xc.m2" class="ltx_Math" alttext="\displaystyle={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left\langle\frac{A}{\sqrt{{P_{\mathcal{A}}}(A)}},{\bm{W}}\Phi(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[\frac{{\left\|A\right\|}_{2}^{2}}{\sqrt{{P_{\mathcal{A}}}(A)}}\right]}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mrow><mo>‖</mo><mi>𝑾</mi><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">X</mi><mo>,</mo><mi mathsize="0.700em">A</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msup><mi mathsize="0.700em">P</mi><mo mathsize="0.710em">+</mo></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mstyle displaystyle="true"><mfrac><mi>A</mi><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>,</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo>‖</mo><mi>A</mi><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msqrt><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{(X,A)\sim P^{+}}{\mathbb{E}}\;{\left\langle\frac{A}{\sqrt{{P_{\mathcal{A}}}(A)}},{\bm{W}}\Phi(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[\frac{{\left\|A\right\|}_{2}^{2}}{\sqrt{{P_{\mathcal{A}}}(A)}}\right]}.</annotation></semantics></math></td>
