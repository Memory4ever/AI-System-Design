ject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m32" class="ltx_Math" alttext="95" display="inline" intent=":literal"><semantics><mn>95</mn><annotation encoding="application/x-tex">95</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp45"><path d="M 0 0 L 57.07 0 L 57.07 42.76 L 0 42.76 Z"></path></clipPath><g clip-path="url(#pgfcp45)"><g stroke-width="1.2pt"><path style="fill:none" d="M 3.57 21.46 L 7.13 24.34 L 10.7 29.82 L 14.27 29.53 L 21.4 28.67 L 28.54 31.27 L 35.67 23.19 L 42.81 16.84 L 49.94 10.79 L 57.07 0.4"></path></g><g></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 32.69 31.27 C 32.69 33.56 30.83 35.42 28.54 35.42 C 26.24 35.42 24.39 33.56 24.39 31.27 C 24.39 28.97 26.24 27.11 28.54 27.11 C 30.83 27.11 32.69 28.97 32.69 31.27 Z M 28.54 31.27"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.3 34.96)"><foreignObject style="--ltx-fo-width:5.11em;--ltx-fo-height:0.71em;--ltx-fo-depth:0.24em;font-size:8.5pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="60.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m33" class="ltx_Math" alttext="(0.40,92.4)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mn mathsize="0.800em">0.40</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">92.4</mn><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(0.40,92.4)</annotation></semantics></math></span></span></foreignObject></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -13.31 -21)"><foreignObject style="--ltx-fo-width:5.41em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="74.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S19.F16.pic1.8" class="ltx_text">Mask Ratio <math id="S19.F16.pic1.m34" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></span></span></foreignObject></g></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 347.07 -6.14)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(-2.46,0) translate(0,6.14)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 57.07 3.05 L 51.17 3.05 M 57.07 21.38 L 51.17 21.38 M 57.07 39.7 L 51.17 39.7"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M 57.07 0 L 57.07 42.76"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 58.5 -1.4)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m35" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 58.5 16.92)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m36" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 58.5 35.24)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m37" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp46"><path d="M 0 0 L 57.07 0 L 57.07 42.76 L 0 42.76 Z"></path></clipPath><g clip-path="url(#pgfcp46)"><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="1.6pt"><path style="fill:none" d="M 3.57 31.4 L 7.13 25.29 L 10.7 11.57 L 14.27 11.96 L 21.4 10.77 L 28.54 1.57 L 35.67 15.29 L 42.81 22 L 49.94 26.6 L 57.07 37.32"></path></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 76.9 -6.14)"><foreignObject style="--ltx-fo-width:6.9em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.72" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="81.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S19.F16.pic1.9" class="ltx_text" style="font-size:80%;">Train-Test Gap</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 288.38 5.17)"><foreignObject style="--ltx-fo-width:2.51em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.72" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="29.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S19.F16.pic1.10" class="ltx_text" style="font-size:80%;">QNLI</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 427.23 4.09)"><foreignObject style="--ltx-fo-width:2.67em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.56" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="31.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S19.F16.pic1.11" class="ltx_text" style="font-size:80%;">SST-2</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 16: </span><span id="S19.F16.5" class="ltx_text ltx_font_bold">Left:</span> Estimated <math id="S19.F16.m3" class="ltx_Math" alttext="\log\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\log\kappa^{2}</annotation></semantics></math> (<math id="S19.F16.m4" class="ltx_Math" alttext="99^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mn>99</mn><mtext>th</mtext></msup><annotation encoding="application/x-tex">99^{\text{th}}</annotation></semantics></math> percentile) on <span id="S19.F16.6" class="ltx_text ltx_font_typewriter">wikipedia-simple</span>, which is the average of five runs with different random seeds. <span id="S19.F16.7" class="ltx_text ltx_font_bold">Right:</span> Downstream performance on QNLI and SST-2. The solid line is the test accuracy and the dashed line is the train-test gap. The highest test accuracy is labeled on each plot.</figcaption>
</figure>
<div id="S19.SS0.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="S19.SS0.SSS0.Px2.p4.1" class="ltx_p"><a href="#S19.F16" title="In Real language models. ‣ 19 Context Complexity ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">16</span></a> (right) plots the real downstream performance of BERT with different mask ratios on QNLI <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib149" title="" class="ltx_ref">149</a>]</cite> and SST-2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib130" title="" class="ltx_ref">130</a>]</cite>.
The models are <span id="S19.SS0.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_typewriter">roberta-large</span> trained with the fast pretraining recipe in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib158" title="" class="ltx_ref">158</a>]</cite>. The context is random masking without the 80-10-10 strategy.
At downstream, the encoder is fine-tuned along with the linear head following common practice.
From the plot, we can see that the highest test accuracy (solid line) is achieved at <math id="S19.SS0.SSS0.Px2.p4.m1" class="ltx_Math" alttext="\alpha=0.15" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\alpha=0.15</annotation></semantics></math> on QNLI and at <math id="S19.SS0.SSS0.Px2.p4.m2" class="ltx_Math" alttext="\alpha=0.40" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.40</mn></mrow><annotation encoding="application/x-tex">\alpha=0.40</annotation></semantics></math> on SST-2. This is because the association between <math id="S19.SS0.SSS0.Px2.p4.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S19.SS0.SSS0.Px2.p4.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is moderate when <math id="S19.SS0.SSS0.Px2.p4.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is neither too big nor too small.
The dashed line is the gap between the train accuracy and test accuracy.
On QNLI, the gap monotonically decreases with <math id="S19.SS0.SSS0.Px2.p4.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>;
on SST-2, it is U-shaped, with the lowest at <math id="S19.SS0.SSS0.Px2.p4.m7" class="ltx_Math" alttext="\alpha=0.40" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.40</mn></mrow><annotation encoding="application/x-tex">\alpha=0.40</annotation></semantics></math>.
We will come back to explain this observation after we prove the generalization bounds.</p>
</div>
</section>
</section>
<section id="S20" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">20 </span>Generalization Bounds for Contexture Learning</h3>

<div id="S20.p1" class="ltx_para ltx_noindent">
<p id="S20.p1.1" class="ltx_p">Suppose there are <math id="S20.p1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> pretrain samples <math id="S20.p1.m2" class="ltx_Math" alttext="x_{1},\cdots,x_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{m}</annotation></semantics></math> and <math id="S20.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> downstream samples <math id="S20.p1.m4" class="ltx_Math" alttext="\tilde{x}_{1},\cdots,\tilde{x}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{x}_{1},\cdots,\tilde{x}_{n}</annotation></semantics></math>, jointly <span id="S20.p1.1.1" class="ltx_text ltx_font_italic">i.i.d.</span> sampled from <math id="S20.p1.m5" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>.
Usually <math id="S20.p1.m6" class="ltx_Math" alttext="m\gg n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≫</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\gg n</annotation></semantics></math>.
This section proves an error bound when an encoder is learned with <math id="S20.p1.m7" class="ltx_Math" alttext="x_{1},\cdots,x_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\cdots,x_{m}</annotation></semantics></math>, and then a predictor is fit with <math id="S20.p1.m8" class="ltx_Math" alttext="\tilde{x}_{1},\cdots,\tilde{x}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{x}_{1},\cdots,\tilde{x}_{n}</annotation></semantics></math>.
Assume that the context has kernel access, and assume that the kernel <math id="S20.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> that we have access to is the centered kernel of <math id="S20.p1.m10" class="ltx_Math" alttext="{k_{X}^{+}}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">{k_{X}^{+}}</annotation></semantics></math>.
In practice there could be a difference between <math id="S20.p1.m11" class="ltx_Math" alttext="{k_{X}^{+}}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">{k_{X}^{+}}</annotation></semantics></math> and <math id="S20.p1.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, but since this difference depends on what <math id="S20.p1.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> we have, this is not something we can analyze in our study of generalization.
Therefore, for simplicity we ignore this difference.
The scenario where the context has pair or transformation access will be discussed later.</p>
</div>
<div id="S20.p2" class="ltx_para ltx_noindent">
<p id="S20.p2.1" class="ltx_p">Let <math id="S20.p2.m1" class="ltx_Math" alttext="s_{i}^{2},\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">s_{i}^{2},\mu_{i}</annotation></semantics></math> be the actual eigenvalues and eigenfunctions of <math id="S20.p2.m2" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>.
The <span id="S20.p2.1.1" class="ltx_text ltx_font_bold">empirical top-<math id="S20.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions</span> of <math id="S20.p2.m4" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math> can be estimated with kernel PCA as introduced at the beginning of <a href="#chapter2" title="Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Chapter</span> <span class="ltx_text ltx_ref_tag">2</span></a>, which is reiterated as follows.</p>
<ol id="S20.I1" class="ltx_enumerate">
<li id="S20.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S20.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S20.I1.i1.p1.1" class="ltx_p">Compute the Gram matrix <math id="S20.I1.i1.p1.m1" class="ltx_Math" alttext="{\bm{G}}\in\mathbb{R}^{m\times m}:{\bm{G}}[i,j]=k(x_{i},x_{j})" display="inline" intent=":literal"><semantics><mrow><mi>𝑮</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝑮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{G}}\in\mathbb{R}^{m\times m}:{\bm{G}}[i,j]=k(x_{i},x_{j})</annotation></semantics></math>.</p>
</div></li>
<li id="S20.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S20.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S20.I1.i2.p1.1" class="ltx_p">Let <math id="S20.I1.i2.p1.m1" class="ltx_Math" alttext="\lambda_{1}\geq\lambda_{2}\geq\cdots\geq\lambda_{m}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>λ</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>λ</mi><mi>m</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}\geq\lambda_{2}\geq\cdots\geq\lambda_{m}\geq 0</annotation></semantics></math> be the eigenvalues of <math id="S20.I1.i2.p1.m2" class="ltx_Math" alttext="{\bm{G}}" display="inline" intent=":literal"><semantics><mi>𝑮</mi><annotation encoding="application/x-tex">{\bm{G}}</annotation></semantics></math>, with orthonormal eigenvectors <math id="S20.I1.i2.p1.m3" class="ltx_Math" alttext="{\bm{v}}_{1},\cdots,{\bm{v}}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒗</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒗</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{v}}_{1},\cdots,{\bm{v}}_{m}</annotation></semantics></math>. Note that <math id="S20.I1.i2.p1.m4" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> has the same order as <math id="S20.I1.i2.p1.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, so it can be much greater than <math id="S20.I1.i2.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.</p>
</div></li>
<li id="S20.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S20.I1.i3.p1" class="ltx_para">
<p id="S20.I1.i3.p1.1" class="ltx_p">Assume that <math id="S20.I1.i3.p1.m1" class="ltx_Math" alttext="\lambda_{d}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{d}&gt;0</annotation></semantics></math>. Let <math id="S20.I1.i3.p1.m2" class="ltx_Math" alttext="\phi_{i}(x)=\frac{1}{\sqrt{\lambda_{i}}}\sum_{j=1}^{m}{\bm{v}}_{i}[j]k(x,x_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mi>λ</mi><mi>i</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>𝒗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}(x)=\frac{1}{\sqrt{\lambda_{i}}}\sum_{j=1}^{m}{\bm{v}}_{i}[j]k(x,x_{j})</annotation></semantics></math>, for <math id="S20.I1.i3.p1.m3" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S20.p3" class="ltx_para ltx_noindent">
<p id="S20.p3.1" class="ltx_p">Although ideally we would like a bound for any target function in <math id="S20.p3.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>, we cannot prove a universal bound for the entire <math id="S20.p3.m2" class="ltx_Math" alttext="{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>.
To see why, consider the following example.
Suppose <math id="S20.p3.m3" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> is a <math id="S20.p3.m4" class="ltx_Math" alttext="(1-\epsilon/2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\epsilon/2)</annotation></semantics></math>-compatible function that is easy to learn, and <math id="S20.p3.m5" class="ltx_Math" alttext="{\left\|f^{*}\right\|}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f^{*}\right\|}=1</annotation></semantics></math>.
Suppose there is a <math id="S20.p3.m6" class="ltx_Math" alttext="\mu_{D}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>D</mi></msub><annotation encoding="application/x-tex">\mu_{D}</annotation></semantics></math> with an extremely large <math id="S20.p3.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, such that the functiion is very noisy and it has large values on all the samples we have.
Let <math id="S20.p3.m8" class="ltx_Math" alttext="f^{\prime}=f^{*}+\frac{\epsilon}{4}\mu_{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>+</mo><mrow><mfrac><mi>ϵ</mi><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>D</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}=f^{*}+\frac{\epsilon}{4}\mu_{D}</annotation></semantics></math>. It is easy to show that <math id="S20.p3.m9" class="ltx_Math" alttext="f^{\prime}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>, but learning <math id="S20.p3.m10" class="ltx_Math" alttext="f^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>′</mo></msup><annotation encoding="application/x-tex">f^{\prime}</annotation></semantics></math> with the samples we have is impossible.
In order to make learning possible, we have to get rid of the extremely noisy components.</p>
</div>
<div id="S20.p4" class="ltx_para ltx_noindent">
<p id="S20.p4.1" class="ltx_p">To this end, we define a variant of the induced RKHS in <a href="#S13" title="13 Intrinsic Evaluation of an Arbitrary Encoder ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">13</span></a>.</p>
</div>
<div id="chapter5.Thmtheorem5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem5.2" class="ltx_text ltx_font_bold">Definition 5.5</span></span><span id="chapter5.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem5.p1" class="ltx_para">
<p id="chapter5.Thmtheorem5.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Define the <span id="chapter5.Thmtheorem5.p1.1.1.1" class="ltx_text ltx_font_bold">induced RKHS</span> of <math id="chapter5.Thmtheorem5.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> as <math id="chapter5.Thmtheorem5.p1.m2" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}={\left\{f=\sum s_{i}u_{i}\mu_{i}\;\middle|\;\sum u_{i}^{2}&lt;\infty\right\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mo>=</mo><mrow><mo>{</mo><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mrow><mo>∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}={\left\{f=\sum s_{i}u_{i}\mu_{i}\;\middle|\;\sum u_{i}^{2}&lt;\infty\right\}}</annotation></semantics></math>.
For <math id="chapter5.Thmtheorem5.p1.m3" class="ltx_Math" alttext="f_{1}=\sum u_{i}\mu_{i},f_{2}=\sum v_{i}\mu_{i}\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1}=\sum u_{i}\mu_{i},f_{2}=\sum v_{i}\mu_{i}\in{{\mathcal{H}}_{k}}</annotation></semantics></math>, define their inner product as <math id="chapter5.Thmtheorem5.p1.m4" class="ltx_Math" alttext="{\left\langle f_{1},f_{2}\right\rangle}_{{{\mathcal{H}}_{k}}}=\sum\frac{u_{i}v_{i}}{s_{i}^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mfrac><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\left\langle f_{1},f_{2}\right\rangle}_{{{\mathcal{H}}_{k}}}=\sum\frac{u_{i}v_{i}}{s_{i}^{2}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S20.p5" class="ltx_para ltx_noindent">
<p id="S20.p5.1" class="ltx_p">Note that <math id="S20.p5.m1" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> is a subset of <math id="S20.p5.m2" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>, rather than <math id="S20.p5.m3" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{A}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{A}})}</annotation></semantics></math>.
Obviously <math id="S20.p5.m4" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> is the RKHS of <math id="S20.p5.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, that is for any <math id="S20.p5.m6" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{k}}</annotation></semantics></math>, we have <math id="S20.p5.m7" class="ltx_Math" alttext="{\left\langle f,k(\cdot,x)\right\rangle}_{{{\mathcal{H}}_{k}}}=f(x)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\langle f,k(\cdot,x)\right\rangle}_{{{\mathcal{H}}_{k}}}=f(x)</annotation></semantics></math>.
In particular, we have <math id="S20.p5.m8" class="ltx_Math" alttext="{\left\langle k(\cdot,x),k(\cdot,x^{\prime})\right\rangle}_{{{\mathcal{H}}_{k}}}=k(x,x^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\langle k(\cdot,x),k(\cdot,x^{\prime})\right\rangle}_{{{\mathcal{H}}_{k}}}=k(x,x^{\prime})</annotation></semantics></math>.
This implies that for all <math id="S20.p5.m9" class="ltx_Math" alttext="i,j\in[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[d]</annotation></semantics></math>, we have</p>
<table id="S20.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex42.m1" class="ltx_math_unparsed" alttext="{\left\langle\phi_{i},\phi_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}=\frac{1}{\sqrt{\lambda_{i}\lambda_{j}}}\sum_{q,r=1}^{m}{\bm{v}}_{i}[q]{\bm{v}}_{j}[r]{\left\langle k(\cdot,x_{q}),k(\cdot,x_{r})\right\rangle}_{{{\mathcal{H}}_{k}}}=\frac{1}{\sqrt{\lambda_{i}\lambda_{j}}}{\bm{v}}_{i}^{\top}{\bm{G}}{\bm{v}}_{j}={\mathbb{I}}[i=j]." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>ϕ</mi><mi>j</mi></msub><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>j</mi></msub></mrow></msqrt></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>q</mi><mo>,</mo><mi>r</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>𝒗</mi><mi>i</mi></msub><mrow><mo stretchy="false">[</mo><mi>q</mi><mo stretchy="false">]</mo></mrow><msub><mi>𝒗</mi><mi>j</mi></msub><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow><msub><mrow><mo>⟨</mo><mi>k</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>x</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>k</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>x</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>j</mi></msub></mrow></msqrt></mfrac><msubsup><mi>𝒗</mi><mi>i</mi><mo>⊤</mo></msubsup><mi>𝑮</mi><msub><mi>𝒗</mi><mi>j</mi></msub><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>=</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\langle\phi_{i},\phi_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}=\frac{1}{\sqrt{\lambda_{i}\lambda_{j}}}\sum_{q,r=1}^{m}{\bm{v}}_{i}[q]{\bm{v}}_{j}[r]{\left\langle k(\cdot,x_{q}),k(\cdot,x_{r})\right\rangle}_{{{\mathcal{H}}_{k}}}=\frac{1}{\sqrt{\lambda_{i}\lambda_{j}}}{\bm{v}}_{i}^{\top}{\bm{G}}{\bm{v}}_{j}={\mathbb{I}}[i=j].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.p5.2" class="ltx_p">That is, <math id="S20.p5.m10" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math> are orthonormal in the Hilbert space <math id="S20.p5.m11" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math>.
Note that when there are finite samples, it is impossible to make <math id="S20.p5.m12" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math> orthonormal in <math id="S20.p5.m13" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math> since we have no access to <math id="S20.p5.m14" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>.
Given <math id="S20.p5.m15" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math>, define the following set of compatible functions.</p>
</div>
<div id="chapter5.Thmtheorem6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem6.2" class="ltx_text ltx_font_bold">Definition 5.6</span></span><span id="chapter5.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem6.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem6.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">The set of functions <math id="chapter5.Thmtheorem6.p1.m1" class="ltx_Math" alttext="(1-\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold" stretchy="false">(</mo><mrow><mn>𝟏</mn><mo class="ltx_mathvariant_bold" mathvariant="bold">−</mo><mi class="ltx_mathvariant_bold" mathvariant="bold">ϵ</mi></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\epsilon)</annotation></semantics></math><span id="chapter5.Thmtheorem6.p1.1.1.1" class="ltx_text ltx_font_bold">-compatible with <math id="chapter5.Thmtheorem6.p1.m2" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>𝐤</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math></span> is defined as</span></p>
<table id="S20.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex43.m1" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})={\left\{f\in{{\mathcal{H}}_{k}}\;\middle|\;{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}\geq{\left\|\tilde{f}\right\|}_{{P_{\mathcal{X}}}}\geq(1-\epsilon){\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}\right\}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≥</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})={\left\{f\in{{\mathcal{H}}_{k}}\;\middle|\;{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}\geq{\left\|\tilde{f}\right\|}_{{P_{\mathcal{X}}}}\geq(1-\epsilon){\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="chapter5.Thmtheorem7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem7.2" class="ltx_text ltx_font_bold">Proposition 5.7</span></span><span id="chapter5.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem7.p1" class="ltx_para">
<p id="chapter5.Thmtheorem7.p1.1" class="ltx_p"><math id="chapter5.Thmtheorem7.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})\subseteq{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})\subseteq{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math><span id="chapter5.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div>
</div>
<div id="S20.p6" class="ltx_para ltx_noindent">
<p id="S20.p6.1" class="ltx_p"><span id="S20.p6.1.1" class="ltx_text ltx_font_bold">Proof </span>
Let <math id="S20.p6.m1" class="ltx_Math" alttext="f=\sum_{i}u_{i}\mu_{i}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum_{i}u_{i}\mu_{i}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math>.
Then, <math id="S20.p6.m2" class="ltx_Math" alttext="\sum_{i}u_{i}^{2}\geq(1-\epsilon)\sum_{i}\frac{u_{i}^{2}}{s_{i}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mfrac><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}u_{i}^{2}\geq(1-\epsilon)\sum_{i}\frac{u_{i}^{2}}{s_{i}^{2}}</annotation></semantics></math>.
By Cauchy-Schwarz inequality, we have <math id="S20.p6.m3" class="ltx_Math" alttext="{\left(\sum_{i}s_{i}^{2}u_{i}^{2}\right)}{\left(\sum_{i}\frac{u_{i}^{2}}{s_{i}^{2}}\right)}\geq{\left(\sum_{i}u_{i}^{2}\right)}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>i</mi></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>i</mi></msub><mfrac><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>i</mi></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\left(\sum_{i}s_{i}^{2}u_{i}^{2}\right)}{\left(\sum_{i}\frac{u_{i}^{2}}{s_{i}^{2}}\right)}\geq{\left(\sum_{i}u_{i}^{2}\right)}^{2}</annotation></semantics></math>.
Thus, <math id="S20.p6.m4" class="ltx_Math" alttext="\sum_{i}s_{i}^{2}u_{i}^{2}\geq\sum_{i}u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}s_{i}^{2}u_{i}^{2}\geq\sum_{i}u_{i}^{2}</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="S20.p7" class="ltx_para ltx_noindent">
<p id="S20.p7.1" class="ltx_p">The following lemma can be proved in the same way as <a href="#chapter3.Thmtheorem8" title="Lemma 3.8. ‣ 13 Intrinsic Evaluation of an Arbitrary Encoder ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.8</span></a>, which is left as an exercise to the reader.</p>
</div>
<div id="chapter5.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma 5.8</span></span><span id="chapter5.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem8.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem8.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="chapter5.Thmtheorem8.p1.m1" class="ltx_Math" alttext="f_{1},\cdots,f_{d}\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{1},\cdots,f_{d}\in{{\mathcal{H}}_{k}}</annotation></semantics></math> such that <math id="chapter5.Thmtheorem8.p1.m2" class="ltx_math_unparsed" alttext="{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>=</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]</annotation></semantics></math>, we have</span></p>
<table id="S20.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex44.m1" class="ltx_Math" alttext="{\left\|f_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|f_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mi>d</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|f_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|f_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<section id="S20.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Approximation error bound.</h4>

<div id="S20.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p1.1" class="ltx_p">Our goal is to prove a universal bound for <math id="S20.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math>.
First, let us bound the approximation error.
Previously, the approximation error was defined as the distance from <math id="S20.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> to the span of <math id="S20.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> in space <math id="S20.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>.
However, since we cannot compute the distance in space <math id="S20.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math> with only finite samples, here we define it with the distance in space <math id="S20.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math>.
Specifically, let <math id="S20.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="f_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">f_{\Phi}</annotation></semantics></math> be the projection of <math id="S20.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> onto the span of <math id="S20.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> in space <math id="S20.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math>, that is <math id="S20.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="{\left\langle f^{*}-f_{\Phi},f_{\Phi}\right\rangle}_{{{\mathcal{H}}_{k}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>,</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\langle f^{*}-f_{\Phi},f_{\Phi}\right\rangle}_{{{\mathcal{H}}_{k}}}=0</annotation></semantics></math>.
Let <math id="S20.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="f^{*}-f_{\Phi}=\beta f_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f^{*}-f_{\Phi}=\beta f_{0}</annotation></semantics></math>, where <math id="S20.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\beta\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta\geq 0</annotation></semantics></math> and <math id="S20.SS0.SSS0.Px1.p1.m14" class="ltx_Math" alttext="{\left\|f_{0}\right\|}_{{{\mathcal{H}}_{k}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f_{0}\right\|}_{{{\mathcal{H}}_{k}}}=1</annotation></semantics></math>.
The above lemma implies that <math id="S20.SS0.SSS0.Px1.p1.m15" class="ltx_Math" alttext="{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d+1}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d+1}^{2}</annotation></semantics></math>.</p>
</div>
<div id="S20.SS0.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p2.1" class="ltx_p">Hence, to bound <math id="S20.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="{\left\|f_{0}^{2}\right\|}" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msubsup><mi>f</mi><mn>0</mn><mn>2</mn></msubsup><mo>‖</mo></mrow><annotation encoding="application/x-tex">{\left\|f_{0}^{2}\right\|}</annotation></semantics></math>, it suffices to prove a lower bound for <math id="S20.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>.
Using the definition of eigenvectors, it is not hard to show that <math id="S20.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\frac{1}{m}\sum_{j=1}^{m}\phi_{i}(x_{j})^{2}=\frac{\lambda_{i}}{m}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>=</mo><mfrac><msub><mi>λ</mi><mi>i</mi></msub><mi>m</mi></mfrac></mrow><annotation encoding="application/x-tex">\frac{1}{m}\sum_{j=1}^{m}\phi_{i}(x_{j})^{2}=\frac{\lambda_{i}}{m}</annotation></semantics></math> for all <math id="S20.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>, which is the empirical <math id="S20.SS0.SSS0.Px1.p2.m5" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> norm of <math id="S20.SS0.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\phi_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\phi_{i}</annotation></semantics></math>.
Therefore, we need to bound two things: (i) the gap between <math id="S20.SS0.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mi>m</mi></mfrac><annotation encoding="application/x-tex">\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}</annotation></semantics></math> and <math id="S20.SS0.SSS0.Px1.p2.m8" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d}^{2}</annotation></semantics></math>; (ii) the gap between the empirical <math id="S20.SS0.SSS0.Px1.p2.m9" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> norm and the actual <math id="S20.SS0.SSS0.Px1.p2.m10" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> norm.</p>
</div>
<div id="S20.SS0.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p3.1" class="ltx_p">Using <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>, Theorem 3.2]</cite>, for any <math id="S20.SS0.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, gap (i) can be bounded by</p>
<table id="S20.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.E20.m1" class="ltx_Math" alttext="\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}\geq s_{1}^{2}+\cdots+s_{d}^{2}-\frac{\kappa^{2}}{\sqrt{m}}\sqrt{\frac{1}{2}\log\frac{6}{\delta}}\qquad\text{with probability at least }1-\frac{\delta}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mi>m</mi></mfrac><mo>≥</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>with probability at least </mtext><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>−</mo><mfrac><mi>δ</mi><mn>2</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}\geq s_{1}^{2}+\cdots+s_{d}^{2}-\frac{\kappa^{2}}{\sqrt{m}}\sqrt{\frac{1}{2}\log\frac{6}{\delta}}\qquad\text{with probability at least }1-\frac{\delta}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p4.1" class="ltx_p">Gap (ii) can be bounded using classical generalization bounds with the Rademacher complexity.</p>
</div>
<div id="chapter5.Thmtheorem9" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem9.2" class="ltx_text ltx_font_bold">Definition 5.9</span></span><span id="chapter5.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem9.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem9.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem9.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> be a function class.
Let <math id="chapter5.Thmtheorem9.p1.m2" class="ltx_Math" alttext="S={\left\{x_{1},\cdots,x_{m}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">S={\left\{x_{1},\cdots,x_{m}\right\}}</annotation></semantics></math> be i.i.d. drawn from <math id="chapter5.Thmtheorem9.p1.m3" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>.
The <span id="chapter5.Thmtheorem9.p1.1.1.1" class="ltx_text ltx_font_bold">empirical Rademacher complexity</span> of <math id="chapter5.Thmtheorem9.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> on <math id="chapter5.Thmtheorem9.p1.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is defined as</span></p>
<table id="S20.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex45.m1" class="ltx_Math" alttext="\hat{\mathfrak{R}}_{S}({\mathcal{F}})=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{f\in{\mathcal{F}}}\frac{1}{m}\sum_{i=1}^{m}\sigma_{i}f(x_{i})\right]}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></munder><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{\mathfrak{R}}_{S}({\mathcal{F}})=\mathbb{E}_{\sigma_{1},\cdots,\sigma_{m}}{\left[\sup_{f\in{\mathcal{F}}}\frac{1}{m}\sum_{i=1}^{m}\sigma_{i}f(x_{i})\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter5.Thmtheorem9.p1.2" class="ltx_p"><span id="chapter5.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">where <math id="chapter5.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\sigma_{1},\cdots,\sigma_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>σ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\sigma_{1},\cdots,\sigma_{m}</annotation></semantics></math> are Rademacher variables, which are i.i.d. uniform random variables taking values in <math id="chapter5.Thmtheorem9.p1.m7" class="ltx_Math" alttext="{\left\{-1,+1\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">{\left\{-1,+1\right\}}</annotation></semantics></math>.
The <span id="chapter5.Thmtheorem9.p1.2.1.1" class="ltx_text ltx_font_bold">Rademacher complexity</span> of <math id="chapter5.Thmtheorem9.p1.m8" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> is defined as</span></p>
<table id="S20.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex46.m1" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}})=\mathbb{E}_{S}[\hat{\mathfrak{R}}_{S}({\mathcal{F}})]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>ℜ</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}})=\mathbb{E}_{S}[\hat{\mathfrak{R}}_{S}({\mathcal{F}})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S20.SS0.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p5.1" class="ltx_p">Define the following function class:</p>
<table id="S20.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex47.m1" class="ltx_math_unparsed" alttext="{\mathcal{F}}_{d}:={\left\{F=f_{1}^{2}+\cdots+f_{d}^{2}\;\middle|\;f_{i}\in{{\mathcal{H}}_{k}};\;\forall i,j\in[d],\;{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]\right\}}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo>:=</mo><mrow><mo>{</mo><mi>F</mi><mo>=</mo><msubsup><mi>f</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>f</mi><mi>d</mi><mn>2</mn></msubsup><mo lspace="0em" stretchy="true">|</mo><msub><mi>f</mi><mi>i</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mo rspace="0.447em">;</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow><mo rspace="0.447em">,</mo><msub><mrow><mo>⟨</mo><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>=</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{d}:={\left\{F=f_{1}^{2}+\cdots+f_{d}^{2}\;\middle|\;f_{i}\in{{\mathcal{H}}_{k}};\;\forall i,j\in[d],\;{\left\langle f_{i},f_{j}\right\rangle}_{{{\mathcal{H}}_{k}}}={\mathbb{I}}[i=j]\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px1.p5.2" class="ltx_p">Since <math id="S20.SS0.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\phi_{1}^{2}+\cdots+\phi_{d}^{2}\in{\mathcal{F}}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ϕ</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>ϕ</mi><mi>d</mi><mn>2</mn></msubsup></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1}^{2}+\cdots+\phi_{d}^{2}\in{\mathcal{F}}_{d}</annotation></semantics></math>, it suffices to bound <math id="S20.SS0.SSS0.Px1.p5.m2" class="ltx_Math" alttext="{\left|\frac{1}{m}\sum_{i=1}^{m}F(x_{i})-\mathbb{E}[F(X)]\right|}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">{\left|\frac{1}{m}\sum_{i=1}^{m}F(x_{i})-\mathbb{E}[F(X)]\right|}</annotation></semantics></math> for all <math id="S20.SS0.SSS0.Px1.p5.m3" class="ltx_Math" alttext="F\in{\mathcal{F}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">F\in{\mathcal{F}}_{d}</annotation></semantics></math>, which requires <math id="S20.SS0.SSS0.Px1.p5.m4" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}}_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}}_{d})</annotation></semantics></math> and a bound for <math id="S20.SS0.SSS0.Px1.p5.m5" class="ltx_Math" alttext="|F(x)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|F(x)|</annotation></semantics></math>.
Let <math id="S20.SS0.SSS0.Px1.p5.m6" class="ltx_Math" alttext="\phi_{i}=\sum_{j}u_{ij}s_{j}\mu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}=\sum_{j}u_{ij}s_{j}\mu_{j}</annotation></semantics></math>, and <math id="S20.SS0.SSS0.Px1.p5.m7" class="ltx_Math" alttext="{\bm{U}}=(u_{ij})=[{\bm{u}}_{1},\cdots,{\bm{u}}_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒖</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒖</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}=(u_{ij})=[{\bm{u}}_{1},\cdots,{\bm{u}}_{d}]</annotation></semantics></math>, which is a matrix with <math id="S20.SS0.SSS0.Px1.p5.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> columns and infinitely many rows. Then, <math id="S20.SS0.SSS0.Px1.p5.m9" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo>=</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{U}}={\bm{I}}_{d}</annotation></semantics></math>.
Let <math id="S20.SS0.SSS0.Px1.p5.m10" class="ltx_Math" alttext="{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x),\cdots]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{M}}(x)=[s_{1}\mu_{1}(x),s_{2}\mu_{2}(x),\cdots]</annotation></semantics></math>.
Then, by <a href="#chapter5.Thmtheorem1" title="Definition 5.1. ‣ 19 Context Complexity ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>, we have <math id="S20.SS0.SSS0.Px1.p5.m11" class="ltx_Math" alttext="{\left\|{\bm{M}}(x)\right\|}_{2}^{2}=\sum s_{i}^{2}\mu_{i}(x)^{2}\leq\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\left\|{\bm{M}}(x)\right\|}_{2}^{2}=\sum s_{i}^{2}\mu_{i}(x)^{2}\leq\kappa^{2}</annotation></semantics></math> for <math id="S20.SS0.SSS0.Px1.p5.m12" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>-almost all <math id="S20.SS0.SSS0.Px1.p5.m13" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
Thus, for <math id="S20.SS0.SSS0.Px1.p5.m14" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>-almost all <math id="S20.SS0.SSS0.Px1.p5.m15" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, we have</p>
<table id="S20.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex48.m1" class="ltx_Math" alttext="{\left|F(x)\right|}={\left|{\bm{M}}(x)^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{M}}(x)\right|}\leq{\left\|{\bm{M}}(x)\right\|}_{2}^{2}{\left\|{\bm{U}}{\bm{U}}^{\top}\right\|}_{2}\leq\kappa^{2}\quad\text{for all }F\in{\mathcal{F}}_{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left|F(x)\right|}={\left|{\bm{M}}(x)^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{M}}(x)\right|}\leq{\left\|{\bm{M}}(x)\right\|}_{2}^{2}{\left\|{\bm{U}}{\bm{U}}^{\top}\right\|}_{2}\leq\kappa^{2}\quad\text{for all }F\in{\mathcal{F}}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px1.p6" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p6.1" class="ltx_p">Regarding <math id="S20.SS0.SSS0.Px1.p6.m1" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}}_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}}_{d})</annotation></semantics></math>, we have the following result.</p>
</div>
<div id="chapter5.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma 5.10</span></span><span id="chapter5.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A2" title="Appendix 11.B Proof of Lemma ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.B</span></a>)<span id="chapter5.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem10.p1" class="ltx_para">
<p id="chapter5.Thmtheorem10.p1.1" class="ltx_p"><math id="chapter5.Thmtheorem10.p1.m1" class="ltx_Math" alttext="\mathfrak{R}_{m}({\mathcal{F}}_{d})\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℜ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><msqrt><mi>d</mi></msqrt><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{m}({\mathcal{F}}_{d})\leq\frac{\sqrt{d}}{\sqrt{m}}\kappa^{2}</annotation></semantics></math><span id="chapter5.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div>
</div>
<div id="S20.SS0.SSS0.Px1.p7" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p7.1" class="ltx_p">Hence, by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib148" title="" class="ltx_ref">148</a>, Theorem 4.10]</cite>, with probability at least <math id="S20.SS0.SSS0.Px1.p7.m1" class="ltx_Math" alttext="1-\frac{\delta}{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mi>δ</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{\delta}{2}</annotation></semantics></math> we have</p>
<table id="S20.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex49.m1" class="ltx_Math" alttext="{\left|\frac{1}{m}\sum_{i=1}^{m}F(x_{i})-\mathbb{E}_{{P_{\mathcal{X}}}}[F(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+\sqrt{2\log\frac{2}{\delta}}\right)}\qquad\text{for all }F\in{\mathcal{F}}_{d}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>d</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left|\frac{1}{m}\sum_{i=1}^{m}F(x_{i})-\mathbb{E}_{{P_{\mathcal{X}}}}[F(X)]\right|}\leq\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+\sqrt{2\log\frac{2}{\delta}}\right)}\qquad\text{for all }F\in{\mathcal{F}}_{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px1.p7.2" class="ltx_p">which implies that</p>
<table id="S20.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.E21.m1" class="ltx_Math" alttext="{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\geq\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+\sqrt{2\log\frac{2}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mi>m</mi></mfrac><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\geq\frac{\lambda_{1}+\cdots+\lambda_{d}}{m}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+\sqrt{2\log\frac{2}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px1.p8" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p8.1" class="ltx_p">Combining <a href="#S20.E20" title="In Approximation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">20</span></a> and <a href="#S20.E21" title="Equation 21 ‣ Approximation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>, with probability at least <math id="S20.SS0.SSS0.Px1.p8.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</p>
<table id="S20.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex50.m1" class="ltx_Math" alttext="{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\geq s_{1}^{2}+\cdots+s_{d}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\phi_{1}\right\|}_{{P_{\mathcal{X}}}}^{2}+\cdots+{\left\|\phi_{d}\right\|}_{{P_{\mathcal{X}}}}^{2}\geq s_{1}^{2}+\cdots+s_{d}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px1.p8.2" class="ltx_p">Thus, by <a href="#chapter5.Thmtheorem8" title="Lemma 5.8. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.8</span></a>, we get</p>
<table id="S20.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex51.m1" class="ltx_Math" alttext="{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}\leq s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px1.p9" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p9.1" class="ltx_p">Let <math id="S20.SS0.SSS0.Px1.p9.m1" class="ltx_Math" alttext="\alpha={\left\|f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\geq s_{1}^{-2}{\left\|f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>≥</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha={\left\|f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\geq s_{1}^{-2}{\left\|f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>. Then, we have</p>
<table id="S20.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex52.m1" class="ltx_Math" alttext="\alpha^{2}+\beta^{2}={\left\|f^{*}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\leq\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}\leq\frac{{\left({\left\|f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}+\beta{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right)}^{2}}{(1-\epsilon)^{2}}\leq\frac{s_{1}^{2}\alpha^{2}+\beta^{2}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}+(\alpha^{2}+\beta^{2})s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}}{(1-\epsilon)^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mfrac><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≤</mo><mfrac><msup><mrow><mo>(</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>≤</mo><mfrac><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha^{2}+\beta^{2}={\left\|f^{*}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\leq\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}\leq\frac{{\left({\left\|f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}+\beta{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right)}^{2}}{(1-\epsilon)^{2}}\leq\frac{s_{1}^{2}\alpha^{2}+\beta^{2}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2}+(\alpha^{2}+\beta^{2})s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}}{(1-\epsilon)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px1.p9.2" class="ltx_p">With some simple algebra, we get</p>
<table id="S20.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex53.m1" class="ltx_Math" alttext="(s_{1}^{2}-{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2})\beta^{2}\leq{\left[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right]}(\alpha^{2}+\beta^{2})\leq{\left[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right]}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mo>[</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>[</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(s_{1}^{2}-{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}^{2})\beta^{2}\leq{\left[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right]}(\alpha^{2}+\beta^{2})\leq{\left[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}\right]}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px1.p9.3" class="ltx_p">Note that <math id="S20.SS0.SSS0.Px1.p9.m2" class="ltx_Math" alttext="{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}=\beta" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}=\beta</annotation></semantics></math>, and <math id="S20.SS0.SSS0.Px1.p9.m3" class="ltx_Math" alttext="{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}=\beta{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}=\beta{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}</annotation></semantics></math>.
Hence, we have proved the following bound for the approximation error.</p>
</div>
<div id="chapter5.Thmtheorem11" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem11.2" class="ltx_text ltx_font_bold">Theorem 5.11</span></span><span id="chapter5.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem11.p1" class="ltx_para">
<p id="chapter5.Thmtheorem11.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem11.p1.m1" class="ltx_Math" alttext="f_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">f_{\Phi}</annotation></semantics></math> be the projection of any <math id="chapter5.Thmtheorem11.p1.m2" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math> onto the span of <math id="chapter5.Thmtheorem11.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, such that <math id="chapter5.Thmtheorem11.p1.m4" class="ltx_Math" alttext="{\left\langle f^{*}-f_{\Phi},f_{\Phi}\right\rangle}_{{{\mathcal{H}}_{k}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>,</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\langle f^{*}-f_{\Phi},f_{\Phi}\right\rangle}_{{{\mathcal{H}}_{k}}}=0</annotation></semantics></math>.
Suppose <math id="chapter5.Thmtheorem11.p1.m5" class="ltx_Math" alttext="(1-\epsilon)^{2}&lt;s_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>&lt;</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">(1-\epsilon)^{2}&lt;s_{1}^{2}</annotation></semantics></math>.
Then, for any <math id="chapter5.Thmtheorem11.p1.m6" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter5.Thmtheorem11.p1.m7" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math> we have</span></p>
<table id="S20.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S20.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S20.Ex54.m1" class="ltx_Math" alttext="\displaystyle{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S20.Ex54.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\sqrt{s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}}{s_{1}^{2}-s_{d+1}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}\cdot\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\sqrt{s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}}{s_{1}^{2}-s_{d+1}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}\cdot\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S20.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S20.Ex55.m1" class="ltx_Math" alttext="\displaystyle{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S20.Ex55.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\sqrt{s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}}{s_{1}^{2}-s_{d+1}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}\cdot\frac{s_{1}^{2}{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>m</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>6</mn><mi>δ</mi></mfrac></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\sqrt{s_{d+1}^{2}+\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}}{s_{1}^{2}-s_{d+1}^{2}-\frac{\kappa^{2}}{\sqrt{m}}{\left(2\sqrt{d}+3\sqrt{\log\frac{6}{\delta}}\right)}}\cdot\frac{s_{1}^{2}{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="chapter5.Thmtheorem11.p1.2" class="ltx_p"><span id="chapter5.Thmtheorem11.p1.2.1" class="ltx_text ltx_font_italic">assuming that the denominator is positive.</span></p>
</div>
</div>
<div id="S20.SS0.SSS0.Px1.p10" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px1.p10.1" class="ltx_p">Comparing to <a href="#chapter3.Thmtheorem4" title="Theorem 3.4 (Proof in ). ‣ 12 Compatibility, Optimality of Contexture ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.4</span></a>, we can see that this bound is fairly tight when <math id="S20.SS0.SSS0.Px1.p10.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is sufficiently large. The only differences are that the numerator has an extra term that is close to <math id="S20.SS0.SSS0.Px1.p10.m2" class="ltx_Math" alttext="s_{1}s_{d+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">s_{1}s_{d+1}</annotation></semantics></math> (<math id="S20.SS0.SSS0.Px1.p10.m3" class="ltx_Math" alttext="s_{d+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{d+1}</annotation></semantics></math> should be pretty small), and <math id="S20.SS0.SSS0.Px1.p10.m4" class="ltx_Math" alttext="{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math> is multiplied by <math id="S20.SS0.SSS0.Px1.p10.m5" class="ltx_Math" alttext="\frac{s_{1}^{2}}{(1-\epsilon)^{2}}" display="inline" intent=":literal"><semantics><mfrac><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{s_{1}^{2}}{(1-\epsilon)^{2}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S20.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Estimation error bound.</h4>

<div id="S20.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px2.p1.1" class="ltx_p">Next, we bound the estimation error of the predictor fit on top of <math id="S20.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> using the <math id="S20.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> labeled downstream samples. The bound consists of two parts:</p>
<ol id="S20.I2" class="ltx_enumerate">
<li id="S20.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S20.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S20.I2.i1.p1.1" class="ltx_p">Assume that the labels are generated from <math id="S20.I2.i1.p1.m1" class="ltx_Math" alttext="f_{\Phi}(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\Phi}(\tilde{x}_{i})</annotation></semantics></math>. Let <math id="S20.I2.i1.p1.m2" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math> be the learned predictor. Then, the gap <math id="S20.I2.i1.p1.m3" class="ltx_Math" alttext="{\left\|\hat{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><annotation encoding="application/x-tex">{\left\|\hat{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}</annotation></semantics></math> can be bounded using standard generalization bounds.</p>
</div></li>
<li id="S20.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S20.I2.i2.p1" class="ltx_para">
<p id="S20.I2.i2.p1.1" class="ltx_p">However, the real labels are generated from <math id="S20.I2.i2.p1.m1" class="ltx_Math" alttext="f^{*}(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{*}(\tilde{x}_{i})</annotation></semantics></math> instead of <math id="S20.I2.i2.p1.m2" class="ltx_Math" alttext="f_{\Phi}(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\Phi}(\tilde{x}_{i})</annotation></semantics></math>. Thus, we need to bound the gap between <math id="S20.I2.i2.p1.m3" class="ltx_Math" alttext="f^{*}(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{*}(\tilde{x}_{i})</annotation></semantics></math> and <math id="S20.I2.i2.p1.m4" class="ltx_Math" alttext="f_{\Phi}(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\Phi}(\tilde{x}_{i})</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S20.SS0.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px2.p2.1" class="ltx_p">Let the downstream training set be <math id="S20.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="{\left\{(\tilde{x}_{i},y_{i})\right\}}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">{\left\{(\tilde{x}_{i},y_{i})\right\}}_{i=1}^{n}</annotation></semantics></math> <span id="S20.SS0.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">i.i.d.</span> drawn from a distribution <math id="S20.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="P_{{\mathcal{X}},{\mathcal{Y}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><annotation encoding="application/x-tex">P_{{\mathcal{X}},{\mathcal{Y}}}</annotation></semantics></math> with marginal distribution <math id="S20.SS0.SSS0.Px2.p2.m3" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>, and we assume the following <span id="S20.SS0.SSS0.Px2.p2.1.2" class="ltx_text ltx_font_bold">moment condition</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>:</p>
<table id="S20.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.E22.m1" class="ltx_Math" alttext="\mathbb{E}_{P_{{\mathcal{X}},{\mathcal{Y}}}}{\left[{\left|Y-f^{*}(X)\right|}^{r}\right]}\leq\frac{1}{2}r!\sigma^{2}L^{r-2}\quad\text{for all }r\geq 2\text{ and }{P_{\mathcal{X}}}\text{-almost all }x," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>|</mo><mrow><mi>Y</mi><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mi>r</mi></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext>-almost all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{P_{{\mathcal{X}},{\mathcal{Y}}}}{\left[{\left|Y-f^{*}(X)\right|}^{r}\right]}\leq\frac{1}{2}r!\sigma^{2}L^{r-2}\quad\text{for all }r\geq 2\text{ and }{P_{\mathcal{X}}}\text{-almost all }x,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px2.p2.2" class="ltx_p">for some <math id="S20.SS0.SSS0.Px2.p2.m4" class="ltx_Math" alttext="\sigma,L&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>,</mo><mi>L</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma,L&gt;0</annotation></semantics></math>. For example, if <math id="S20.SS0.SSS0.Px2.p2.m5" class="ltx_Math" alttext="Y\sim{\mathcal{N}}(f^{*}(X),\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y\sim{\mathcal{N}}(f^{*}(X),\sigma^{2})</annotation></semantics></math>, then this condition holds with <math id="S20.SS0.SSS0.Px2.p2.m6" class="ltx_Math" alttext="L=\sigma" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mi>σ</mi></mrow><annotation encoding="application/x-tex">L=\sigma</annotation></semantics></math>.
Denote <math id="S20.SS0.SSS0.Px2.p2.m7" class="ltx_Math" alttext="{\bm{y}}=[y_{1},\cdots,y_{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}=[y_{1},\cdots,y_{n}]</annotation></semantics></math>, <math id="S20.SS0.SSS0.Px2.p2.m8" class="ltx_Math" alttext="{\bm{y}}^{*}=[f^{*}(\tilde{x}_{1}),\cdots,f^{*}(\tilde{x}_{n})]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒚</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}^{*}=[f^{*}(\tilde{x}_{1}),\cdots,f^{*}(\tilde{x}_{n})]</annotation></semantics></math>, and <math id="S20.SS0.SSS0.Px2.p2.m9" class="ltx_Math" alttext="{\bm{y}}^{*}_{\Phi}=[f_{\Phi}(\tilde{x}_{1}),\cdots,f_{\Phi}(\tilde{x}_{n})]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒚</mi><mi mathvariant="normal">Φ</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}^{*}_{\Phi}=[f_{\Phi}(\tilde{x}_{1}),\cdots,f_{\Phi}(\tilde{x}_{n})]</annotation></semantics></math>.
Then, <math id="S20.SS0.SSS0.Px2.p2.m10" class="ltx_Math" alttext="{\bm{y}}_{\Phi}={\bm{y}}-{\bm{y}}^{*}+{\bm{y}}_{\Phi}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><mrow><mi>𝒚</mi><mo>−</mo><msup><mi>𝒚</mi><mo>∗</mo></msup></mrow><mo>+</mo><msubsup><mi>𝒚</mi><mi mathvariant="normal">Φ</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{\Phi}={\bm{y}}-{\bm{y}}^{*}+{\bm{y}}_{\Phi}^{*}</annotation></semantics></math> consists of the original labels shifted by <math id="S20.SS0.SSS0.Px2.p2.m11" class="ltx_Math" alttext="f_{\Phi}-f^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">f_{\Phi}-f^{*}</annotation></semantics></math>.
Part (i) bounds the estimation error assuming that the labels are <math id="S20.SS0.SSS0.Px2.p2.m12" class="ltx_Math" alttext="{\bm{y}}_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">{\bm{y}}_{\Phi}</annotation></semantics></math>.
Then, part (ii) bounds the gap between <math id="S20.SS0.SSS0.Px2.p2.m13" class="ltx_Math" alttext="{\bm{y}}_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">{\bm{y}}_{\Phi}</annotation></semantics></math> and <math id="S20.SS0.SSS0.Px2.p2.m14" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S20.SS0.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Part (i) Estimation error bound for kernel ridge regression.</h4>

<div id="S20.SS0.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p1.1" class="ltx_p">Let the downstream predictor be <math id="S20.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="f(x)={\bm{w}}^{\top}\Phi(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)={\bm{w}}^{\top}\Phi(x)</annotation></semantics></math>.
Here we consider an unbiased linear predictor for simplicity.
The proof when the predictor is biased is the same but a bit more verbose.
Consider fitting <math id="S20.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="{\bm{w}}" display="inline" intent=":literal"><semantics><mi>𝒘</mi><annotation encoding="application/x-tex">{\bm{w}}</annotation></semantics></math> with ridge regression given by</p>
<table id="S20.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex56.m1" class="ltx_Math" alttext="\tilde{{\bm{w}}}=\argmin_{{\bm{w}}}{\left\{\frac{1}{n}{\left({\bm{y}}_{\Phi}[i]-{\bm{w}}^{\top}\Phi(\tilde{x}_{i})\right)}^{2}+\beta_{n}{\left\|{\bm{w}}\right\|}_{2}^{2}\right\}}," display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐰</mi></msub><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mi>𝐲</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mi>𝐰</mi><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{{\bm{w}}}=\argmin_{{\bm{w}}}{\left\{\frac{1}{n}{\left({\bm{y}}_{\Phi}[i]-{\bm{w}}^{\top}\Phi(\tilde{x}_{i})\right)}^{2}+\beta_{n}{\left\|{\bm{w}}\right\|}_{2}^{2}\right\}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px3.p1.2" class="ltx_p">where the regularization parameter <math id="S20.SS0.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\beta_{n}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\beta_{n}</annotation></semantics></math> can change with <math id="S20.SS0.SSS0.Px3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.
When <math id="S20.SS0.SSS0.Px3.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is larger, typically we would like <math id="S20.SS0.SSS0.Px3.p1.m6" class="ltx_Math" alttext="\beta_{n}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\beta_{n}</annotation></semantics></math> to be smaller, because we have more samples so can use a smaller regularization to achieve the same level of generalization.
Let <math id="S20.SS0.SSS0.Px3.p1.m7" class="ltx_Math" alttext="\tilde{f}(x)=\tilde{{\bm{w}}}^{\top}\Phi(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{f}(x)=\tilde{{\bm{w}}}^{\top}\Phi(x)</annotation></semantics></math>.
Note that <math id="S20.SS0.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\tilde{f}\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{f}\in{{\mathcal{H}}_{k}}</annotation></semantics></math>, and <math id="S20.SS0.SSS0.Px3.p1.m9" class="ltx_Math" alttext="{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum\tilde{w}_{i}^{2}{\left\|\phi_{i}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\tilde{{\bm{w}}}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum\tilde{w}_{i}^{2}{\left\|\phi_{i}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\tilde{{\bm{w}}}\right\|}_{2}^{2}</annotation></semantics></math>.
Thus, the above regression is equivalent to a kernel ridge regression on <math id="S20.SS0.SSS0.Px3.p1.m10" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math>, where the regularization term is <math id="S20.SS0.SSS0.Px3.p1.m11" class="ltx_Math" alttext="\beta_{n}{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\beta_{n}{\left\|\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}</annotation></semantics></math>.</p>
</div>
<div id="S20.SS0.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p2.1" class="ltx_p">Denote <math id="S20.SS0.SSS0.Px3.p2.m1" class="ltx_Math" alttext="{\bm{\Phi}}=[\Phi(\tilde{x}_{1}),\cdots,\Phi(\tilde{x}_{n})]\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝚽</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{\Phi}}=[\Phi(\tilde{x}_{1}),\cdots,\Phi(\tilde{x}_{n})]\in\mathbb{R}^{d\times n}</annotation></semantics></math>.
A standard result in statistics shows that</p>
<table id="S20.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.E23.m1" class="ltx_Math" alttext="\tilde{{\bm{w}}}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}{\bm{y}}_{\Phi}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{{\bm{w}}}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}{\bm{y}}_{\Phi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px3.p3" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p3.1" class="ltx_p"><math id="S20.SS0.SSS0.Px3.p3.m1" class="ltx_Math" alttext="{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math> can be bounded using the results in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>.
To use their results, apart from the moment condition <a href="#S20.E22" title="In Estimation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">22</span></a>, three additional conditions are required:</p>
<ul id="S20.I3" class="ltx_itemize">
<li id="S20.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S20.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S20.I3.i1.p1.1" class="ltx_p"><span id="S20.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">Eigenvalue decay (EVD):</span> Let <math id="S20.I3.i1.p1.m1" class="ltx_Math" alttext="\zeta_{1}\geq\zeta_{2}\geq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\zeta_{1}\geq\zeta_{2}\geq\cdots</annotation></semantics></math> be the eigenvalues of the RKHS. Then, <math id="S20.I3.i1.p1.m2" class="ltx_Math" alttext="\zeta_{i}\leq c_{1}i^{-\frac{1}{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>i</mi></msub><mo>≤</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>i</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mi>p</mi></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\zeta_{i}\leq c_{1}i^{-\frac{1}{p}}</annotation></semantics></math> for some constant <math id="S20.I3.i1.p1.m3" class="ltx_Math" alttext="c_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{1}&gt;0</annotation></semantics></math> and <math id="S20.I3.i1.p1.m4" class="ltx_Math" alttext="p\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">p\in(0,1]</annotation></semantics></math>.</p>
</div></li>
<li id="S20.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S20.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S20.I3.i2.p1.1" class="ltx_p"><span id="S20.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Embedding condition (EMB):</span> There exists a constant <math id="S20.I3.i2.p1.m1" class="ltx_Math" alttext="c_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{2}&gt;0</annotation></semantics></math> such that for any <math id="S20.I3.i2.p1.m2" class="ltx_Math" alttext="f\in{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">f\in{{\mathcal{H}}_{k}}</annotation></semantics></math>, <math id="S20.I3.i2.p1.m3" class="ltx_Math" alttext="{\left\|f\right\|}_{\infty}\leq c_{2}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{\infty}\leq c_{2}{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}</annotation></semantics></math>. Here <math id="S20.I3.i2.p1.m4" class="ltx_Math" alttext="{\left\|f\right\|}_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">{\left\|f\right\|}_{\infty}</annotation></semantics></math> is the smallest <math id="S20.I3.i2.p1.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> such that <math id="S20.I3.i2.p1.m6" class="ltx_Math" alttext="|f(x)|\leq B" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">|f(x)|\leq B</annotation></semantics></math> for <math id="S20.I3.i2.p1.m7" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>-almost all <math id="S20.I3.i2.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</p>
</div></li>
<li id="S20.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S20.I3.i3.p1" class="ltx_para">
<p id="S20.I3.i3.p1.1" class="ltx_p"><span id="S20.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">Source condition (SRC):</span> There exists a constant <math id="S20.I3.i3.p1.m1" class="ltx_Math" alttext="c_{3}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{3}&gt;0</annotation></semantics></math> such that <math id="S20.I3.i3.p1.m2" class="ltx_Math" alttext="{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq c_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><msub><mi>c</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}\leq c_{3}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S20.SS0.SSS0.Px3.p4" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p4.1" class="ltx_p">Space <math id="S20.SS0.SSS0.Px3.p4.m1" class="ltx_Math" alttext="{{\mathcal{H}}_{k}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">{{\mathcal{H}}_{k}}</annotation></semantics></math> obviously satisfies (EVD) because its rank is <math id="S20.SS0.SSS0.Px3.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, so the condition holds for any <math id="S20.SS0.SSS0.Px3.p4.m3" class="ltx_Math" alttext="p\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">p\in(0,1]</annotation></semantics></math>.
For <math id="S20.SS0.SSS0.Px3.p4.m4" class="ltx_Math" alttext="f=f_{\Phi}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><annotation encoding="application/x-tex">f=f_{\Phi}</annotation></semantics></math>, it satisfies (EMB) with <math id="S20.SS0.SSS0.Px3.p4.m5" class="ltx_Math" alttext="c_{2}=\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>=</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">c_{2}=\kappa</annotation></semantics></math>, because for any <math id="S20.SS0.SSS0.Px3.p4.m6" class="ltx_Math" alttext="x_{0}\in{\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x_{0}\in{\mathcal{X}}</annotation></semantics></math>, we have <math id="S20.SS0.SSS0.Px3.p4.m7" class="ltx_Math" alttext="f(x_{0})={\left\langle f,k(x_{0},\cdot)\right\rangle}_{{{\mathcal{H}}_{k}}}\leq{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}{\left\|k(x_{0},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">f(x_{0})={\left\langle f,k(x_{0},\cdot)\right\rangle}_{{{\mathcal{H}}_{k}}}\leq{\left\|f\right\|}_{{{\mathcal{H}}_{k}}}{\left\|k(x_{0},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}</annotation></semantics></math>,
and <math id="S20.SS0.SSS0.Px3.p4.m8" class="ltx_Math" alttext="{\left\|k(x_{0},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\sum s_{i}^{2}\mu_{i}(x_{0})\mu_{i}(\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum s_{i}^{2}\mu_{i}(x_{0})^{2}\leq\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\left\|k(x_{0},\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|\sum s_{i}^{2}\mu_{i}(x_{0})\mu_{i}(\cdot)\right\|}_{{{\mathcal{H}}_{k}}}^{2}=\sum s_{i}^{2}\mu_{i}(x_{0})^{2}\leq\kappa^{2}</annotation></semantics></math> for <math id="S20.SS0.SSS0.Px3.p4.m9" class="ltx_Math" alttext="{P_{\mathcal{X}}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><annotation encoding="application/x-tex">{P_{\mathcal{X}}}</annotation></semantics></math>-almost all <math id="S20.SS0.SSS0.Px3.p4.m10" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math>.
Moreover, assuming that <math id="S20.SS0.SSS0.Px3.p4.m11" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> is fixed, <math id="S20.SS0.SSS0.Px3.p4.m12" class="ltx_Math" alttext="f=f_{\Phi}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><annotation encoding="application/x-tex">f=f_{\Phi}</annotation></semantics></math> also satisfies (SRC) with <math id="S20.SS0.SSS0.Px3.p4.m13" class="ltx_Math" alttext="c_{3}={\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}/(1-\epsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{3}={\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}/(1-\epsilon)</annotation></semantics></math> because <math id="S20.SS0.SSS0.Px3.p4.m14" class="ltx_Math" alttext="{\left\|f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}\leq{\left\|f^{*}\right\|}_{{{\mathcal{H}}_{k}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><msub><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">{\left\|f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}\leq{\left\|f^{*}\right\|}_{{{\mathcal{H}}_{k}}}</annotation></semantics></math>.</p>
</div>
<div id="S20.SS0.SSS0.Px3.p5" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p5.1" class="ltx_p">With all these conditions, invoking Theorem 3.1 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>, we get the following.</p>
</div>
<div id="chapter5.Thmtheorem12" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem12.2" class="ltx_text ltx_font_bold">Theorem 5.12</span></span><span id="chapter5.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem12.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem12.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="chapter5.Thmtheorem12.p1.m1" class="ltx_Math" alttext="p\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">p\in(0,1]</annotation></semantics></math> and sufficiently large <math id="chapter5.Thmtheorem12.p1.m2" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math> and <math id="chapter5.Thmtheorem12.p1.m3" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math>, suppose we choose <math id="chapter5.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\beta_{n}=\Theta{\left(n^{-\frac{1}{1+p}}\right)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>n</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>n</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>p</mi></mrow></mfrac></mrow></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{n}=\Theta{\left(n^{-\frac{1}{1+p}}\right)}</annotation></semantics></math>. Then, there exists a constant <math id="chapter5.Thmtheorem12.p1.m5" class="ltx_Math" alttext="A&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A&gt;0</annotation></semantics></math> independent of <math id="chapter5.Thmtheorem12.p1.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="chapter5.Thmtheorem12.p1.m7" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, such that with probability at least <math id="chapter5.Thmtheorem12.p1.m8" class="ltx_Math" alttext="1-4e^{\eta}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>η</mi></msup></mrow></mrow><annotation encoding="application/x-tex">1-4e^{\eta}</annotation></semantics></math>, we have <math id="chapter5.Thmtheorem12.p1.m9" class="ltx_Math" alttext="{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}\leq s_{1}{\left\|\tilde{f}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>≤</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}\leq s_{1}{\left\|\tilde{f}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}</annotation></semantics></math>, and</span></p>
<table id="S20.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex57.m1" class="ltx_Math" alttext="{\left\|\tilde{f}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\leq 2\sqrt{\beta_{n}}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}+A\eta^{2}{\left[\frac{\kappa^{2}{\left(\sigma^{2}+\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}\right)}}{n\beta_{n}^{\frac{1}{2}+p}}+\frac{\kappa^{2}\max{\left\{L^{2},4\kappa^{2}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}^{2}}}{(1-\epsilon)^{2}}\right\}}}{n^{2}\sqrt{\beta_{n}}}\right]}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>β</mi><mi>n</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mfrac><msubsup><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>n</mi><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mi>p</mi></mrow></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><msup><mi>L</mi><mn>2</mn></msup><mo>,</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><mmultiscripts><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi><mrow></mrow><mrow></mrow><mn>2</mn></mmultiscripts></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>}</mo></mrow></mrow></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>β</mi><mi>n</mi></msub></msqrt></mrow></mfrac></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\leq 2\sqrt{\beta_{n}}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}+A\eta^{2}{\left[\frac{\kappa^{2}{\left(\sigma^{2}+\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}^{2}}{(1-\epsilon)^{2}}\right)}}{n\beta_{n}^{\frac{1}{2}+p}}+\frac{\kappa^{2}\max{\left\{L^{2},4\kappa^{2}\frac{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}^{2}}}{(1-\epsilon)^{2}}\right\}}}{n^{2}\sqrt{\beta_{n}}}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S20.SS0.SSS0.Px3.p6" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px3.p6.1" class="ltx_p">We can see that as <math id="S20.SS0.SSS0.Px3.p6.m1" class="ltx_Math" alttext="n\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\rightarrow\infty</annotation></semantics></math>, there is <math id="S20.SS0.SSS0.Px3.p6.m2" class="ltx_Math" alttext="{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\left\|\tilde{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}\rightarrow 0</annotation></semantics></math>.
when <math id="S20.SS0.SSS0.Px3.p6.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is very small, we can think of this bound as <math id="S20.SS0.SSS0.Px3.p6.m4" class="ltx_Math" alttext="O(\frac{\kappa^{2}}{\sqrt{n}})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\frac{\kappa^{2}}{\sqrt{n}})</annotation></semantics></math>.
In the ideal case, all singular values except the top-<math id="S20.SS0.SSS0.Px3.p6.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> are <math id="S20.SS0.SSS0.Px3.p6.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>; then, <math id="S20.SS0.SSS0.Px3.p6.m7" class="ltx_Math" alttext="\kappa^{2}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\kappa^{2}</annotation></semantics></math> can be viewed as an approximation of <math id="S20.SS0.SSS0.Px3.p6.m8" class="ltx_Math" alttext="\sum_{i=1}^{d}s_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{d}s_{i}^{2}</annotation></semantics></math>.
This is the bound that we used to derive the metric in <a href="#S14" title="14 Evaluating Context Usefulness ‣ Chapter 3 Intrinsic Evaluation: The Optimality of Learning the Contexture ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">14</span></a>.</p>
</div>
</section>
<section id="S20.SS0.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Part (ii) Shift in the labels.</h4>

<div id="S20.SS0.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px4.p1.1" class="ltx_p">The actual downstream predictor is given by</p>
<table id="S20.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.E24.m1" class="ltx_Math" alttext="\hat{{\bm{w}}}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}{\bm{y}}," display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒘</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{{\bm{w}}}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}{\bm{y}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px4.p1.2" class="ltx_p">similar to <a href="#S20.E23" title="In Part (i) Estimation error bound for kernel ridge regression. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">23</span></a>. Let <math id="S20.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\hat{f}(x)=\hat{{\bm{w}}}^{\top}\Phi(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x)=\hat{{\bm{w}}}^{\top}\Phi(x)</annotation></semantics></math>.
Then, we have</p>
<table id="S20.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex58.m1" class="ltx_Math" alttext="{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|{\left[{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right]}^{\top}\Phi\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right\|}_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|{\left[{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right]}^{\top}\Phi\right\|}_{{{\mathcal{H}}_{k}}}^{2}={\left\|{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right\|}_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S20.SS0.SSS0.Px4.p2" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px4.p2.1" class="ltx_p">Let <math id="S20.SS0.SSS0.Px4.p2.m1" class="ltx_Math" alttext="{\bm{Q}}={\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}={\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}</annotation></semantics></math>.
It suffices to bound <math id="S20.SS0.SSS0.Px4.p2.m2" class="ltx_Math" alttext="{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}</annotation></semantics></math> and <math id="S20.SS0.SSS0.Px4.p2.m3" class="ltx_Math" alttext="{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}</annotation></semantics></math>.
To bound these, we need the following lemma, which can be proved using the Rademacher complexity.</p>
</div>
<div id="chapter5.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma 5.13</span></span><span id="chapter5.Thmtheorem13.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A3" title="Appendix 11.C Proof of Lemma ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.C</span></a>)<span id="chapter5.Thmtheorem13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem13.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem13.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem13.p1.m1" class="ltx_math_unparsed" alttext="{\mathcal{F}}={\left\{f_{1}f_{2}\;\middle|\;f_{1},f_{2}\in{{\mathcal{H}}_{k}};{\left\|f_{1}\right\|}_{{{\mathcal{H}}_{k}}},{\left\|f_{2}\right\|}_{{{\mathcal{H}}_{k}}}\leq 1\right\}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><mrow><mo>{</mo><msub><mi>f</mi><mn>1</mn></msub><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" stretchy="true">|</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mo>;</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>2</mn></msub><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo>≤</mo><mn>1</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}={\left\{f_{1}f_{2}\;\middle|\;f_{1},f_{2}\in{{\mathcal{H}}_{k}};{\left\|f_{1}\right\|}_{{{\mathcal{H}}_{k}}},{\left\|f_{2}\right\|}_{{{\mathcal{H}}_{k}}}\leq 1\right\}}</annotation></semantics></math>.
Then, <math id="chapter5.Thmtheorem13.p1.m2" class="ltx_Math" alttext="\mathfrak{R}_{n}({\mathcal{F}})\leq\frac{\kappa^{2}}{\sqrt{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℜ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\mathfrak{R}_{n}({\mathcal{F}})\leq\frac{\kappa^{2}}{\sqrt{n}}</annotation></semantics></math>.
If <math id="chapter5.Thmtheorem13.p1.m3" class="ltx_Math" alttext="m\geq n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\geq n</annotation></semantics></math>, then for any <math id="chapter5.Thmtheorem13.p1.m4" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="chapter5.Thmtheorem13.p1.m5" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="S20.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex59.m1" class="ltx_Math" alttext="{\left\|{\bm{\Phi}}^{\top}{\bm{u}}\right\|}_{2}^{2}\geq\frac{n}{m}\lambda_{d}-\kappa^{2}\sqrt{n}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}\quad\text{for any unit vector }{\bm{u}}\in\mathbb{R}^{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><mrow><mfrac><mi>n</mi><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mo>−</mo><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for any unit vector </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|{\bm{\Phi}}^{\top}{\bm{u}}\right\|}_{2}^{2}\geq\frac{n}{m}\lambda_{d}-\kappa^{2}\sqrt{n}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}\quad\text{for any unit vector }{\bm{u}}\in\mathbb{R}^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S20.SS0.SSS0.Px4.p3" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px4.p3.1" class="ltx_p"><math id="S20.SS0.SSS0.Px4.p3.m1" class="ltx_Math" alttext="{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}</annotation></semantics></math> is equal to the largest eigenvalue of <math id="S20.SS0.SSS0.Px4.p3.m2" class="ltx_Math" alttext="{\bm{\Phi}}^{\top}{\bm{Q}}^{-2}{\bm{\Phi}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi></mrow><annotation encoding="application/x-tex">{\bm{\Phi}}^{\top}{\bm{Q}}^{-2}{\bm{\Phi}}</annotation></semantics></math>,
which is also the largest eigenvalue of <math id="S20.SS0.SSS0.Px4.p3.m3" class="ltx_Math" alttext="{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}</annotation></semantics></math> by Sylvester’s theorem.
Let <math id="S20.SS0.SSS0.Px4.p3.m4" class="ltx_Math" alttext="\xi_{1}\geq\cdots\geq\xi_{d}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mn>1</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>ξ</mi><mi>d</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi_{1}\geq\cdots\geq\xi_{d}\geq 0</annotation></semantics></math> and <math id="S20.SS0.SSS0.Px4.p3.m5" class="ltx_Math" alttext="{\bm{\alpha}}_{1},\cdots,{\bm{\alpha}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜶</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝜶</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{\alpha}}_{1},\cdots,{\bm{\alpha}}_{d}</annotation></semantics></math> be the eigenvalues and orthonormal eigenvectors of <math id="S20.SS0.SSS0.Px4.p3.m6" class="ltx_Math" alttext="{\bm{\Phi}}{\bm{\Phi}}^{\top}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{\Phi}}{\bm{\Phi}}^{\top}\in\mathbb{R}^{d\times d}</annotation></semantics></math>.
If <math id="S20.SS0.SSS0.Px4.p3.m7" class="ltx_Math" alttext="\xi_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi_{i}=0</annotation></semantics></math>, then <math id="S20.SS0.SSS0.Px4.p3.m8" class="ltx_Math" alttext="{\bm{\alpha}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝜶</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{\alpha}}_{i}</annotation></semantics></math> is also an eigenvector of <math id="S20.SS0.SSS0.Px4.p3.m9" class="ltx_Math" alttext="{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}</annotation></semantics></math> with eigenvalue <math id="S20.SS0.SSS0.Px4.p3.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
If <math id="S20.SS0.SSS0.Px4.p3.m11" class="ltx_Math" alttext="\xi&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi&gt;0</annotation></semantics></math>, then we have</p>
<table id="S20.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex60.m1" class="ltx_Math" alttext="{\bm{Q}}{\bm{\alpha}}_{i}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}{\bm{\alpha}}_{i}={\left(\xi_{i}+n\beta_{n}\right)}{\bm{\alpha}}_{i}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{Q}}{\bm{\alpha}}_{i}={\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}{\bm{\alpha}}_{i}={\left(\xi_{i}+n\beta_{n}\right)}{\bm{\alpha}}_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px4.p3.2" class="ltx_p">which implies that <math id="S20.SS0.SSS0.Px4.p3.m12" class="ltx_Math" alttext="{\bm{Q}}^{2}{\bm{\alpha}}_{i}={\left(\xi_{i}+n\beta_{n}\right)}^{2}{\bm{\alpha}}_{i}=\frac{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}{\xi_{i}}{\bm{\Phi}}{\bm{\Phi}}^{\top}{\bm{\alpha}}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝑸</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo>(</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><msub><mi>ξ</mi><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{2}{\bm{\alpha}}_{i}={\left(\xi_{i}+n\beta_{n}\right)}^{2}{\bm{\alpha}}_{i}=\frac{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}{\xi_{i}}{\bm{\Phi}}{\bm{\Phi}}^{\top}{\bm{\alpha}}_{i}</annotation></semantics></math>.
Thus, <math id="S20.SS0.SSS0.Px4.p3.m13" class="ltx_Math" alttext="{\bm{\alpha}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝜶</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{\alpha}}_{i}</annotation></semantics></math> is an eigenvector of <math id="S20.SS0.SSS0.Px4.p3.m14" class="ltx_Math" alttext="{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}</annotation></semantics></math> with eigenvalue <math id="S20.SS0.SSS0.Px4.p3.m15" class="ltx_Math" alttext="\frac{\xi_{i}}{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}" display="inline" intent=":literal"><semantics><mfrac><msub><mi>ξ</mi><mi>i</mi></msub><msup><mrow><mo>(</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{\xi_{i}}{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}</annotation></semantics></math>.
We can therefore conclude that <math id="S20.SS0.SSS0.Px4.p3.m16" class="ltx_Math" alttext="{\left(\frac{\xi_{i}}{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}\right)}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac><msub><mi>ξ</mi><mi>i</mi></msub><msup><mrow><mo>(</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">{\left(\frac{\xi_{i}}{{\left(\xi_{i}+n\beta_{n}\right)}^{2}}\right)}</annotation></semantics></math> are all the eigenvalues of <math id="S20.SS0.SSS0.Px4.p3.m17" class="ltx_Math" alttext="{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{-2}{\bm{\Phi}}{\bm{\Phi}}^{\top}</annotation></semantics></math>.
Meanwhile, by <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>, we have</p>
<table id="S20.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex61.m1" class="ltx_Math" alttext="\xi_{d}={\bm{\alpha}}_{d}^{\top}{\bm{\Phi}}{\bm{\Phi}}^{\top}{\bm{\alpha}}_{d}={\left\|{\bm{\Phi}}^{\top}{\bm{\alpha}}_{d}\right\|}_{2}^{2}\geq\frac{n}{m}\lambda_{d}-\kappa^{2}\sqrt{n}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ξ</mi><mi>d</mi></msub><mo>=</mo><mrow><msubsup><mi>𝜶</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>d</mi></msub></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜶</mi><mi>d</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><mrow><mfrac><mi>n</mi><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mo>−</mo><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\xi_{d}={\bm{\alpha}}_{d}^{\top}{\bm{\Phi}}{\bm{\Phi}}^{\top}{\bm{\alpha}}_{d}={\left\|{\bm{\Phi}}^{\top}{\bm{\alpha}}_{d}\right\|}_{2}^{2}\geq\frac{n}{m}\lambda_{d}-\kappa^{2}\sqrt{n}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px4.p3.3" class="ltx_p">When <math id="S20.SS0.SSS0.Px4.p3.m18" class="ltx_Math" alttext="n\geq\frac{4\kappa^{4}m^{2}}{\lambda_{d}^{2}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>d</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">n\geq\frac{4\kappa^{4}m^{2}}{\lambda_{d}^{2}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}^{2}</annotation></semantics></math>, we have <math id="S20.SS0.SSS0.Px4.p3.m19" class="ltx_Math" alttext="\xi_{d}\geq\frac{n\lambda_{d}}{2m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>d</mi></msub><mo>≥</mo><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\xi_{d}\geq\frac{n\lambda_{d}}{2m}</annotation></semantics></math>,
which implies that <math id="S20.SS0.SSS0.Px4.p3.m20" class="ltx_Math" alttext="{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}\leq\frac{2m}{n\lambda_{d}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝑸</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>d</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">{\left\|{\bm{Q}}^{-1}{\bm{\Phi}}\right\|}_{2}^{2}\leq\frac{2m}{n\lambda_{d}}</annotation></semantics></math>.
Remember that <math id="S20.SS0.SSS0.Px4.p3.m21" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> has the same order as <math id="S20.SS0.SSS0.Px4.p3.m22" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, so we should view <math id="S20.SS0.SSS0.Px4.p3.m23" class="ltx_Math" alttext="\lambda_{d}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\lambda_{d}</annotation></semantics></math> as also having roughly the same order as <math id="S20.SS0.SSS0.Px4.p3.m24" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>.</p>
</div>
<div id="S20.SS0.SSS0.Px4.p4" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px4.p4.1" class="ltx_p">Regarding <math id="S20.SS0.SSS0.Px4.p4.m1" class="ltx_Math" alttext="{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}</annotation></semantics></math>, it is equal to <math id="S20.SS0.SSS0.Px4.p4.m2" class="ltx_Math" alttext="\sum_{i=1}^{n}F(\tilde{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}F(\tilde{x}_{i})</annotation></semantics></math> where <math id="S20.SS0.SSS0.Px4.p4.m3" class="ltx_Math" alttext="F(x)=(f^{*}(x)-f_{\Phi}(x))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">F(x)=(f^{*}(x)-f_{\Phi}(x))^{2}</annotation></semantics></math>,
and we have already bounded <math id="S20.SS0.SSS0.Px4.p4.m4" class="ltx_Math" alttext="{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}</annotation></semantics></math> in <a href="#chapter5.Thmtheorem11" title="Theorem 5.11. ‣ Approximation error bound. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.11</span></a>.
We can bound <math id="S20.SS0.SSS0.Px4.p4.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> using <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>.</p>
</div>
<div id="chapter5.Thmtheorem14" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem14.2" class="ltx_text ltx_font_bold">Corollary 5.14</span></span><span id="chapter5.Thmtheorem14.3" class="ltx_text ltx_font_bold"> </span>(Proof in <a href="#chapter11.A4" title="Appendix 11.D Proof of Corollary ‣ Chapter 11 Proofs for Chapter 5 ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">11.D</span></a>)<span id="chapter5.Thmtheorem14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem14.p1" class="ltx_para ltx_noindent">
<p id="chapter5.Thmtheorem14.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">With probability at least <math id="chapter5.Thmtheorem14.p1.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we have</span></p>
<table id="S20.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex62.m1" class="ltx_Math" alttext="\frac{{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}}{n}\leq{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msubsup><mrow><mo>‖</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}}{n}\leq{\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}+{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S20.SS0.SSS0.Px4.p5" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px4.p5.1" class="ltx_p">Next, note that <math id="S20.SS0.SSS0.Px4.p5.m1" class="ltx_Math" alttext="G(x)=\frac{(\hat{f}(x)-\tilde{f}(x))^{2}}{{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}}\in{\mathcal{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mfrac><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">G(x)=\frac{(\hat{f}(x)-\tilde{f}(x))^{2}}{{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}}\in{\mathcal{F}}</annotation></semantics></math> defined in <a href="#chapter5.Thmtheorem13" title="Lemma 5.13 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">5.13</span></a>, and</p>
<table id="S20.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S20.Ex63.m1" class="ltx_Math" alttext="\sum_{i=1}^{n}{\left(\hat{f}(\tilde{x}_{i})-\tilde{f}(\tilde{x}_{i})\right)}^{2}={\left\|{\bm{\Phi}}^{\top}{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right\|}_{2}^{2}\leq{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo lspace="0em">(</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}{\left(\hat{f}(\tilde{x}_{i})-\tilde{f}(\tilde{x}_{i})\right)}^{2}={\left\|{\bm{\Phi}}^{\top}{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}({\bm{y}}-{\bm{y}}_{\Phi})\right\|}_{2}^{2}\leq{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px4.p5.2" class="ltx_p">because <math id="S20.SS0.SSS0.Px4.p5.m2" class="ltx_Math" alttext="{\left\|{\bm{\Phi}}^{\top}{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}\right\|}_{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mi>𝚽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚽</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑰</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚽</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|{\bm{\Phi}}^{\top}{\left({\bm{\Phi}}{\bm{\Phi}}^{\top}+n\beta_{n}{\bm{I}}_{d}\right)}^{-1}{\bm{\Phi}}\right\|}_{2}\leq 1</annotation></semantics></math>.
Thus, using <a href="#chapter5.Thmtheorem14" title="Corollary 5.14 (Proof in ). ‣ Part (ii) Shift in the labels. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">5.14</span></a>, we get</p>
<table id="S20.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S20.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S20.Ex64.m1" class="ltx_Math" alttext="\displaystyle{\left\|\hat{f}-\tilde{f}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle{\left\|\hat{f}-\tilde{f}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S20.Ex64.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{n}\sum_{i=1}^{n}{\left(\hat{f}(\tilde{x}_{i})-\tilde{f}(\tilde{x}_{i})\right)}^{2}+{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{n}\sum_{i=1}^{n}{\left(\hat{f}(\tilde{x}_{i})-\tilde{f}(\tilde{x}_{i})\right)}^{2}+{\left\|\hat{f}-\tilde{f}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\frac{\kappa^{2}}{\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S20.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S20.Ex65.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}}{n}{\left[1+\frac{2\kappa^{2}}{\lambda_{d}\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo>‖</mo><mrow><mi>𝒚</mi><mo>−</mo><msub><mi>𝒚</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>n</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{{\left\|{\bm{y}}-{\bm{y}}_{\Phi}\right\|}_{2}^{2}}{n}{\left[1+\frac{2\kappa^{2}}{\lambda_{d}\sqrt{n}}{\left(2+\sqrt{2\log\frac{2}{\delta}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S20.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S20.Ex66.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{3}{2}{\left({\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}+\frac{\lambda_{d}}{4}{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>λ</mi><mi>d</mi></msub><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{3}{2}{\left({\left\|f^{*}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}+\frac{\lambda_{d}}{4}{\left\|f^{*}-f_{\Phi}\right\|}_{{{\mathcal{H}}_{k}}}^{2}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S20.SS0.SSS0.Px4.p5.3" class="ltx_p">where the last step uses <math id="S20.SS0.SSS0.Px4.p5.m3" class="ltx_Math" alttext="n\geq\frac{4\kappa^{4}}{\lambda_{d}^{2}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow><msubsup><mi>λ</mi><mi>d</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">n\geq\frac{4\kappa^{4}}{\lambda_{d}^{2}}{\left(4+2\sqrt{2\log\frac{2}{\delta}}\right)}^{2}</annotation></semantics></math>.
Combining the above inequality with <a href="#chapter5.Thmtheorem12" title="Theorem 5.12. ‣ Part (i) Estimation error bound for kernel ridge regression. ‣ 20 Generalization Bounds for Contexture Learning ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.12</span></a>, we obtain a bound for <math id="S20.SS0.SSS0.Px4.p5.m4" class="ltx_Math" alttext="{\left\|\hat{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|\hat{f}-f_{\Phi}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S20.SS0.SSS0.Px5" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Dependency on the context complexity.</h4>

<div id="S20.SS0.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px5.p1.1" class="ltx_p">Our prediction error bound decreases with <math id="S20.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, meaning that the weaker the association of the context, the better the generalization will be.
Let us revisit the experimental results in <a href="#S19.F16" title="In Real language models. ‣ 19 Context Complexity ‣ Chapter 5 Statistical Learning Bounds for Representation Learning ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">16</span></a> (right).
On QNLI, the train-test gap decreases with the mask ratio <math id="S20.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, which matches our bound.
However, on SST-2, the train-test gap first decreases and then increases.
The reason is that our bound assumes that <math id="S20.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math>, but as the association becomes weaker, <math id="S20.SS0.SSS0.Px5.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math> becomes smaller and smaller.
When the association becomes too weak, <math id="S20.SS0.SSS0.Px5.p1.m5" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> might no longer belong to <math id="S20.SS0.SSS0.Px5.p1.m6" class="ltx_Math" alttext="{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{{{\mathcal{H}}_{k}}}(P^{+})</annotation></semantics></math>, and our bound will no longer hold.
In this case, further weakening the association might make the train-test gap larger.</p>
</div>
</section>
<section id="S20.SS0.SSS0.Px6" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Pair/transformation access.</h4>

<div id="S20.SS0.SSS0.Px6.p1" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px6.p1.1" class="ltx_p">The above analysis assumed that we have access to the centered dual kernel of the context.
What if we have pair or transformation access instead?
Recall that the dual kernel is <math id="S20.SS0.SSS0.Px6.p1.m1" class="ltx_Math" alttext="{k_{X}^{+}}(x,x^{\prime})=\int\frac{P^{+}(a|x)P^{+}(a|x^{\prime})}{{P_{\mathcal{A}}}(a)}da" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>a</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{k_{X}^{+}}(x,x^{\prime})=\int\frac{P^{+}(a|x)P^{+}(a|x^{\prime})}{{P_{\mathcal{A}}}(a)}da</annotation></semantics></math>.
If we have transformation access, then we can assume that we have full access to <math id="S20.SS0.SSS0.Px6.p1.m2" class="ltx_Math" alttext="P^{+}(a|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(a|x)</annotation></semantics></math> for any given <math id="S20.SS0.SSS0.Px6.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
The main problem appears in the denominator, because we can only estimate <math id="S20.SS0.SSS0.Px6.p1.m4" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)</annotation></semantics></math> by <math id="S20.SS0.SSS0.Px6.p1.m5" class="ltx_Math" alttext="\frac{1}{m}\sum_{i=1}^{m}P^{+}(a|x_{i})" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{m}\sum_{i=1}^{m}P^{+}(a|x_{i})</annotation></semantics></math>.
Although their difference can be shown to be small if <math id="S20.SS0.SSS0.Px6.p1.m6" class="ltx_Math" alttext="P^{+}(a|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(a|x)</annotation></semantics></math> is assumed to be smooth in <math id="S20.SS0.SSS0.Px6.p1.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, if <math id="S20.SS0.SSS0.Px6.p1.m8" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)</annotation></semantics></math> itself is very small, then a tiny estimation error of <math id="S20.SS0.SSS0.Px6.p1.m9" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)</annotation></semantics></math> will have a huge impact on <math id="S20.SS0.SSS0.Px6.p1.m10" class="ltx_Math" alttext="{k_{X}^{+}}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">{k_{X}^{+}}</annotation></semantics></math> because it is in the denominator.
For this reason, we also need to assume that <math id="S20.SS0.SSS0.Px6.p1.m11" class="ltx_Math" alttext="{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{P_{\mathcal{A}}}(a)</annotation></semantics></math> is bounded away from zero for all <math id="S20.SS0.SSS0.Px6.p1.m12" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, in order to get a reasonable generalization bound.
Such a bound was proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib167" title="" class="ltx_ref">167</a>]</cite>.</p>
</div>
<div id="S20.SS0.SSS0.Px6.p2" class="ltx_para ltx_noindent">
<p id="S20.SS0.SSS0.Px6.p2.1" class="ltx_p">The case with pair access to the context is even more challenging, because in this case we have to estimate <math id="S20.SS0.SSS0.Px6.p2.m1" class="ltx_Math" alttext="P^{+}(a|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}(a|x)</annotation></semantics></math>, so we need to consider the sample complexity of <math id="S20.SS0.SSS0.Px6.p2.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> as well.
Deriving a bound for this case is posed as an open problem.</p>
</div>
</section>
</section>
<section id="S21" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">21 </span>Spectrally Transformed Kernel Regression</h3>

<div id="S21.p1" class="ltx_para ltx_noindent">
<p id="S21.p1.1" class="ltx_p">The previous section showed that fitting the linear probe with ridge regression is equivalent to kernel ridge regression on a subspace of the induced RKHS, spanned by <math id="S21.p1.m1" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math>.
In fact, this is a special case of spectrally transformed kernel regression (STKR) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib168" title="" class="ltx_ref">168</a>]</cite>.</p>
</div>
<div id="chapter5.Thmtheorem15" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem15.2" class="ltx_text ltx_font_bold">Definition 5.15</span></span><span id="chapter5.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem15.p1" class="ltx_para">
<p id="chapter5.Thmtheorem15.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="chapter5.Thmtheorem15.p1.m1" class="ltx_Math" alttext="k:{\mathcal{X}}\times{\mathcal{X}}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">k:{\mathcal{X}}\times{\mathcal{X}}\rightarrow\mathbb{R}</annotation></semantics></math> be a p.s.d. kernel such that <math id="chapter5.Thmtheorem15.p1.m2" class="ltx_Math" alttext="k(x,x^{\prime})=\sum_{i=1}^{\infty}\lambda_{i}\mu_{i}(x)\mu_{i}(x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">k(x,x^{\prime})=\sum_{i=1}^{\infty}\lambda_{i}\mu_{i}(x)\mu_{i}(x^{\prime})</annotation></semantics></math>, where <math id="chapter5.Thmtheorem15.p1.m3" class="ltx_Math" alttext="\lambda_{1}\geq\lambda_{2}\geq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>λ</mi><mn>2</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}\geq\lambda_{2}\geq\cdots</annotation></semantics></math> and <math id="chapter5.Thmtheorem15.p1.m4" class="ltx_Math" alttext="\mu_{1},\mu_{2},\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\mu_{1},\mu_{2},\cdots</annotation></semantics></math> are the eigenvalues and eigenfunctions of <math id="chapter5.Thmtheorem15.p1.m5" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>.
Then, a <span id="chapter5.Thmtheorem15.p1.1.1.1" class="ltx_text ltx_font_bold">spectrally transformed kernel (STK)</span> of <math id="chapter5.Thmtheorem15.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is defined as <math id="chapter5.Thmtheorem15.p1.m7" class="ltx_Math" alttext="k_{s}(x,x^{\prime})=\sum_{i=1}^{\infty}s(\lambda_{i})\mu_{i}(x)\mu_{i}(x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">k_{s}(x,x^{\prime})=\sum_{i=1}^{\infty}s(\lambda_{i})\mu_{i}(x)\mu_{i}(x^{\prime})</annotation></semantics></math>, for some transformation function <math id="chapter5.Thmtheorem15.p1.m8" class="ltx_math_unparsed" alttext="s:[0,+\infty)\rightarrow[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s:[0,+\infty)\rightarrow[0,+\infty)</annotation></semantics></math> such that <math id="chapter5.Thmtheorem15.p1.m9" class="ltx_Math" alttext="s(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s(0)=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.p2" class="ltx_para ltx_noindent">
<p id="S21.p2.1" class="ltx_p">An STK has the same eigenfunctions as the original kernel.
In general one would like <math id="S21.p2.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> to be a monotonically non-decreasing function, so that the spectral transformation does not change the order of the eigenfunctions,</p>
</div>
<div id="chapter5.Thmtheorem16" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter5.Thmtheorem16.2" class="ltx_text ltx_font_bold">Example 5.16</span></span><span id="chapter5.Thmtheorem16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter5.Thmtheorem16.p1" class="ltx_para">
<p id="chapter5.Thmtheorem16.p1.1" class="ltx_p"><span id="chapter5.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">If <math id="chapter5.Thmtheorem16.p1.m1" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math> are obtained by kernel PCA described in the previous section, and the downstream linear probe is fit using ridge regression, then this process is equivalent to doing kernel ridge regression on an STK <math id="chapter5.Thmtheorem16.p1.m2" class="ltx_Math" alttext="k_{s}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>s</mi></msub><annotation encoding="application/x-tex">k_{s}</annotation></semantics></math>, where <math id="chapter5.Thmtheorem16.p1.m3" class="ltx_math_unparsed" alttext="s(\lambda_{i})=\lambda_{i}{\mathbb{I}}[i\leq d]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>λ</mi><mi>i</mi></msub><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>≤</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s(\lambda_{i})=\lambda_{i}{\mathbb{I}}[i\leq d]</annotation></semantics></math> is called the truncation function.</span></p>
</div>
</div>
<figure id="S21.F17" class="ltx_figure"><span class="ltx_inline-block"><svg id="S21.F17.pic1" class="ltx_picture ltx_centering" height="136.82" overflow="visible" version="1.1" viewBox="0 0 518.3 136.82" width="518.3"><g style="--ltx-stroke-color:#000000;" stroke="#000000" transform="translate(0,136.82) matrix(1 0 0 -1 0 0) translate(15.06,0) translate(0,43.03)"><g style="--ltx-fill-color:#999999;" fill="#999999" stroke-width="0.8pt"><path d="M 14.5 0 C 14.5 8.01 8.01 14.5 0 14.5 C -8.01 14.5 -14.5 8.01 -14.5 0 C -14.5 -8.01 -8.01 -14.5 0 -14.5 C 8.01 -14.5 14.5 -8.01 14.5 0 Z M 0 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -7.06 -1.94)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.F17.pic1.m1" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><g stroke-width="0.8pt"><path style="fill:none" d="M 38.12 39.37 C 38.12 47.38 31.63 53.87 23.62 53.87 C 15.61 53.87 9.12 47.38 9.12 39.37 C 9.12 31.36 15.61 24.87 23.62 24.87 C 31.63 24.87 38.12 31.36 38.12 39.37 Z M 23.62 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 16.56 37.43)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_fore