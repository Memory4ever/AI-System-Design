encoding="application/x-tex">0.04</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -31.79 9.81)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="26.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F21.pic1.m5" class="ltx_Math" alttext="0.06" display="inline" intent=":literal"><semantics><mn>0.06</mn><annotation encoding="application/x-tex">0.06</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -31.79 24.08)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="26.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F21.pic1.m6" class="ltx_Math" alttext="0.08" display="inline" intent=":literal"><semantics><mn>0.08</mn><annotation encoding="application/x-tex">0.08</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 38.35)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S25.F21.pic1.m7" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math></span></span