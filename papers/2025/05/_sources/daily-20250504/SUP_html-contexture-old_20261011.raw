ine" intent=":literal"><semantics><mn mathsize="0.800em">0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 43.82 -12.02)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="16.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m5" class="ltx_Math" alttext="0.8" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.8</mn><annotation encoding="application/x-tex">0.8</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -19.07 -0.51)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="17.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m6" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -19.07 14.76)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="17.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m7" class="ltx_Math" alttext="200" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">200</mn><annotation encoding="application/x-tex">200</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -19.07 30.03)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="17.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S19.F16.pic1.m8" class="ltx_Math" alttext="300" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">300</mn><annotation encoding="application/x-tex">300</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp42"><path d="M 0 0 L 52.31 0 L 52.31 42.75 L 0 42.75 Z"></path></clipPath><g clip-path="url(#pgfcp42)"><g fill-opacity="0.3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-opacity="0.3" stroke-width="1.6pt"><path style="fill:none" d="M 3.27 41.83 L 6.54 40.99 L 9.81 40.68 L 13.08 39.55 L 19.62 37.42 L 26.16 34.66 L 32.69 30.32 L 39.23 25.96 L 45.77 20.48 L 52.31 12.25"></path></g><g></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-width="0.6pt"><path style="fill:none" d="M 3.27 41.38 L 6.54 41.1 L 9.81 40.12 L 13.08 38.94 L 19.62 35.46 L 26.16 30.65 L 32.69 24.67 L 39.23 18.04 L 45.77 10.93 L 52.31 0.69"></path></g><g></g><g fill-opacity="0.7" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-opacity="0.7" stroke-width="1.6pt"><path style="fill:none" d="M 3.27 40.73 L 6.54 39.68 L 9.81 37.74 L 13.08 35.71 L 19.62 30.64 L 26.16 26.63 L 32.69 20.97 L 39.23 16.43 L 45.77 11.1 L 52.31 5.17"></path></g><g></g><g fill-opacity="0.6" stroke-dasharray="1.6pt,2.0pt" stroke-dashoffset="0.0pt" stroke-opacity="0.6" stroke-width="1.6pt"><path style="fill:none" d="M 3.27 41.3 L 6.54 40.27 L 9.81 39.21 L 13.08 37.08 L 19.62 33.99 L 