               <span id="alg3.l8.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l8.m1" class="ltx_Math" alttext="\|{\bm{u}}-{\bm{y}}\|_{2}&lt;\epsilon\|{\bm{y}}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝒖</mi><mo>−</mo><mi>𝒚</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝒚</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\bm{u}}-{\bm{y}}\|_{2}&lt;\epsilon\|{\bm{y}}\|_{2}</annotation></semantics></math> <span id="alg3.l8.4" class="ltx_text ltx_font_bold">then return</span> <math id="alg3.l8.m2" class="ltx_Math" alttext="\hat{{\bm{\alpha}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝜶</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{\alpha}}}</annotation></semantics></math>

</div>
