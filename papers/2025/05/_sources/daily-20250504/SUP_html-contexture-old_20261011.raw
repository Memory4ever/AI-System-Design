0.8pt"><path style="fill:none" d="M 14.28 -4.76 L 102.9 -34.3"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.94868 -0.31622 0.31622 0.94868 102.9 -34.3)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 50.21 -14.52)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.3" class="ltx_text">0.7</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 11.79 -9.36 C 41.28 -32.76 65.43 -40.81 102.08 -39.81"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.99963 0.02731 -0.02731 0.99963 102.08 -39.81)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 45.53 -47.81)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.4" class="ltx_text">0.5</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 132.39 34.61 L 221.01 5.07"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.94868 -0.31622 0.31622 0.94868 221.01 5.07)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 168.33 5.6)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.5" class="ltx_text">1.0</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 133.16 39.78 C 170.79 40.81 194.94 32.76 223.66 9.97"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.78333 -0.62161 0.62161 0.78333 223.66 9.97)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 173.01 38.9)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.6" class="ltx_text">0.6</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 115.5 24.54 C 112.17 5.69 112.17 -5.69 115.33 -23.58"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.17365 -0.98482 0.98482 0.17365 115.33 -23.58)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 90.16 -4.46)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.7" class="ltx_text">0.4</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 132.39 -34.61 L 221.01 -5.07"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.94868 0.31622 -0.31622 0.94868 221.01 -5.07)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 168.33 -14.52)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.8" class="ltx_text">1.0</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 120.72 -24.54 C 124.05 -5.69 124.05 5.69 120.9 23.58"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.17365 0.98482 -0.98482 -0.17365 120.9 23.58)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 128.38 -4.46)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.9" class="ltx_text">0.6</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 133.16 -39.78 C 170.79 -40.81 194.94 -32.76 223.66 -9.97"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.78333 0.62161 -0.62161 0.78333 223.66 -9.97)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 173.01 -47.81)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.10" class="ltx_text">0.4</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 229.86 13.65 C 193.02 92.64 43.2 92.64 6.78 14.54"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.42262 -0.90631 0.90631 -0.42262 6.78 14.54)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 109.27 78.05)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.11" class="ltx_text">1.0</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 229.86 -13.65 C 193.02 -92.64 43.2 -92.64 6.78 -14.54"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.42262 0.90631 -0.90631 -0.42262 6.78 -14.54)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 109.27 -86.97)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S14.F13.pic1.12" class="ltx_text">1.0</span></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 13: </span>An example of two contexts (solid and dashed edges) where <math id="S14.F13.m2" class="ltx_Math" alttext="|{\mathcal{X}}|=4" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{X}}|=4</annotation></semantics></math>.</figcaption>
</figure>
<div id="chapter4.p6" class="ltx_para ltx_noindent">
<p id="chapter4.p6.1" class="ltx_p">Convolution, denoted by <math id="chapter4.p6.m1" class="ltx_Math" alttext="\star" display="inline" intent=":literal"><semantics><mo>⋆</mo><annotation encoding="application/x-tex">\star</annotation></semantics></math>, is equivalent to a multi-step random walk.
<math id="chapter4.p6.m2" class="ltx_Math" alttext="P^{+}_{2}\star P^{+}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{2}\star P^{+}_{1}</annotation></semantics></math> means that we first walk one step on the solid edges (<math id="chapter4.p6.m3" class="ltx_Math" alttext="P^{+}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{1}</annotation></semantics></math>), and then walk one step on the dashed edges (<math id="chapter4.p6.m4" class="ltx_Math" alttext="P^{+}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{2}</annotation></semantics></math>).
For example, <math id="chapter4.p6.m5" class="ltx_Math" alttext="(P^{+}_{2}\star P^{+}_{1})(x_{4}|x_{1})=\sum_{x}P^{+}_{2}(x_{4}|x)P^{+}_{1}(x|x_{1})=0.6\times 0.3+0.4\times 0.7=0.46" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>x</mi></msub><mrow><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mn>0.6</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.3</mn></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.7</mn></mrow></mrow><mo>=</mo><mn>0.46</mn></mrow><annotation encoding="application/x-tex">(P^{+}_{2}\star P^{+}_{1})(x_{4}|x_{1})=\sum_{x}P^{+}_{2}(x_{4}|x)P^{+}_{1}(x|x_{1})=0.6\times 0.3+0.4\times 0.7=0.46</annotation></semantics></math>.
Similarly, <math id="chapter4.p6.m6" class="ltx_Math" alttext="P^{+}_{1}\star P^{+}_{2}\star P^{+}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{1}\star P^{+}_{2}\star P^{+}_{1}</annotation></semantics></math> is equivalent to a solid-dashed-solid random walk.
In general, convolution does not have the commutative property.</p>
</div>
<div id="chapter4.p7" class="ltx_para ltx_noindent">
<p id="chapter4.p7.1" class="ltx_p">Convex combination, denoted by <math id="chapter4.p7.m1" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math>, is equivalent to a stochastic one-step random walk.
<math id="chapter4.p7.m2" class="ltx_Math" alttext="0.6P^{+}_{1}+0.4P^{+}_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">0.6P^{+}_{1}+0.4P^{+}_{2}</annotation></semantics></math> means that we walk one step; with probability <math id="chapter4.p7.m3" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn>0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math> the step is on the solid edges, and with probability <math id="chapter4.p7.m4" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math> the step is on the dashed edges.
For example, if we are standing at <math id="chapter4.p7.m5" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>, then under <math id="chapter4.p7.m6" class="ltx_Math" alttext="0.6P^{+}_{1}+0.4P^{+}_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">0.6P^{+}_{1}+0.4P^{+}_{2}</annotation></semantics></math>, with probability <math id="chapter4.p7.m7" class="ltx_Math" alttext="0.6\times 0.3+0.4\times 0.5=0.38" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>0.6</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.3</mn></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.5</mn></mrow></mrow><mo>=</mo><mn>0.38</mn></mrow><annotation encoding="application/x-tex">0.6\times 0.3+0.4\times 0.5=0.38</annotation></semantics></math> we will walk to <math id="chapter4.p7.m8" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math>, and with probability <math id="chapter4.p7.m9" class="ltx_Math" alttext="0.62" display="inline" intent=":literal"><semantics><mn>0.62</mn><annotation encoding="application/x-tex">0.62</annotation></semantics></math> we will walk to <math id="chapter4.p7.m10" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math>.
Convex combination can be combined with convolution.
For example, <math id="chapter4.p7.m11" class="ltx_Math" alttext="P^{+}_{2}\star(0.6P^{+}_{1}+0.4P^{+}_{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}_{2}\star(0.6P^{+}_{1}+0.4P^{+}_{2})</annotation></semantics></math> means that we first take one step using <math id="chapter4.p7.m12" class="ltx_Math" alttext="0.6P^{+}_{1}+0.4P^{+}_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">0.6P^{+}_{1}+0.4P^{+}_{2}</annotation></semantics></math>, and then take another step using <math id="chapter4.p7.m13" class="ltx_Math" alttext="P^{+}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{2}</annotation></semantics></math>.</p>
</div>
<div id="chapter4.p8" class="ltx_para ltx_noindent">
<p id="chapter4.p8.1" class="ltx_p">We can show that the set of contexts forms a near-ring with scalar multiplication (also called a module), where convolution is multiplication and convex combination is addition with scalar multiplication.
“Near”-ring means that it only has the right distributive property but not the left one; that is, <math id="chapter4.p8.m1" class="ltx_Math" alttext="(0.6P^{+}_{1}+0.4P^{+}_{2})\star P^{+}_{2}=0.6P^{+}_{1}\star P^{+}_{2}+0.4P^{+}_{2}\star P^{+}_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow><mo>=</mo><mrow><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">⋆</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">(0.6P^{+}_{1}+0.4P^{+}_{2})\star P^{+}_{2}=0.6P^{+}_{1}\star P^{+}_{2}+0.4P^{+}_{2}\star P^{+}_{2}</annotation></semantics></math>, but <math id="chapter4.p8.m2" class="ltx_Math" alttext="P^{+}_{2}\star(0.6P^{+}_{1}+0.4P^{+}_{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋆</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>0.6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mn>0.4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>2</mn><mo>+</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{+}_{2}\star(0.6P^{+}_{1}+0.4P^{+}_{2})</annotation></semantics></math> is not distributive.</p>
</div>
<div id="chapter4.p9" class="ltx_para ltx_noindent">
<p id="chapter4.p9.1" class="ltx_p">There is a third operation for mixing multiple contexts called concatenation.
Concatenation is completely different from the other two operations, because convolution and convex combination act on the input space <math id="chapter4.p9.m1" class="ltx_Math" alttext="{\mathcal{X}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">{\mathcal{X}}</annotation></semantics></math>, whereas concatenation acts on the output space of the encoder.
Specifically, given <math id="chapter4.p9.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> contexts, one trains an individual encoder <math id="chapter4.p9.m3" class="ltx_Math" alttext="\Phi_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\Phi_{j}</annotation></semantics></math> for each context, and then concatenate them as <math id="chapter4.p9.m4" class="ltx_Math" alttext="\Phi(x)=[\Phi_{1}(x),\cdots,\Phi_{r}(x)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi(x)=[\Phi_{1}(x),\cdots,\Phi_{r}(x)]</annotation></semantics></math>.
Concatenation is a classical and very popular method, and it is connected to a whole field in data science known as feature engineering.
In feature engineering, people create different features based on different signals (formulated as contexts in this thesis), and then train a model on their concatenation.</p>
</div>
<div id="chapter4.p10" class="ltx_para ltx_noindent">
<p id="chapter4.p10.1" class="ltx_p">Mixture of experts (MOE) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib76" title="" class="ltx_ref">76</a>]</cite> is a popular method that is a stronger version of concatenation.
In MOE, we first train individual encoders <math id="chapter4.p10.m1" class="ltx_Math" alttext="\Phi_{1},\cdots,\Phi_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi mathvariant="normal">Φ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">\Phi_{1},\cdots,\Phi_{r}</annotation></semantics></math> for the <math id="chapter4.p10.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> contexts, and then at the downstream stage, we train a gating function <math id="chapter4.p10.m3" class="ltx_Math" alttext="g:{\mathcal{X}}\rightarrow\mathbb{R}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>r</mi></msup></mrow></mrow><annotation encoding="application/x-tex">g:{\mathcal{X}}\rightarrow\mathbb{R}^{r}</annotation></semantics></math> that assigns weights to the <math id="chapter4.p10.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> encoders for each <math id="chapter4.p10.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
The overall encoder is <math id="chapter4.p10.m6" class="ltx_Math" alttext="\Phi(x)=\sum_{j=1}^{r}g(x)_{j}\Phi_{j}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi(x)=\sum_{j=1}^{r}g(x)_{j}\Phi_{j}(x)</annotation></semantics></math>, and finally a linear probe is fit on top of <math id="chapter4.p10.m7" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>.
The common practice is to implement <math id="chapter4.p10.m8" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> as a small neural network, and its output space is usually restricted to <math id="chapter4.p10.m9" class="ltx_Math" alttext="\Delta^{r-1}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\Delta^{r-1}</annotation></semantics></math>, the <math id="chapter4.p10.m10" class="ltx_Math" alttext="(r-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r-1)</annotation></semantics></math>-dimensional unit simplex, so that <math id="chapter4.p10.m11" class="ltx_Math" alttext="g(x)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(x)</annotation></semantics></math> is a probability distribution over the <math id="chapter4.p10.m12" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> encoders.
This can be easily done by adding a softmax layer to the end of the neural network.
Concatenation is a special case of MOE, where <math id="chapter4.p10.m13" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is restricted to be a constant function.</p>
</div>
<div id="chapter4.p11" class="ltx_para ltx_noindent">
<p id="chapter4.p11.1" class="ltx_p">In what follows, we conduct a deep analysis on the three base operations for mixing multiple contexts: convolution, convex combination and concatenation.
Importantly, we discuss in what situations each operation should be used.
After that, we apply the three operations to real-world tabular datasets, and we find that they can improve the performance of state-of-the-art methods such as XGBoost <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite>.</p>
</div>
<section id="S15" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">15 </span>Convolution</h3>

<div id="S15.p1" class="ltx_para ltx_noindent">
<p id="S15.p1.1" class="ltx_p">Suppose we have <math id="S15.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> contexts given by <math id="S15.p1.m2" class="ltx_Math" alttext="P^{+}_{1},\cdots,P^{+}_{r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>P</mi><mi>r</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{1},\cdots,P^{+}_{r}</annotation></semantics></math>.
Let <math id="S15.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}_{j}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{j}</annotation></semantics></math> be the context space of <math id="S15.p1.m4" class="ltx_Math" alttext="P^{+}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>j</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{j}</annotation></semantics></math>,
and let <math id="S15.p1.m5" class="ltx_Math" alttext="Q^{+}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mi>j</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">Q^{+}_{j}</annotation></semantics></math> be the heuristic inverse of <math id="S15.p1.m6" class="ltx_Math" alttext="P^{+}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>j</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{j}</annotation></semantics></math> (<a href="#chapter1.Thmtheorem11" title="Definition 1.11. ‣ 4 Three Types of Access and Example Contexts ‣ Chapter 1 Introduction to the Contexture Theory ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">1.11</span></a>).
As mentioned earlier, convolution is similar to composing multiple data augmentation techniques.
Assuming that we have <math id="S15.p1.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to every context, we can transform <math id="S15.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by <math id="S15.p1.m9" class="ltx_Math" alttext="X\xrightarrow{P_{1}^{+}}A_{1}\xrightarrow{Q_{1}^{+}}X_{1}\xrightarrow{P_{2}^{+}}A_{2}\xrightarrow{Q_{2}^{+}}X_{2}\xrightarrow{P_{3}^{+}}\cdots\xrightarrow{Q_{r-1}^{+}}X_{r-1}\xrightarrow{P_{r}^{+}}A_{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mover accent="true"><mo>→</mo><msubsup><mi mathsize="0.700em">P</mi><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>A</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msubsup><mi mathsize="0.700em">Q</mi><mn mathsize="0.710em">1</mn><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>X</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msubsup><mi mathsize="0.700em">P</mi><mn mathsize="0.710em">2</mn><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>A</mi><mn>2</mn></msub><mover accent="true"><mo>→</mo><msubsup><mi mathsize="0.700em">Q</mi><mn mathsize="0.710em">2</mn><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>X</mi><mn>2</mn></msub><mover accent="true"><mo rspace="0.1389em">→</mo><msubsup><mi mathsize="0.700em">P</mi><mn mathsize="0.710em">3</mn><mo mathsize="0.710em">+</mo></msubsup></mover><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mover accent="true"><mo lspace="0.1389em">→</mo><msubsup><mi mathsize="0.700em">Q</mi><mrow><mi mathsize="0.710em">r</mi><mo mathsize="0.710em">−</mo><mn mathsize="0.710em">1</mn></mrow><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>X</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mover accent="true"><mo>→</mo><msubsup><mi mathsize="0.700em">P</mi><mi mathsize="0.710em">r</mi><mo mathsize="0.710em">+</mo></msubsup></mover><msub><mi>A</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">X\xrightarrow{P_{1}^{+}}A_{1}\xrightarrow{Q_{1}^{+}}X_{1}\xrightarrow{P_{2}^{+}}A_{2}\xrightarrow{Q_{2}^{+}}X_{2}\xrightarrow{P_{3}^{+}}\cdots\xrightarrow{Q_{r-1}^{+}}X_{r-1}\xrightarrow{P_{r}^{+}}A_{r}</annotation></semantics></math>.
This <math id="S15.p1.m10" class="ltx_Math" alttext="A_{r}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>r</mi></msub><annotation encoding="application/x-tex">A_{r}</annotation></semantics></math> is defined as the context variable of the convolution <math id="S15.p1.m11" class="ltx_math_unparsed" alttext="P_{r}^{+}\star\cdots\star P_{1}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi>r</mi></msub><msup><mrow></mrow><mo>+</mo></msup><mo lspace="0.222em">⋆</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⋆</mo><mi>P</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">P_{r}^{+}\star\cdots\star P_{1}^{+}</annotation></semantics></math>.
The heuristic inverse of <math id="S15.p1.m12" class="ltx_math_unparsed" alttext="P_{r}^{+}\star\cdots\star P_{1}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi>r</mi></msub><msup><mrow></mrow><mo>+</mo></msup><mo lspace="0.222em">⋆</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⋆</mo><mi>P</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">P_{r}^{+}\star\cdots\star P_{1}^{+}</annotation></semantics></math> is defined as <math id="S15.p1.m13" class="ltx_Math" alttext="Q_{r}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mi>r</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">Q_{r}^{+}</annotation></semantics></math>.
Then, it is easy to see that convolution has the associative property.</p>
</div>
<div id="S15.p2" class="ltx_para ltx_noindent">
<p id="S15.p2.1" class="ltx_p">In the general case, we might not have <math id="S15.p2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to all contexts, but we can assume that each context has either <math id="S15.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access or <math id="S15.p2.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access.
This is a weak assumption since it has been shown previously that any access can be converted to <math id="S15.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access.</p>
</div>
<div id="S15.p3" class="ltx_para ltx_noindent">
<p id="S15.p3.1" class="ltx_p">For every <math id="S15.p3.m1" class="ltx_Math" alttext="j\in[r]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[r]</annotation></semantics></math>, define a kernel <math id="S15.p3.m2" class="ltx_Math" alttext="k_{j}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>j</mi></msub><annotation encoding="application/x-tex">k_{j}</annotation></semantics></math> as follows:</p>
<ul id="S15.I1" class="ltx_itemize">
<li id="S15.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S15.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I1.i1.p1.1" class="ltx_p">If it has <math id="S15.I1.i1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access, let <math id="S15.I1.i1.p1.m2" class="ltx_Math" alttext="k_{j}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>j</mi></msub><annotation encoding="application/x-tex">k_{j}</annotation></semantics></math> be the kernel we have access to.</p>
</div></li>
<li id="S15.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S15.I1.i2.p1" class="ltx_para">
<p id="S15.I1.i2.p1.1" class="ltx_p">If it has <math id="S15.I1.i2.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access, let <math id="S15.I1.i2.p1.m2" class="ltx_Math" alttext="k_{j}(x,x^{\prime})=\int Q_{j}^{+}(x^{\prime}|a)dP_{j}^{+}(a|x)/{P_{\mathcal{X}}}(x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>j</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mi>j</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">k_{j}(x,x^{\prime})=\int Q_{j}^{+}(x^{\prime}|a)dP_{j}^{+}(a|x)/{P_{\mathcal{X}}}(x^{\prime})</annotation></semantics></math> if <math id="S15.I1.i2.p1.m3" class="ltx_Math" alttext="j&lt;r" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">j&lt;r</annotation></semantics></math>.
If <math id="S15.I1.i2.p1.m4" class="ltx_Math" alttext="j=r" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">j=r</annotation></semantics></math>, then define <math id="S15.I1.i2.p1.m5" class="ltx_Math" alttext="k_{r}={k_{X}^{+}}_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>r</mi></msub><mo>=</mo><mmultiscripts><mi>k</mi><mi>X</mi><mo>+</mo><mi>r</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">k_{r}={k_{X}^{+}}_{r}</annotation></semantics></math> as the exact dual kernel of context <math id="S15.I1.i2.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="chapter4.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 4.1</span></span><span id="chapter4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter4.Thmtheorem1.p1" class="ltx_para">
<p id="chapter4.Thmtheorem1.p1.1" class="ltx_p"><span id="chapter4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The integral operator of the dual kernel of the convolution of the <math id="chapter4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> contexts is equal to <math id="chapter4.Thmtheorem1.p1.m2" class="ltx_math_unparsed" alttext="T_{k_{1}}T_{k_{2}}\cdots T_{k_{r}}\cdots T_{k_{2}}T_{k_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mn>1</mn></msub></msub><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mn>2</mn></msub></msub><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">T_{k_{1}}T_{k_{2}}\cdots T_{k_{r}}\cdots T_{k_{2}}T_{k_{1}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="chapter4.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="chapter4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Remark 4.2</span></span><span id="chapter4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="chapter4.Thmtheorem2.p1" class="ltx_para">
<p id="chapter4.Thmtheorem2.p1.1" class="ltx_p"><span id="chapter4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">When each <math id="chapter4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="T_{k_{j}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">T_{k_{j}}</annotation></semantics></math> is a bounded compact self-adjoint operator, this operator is also bounded compact self-adjoint, so the Hilbert-Schmidt theorem still applies.
Note that this operator is not equal to <math id="chapter4.Thmtheorem2.p1.m2" class="ltx_math_unparsed" alttext="T_{k_{r}}\cdots T_{k_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>T</mi><msub><mrow></mrow><msub><mi>k</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">T_{k_{r}}\cdots T_{k_{1}}</annotation></semantics></math>, which is not necessarily a self-adjoint operator.</span></p>
</div>
</div>
<div id="S15.p4" class="ltx_para ltx_noindent">
<p id="S15.p4.1" class="ltx_p"><span id="S15.p4.1.1" class="ltx_text ltx_font_bold">Proof </span>
We prove by induction on <math id="S15.p4.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. When <math id="S15.p4.m2" class="ltx_Math" alttext="r=1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r=1</annotation></semantics></math> this is obvious. Suppose the result holds for <math id="S15.p4.m3" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math>. Let <math id="S15.p4.m4" class="ltx_Math" alttext="k_{j}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>j</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">k_{j}^{+}</annotation></semantics></math> be the dual kernel between <math id="S15.p4.m5" class="ltx_Math" alttext="X_{1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>1</mn></msub><annotation encoding="application/x-tex">X_{1}</annotation></semantics></math> and <math id="S15.p4.m6" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math>. Then, we have</p>
<table id="S15.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex34.m1" class="ltx_Math" alttext="k_{r}^{+}(x,x^{\prime})=\iint k_{1}(x,z)k_{r-1}^{+}(z,z^{\prime})k_{1}(z^{\prime},x^{\prime})d{P_{\mathcal{X}}}(z)d{P_{\mathcal{X}}}(z^{\prime})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>k</mi><mi>r</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mo>′</mo></msup><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">k_{r}^{+}(x,x^{\prime})=\iint k_{1}(x,z)k_{r-1}^{+}(z,z^{\prime})k_{1}(z^{\prime},x^{\prime})d{P_{\mathcal{X}}}(z)d{P_{\mathcal{X}}}(z^{\prime}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.p4.2" class="ltx_p">so it is easy to see that <math id="S15.p4.m7" class="ltx_Math" alttext="T_{k_{r}^{+}}=T_{k_{1}}T_{k_{r-1}^{+}}T_{k_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>r</mi><mo>+</mo></msubsup></msub><mo>=</mo><mrow><msub><mi>T</mi><msub><mi>k</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msubsup><mi>k</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msub><mi>k</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">T_{k_{r}^{+}}=T_{k_{1}}T_{k_{r-1}^{+}}T_{k_{1}}</annotation></semantics></math>, which shows that the result holds for <math id="S15.p4.m8" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>.
 <span class="ltx_rule" style="width:6.5pt;height:6.5pt;--ltx-bg-color:black;display:inline-block;"> </span>
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></p>
</div>
<div id="S15.p5" class="ltx_para ltx_noindent">
<p id="S15.p5.1" class="ltx_p">We now discuss how to learn the contexture of a convolution.
If we have <math id="S15.p5.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to every context, then we can simply transform <math id="S15.p5.m2" class="ltx_Math" alttext="X\rightarrow A_{r}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>A</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">X\rightarrow A_{r}</annotation></semantics></math>, and use SVME on <math id="S15.p5.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S15.p5.m4" class="ltx_Math" alttext="A_{r}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>r</mi></msub><annotation encoding="application/x-tex">A_{r}</annotation></semantics></math>.
If we have <math id="S15.p5.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to <math id="S15.p5.m6" class="ltx_Math" alttext="P^{+}_{1},\cdots,P^{+}_{r-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>P</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{1},\cdots,P^{+}_{r-1}</annotation></semantics></math> but <math id="S15.p5.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access to <math id="S15.p5.m8" class="ltx_Math" alttext="P^{+}_{r}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>r</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P^{+}_{r}</annotation></semantics></math>, then it is also very simple.
We can transform <math id="S15.p5.m9" class="ltx_Math" alttext="X\rightarrow X_{r-1}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">→</mo><msub><mi>X</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X\rightarrow X_{r-1}</annotation></semantics></math>, and use KISE on <math id="S15.p5.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S15.p5.m11" class="ltx_Math" alttext="X_{r-1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">X_{r-1}</annotation></semantics></math>.</p>
</div>
<div id="S15.p6" class="ltx_para ltx_noindent">
<p id="S15.p6.1" class="ltx_p">The more difficult scenario is when we have <math id="S15.p6.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access to <math id="S15.p6.m2" class="ltx_Math" alttext="P_{j}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>j</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P_{j}^{+}</annotation></semantics></math> for some <math id="S15.p6.m3" class="ltx_Math" alttext="j&lt;r" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">j&lt;r</annotation></semantics></math>.
Let <math id="S15.p6.m4" class="ltx_Math" alttext="j_{1}&lt;j_{2}&lt;\cdots&lt;j_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>j</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>j</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">j_{1}&lt;j_{2}&lt;\cdots&lt;j_{l}</annotation></semantics></math> be all such <math id="S15.p6.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>.
We now present an algorithm that learns the contexture.
First, initialize <math id="S15.p6.m6" class="ltx_Math" alttext="\Phi^{0}=\Phi" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mn>0</mn></msup><mo>=</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\Phi^{0}=\Phi</annotation></semantics></math>, and <math id="S15.p6.m7" class="ltx_Math" alttext="X_{0}=X" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>=</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">X_{0}=X</annotation></semantics></math>.
Second, transform <math id="S15.p6.m8" class="ltx_Math" alttext="X_{0}\rightarrow X_{j_{1}-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">→</mo><msub><mi>X</mi><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X_{0}\rightarrow X_{j_{1}-1}</annotation></semantics></math> using the <math id="S15.p6.m9" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to <math id="S15.p6.m10" class="ltx_Math" alttext="P^{+}_{1},\cdots,P^{+}_{j_{1}-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mo>+</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>P</mi><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{1},\cdots,P^{+}_{j_{1}-1}</annotation></semantics></math>.
Third, let <math id="S15.p6.m11" class="ltx_Math" alttext="\Phi^{1}(X)=(T_{k_{j_{1}}}\Phi^{0})(X_{j_{1}-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><msub><mi>k</mi><msub><mi>j</mi><mn>1</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mn>0</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{1}(X)=(T_{k_{j_{1}}}\Phi^{0})(X_{j_{1}-1})</annotation></semantics></math>, which can be estimated with Monte Carlo using the <math id="S15.p6.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access to <math id="S15.p6.m13" class="ltx_Math" alttext="k_{j_{1}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><msub><mi>j</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">k_{j_{1}}</annotation></semantics></math>.
Fourth, let <math id="S15.p6.m14" class="ltx_Math" alttext="X_{j_{1}}=X" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><msub><mi>j</mi><mn>1</mn></msub></msub><mo>=</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">X_{j_{1}}=X</annotation></semantics></math>, and transform <math id="S15.p6.m15" class="ltx_Math" alttext="X_{j_{1}}\rightarrow X_{j_{2}-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><msub><mi>j</mi><mn>1</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>X</mi><mrow><msub><mi>j</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X_{j_{1}}\rightarrow X_{j_{2}-1}</annotation></semantics></math> using the <math id="S15.p6.m16" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to <math id="S15.p6.m17" class="ltx_Math" alttext="P^{+}_{j_{1}+1},\cdots,P^{+}_{j_{2}-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>+</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>P</mi><mrow><msub><mi>j</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">P^{+}_{j_{1}+1},\cdots,P^{+}_{j_{2}-1}</annotation></semantics></math>.
Fifth, let <math id="S15.p6.m18" class="ltx_Math" alttext="\Phi^{2}(X)=(T_{k_{j_{2}}}\Phi^{1})(X_{j_{2}-1})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><msub><mi>k</mi><msub><mi>j</mi><mn>2</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mn>1</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><msub><mi>j</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{2}(X)=(T_{k_{j_{2}}}\Phi^{1})(X_{j_{2}-1})</annotation></semantics></math>.
Repeat these two steps until we get <math id="S15.p6.m19" class="ltx_Math" alttext="\Phi^{l}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>l</mi></msup><annotation encoding="application/x-tex">\Phi^{l}</annotation></semantics></math>, and transform <math id="S15.p6.m20" class="ltx_Math" alttext="X_{j_{l}}\rightarrow X_{r-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><msub><mi>j</mi><mi>l</mi></msub></msub><mo stretchy="false">→</mo><msub><mi>X</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X_{j_{l}}\rightarrow X_{r-1}</annotation></semantics></math>.
Finally, the learning objective is SVME if we have <math id="S15.p6.m21" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to <math id="S15.p6.m22" class="ltx_Math" alttext="P_{r}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>r</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P_{r}^{+}</annotation></semantics></math>, or KISE if we have <math id="S15.p6.m23" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-access to <math id="S15.p6.m24" class="ltx_Math" alttext="P_{r}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>r</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">P_{r}^{+}</annotation></semantics></math>.</p>
</div>
<div id="S15.p7" class="ltx_para ltx_noindent">
<p id="S15.p7.1" class="ltx_p">The detailed algorithm is listed in <a href="#alg1" title="In 15 Convolution ‣ Chapter 4 Mixing Multiple Contexts ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>.
One can prove that for any <math id="S15.p7.m1" class="ltx_Math" alttext="t\in[0,l]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>l</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,l]</annotation></semantics></math> and any <math id="S15.p7.m2" class="ltx_Math" alttext="j\in[j_{t},j_{t+1}-1]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>j</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>j</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[j_{t},j_{t+1}-1]</annotation></semantics></math>, <math id="S15.p7.m3" class="ltx_Math" alttext="\Phi^{t}(X_{j})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{t}(X_{j})</annotation></semantics></math> has the same distribution as <math id="S15.p7.m4" class="ltx_math_unparsed" alttext="(T_{k_{j}}T_{k_{j-1}}\cdots T_{k_{1}}\Phi)(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><msub><mi>k</mi><mi>j</mi></msub></msub><msub><mi>T</mi><msub><mi>k</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>T</mi><msub><mi>k</mi><mn>1</mn></msub></msub><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(T_{k_{j}}T_{k_{j-1}}\cdots T_{k_{1}}\Phi)(X)</annotation></semantics></math>.
Hence, <math id="S15.p7.m5" class="ltx_Math" alttext="\Phi^{l}(X_{r-1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{l}(X_{r-1})</annotation></semantics></math> has the same distribution as <math id="S15.p7.m6" class="ltx_math_unparsed" alttext="(T_{k_{r-1}}T_{k_{j-1}}\cdots T_{k_{1}}\Phi)(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><msub><mi>k</mi><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><msub><mi>T</mi><msub><mi>k</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>T</mi><msub><mi>k</mi><mn>1</mn></msub></msub><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(T_{k_{r-1}}T_{k_{j-1}}\cdots T_{k_{1}}\Phi)(X)</annotation></semantics></math>.
By <a href="#chapter2.Thmtheorem11" title="Theorem 2.11 (Proof in ). ‣ 7 General Objectives: SVME and KISE ‣ Chapter 2 Learning the Contexture with Variational Objectives ‣ Contextures: The Mechanism of Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2.11</span></a>, this algorithm extracts the top-<math id="S15.p7.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace of the operator.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Extracting top-<math id="alg1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenspace of a convolution of contexts</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Initialize encoder <math id="alg1.l1.m1" class="ltx_Math" alttext="\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>; If have <math id="alg1.l1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-access to context <math id="alg1.l1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, initialize <math id="alg1.l1.m4" class="ltx_Math" alttext="\Psi:{\mathcal{A}}_{r}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>r</mi></msub><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Psi:{\mathcal{A}}_{r}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> each training step <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
             Sample a batch of samples <math id="alg1.l3.m1" class="ltx_Math" alttext="{\left\{x_{1},\cdots,x_{m}\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo>}</mo></mrow><annotation encoding="application/x-tex">{\left\{x_{1},\cdots,x_{m}\right\}}</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
             Center <math id="alg1.l4.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>: <math id="alg1.l4.m2" class="ltx_Math" alttext="\Phi\leftarrow\Phi-\frac{1}{m}\sum_{i=1}^{m}\Phi(x_{i})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo stretchy="false">←</mo><mrow><mi mathvariant="normal">Φ</mi><mo>−</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi\leftarrow\Phi-\frac{1}{m}\sum_{i=1}^{m}\Phi(x_{i})</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
             <span id="alg1.l5.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="i\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m]</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">do</span> <math id="alg1.l5.m2" class="ltx_Math" alttext="x_{i}^{0}\leftarrow x_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">←</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">x_{i}^{0}\leftarrow x_{i}</annotation></semantics></math>; set <math id="alg1.l5.m3" class="ltx_Math" alttext="{\bm{B}}\leftarrow{\bm{0}}\in\mathbb{R}^{d\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{B}}\leftarrow{\bm{0}}\in\mathbb{R}^{d\times m}</annotation></semantics></math>, <math id="alg1.l5.m4" class="ltx_Math" alttext="k\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">k\leftarrow</annotation></semantics></math> <span id="alg1.l5.5" class="ltx_text ltx_font_bold">null</span>

</div>
