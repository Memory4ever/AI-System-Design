               <math id="alg1.l28.m1" class="ltx_Math" alttext="SP\leftarrow SP\cup S_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo>∪</mo><msub><mi>S</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">SP\leftarrow SP\cup S_{i}</annotation></semantics></math>

</div>
