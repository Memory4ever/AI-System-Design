               <math id="alg1.l26.m1" class="ltx_Math" alttext="P_{i}^{r}\leftarrow\{p\in D_{i}\mid\text{ClusterOf}(p)=\text{ClusterOf}(t_{r})\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>i</mi><mi>r</mi></msubsup><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mi>p</mi><mo>∈</mo><msub><mi>D</mi><mi>i</mi></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mtext>ClusterOf</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>ClusterOf</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P_{i}^{r}\leftarrow\{p\in D_{i}\mid\text{ClusterOf}(p)=\text{ClusterOf}(t_{r})\}</annotation></semantics></math>

</div>
<div id="alg1.l27" class="ltx_listingline">
