<th id="S5.T2.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_tt" colspan="6"><span id="S5.T2.5.1.1.2.1" class="ltx_text ltx_font_bold">Influencers Dataset</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.5.1.2" class="ltx_tr">
<th id="S5.T2.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T2.5.1.2.1.1" class="ltx_text ltx_font_bold">Folder</span></th>
<th id="S5.T2.5.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T2.5.1.2.2.1" class="ltx_text ltx_font_bold">Provider</span></th>
<td id="S5.T2.5.1.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T2.5.1.2.3.1" class="ltx_text ltx_font_bold">Hashtags</span></td>
<td id="S5.T2.5.1.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T2.5.1.2.4.1" class="ltx_text ltx_font_bold">Mentions</span></td>
<td id="S5.T2.5.1.2.5" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T2.5.1.2.5.1" class="ltx_text ltx_font_bold">URLs</span></td>
