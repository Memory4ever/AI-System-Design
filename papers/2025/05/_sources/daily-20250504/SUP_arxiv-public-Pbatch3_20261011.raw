  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2505.01790">arXiv:2505.01790</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.01790">pdf</a>, <a href="https://arxiv.org/ps/2505.01790">ps</a>, <a href="https://arxiv.org/format/2505.01790">other</a>]&nbsp;</span>
