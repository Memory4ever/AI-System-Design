    <p class="title is-5 mathjax">
      
        PosePilot: Steering Camera Pose for Generative World Models with Self-supervised Depth
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Jin%2C+B">Bu Jin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+W">Weize Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+B">Baihan Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhu%2C+Z">Zhenxin Zhu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jiang%2C+J">Junpeng Jiang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gao%2C+H">Huan-ang Gao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+H">Haiyang Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhan%2C+K">Kun Zhan</a>, 
      
