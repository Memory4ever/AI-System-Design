  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2505.01761">arXiv:2505.01761</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.01761">pdf</a>, <a href="https://arxiv.org/ps/2505.01761">ps</a>, <a href="https://arxiv.org/format/2505.01761">other</a>]&nbsp;</span>
