<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex82.m1" class="ltx_Math" alttext="\displaystyle\leq\sup_{x_{3}\in{\mathcal{X}}}\sum_{i&gt;0}s_{i}^{2}\mu_{i}(x_{3})\sup_{x_{1},x_{2}\in{\mathcal{X}}}\frac{|\mu_{i}(x_{1})-\mu_{i}(x_{2})|}{{\left\|x_{1}-x_{2}\right\|}_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mn>0</mn></mrow></munder></mstyle><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{x_{3}\in{\mathcal{X}}}\sum_{i&gt;0}s_{i}^{2}\mu_{i}(x_{3})\sup_{x_{1},x_{2}\in{\mathcal{X}}}\frac{|\mu_{i}(x_{1})-\mu_{i}(x_{2})|}{{\left\|x_{1}-x_{2}\right\|}_{2}}</annotation></semantics></math></td>
