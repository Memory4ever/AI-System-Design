<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38Xb.m2" class="ltx_Math" alttext="\displaystyle=\int{\left\langle\int\tilde{\Psi}(a)P^{+}(a|x)dy,\int\tilde{\Psi}(a^{+})P^{+}(a^{+}|x)da^{+}\right\rangle}p(x)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mo lspace="0em">∫</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo rspace="0em">,</mo><mrow><mo>∫</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>+</mo></msup></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle\int\tilde{\Psi}(a)P^{+}(a|x)dy,\int\tilde{\Psi}(a^{+})P^{+}(a^{+}|x)da^{+}\right\rangle}p(x)dx</annotation></semantics></math></td>
