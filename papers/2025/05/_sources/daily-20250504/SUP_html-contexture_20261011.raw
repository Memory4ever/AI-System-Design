1 0 0 -1 0 8.03)" width="12.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.24" class="ltx_text" style="font-size:90%;">16</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 216.49 -21.64)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="12.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.25" class="ltx_text" style="font-size:90%;">32</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 260.12 -21.64)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="12.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.26" class="ltx_text" style="font-size:90%;">64</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 301.5 -26.16)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="19.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.27" class="ltx_text" style="font-size:90%;">100</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 345.13 -26.16)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="19.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.28" class="ltx_text" style="font-size:90%;">150</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7071 0.7071 -0.7071 0.7071 388.77 -26.16)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="19.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.29" class="ltx_text" style="font-size:90%;">200</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 19.15)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F1.pic1.m5" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn>0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 66.36)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F1.pic1.m6" class="ltx_Math" alttext="0.7" 