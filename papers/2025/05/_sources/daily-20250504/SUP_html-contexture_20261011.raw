<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex84.m1" class="ltx_Math" alttext="\displaystyle\leq\sup_{x_{3}\in{\mathcal{X}}}cL_{\mu}\sum_{i&gt;0}s_{i}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mn>0</mn></mrow></munder></mstyle><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{x_{3}\in{\mathcal{X}}}cL_{\mu}\sum_{i&gt;0}s_{i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
