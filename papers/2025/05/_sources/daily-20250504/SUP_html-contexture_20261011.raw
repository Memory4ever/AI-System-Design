<tbody id="A1.Ex38Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38Xc.m2" class="ltx_Math" alttext="\displaystyle=\int{\left\langle T_{P^{+}}\tilde{\Psi}(x),T_{P^{+}}\tilde{\Psi}(x)\right\rangle}p(x)dx=\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle T_{P^{+}}\tilde{\Psi}(x),T_{P^{+}}\tilde{\Psi}(x)\right\rangle}p(x)dx=\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex38Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i}s_{i}^{2}b_{ii};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i}s_{i}^{2}b_{ii};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i1.p2.2" class="ltx_p">and</p>
<table id="A1.Ex39" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex39X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex39X.m2" class="ltx_Math" alttext="\displaystyle\underset{A,A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mrow><msup><mi mathsize="0.700em">A</mi><mo mathsize="0.710em">−</mo></msup><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{A,A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39X.m3" class="ltx_Math" alttext="\displaystyle=\iint{\left[\sum_{i=1}^{d}\tilde{\psi}_{i}(a)\tilde{\psi}_{i}(a^{-})\right]}^{2}d{P_{\mathcal{A}}}(a)d{P_{\mathcal{A}}}(a^{-})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iint{\left[\sum_{i=1}^{d}\tilde{\psi}_{i}(a)\tilde{\psi}_{i}(a^{-})\right]}^{2}d{P_{\mathcal{A}}}(a)d{P_{\mathcal{A}}}(a^{-})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex39Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{1\leq i,j\leq d}{\left[\int\tilde{\psi}_{i}(a)\tilde{\psi}_{j}(a)d{P_{\mathcal{A}}}(a)\right]}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≤</mo><mi>d</mi></mrow></mrow></munder></mstyle><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{1\leq i,j\leq d}{\left[\int\tilde{\psi}_{i}(a)\tilde{\psi}_{j}(a)d{P_{\mathcal{A}}}(a)\right]}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex39Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}b_{ij}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><msubsup><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}b_{ij}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i1.p2.3" class="ltx_p">Thus, we have</p>
<table id="A1.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex40.m1" class="ltx_math_unparsed" alttext="{\mathcal{L}}_{\rm{C}}(\Psi)=-\sum_{i}s_{i}^{2}b_{ii}+\frac{1}{2}\sum_{i,j}b_{ij}^{2}\\
=\|{\bm{B}}-{\bm{D}}\|_{F}^{2}-\|{\bm{D}}\|_{F}^{2}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>C</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝑩</mi><mo>−</mo><mi>𝑫</mi><msubsup><mo lspace="0em" rspace="0em">∥</mo><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝑫</mi><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mi>F</mi><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{C}}(\Psi)=-\sum_{i}s_{i}^{2}b_{ii}+\frac{1}{2}\sum_{i,j}b_{ij}^{2}\\
=\|{\bm{B}}-{\bm{D}}\|_{F}^{2}-\|{\bm{D}}\|_{F}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i1.p2.4" class="ltx_p">So if suffices to minimize <math id="A1.I1.i1.p2.m6" class="ltx_Math" alttext="\|{\bm{B}}-{\bm{D}}\|_{F}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑩</mi><mo>−</mo><mi>𝑫</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|{\bm{B}}-{\bm{D}}\|_{F}^{2}</annotation></semantics></math> where <math id="A1.I1.i1.p2.m7" class="ltx_Math" alttext="\text{rank}({\bm{B}})\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>rank</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\text{rank}({\bm{B}})\leq d</annotation></semantics></math>. By Eckart-Young-Mirsky Theorem, we know the minimizer of <math id="A1.I1.i1.p2.m8" class="ltx_Math" alttext="{\bm{B}}" display="inline" intent=":literal"><semantics><mi>𝑩</mi><annotation encoding="application/x-tex">{\bm{B}}</annotation></semantics></math> is <math id="A1.I1.i1.p2.m9" class="ltx_Math" alttext="{\bm{B}}^{*}=\text{diag}(s_{1}^{2},\cdots,s_{d}^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑩</mi><mo>∗</mo></msup><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}^{*}=\text{diag}(s_{1}^{2},\cdots,s_{d}^{2})</annotation></semantics></math>. Thus, the minimizer of <math id="A1.I1.i1.p2.m10" class="ltx_Math" alttext="{\bm{C}}" display="inline" intent=":literal"><semantics><mi>𝑪</mi><annotation encoding="application/x-tex">{\bm{C}}</annotation></semantics></math> should be <math id="A1.I1.i1.p2.m11" class="ltx_Math" alttext="{\bm{C}}^{*}={\bm{U}}{\textnormal{diag}}(s_{1},\cdots,s_{d})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑪</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>s</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}^{*}={\bm{U}}{\textnormal{diag}}(s_{1},\cdots,s_{d})</annotation></semantics></math> where <math id="A1.I1.i1.p2.m12" class="ltx_Math" alttext="{\bm{U}}\in{\mathbb{R}}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{U}}\in{\mathbb{R}}^{d\times d}</annotation></semantics></math> is an orthonormal matrix. This indicates the minimizer <math id="A1.I1.i1.p2.m13" class="ltx_Math" alttext="\tilde{\Psi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Psi}^{*}</annotation></semantics></math> extracts the top-<math id="A1.I1.i1.p2.m14" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions of <math id="A1.I1.i1.p2.m15" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, and <math id="A1.I1.i1.p2.m16" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="A1.I1.i1.p2.m17" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p">The non-contrastive loss is</p>
<table id="A1.Ex41" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex41X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41X.m2" class="ltx_Math" alttext="\displaystyle{\displaystyle\mathcal{L}}_{\rm{N}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]};" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\mathcal{L}}_{\rm{N}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex41Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41Xa.m2" class="ltx_Math" alttext="\displaystyle{\displaystyle\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\|\Psi(A)-\Psi(A^{+})\right\|}_{2}^{2}\right]}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\|\Psi(A)-\Psi(A^{+})\right\|}_{2}^{2}\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i2.p1.2" class="ltx_p">where <math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi mathvariant="normal">Ψ</mi><mo>]</mo></mrow></mrow><mo>=</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">\mathrm{Cov}_{{P_{\mathcal{A}}}}{\left[\Psi\right]}={\bm{I}}</annotation></semantics></math>. Since for any <math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>,</p>
<table id="A1.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)-{\mathcal{L}}_{N}(\Psi)=2\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\|\tilde{\Psi}(A)\right\|}_{2}^{2}\right]}=2d" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)-{\mathcal{L}}_{N}(\Psi)=2\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\|\tilde{\Psi}(A)\right\|}_{2}^{2}\right]}=2d</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i2.p1.3" class="ltx_p">is a constant, thus <math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="\Psi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Psi^{*}</annotation></semantics></math> minimizes <math id="A1.I1.i2.p1.m4" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)\iff\Psi^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⇔</mo><msup><mi mathvariant="normal">Ψ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)\iff\Psi^{*}</annotation></semantics></math> minimizes <math id="A1.I1.i2.p1.m5" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}^{\prime}(\Psi)</annotation></semantics></math>.</p>
</div>
<div id="A1.I1.i2.p2" class="ltx_para">
<p id="A1.I1.i2.p2.1" class="ltx_p">Suppose <math id="A1.I1.i2.p2.m1" class="ltx_Math" alttext="\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}</annotation></semantics></math> where <math id="A1.I1.i2.p2.m2" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="A1.I1.i2.p2.m3" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> in <a href="#Thmtheorem4" title="Lemma 4. ‣ 2.2 Induced Kernels and Expectation Operator ‣ 2 Definitions and Examples ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4</span></a>. Since <math id="A1.I1.i2.p2.m4" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ν</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}</annotation></semantics></math>, we can get <math id="A1.I1.i2.p2.m5" class="ltx_Math" alttext="\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}</annotation></semantics></math>.</p>
</div>
<div id="A1.I1.i2.p3" class="ltx_para">
<p id="A1.I1.i2.p3.1" class="ltx_p">We now consider the minimizer of <math id="A1.I1.i2.p3.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)</annotation></semantics></math>. By the calculation in (i), we obtain</p>
<table id="A1.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex43.m1" class="ltx_math_unparsed" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)=-\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}=-\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}=-\sum_{i}s_{i}^{2}b_{ii}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mrow><mo>⟨</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow><mo>]</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)=-\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}=-\|T_{P^{+}}\tilde{\Psi}\|^{2}_{{P_{\mathcal{X}}}}=-\sum_{i}s_{i}^{2}b_{ii}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i2.p3.2" class="ltx_p">By <math id="A1.I1.i2.p3.m2" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}{\left[\tilde{\psi}_{i}\tilde{\psi}_{j}\right]}=\delta_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}{\left[\tilde{\psi}_{i}\tilde{\psi}_{j}\right]}=\delta_{ij}</annotation></semantics></math>, we have</p>
<table id="A1.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex44.m1" class="ltx_Math" alttext="\sum_{i}b_{ii}=\sum_{i,j}c_{ij}^{2}=d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow><mo>=</mo><mi>d</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i}b_{ii}=\sum_{i,j}c_{ij}^{2}=d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i2.p3.3" class="ltx_p">Since <math id="A1.I1.i2.p3.m3" class="ltx_Math" alttext="\nu_{i}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\nu_{i}</annotation></semantics></math> is an ONB of <math id="A1.I1.i2.p3.m4" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math>, <math id="A1.I1.i2.p3.m5" class="ltx_Math" alttext="\tilde{\psi}_{1},\cdots,\tilde{\psi}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{1},\cdots,\tilde{\psi}_{d}</annotation></semantics></math> are orthogonal, we have</p>
<table id="A1.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E6.m1" class="ltx_Math" alttext="b_{ii}=\sum_{j=1}^{d}c_{ji}^{2}=\sum_{j=1}^{d}{\left\langle\tilde{\psi}_{j},\nu_{i}\right\rangle}_{{P_{\mathcal{A}}}}^{2}\leq\|\nu_{i}\|_{{P_{\mathcal{A}}}}^{2}=1." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>c</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>j</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>ν</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b_{ii}=\sum_{j=1}^{d}c_{ji}^{2}=\sum_{j=1}^{d}{\left\langle\tilde{\psi}_{j},\nu_{i}\right\rangle}_{{P_{\mathcal{A}}}}^{2}\leq\|\nu_{i}\|_{{P_{\mathcal{A}}}}^{2}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="A1.I1.i2.p3.4" class="ltx_p">Thus, we conclude that</p>
<table id="A1.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex45.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)+\sum_{i=1}^{d}s_{i}^{2}=\sum_{i=1}^{d}s_{i}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{i}^{2}b_{ii}\geq\sum_{i=1}^{d}s_{d}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{d}^{2}b_{ii}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>d</mi></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>d</mi></mrow></munder><mrow><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)+\sum_{i=1}^{d}s_{i}^{2}=\sum_{i=1}^{d}s_{i}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{i}^{2}b_{ii}\geq\sum_{i=1}^{d}s_{d}^{2}(1-b_{ii})-\sum_{i&gt;d}s_{d}^{2}b_{ii}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i2.p3.5" class="ltx_p">which implies that <math id="A1.I1.i2.p3.m6" class="ltx_math_unparsed" alttext="{\mathcal{L}}_{\rm{N}}(\Psi)\geq-\sum_{i=1}^{d}s_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">≥</mo><mo lspace="0em" rspace="0.055em">−</mo><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}(\Psi)\geq-\sum_{i=1}^{d}s_{i}^{2}</annotation></semantics></math>. To attain equality, we will have <math id="A1.I1.i2.p3.m7" class="ltx_Math" alttext="b_{ii}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">b_{ii}=1</annotation></semantics></math> for <math id="A1.I1.i2.p3.m8" class="ltx_Math" alttext="i=1,\cdots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i=1,\cdots,d</annotation></semantics></math>, and <math id="A1.I1.i2.p3.m9" class="ltx_Math" alttext="b_{ii}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b_{ii}=0</annotation></semantics></math> for <math id="A1.I1.i2.p3.m10" class="ltx_Math" alttext="i\geq d+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\geq d+1</annotation></semantics></math>. By <a href="#A1.E6" title="In Item (ii) ‣ Proof. ‣ Theorem . ‣ A.4 Proof of Theorem ‣ Appendix A Proofs for Section ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">6</span></a>, we can know <math id="A1.I1.i2.p3.m11" class="ltx_Math" alttext="\Psi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Psi^{*}</annotation></semantics></math> extracts the span of <math id="A1.I1.i2.p3.m12" class="ltx_Math" alttext="\nu_{1},\cdots,\nu_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ν</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\nu_{1},\cdots,\nu_{d}</annotation></semantics></math>, indicating that <math id="A1.I1.i2.p3.m13" class="ltx_Math" alttext="\tilde{\Psi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Psi}^{*}</annotation></semantics></math> extracts the top-<math id="A1.I1.i2.p3.m14" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions of <math id="A1.I1.i2.p3.m15" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> and <math id="A1.I1.i2.p3.m16" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="A1.I1.i2.p3.m17" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A1.SS4.SSS0.Px1.p2.2" class="ltx_p"><span id="A1.SS4.SSS0.Px1.p2.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof of Theorem <a href="#Thmtheorem12" title="Theorem 12 (Proof in ). ‣ 3.3 Node Representation Learning: Graph Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a></h3>

<section id="A1.SS5.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem <a href="#Thmtheorem12" title="Theorem 12 (Proof in ). ‣ 3.3 Node Representation Learning: Graph Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>.</h5>

<div id="A1.SS5.SSS0.Px1.p1" class="ltx_para">
<p id="A1.SS5.SSS0.Px1.p1.1" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> be any solution to <a href="#S3.E3" title="In 3.3 Node Representation Learning: Graph Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">3</span></a> (so that for any constant <math id="A1.SS5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, <math id="A1.SS5.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\Phi^{*}+c" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo>+</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\Phi^{*}+c</annotation></semantics></math> is also a solution).
Then, <math id="A1.SS5.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> learns the contexture of <math id="A1.SS5.SSS0.Px1.p1.m5" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS5.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.SSS0.Px1.p2" class="ltx_para">
<p id="A1.SS5.SSS0.Px1.p2.1" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.1.1" class="ltx_text">Without loss of generality, suppose <math id="A1.SS5.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\bar{\Phi}={\bm{0}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>¯</mo></mover><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\bar{\Phi}={\bm{0}}</annotation></semantics></math>.
We have</span></p>
<table id="A1.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex46.m1" class="ltx_Math" alttext="{\left(T_{P^{+}}f\right)}(u)=\sum_{v}f(v)\frac{w(u,v)}{d(u)};\quad{\left\langle T_{P^{+}}f,g\right\rangle}_{{P_{\mathcal{X}}}}=\sum_{u,v}f(u)g(v)\frac{w(u,v)}{d_{\textrm{sum}}}={\left\langle f,T_{P^{+}}g\right\rangle}_{{P_{\mathcal{X}}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>v</mi></munder><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo rspace="1.167em">;</mo><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>g</mi></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>d</mi><mtext>sum</mtext></msub></mfrac></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mi>f</mi><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left(T_{P^{+}}f\right)}(u)=\sum_{v}f(v)\frac{w(u,v)}{d(u)};\quad{\left\langle T_{P^{+}}f,g\right\rangle}_{{P_{\mathcal{X}}}}=\sum_{u,v}f(u)g(v)\frac{w(u,v)}{d_{\textrm{sum}}}={\left\langle f,T_{P^{+}}g\right\rangle}_{{P_{\mathcal{X}}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p2.2" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p2.2.1" class="ltx_text">which implies that <math id="A1.SS5.SSS0.Px1.p2.m2" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> is self-adjoint.
Therefore, the eigenfunctions of <math id="A1.SS5.SSS0.Px1.p2.m3" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math> are the same as those of <math id="A1.SS5.SSS0.Px1.p2.m4" class="ltx_Math" alttext="T_{P^{+}}^{*}T_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">T_{P^{+}}^{*}T_{P^{+}}</annotation></semantics></math>, with square root eigenvalues.</span></p>
</div>
<div id="A1.SS5.SSS0.Px1.p3" class="ltx_para">
<p id="A1.SS5.SSS0.Px1.p3.1" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p3.1.1" class="ltx_text">For the objective of <a href="#S3.E3" title="In 3.3 Node Representation Learning: Graph Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">3</span></a>, we have</span></p>
<table id="A1.Ex47" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex47X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex47X.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\mathbb{E}_{(u,v)\sim P_{w}}{\left[{\left\|\Phi(u)-\Phi(v)\right\|}_{2}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>P</mi><mi>w</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\mathbb{E}_{(u,v)\sim P_{w}}{\left[{\left\|\Phi(u)-\Phi(v)\right\|}_{2}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47X.m3" class="ltx_Math" alttext="\displaystyle=\underset{(u,v)\sim P_{w}}{\mathbb{E}}{\left[{\left\|\Phi(u)\right\|}_{2}^{2}-{\left\langle\Phi(u),\Phi(v)\right\rangle}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">u</mi><mo>,</mo><mi mathsize="0.700em">v</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi mathsize="0.710em">w</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{(u,v)\sim P_{w}}{\mathbb{E}}{\left[{\left\|\Phi(u)\right\|}_{2}^{2}-{\left\langle\Phi(u),\Phi(v)\right\rangle}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex47Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{d}{\left({\left\|\phi_{i}\right\|}_{P_{\mathcal{X}}}^{2}-{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>(</mo><mrow><msubsup><mrow><mo>‖</mo><msub><mi>ϕ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>−</mo><msub><mrow><mo>⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{d}{\left({\left\|\phi_{i}\right\|}_{P_{\mathcal{X}}}^{2}-{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex47Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47Xb.m2" class="ltx_Math" alttext="\displaystyle=d-\sum_{i=1}^{d}{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>d</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msub><mrow><mo>⟨</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=d-\sum_{i=1}^{d}{\left\langle\phi_{i},T_{P^{+}}\phi_{i}\right\rangle}_{P_{\mathcal{X}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.SSS0.Px1.p3.2" class="ltx_p"><span id="A1.SS5.SSS0.Px1.p3.2.1" class="ltx_text">Note that <math id="A1.SS5.SSS0.Px1.p3.m1" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math> and <math id="A1.SS5.SSS0.Px1.p3.m2" class="ltx_Math" alttext="(v,u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,u)</annotation></semantics></math> can be drawn from <math id="A1.SS5.SSS0.Px1.p3.m3" class="ltx_Math" alttext="P_{w}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>w</mi></msub><annotation encoding="application/x-tex">P_{w}</annotation></semantics></math> with equal probability.
We conclude that <math id="A1.SS5.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> extracts the top-<math id="A1.SS5.SSS0.Px1.p3.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="A1.SS5.SSS0.Px1.p3.m6" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, which are the same as the top-<math id="A1.SS5.SSS0.Px1.p3.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="A1.SS5.SSS0.Px1.p3.m8" class="ltx_Math" alttext="T_{P^{+}}^{*}T_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">T_{P^{+}}^{*}T_{P^{+}}</annotation></semantics></math>, or the top-<math id="A1.SS5.SSS0.Px1.p3.m9" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions of <math id="A1.SS5.SSS0.Px1.p3.m10" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>. This implies that <math id="A1.SS5.SSS0.Px1.p3.m11" class="ltx_Math" alttext="\tilde{\Phi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Phi}</annotation></semantics></math> learns the contexture of <math id="A1.SS5.SSS0.Px1.p3.m12" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proofs for Section <a href="#S4" title="4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a></h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Proof of Theorem <a href="#Thmtheorem14" title="Theorem 14 (Proof in ). ‣ 4.1 Compatibility ‣ 4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a></h3>

<section id="A2.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem <a href="#Thmtheorem14" title="Theorem 14 (Proof in ). ‣ 4.1 Compatibility ‣ 4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>.</h5>

<div id="A2.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px1.p1.1" class="ltx_p"><span id="A2.SS1.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="A2.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>, there exists a <math id="A2.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="g^{*}\in{L^{2}(P_{\mathcal{A}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{*}\in{L^{2}(P_{\mathcal{A}})}</annotation></semantics></math> such that <math id="A2.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="f^{*}(x)=\mathbb{E}{\left[g^{*}(A)\;\middle|\;x\right]}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">|</mo><mi>x</mi><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}(x)=\mathbb{E}{\left[g^{*}(A)\;\middle|\;x\right]}</annotation></semantics></math>, and <math id="A2.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="g^{*}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">g^{*}</annotation></semantics></math> satisfies</span></p>
<table id="A2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E7.m1" class="ltx_Math" alttext="\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{\prime}\sim P^{+}{\left(\cdot\;\middle|\;X\right)}}{\mathbb{E}}{\left[{\left(g^{*}(A)-g^{*}(A^{\prime})\right)}^{2}\right]}\leq 4\epsilon{\left\|g^{*}\right\|}_{{P_{\mathcal{A}}}}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0.280em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">′</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo>(</mo><mo lspace="0em" mathsize="0.700em" rspace="0.224em">⋅</mo><mo stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo>)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msup><mi>g</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{\prime}\sim P^{+}{\left(\cdot\;\middle|\;X\right)}}{\mathbb{E}}{\left[{\left(g^{*}(A)-g^{*}(A^{\prime})\right)}^{2}\right]}\leq 4\epsilon{\left\|g^{*}\right\|}_{{P_{\mathcal{A}}}}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="A2.SS1.SSS0.Px1.p2.1" class="ltx_p"><span id="A2.SS1.SSS0.Px1.p2.1.1" class="ltx_text">Let <math id="A2.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="g^{*}=\sum s_{i}u_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{*}=\sum s_{i}u_{i}\nu_{i}</annotation></semantics></math>. We have already explained that if <math id="A2.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math>, i.e., <math id="A2.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\mathbb{E}[f^{*}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[f^{*}]=0</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\rho(f^{*},P^{+})\geq 1-{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\rho(f^{*},P^{+})\geq 1-{\epsilon}</annotation></semantics></math>, then it must satisfy the condition </span><span id="A2.SS1.SSS0.Px1.p2.1.2" class="ltx_text ltx_font_italic">w.r.t.</span><span id="A2.SS1.SSS0.Px1.p2.1.3" class="ltx_text"> <math id="A2.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="g^{*}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">g^{*}</annotation></semantics></math>:</span></p>
<table id="A2.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\frac{{\left\langle f^{*},T_{P^{+}}g^{*}\right\rangle}_{{P_{\mathcal{X}}}}}{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}{\left\|g^{*}\right\|}_{{P_{\mathcal{A}}}}}\geq 1-{\epsilon}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msub><mrow><mo>⟨</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>,</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mrow><msub><mrow><mo>‖</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>g</mi><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub></mrow></mfrac><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{{\left\langle f^{*},T_{P^{+}}g^{*}\right\rangle}_{{P_{\mathcal{X}}}}}{{\left\|f^{*}\right\|}_{{P_{\mathcal{X}}}}{\left\|g^{*}\right\|}_{{P_{\mathcal{A}}}}}\geq 1-{\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p2.2" class="ltx_p"><span id="A2.SS1.SSS0.Px1.p2.2.1" class="ltx_text">For <a href="#A2.E7" title="In Theorem . ‣ B.1 Proof of Theorem ‣ Appendix B Proofs for Section ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a>, we have <math id="A2.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="P(A^{\prime}|A=a)=\int P^{+}(A^{\prime}|X=x)P^{+}(x|A^{\prime}=a)dx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>X</mi><mo>=</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>A</mi><mo>′</mo></msup><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P(A^{\prime}|A=a)=\int P^{+}(A^{\prime}|X=x)P^{+}(x|A^{\prime}=a)dx</annotation></semantics></math>, where <math id="A2.SS1.SSS0.Px1.p2.m7" class="ltx_Math" alttext="P^{+}(x|a)=\frac{P^{+}(a|x){P_{\mathcal{X}}}(x)}{{P_{\mathcal{A}}}(a)}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P^{+}(x|a)=\frac{P^{+}(a|x){P_{\mathcal{X}}}(x)}{{P_{\mathcal{A}}}(a)}</annotation></semantics></math> by Bayes rule.
Then, using <a href="#Thmtheorem1" title="Definition 1. ‣ 2.2 Induced Kernels and Expectation Operator ‣ 2 Definitions and Examples ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">1</span></a> we have <math id="A2.SS1.SSS0.Px1.p2.m8" class="ltx_Math" alttext="P(A^{\prime}|A=a)={k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(A^{\prime}|A=a)={k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})</annotation></semantics></math>, which implies that</span></p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{A,A^{\prime}\sim P^{+}(\cdot|X)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}\mathbb{E}_{A^{\prime}\sim P(\cdot|A)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>,</mo><mi>A</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>P</mi><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><msub><mi>𝔼</mi><mrow><mi>A</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>P</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><msup><mi>g</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{X\sim{P_{\mathcal{X}}}}\mathbb{E}_{A,A^{\prime}\sim P^{+}(\cdot|X)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}\mathbb{E}_{A^{\prime}\sim P(\cdot|A)}{\left[g^{*}(A)g^{*}(A^{\prime})\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex50.m1" class="ltx_Math" alttext="\displaystyle=\;" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime})P(a^{\prime}|A)da^{\prime}\right]}=\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime}){k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})da^{\prime}\right]}={\left\langle g^{*},T_{{k_{A}^{+}}}g^{*}\right\rangle}_{P_{\mathcal{A}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>′</mo></msup></mrow></mrow></mstyle></mrow><mo>]</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>,</mo><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime})P(a^{\prime}|A)da^{\prime}\right]}=\mathbb{E}_{A}{\left[g^{*}(A)\int g^{*}(a^{\prime}){k_{A}^{+}}(a,a^{\prime}){P_{\mathcal{A}}}(a^{\prime})da^{\prime}\right]}={\left\langle g^{*},T_{{k_{A}^{+}}}g^{*}\right\rangle}_{P_{\mathcal{A}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p2.3" class="ltx_p"><span id="A2.SS1.SSS0.Px1.p2.3.1" class="ltx_text">Since <math id="A2.SS1.SSS0.Px1.p2.m9" class="ltx_Math" alttext="T_{{k_{A}^{+}}}g^{*}=T_{P^{+}}^{*}T_{P^{+}}g^{*}=\sum s_{i}^{3}u_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>∗</mo></msup></mrow><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{{k_{A}^{+}}}g^{*}=T_{P^{+}}^{*}T_{P^{+}}g^{*}=\sum s_{i}^{3}u_{i}\nu_{i}</annotation></semantics></math>, <a href="#A2.E7" title="In Theorem . ‣ B.1 Proof of Theorem ‣ Appendix B Proofs for Section ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a> is equivalent to <math id="A2.SS1.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\sum(s_{i}^{2}-s_{i}^{4})u_{i}^{2}\leq 2\epsilon\sum s_{i}^{2}u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mi>i</mi><mn>4</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum(s_{i}^{2}-s_{i}^{4})u_{i}^{2}\leq 2\epsilon\sum s_{i}^{2}u_{i}^{2}</annotation></semantics></math>.
Meanwhile, we have <math id="A2.SS1.SSS0.Px1.p2.m11" class="ltx_Math" alttext="\sum s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum u_{i}^{2}\geq(1-2\epsilon)\sum u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum u_{i}^{2}\geq(1-2\epsilon)\sum u_{i}^{2}</annotation></semantics></math>. By Cauchy-Schwarz inequality, we have <math id="A2.SS1.SSS0.Px1.p2.m12" class="ltx_Math" alttext="(\sum s_{i}^{4}u_{i}^{2})(\sum u_{i}^{2})\geq(\sum s_{i}^{2}u_{i}^{2})^{2}\geq(1-2\epsilon)(\sum u_{i}^{2})(\sum s_{i}^{2}u_{i}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\sum s_{i}^{4}u_{i}^{2})(\sum u_{i}^{2})\geq(\sum s_{i}^{2}u_{i}^{2})^{2}\geq(1-2\epsilon)(\sum u_{i}^{2})(\sum s_{i}^{2}u_{i}^{2})</annotation></semantics></math>, which proves <a href="#A2.E7" title="In Theorem . ‣ B.1 Proof of Theorem ‣ Appendix B Proofs for Section ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Proof of Theorem <a href="#Thmtheorem16" title="Theorem 16 (Proof in ). ‣ 4.1 Compatibility ‣ 4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a></h3>

<section id="A2.SS2.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem <a href="#Thmtheorem16" title="Theorem 16 (Proof in ). ‣ 4.1 Compatibility ‣ 4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>.</h5>

<div id="A2.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p1.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A2.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="1-s_{1}\leq{\epsilon}\leq 1-\sqrt{\frac{s_{1}^{2}+s_{2}^{2}}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>s</mi><mn>1</mn></msub></mrow><mo>≤</mo><mi>ϵ</mi><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msqrt><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">1-s_{1}\leq{\epsilon}\leq 1-\sqrt{\frac{s_{1}^{2}+s_{2}^{2}}{2}}</annotation></semantics></math>.
For any <math id="A2.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, among all <math id="A2.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\Phi=[\phi_{1},\cdots,\phi_{d}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi=[\phi_{1},\cdots,\phi_{d}]</annotation></semantics></math> where <math id="A2.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\phi_{i}\in{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}\in{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> minimizes <math id="A2.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))" display="inline" intent=":literal"><semantics><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))</annotation></semantics></math> if and only if it learns the contexture of <math id="A2.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>. The error is given by</span></p>
<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_math_unparsed" alttext="\min_{\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d},\;\phi_{i}\in{L^{2}(P_{\mathcal{X}})}}\;\textnormal{err}{\left(\Phi;{\mathcal{F}}_{\epsilon}(P^{+})\right)}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}." display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><mtext>err</mtext><mrow><mo>(</mo><mi mathvariant="normal">Φ</mi><mo>;</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{\Phi:{\mathcal{X}}\rightarrow\mathbb{R}^{d},\;\phi_{i}\in{L^{2}(P_{\mathcal{X}})}}\;\textnormal{err}{\left(\Phi;{\mathcal{F}}_{\epsilon}(P^{+})\right)}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p1.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p1.2.1" class="ltx_text ltx_font_italic">Conversely, for any <math id="A2.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional encoder <math id="A2.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> and any <math id="A2.SS2.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, there exists <math id="A2.SS2.SSS0.Px1.p1.m11" class="ltx_Math" alttext="f\in{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math> such that <math id="A2.SS2.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\rho(f,P^{+})=1-\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\rho(f,P^{+})=1-\epsilon</annotation></semantics></math>, and <math id="A2.SS2.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\textnormal{err}(\Phi,f)\geq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\textnormal{err}(\Phi,f)\geq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.SSS0.Px1.p2" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p2.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p2.1.1" class="ltx_text ltx_font_bold">Necessity:<span id="A2.SS2.SSS0.Px1.p2.1.1.1" class="ltx_text ltx_font_medium"> Since <math id="A2.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math> is at most rank-<math id="A2.SS2.SSS0.Px1.p2.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, thus there exists <math id="A2.SS2.SSS0.Px1.p2.m3" class="ltx_Math" alttext="f_{1}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math> with <math id="A2.SS2.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\|f_{1}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{1}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math> that is orthogonal to <math id="A2.SS2.SSS0.Px1.p2.m5" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math>. Thus, there exists <math id="A2.SS2.SSS0.Px1.p2.m6" class="ltx_Math" alttext="f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math> with <math id="A2.SS2.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\|f_{1}\|_{P_{\mathcal{X}}}=\|f_{2}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{1}\|_{P_{\mathcal{X}}}=\|f_{2}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p2.m8" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is orthogonal to <math id="A2.SS2.SSS0.Px1.p2.m9" class="ltx_Math" alttext="{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\Phi)</annotation></semantics></math> and <math id="A2.SS2.SSS0.Px1.p2.m10" class="ltx_Math" alttext="f_{2}\in{\textnormal{span}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{2}\in{\textnormal{span}}(\Phi)</annotation></semantics></math> (thus <math id="A2.SS2.SSS0.Px1.p2.m11" class="ltx_Math" alttext="f_{1}\perp f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>⟂</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{1}\perp f_{2}</annotation></semantics></math>), and <math id="A2.SS2.SSS0.Px1.p2.m12" class="ltx_Math" alttext="\mu_{1}\in{\textnormal{span}}\{f_{1},f_{2}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{1}\in{\textnormal{span}}\{f_{1},f_{2}\}</annotation></semantics></math>.
Suppose <math id="A2.SS2.SSS0.Px1.p2.m13" class="ltx_Math" alttext="\mu_{1}=\alpha_{1}f_{1}+\alpha_{2}f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{1}=\alpha_{1}f_{1}+\alpha_{2}f_{2}</annotation></semantics></math> (without loss of generosity, assuming <math id="A2.SS2.SSS0.Px1.p2.m14" class="ltx_Math" alttext="\alpha_{1},\alpha_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2}\in[0,1]</annotation></semantics></math>) and denote <math id="A2.SS2.SSS0.Px1.p2.m15" class="ltx_Math" alttext="f_{0}=\alpha_{2}f_{1}-\alpha_{1}f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}=\alpha_{2}f_{1}-\alpha_{1}f_{2}</annotation></semantics></math>. Then <math id="A2.SS2.SSS0.Px1.p2.m16" class="ltx_Math" alttext="\|f_{0}\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f_{0}\|_{P_{\mathcal{X}}}=1</annotation></semantics></math> and <math id="A2.SS2.SSS0.Px1.p2.m17" class="ltx_Math" alttext="\langle\mu_{1},f_{0}\rangle_{P_{\mathcal{X}}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle\mu_{1},f_{0}\rangle_{P_{\mathcal{X}}}=0</annotation></semantics></math>. Since <math id="A2.SS2.SSS0.Px1.p2.m18" class="ltx_Math" alttext="f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},f_{2}\in{\textnormal{span}}\{\mu_{1},\cdots,\mu_{d+1}\}</annotation></semantics></math>, we have <math id="A2.SS2.SSS0.Px1.p2.m19" class="ltx_Math" alttext="f_{0}\in{\textnormal{span}}\{\mu_{2},\cdots,\mu_{d+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>∈</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}\in{\textnormal{span}}\{\mu_{2},\cdots,\mu_{d+1}\}</annotation></semantics></math> and thus <math id="A2.SS2.SSS0.Px1.p2.m20" class="ltx_Math" alttext="\mathbb{E}[f_{0}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[f_{0}]=0</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p3.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p3.1.1" class="ltx_text">Consider <math id="A2.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}f_{0}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}f_{0}</annotation></semantics></math> where <math id="A2.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\beta_{1}^{2}+\beta_{2}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{1}^{2}+\beta_{2}^{2}=1</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\beta_{1},\beta_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}\in[0,1]</annotation></semantics></math>.
Denote <math id="A2.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="f=\sum_{i\geq 1}u_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum_{i\geq 1}u_{i}\mu_{i}</annotation></semantics></math>, we can get <math id="A2.SS2.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\sum_{i}u_{i}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}u_{i}^{2}=1</annotation></semantics></math> and</span></p>
<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_Math" alttext="\beta_{2}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\implies\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})\beta_{2}^{2}\geq(1-{\epsilon})^{2}\sum_{i}u_{i}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo rspace="0.111em" stretchy="false">⟹</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\beta_{2}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\implies\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})\beta_{2}^{2}\geq(1-{\epsilon})^{2}\sum_{i}u_{i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p3.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p3.2.1" class="ltx_text">Obviously, <math id="A2.SS2.SSS0.Px1.p3.m6" class="ltx_Math" alttext="f\in{\mathcal{F}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{\mathcal{F}}(P^{+})</annotation></semantics></math>. We have</span></p>
<table id="A2.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex53.m1" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}f_{0}=\beta_{1}(\alpha_{1}f_{1}+\alpha_{2}f_{2})+\beta_{2}(\alpha_{2}f_{1}-\alpha_{1}f_{2})=(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})f_{1}+(\alpha_{2}\beta_{1}-\alpha_{1}\beta_{2})f_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}f_{0}=\beta_{1}(\alpha_{1}f_{1}+\alpha_{2}f_{2})+\beta_{2}(\alpha_{2}f_{1}-\alpha_{1}f_{2})=(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})f_{1}+(\alpha_{2}\beta_{1}-\alpha_{1}\beta_{2})f_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p3.3" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p3.3.1" class="ltx_text">By the definition of <math id="A2.SS2.SSS0.Px1.p3.m7" class="ltx_Math" alttext="f_{1},f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{1},f_{2}</annotation></semantics></math> we can know the approximation error for <math id="A2.SS2.SSS0.Px1.p3.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is <math id="A2.SS2.SSS0.Px1.p3.m9" class="ltx_Math" alttext="(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}</annotation></semantics></math>.
We can show <math id="A2.SS2.SSS0.Px1.p3.m10" class="ltx_Math" alttext="F(\alpha_{1})=\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2}=\alpha_{1}\beta_{1}+\sqrt{1-\alpha_{1}^{2}}\beta_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mn>1</mn><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\alpha_{1})=\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2}=\alpha_{1}\beta_{1}+\sqrt{1-\alpha_{1}^{2}}\beta_{2}</annotation></semantics></math> (<math id="A2.SS2.SSS0.Px1.p3.m11" class="ltx_Math" alttext="\alpha_{1}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1}\in[0,1]</annotation></semantics></math>) first increases then decreases when <math id="A2.SS2.SSS0.Px1.p3.m12" class="ltx_Math" alttext="\beta_{1},\beta_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}\in[0,1]</annotation></semantics></math>. Thus <math id="A2.SS2.SSS0.Px1.p3.m13" class="ltx_Math" alttext="F(\alpha_{1})^{2}\geq\min\{F(0)^{2},F(1)^{2}\}=\min\{\beta_{1}^{2},\beta_{2}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\alpha_{1})^{2}\geq\min\{F(0)^{2},F(1)^{2}\}=\min\{\beta_{1}^{2},\beta_{2}^{2}\}</annotation></semantics></math>.
Take <math id="A2.SS2.SSS0.Px1.p3.m14" class="ltx_Math" alttext="\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\leq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}\leq\frac{1}{2}</annotation></semantics></math>, we can get for <math id="A2.SS2.SSS0.Px1.p3.m15" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, the approximation error is always at least <math id="A2.SS2.SSS0.Px1.p3.m16" class="ltx_Math" alttext="\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><annotation encoding="application/x-tex">\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS0.Px1.p4" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p4.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p4.1.1" class="ltx_text">To attain equality, we must have <math id="A2.SS2.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}=s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}=s_{1}^{2}\beta_{1}^{2}+s_{d+1}^{2}\beta_{2}^{2}</annotation></semantics></math>. This implies that <math id="A2.SS2.SSS0.Px1.p4.m2" class="ltx_Math" alttext="f_{1}=\mu_{d+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">f_{1}=\mu_{d+1}</annotation></semantics></math>, indicating that <math id="A2.SS2.SSS0.Px1.p4.m3" class="ltx_Math" alttext="{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})</annotation></semantics></math>. Thus <math id="A2.SS2.SSS0.Px1.p4.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture of <math id="A2.SS2.SSS0.Px1.p4.m5" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS0.Px1.p5" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p5.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p5.1.1" class="ltx_text">Furthermore, denote <math id="A2.SS2.SSS0.Px1.p5.m1" class="ltx_Math" alttext="f_{0}=k_{2}\mu_{2}+\cdots+k_{d+1}\mu_{d+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><msub><mi>k</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi>k</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}=k_{2}\mu_{2}+\cdots+k_{d+1}\mu_{d+1}</annotation></semantics></math> and consider <math id="A2.SS2.SSS0.Px1.p5.m2" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}f_{0}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}f_{0}</annotation></semantics></math> where <math id="A2.SS2.SSS0.Px1.p5.m3" class="ltx_Math" alttext="\beta_{1}^{2}+\beta_{2}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta_{1}^{2}+\beta_{2}^{2}=1</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p5.m4" class="ltx_Math" alttext="\beta_{1},\beta_{2}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}\in[0,1]</annotation></semantics></math>. By the definition of <math id="A2.SS2.SSS0.Px1.p5.m5" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="A2.SS2.SSS0.Px1.p5.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, we have <math id="A2.SS2.SSS0.Px1.p5.m7" class="ltx_Math" alttext="\|f\|_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>f</mi><mo stretchy="false">‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|f\|_{P_{\mathcal{X}}}=1</annotation></semantics></math> and <math id="A2.SS2.SSS0.Px1.p5.m8" class="ltx_Math" alttext="f=\beta_{1}\mu_{1}+\beta_{2}\mu_{2}=\beta_{1}\mu_{1}+\beta_{2}k_{2}\mu_{2}+\cdots+\beta_{2}k_{d+1}\mu_{d+1}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mn>2</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\beta_{1}\mu_{1}+\beta_{2}\mu_{2}=\beta_{1}\mu_{1}+\beta_{2}k_{2}\mu_{2}+\cdots+\beta_{2}k_{d+1}\mu_{d+1}</annotation></semantics></math>.
Thus</span></p>
<table id="A2.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\rho^{2}(f,P^{+})=s_{1}^{2}\beta_{1}^{2}+\beta_{2}^{2}\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}=s_{1}^{2}-\left(s_{1}^{2}-\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)\beta_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho^{2}(f,P^{+})=s_{1}^{2}\beta_{1}^{2}+\beta_{2}^{2}\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}=s_{1}^{2}-\left(s_{1}^{2}-\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)\beta_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p5.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p5.2.1" class="ltx_text">Take</span></p>
<table id="A2.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-\left(\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{2}^{2}}\leq\frac{s_{1}^{2}-\frac{s_{1}^{2}+s_{2}^{2}}{2}}{s_{1}^{2}-s_{2}^{2}}=\frac{1}{2}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mfrac><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mfrac><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-\left(\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{2}^{2}}\leq\frac{s_{1}^{2}-\frac{s_{1}^{2}+s_{2}^{2}}{2}}{s_{1}^{2}-s_{2}^{2}}=\frac{1}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p5.3" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p5.3.1" class="ltx_text">we have <math id="A2.SS2.SSS0.Px1.p5.m9" class="ltx_Math" alttext="\rho(f,P^{+})=1-{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\rho(f,P^{+})=1-{\epsilon}</annotation></semantics></math>.
Similarly, the approximation error for <math id="A2.SS2.SSS0.Px1.p5.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is</span></p>
<table id="A2.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex56.m1" class="ltx_Math" alttext="(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}\geq\min\{\beta_{1}^{2},\beta_{2}^{2}\}=\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-\left(\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)}\geq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><msubsup><mi>β</mi><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mfrac><mo>≥</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\alpha_{1}\beta_{1}+\alpha_{2}\beta_{2})^{2}\geq\min\{\beta_{1}^{2},\beta_{2}^{2}\}=\beta_{2}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-\left(\sum_{i=2}^{d+1}s_{i}^{2}k_{i}^{2}\right)}\geq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.SSS0.Px1.p6" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p6.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p6.1.1" class="ltx_text ltx_font_bold">Sufficiency:<span id="A2.SS2.SSS0.Px1.p6.1.1.1" class="ltx_text ltx_font_medium"> For any <math id="A2.SS2.SSS0.Px1.p6.m1" class="ltx_Math" alttext="f\in{\mathcal{F}}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{\mathcal{F}}(P^{+})</annotation></semantics></math> with <math id="A2.SS2.SSS0.Px1.p6.m2" class="ltx_Math" alttext="{\left\|f\right\|}_{P_{\mathcal{X}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{P_{\mathcal{X}}}=1</annotation></semantics></math> and <math id="A2.SS2.SSS0.Px1.p6.m3" class="ltx_Math" alttext="\mathbb{E}[f]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>f</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[f]=0</annotation></semantics></math>, denote <math id="A2.SS2.SSS0.Px1.p6.m4" class="ltx_Math" alttext="f=\sum_{i\geq 1}u_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum_{i\geq 1}u_{i}\mu_{i}</annotation></semantics></math> where <math id="A2.SS2.SSS0.Px1.p6.m5" class="ltx_Math" alttext="\sum_{i\geq 1}u_{i}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i\geq 1}u_{i}^{2}=1</annotation></semantics></math>. Obviously we have <math id="A2.SS2.SSS0.Px1.p6.m6" class="ltx_Math" alttext="(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">≤</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq 1</annotation></semantics></math>. Notice that when <math id="A2.SS2.SSS0.Px1.p6.m7" class="ltx_Math" alttext="{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}(\phi_{1},\cdots,\phi_{d})={\textnormal{span}}(\mu_{1},\cdots,\mu_{d})</annotation></semantics></math> since <math id="A2.SS2.SSS0.Px1.p6.m8" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture of <math id="A2.SS2.SSS0.Px1.p6.m9" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>, the approximation of <math id="A2.SS2.SSS0.Px1.p6.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> will be <math id="A2.SS2.SSS0.Px1.p6.m11" class="ltx_Math" alttext="\sum_{i\geq d+1}u_{i}^{2}:=A" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo>:=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\sum_{i\geq d+1}u_{i}^{2}:=A</annotation></semantics></math>.
By the given conditions, we have</span></span></p>
<table id="A2.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex57.m1" class="ltx_Math" alttext="(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq s_{1}^{2}\sum_{i=1}^{d}u_{i}^{2}+s_{d+1}^{2}\sum_{i\geq d+1}u_{i}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})A," display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></munder><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow></munder><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(1-{\epsilon})^{2}\leq\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\leq s_{1}^{2}\sum_{i=1}^{d}u_{i}^{2}+s_{d+1}^{2}\sum_{i\geq d+1}u_{i}^{2}=s_{1}^{2}-(s_{1}^{2}-s_{d+1}^{2})A,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p6.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p6.2.1" class="ltx_text">and this implies that</span></p>
<table id="A2.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex58.m1" class="ltx_Math" alttext="A=\min_{{\bm{w}}\in\mathbb{R}^{d},\;b\in\mathbb{R}}\;{\left\|{\bm{w}}^{\top}\Phi+b-f\right\|}_{P_{\mathcal{X}}}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>=</mo><mrow><munder><mi>min</mi><mrow><mrow><mi>𝒘</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo rspace="0.447em">,</mo><mrow><mi>b</mi><mo>∈</mo><mi>ℝ</mi></mrow></mrow></munder><mo>⁡</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mrow><msup><mi>𝒘</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi></mrow><mo>+</mo><mi>b</mi></mrow><mo>−</mo><mi>f</mi></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=\min_{{\bm{w}}\in\mathbb{R}^{d},\;b\in\mathbb{R}}\;{\left\|{\bm{w}}^{\top}\Phi+b-f\right\|}_{P_{\mathcal{X}}}^{2}\leq\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p6.3" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p6.3.1" class="ltx_text">When <math id="A2.SS2.SSS0.Px1.p6.m12" class="ltx_Math" alttext="u_{1}^{2}=1-\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}},u_{d+1}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mn>1</mn><mn>2</mn></msubsup><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow><mo>,</mo><mrow><msubsup><mi>u</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">u_{1}^{2}=1-\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}},u_{d+1}^{2}=\frac{s_{1}^{2}-(1-{\epsilon})^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>, the equality holds. Thus, the approximation error reaches its lower bound when <math id="A2.SS2.SSS0.Px1.p6.m13" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture of <math id="A2.SS2.SSS0.Px1.p6.m14" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Evaluating an Arbitrary Encoder</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">Given a context that is compatible with the task, the encoder that learns the contexture is optimal.
Now, what about an arbitrary encoder <math id="A3.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>? Is it possible to bound its worst-case approximation error on the class of compatible tasks?
To derive such a bound, two key objects are necessary: the induced RKHS and the ratio trace.
They were originally defined in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx66" title="" class="ltx_ref">ZLR+24</a>]</cite> for self-supervised learning, and here we extend them to a broader scope.</p>
</div>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p">Denote the range of <math id="A3.p2.m1" class="ltx_Math" alttext="T_{P^{+}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><annotation encoding="application/x-tex">T_{P^{+}}^{*}</annotation></semantics></math> by <math id="A3.p2.m2" class="ltx_Math" alttext="R(T_{P^{+}}^{*})={\left\{T_{P^{+}}^{*}f\;\middle|\;f\in{L^{2}(P_{\mathcal{X}})}\right\}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="true">|</mo><mrow><mi>f</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">R(T_{P^{+}}^{*})={\left\{T_{P^{+}}^{*}f\;\middle|\;f\in{L^{2}(P_{\mathcal{X}})}\right\}}</annotation></semantics></math>.</p>
</div>
<div id="Thmtheorem19" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem19.2" class="ltx_text ltx_font_bold">Definition 19</span></span><span id="Thmtheorem19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem19.p1" class="ltx_para">
<p id="Thmtheorem19.p1.1" class="ltx_p"><span id="Thmtheorem19.p1.1.1" class="ltx_text ltx_font_italic">The <span id="Thmtheorem19.p1.1.1.1" class="ltx_text ltx_font_bold">induced RKHS</span> of <math id="Thmtheorem19.p1.m1" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>, denoted by <math id="Thmtheorem19.p1.m2" class="ltx_Math" alttext="{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{P^{+}}</annotation></semantics></math>, is the Hilbert space <math id="Thmtheorem19.p1.m3" class="ltx_Math" alttext="R(T_{P^{+}}^{*})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(T_{P^{+}}^{*})</annotation></semantics></math> with the inner product given by <math id="Thmtheorem19.p1.m4" class="ltx_Math" alttext="{\left\langle T_{P^{+}}^{*}f_{1},T_{P^{+}}^{*}f_{2}\right\rangle}_{{\mathcal{H}}_{P^{+}}}={\left\langle f_{1},f_{2}\right\rangle}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><annotation encoding="application/x-tex">{\left\langle T_{P^{+}}^{*}f_{1},T_{P^{+}}^{*}f_{2}\right\rangle}_{{\mathcal{H}}_{P^{+}}}={\left\langle f_{1},f_{2}\right\rangle}_{{P_{\mathcal{X}}}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p">An alternative formula is that for any <math id="A3.p3.m1" class="ltx_Math" alttext="h_{1},h_{2}\in{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow></mrow><annotation encoding="application/x-tex">h_{1},h_{2}\in{\mathcal{H}}_{P^{+}}</annotation></semantics></math> where <math id="A3.p3.m2" class="ltx_Math" alttext="h_{1}=\sum u_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{1}=\sum u_{i}\nu_{i}</annotation></semantics></math> and <math id="A3.p3.m3" class="ltx_Math" alttext="h_{2}=\sum v_{i}\nu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>2</mn></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{2}=\sum v_{i}\nu_{i}</annotation></semantics></math>, there is <math id="A3.p3.m4" class="ltx_Math" alttext="{\left\langle h_{1},h_{2}\right\rangle}_{{\mathcal{H}}_{P^{+}}}=\sum\frac{u_{i}v_{i}}{s_{i}^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>⟨</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>,</mo><msub><mi>h</mi><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mfrac><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\left\langle h_{1},h_{2}\right\rangle}_{{\mathcal{H}}_{P^{+}}}=\sum\frac{u_{i}v_{i}}{s_{i}^{2}}</annotation></semantics></math>.</p>
</div>
<div id="Thmtheorem20" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem20.2" class="ltx_text ltx_font_bold">Proposition 20</span></span><span id="Thmtheorem20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem20.p1" class="ltx_para">
<p id="Thmtheorem20.p1.1" class="ltx_p"><span id="Thmtheorem20.p1.1.1" class="ltx_text ltx_font_italic">The induced RKHS <math id="Thmtheorem20.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{P^{+}}</annotation></semantics></math> has the following properties:</span></p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p"><math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="{k_{A}^{+}}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">{k_{A}^{+}}</annotation></semantics></math><span id="A3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> is the reproducing kernel, such that </span><math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="h(a)={\left\langle h,{k_{A}^{+}}(a,\cdot)\right\rangle}_{{\mathcal{H}}_{P^{+}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mi>h</mi><mo>,</mo><mrow><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub></mrow><annotation encoding="application/x-tex">h(a)={\left\langle h,{k_{A}^{+}}(a,\cdot)\right\rangle}_{{\mathcal{H}}_{P^{+}}}</annotation></semantics></math><span id="A3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> for all </span><math id="A3.I1.i1.p1.m3" class="ltx_Math" alttext="h\in{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">h\in{\mathcal{H}}_{P^{+}}</annotation></semantics></math><span id="A3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p"><math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{P^{+}}</annotation></semantics></math><span id="A3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> is isometric to </span><math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="{\textnormal{span}}{\left\{\mu_{i}:s_{i}&gt;0\right\}}" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\textnormal{span}}{\left\{\mu_{i}:s_{i}&gt;0\right\}}</annotation></semantics></math><span id="A3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, which is a subspace of </span><math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math><span id="A3.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A3.I1.i3.p1" class="ltx_para">
<p id="A3.I1.i3.p1.1" class="ltx_p"><math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math><span id="A3.I1.i3.p1.1.1" class="ltx_text ltx_font_italic"> is equivalent to </span><math id="A3.I1.i3.p1.m2" class="ltx_Math" alttext="h^{*}=T_{P^{+}}^{*}f^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">h^{*}=T_{P^{+}}^{*}f^{*}</annotation></semantics></math><span id="A3.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> satisfying the following </span><span id="A3.I1.i3.p1.1.3" class="ltx_text ltx_font_bold ltx_font_italic">isometry property</span><span id="A3.I1.i3.p1.1.4" class="ltx_text ltx_font_italic">:</span></p>
<table id="A3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E8.m1" class="ltx_Math" alttext="(1-\epsilon){\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo>≤</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1-\epsilon){\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="A3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p4" class="ltx_para">
<p id="A3.p4.1" class="ltx_p"><span id="A3.p4.1.1" class="ltx_text">For any <math id="A3.p4.m1" class="ltx_Math" alttext="h\in{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">h\in{\mathcal{H}}_{P^{+}}</annotation></semantics></math> where <math id="A3.p4.m2" class="ltx_Math" alttext="h=T_{P^{+}}^{*}f" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">h=T_{P^{+}}^{*}f</annotation></semantics></math> and <math id="A3.p4.m3" class="ltx_Math" alttext="f=\sum u_{i}\mu_{i}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\sum u_{i}\mu_{i}</annotation></semantics></math>, we have</span></p>
<table id="A3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex59.m1" class="ltx_Math" alttext="{\left\langle h,{k_{A}^{+}}(a,\cdot)\right\rangle}_{{\mathcal{H}}_{P^{+}}}={\left\langle\sum s_{i}u_{i}\nu_{i},\sum s_{i}^{2}\nu_{i}(a)\nu_{i}\right\rangle}_{{\mathcal{H}}_{P^{+}}}=\sum s_{i}u_{i}\nu_{i}(a)=h(a)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>⟨</mo><mrow><mi>h</mi><mo>,</mo><mrow><msubsup><mi>k</mi><mi>A</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><mrow><mo lspace="0em" movablelimits="false">∑</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0em">,</mo><mrow><mo movablelimits="false">∑</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>⟩</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub><mo rspace="0.111em">=</mo><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\left\langle h,{k_{A}^{+}}(a,\cdot)\right\rangle}_{{\mathcal{H}}_{P^{+}}}={\left\langle\sum s_{i}u_{i}\nu_{i},\sum s_{i}^{2}\nu_{i}(a)\nu_{i}\right\rangle}_{{\mathcal{H}}_{P^{+}}}=\sum s_{i}u_{i}\nu_{i}(a)=h(a),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p4.2" class="ltx_p"><span id="A3.p4.2.1" class="ltx_text">which proves (i). (ii) is obvious. Regarding (iii), recall that <math id="A3.p4.m4" class="ltx_Math" alttext="f^{*}=\sum u_{i}\mu_{i}\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}=\sum u_{i}\mu_{i}\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math> is equivalent to <math id="A3.p4.m5" class="ltx_Math" alttext="\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum_{i\geq 1}u_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>1</mn></mrow></msub><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\geq 1}s_{i}^{2}u_{i}^{2}\geq(1-\epsilon)^{2}\sum_{i\geq 1}u_{i}^{2}</annotation></semantics></math>, and this is <math id="A3.p4.m6" class="ltx_Math" alttext="{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\geq(1-\epsilon){\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\geq(1-\epsilon){\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}</annotation></semantics></math>.
Meanwhile, it is obvious that <math id="A3.p4.m7" class="ltx_Math" alttext="{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo>≤</mo><msub><mrow><mo>‖</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></msub></mrow><annotation encoding="application/x-tex">{\left\|\tilde{h}^{*}\right\|}_{{P_{\mathcal{A}}}}\leq{\left\|\tilde{h}^{*}\right\|}_{{\mathcal{H}}_{P^{+}}}</annotation></semantics></math> always holds.
∎</span></p>
</div>
</div>
<div id="Thmtheorem21" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem21.2" class="ltx_text ltx_font_bold">Definition 21</span></span><span id="Thmtheorem21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem21.p1" class="ltx_para">
<p id="Thmtheorem21.p1.1" class="ltx_p"><span id="Thmtheorem21.p1.1.1" class="ltx_text ltx_font_italic">Define covariance matrices <math id="Thmtheorem21.p1.m1" class="ltx_Math" alttext="{\bm{C}}_{\Phi}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[\Phi]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐂</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}_{\Phi}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[\Phi]</annotation></semantics></math>, and <math id="Thmtheorem21.p1.m2" class="ltx_Math" alttext="{\bm{B}}_{\Phi}=\mathrm{Cov}_{{P_{\mathcal{A}}}}[T_{P^{+}}^{*}\Phi]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐁</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}_{\Phi}=\mathrm{Cov}_{{P_{\mathcal{A}}}}[T_{P^{+}}^{*}\Phi]</annotation></semantics></math>. If <math id="Thmtheorem21.p1.m3" class="ltx_Math" alttext="{\bm{C}}_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi>𝐂</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">{\bm{C}}_{\Phi}</annotation></semantics></math> is invertible, then the <span id="Thmtheorem21.p1.1.1.1" class="ltx_text ltx_font_bold">ratio trace</span> of <math id="Thmtheorem21.p1.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> w.r.t. <math id="Thmtheorem21.p1.m5" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math> is defined as <math id="Thmtheorem21.p1.m6" class="ltx_Math" alttext="\textnormal{RT}(\Phi;P^{+})=\textnormal{RT}(\phi_{1},\cdots,\phi_{d};P^{+}):=\Tr({\bm{C}}_{\Phi}^{-1}{\bm{B}}_{\Phi})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐂</mi><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textnormal{RT}(\Phi;P^{+})=\textnormal{RT}(\phi_{1},\cdots,\phi_{d};P^{+}):=\Tr({\bm{C}}_{\Phi}^{-1}{\bm{B}}_{\Phi})</annotation></semantics></math>;
otherwise, let <math id="Thmtheorem21.p1.m7" class="ltx_Math" alttext="\Phi^{\prime}={\left[\phi_{i_{1}},\cdots,\phi_{i_{t}}\right]}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mo>′</mo></msup><mo>=</mo><mrow><mo>[</mo><mrow><msub><mi>ϕ</mi><msub><mi>i</mi><mn>1</mn></msub></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><msub><mi>i</mi><mi>t</mi></msub></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\prime}={\left[\phi_{i_{1}},\cdots,\phi_{i_{t}}\right]}</annotation></semantics></math> be the maximal linearly independent subset of <math id="Thmtheorem21.p1.m8" class="ltx_Math" alttext="{\left[\phi_{1},\cdots,\phi_{d}\right]}" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">{\left[\phi_{1},\cdots,\phi_{d}\right]}</annotation></semantics></math>, and define the ratio trace of <math id="Thmtheorem21.p1.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> the same as the ratio trace of <math id="Thmtheorem21.p1.m10" class="ltx_Math" alttext="\Phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Phi^{\prime}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p">The ratio trace of any <math id="A3.p5.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> essentially measures how well <math id="A3.p5.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is aligned with the contexture of <math id="A3.p5.m3" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math>.
Multiplying <math id="A3.p5.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> by any invertible matrix does not change its ratio trace.
If <math id="A3.p5.m5" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture, then its ratio trace is <math id="A3.p5.m6" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d}^{2}</annotation></semantics></math>, which can be easily shown by setting <math id="A3.p5.m7" class="ltx_Math" alttext="\phi_{i}=\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>=</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{i}=\mu_{i}</annotation></semantics></math>.
In fact, this is the maximum ratio trace of any <math id="A3.p5.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional encoder.</p>
</div>
<div id="Thmtheorem22" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem22.2" class="ltx_text ltx_font_bold">Lemma 22</span></span><span id="Thmtheorem22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem22.p1" class="ltx_para">
<p id="Thmtheorem22.p1.1" class="ltx_p"><span id="Thmtheorem22.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="Thmtheorem22.p1.m1" class="ltx_Math" alttext="\phi_{1},\cdots,\phi_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\cdots,\phi_{d}</annotation></semantics></math> are orthonormal and all have zero mean. Then, we have</span></p>
<table id="A3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex60.m1" class="ltx_Math" alttext="{\left\|T_{P^{+}}^{*}\phi_{1}\right\|}_{{P_{\mathcal{A}}}}^{2}+\cdots+{\left\|T_{P^{+}}^{*}\phi_{d}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>d</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|T_{P^{+}}^{*}\phi_{1}\right\|}_{{P_{\mathcal{A}}}}^{2}+\cdots+{\left\|T_{P^{+}}^{*}\phi_{d}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p"><span id="A3.p6.1.1" class="ltx_text">Let <math id="A3.p6.m1" class="ltx_Math" alttext="\phi_{i}=\sum_{j\geq 1}q_{ij}\mu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}=\sum_{j\geq 1}q_{ij}\mu_{j}</annotation></semantics></math> for <math id="A3.p6.m2" class="ltx_Math" alttext="i\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d]</annotation></semantics></math>.
Then, <math id="A3.p6.m3" class="ltx_Math" alttext="{\bm{Q}}=(q_{ij})" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}=(q_{ij})</annotation></semantics></math> is a matrix with <math id="A3.p6.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> orthonormal rows and infinitely many columns.
It is easy to see that the left-hand side is equal to <math id="A3.p6.m5" class="ltx_Math" alttext="\Tr({\bm{Q}}{\bm{D}}{\bm{Q}}^{\top})" display="inline" intent=":literal"><semantics><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{Q}}{\bm{D}}{\bm{Q}}^{\top})</annotation></semantics></math>, where <math id="A3.p6.m6" class="ltx_Math" alttext="{\bm{D}}={\textnormal{diag}}{\left\{s_{1}^{2},s_{2}^{2},\cdots\right\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{D}}={\textnormal{diag}}{\left\{s_{1}^{2},s_{2}^{2},\cdots\right\}}</annotation></semantics></math>.
Let <math id="A3.p6.m7" class="ltx_Math" alttext="{\bm{q}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝒒</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\bm{q}}_{j}</annotation></semantics></math> be the <math id="A3.p6.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th column of <math id="A3.p6.m9" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi>𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math>. For all <math id="A3.p6.m10" class="ltx_Math" alttext="j\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[d]</annotation></semantics></math>, there is <math id="A3.p6.m11" class="ltx_Math" alttext="\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\leq j" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mrow><msubsup><mi>𝒒</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mi>i</mi></msub></mrow></mrow><mo>≤</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\leq j</annotation></semantics></math>; and for any <math id="A3.p6.m12" class="ltx_Math" alttext="j&gt;d" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&gt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">j&gt;d</annotation></semantics></math>, there is <math id="A3.p6.m13" class="ltx_Math" alttext="\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mrow><msubsup><mi>𝒒</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mi>i</mi></msub></mrow></mrow><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\leq d</annotation></semantics></math>.
Thus, using Abel transformation, we have</span></p>
<table id="A3.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\Tr({\bm{Q}}{\bm{D}}{\bm{Q}}^{\top})=\Tr({\bm{D}}{\bm{Q}}^{\top}{\bm{Q}})=\sum_{j=1}^{\infty}s_{j}^{2}{\bm{q}}_{j}^{\top}{\bm{q}}_{j}=\sum_{j=1}^{\infty}{\left(\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\right)}{\left(s_{j}^{2}-s_{j+1}^{2}\right)}\leq\sum_{j=1}^{d}s_{j}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msubsup><mi>s</mi><mi>j</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mi>j</mi></msub></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>j</mi></munderover><mrow><msubsup><mi>𝒒</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>s</mi><mi>j</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>s</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Tr({\bm{Q}}{\bm{D}}{\bm{Q}}^{\top})=\Tr({\bm{D}}{\bm{Q}}^{\top}{\bm{Q}})=\sum_{j=1}^{\infty}s_{j}^{2}{\bm{q}}_{j}^{\top}{\bm{q}}_{j}=\sum_{j=1}^{\infty}{\left(\sum_{i=1}^{j}{\bm{q}}_{i}^{\top}{\bm{q}}_{i}\right)}{\left(s_{j}^{2}-s_{j+1}^{2}\right)}\leq\sum_{j=1}^{d}s_{j}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p6.2" class="ltx_p"><span id="A3.p6.2.1" class="ltx_text">as desired.
∎</span></p>
</div>
</div>
<div id="A3.p7" class="ltx_para">
<p id="A3.p7.1" class="ltx_p">The ratio trace induces a key quantity in the approximation error bound called the trace gap, which reflects the gap between <math id="A3.p7.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> and the top-<math id="A3.p7.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions.
The larger the trace gap is, the larger the approximation error will be.
A simple definition is <math id="A3.p7.m3" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})</annotation></semantics></math>, whose lower bound <math id="A3.p7.m4" class="ltx_Math" alttext="s_{d+1}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><annotation encoding="application/x-tex">s_{d+1}^{2}</annotation></semantics></math> can be achieved by the top-<math id="A3.p7.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> singular functions, the optimal encoder.
However, there is an issue with this definition.
For example, consider an encoder with <math id="A3.p7.m6" class="ltx_Math" alttext="d=1000" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">d=1000</annotation></semantics></math>.
It learns the top-<math id="A3.p7.m7" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> singular functions, but the other <math id="A3.p7.m8" class="ltx_Math" alttext="990" display="inline" intent=":literal"><semantics><mn>990</mn><annotation encoding="application/x-tex">990</annotation></semantics></math> dimensions are complete noise that has zero contribution to <math id="A3.p7.m9" class="ltx_Math" alttext="\textnormal{RT}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{RT}(\Phi;P^{+})</annotation></semantics></math>.
The approximation error of this encoder should be no higher than that of the top-<math id="A3.p7.m10" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> singular functions, because adding more dimensions will never make the approximation error higher.
However, if <math id="A3.p7.m11" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> becomes larger and <math id="A3.p7.m12" class="ltx_Math" alttext="\textnormal{RT}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{RT}(\Phi;P^{+})</annotation></semantics></math> stays the same, then <math id="A3.p7.m13" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})</annotation></semantics></math> will become larger, so this quantity does not correlate with the approximation error in this scenario.
The following definition fixes this issue.</p>
</div>
<div id="Thmtheorem23" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem23.2" class="ltx_text ltx_font_bold">Definition 23</span></span><span id="Thmtheorem23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem23.p1" class="ltx_para">
<p id="Thmtheorem23.p1.1" class="ltx_p"><span id="Thmtheorem23.p1.1.1" class="ltx_text ltx_font_italic">For any linearly independent <math id="Thmtheorem23.p1.m1" class="ltx_Math" alttext="f_{1},\cdots,f_{d^{\prime}}\in{L^{2}(P_{\mathcal{X}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1},\cdots,f_{d^{\prime}}\in{L^{2}(P_{\mathcal{X}})}</annotation></semantics></math>, denote <math id="Thmtheorem23.p1.m2" class="ltx_Math" alttext="F=[f_{1},\cdots,f_{d^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">F=[f_{1},\cdots,f_{d^{\prime}}]</annotation></semantics></math>, <math id="Thmtheorem23.p1.m3" class="ltx_Math" alttext="{\bm{C}}_{F}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[F]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐂</mi><mi>F</mi></msub><mo>=</mo><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>F</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}_{F}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[F]</annotation></semantics></math>, and <math id="Thmtheorem23.p1.m4" class="ltx_Math" alttext="{\bm{B}}_{F}=\mathrm{Cov}_{{P_{\mathcal{A}}}}[F]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐁</mi><mi>F</mi></msub><mo>=</mo><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>F</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}_{F}=\mathrm{Cov}_{{P_{\mathcal{A}}}}[F]</annotation></semantics></math>.
The <span id="Thmtheorem23.p1.1.1.1" class="ltx_text ltx_font_bold">trace gap</span> of <math id="Thmtheorem23.p1.m5" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> w.r.t. <math id="Thmtheorem23.p1.m6" class="ltx_Math" alttext="P^{+}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>+</mo></msup><annotation encoding="application/x-tex">P^{+}</annotation></semantics></math> is defined as</span></p>
<table id="A3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\textnormal{TG}(\Phi;P^{+}):=\inf_{d^{\prime}\leq d}\;\inf_{f_{1},\cdots,f_{d^{\prime}}}\;{\left\{s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F})\right\}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">inf</mo><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>≤</mo><mi>d</mi></mrow></munder><mrow><munder><mo lspace="0.0835em" movablelimits="false" rspace="0em">inf</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow></munder><mrow><mo>{</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑪</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>F</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textnormal{TG}(\Phi;P^{+}):=\inf_{d^{\prime}\leq d}\;\inf_{f_{1},\cdots,f_{d^{\prime}}}\;{\left\{s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F})\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p8" class="ltx_para">
<p id="A3.p8.1" class="ltx_p">Obviously, this definition of trace gap is upper bounded by <math id="A3.p8.m1" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mtext>RT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d+1}^{2}-\textnormal{RT}(\Phi;P^{+})</annotation></semantics></math>.
It solves the issue in the previous example because having completely noisy dimensions does not affect the trace gap.
The following result bounds the approximation error.</p>
</div>
<div id="Thmtheorem24" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem24.2" class="ltx_text ltx_font_bold">Theorem 24</span></span><span id="Thmtheorem24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem24.p1" class="ltx_para">
<p id="Thmtheorem24.p1.1" class="ltx_p"><span id="Thmtheorem24.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="Thmtheorem24.p1.m1" class="ltx_Math" alttext="\textnormal{TG}(\Phi;P^{+})&lt;s_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\textnormal{TG}(\Phi;P^{+})&lt;s_{1}^{2}</annotation></semantics></math>, and <math id="Thmtheorem24.p1.m2" class="ltx_Math" alttext="\epsilon&gt;1-s_{1}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>s</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\epsilon&gt;1-s_{1}</annotation></semantics></math>. Then,</span></p>
<table id="A3.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\textnormal{TG}(\Phi;P^{+})}{s_{1}^{2}-\textnormal{TG}(\Phi;P^{+})^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))\leq\frac{s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\textnormal{TG}(\Phi;P^{+})}{s_{1}^{2}-\textnormal{TG}(\Phi;P^{+})^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmremarkx2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremarkx2.2" class="ltx_text ltx_font_bold">Remark</span></span><span id="Thmremarkx2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremarkx2.p1" class="ltx_para">
<p id="Thmremarkx2.p1.1" class="ltx_p"><span id="Thmremarkx2.p1.1.1" class="ltx_text ltx_font_italic">This bound is fairly tight. If <math id="Thmremarkx2.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> learns the contexture, then by <a href="#Thmtheorem16" title="Theorem 16 (Proof in ). ‣ 4.1 Compatibility ‣ 4 Optimality of the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">16</span></a> we have <math id="Thmremarkx2.p1.m2" class="ltx_Math" alttext="\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))=\frac{s_{1}^{2}-(1-\epsilon)^{2}}{s_{1}^{2}-s_{d+1}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))=\frac{s_{1}^{2}-(1-\epsilon)^{2}}{s_{1}^{2}-s_{d+1}^{2}}</annotation></semantics></math>, and <math id="Thmremarkx2.p1.m3" class="ltx_Math" alttext="\textnormal{TG}(\Phi;P^{+})=s_{d+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>s</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\textnormal{TG}(\Phi;P^{+})=s_{d+1}</annotation></semantics></math>.
Compared to this exact formula, the above upper bound only has an extra <math id="Thmremarkx2.p1.m4" class="ltx_Math" alttext="s_{1}\textnormal{TG}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{1}\textnormal{TG}(\Phi;P^{+})</annotation></semantics></math> term in the numerator.</span></p>
</div>
</div>
<div id="A3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p9" class="ltx_para">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text">Let <math id="A3.p9.m1" class="ltx_Math" alttext="f_{1},\cdots,f_{d^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">f_{1},\cdots,f_{d^{\prime}}</annotation></semantics></math> be the functions that minimize <math id="A3.p9.m2" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑪</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>F</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F})</annotation></semantics></math>. Without loss of generality, assume that <math id="A3.p9.m3" class="ltx_Math" alttext="f_{1},\cdots,f_{d^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">f_{1},\cdots,f_{d^{\prime}}</annotation></semantics></math> have zero mean and are orthonormal. Let <math id="A3.p9.m4" class="ltx_Math" alttext="{\mathcal{F}}={\textnormal{span}}{\left\{f_{1},\cdots,f_{d^{\prime}}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}={\textnormal{span}}{\left\{f_{1},\cdots,f_{d^{\prime}}\right\}}</annotation></semantics></math>, and <math id="A3.p9.m5" class="ltx_Math" alttext="{\mathcal{H}}={\textnormal{span}}{\left\{T_{P^{+}}^{*}f_{1},\cdots,T_{P^{+}}^{*}f_{d^{\prime}}\right\}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}={\textnormal{span}}{\left\{T_{P^{+}}^{*}f_{1},\cdots,T_{P^{+}}^{*}f_{d^{\prime}}\right\}}</annotation></semantics></math>.
For any <math id="A3.p9.m6" class="ltx_Math" alttext="f\in{\mathcal{F}}_{\epsilon}(P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in{\mathcal{F}}_{\epsilon}(P^{+})</annotation></semantics></math> with <math id="A3.p9.m7" class="ltx_Math" alttext="{\left\|f\right\|}_{{P_{\mathcal{X}}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f\right\|}_{{P_{\mathcal{X}}}}=1</annotation></semantics></math>, let <math id="A3.p9.m8" class="ltx_Math" alttext="h=T_{P^{+}}^{*}f\in{\mathcal{H}}_{P^{+}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub></mrow><annotation encoding="application/x-tex">h=T_{P^{+}}^{*}f\in{\mathcal{H}}_{P^{+}}</annotation></semantics></math>, and let <math id="A3.p9.m9" class="ltx_Math" alttext="f_{{\mathcal{F}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><annotation encoding="application/x-tex">f_{{\mathcal{F}}}</annotation></semantics></math> be the projection of <math id="A3.p9.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> onto <math id="A3.p9.m11" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math>.
Since <math id="A3.p9.m12" class="ltx_Math" alttext="\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))" display="inline" intent=":literal"><semantics><mrow><mtext>err</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{err}(\Phi;{\mathcal{F}}_{\epsilon}(P^{+}))</annotation></semantics></math> is upper bounded by <math id="A3.p9.m13" class="ltx_Math" alttext="{\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>, it suffices to show that <math id="A3.p9.m14" class="ltx_Math" alttext="{\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">{\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math> is upper bounded by the right-hand side.</span></p>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">Let <math id="A3.p10.m1" class="ltx_Math" alttext="\alpha^{2}={\left\|f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>=</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\alpha^{2}={\left\|f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>, and <math id="A3.p10.m2" class="ltx_Math" alttext="\beta^{2}={\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mn>2</mn></msup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\beta^{2}={\left\|f-f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}</annotation></semantics></math>, where <math id="A3.p10.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="A3.p10.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> are non-negative.
Then, <math id="A3.p10.m5" class="ltx_Math" alttext="\alpha^{2}+\beta^{2}={\left\|f\right\|}_{{P_{\mathcal{X}}}}^{2}=1={\left\|h\right\|}_{{\mathcal{H}}_{P^{+}}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>=</mo><msubsup><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup><mo>=</mo><mn>1</mn><mo>=</mo><msubsup><mrow><mo>‖</mo><mi>h</mi><mo>‖</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\alpha^{2}+\beta^{2}={\left\|f\right\|}_{{P_{\mathcal{X}}}}^{2}=1={\left\|h\right\|}_{{\mathcal{H}}_{P^{+}}}^{2}</annotation></semantics></math>.
The isometry property says that <math id="A3.p10.m6" class="ltx_Math" alttext="(1-\epsilon)^{2}(\alpha^{2}+\beta^{2})\leq{\left\|h\right\|}_{{P_{\mathcal{A}}}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msubsup><mrow><mo>‖</mo><mi>h</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">(1-\epsilon)^{2}(\alpha^{2}+\beta^{2})\leq{\left\|h\right\|}_{{P_{\mathcal{A}}}}^{2}</annotation></semantics></math>.
Let <math id="A3.p10.m7" class="ltx_Math" alttext="f-f_{{\mathcal{F}}}=\beta f_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f-f_{{\mathcal{F}}}=\beta f_{0}</annotation></semantics></math> where <math id="A3.p10.m8" class="ltx_Math" alttext="{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\left\|f_{0}\right\|}_{{P_{\mathcal{X}}}}=1</annotation></semantics></math>.
Let <math id="A3.p10.m9" class="ltx_Math" alttext="h_{{\mathcal{F}}}=T_{P^{+}}^{*}h_{{\mathcal{F}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{{\mathcal{F}}}=T_{P^{+}}^{*}h_{{\mathcal{F}}}</annotation></semantics></math> and <math id="A3.p10.m10" class="ltx_Math" alttext="h_{0}=T_{P^{+}}^{*}f_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">h_{0}=T_{P^{+}}^{*}f_{0}</annotation></semantics></math>.
Then, we have <math id="A3.p10.m11" class="ltx_Math" alttext="{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}{\left\|f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}=s_{1}^{2}\alpha^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}{\left\|f_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{X}}}}^{2}=s_{1}^{2}\alpha^{2}</annotation></semantics></math>.
Meanwhile, since <math id="A3.p10.m12" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> is orthogonal to <math id="A3.p10.m13" class="ltx_Math" alttext="f_{1},\cdots,f_{d^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">f_{1},\cdots,f_{d^{\prime}}</annotation></semantics></math>, by <a href="#Thmtheorem22" title="Lemma 22. ‣ Appendix C Evaluating an Arbitrary Encoder ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">22</span></a> we have <math id="A3.p10.m14" class="ltx_Math" alttext="{\left\|T_{P^{+}}^{*}f_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}+{\left\|T_{P^{+}}^{*}f_{1}\right\|}_{{P_{\mathcal{A}}}}^{2}+\cdots+{\left\|T_{P^{+}}^{*}f_{d^{\prime}}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>≤</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\left\|T_{P^{+}}^{*}f_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}+{\left\|T_{P^{+}}^{*}f_{1}\right\|}_{{P_{\mathcal{A}}}}^{2}+\cdots+{\left\|T_{P^{+}}^{*}f_{d^{\prime}}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}</annotation></semantics></math>, which implies that <math id="A3.p10.m15" class="ltx_Math" alttext="{\left\|T_{P^{+}}^{*}f_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F}^{-1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑪</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\left\|T_{P^{+}}^{*}f_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq s_{1}^{2}+\cdots+s_{d^{\prime}+1}^{2}-\Tr({\bm{C}}_{F}^{-1}{\bm{B}}_{F}^{-1})</annotation></semantics></math>.
Let <math id="A3.p10.m16" class="ltx_Math" alttext="\tau=\textnormal{TG}(\Phi;P^{+})" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mrow><mtext>TG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><msup><mi>P</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau=\textnormal{TG}(\Phi;P^{+})</annotation></semantics></math>. Then, we have</span></p>
<table id="A3.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex64.m1" class="ltx_Math" alttext="{\left\|h\right\|}_{{P_{\mathcal{A}}}}^{2}={\left\|h_{{\mathcal{F}}}+\beta h_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}^{2}+\beta^{2}{\left\|h_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}+2\beta{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}{\left\|h_{0}\right\|}_{{P_{\mathcal{A}}}}\leq s_{1}^{2}\alpha^{2}+\tau^{2}\beta^{2}+2s_{1}\tau\alpha\beta." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo>‖</mo><mi>h</mi><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>0</mn></msub></mrow></mrow><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mrow><mo>‖</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>h</mi><mn>0</mn></msub><mo>‖</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\left\|h\right\|}_{{P_{\mathcal{A}}}}^{2}={\left\|h_{{\mathcal{F}}}+\beta h_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}\leq{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}^{2}+\beta^{2}{\left\|h_{0}\right\|}_{{P_{\mathcal{A}}}}^{2}+2\beta{\left\|h_{{\mathcal{F}}}\right\|}_{{P_{\mathcal{A}}}}{\left\|h_{0}\right\|}_{{P_{\mathcal{A}}}}\leq s_{1}^{2}\alpha^{2}+\tau^{2}\beta^{2}+2s_{1}\tau\alpha\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">Thus, we have <math id="A3.p10.m17" class="ltx_Math" alttext="(1-\epsilon)^{2}(\alpha^{2}+\beta^{2})\leq s_{1}^{2}\alpha^{2}+\tau^{2}\beta^{2}+2s_{1}\tau\alpha\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\epsilon)^{2}(\alpha^{2}+\beta^{2})\leq s_{1}^{2}\alpha^{2}+\tau^{2}\beta^{2}+2s_{1}\tau\alpha\beta</annotation></semantics></math>, which implies that <math id="A3.p10.m18" class="ltx_Math" alttext="(s_{1}^{2}-\tau^{2})\beta^{2}\leq[s_{1}^{2}-(1-\epsilon)^{2}](\alpha^{2}+\beta^{2})+2s_{1}\tau\alpha\beta\leq[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\tau](\alpha^{2}+\beta^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(s_{1}^{2}-\tau^{2})\beta^{2}\leq[s_{1}^{2}-(1-\epsilon)^{2}](\alpha^{2}+\beta^{2})+2s_{1}\tau\alpha\beta\leq[s_{1}^{2}-(1-\epsilon)^{2}+s_{1}\tau](\alpha^{2}+\beta^{2})</annotation></semantics></math>, as desired.
∎</span></p>
</div>
</div>
<section id="A3.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Connection to Fisher discriminant analysis.</h5>

<div id="A3.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS0.SSS0.Px1.p1.1" class="ltx_p">Fisher discriminant analysis <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">MRW+99</a>, <a href="#bib.bibx3" title="" class="ltx_ref">BA00</a>, <a href="#bib.bibx35" title="" class="ltx_ref">LLM04</a>]</cite>, or more generally linear discriminant analysis (LDA), is a classical method of learning linear classifiers in statistics.
Here we show that Fisher discriminant analysis has a strong connection to the contexture theory.
Suppose <math id="A3.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="{\mathcal{X}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>⊆</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msup></mrow><annotation encoding="application/x-tex">{\mathcal{X}}\subseteq\mathbb{R}^{d_{{\mathcal{X}}}}</annotation></semantics></math>.
Fisher discriminant analysis defines the following <span id="A3.SS0.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_bold">between-class covariance matrix</span> <math id="A3.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="{\bm{S}}_{B}\in\mathbb{R}^{d_{{\mathcal{X}}}\times d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑺</mi><mi>B</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{S}}_{B}\in\mathbb{R}^{d_{{\mathcal{X}}}\times d_{{\mathcal{X}}}}</annotation></semantics></math> and <span id="A3.SS0.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_bold">within-class covariance matrix</span> <math id="A3.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="{\bm{S}}_{W}\in\mathbb{R}^{d_{{\mathcal{X}}}\times d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑺</mi><mi>W</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{S}}_{W}\in\mathbb{R}^{d_{{\mathcal{X}}}\times d_{{\mathcal{X}}}}</annotation></semantics></math>:</p>
<table id="A3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle{\bm{S}}_{B}" display="inline" intent=":literal"><semantics><msub><mi>𝑺</mi><mi>B</mi></msub><annotation encoding="application/x-tex">\displaystyle{\bm{S}}_{B}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle=\iint{\left\{{\left(\mathbb{E}{\left[X\;\middle|\;A=a_{1}\right]}-\mathbb{E}{\left[X\;\middle|\;A=a_{2}\right]}\right)}{\left(\mathbb{E}{\left[X\;\middle|\;A=a_{1}\right]}-\mathbb{E}{\left[X\;\middle|\;A=a_{2}\right]}\right)}^{\top}\right\}};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mo>{</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>}</mo></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint{\left\{{\left(\mathbb{E}{\left[X\;\middle|\;A=a_{1}\right]}-\mathbb{E}{\left[X\;\middle|\;A=a_{2}\right]}\right)}{\left(\mathbb{E}{\left[X\;\middle|\;A=a_{1}\right]}-\mathbb{E}{\left[X\;\middle|\;A=a_{2}\right]}\right)}^{\top}\right\}};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\displaystyle{\bm{S}}_{W}" display="inline" intent=":literal"><semantics><msub><mi>𝑺</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\displaystyle{\bm{S}}_{W}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66.m2" class="ltx_Math" alttext="\displaystyle=\int\mathbb{E}_{P^{+}}{\left[{\left(X-\mathbb{E}{\left[X\;\middle|\;A=a\right]}\right)}{\left(X-\mathbb{E}{\left[X\;\middle|\;A=a\right]}\right)}^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>X</mi><mo stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathbb{E}_{P^{+}}{\left[{\left(X-\mathbb{E}{\left[X\;\middle|\;A=a\right]}\right)}{\left(X-\mathbb{E}{\left[X\;\middle|\;A=a\right]}\right)}^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS0.SSS0.Px1.p1.2" class="ltx_p">In the original formulation of Fisher discriminant analysis, <math id="A3.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is the label of <math id="A3.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
Here we extend it to a general context variable.
Consider a linear encoder <math id="A3.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\Phi(x)={\bm{W}}x" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\Phi(x)={\bm{W}}x</annotation></semantics></math>, where <math id="A3.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="{\bm{W}}\in\mathbb{R}^{d\times d_{{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}\in\mathbb{R}^{d\times d_{{\mathcal{X}}}}</annotation></semantics></math>.
Then, one solves the following optimization problem to find <math id="A3.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math>:</p>
<table id="A3.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\underset{{\bm{W}}\in\mathbb{R}^{d\times d_{{\mathcal{X}}}}}{\text{maximize}}\;J({\bm{W}})=\Tr{\left[{\left({\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}\right)}{\left({\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}\right)}^{-1}\right]}\quad\text{s.t.}\quad{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}\text{ is invertible}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder accentunder="true"><mtext>maximize</mtext><mrow><mi mathsize="0.700em">𝑾</mi><mo mathsize="0.700em">∈</mo><msup><mi mathsize="0.700em">ℝ</mi><mrow><mi mathsize="0.710em">d</mi><mo lspace="0.222em" mathsize="0.710em" rspace="0.222em">×</mo><msub><mi mathsize="0.710em">d</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msup></mrow></munder><mo lspace="0.280em" rspace="0em">​</mo><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>]</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>s.t.</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mtext> is invertible</mtext></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underset{{\bm{W}}\in\mathbb{R}^{d\times d_{{\mathcal{X}}}}}{\text{maximize}}\;J({\bm{W}})=\Tr{\left[{\left({\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}\right)}{\left({\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}\right)}^{-1}\right]}\quad\text{s.t.}\quad{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}\text{ is invertible}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS0.SSS0.Px1.p1.3" class="ltx_p">Here, <math id="A3.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="J({\bm{W}})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J({\bm{W}})</annotation></semantics></math> is called the <span id="A3.SS0.SSS0.Px1.p1.3.1" class="ltx_text ltx_font_bold">Fisher discriminant</span>.
Define <math id="A3.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\Psi(a)=\mathbb{E}_{P^{+}}[{\bm{W}}X|A=a]" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi(a)=\mathbb{E}_{P^{+}}[{\bm{W}}X|A=a]</annotation></semantics></math>. Then, we can see that</p>
<table id="A3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\displaystyle{\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m2" class="ltx_Math" alttext="\displaystyle=\iint{\left(\Psi(a_{1})-\Psi(a_{2})\right)}{\left(\Psi(a_{1})-\Psi(a_{2})\right)}^{\top}d{P_{\mathcal{A}}}(a_{1})d{P_{\mathcal{A}}}(a_{2});" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint{\left(\Psi(a_{1})-\Psi(a_{2})\right)}{\left(\Psi(a_{1})-\Psi(a_{2})\right)}^{\top}d{P_{\mathcal{A}}}(a_{1})d{P_{\mathcal{A}}}(a_{2});</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_Math" alttext="\displaystyle{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m2" class="ltx_Math" alttext="\displaystyle=\int\mathbb{E}_{P^{+}}{\left[{\left(\Phi(X)-\Psi(a)\right)}{\left(\Phi(X)-\Psi(a)\right)}^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathbb{E}_{P^{+}}{\left[{\left(\Phi(X)-\Psi(a)\right)}{\left(\Phi(X)-\Psi(a)\right)}^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS0.SSS0.Px1.p1.4" class="ltx_p">Let <math id="A3.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="{\bm{C}}_{\Phi}=\mathbb{E}[\tilde{\Phi}(X)\tilde{\Phi}(X)^{\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑪</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}_{\Phi}=\mathbb{E}[\tilde{\Phi}(X)\tilde{\Phi}(X)^{\top}]</annotation></semantics></math> and <math id="A3.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="{\bm{B}}_{\Phi}=\mathbb{E}[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}_{\Phi}=\mathbb{E}[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}]</annotation></semantics></math>.
Then, we have</p>
<table id="A3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\displaystyle{\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{W}}{\bm{S}}_{B}{\bm{W}}^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70.m2" class="ltx_Math" alttext="\displaystyle=2{\left\{\mathbb{E}{\left[\Psi(A)\Psi(A)^{\top}\right]}-\bar{\Psi}\bar{\Psi}^{\top}\right\}}=2\mathbb{E}{\left[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}\right]}=2{\bm{B}}_{\Phi};" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>¯</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>}</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2{\left\{\mathbb{E}{\left[\Psi(A)\Psi(A)^{\top}\right]}-\bar{\Psi}\bar{\Psi}^{\top}\right\}}=2\mathbb{E}{\left[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}\right]}=2{\bm{B}}_{\Phi};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex71.m1" class="ltx_Math" alttext="\displaystyle{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{W}}{\bm{S}}_{W}{\bm{W}}^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71.m2" class="ltx_Math" alttext="\displaystyle=\int\mathbb{E}_{P^{+}}{\left[\Phi(X)\Phi(X)^{\top}-\Psi(a)\Psi(a)^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>𝔼</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mi>A</mi><mo>=</mo><mi>a</mi></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathbb{E}_{P^{+}}{\left[\Phi(X)\Phi(X)^{\top}-\Psi(a)\Psi(a)^{\top}\;\middle|\;A=a\right]}d{P_{\mathcal{A}}}(a)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}{\left[\Phi(X)\Phi(X)^{\top}\right]}-\mathbb{E}{\left[\Psi(A)\Psi(A)^{\top}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}{\left[\Phi(X)\Phi(X)^{\top}\right]}-\mathbb{E}{\left[\Psi(A)\Psi(A)^{\top}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}{\left[\tilde{\Phi}(X)\tilde{\Phi}(X)^{\top}\right]}-\mathbb{E}{\left[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}\right]}={\bm{C}}_{\Phi}-{\bm{B}}_{\Phi}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>𝑪</mi><mi mathvariant="normal">Φ</mi></msub><mo>−</mo><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}{\left[\tilde{\Phi}(X)\tilde{\Phi}(X)^{\top}\right]}-\mathbb{E}{\left[\tilde{\Psi}(A)\tilde{\Psi}(A)^{\top}\right]}={\bm{C}}_{\Phi}-{\bm{B}}_{\Phi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS0.SSS0.Px1.p1.5" class="ltx_p">Therefore, <math id="A3.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="J({\bm{W}})=2\Tr[({\bm{C}}_{\Phi}-{\bm{B}}_{\Phi})^{-1}{\bm{B}}_{\Phi}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑪</mi><mi mathvariant="normal">Φ</mi></msub><mo>−</mo><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">J({\bm{W}})=2\Tr[({\bm{C}}_{\Phi}-{\bm{B}}_{\Phi})^{-1}{\bm{B}}_{\Phi}]</annotation></semantics></math>, which is very similar to the ratio trace defined in <a href="#Thmtheorem21" title="Definition 21. ‣ Appendix C Evaluating an Arbitrary Encoder ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">21</span></a>.
Recall that an encoder that learns the contexture maximizes the ratio trace.
A well-known result is that <math id="A3.SS0.SSS0.Px1.p1.m14" class="ltx_Math" alttext="J({\bm{W}})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J({\bm{W}})</annotation></semantics></math> is maximized when <math id="A3.SS0.SSS0.Px1.p1.m15" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> consists of the top-<math id="A3.SS0.SSS0.Px1.p1.m16" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenvectors of <math id="A3.SS0.SSS0.Px1.p1.m17" class="ltx_Math" alttext="{\bm{S}}_{W}^{-1}{\bm{S}}_{B}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑺</mi><mi>W</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑺</mi><mi>B</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}_{W}^{-1}{\bm{S}}_{B}</annotation></semantics></math>.
Hence, Fisher discriminant analysis is almost equivalent to contexture learning under the constraint that the encoder must be linear.</p>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Efficient Estimation of the Context Usefulness Metric</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">To estimate the metric <math id="A4.p1.m1" class="ltx_Math" alttext="\tau_{d}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\tau_{d}</annotation></semantics></math> defined in <a href="#S5.E4" title="In 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">4</span></a>, it suffices to estimate the top-<math id="A4.p1.m2" class="ltx_Math" alttext="d_{0}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>0</mn></msub><annotation encoding="application/x-tex">d_{0}</annotation></semantics></math> eigenvalues of the context. This can be efficiently done with the following procedure:</p>
<ol id="A4.I1" class="ltx_enumerate">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p">Train an encoder <math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> whose output dimension is at least <math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="d_{0}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>0</mn></msub><annotation encoding="application/x-tex">d_{0}</annotation></semantics></math> to learn the contexture with a random subset of <math id="A4.I1.i1.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> samples.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p">Estimate the covariance matrix <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="{\bm{C}}_{\Phi}\in\mathbb{R}^{d\times d}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[\Phi]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑪</mi><mi mathvariant="normal">Φ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>=</mo><mrow><msub><mi>Cov</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{C}}_{\Phi}\in\mathbb{R}^{d\times d}=\mathrm{Cov}_{{P_{\mathcal{X}}}}[\Phi]</annotation></semantics></math> with Monte Carlo.</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p">Estimate <math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="{\bm{B}}_{\Phi}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{B}}_{\Phi}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, where <math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="{\bm{B}}_{\Phi}[i,j]={\left\langle\tilde{\phi}_{i},T_{{k_{X}^{+}}}\tilde{\phi}_{j}\right\rangle}_{{P_{\mathcal{X}}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>j</mi></msub></mrow></mrow><mo>⟩</mo></mrow><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></msub></mrow><annotation encoding="application/x-tex">{\bm{B}}_{\Phi}[i,j]={\left\langle\tilde{\phi}_{i},T_{{k_{X}^{+}}}\tilde{\phi}_{j}\right\rangle}_{{P_{\mathcal{X}}}}</annotation></semantics></math>, with Monte Carlo.</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iv)</span> 
<div id="A4.I1.i4.p1" class="ltx_para">
<p id="A4.I1.i4.p1.1" class="ltx_p">Solve the generalized eigenvalue problem <math id="A4.I1.i4.p1.m1" class="ltx_Math" alttext="{\bm{B}}_{\Phi}{\bm{v}}=\lambda{\bm{C}}_{\Phi}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑩</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}_{\Phi}{\bm{v}}=\lambda{\bm{C}}_{\Phi}{\bm{v}}</annotation></semantics></math>. The eigenvalues <math id="A4.I1.i4.p1.m2" class="ltx_Math" alttext="\lambda_{1}\geq\cdots\geq\lambda_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>λ</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\lambda_{1}\geq\cdots\geq\lambda_{d_{0}}</annotation></semantics></math> are estimates of <math id="A4.I1.i4.p1.m3" class="ltx_Math" alttext="s_{1}^{2},\cdots,s_{d_{0}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>s</mi><msub><mi>d</mi><mn>0</mn></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">s_{1}^{2},\cdots,s_{d_{0}}^{2}</annotation></semantics></math>.
Moreover, let <math id="A4.I1.i4.p1.m4" class="ltx_Math" alttext="{\bm{Q}}=[{\bm{v}}_{1},\cdots,{\bm{v}}_{d}]" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒗</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝒗</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}=[{\bm{v}}_{1},\cdots,{\bm{v}}_{d}]</annotation></semantics></math> where <math id="A4.I1.i4.p1.m5" class="ltx_Math" alttext="({\bm{v}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒗</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{v}}_{i})</annotation></semantics></math> are the orthonormal eigenvectors corresponding to <math id="A4.I1.i4.p1.m6" class="ltx_Math" alttext="(\lambda_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{i})</annotation></semantics></math>. Let <math id="A4.I1.i4.p1.m7" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> be the normalized version of <math id="A4.I1.i4.p1.m8" class="ltx_Math" alttext="\tilde{\Phi}{\bm{Q}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝑸</mi></mrow><annotation encoding="application/x-tex">\tilde{\Phi}{\bm{Q}}</annotation></semantics></math> such that each dimension is scaled to unit variance. Then, <math id="A4.I1.i4.p1.m9" class="ltx_Math" alttext="\phi_{1}^{*},\cdots,\phi_{d_{0}}^{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϕ</mi><mn>1</mn><mo>∗</mo></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>ϕ</mi><msub><mi>d</mi><mn>0</mn></msub><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\phi_{1}^{*},\cdots,\phi_{d_{0}}^{*}</annotation></semantics></math> are estimates of <math id="A4.I1.i4.p1.m10" class="ltx_Math" alttext="\mu_{1},\cdots,\mu_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>μ</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\mu_{1},\cdots,\mu_{d_{0}}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">If we only need to estimate the eigenvalues,
then <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx50" title="" class="ltx_ref">STWCK05</a>]</cite> showed that for any fixed <math id="A4.p2.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, the sum <math id="A4.p2.m2" class="ltx_Math" alttext="s_{1}^{2}+\cdots+s_{d}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>s</mi><mi>d</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">s_{1}^{2}+\cdots+s_{d}^{2}</annotation></semantics></math> can be estimated with low error using <math id="A4.p2.m3" class="ltx_Math" alttext="\Theta(d)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(d)</annotation></semantics></math> <span id="A4.p2.1.1" class="ltx_text ltx_font_italic">i.i.d.</span> samples.
By union bound, all <math id="A4.p2.m4" class="ltx_Math" alttext="s_{1}^{2},\cdots,s_{d_{0}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>s</mi><msub><mi>d</mi><mn>0</mn></msub><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">s_{1}^{2},\cdots,s_{d_{0}}^{2}</annotation></semantics></math> can be estimated with low error using <math id="A4.p2.m5" class="ltx_Math" alttext="m=\Theta(d_{0}\log d_{0})" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m=\Theta(d_{0}\log d_{0})</annotation></semantics></math> <span id="A4.p2.1.2" class="ltx_text ltx_font_italic">i.i.d.</span> samples.
However, if we want to estimate the eigenfunctions as well, then usually we need to use the entire training set.</p>
</div>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p">Let us demonstrate this method on 3 real datasets from OpenML <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx57" title="" class="ltx_ref">VvRBT13</a>]</cite>: <span id="A4.p3.1.1" class="ltx_text ltx_font_typewriter">abalone</span>, <span id="A4.p3.1.2" class="ltx_text ltx_font_typewriter">fifa</span>, and <span id="A4.p3.1.3" class="ltx_text ltx_font_typewriter">kings_county</span>.
We use KNN with <math id="A4.p3.m1" class="ltx_Math" alttext="K=60" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>60</mn></mrow><annotation encoding="application/x-tex">K=60</annotation></semantics></math> as context, where <math id="A4.p3.m2" class="ltx_Math" alttext="{\mathcal{A}}={\mathcal{X}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">{\mathcal{A}}={\mathcal{X}}</annotation></semantics></math>, and <math id="A4.p3.m3" class="ltx_Math" alttext="P^{+}(x^{\prime}|x)=K^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>K</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">P^{+}(x^{\prime}|x)=K^{-1}</annotation></semantics></math> if <math id="A4.p3.m4" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> is a <math id="A4.p3.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-nearest neighbor of <math id="A4.p3.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="A4.p3.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise.
For this context, we can exactly compute <math id="A4.p3.m8" class="ltx_Math" alttext="{k_{X}^{+}}" display="inline" intent=":literal"><semantics><msubsup><mi>k</mi><mi>X</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">{k_{X}^{+}}</annotation></semantics></math>, and thus we can obtain the exact eigenvalues (ground truth) using kernel PCA.
Meanwhile, we pretrain <math id="A4.p3.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> with one of the variational objectives using a random subset of <math id="A4.p3.m10" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> samples, and estimate the eigenvalues using the post-hoc approach.
Then, we compare the estimation with the ground truth.</p>
</div>
