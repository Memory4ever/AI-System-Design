<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|A-{\bm{W}}\Phi(X)-{\bm{b}}\right\|}_{2}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mi>A</mi><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒃</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|A-{\bm{W}}\Phi(X)-{\bm{b}}\right\|}_{2}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex30Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30Xb.m2" class="ltx_Math" alttext="\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)-\hat{\bm{b}}\right\|}_{2}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mover accent="true"><mi>𝒃</mi><mo>^</mo></mover></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)-\hat{\bm{b}}\right\|}_{2}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex30Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30Xc.m2" class="ltx_Math" alttext="\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}+{\left\|\hat{\bm{b}}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>𝒃</mi><mo>^</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}+{\left\|\hat{\bm{b}}\right\|}_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p4.2" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p4.2.1" class="ltx_text">where <math id="A1.SS3.SSS0.Px1.p4.m2" class="ltx_Math" alttext="\hat{\bm{b}}={\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]-\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]+{\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝒃</mi><mo>^</mo></mover><mo>=</mo><mrow><mrow><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{b}}={\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]-\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]+{\bm{b}}</annotation></semantics></math>. Thus, for any fixed <math id="A1.SS3.SSS0.Px1.p4.m3" class="ltx_Math" alttext="\Phi,{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>,</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">\Phi,{\bm{W}}</annotation></semantics></math>, the optimal <math id="A1.SS3.SSS0.Px1.p4.m4" class="ltx_Math" alttext="{\bm{b}}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]-{\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]" display="inline" intent=":literal"><semantics><mrow><mi>𝒃</mi><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{b}}=\mathbb{E}_{A\sim{P_{\mathcal{A}}}}[A]-{\bm{W}}\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\Phi(X)]</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.SSS0.Px1.p5" class="ltx_para">
<p id="A1.SS3.SSS0.Px1.p5.1" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p5.1.1" class="ltx_text">Assuming, without loss of generality, <math id="A1.SS3.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\tilde{\Phi}_{i}\tilde{\Phi}_{j}]=\delta_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>X</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}_{X\sim{P_{\mathcal{X}}}}[\tilde{\Phi}_{i}\tilde{\Phi}_{j}]=\delta_{ij}</annotation></semantics></math>; otherwise we can perform Gram-Schmidt process on <math id="A1.SS3.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\tilde{\Phi}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{\Phi}_{i}</annotation></semantics></math> and change the value of <math id="A1.SS3.SSS0.Px1.p5.m3" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> respectively. Thus, it suffices to minimize</span></p>
</div>
<div id="A1.SS3.SSS0.Px1.p6" class="ltx_para">
<table id="A1.Ex31" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex31X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex31X.m2" class="ltx_Math" alttext="\displaystyle\hat{\mathcal{R}}(\Phi,{\bm{W}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mi>𝑾</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\mathcal{R}}(\Phi,{\bm{W}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31X.m3" class="ltx_Math" alttext="\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[{\left\|\tilde{A}-{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex31Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31Xa.m2" class="ltx_Math" alttext="\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}{\left\|{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left\langle\tilde{Y},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mover accent="true"><mi>Y</mi><mo>~</mo></mover><mo>,</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}{\left\|{\bm{W}}\tilde{\Phi}(X)\right\|}_{2}^{2}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left\langle\tilde{Y},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex31Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31Xb.m2" class="ltx_Math" alttext="\displaystyle={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left\langle\tilde{A},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mrow><mo>‖</mo><mi>𝑾</mi><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>,</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\left\|{\bm{W}}\right\|}_{F}^{2}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left\langle\tilde{A},{\bm{W}}\tilde{\Phi}(X)\right\rangle}+\underset{A\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left\|\tilde{A}\right\|}_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.SSS0.Px1.p7" class="ltx_para">
<p id="A1.SS3.SSS0.Px1.p7.1" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.1.1" class="ltx_text">Denote <math id="A1.SS3.SSS0.Px1.p7.m1" class="ltx_Math" alttext="{\bm{W}}=(w_{ij})_{1\leq i\leq d_{y},1\leq j\leq d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑾</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>d</mi><mi>y</mi></msub></mrow><mo>,</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>d</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{W}}=(w_{ij})_{1\leq i\leq d_{y},1\leq j\leq d}</annotation></semantics></math>. We have</span></p>
<table id="A1.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex32.m1" class="ltx_Math" alttext="\frac{\partial\hat{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover></mrow><mrow><mo>∂</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mfrac><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\partial\hat{\mathcal{R}}}{\partial w_{ij}}=2w_{ij}-2\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p7.2" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.2.1" class="ltx_text">which implies that for a fixed <math id="A1.SS3.SSS0.Px1.p7.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, the minimizer of <math id="A1.SS3.SSS0.Px1.p7.m3" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> satisfies</span></p>
<table id="A1.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex33.m1" class="ltx_Math" alttext="w_{ij}=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w_{ij}=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;{\left[\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p7.3" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.3.1" class="ltx_text">Combining the minimizer of <math id="A1.SS3.SSS0.Px1.p7.m4" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> with <math id="A1.SS3.SSS0.Px1.p7.m5" class="ltx_Math" alttext="\hat{\mathcal{R}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathcal{R}}</annotation></semantics></math> and notice that <math id="A1.SS3.SSS0.Px1.p7.m6" class="ltx_Math" alttext="\mathbb{E}_{A\sim{P_{\mathcal{A}}}}{\left\|\tilde{A}\right\|}_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>A</mi><mo>∼</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}_{A\sim{P_{\mathcal{A}}}}{\left\|\tilde{A}\right\|}_{2}^{2}</annotation></semantics></math> is a constant, it suffices to maximize</span></p>
<table id="A1.Ex34" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex34X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex34X.m2" class="ltx_Math" alttext="\displaystyle\hat{\mathcal{R}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>^</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle\hat{\mathcal{R}}^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}{\left[\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><msup><mrow><mo>[</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}{\left[\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A\sim P^{+}(\cdot|X)}{\mathbb{E}}\;\tilde{A}_{i}\tilde{\Phi}_{j}(X)\right]}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex34Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34Xa.m2" class="ltx_Math" alttext="\displaystyle=\int\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2}){\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{X}}}(x_{1})P^{+}(a_{1}|x_{1}){P_{\mathcal{X}}}(x_{2})P^{+}(a_{2}|x_{2})dx_{1}da_{1}dx_{2}da_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2}){\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{X}}}(x_{1})P^{+}(a_{1}|x_{1}){P_{\mathcal{X}}}(x_{2})P^{+}(a_{2}|x_{2})dx_{1}da_{1}dx_{2}da_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex34Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34Xb.m2" class="ltx_Math" alttext="\displaystyle=\iint\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo>∬</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder></mstyle><mrow><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\iint\sum_{j}\tilde{\Phi}_{j}(x_{1})\tilde{\Phi}_{j}(x_{2})\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p7.4" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.4.1" class="ltx_text">where</span></p>
<table id="A1.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex35.m1" class="ltx_Math" alttext="\hat{k}(x_{1},x_{2})=\iint{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∬</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{k}(x_{1},x_{2})=\iint{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(a_{1}|x_{1})P^{+}(a_{2}|x_{2})da_{1}da_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p7.5" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.5.1" class="ltx_text">Notice that</span></p>
<table id="A1.Ex36" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex36X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex36X.m2" class="ltx_Math" alttext="\displaystyle\iint\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2}" display="inline" intent=":literal"><semantics><mrow><mo>∬</mo><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo mathsize="0.700em">,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\iint\hat{k}(x_{1},x_{2}){P_{\mathcal{X}}}(x_{1}){P_{\mathcal{X}}}(x_{2})dx_{1}dx_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex36X.m3" class="ltx_Math" alttext="\displaystyle=\int{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(x_{1},a_{1})P^{+}(x_{2},a_{2})dx_{1}da_{1}dx_{2}da_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo mathsize="0.700em">,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo mathsize="0.700em">,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}P^{+}(x_{1},a_{1})P^{+}(x_{2},a_{2})dx_{1}da_{1}dx_{2}da_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex36Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex36Xa.m2" class="ltx_Math" alttext="\displaystyle=\int{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})da_{1}da_{2}=0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>a</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></mrow></mstyle><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int{\left\langle\tilde{a}_{1},\tilde{a}_{2}\right\rangle}{P_{\mathcal{A}}}(a_{1}){P_{\mathcal{A}}}(a_{2})da_{1}da_{2}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p7.6" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p7.6.1" class="ltx_text">thus <math id="A1.SS3.SSS0.Px1.p7.m7" class="ltx_Math" alttext="\Phi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Phi^{*}</annotation></semantics></math> is a minimizer of <math id="A1.SS3.SSS0.Px1.p7.m8" class="ltx_Math" alttext="{\mathcal{R}}(\Phi)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{R}}(\Phi)</annotation></semantics></math> if <math id="A1.SS3.SSS0.Px1.p7.m9" class="ltx_Math" alttext="\tilde{\Phi}^{*}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{*}</annotation></semantics></math> extracts the top-<math id="A1.SS3.SSS0.Px1.p7.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> eigenfunctions of <math id="A1.SS3.SSS0.Px1.p7.m11" class="ltx_Math" alttext="\hat{k}(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{k}(x_{1},x_{2})</annotation></semantics></math>. Combining with <a href="#Thmtheorem18" title="Lemma 18. ‣ Theorem . ‣ A.1 Proof of Theorem ‣ Appendix A Proofs for Section ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">18</span></a> yields the desired results.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proof of Theorem <a href="#Thmtheorem10" title="Theorem 10 (Proof in ). ‣ 3.2 Self-supervised Learning (SSL): Transformation Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></h3>

<section id="A1.SS4.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Theorem <a href="#Thmtheorem10" title="Theorem 10 (Proof in ). ‣ 3.2 Self-supervised Learning (SSL): Transformation Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>.</h5>

<div id="A1.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="A1.SS4.SSS0.Px1.p1.1" class="ltx_p"><math id="A1.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\Psi^{*}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\Psi^{*}</annotation></semantics></math><span id="A1.SS4.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic"> minimizes <math id="A1.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{C}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">C</mi></msub><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{C}}</annotation></semantics></math> or <math id="A1.SS4.SSS0.Px1.p1.m3" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{N}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi mathvariant="normal">N</mi></msub><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{N}}</annotation></semantics></math> if and only if <math id="A1.SS4.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\tilde{\Phi}^{*}=T_{P^{+}}\tilde{\Psi}^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Phi}^{*}=T_{P^{+}}\tilde{\Psi}^{*}</annotation></semantics></math> learns the contexture.</span></p>
</div>
<div id="A1.SS4.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.SSS0.Px1.p2" class="ltx_para">
<p id="A1.SS4.SSS0.Px1.p2.1" class="ltx_p"><span id="A1.SS4.SSS0.Px1.p2.1.1" class="ltx_text">We prove the two cases as follows.</span></p>
<ol id="A1.I1" class="ltx_enumerate">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p">The spectral contrastive loss is</p>
<table id="A1.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex37.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\rm{C}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}+\frac{1}{2}\underset{A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}\right]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ψ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><msup><mi mathsize="0.700em">A</mi><mo mathsize="0.710em">−</mo></msup><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒜</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\rm{C}}(\Psi)=\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\;\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[-{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}+\frac{1}{2}\underset{A^{-}\sim{P_{\mathcal{A}}}}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{-})\right\rangle}^{2}\right]}\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i1.p1.2" class="ltx_p">Suppose <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}=\sum_{j\geq 0}c_{ij}\nu_{j}</annotation></semantics></math> where <math id="A1.I1.i1.p1.m2" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="A1.I1.i1.p1.m3" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> in <a href="#Thmtheorem3" title="Lemma 3 (Duality property, [], Proposition 1). ‣ 2.2 Induced Kernels and Expectation Operator ‣ 2 Definitions and Examples ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3</span></a>. Since <math id="A1.I1.i1.p1.m4" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math> is the ONB of <math id="A1.I1.i1.p1.m5" class="ltx_Math" alttext="L^{2}({P_{\mathcal{A}}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}({P_{\mathcal{A}}})</annotation></semantics></math> and <math id="A1.I1.i1.p1.m6" class="ltx_Math" alttext="\nu_{0}\equiv 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>0</mn></msub><mo>≡</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\nu_{0}\equiv 1</annotation></semantics></math>, we can get for <math id="A1.I1.i1.p1.m7" class="ltx_Math" alttext="j\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j\geq 1</annotation></semantics></math>, <math id="A1.I1.i1.p1.m8" class="ltx_Math" alttext="\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ν</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{P_{\mathcal{A}}}}[\nu_{j}(a)]=\delta_{0,j}=0</annotation></semantics></math>. Thus we can get <math id="A1.I1.i1.p1.m9" class="ltx_Math" alttext="\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{i}=\psi_{i}-\mathbb{E}[\psi_{i}]=\sum_{j\geq 1}c_{ij}\nu_{j}</annotation></semantics></math>.</p>
</div>
<div id="A1.I1.i1.p2" class="ltx_para">
<p id="A1.I1.i1.p2.1" class="ltx_p">Denote matrix <math id="A1.I1.i1.p2.m1" class="ltx_Math" alttext="{\bm{C}}=(c_{ij})_{1\leq i\leq d,j\geq 1}" display="inline" intent=":literal"><semantics><mrow><mi>𝑪</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{C}}=(c_{ij})_{1\leq i\leq d,j\geq 1}</annotation></semantics></math>, matrix <math id="A1.I1.i1.p2.m2" class="ltx_Math" alttext="{\bm{B}}=(b_{ij}):={\bm{C}}^{\top}{\bm{C}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><msup><mi>𝑪</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑪</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}=(b_{ij}):={\bm{C}}^{\top}{\bm{C}}</annotation></semantics></math>, and matrix <math id="A1.I1.i1.p2.m3" class="ltx_Math" alttext="{\bm{D}}={\textnormal{diag}}(s_{1}^{2},s_{2}^{2},\cdots)" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{D}}={\textnormal{diag}}(s_{1}^{2},s_{2}^{2},\cdots)</annotation></semantics></math> where <math id="A1.I1.i1.p2.m4" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math> is the singular value of <math id="A1.I1.i1.p2.m5" class="ltx_Math" alttext="T_{P^{+}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><msup><mi>P</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">T_{P^{+}}</annotation></semantics></math>. We have</p>
