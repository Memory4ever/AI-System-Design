<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38Xa.m2" class="ltx_Math" alttext="\displaystyle=\iiint{\left\langle\tilde{\Psi}(a),\tilde{\Psi}(a^{+})\right\rangle}P^{+}(a|x)P^{+}(a^{+}|x){P_{\mathcal{X}}}(x)dxdada^{+}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∭</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi class="ltx_font_mathcaligraphic">𝒳</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">d</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>+</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\iiint{\left\langle\tilde{\Psi}(a),\tilde{\Psi}(a^{+})\right\rangle}P^{+}(a|x)P^{+}(a^{+}|x){P_{\mathcal{X}}}(x)dxdada^{+}</annotation></semantics></math></td>
