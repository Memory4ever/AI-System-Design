o-width:0.52em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="7.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic1.m57" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -12.65 -38.98)"><foreignObject style="--ltx-fo-width:9.51em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="131.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F4.pic1.3" class="ltx_text">(c) Strong association</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F4.4" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="S5.F4.5" class="ltx_text" style="font-size:90%;">Metric illustration on <span id="S5.F4.5.1" class="ltx_text ltx_font_typewriter">MNIST</span>, similar to <a href="#S5.F3" title="In Derivation of the metric. ‣ 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a>.</span></figcaption>
</figure>
<div id="S5.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="S5.SS2.SSS0.Px1.p3.1" class="ltx_p">Second, we apply the metric to the <span id="S5.SS2.SSS0.Px1.p3.1.1" class="ltx_text ltx_font_typewriter">MNIST</span> dataset.
The context is random cropping with crop ratio <math id="S5.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.
We adjust the association of the context by changing <math id="S5.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.
In particular, we choose <math id="S5.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\alpha=0.5" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\alpha=0.5</annotation></semantics></math> (weak), <math id="S5.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\alpha=0.2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">\alpha=0.2</annotation></semantics></math> (moderate) and <math id="S5.SS2.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\alpha=0.05" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\alpha=0.05</annotation></semantics></math> (strong).
Since kernel PCA is not scalable to datasets as large as MNIST, we instead train a neural network.
Specifically, we train a LeNet <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">LBBH98</a>]</cite> using the non-contrastive learning objective (<math id="S5.SS2.SSS0.Px1.p3.m6" class="ltx_Math" alttext="{\mathcal{L}}_{N}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>N</mi></msub><annotation encoding="application/x-tex">{\mathcal{L}}_{N}</annotation></semantics></math> in <a href="#Thmtheorem10" title="Theorem 10 (Proof in ). ‣ 3.2 Self-supervised Learning (SSL): Transformation Context ‣ 3 Learning the Contexture ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">10</span></a>) and the AdamW optimizer.
Then, we estimate the top eigenvalues using the method in <a href="#A4" title="Appendix D Efficient Estimation of the Context Usefulness Metric ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">D</span></a>.
The downstream task is a binary classification task—whether the digit is greater than 4.
After pretraining, a linear probe is fit on top of <math id="S5.SS2.SSS0.Px1.p3.m7" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> using ridge regression.
The result is plotted in <a href="#S5.F4" title="In Derivation of the metric. ‣ 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<div id="S5.SS2.SSS0.Px1.p4" class="ltx_para">
<p id="S5.SS2.SSS0.Px1.p4.1" class="ltx_p">From <a href="#S5.F4" title="In Derivation of the metric. ‣ 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">4</span></a>, we can see that when the association is not too strong, <math id="S5.SS2.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\tau_{d}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\tau_{d}</annotation></semantics></math> first decreases and then increases, similar to <a href="#S5.F3" title="In Derivation of the metric. ‣ 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a>.
However, on <span id="S5.SS2.SSS0.Px1.p4.1.1" class="ltx_text ltx_font_typewriter">MNIST</span>, the downstream error monotonically decreases with <math id="S5.SS2.SSS0.Px1.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, unlike <span id="S5.SS2.SSS0.Px1.p4.1.2" class="ltx_text ltx_font_typewriter">abalone</span>.
This disparity is due to the difference between the two downstream tasks.
To demonstrate this, in <a href="#S5.F5" title="In Derivation of the metric. ‣ 5.2 Task-agnostic Evaluation of Contexts ‣ 5 Context Evaluation ‣ Contextures: Representations from Contexts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a> we plot the cosine similarity between the target function <math id="S5.SS2.SSS0.Px1.p4.m3" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> and the estimated <math id="S5.SS2.SSS0.Px1.p4.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th eigenfunction on the two datasets.
We can see that the variance of <math id="S5.SS2.SSS0.Px1.p4.m5" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> on <span id="S5.SS2.SSS0.Px1.p4.1.3" class="ltx_text ltx_font_typewriter">abalone</span> is mostly concentrated on the top-<math id="S5.SS2.SSS0.Px1.p4.m6" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> eigenfunctions, with the first cosine similarity being almost <math id="S5.SS2.SSS0.Px1.p4.m7" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math>.
In contrast, the variance of <math id="S5.SS2.SSS0.Px1.p4.m8" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> on <span id="S5.SS2.SSS0.Px1.p4.1.4" class="ltx_text ltx_font_typewriter">MNIST</span> is more scattered, and the cosine similarity is still close to <math id="S5.SS2.SSS0.Px1.p4.m9" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math> for the <math id="S5.SS2.SSS0.Px1.p4.m10" class="ltx_Math" alttext="150" display="inline" intent=":literal"><semantics><mn>150</mn><annotation encoding="application/x-tex">150</annotation></semantics></math>-th eigenfunction.
Consequently, having a large <math id="S5.SS2.SSS0.Px1.p4.m11" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> on <span id="S5.SS2.SSS0.Px1.p4.1.5" class="ltx_text ltx_font_typewriter">abalone</span> will have a little impact on the approximation error but will increase the estimation error significantly.
On the other hand, having a larger <math id="S5.SS2.SSS0.Px1.p4.m12" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> on <span id="S5.SS2.SSS0.Px1.p4.1.6" class="ltx_text ltx_font_typewriter">MNIST</span> will decrease the approximation error more than it increases the estimation error, which is why the total error monotonically decreases with <math id="S5.SS2.SSS0.Px1.p4.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</p>
</div>
