<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex38X.m2" class="ltx_Math" alttext="\displaystyle\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">X</mi><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">P</mi><mi class="ltx_font_mathcaligraphic" mathsize="0.710em">𝒳</mi></msub></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">A</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">A</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">P</mi><msup><mrow></mrow><mo mathsize="0.710em">+</mo></msup><mo maxsize="0.700em" minsize="0.700em">(</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">X</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>⟨</mo><mrow><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{X\sim{P_{\mathcal{X}}}}{\mathbb{E}}\underset{A,A^{+}\sim P^{+}(\cdot|X)}{\mathbb{E}}{\left[{\left\langle\tilde{\Psi}(A),\tilde{\Psi}(A^{+})\right\rangle}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
