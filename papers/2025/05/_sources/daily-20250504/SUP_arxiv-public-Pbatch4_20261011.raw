        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.03821">pdf</a>, <a href="https://arxiv.org/ps/2505.03821">ps</a>, <a href="https://arxiv.org/format/2505.03821">other</a>]&nbsp;</span>
