        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.03824">pdf</a>, <a href="https://arxiv.org/ps/2505.03824">ps</a>, <a href="https://arxiv.org/format/2505.03824">other</a>]&nbsp;</span>
