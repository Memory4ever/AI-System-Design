<td id="S4.T8.32.12.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">Overall</td>
<td id="S4.T8.32.12.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">61.29</td>
<td id="S4.T8.32.12.3" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t">49.68</td>
<td id="S4.T8.32.12.4" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">7.74</td>
