<td id="S3.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m1" class="ltx_Math" alttext="1133" display="inline" intent=":literal"><semantics><mn>1133</mn><annotation encoding="application/x-tex">1133</annotation></semantics></math></td>
<td id="S3.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m2" class="ltx_Math" alttext="6290" display="inline" intent=":literal"><semantics><mn>6290</mn><annotation encoding="application/x-tex">6290</annotation></semantics></math></td>
<td id="S3.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m3" class="ltx_Math" alttext="7423" display="inline" intent=":literal"><semantics><mn>7423</mn><annotation encoding="application/x-tex">7423</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
<td id="S3.T2.2.3.1" class="ltx_td ltx_align_left"><span id="S3.T2.2.3.1.1" class="ltx_text ltx_font_bold">#Val Videos</span></td>
<td id="S3.T2.2.3.2" class="ltx_td ltx_align_center"><math id="S3.T2.m4" class="ltx_Math" alttext="141" display="inline" intent=":literal"><semantics><mn>141</mn><annotation encoding="application/x-tex">141</annotation></semantics></math></td>
<td id="S3.T2.2.3.3" class="ltx_td ltx_align_center"><math id="S3.T2.m5" class="ltx_Math" alttext="786" display="inline" intent=":literal"><semantics><mn>786</mn><annotation encoding="application/x-tex">786</annotation></semantics></math></td>
<td id="S3.T2.2.3.4" class="ltx_td ltx_align_center"><math id="S3.T2.m6" class="ltx_Math" alttext="927" display="inline" intent=":literal"><semantics><mn>927</mn><annotation encoding="application/x-tex">927</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.4" class="ltx_tr">
<td id="S3.T2.2.4.1" class="ltx_td ltx_align_left"><span id="S3.T2.2.4.1.1" class="ltx_text ltx_font_bold">#Test Videos</span></td>
<td id="S3.T2.2.4.2" class="ltx_td ltx_align_center"><math id="S3.T2.m7" class="ltx_Math" alttext="143" display="inline" intent=":literal"><semantics><mn>143</mn><annotation encoding="application/x-tex">143</annotation></semantics></math></td>
<td id="S3.T2.2.4.3" class="ltx_td ltx_align_center"><math id="S3.T2.m8" class="ltx_Math" alttext="787" display="inline" intent=":literal"><semantics><mn>787</mn><annotation encoding="application/x-tex">787</annotation></semantics></math></td>
<td id="S3.T2.2.4.4" class="ltx_td ltx_align_center"><math id="S3.T2.m9" class="ltx_Math" alttext="930" display="inline" intent=":literal"><semantics><mn>930</mn><annotation encoding="application/x-tex">930</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.5" class="ltx_tr">
<td id="S3.T2.2.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T2.2.5.1.1" class="ltx_text ltx_font_bold">#Train Questions</span></td>
<td id="S3.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m10" class="ltx_Math" alttext="5601" display="inline" intent=":literal"><semantics><mn>5601</mn><annotation encoding="application/x-tex">5601</annotation></semantics></math></td>
<td id="S3.T2.2.5.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m11" class="ltx_Math" alttext="161\,901" display="inline" intent=":literal"><semantics><mn>161 901</mn><annotation encoding="application/x-tex">161\,901</annotation></semantics></math></td>
<td id="S3.T2.2.5.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m12" class="ltx_Math" alttext="167\,502" display="inline" intent=":literal"><semantics><mn>167 502</mn><annotation encoding="application/x-tex">167\,502</annotation></semantics></math></td></tr>
