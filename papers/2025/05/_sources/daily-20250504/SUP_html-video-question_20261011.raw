<td id="S3.T2.2.6.1" class="ltx_td ltx_align_left"><span id="S3.T2.2.6.1.1" class="ltx_text ltx_font_bold">#Val Questions</span></td>
<td id="S3.T2.2.6.2" class="ltx_td ltx_align_center"><math id="S3.T2.m13" class="ltx_Math" alttext="726" display="inline" intent=":literal"><semantics><mn>726</mn><annotation encoding="application/x-tex">726</annotation></semantics></math></td>
