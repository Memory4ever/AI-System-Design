<td id="S3.T2.2.6.4" class="ltx_td ltx_align_center"><math id="S3.T2.m15" class="ltx_Math" alttext="22\,696" display="inline" intent=":literal"><semantics><mn>22 696</mn><annotation encoding="application/x-tex">22\,696</annotation></semantics></math></td></tr>
