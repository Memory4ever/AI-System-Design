<td id="S3.T2.2.7.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T2.2.7.1.1" class="ltx_text ltx_font_bold">#Test Questions</span></td>
<td id="S3.T2.2.7.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T2.m16" class="ltx_Math" alttext="680" display="inline" intent=":literal"><semantics><mn>680</mn><annotation encoding="application/x-tex">680</annotation></semantics></math></td>
<td id="S3.T2.2.7.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T2.m17" class="ltx_Math" alttext="20\,342" display="inline" intent=":literal"><semantics><mn>20 342</mn><annotation encoding="application/x-tex">20\,342</annotation></semantics></math></td>
