<td id="S4.T8.32.12.6" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">36.13</td>
<td id="S4.T8.32.12.7" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">1.94</td>
<td id="S4.T8.32.12.8" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">8.39</td>
