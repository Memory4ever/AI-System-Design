      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jianguo Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yong%2C+L">Liang Yong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luo%2C+J">Jiebo Luo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luo%2C+S">Shengda Luo</a>
      
