<td id="A0.T2.4.5.2" class="ltx_td ltx_align_left" style="padding:0.4pt 11.0pt;"><span id="A0.T2.4.5.2.1" class="ltx_text ltx_font_italic">Book of Han</span></td>
<td id="A0.T2.4.5.3" class="ltx_td ltx_align_left" style="padding:0.4pt 11.0pt;">Ban Gu, et al.</td>
<td id="A0.T2.4.5.4" class="ltx_td ltx_align_left" style="padding:0.4pt 11.0pt;">80 CE</td>
<td id="A0.T2.4.5.5" class="ltx_td ltx_align_left" style="padding:0.4pt 11.0pt;">Eastern Han</td></tr>
