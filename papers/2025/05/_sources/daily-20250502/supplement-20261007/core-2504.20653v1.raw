<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">671B</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">47.27%</td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">63.64%</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<th id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">GPT-3.5</th>
