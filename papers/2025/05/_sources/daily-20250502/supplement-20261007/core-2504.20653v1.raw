<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r">34.55%</td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_r">58.18%</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<th id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">GPT-4o</th>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r">N/A</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r">45.45%</td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center ltx_border_r">69.09%</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<th id="S4.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">CodeV <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite></th>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">7B</td>
<td id="S4.T2.2.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">20.00%</td>
<td id="S4.T2.2.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">29.09%</td></tr>
<tr id="S4.T2.2.6" class="ltx_tr">
<th id="S4.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">RTLCoder <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></th>
