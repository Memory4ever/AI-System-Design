</span></th>
<td id="S4.T4.2.13.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T4.2.13.2.1" class="ltx_text" style="font-size:80%;">2.72%</span></td>
<td id="S4.T4.2.13.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T4.2.13.3.1" class="ltx_text ltx_underline ltx_font_bold" style="font-size:80%;">1.45%</span></td>
<td id="S4.T4.2.13.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T4.2.13.4.1" class="ltx_text" style="font-size:80%;">3.20%</span></td>
<td id="S4.T4.2.13.5" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T4.2.13.5.1" class="ltx_text" style="font-size:80%;">5.01%</span></td>
