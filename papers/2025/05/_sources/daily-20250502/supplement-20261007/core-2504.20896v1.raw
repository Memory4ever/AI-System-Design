<td id="S4.T1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.2.3.1" class="ltx_text" style="font-size:90%;">71.3%</span></td>
<td id="S4.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.2.4.1" class="ltx_text" style="font-size:90%;">12%</span></td>
