        <span>&nbsp;[<a href="https://arxiv.org/pdf/2504.21561">pdf</a>, <a href="https://arxiv.org/ps/2504.21561">ps</a>, <a href="https://arxiv.org/format/2504.21561">other</a>]&nbsp;</span>
