<th id="S5.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S5.T3.5.1.2.1" class="ltx_text ltx_font_bold">Param.</span></th>
<th id="S5.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S5.T3.5.1.3.1" class="ltx_text ltx_font_bold">Acc.W. (%)</span></th>
