<th id="S5.T6.5.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">MAE</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T6.5.3" class="ltx_tr">
<th id="S5.T6.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><math id="S5.T6.m1" class="ltx_Math" alttext="46(204)" display="inline" intent=":literal"><semantics><mrow><mn>46</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>204</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">46(204)</annotation></semantics></math></th>
