<td id="S5.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">25.5</td>
<td id="S5.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">39.8</td></tr>
<tr id="S5.T3.5.3" class="ltx_tr">
<th id="S5.T3.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">LBLM<sub id="S5.T3.5.3.1.1" class="ltx_sub"><span id="S5.T3.5.3.1.1.1" class="ltx_text ltx_font_italic">C</span></sub></th>
