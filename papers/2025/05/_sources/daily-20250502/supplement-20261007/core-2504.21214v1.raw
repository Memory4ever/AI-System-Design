<th id="S5.T6.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">MAE</th>
<th id="S5.T6.5.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">MSE</th>
