<th id="S5.T6.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" colspan="2">LBLM (Ours)</th>
