        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.00979">pdf</a>, <a href="https://arxiv.org/ps/2505.00979">ps</a>, <a href="https://arxiv.org/format/2505.00979">other</a>]&nbsp;</span>
