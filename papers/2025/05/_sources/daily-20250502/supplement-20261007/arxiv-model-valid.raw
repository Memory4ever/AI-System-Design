      <a href="/search/?searchtype=author&amp;query=Murali%2C+A">Abhejay Murali</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+K">Kevin Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Atkinson%2C+D">David Atkinson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dhurandhar%2C+A">Amit Dhurandhar</a>
      
