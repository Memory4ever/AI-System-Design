      <a href="/search/?searchtype=author&amp;query=Matejek%2C+B">Brian Matejek</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Berenbeim%2C+A+M">Alexander M. Berenbeim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bastian%2C+N+D">Nathaniel D. Bastian</a>, 
      
