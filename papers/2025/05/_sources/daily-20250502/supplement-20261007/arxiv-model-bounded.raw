      <a href="/search/?searchtype=author&amp;query=Ramparany%2C+F">Fano Ramparany</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Vaufreydaz%2C+D">Dominique Vaufreydaz</a>
      
