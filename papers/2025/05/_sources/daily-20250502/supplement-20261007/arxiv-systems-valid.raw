        <span>&nbsp;[<a href="https://arxiv.org/pdf/2505.00972">pdf</a>, <a href="https://arxiv.org/ps/2505.00972">ps</a>, <a href="https://arxiv.org/format/2505.00972">other</a>]&nbsp;</span>
