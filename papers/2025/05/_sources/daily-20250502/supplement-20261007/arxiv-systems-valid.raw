        <span>&nbsp;[<a href="https://arxiv.org/pdf/2504.21668">pdf</a>, <a href="https://arxiv.org/ps/2504.21668">ps</a>, <a href="https://arxiv.org/format/2504.21668">other</a>]&nbsp;</span>
