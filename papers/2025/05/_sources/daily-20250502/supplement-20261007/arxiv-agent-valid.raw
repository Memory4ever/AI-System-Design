      <a href="/search/?searchtype=author&amp;query=He%2C+L">Langzhou He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+Y">Yangning Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+D">Dongyuan Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jiang%2C+R">Renhe Jiang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+X">Xue Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+P+S">Philip S. Yu</a>
      
