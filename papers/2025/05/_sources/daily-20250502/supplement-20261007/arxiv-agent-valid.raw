      <a href="/search/?searchtype=author&amp;query=Fang%2C+L">Liancheng Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+H">Hanrong Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+F">Fangxin Wang</a>, 
      
