n></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.02)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 9.81 0)"><foreignObject style="--ltx-fo-width:1.19em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="9.89" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="15.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch34.F4.pic1.m7" class="ltx_Math" alttext="\Sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em" mathvariant="normal">Σ</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">\Sigma_{1}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 258.26 -220.16 C 258.26 -200.6 233.58 -184.73 203.14 -184.73 C 172.7 -184.73 148.02 -200.6 148.02 -220.16 C 148.02 -239.73 172.7 -255.6 203.14 -255.6 C 233.58 -255.6 258.26 -239.73 258.26 -220.16 Z M 203.14 -220.16"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 185.7 -227.98)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 18.4)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:2.72em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="34.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch34.F4.pic1.3" class="ltx_text" style="font-size:90%;">Sector</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.02)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 9.81 0)"><foreignObject style="--ltx-fo-width:1