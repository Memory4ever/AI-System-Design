container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.20" class="ltx_text" style="font-size:90%;">Sensory Data </span><math id="Ch7.F1.pic1.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -108.97 -143.39 L -196.32 -143.39 C -199.38 -143.39 -201.86 -145.87 -201.86 -148.93 L -201.86 -173.29 C -201.86 -176.35 -199.38 -178.83 -196.32 -178.83 L -108.97 -178.83 C -105.91 -178.83 -103.43 -176.35 -103.43 -173.29 L -103.43 -148.93 C -103.43 -145.87 -105.91 -143.39 -108.97 -143.39 Z M -201.86 -178.83"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -188.02 -170.38)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 23.38)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.34)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.56em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="71.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.21" class="ltx_text" style="font-size:90%;">Simulation /</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.96)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 1.78 0)"><foreignObject style="--ltx-fo-width:5.25em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="67.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.22" class="ltx_text" style="font-size:90%;">Imagination</span></span></span></foreignObject></g></g></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -90.76 -197.1 L -178.12 -197.1 C -181.17 -197.1 -183.65 -199.57 -183.65 -202.63 L -183.65 -226.99 C -183.65 -230.05 -181.17 -232.53 -178.12 -232.53 L -90.76 -232.53 C -87.7 -232.53 -85.22 -230.05 -85.22 -226.99 L -85.22 -202.63 C -85.22 -199.57 -87.7 -197.1 -90.76 -197.1 Z M -183.65 -232.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -162.44 -219.14)"><foreignObject style="--ltx-fo-width:4.38em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="56.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.23" class="ltx_text" style="font-size:90%;">Reflection</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -101.66 -250.8 L -189.01 -250.8 C -192.07 -250.8 -194.55 -253.28 -194.55 -256.33 L -194.55 -280.7 C -194.55 -283.75 -192.07 -286.23 -189.01 -286.23 L -101.66 -286.23 C -98.6 -286.23 -96.12 -283.75 -96.12 -280.7 L -96.12 -256.33 C -96.12 -253.28 -98.6 -250.8 -101.66 -250.8 Z M -194.55 -286.23"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -170.6 -272.84)"><foreignObject style="--ltx-fo-width:3.95em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="50.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.24" class="ltx_text" style="font-size:90%;">Inference</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 201.54 -197.1 L 90.76 -197.1 C 87.7 -197.1 85.22 -199.57 85.22 -202.63 L 85.22 -226.99 C 85.22 -230.05 87.7 -232.53 90.76 -232.53 L 201.54 -232.53 C 204.6 -232.53 207.08 -230.05 207.08 -226.99 L 207.08 -202.63 C 207.08 -199.57 204.6 -197.1 201.54 -197.1 Z M 85.22 -232.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 89.84 -225.36)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.34)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.8em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="112.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.25" class="ltx_text" style="font-size:90%;">Spontaneous Drift /</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.1)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 21.12 0)"><foreignObject style="--ltx-fo-width:5.5em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="70.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch7.F1.pic1.26" class="ltx_text" style="font-size:90%;">Stabilization</span></span></span></foreignObject></g></g></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 189.01 -250.8 L 101.66 -250.8 C 98.6 -250.8 96.12 -253.28 96.12 -256.33 L 96.12