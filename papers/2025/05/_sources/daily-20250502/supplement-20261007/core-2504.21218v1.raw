1.3" class="ltx_text" style="font-size:90%;">Meta-Belief Formation</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 14.82 0)"><foreignObject style="--ltx-fo-width:7.58em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="96.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch29.F2.pic1.4" class="ltx_text" style="font-size:90%;">(Error/Anomaly)</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 63.95 -51.18 L -63.95 -51.18 C -67.77 -51.18 -70.87 -54.28 -70.87 -58.1 L -70.87 -91.51 C -70.87 -95.33 -67.77 -98.42 -63.95 -98.42 L 63.95 -98.42 C 67.77 -98.42 70.87 -95.33 70.87 -91.51 L 70.87 -58.1 C 70.87 -54.28 67.77 -51.18 63.95 -51.18 Z M -70.87 -98.42"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -52.56 -81.29)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.89)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.3em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="106.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch29.F2.pic1.5" class="ltx_text" style="font-size:90%;">Trigger Regulation</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.43)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 27.96 0)"><foreignObject style="--ltx-fo-width:3.84em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.27em;fon