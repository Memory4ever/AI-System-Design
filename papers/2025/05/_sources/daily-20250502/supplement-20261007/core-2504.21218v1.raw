<span id="Ch27.F2.pic1.4.2" class="ltx_p"><math id="Ch27.F2.pic1.m3" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 307.09 216.54)"><foreignObject style="--ltx-fo-width:5.94em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="82.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
