</div></li>
<li id="A1.S2.I1.ix10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.S2.I1.ix10.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math></span> 
<div id="A1.S2.I1.ix10.p1" class="ltx_para">
<p id="A1.S2.I1.ix10.p1.1" class="ltx_p">Null state; <math id="A1.S2.I1.ix10.p1.m1" class="ltx_Math" alttext="\omega\in\Omega" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow><annotation encoding="application/x-tex">\omega\in\Omega</annotation></semantics></math>.</p>
</div></li>
<li id="A1.S2.I1.ix11" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="A1.S2.I1.ix11.m1" class="ltx_Math" alttext="\omega^{(\infty)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(\infty)}</annotation></semantics></math></span> 
<div id="A1.S2.I1.ix11.p1" class="ltx_para">
<p id="A1.S2.I1.ix11.p1.1" class="ltx_p">Semantic singularity of <math id="A1.S2.I1.ix11.p1.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</section>
