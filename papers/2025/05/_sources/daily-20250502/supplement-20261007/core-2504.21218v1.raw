0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="152"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch34.F4.pic1.4" class="ltx_text" style="font-size:90%;">Refined Semantic Manifold</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.48)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 65.22 0)"><foreignObject style="--ltx-fo-width:1.66em;--ltx-fo-height:0.92em;--ltx-fo-depth:0em;font-size:9.25pt;" height="11.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.83)" width="21.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch34.F4.pic1.m9" class="ltx_Math" alttext="\Phi^{[\theta]}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em" mathvariant="normal">Φ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">θ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{[\theta]}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -45.66 -256.15 L -7.87 -269.38"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.94386 -0.33034 0.33034 0.94386 -10.87 -268.33)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 203.14 -256.15 L 165.36 -269.38"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.94386 -0.33034 0.33034 -0.94386 168.35 -268.33)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch34.F4.3" class="ltx_text" style="font-size:90%;">Figure 34.4</span>. </span><span id="Ch34.F4.4" class="ltx_text" style="font-size:90%;">Learning semantic structures. Raw belief fragments <math id="Ch34.F4.m5" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math> are processed through metric learning (<math id="Ch34.F4.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>), leading to the emergence of sectors (<math id="Ch34.F4.m7" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>) and refinement of the semantic manifold <math id="Ch34.F4.m8" class="ltx_Math" alttext="\Phi^{[\theta]}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{[\theta]}</annotation></semantics></math>.</span></figcaption>
</figure>
</section>
<section id="Ch34.S6" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">34.6. </span>Conclusion: Towards a Learned Mind-Space</h4>

<div id="Ch34.S6.p1" class="ltx_para">
<p id="Ch34.S6.p1.1" class="ltx_p">This chapter initiated the exploration of learning within the Semantic Manifold framework by focusing on its foundational structures. We argued that for agents to achieve true adaptability and sophisticated understanding, the semantic metric <math id="Ch34.S6.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, the functional organization into sectors <math id="Ch34.S6.p1.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, and potentially even the underlying geometry of the belief space <math id="Ch34.S6.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> should not be entirely fixed but should emerge from or be refined by learning processes, driven by objectives like improving task performance, coherence, or representational efficiency.</p>
</div>
<div id="Ch34.S6.p2" class="ltx_para">
<p id="Ch34.S6.p2.1" class="ltx_p">We outlined potential mechanisms drawing on machine learning techniques like contrastive learning, metric learning, clustering, and modular training, emphasizing the dependence on the chosen representation mode <math id="Ch34.S6.p2.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>. While significant challenges remain, particularly in learning manifold geometry, incorporating structural plasticity moves the framework towards modeling agents whose internal representational landscape—their very "mind-space"—is dynamically shaped by their interactions with the world. The following chapters will build on this by exploring how the cognitive operators themselves can be learned.</p>
</div>
<section id="Ch34.S6.SSx1" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection">Chapter Summary</h5>

<div id="Ch34.S6.SSx1.p1" class="ltx_para">
<p id="Ch34.S6.SSx1.p1.1" class="ltx_p">This chapter begins the exploration of learning and adaptation within the Semantic Manifold framework, shifting focus from dynamics within a fixed structure to the potential plasticity of the structure itself. It proposes that core structural components of the belief space <math id="Ch34.S6.SSx1.p1.m1" class="ltx_Math" alttext="\Phi^{[\theta]}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">[</mo><mi>θ</mi><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{[\theta]}</annotation></semantics></math>—specifically the semantic distance metric (<math id="Ch34.S6.SSx1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>) and the functional organization into semantic sectors (<math id="Ch34.S6.SSx1.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>)—can be learned or refined through experience, rather than being entirely predefined. The chapter discusses potential mechanisms for this structural learning, emphasizing their dependence on the chosen representation mode (<math id="Ch34.S6.SSx1.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>). For instance, learning <math id="Ch34.S6.SSx1.p1.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> might involve contrastive representation learning or metric learning if <math id="Ch34.S6.SSx1.p1.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is embedding-based, while sector emergence (<math id="Ch34.S6.SSx1.p1.m7" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>) could result from activity correlation, clustering, or task-driven specialization. The more speculative possibility of adapting the underlying manifold geometry is also considered. The overall objective of learning semantic structures is to optimize the internal representational space <math id="Ch34.S6.SSx1.p1.m8" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> itself for improved cognitive efficiency, coherence, and task performance.</p>
</div>
</section>
</section>
</section>
<section id="Ch35" class="ltx_chapter">
<h3 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 35 </span>Learning Cognitive Operators</h3>

<section id="Ch35.S1" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">35.1. </span>Introduction: From Fixed Functions to Learned Processes</h4>

<div id="Ch35.S1.p1" class="ltx_para">
<p id="Ch35.S1.p1.1" class="ltx_p">Chapter <a href="#Ch34" title="Chapter 34 Learning Semantic Structures ‣ Part IX Learning and Adaptation ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a> explored the potential for learning the foundational structures of the semantic state space <math id="Ch35.S1.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, including its metric <math id="Ch35.S1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and sectoral organization <math id="Ch35.S1.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. However, the cognitive architecture defined by the Semantic Manifold framework relies equally on a suite of dynamic operators—Assimilation (<math id="Ch35.S1.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>), Meta-Assimilation (<math id="Ch35.S1.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>), Nullification (<math id="Ch35.S1.p1.m6" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>), Annihilation (<math id="Ch35.S1.p1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>), Abstraction (<math id="Ch35.S1.p1.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>), Elaboration (<math id="Ch35.S1.p1.m9" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>), Retrieval (<math id="Ch35.S1.p1.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>), and Querying (<math id="Ch35.S1.p1.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>)—that manipulate beliefs within this space.</p>
</div>
<div id="Ch35.S1.p2" class="ltx_para">
<p id="Ch35.S1.p2.1" class="ltx_p">A truly adaptive agent likely cannot rely on entirely fixed, pre-specified operators; these processes themselves must be learnable or adaptable based on experience and task demands. This chapter investigates how these core cognitive operators might be acquired or refined through learning. We consider mechanisms drawn from machine learning that could allow an agent to develop effective strategies for integrating information (<math id="Ch35.S1.p2.m1" class="ltx_Math" alttext="A,M" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">A,M</annotation></semantics></math>), navigating abstraction levels (<math id="Ch35.S1.p2.m2" class="ltx_Math" alttext="\Lambda,V" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>,</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\Lambda,V</annotation></semantics></math>), accessing memory (<math id="Ch35.S1.p2.m3" class="ltx_Math" alttext="R,Q" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>,</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">R,Q</annotation></semantics></math>), and potentially even tuning decay (<math id="Ch35.S1.p2.m4" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>) or conflict resolution (<math id="Ch35.S1.p2.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) based on its interactions and internal evaluations.</p>
</div>
<div id="Ch35.S1.p3" class="ltx_para">
<p id="Ch35.S1.p3.1" class="ltx_p">The ability to learn these operators is crucial for tailoring the agent’s cognitive dynamics to its specific environment and goals, moving beyond hardcoded processing logic. As with structural learning, the feasibility and specific methods depend significantly on the agent’s parameterization <math id="Ch35.S1.p3.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, particularly the representation mode <math id="Ch35.S1.p3.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.</p>
</div>
<figure id="Ch35.F1" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch35.F1.pic1" class="ltx_picture ltx_centering" height="200.17" overflow="visible" version="1.1" viewBox="0 0 564.65 200.17" width="564.65"><g style="--ltx-stroke-color:#000000;" stroke="#000000" transform="translate(0,200.17) matrix(1 0 0 -1 0 0) translate(268.99,0) translate(0,100.09)"><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" stroke-width="0.8pt"><path d="M 53.09 19.69 L -53.09 19.69 C -57.67 19.69 -61.39 15.97 -61.39 11.38 L -61.39 -11.38 C -61.39 -15.97 -57.67 -19.69 -53.09 -19.69 L 53.09 -19.69 C 57.67 -19.69 61.39 -15.97 61.39 -11.38 L 61.39 11.38 C 61.39 15.97 57.67 19.69 53.09 19.69 Z M -61.39 -19.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -56.78 -3.04)"><foreignObject style="--ltx-fo-width:8.87em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="113.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F1.pic1.1" class="ltx_text" style="font-size:90%;">Cognitive Operators</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><g stroke-width="0.8pt"><path style="fill:none" d="M -118.04 99.53 L -260.14 99.53 C -264.72 99.53 -268.44 95.82 -268.44 91.23 L -268.44 68.46 C -268.44 63.88 -264.72 60.16 -260.14 60.16 L -118.04 60.16 C -113.46 60.16 -109.74 63.88 -109.74 68.46 L -109.74 91.23 C -109.74 95.82 -113.46 99.53 -118.04 99.53 Z M -268.44 60.16"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -263.83 71.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 60.24 0)"><foreignObject style="--ltx-fo-width:2.27em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F1.pic1.m1" class="ltx_Math" alttext="A,M" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">A</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">M</mi></mrow><annotation encoding="application/x-tex">A,M</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.58)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="149.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F1.pic1.2" class="ltx_text" style="font-size:90%;">Learn Coherence, Revision</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 286.81 99.53 L 118.04 99.53 C 113.46 99.53 109.74 95.82 109.74 91.23 L 109.74 68.46 C 109.74 63.88 113.46 60.16 118.04 60.16 L 286.81 60.16 C 291.39 60.16 295.11 63.88 295.11 68.46 L 295.11 91.23 C 295.11 95.82 291.39 99.53 286.81 99.53 Z M 109.74 60.16"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 114.35 71.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 75.63 0)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="24.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F1.pic1.m2" class="ltx_Math" alttext="\Lambda,V" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Λ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">V</mi></mrow><annotation encoding="application/x-tex">\Lambda,V</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.58)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:13.73em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="175.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F1.pic1.3" class="ltx_text" style="font-size:90%;">Learn Abstraction, Elaboration</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -118.04 -60.16 L -256.89 -60.16 C -261.47 -60.16 -265.19 -63.88 -265.19 -68.46 L -265.19 -91.23 C -265.19 -95.82 -261.47 -99.53 -256.89 -99.53 L -118.04 -99.53 C -113.46 -99.53 -109.74 -95.82 -109.74 -91.23 L -109.74 -68.46 C -109.74 -63.88 -113.46 -60.16 -118.04 -60.16 Z M -265.19 -99.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -260.58 -88.43)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 60.34 0)"><foreignObject style="--ltx-fo-width:2em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="25.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F1.pic1.m3" class="ltx_Math" alttext="R,Q" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">R</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">Q</mi></mrow><annotation encoding="application/x-tex">R,Q</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.58)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.48em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="146.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F1.pic1.4" class="ltx_text" style="font-size:90%;">Learn Retrieval, Querying</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 257.89 -60.16 L 118.04 -60.16 C 113.46 -60.16 109.74 -63.88 109.74 -68.46 L 109.74 -91.23 C 109.74 -95.82 113.46 -99.53 118.04 -99.53 L 257.89 -99.53 C 262.47 -99.53 266.19 -95.82 266.19 -91.23 L 266.19 -68.46 C 266.19 -63.88 262.47 -60.16 257.89 -60.16 Z M 109.74 -99.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 114.35 -88.43)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 56.69 0)"><foreignObject style="--ltx-fo-width:2.64em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="33.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F1.pic1.m4" class="ltx_Math" alttext="N_{t},K" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi></mrow><annotation encoding="application/x-tex">N_{t},K</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.58)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.61em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="148.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F1.pic1.5" class="ltx_text" style="font-size:90%;">Learn Decay, Annihilation</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -47.93 20.24 L -135.7 57.29"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.92128 0.38892 -0.38892 -0.92128 -132.78 56.06)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 51.31 20.24 L 145.6 57.42"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.93028 0.36684 -0.36684 0.93028 142.65 56.26)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -47.52 -20.24 L -134.49 -57.27"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.92007 -0.39175 0.39175 -0.92007 -131.58 -56.03)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 47.64 -20.24 L 134.86 -57.28"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.92044 -0.39088 0.39088 0.92044 131.94 -56.04)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch35.F1.3" class="ltx_text" style="font-size:90%;">Figure 35.1</span>. </span><span id="Ch35.F1.4" class="ltx_text" style="font-size:90%;">Learning pathways for core cognitive operators within the Semantic Manifold framework. Each operator (Assimilation <math id="Ch35.F1.m9" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, Meta-Assimilation <math id="Ch35.F1.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, Abstraction <math id="Ch35.F1.m11" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, Elaboration <math id="Ch35.F1.m12" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, Retrieval <math id="Ch35.F1.m13" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, Querying <math id="Ch35.F1.m14" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, and decay processes <math id="Ch35.F1.m15" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>, <math id="Ch35.F1.m16" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) is associated with specific machine learning techniques enabling their refinement through experience.</span></figcaption>
</figure>
</section>
<section id="Ch35.S2" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">35.2. </span>Learning Abstraction (<math id="Ch35.S2.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>) and Elaboration (<math id="Ch35.S2.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>)</h4>

<div id="Ch35.S2.p1" class="ltx_para">
<p id="Ch35.S2.p1.1" class="ltx_p">The scaling operators <math id="Ch35.S2.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> (specific to general) and <math id="Ch35.S2.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> (general to specific) are central to managing complexity and connecting different levels of understanding. Learning these operators involves acquiring the ability to perform meaningful generalization and instantiation.</p>
</div>
<figure id="Ch35.F2" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch35.F2.pic1" class="ltx_picture ltx_centering" height="200.17" overflow="visible" version="1.1" viewBox="0 0 288.64 200.17" width="288.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,200.17) matrix(1 0 0 -1 0 0) translate(68.06,0) translate(0,179.93)"><g stroke-width="0.8pt"><path style="fill:none" d="M 46.82 19.69 L -46.82 19.69 C -51.4 19.69 -55.12 15.97 -55.12 11.38 L -55.12 -11.38 C -55.12 -15.97 -51.4 -19.69 -46.82 -19.69 L 46.82 -19.69 C 51.4 -19.69 55.12 -15.97 55.12 -11.38 L 55.12 11.38 C 55.12 15.97 51.4 19.69 46.82 19.69 Z M -55.12 -19.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -40.09 -9.03)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.9)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.27em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="80.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F2.pic1.1" class="ltx_text" style="font-size:90%;">Detailed State</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.48)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 28.77 0)"><foreignObject style="--ltx-fo-width:1.77em;--ltx-fo-height:0.92em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="14.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.83)" width="22.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F2.pic1.m1" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ϕ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 211.67 19.69 L 103.9 19.69 C 99.31 19.69 95.6 15.97 95.6 11.38 L 95.6 -11.38 C 95.6 -15.97 99.31 -19.69 103.9 -19.69 L 211.67 -19.69 C 216.25 -19.69 219.97 -15.97 219.97 -11.38 L 219.97 11.38 C 219.97 15.97 216.25 19.69 211.67 19.69 Z M 95.6 -19.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 100.21 -8.58)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.16)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:9em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="115.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F2.pic1.2" class="ltx_text" style="font-size:90%;">Learned Abstraction</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.16)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 53.13 0)"><foreignObject style="--ltx-fo-width:0.69em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="8.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F2.pic1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 204.6 -60.16 L 110.97 -60.16 C 106.38 -60.16 102.66 -63.88 102.66 -68.46 L 102.66 -91.23 C 102.66 -95.82 106.38 -99.53 110.97 -99.53 L 204.6 -99.53 C 209.18 -99.53 212.9 -95.82 212.9 -91.23 L 212.9 -68.46 C 212.9 -63.88 209.18 -60.16 204.6 -60.16 Z M 102.66 -99.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 116.67 -88.87)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.9)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.42em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="82.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F2.pic1.3" class="ltx_text" style="font-size:90%;">Abstract State</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.48)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 23.05 0)"><foreignObject style="--ltx-fo-width:2.82em;--ltx-fo-height:0.92em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="14.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.83)" width="36.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F2.pic1.m3" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ϕ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 211.72 -140.01 L 103.84 -140.01 C 99.26 -140.01 95.54 -143.73 95.54 -148.31 L 95.54 -171.08 C 95.54 -175.66 99.26 -179.38 103.84 -179.38 L 211.72 -179.38 C 216.31 -179.38 220.02 -175.66 220.02 -171.08 L 220.02 -148.31 C 220.02 -143.73 216.31 -140.01 211.72 -140.01 Z M 95.54 -179.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 100.15 -168.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.16)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.98em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="114.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F2.pic1.4" class="ltx_text" style="font-size:90%;">Learned Elaboration</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.16)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 52.48 0)"><foreignObject style="--ltx-fo-width:0.81em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="10.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F2.pic1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 46.76 -140.01 L -59.21 -140.01 C -63.79 -140.01 -67.51 -143.73 -67.51 -148.31 L -67.51 -171.08 C -67.51 -175.66 -63.79 -179.38 -59.21 -179.38 L 46.76 -179.38 C 51.35 -179.38 55.06 -175.66 55.06 -171.08 L 55.06 -148.31 C 55.06 -143.73 51.35 -140.01 46.76 -140.01 Z M -67.51 -179.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -62.9 -169.8)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 20.21)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.86em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="113.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F2.pic1.5" class="ltx_text" style="font-size:90%;">Reconstructed State</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.21)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 45.32 0)"><foreignObject style="--ltx-fo-width:1.77em;--ltx-fo-height:0.9em;--ltx-fo-depth:0em;font-size:9.25pt;" height="11.56" overflow="visible" transform="matrix(1 0 0 -1 0 11.56)" width="22.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F2.pic1.m5" class="ltx_Math" alttext="\hat{\phi}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathsize="0.900em">ϕ</mi><mo>^</mo></mover><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\phi}^{(k)}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 55.67 0 L 89.08 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 85.91 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 157.78 -20.24 L 157.78 -53.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 157.78 -50.48)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 157.78 -100.09 L 157.78 -133.49"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 157.78 -130.32)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 94.99 -159.69 L 61.58 -159.69"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 64.75 -159.69)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch35.F2.3" class="ltx_text" style="font-size:90%;">Figure 35.2</span>. </span><span id="Ch35.F2.4" class="ltx_text" style="font-size:90%;">Learning abstraction (<math id="Ch35.F2.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>) and elaboration (<math id="Ch35.F2.m6" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>) via an autoencoder structure. Belief states <math id="Ch35.F2.m7" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math> are encoded into compressed abstract representations <math id="Ch35.F2.m8" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math> and reconstructed back, optimizing the agent’s ability to manage information across levels of semantic scaling.</span></figcaption>
</figure>
<section id="Ch35.S2.SS1" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">35.2.1. </span>Learning <math id="Ch35.S2.SS1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> (Abstraction)</h5>

<div id="Ch35.S2.SS1.p1" class="ltx_para">
<ul id="Ch35.S2.I1" class="ltx_itemize">
<li id="Ch35.S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I1.i1.p1" class="ltx_para">
<p id="Ch35.S2.I1.i1.p1.1" class="ltx_p"><span id="Ch35.S2.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Using Autoencoders/Representation Learning:</span> If <math id="Ch35.S2.I1.i1.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> involves embeddings, <math id="Ch35.S2.I1.i1.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> could be implemented as the encoder part of an autoencoder trained on belief states <math id="Ch35.S2.I1.i1.p1.m3" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math>. The bottleneck layer learns a compressed, abstract representation <math id="Ch35.S2.I1.i1.p1.m4" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math>. The learning objective could be reconstruction accuracy (in combination with learning <math id="Ch35.S2.I1.i1.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>) or optimizing the abstract representation for downstream tasks.</p>
</div></li>
<li id="Ch35.S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I1.i2.p1" class="ltx_para">
<p id="Ch35.S2.I1.i2.p1.1" class="ltx_p"><span id="Ch35.S2.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Learning Summarization Policies:</span> <math id="Ch35.S2.I1.i2.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> could be learned as a policy (potentially using RL or supervised learning on human summaries) that selects or generates the most salient components of <math id="Ch35.S2.I1.i2.p1.m2" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math> to form <math id="Ch35.S2.I1.i2.p1.m3" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math>. Techniques from abstractive text summarization are relevant here, especially if leveraging LLM components for implementation.</p>
</div></li>
<li id="Ch35.S2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I1.i3.p1" class="ltx_para">
<p id="Ch35.S2.I1.i3.p1.1" class="ltx_p"><span id="Ch35.S2.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Concept Formation/Clustering:</span> Abstraction can involve identifying recurring patterns across multiple <math id="Ch35.S2.I1.i3.p1.m1" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math> instances and forming a higher-level concept node <math id="Ch35.S2.I1.i3.p1.m2" class="ltx_Math" alttext="\varphi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\varphi^{(k+1)}</annotation></semantics></math> that represents the cluster, potentially using unsupervised learning techniques.</p>
</div></li>
</ul>
</div>
</section>
<section id="Ch35.S2.SS2" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">35.2.2. </span>Learning <math id="Ch35.S2.SS2.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> (Elaboration)</h5>

<div id="Ch35.S2.SS2.p1" class="ltx_para">
<ul id="Ch35.S2.I2" class="ltx_itemize">
<li id="Ch35.S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I2.i1.p1" class="ltx_para">
<p id="Ch35.S2.I2.i1.p1.1" class="ltx_p"><span id="Ch35.S2.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Using Generative Models/Decoders:</span> <math id="Ch35.S2.I2.i1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> could be the decoder part of an autoencoder, reconstructing details of <math id="Ch35.S2.I2.i1.p1.m2" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math> from the abstract representation <math id="Ch35.S2.I2.i1.p1.m3" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math>. If using LLMs, <math id="Ch35.S2.I2.i1.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> could be implemented via prompted generation conditioned on <math id="Ch35.S2.I2.i1.p1.m5" class="ltx_Math" alttext="\phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k+1)}</annotation></semantics></math> to produce plausible details <math id="Ch35.S2.I2.i1.p1.m6" class="ltx_Math" alttext="\phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(k)}</annotation></semantics></math>. Learning would optimize the fidelity or utility of the generated details.</p>
</div></li>
<li id="Ch35.S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I2.i2.p1" class="ltx_para">
<p id="Ch35.S2.I2.i2.p1.1" class="ltx_p"><span id="Ch35.S2.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Learning Instantiation Rules:</span> For symbolic architectures, <math id="Ch35.S2.I2.i2.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> might involve learned rules or templates for generating specific examples or groundings from abstract descriptions, possibly learned via inductive logic programming.</p>
</div></li>
<li id="Ch35.S2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S2.I2.i3.p1" class="ltx_para">
<p id="Ch35.S2.I2.i3.p1.1" class="ltx_p"><span id="Ch35.S2.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Goal:</span> Learning should optimize <math id="Ch35.S2.I2.i3.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> such that the elaborated state <math id="Ch35.S2.I2.i3.p1.m2" class="ltx_Math" alttext="V(\Lambda(\phi))" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(\Lambda(\phi))</annotation></semantics></math> is functionally useful and consistent, even if not identical to the original <math id="Ch35.S2.I2.i3.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> (as discussed in Chapter <a href="#Ch10" title="Chapter 10 Semantic Scaling ‣ Part III Structuring Belief: Modularity and Abstraction ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>).</p>
</div></li>
</ul>
<p id="Ch35.S2.SS2.p1.1" class="ltx_p">Learning <math id="Ch35.S2.SS2.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> and <math id="Ch35.S2.SS2.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> allows the agent to develop its own effective hierarchy for representing and manipulating information at different levels of granularity.</p>
</div>
</section>
</section>
<section id="Ch35.S3" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">35.3. </span>Learning Assimilation (<math id="Ch35.S3.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>) and Meta-Assimilation (<math id="Ch35.S3.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>)</h4>

<div id="Ch35.S3.p1" class="ltx_para">
<p id="Ch35.S3.p1.1" class="ltx_p">Assimilation (<math id="Ch35.S3.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, Chapter <a href="#Ch13" title="Chapter 13 Assimilation ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) integrates object-level input, while Meta-Assimilation (<math id="Ch35.S3.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, Chapter <a href="#Ch28" title="Chapter 28 Meta-Assimilation: Integrating Introspective Beliefs ‣ Part VIII Meta-Cognition and Recursive Regulation ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) integrates introspective input. Both involve complex steps like context assessment, coherence checking (<math id="Ch35.S3.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>), potential revision (<math id="Ch35.S3.p1.m4" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math>), and elaboration (<math id="Ch35.S3.p1.m5" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math>). Learning effective assimilation is crucial for robust knowledge acquisition and self-awareness.</p>
</div>
<figure id="Ch35.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch35.F3.pic1" class="ltx_picture ltx_centering" height="285.13" overflow="visible" version="1.1" viewBox="0 0 590.76 285.13" width="590.76"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,285.13) matrix(1 0 0 -1 0 0) translate(199.89,0) translate(0,264.89)"><g stroke-width="0.8pt"><path style="fill:none" d="M 42.88 19.69 L -42.88 19.69 C -47.46 19.69 -51.18 15.97 -51.18 11.38 L -51.18 -11.38 C -51.18 -15.97 -47.46 -19.69 -42.88 -19.69 L 42.88 -19.69 C 47.46 -19.69 51.18 -15.97 51.18 -11.38 L 51.18 11.38 C 51.18 15.97 47.46 19.69 42.88 19.69 Z M -51.18 -19.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -38.61 -7.37)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.58)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.06em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="77.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.1" class="ltx_text" style="font-size:90%;">Current State</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.16)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 15.47 0)"><foreignObject style="--ltx-fo-width:3.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="46.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F3.pic1.m1" class="ltx_Math" alttext="\phi_{current}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{current}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 248.71 19.69 L 162.95 19.69 C 158.37 19.69 154.65 15.97 154.65 11.38 L 154.65 -11.38 C 154.65 -15.97 158.37 -19.69 162.95 -19.69 L 248.71 -19.69 C 253.3 -19.69 257.01 -15.97 257.01 -11.38 L 257.01 11.38 C 257.01 15.97 253.3 19.69 248.71 19.69 Z M 154.65 -19.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 172.5 -8.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.9)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.21em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="66.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.2" class="ltx_text" style="font-size:90%;">Input Belief</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.72)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 15.79 0)"><foreignObject style="--ltx-fo-width:2.74em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.25em;font-size:9.25pt;" height="11.83" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="35.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F3.pic1.m2" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 184.26 -112.21 L 102.92 -71.65 L 21.57 -112.21 L 102.92 -152.77 Z"></path></g><g stroke-width="0.8pt"><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.3" class="ltx_text"></span></span></span></foreignObject><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 205.83 -264.97)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:7.53em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="96.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.4" class="ltx_text" style="font-size:90%;">Coherence Check</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 36.33 0)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.5" class="ltx_text" style="font-size:90%;">(</span><math id="Ch35.F3.pic1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="Ch35.F3.pic1.6" class="ltx_text" style="font-size:90%;">)?</span></span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -90.43 -92.52 L -191.03 -92.52 C -195.61 -92.52 -199.33 -96.24 -199.33 -100.82 L -199.33 -123.59 C -199.33 -128.18 -195.61 -131.89 -191.03 -131.89 L -90.43 -131.89 C -85.85 -131.89 -82.13 -128.18 -82.13 -123.59 L -82.13 -100.82 C -82.13 -96.24 -85.85 -92.52 -90.43 -92.52 Z M -199.33 -131.89"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -194.72 -119.64)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.44em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="107.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.7" class="ltx_text" style="font-size:90%;">Conflict Resolution</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 33.42 0)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="9.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.8" class="ltx_text" style="font-size:90%;">(</span><math id="Ch35.F3.pic1.m4" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math><span id="Ch35.F3.pic1.9" class="ltx_text" style="font-size:90%;">)</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 145.79 -224.97 L 60.04 -224.97 C 55.45 -224.97 51.73 -228.69 51.73 -233.27 L 51.73 -256.04 C 51.73 -260.62 55.45 -264.34 60.04 -264.34 L 145.79 -264.34 C 150.38 -264.34 154.1 -260.62 154.1 -256.04 L 154.1 -233.27 C 154.1 -228.69 150.38 -224.97 145.79 -224.97 Z M 51.73 -264.34"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 71.37 -252.09)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 2.49 0)"><foreignObject style="--ltx-fo-width:4.54em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="58.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.10" class="ltx_text" style="font-size:90%;">Assimilate</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:4.31em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="55.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.11" class="ltx_text" style="font-size:90%;">(Update </span><math id="Ch35.F3.pic1.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math><span id="Ch35.F3.pic1.12" class="ltx_text" style="font-size:90%;">)</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 382.02 -92.52 L 296.26 -92.52 C 291.68 -92.52 287.96 -96.24 287.96 -100.82 L 287.96 -123.59 C 287.96 -128.18 291.68 -131.89 296.26 -131.89 L 382.02 -131.89 C 386.61 -131.89 390.32 -128.18 390.32 -123.59 L 390.32 -100.82 C 390.32 -96.24 386.61 -92.52 382.02 -92.52 Z M 287.96 -131.89"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 306.15 -119.64)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.13em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="65.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.13" class="ltx_text" style="font-size:90%;">Elaboration</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 13.22 0)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="9.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.14" class="ltx_text" style="font-size:90%;">(</span><math id="Ch35.F3.pic1.m6" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mrow><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math><span id="Ch35.F3.pic1.15" class="ltx_text" style="font-size:90%;">)</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 18.55 -20.24 L 72.94 -79.53"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.676 -0.73691 0.73691 0.676 70.8 -77.19)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 187.28 -20.24 L 132.89 -79.53"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.676 -0.73691 0.73691 -0.676 135.03 -77.19)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 20.78 -112.21 L -75.61 -112.21"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 -72.44 -112.21)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -59.92 -107.04)"><foreignObject style="--ltx-fo-width:4.64em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="59.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.16" class="ltx_text" style="font-size:90%;">Incoherent</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 102.92 -153.55 L 102.92 -218.45"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 102.92 -215.28)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 108.08 -193.31)"><foreignObject style="--ltx-fo-width:4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="51.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F3.pic1.17" class="ltx_text" style="font-size:90%;">Coherent</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -140.73 -132.45 L -140.73 -244.65 L 45.22 -244.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 42.05 -244.65)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 339.14 -132.45 L 339.14 -244.65 L 160.61 -244.65"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 163.78 -244.65)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 185.05 -112.21 L 281.45 -112.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 278.27 -112.21)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch35.F3.3" class="ltx_text" style="font-size:90%;">Figure 35.3</span>. </span><span id="Ch35.F3.4" class="ltx_text" style="font-size:90%;">Learning conflict resolution within Assimilation (<math id="Ch35.F3.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>) and Meta-Assimilation (<math id="Ch35.F3.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>). The agent assesses coherence <math id="Ch35.F3.m9" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, applies learned revision strategies (<math id="Ch35.F3.m10" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math>), and elaborates beliefs (<math id="Ch35.F3.m11" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math>) to achieve robust integration of new information and meta-information into its belief state <math id="Ch35.F3.m12" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="Ch35.S3.p2" class="ltx_para">
<ul id="Ch35.S3.I1" class="ltx_itemize">
<li id="Ch35.S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S3.I1.i1.p1" class="ltx_para">
<p id="Ch35.S3.I1.i1.p1.1" class="ltx_p"><span id="Ch35.S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Learning Coherence Judgment (<math id="Ch35.S3.I1.i1.p1.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> basis):</span> The ability to assess coherence <math id="Ch35.S3.I1.i1.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, crucial for <math id="Ch35.S3.I1.i1.p1.m3" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math> and <math id="Ch35.S3.I1.i1.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, might be learned. This could involve training classifiers to detect inconsistencies or using energy-based models where coherent states have lower energy, optimized based on task outcomes or logical constraints.</p>
</div></li>
<li id="Ch35.S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S3.I1.i2.p1" class="ltx_para">
<p id="Ch35.S3.I1.i2.p1.1" class="ltx_p"><span id="Ch35.S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Learning Revision Policies (within <math id="Ch35.S3.I1.i2.p1.m1" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math>):</span> Deciding which beliefs to retract during conflict resolution is complex. An agent could learn revision policies (e.g., based on anchoring <math id="Ch35.S3.I1.i2.p1.m2" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>, source tags, logical entailment) using RL, where rewards are given for restoring high coherence <math id="Ch35.S3.I1.i2.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> or improving subsequent task performance.</p>
</div></li>
<li id="Ch35.S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S3.I1.i3.p1" class="ltx_para">
<p id="Ch35.S3.I1.i3.p1.1" class="ltx_p"><span id="Ch35.S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Learning Elaboration Strategies (within <math id="Ch35.S3.I1.i3.p1.m1" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math>):</span> The agent could learn which elaborations are most useful or contextually appropriate, perhaps by training generative models conditioned on <math id="Ch35.S3.I1.i3.p1.m2" class="ltx_Math" alttext="\phi_{current}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{current}</annotation></semantics></math> and <math id="Ch35.S3.I1.i3.p1.m3" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math>, optimizing for predictive accuracy or goal relevance.</p>
</div></li>
<li id="Ch35.S3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S3.I1.i4.p1" class="ltx_para">
<p id="Ch35.S3.I1.i4.p1.1" class="ltx_p"><span id="Ch35.S3.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Fine-tuning LLM Components:</span> If <math id="Ch35.S3.I1.i4.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> or <math id="Ch35.S3.I1.i4.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> are implemented using LLMs (Appendix <a href="#A4" title="Appendix D Implementation Strategies and Examples ‣ Part XI Conclusion ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>), fine-tuning the LLM on specific assimilation or meta-assimilation tasks (e.g., integrating conflicting reports, generating meta-summaries based on state metrics) is a direct way to learn these operator functions tailored to the agent’s needs.</p>
</div></li>
<li id="Ch35.S3.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S3.I1.i5.p1" class="ltx_para">
<p id="Ch35.S3.I1.i5.p1.1" class="ltx_p"><span id="Ch35.S3.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Learning for <math id="Ch35.S3.I1.i5.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>:</span> Specifically for <math id="Ch35.S3.I1.i5.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, learning might involve calibrating the integration of introspective signals (<math id="Ch35.S3.I1.i5.p1.m3" class="ltx_Math" alttext="\Phi_{introspective}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">\Phi_{introspective}</annotation></semantics></math>), perhaps learning to weight different internal signals based on their past reliability in predicting performance or problems.</p>
</div></li>
</ul>
<p id="Ch35.S3.p2.1" class="ltx_p">Learning <math id="Ch35.S3.p2.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="Ch35.S3.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> allows the agent to move beyond predefined integration rules towards context-sensitive, adaptive, and potentially more robust belief updating and self-assessment.</p>
</div>
</section>
<section id="Ch35.S4" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">35.4. </span>Learning Retrieval (<math id="Ch35.S4.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>) and Querying (<math id="Ch35.S4.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>)</h4>

<div id="Ch35.S4.p1" class="ltx_para">
<p id="Ch35.S4.p1.1" class="ltx_p">Effective use of semantic memory (Part <a href="#Pt5" title="Part V Semantic Memory: Retrieval and Integration ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a>) depends on retrieving the right information (<math id="Ch35.S4.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, Chapter <a href="#Ch19" title="Chapter 19 The Retrieval Operator: Accessing Stored Beliefs ‣ Part V Semantic Memory: Retrieval and Integration ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) in response to appropriate cues (<math id="Ch35.S4.p1.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, Chapter <a href="#Ch18" title="Chapter 18 Querying Belief Space: The Genesis of Retrieval ‣ Part V Semantic Memory: Retrieval and Integration ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>).</p>
</div>
<figure id="Ch35.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch35.F4.pic1" class="ltx_picture ltx_centering" height="382.38" overflow="visible" version="1.1" viewBox="0 0 332.92 382.38" width="332.92"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,382.38) matrix(1 0 0 -1 0 0) translate(55.67,0) translate(0,358.21)"><g stroke-width="0.8pt"><path style="fill:none" d="M 46.82 23.62 L -46.82 23.62 C -51.4 23.62 -55.12 19.91 -55.12 15.32 L -55.12 -15.32 C -55.12 -19.91 -51.4 -23.62 -46.82 -23.62 L 46.82 -23.62 C 51.4 -23.62 55.12 -19.91 55.12 -15.32 L 55.12 15.32 C 55.12 19.91 51.4 23.62 46.82 23.62 Z M -55.12 -23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -37.23 -4.32)"><foreignObject style="--ltx-fo-width:5.85em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="74.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.1" class="ltx_text" style="font-size:90%;">Current Goal</span></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 46.82 -87.72 L -46.82 -87.72 C -51.4 -87.72 -55.12 -91.44 -55.12 -96.02 L -55.12 -126.66 C -55.12 -131.25 -51.4 -134.97 -46.82 -134.97 L 46.82 -134.97 C 51.4 -134.97 55.12 -131.25 55.12 -126.66 L 55.12 -96.02 C 55.12 -91.44 51.4 -87.72 46.82 -87.72 Z M -55.12 -134.97"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -44.7 -119.59)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.66)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.99em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="89.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.2" class="ltx_text" style="font-size:90%;">Generate Query</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.58)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 26.54 0)"><foreignObject style="--ltx-fo-width:2.84em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="11.73" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="36.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F4.pic1.m1" class="ltx_Math" alttext="\phi_{query}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">y</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{query}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 46.82 -199.06 L -46.82 -199.06 C -51.4 -199.06 -55.12 -202.78 -55.12 -207.37 L -55.12 -238.01 C -55.12 -242.59 -51.4 -246.31 -46.82 -246.31 L 46.82 -246.31 C 51.4 -246.31 55.12 -242.59 55.12 -238.01 L 55.12 -207.37 C 55.12 -202.78 51.4 -199.06 46.82 -199.06 Z M -55.12 -246.31"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -49.82 -230.12)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:7.87em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="100.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.3" class="ltx_text" style="font-size:90%;">Perform Retrieval</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 17.17 0)"><foreignObject style="--ltx-fo-width:5.1em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="65.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch35.F4.pic1.m2" class="ltx_Math" alttext="R(\cdot,\phi_{query})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">R</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">ϕ</mi><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">y</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(\cdot,\phi_{query})</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 46.82 -310.41 L -46.82 -310.41 C -51.4 -310.41 -55.12 -314.12 -55.12 -318.71 L -55.12 -349.35 C -55.12 -353.93 -51.4 -357.65 -46.82 -357.65 L 46.82 -357.65 C 51.4 -357.65 55.12 -353.93 55.12 -349.35 L 55.12 -318.71 C 55.12 -314.12 51.4 -310.41 46.82 -310.41 Z M -55.12 -357.65"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -47.17 -338.35)"><foreignObject style="--ltx-fo-width:7.4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="94.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.4" class="ltx_text" style="font-size:90%;">Retrieved Beliefs</span></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 268.4 -199.06 L 174.76 -199.06 C 170.18 -199.06 166.46 -202.78 166.46 -207.37 L 166.46 -238.01 C 166.46 -242.59 170.18 -246.31 174.76 -246.31 L 268.4 -246.31 C 272.98 -246.31 276.7 -242.59 276.7 -238.01 L 276.7 -207.37 C 276.7 -202.78 272.98 -199.06 268.4 -199.06 Z M 166.46 -246.31"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 180.64 -231.33)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.3)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 13.47 0)"><foreignObject style="--ltx-fo-width:4.4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="56.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.5" class="ltx_text" style="font-size:90%;">Feedback:</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.3)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.4em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="81.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch35.F4.pic1.6" class="ltx_text" style="font-size:90%;">Useful or Not?</span></span></span></foreignObject></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -24.18 L 0 -81.21"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -78.04)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -135.52 L 0 -192.55"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -189.38)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -246.86 L 0 -303.89"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -300.72)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 55.67 -222.69 L 159.95 -222.69"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 156.78 -222.69)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 221.58 -198.51 L 221.58 -111.34 L 61.63 -111.34"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 64.8 -111.34)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch35.F4.3" class="ltx_text" style="font-size:90%;">Figure 35.4</span>. </span><span id="Ch35.F4.4" class="ltx_text" style="font-size:90%;">Learning mechanisms for Query (<math id="Ch35.F4.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>) and Retrieval (<math id="Ch35.F4.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>). The agent refines its ability to generate effective queries based on task needs and optimizes retrieval strategies using learned metrics (<math id="Ch35.F4.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>) and experience with retrieval success or failure.</span></figcaption>
</figure>
<section id="Ch35.S4.SS1" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">35.4.1. </span>Learning Retrieval Policies (<math id="Ch35.S4.SS1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>)</h5>

<div id="Ch35.S4.SS1.p1" class="ltx_para">
<ul id="Ch35.S4.I1" class="ltx_itemize">
<li id="Ch35.S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S4.I1.i1.p1" class="ltx_para">
<p id="Ch35.S4.I1.i1.p1.1" class="ltx_p"><span id="Ch35.S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Tuning Similarity/Relevance:</span> If <math id="Ch35.S4.I1.i1.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> uses the learned metric <math id="Ch35.S4.I1.i1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> (Chapter <a href="#Ch34" title="Chapter 34 Learning Semantic Structures ‣ Part IX Learning and Adaptation ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>), its effectiveness improves as <math id="Ch35.S4.I1.i1.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> improves. Additionally, the thresholds or search strategies used by <math id="Ch35.S4.I1.i1.p1.m4" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> could be adapted based on feedback (e.g., was the retrieved information useful for the current task?). This could be framed as an RL problem where retrieval effectiveness provides the reward.</p>
</div></li>
<li id="Ch35.S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S4.I1.i2.p1" class="ltx_para">
<p id="Ch35.S4.I1.i2.p1.1" class="ltx_p"><span id="Ch35.S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Learning Associative Links:</span> For graph-based <math id="Ch35.S4.I1.i2.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, the links traversed by <math id="Ch35.S4.I1.i2.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> could be learned or weighted based on experienced co-activations or causal relationships identified during learning.</p>
</div></li>
</ul>
</div>
</section>
<section id="Ch35.S4.SS2" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">35.4.2. </span>Learning Query Formulation (<math id="Ch35.S4.SS2.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>)</h5>

<div id="Ch35.S4.SS2.p1" class="ltx_para">
<ul id="Ch35.S4.I2" class="ltx_itemize">
<li id="Ch35.S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S4.I2.i1.p1" class="ltx_para">
<p id="Ch35.S4.I2.i1.p1.1" class="ltx_p">An agent could learn what makes a good retrieval cue <math id="Ch35.S4.I2.i1.p1.m1" class="ltx_Math" alttext="\phi_{query}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{query}</annotation></semantics></math>. This might involve RL where the agent gets rewarded for generating queries that lead to successful retrieval (<math id="Ch35.S4.I2.i1.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> returns relevant results) contributing to goal achievement.</p>
</div></li>
<li id="Ch35.S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch35.S4.I2.i2.p1" class="ltx_para">
<p id="Ch35.S4.I2.i2.p1.1" class="ltx_p">Learning to map from <math id="Ch35.S4.I2.i2.p1.m1" class="ltx_Math" alttext="\phi_{current}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{current}</annotation></semantics></math> and current goals to effective <math id="Ch35.S4.I2.i2.p1.m2" class="ltx_Math" alttext="\phi_{query}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{query}</annotation></semantics></math> could involve training sequence-to-sequence models or attention mechanisms, potentially supervised by examples of effective queries or learned via RL based on retrieval outcomes.</p>
</div></li>
</ul>
<p id="Ch35.S4.SS2.p1.1" class="ltx_p">Learning <math id="Ch35.S4.SS2.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and <math id="Ch35.S4.SS2.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> transforms memory from a static store to an adaptive resource accessed through increasingly effective querying and retrieval strategies.</p>
</div>
</section>
</section>
<section id="Ch35.S5" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">35.5. </span>Learning Decay (<math id="Ch35.S5.m1" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>) and Annihilation (<math id="Ch35.S5.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) Triggers</h4>

<div id="Ch35.S5.p1" class="ltx_para">
<p id="Ch35.S5.p1.1" class="ltx_p">While <math id="Ch35.S5.p1.m1" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> (Chapter <a href="#Ch14" title="Chapter 14 Nullification ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and <math id="Ch35.S5.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> (Chapter <a href="#Ch15" title="Chapter 15 Annihilation ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) primarily model passive decay or abrupt erasure, aspects of their operation might be adaptable:</p>
</div>
