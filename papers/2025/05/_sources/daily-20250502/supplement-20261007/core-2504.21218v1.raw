18.5 L 22.86 118.72 L 23.68 118.96 L 24.48 119.21 L 25.25 119.47 L 26 119.74 L 26.72 120.02 L 27.42 120.31 L 28.08 120.61 L 28.72 120.92 L 29.33 121.23 L 29.91 121.56 L 30.46 121.9 L 30.98 122.24 L 31.47 122.59 L 31.92 122.95 L 32.35 123.31 L 32.74 123.69"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -47.75 9.09 L -19.1 263.48"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 47.75 -9.09 L 19.1 256.21"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -159.24 169.68)"><foreignObject style="--ltx-fo-width:8.23em;--ltx-fo-height:0.59em;--ltx-fo-depth:0.16em;font-size:10.65pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="121.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch6.F3.pic1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Null Tower Layers</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 145.44 6.14)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="9.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch6.F3.pic1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -29.56 -2.54)"><foreignObject style="--ltx-fo-width:1.85em;--ltx-fo-height:0.92em;--ltx-fo-depth:0em;font-size:9.25pt;" height="11.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.83)" width="23.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch6.F3.pic1.m4" class="ltx_Math" alttext="\Omega^{(0)}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em" mathvariant="normal">Ω</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(0)}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -29.56 127.39)"><foreignObject style="--ltx-fo-width:1.85em;--ltx-fo-height:0.92em;--ltx-fo-depth:0em;font-size:9.25pt;" height="11.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.83)" width="23.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch6.F3.pic1.m5" class="ltx_Math" alttext="\Omega^{(1)}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em" mathvariant="normal">Ω</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(1)}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch6.F3.3" class="ltx_text" style="font-size:90%;">Figure 6.3</span>. </span><span id="Ch6.F3.4" class="ltx_text" style="font-size:90%;">The Null Tower structure in semantic state space with layers <math id="Ch6.F3.m4" class="ltx_Math" alttext="\Omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(k)}</annotation></semantics></math>. The vertical axis <math id="Ch6.F3.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> denotes introspective depth, while the horizontal axis <math id="Ch6.F3.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> represents semantic spread.</span></figcaption>
</figure>
<div id="Ch6.S3.p5" class="ltx_para">
<p id="Ch6.S3.p5.1" class="ltx_p">The full set of beliefs derivable from the epistemic vacuum via abstraction constitutes the null-derived belief space <math id="Ch6.S3.p5.m1" class="ltx_Math" alttext="\mathcal{T}_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">\mathcal{T}_{\Omega}</annotation></semantics></math>:</p>
<table id="Ch6.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch6.Ex3.m1" class="ltx_Math" alttext="\mathcal{T}_{\Omega}:=\bigcup_{\omega\in\Omega^{(0)}}\{\omega^{(k)}|k\in\mathbb{N}_{0}\}=\bigcup_{k=0}^{\infty}\Omega^{(k)}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">Ω</mi></msub><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false" rspace="0em">⋃</mo><mrow><mi>ω</mi><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></munder><mrow><mo stretchy="false">{</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">⋃</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{\Omega}:=\bigcup_{\omega\in\Omega^{(0)}}\{\omega^{(k)}|k\in\mathbb{N}_{0}\}=\bigcup_{k=0}^{\infty}\Omega^{(k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch6.S3.p5.2" class="ltx_p">This space represents the agent’s potential for internally generated structure, built solely upon recursive abstraction from its minimal starting points. The Null Tower is thus not a static object but the result of this ongoing constructive process, defining the developmental and structural backbone of the agent’s potential for internal epistemic organization.</p>
</div>
</section>
<section id="Ch6.S4" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6.4. </span>Structural Properties and Dynamics</h4>

<div id="Ch6.S4.p1" class="ltx_para">
<p id="Ch6.S4.p1.1" class="ltx_p">The Null Tower possesses several crucial structural properties that enable cognitive functions:</p>
<ul id="Ch6.S4.I1" class="ltx_itemize">
<li id="Ch6.S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch6.S4.I1.i1.p1" class="ltx_para">
<p id="Ch6.S4.I1.i1.p1.1" class="ltx_p"><span id="Ch6.S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Stratification:</span> The layers <math id="Ch6.S4.I1.i1.p1.m1" class="ltx_Math" alttext="\Omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(k)}</annotation></semantics></math> are distinct by construction, providing a canonical indexing of null-derived beliefs by abstraction depth.</p>
</div></li>
<li id="Ch6.S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch6.S4.I1.i2.p1" class="ltx_para">
<p id="Ch6.S4.I1.i2.p1.1" class="ltx_p"><span id="Ch6.S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Recursive Dependency and Inheritance:</span> Each state <math id="Ch6.S4.I1.i2.p1.m1" class="ltx_Math" alttext="\omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(k)}</annotation></semantics></math> inherits its structure from <math id="Ch6.S4.I1.i2.p1.m2" class="ltx_Math" alttext="\omega^{(k-1)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(k-1)}</annotation></semantics></math> via <math id="Ch6.S4.I1.i2.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. This ensures a downward referential integrity (higher levels summarize lower ones) and upward semantic accumulation. This dependency chain (<math id="Ch6.S4.I1.i2.p1.m4" class="ltx_Math" alttext="\omega^{(k)}\rightarrow\omega^{(k-1)}\rightarrow\dots\rightarrow\omega^{(0)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">→</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">→</mo><mi mathvariant="normal">…</mi><mo stretchy="false">→</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\omega^{(k)}\rightarrow\omega^{(k-1)}\rightarrow\dots\rightarrow\omega^{(0)}</annotation></semantics></math>) supports semantic stability and recovery. If <math id="Ch6.S4.I1.i2.p1.m5" class="ltx_Math" alttext="\omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(k)}</annotation></semantics></math> becomes corrupted or unstable, the agent might revert to <math id="Ch6.S4.I1.i2.p1.m6" class="ltx_Math" alttext="\omega^{(k-1)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(k-1)}</annotation></semantics></math> and re-apply abstraction.</p>
</div></li>
<li id="Ch6.S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch6.S4.I1.i3.p1" class="ltx_para">
<p id="Ch6.S4.I1.i3.p1.1" class="ltx_p"><span id="Ch6.S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Semantic Metrics and Alignment:</span> If a semantic distance <math id="Ch6.S4.I1.i3.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is defined on <math id="Ch6.S4.I1.i3.p1.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> (see Part <a href="#Pt7" title="Part VII Embodiment and Action: Executing Belief ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VII</span></a>), and if abstraction operators <math id="Ch6.S4.I1.i3.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> are contractive under <math id="Ch6.S4.I1.i3.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, then abstraction can regularize noise and align related belief trajectories. The coherence of a trajectory <math id="Ch6.S4.I1.i3.p1.m5" class="ltx_Math" alttext="\{\omega^{(k)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\omega^{(k)}\}</annotation></semantics></math> can be measured relative to its ideal path.</p>
</div></li>
<li id="Ch6.S4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch6.S4.I1.i4.p1" class="ltx_para">
<p id="Ch6.S4.I1.i4.p1.1" class="ltx_p"><span id="Ch6.S4.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Semantic Flow:</span> The tower structure supports directional semantic flow: bottom-up processes correspond to construction, generalization, and emergence of patterns, while top-down processes can represent goal imposition, constraint propagation, or reflective modulation originating from higher abstraction levels.</p>
</div></li>
<li id="Ch6.S4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch6.S4.I1.i5.p1" class="ltx_para">
<p id="Ch6.S4.I1.i5.p1.1" class="ltx_p"><span id="Ch6.S4.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Failure Modes:</span> The tower’s structure is not guaranteed to be stable. Potential failures include:</p>
<ul id="Ch6.S4.I1.i5.I1" class="ltx_itemize">
<li id="Ch6.S4.I1.i5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="Ch6.S4.I1.i5.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="Ch6.S4.I1.i5.I1.i1.p1" class="ltx_para">
<p id="Ch6.S4.I1.i5.I1.i1.p1.1" class="ltx_p">Collapse: One or more layers <math id="Ch6.S4.I1.i5.I1.i1.p1.m1" class="ltx_Math" alttext="\omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(k)}</annotation></semantics></math> become inaccessible or incoherent, breaking the recursive chain.</p>
</div></li>
<li id="Ch6.S4.I1.i5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="Ch6.S4.I1.i5.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="Ch6.S4.I1.i5.I1.i2.p1" class="ltx_para">
<p id="Ch6.S4.I1.i5.I1.i2.p1.1" class="ltx_p">Drift: A trajectory <math id="Ch6.S4.I1.i5.I1.i2.p1.m1" class="ltx_Math" alttext="\{\omega^{(k)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\omega^{(k)}\}</annotation></semantics></math> deviates significantly from its expected or coherent path, leading to semantically invalid abstractions.</p>
</div></li>
<li id="Ch6.S4.I1.i5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="Ch6.S4.I1.i5.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="Ch6.S4.I1.i5.I1.i3.p1" class="ltx_para">
<p id="Ch6.S4.I1.i5.I1.i3.p1.1" class="ltx_p">Fragmentation: Subsequences lose structural continuity or inheritance, leading to isolated, ungrounded high-level beliefs.</p>
</div></li>
</ul>
<p id="Ch6.S4.I1.i5.p1.2" class="ltx_p">These failures can arise from noisy operators, memory limits, or internal contradictions. The tower’s structure, however, also provides pathways for recovery, such as downward fallback or lateral substitution within a layer <math id="Ch6.S4.I1.i5.p1.m1" class="ltx_Math" alttext="\Omega^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Omega^{(k)}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="Ch6.S4.p1.2" class="ltx_p">The Null Tower is therefore a dynamic cognitive architecture, providing a scaffold for belief formation, coherence maintenance, and structured recovery from epistemic disruption.</p>
</div>
</section>
<section id="Ch6.S5" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6.5. </span>The Semantic Singularity <math id="Ch6.S5.m1" class="ltx_Math" alttext="\omega^{(\infty)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(\infty)}</annotation></semantics></math></h4>

<div id="Ch6.S5.p1" class="ltx_para">
<p id="Ch6.S5.p1.1" class="ltx_p">What is the ultimate destination of a belief trajectory under indefinite recursive abstraction? The concept of the semantic singularity addresses this question.</p>
</div>
<div id="Ch6.S5.p2" class="ltx_para">
<p id="Ch6.S5.p2.1" class="ltx_p"><span id="Ch6.S5.p2.1.1" class="ltx_text ltx_font_bold">Definition (Semantic Singularity):</span> If the sequence of abstracted states <math id="Ch6.S5.p2.m1" class="ltx_Math" alttext="\{\omega^{(k)}\}_{k=0}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\{\omega^{(k)}\}_{k=0}^{\infty}</annotation></semantics></math> originating from <math id="Ch6.S5.p2.m2" class="ltx_Math" alttext="\omega\in\Omega^{(0)}" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\omega\in\Omega^{(0)}</annotation></semantics></math> converges to a limit point <math id="Ch6.S5.p2.m3" class="ltx_Math" alttext="\omega^{(\infty)}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\omega^{(\infty)}</annotation></semantics></math> within <math id="Ch6.S5.p2.m4" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, this limit is called the semantic singularity associated with <math id="Ch6.S5.p2.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>.</p>
<table id="Ch6.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch6.Ex4.m1" class="ltx_Math" alttext="\omega^{(\infty)}:=\lim_{k\rightarrow\infty}\omega^{(k)}" display="block" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>k</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\omega^{(\infty)}:=\lim_{k\rightarrow\infty}\omega^{(k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch6.S5.p2.2" class="ltx_p">A semantic singularity <math id="Ch6.S5.p2.m6" class="ltx_Math" alttext="\phi_{\infty}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\phi_{\infty}</annotation></semantics></math> might be characterized as a fixed point of abstraction, satisfying <math id="Ch6.S5.p2.m7" class="ltx_Math" alttext="\Lambda(\phi_{\infty})=\phi_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>ϕ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\Lambda(\phi_{\infty})=\phi_{\infty}</annotation></semantics></math> for a suitably defined global abstraction operator <math id="Ch6.S5.p2.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.</p>
</div>
