ke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 68.9 -39.37 C 68.9 -1.32 38.05 29.53 0 29.53 C -38.05 29.53 -68.9 -1.32 -68.9 -39.37 C -68.9 -77.42 -38.05 -108.27 0 -108.27 C 38.05 -108.27 68.9 -77.42 68.9 -39.37 Z M 0 -39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -17.84 -42.74)"><foreignObject style="--ltx-fo-width:2.79em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.14em;font-size:9.25pt;" height="10.27" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="35.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m6" class="ltx_Math" alttext="\Sigma_{\text{affect}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em" mathvariant="normal">Σ</mi><mtext mathsize="0.900em">affect</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{affect}}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 88.58 0 C 88.58 38.05 57.74 68.9 19.69 68.9 C -18.37 68.9 -49.21 38.05 -49.21 0 C -49.21 -38.05 -18.37 -68.9 19.69 -68.9 C 57.74 -68.9 88.58 -38.05 88.58 0 Z M 19.69 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 4.91 -2.53)"><foreignObject style="--ltx-fo-width:2.31em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="11.97" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="29.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m7" class="ltx_Math" alttext="\Sigma_{\text{lang}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em" mathvariant="normal">Σ</mi><mtext mathsize="0.900em">lang</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{lang}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 193.24 114.72)"><foreignObject style="--ltx-fo-width:8em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="102.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch11.F1.pic1.2" class="ltx_text" style="font-size:90%;">Sector Activation <math id="Ch11.F1.pic1.m8" class="ltx_Math" alttext="\vec{\alpha}(t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo mathsize="1.110em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t)</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 92.53)"><foreignObject style="--ltx-fo-width:1.87em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.24em;font-size:8.19pt;" height="9.32" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="21.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m9" class="ltx_Math" alttext="\Sigma_{\text{perc}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">perc</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{perc}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 86.61 M 196.85 83.85 L 196.85 81.51 C 196.85 79.98 198.09 78.74 199.62 78.74 L 257.08 78.74 C 258.6 78.74 259.84 79.98 259.84 81.51 L 259.84 83.85 C 259.84 85.38 258.6 86.61 257.08 86.61 L 199.62 86.61 C 198.09 86.61 196.85 85.38 196.85 83.85 Z M 259.84 78.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 68.91)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.24em;font-size:8.19pt;" height="9.32" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="21.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m10" class="ltx_Math" alttext="\Sigma_{\text{plan}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">plan</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{plan}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 62.99 M 196.85 60.22 L 196.85 57.89 C 196.85 56.36 198.09 55.12 199.62 55.12 L 241.33 55.12 C 242.86 55.12 244.09 56.36 244.09 57.89 L 244.09 60.22 C 244.09 61.75 242.86 62.99 241.33 62.99 L 199.62 62.99 C 198.09 62.99 196.85 61.75 196.85 60.22 Z M 244.09 55.12"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 44.63)"><foreignObject style="--ltx-fo-width:1.86em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="21.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m11" class="ltx_Math" alttext="\Sigma_{\text{narr}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">narr</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{narr}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 39.37 M 196.85 36.6 L 196.85 34.26 C 196.85 32.74 198.09 31.5 199.62 31.5 L 221.64 31.5 C 223.17 31.5 224.41 32.74 224.41 34.26 L 224.41 36.6 C 224.41 38.13 223.17 39.37 221.64 39.37 L 199.62 39.37 C 198.09 39.37 196.85 38.13 196.85 36.6 Z M 224.41 31.5"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 21)"><foreignObject style="--ltx-fo-width:1.61em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="18.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m12" class="ltx_Math" alttext="\Sigma_{\text{refl}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">refl</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{refl}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 15.75 M 196.85 12.98 L 196.85 10.64 C 196.85 9.11 198.09 7.87 199.62 7.87 L 233.45 7.87 C 234.98 7.87 236.22 9.11 236.22 10.64 L 236.22 12.98 C 236.22 14.51 234.98 15.75 233.45 15.75 L 199.62 15.75 C 198.09 15.75 196.85 14.51 196.85 12.98 Z M 236.22 7.87"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 -2.62)"><foreignObject style="--ltx-fo-width:2.19em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="24.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m13" class="ltx_Math" alttext="\Sigma_{\text{affect}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">affect</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{affect}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 -7.87 M 196.85 -10.64 L 196.85 -12.98 C 196.85 -14.51 198.09 -15.75 199.62 -15.75 L 209.83 -15.75 C 211.36 -15.75 212.6 -14.51 212.6 -12.98 L 212.6 -10.64 C 212.6 -9.11 211.36 -7.87 209.83 -7.87 L 199.62 -7.87 C 198.09 -7.87 196.85 -9.11 196.85 -10.64 Z M 212.6 -15.75"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 201.74 -25.58)"><foreignObject style="--ltx-fo-width:1.85em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.24em;font-size:8.19pt;" height="9.32" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="21.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F1.pic1.m14" class="ltx_Math" alttext="\Sigma_{\text{lang}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">lang</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{lang}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6"><path d="M 196.85 -31.5 M 196.85 -34.26 L 196.85 -36.6 C 196.85 -38.13 198.09 -39.37 199.62 -39.37 L 249.2 -39.37 C 250.73 -39.37 251.97 -38.13 251.97 -36.6 L 251.97 -34.26 C 251.97 -32.74 250.73 -31.5 249.2 -31.5 L 199.62 -31.5 C 198.09 -31.5 196.85 -32.74 196.85 -34.26 Z M 251.97 -39.37"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch11.F1.3" class="ltx_text" style="font-size:90%;">Figure 11.1</span>. </span><span id="Ch11.F1.4" class="ltx_text" style="font-size:90%;">Functional stratification of the belief space <math id="Ch11.F1.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> into semantic sectors <math id="Ch11.F1.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. Each sector (e.g., perception <math id="Ch11.F1.m11" class="ltx_Math" alttext="\Sigma_{\text{perc}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mtext>perc</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{perc}}</annotation></semantics></math>, planning <math id="Ch11.F1.m12" class="ltx_Math" alttext="\Sigma_{\text{plan}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mtext>plan</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{plan}}</annotation></semantics></math>, narrative <math id="Ch11.F1.m13" class="ltx_Math" alttext="\Sigma_{\text{narr}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mtext>narr</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{narr}}</annotation></semantics></math>, reflection <math id="Ch11.F1.m14" class="ltx_Math" alttext="\Sigma_{\text{refl}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mtext>refl</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{refl}}</annotation></semantics></math>) represents an overlapping, functionally coherent subregion of <math id="Ch11.F1.m15" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>. The agent’s current cognitive mode is characterized by the sector activation vector <math id="Ch11.F1.m16" class="ltx_Math" alttext="\vec{\alpha}(t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo mathsize="1.110em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t)</annotation></semantics></math>, dynamically modulating processing emphasis.</span></figcaption>
</figure>
</section>
<section id="Ch11.S4" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">11.4. </span>Sectoral Dynamics and Mode Switching</h4>

<div id="Ch11.S4.p1" class="ltx_para">
<p id="Ch11.S4.p1.1" class="ltx_p">Semantic sectors are not static partitions but dynamically activated components of the cognitive architecture. An agent’s overall cognitive "mode" can be characterized by the relative activation levels of its different sectors.</p>
</div>
<div id="Ch11.S4.p2" class="ltx_para">
<p id="Ch11.S4.p2.1" class="ltx_p"><span id="Ch11.S4.p2.1.1" class="ltx_text ltx_font_bold">Definition (Sector Activation):</span> Each sector <math id="Ch11.S4.p2.m1" class="ltx_Math" alttext="\Sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Sigma_{i}</annotation></semantics></math> has an associated time-varying activation signal <math id="Ch11.S4.p2.m2" class="ltx_Math" alttext="\alpha_{i}(t)\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}(t)\in[0,1]</annotation></semantics></math>, indicating its current relevance, processing load, or accessibility. The state of all sectors is captured by the activation vector <math id="Ch11.S4.p2.m3" class="ltx_Math" alttext="\vec{\alpha}(t)=[\alpha_{1}(t),\dots,\alpha_{n}(t)]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>α</mi><mo stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>α</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t)=[\alpha_{1}(t),\dots,\alpha_{n}(t)]</annotation></semantics></math>.</p>
</div>
<div id="Ch11.S4.p3" class="ltx_para">
<p id="Ch11.S4.p3.1" class="ltx_p">Operations can be gated by activation levels (e.g., assimilation <math id="Ch11.S4.p3.m1" class="ltx_Math" alttext="A_{\Sigma_{i}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">A_{\Sigma_{i}}</annotation></semantics></math> only occurs if <math id="Ch11.S4.p3.m2" class="ltx_Math" alttext="\alpha_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}(t)</annotation></semantics></math> exceeds a threshold). Different cognitive modes correspond to distinct activation profiles:</p>
<ul id="Ch11.S4.I1" class="ltx_itemize">
<li id="Ch11.S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S4.I1.i1.p1" class="ltx_para">
<p id="Ch11.S4.I1.i1.p1.1" class="ltx_p"><span id="Ch11.S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Reactive Mode:</span> High <math id="Ch11.S4.I1.i1.p1.m1" class="ltx_Math" alttext="\alpha_{perc}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{perc}</annotation></semantics></math>, <math id="Ch11.S4.I1.i1.p1.m2" class="ltx_Math" alttext="\alpha_{plan}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{plan}</annotation></semantics></math>; low <math id="Ch11.S4.I1.i1.p1.m3" class="ltx_Math" alttext="\alpha_{narr}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{narr}</annotation></semantics></math>, <math id="Ch11.S4.I1.i1.p1.m4" class="ltx_Math" alttext="\alpha_{refl}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{refl}</annotation></semantics></math>.</p>
</div></li>
<li id="Ch11.S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S4.I1.i2.p1" class="ltx_para">
<p id="Ch11.S4.I1.i2.p1.1" class="ltx_p"><span id="Ch11.S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Reflective Mode:</span> High <math id="Ch11.S4.I1.i2.p1.m1" class="ltx_Math" alttext="\alpha_{narr}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{narr}</annotation></semantics></math>, <math id="Ch11.S4.I1.i2.p1.m2" class="ltx_Math" alttext="\alpha_{refl}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{refl}</annotation></semantics></math>; moderate <math id="Ch11.S4.I1.i2.p1.m3" class="ltx_Math" alttext="\alpha_{perc}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{perc}</annotation></semantics></math>.</p>
</div></li>
<li id="Ch11.S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S4.I1.i3.p1" class="ltx_para">
<p id="Ch11.S4.I1.i3.p1.1" class="ltx_p"><span id="Ch11.S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Planning Mode:</span> High <math id="Ch11.S4.I1.i3.p1.m1" class="ltx_Math" alttext="\alpha_{plan}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{plan}</annotation></semantics></math>; moderate <math id="Ch11.S4.I1.i3.p1.m2" class="ltx_Math" alttext="\alpha_{perc}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{perc}</annotation></semantics></math>, <math id="Ch11.S4.I1.i3.p1.m3" class="ltx_Math" alttext="\alpha_{refl}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{refl}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="Ch11.S4.p3.2" class="ltx_p">Transitions between these modes, or mode switching, can be triggered externally (by environmental cues) or endogenously (by internal diagnostics like high cognitive load <math id="Ch11.S4.p3.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, detected incoherence <math id="Ch11.S4.p3.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, or completion of a task phase). The transition dynamics can be modeled by a function governing the evolution of the activation vector: <math id="Ch11.S4.p3.m5" class="ltx_Math" alttext="\vec{\alpha}(t+\delta t)=f(\vec{\alpha}(t),\phi,s,\pi)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>α</mi><mo stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>α</mi><mo stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ϕ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t+\delta t)=f(\vec{\alpha}(t),\phi,s,\pi)</annotation></semantics></math>.</p>
</div>
<div id="Ch11.S4.p4" class="ltx_para">
<p id="Ch11.S4.p4.1" class="ltx_p">Sector dynamics often involve interactions:</p>
<ul id="Ch11.S4.I2" class="ltx_itemize">
<li id="Ch11.S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S4.I2.i1.p1" class="ltx_para">
<p id="Ch11.S4.I2.i1.p1.1" class="ltx_p"><span id="Ch11.S4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Mutual Inhibition:</span> Activation of one sector might suppress another (e.g., high <math id="Ch11.S4.I2.i1.p1.m1" class="ltx_Math" alttext="\alpha_{react}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{react}</annotation></semantics></math> inhibits <math id="Ch11.S4.I2.i1.p1.m2" class="ltx_Math" alttext="\alpha_{refl}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\alpha_{refl}</annotation></semantics></math>).</p>
</div></li>
<li id="Ch11.S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S4.I2.i2.p1" class="ltx_para">
<p id="Ch11.S4.I2.i2.p1.1" class="ltx_p"><span id="Ch11.S4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Coactivation:</span> Some sectors might typically activate together (e.g., <math id="Ch11.S4.I2.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{narr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{narr}</annotation></semantics></math> and <math id="Ch11.S4.I2.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math> during introspection).</p>
</div></li>
</ul>
<p id="Ch11.S4.p4.2" class="ltx_p">The history of sector activations <math id="Ch11.S4.p4.m1" class="ltx_Math" alttext="\alpha_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}(t)</annotation></semantics></math> provides an introspective trace of the agent’s cognitive activity over time, useful for meta-control and analysis. Dynamic activation and mode switching give the agent cognitive flexibility, allowing it to allocate resources (<math id="Ch11.S4.p4.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>) and adopt appropriate processing strategies based on demand.</p>
</div>
</section>
<section id="Ch11.S5" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">11.5. </span>Sector-Targeted Operations</h4>

<div id="Ch11.S5.p1" class="ltx_para">
<p id="Ch11.S5.p1.1" class="ltx_p">The functional stratification provided by semantic sectors enables epistemic operations to be applied with precision. Instead of modifying the entire belief state <math id="Ch11.S5.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, agents can target specific sectors.</p>
<ul id="Ch11.S5.I1" class="ltx_itemize">
<li id="Ch11.S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S5.I1.i1.p1" class="ltx_para">
<p id="Ch11.S5.I1.i1.p1.1" class="ltx_p"><span id="Ch11.S5.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Sectoral Assimilation (<math id="Ch11.S5.I1.i1.p1.m1" class="ltx_Math" alttext="A_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">A_{\Sigma}</annotation></semantics></math>):</span> New information <math id="Ch11.S5.I1.i1.p1.m2" class="ltx_Math" alttext="X(s)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X(s)</annotation></semantics></math> can be routed to and integrated primarily within a specific sector <math id="Ch11.S5.I1.i1.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, based on content type or context. For example, perceptual input updates <math id="Ch11.S5.I1.i1.p1.m4" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math>, while instructions update <math id="Ch11.S5.I1.i1.p1.m5" class="ltx_Math" alttext="\Sigma_{plan}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{plan}</annotation></semantics></math>.</p>
</div></li>
<li id="Ch11.S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S5.I1.i2.p1" class="ltx_para">
<p id="Ch11.S5.I1.i2.p1.1" class="ltx_p"><span id="Ch11.S5.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Sectoral Nullification (<math id="Ch11.S5.I1.i2.p1.m1" class="ltx_Math" alttext="N^{\Sigma}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>t</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">N^{\Sigma}_{t}</annotation></semantics></math>):</span> Belief decay can be applied selectively. An agent might allow episodic memories in <math id="Ch11.S5.I1.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{narr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{narr}</annotation></semantics></math> to fade via <math id="Ch11.S5.I1.i2.p1.m3" class="ltx_Math" alttext="N^{\Sigma_{narr}}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>t</mi><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msubsup><annotation encoding="application/x-tex">N^{\Sigma_{narr}}_{t}</annotation></semantics></math> while preserving stable policies in <math id="Ch11.S5.I1.i2.p1.m4" class="ltx_Math" alttext="\Sigma_{plan}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{plan}</annotation></semantics></math>. This implements selective forgetting.</p>
</div></li>
<li id="Ch11.S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S5.I1.i3.p1" class="ltx_para">
<p id="Ch11.S5.I1.i3.p1.1" class="ltx_p"><span id="Ch11.S5.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Sectoral Annihilation (<math id="Ch11.S5.I1.i3.p1.m1" class="ltx_Math" alttext="K_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">K_{\Sigma}</annotation></semantics></math>):</span> Abrupt erasure can be confined to a specific sector, <math id="Ch11.S5.I1.i3.p1.m2" class="ltx_Math" alttext="\phi_{new}=\phi\setminus\phi|_{\Sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mrow><mi>ϕ</mi><mo>∖</mo><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Σ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\phi_{new}=\phi\setminus\phi|_{\Sigma}</annotation></semantics></math>. This allows for functional resets without total memory loss. Examples include <math id="Ch11.S5.I1.i3.p1.m3" class="ltx_Math" alttext="K_{plan}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">K_{plan}</annotation></semantics></math> to discard an outdated plan, <math id="Ch11.S5.I1.i3.p1.m4" class="ltx_Math" alttext="K_{refl}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">K_{refl}</annotation></semantics></math> to suppress introspection and enter a reactive state, or <math id="Ch11.S5.I1.i3.p1.m5" class="ltx_Math" alttext="K_{affect}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">K_{affect}</annotation></semantics></math> to reset emotional state.</p>
</div></li>
<li id="Ch11.S5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S5.I1.i4.p1" class="ltx_para">
<p id="Ch11.S5.I1.i4.p1.1" class="ltx_p"><span id="Ch11.S5.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Sector-Sensitive Control (<math id="Ch11.S5.I1.i4.p1.m1" class="ltx_Math" alttext="\pi(\phi|_{\Sigma_{i}})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(\phi|_{\Sigma_{i}})</annotation></semantics></math>):</span> Policies can base decisions on the state of specific sectors (e.g., "If <math id="Ch11.S5.I1.i4.p1.m2" class="ltx_Math" alttext="\kappa(\Sigma_{plan},\phi)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(\Sigma_{plan},\phi)</annotation></semantics></math> is low, initiate reflection in <math id="Ch11.S5.I1.i4.p1.m3" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math>"). They can also issue commands targeting sectors (e.g., "Trigger <math id="Ch11.S5.I1.i4.p1.m4" class="ltx_Math" alttext="K_{narr}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">K_{narr}</annotation></semantics></math> to reduce interference").</p>
</div></li>
<li id="Ch11.S5.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch11.S5.I1.i5.p1" class="ltx_para">
<p id="Ch11.S5.I1.i5.p1.1" class="ltx_p"><span id="Ch11.S5.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Sector-Level Information Access:</span> Operations like extracting content (<math id="Ch11.S5.I1.i5.p1.m1" class="ltx_Math" alttext="\phi|_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">\phi|_{\Sigma}</annotation></semantics></math> for summary), computing diagnostics (<math id="Ch11.S5.I1.i5.p1.m2" class="ltx_Math" alttext="\lambda(\Sigma,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(\Sigma,\phi)</annotation></semantics></math> for load), or saving/restoring sector states become possible.</p>
</div></li>
</ul>
</div>
<figure id="Ch11.F2" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch11.F2.pic1" class="ltx_picture ltx_centering" height="164.94" overflow="visible" version="1.1" viewBox="0 0 533.39 164.94" width="533.39"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,164.94) matrix(1 0 0 -1 0 0) translate(102.92,0) translate(0,102.97)"><g stroke-width="0.8pt"><path style="fill:none" d="M 0 0 M 102.36 0 C 102.36 33.92 56.53 61.42 0 61.42 C -56.53 61.42 -102.36 33.92 -102.36 0 C -102.36 -33.92 -56.53 -61.42 0 -61.42 C 56.53 -61.42 102.36 -33.92 102.36 0 Z M 0 0"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -62.51 -95.24)"><foreignObject style="--ltx-fo-width:9.17em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="117.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch11.F2.pic1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Before:<span id="Ch11.F2.pic1.1.1" class="ltx_text ltx_font_medium"> Belief state <math id="Ch11.F2.pic1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></span></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="stroke:none" d="M 276.38 20.47 M 317.32 20.47 C 317.32 34.61 298.99 46.06 276.38 46.06 C 253.77 46.06 235.43 34.61 235.43 20.47 C 235.43 6.34 253.77 -5.12 276.38 -5.12 C 298.99 -5.12 317.32 6.34 317.32 20.47 Z M 276.38 20.47"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -61.88 18.51)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.24em;font-size:8.19pt;" height="9.32" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="21.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F2.pic1.m2" class="ltx_Math" alttext="\Sigma_{\text{plan}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Σ</mi><mtext mathsize="0.700em">plan</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{plan}}</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 122.83 0 L 198.76 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 195.59 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 153.78 6.83)"><foreignObject style="--ltx-fo-width:1.56em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.13em;font-size:9.25pt;" height="10.18" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="20"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F2.pic1.m3" class="ltx_Math" alttext="K_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">K</mi><mi mathsize="0.900em" mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">K_{\Sigma}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 327.56 0 M 429.92 0 C 429.92 33.92 384.09 61.42 327.56 61.42 C 271.03 61.42 225.2 33.92 225.2 0 C 225.2 -33.92 271.03 -61.42 327.56 -61.42 C 384.09 -61.42 429.92 -33.92 429.92 0 Z M 327.56 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 287.49 -95.24)"><foreignObject style="--ltx-fo-width:3.32em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="42.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch11.F2.pic1.2" class="ltx_text ltx_font_bold" style="font-size:90%;">After:<span id="Ch11.F2.pic1.2.1" class="ltx_text ltx_font_medium"> <math id="Ch11.F2.pic1.m4" class="ltx_Math" alttext="K_{\Sigma}(\phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi mathvariant="normal">Σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\Sigma}(\phi)</annotation></semantics></math></span></span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M -51.18 20.47 M -10.24 20.47 C -10.24 34.61 -28.57 46.06 -51.18 46.06 C -73.79 46.06 -92.13 34.61 -92.13 20.47 C -92.13 6.34 -73.79 -5.12 -51.18 -5.12 C -28.57 -5.12 -10.24 6.34 -10.24 20.47 Z M -51.18 20.47"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 261.32 17.95)"><foreignObject style="--ltx-fo-width:2.35em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="11.97" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="30.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch11.F2.pic1.m5" class="ltx_Math" alttext="{\Sigma_{\text{plan}}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em" mathvariant="normal">Σ</mi><mtext mathsize="0.900em">plan</mtext></msub><annotation encoding="application/x-tex">{\Sigma_{\text{plan}}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch11.F2.3" class="ltx_text" style="font-size:90%;">Figure 11.2</span>. </span><span id="Ch11.F2.4" class="ltx_text" style="font-size:90%;">Illustration of sector-targeted annihilation. The operator <math id="Ch11.F2.m4" class="ltx_Math" alttext="K_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">K_{\Sigma}</annotation></semantics></math> removes content associated with a specific semantic sector (e.g., <math id="Ch11.F2.m5" class="ltx_Math" alttext="\Sigma_{\text{plan}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mtext>plan</mtext></msub><annotation encoding="application/x-tex">\Sigma_{\text{plan}}</annotation></semantics></math>) from a belief state <math id="Ch11.F2.m6" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, leaving the rest of the structure intact.</span></figcaption>
</figure>
<div id="Ch11.S5.p2" class="ltx_para">
<p id="Ch11.S5.p2.1" class="ltx_p">Sector-targeted operations transform sectors from mere labels into functional components that can be independently monitored, managed, and modified, enabling fine-grained control over the agent’s internal cognitive landscape.</p>
</div>
</section>
<section id="Ch11.S6" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">11.6. </span>Applications and Illustrative Examples</h4>

<div id="Ch11.S6.p1" class="ltx_para">
<p id="Ch11.S6.p1.1" class="ltx_p">Consider these scenarios illustrating the utility of semantic sectors:</p>
<ol id="Ch11.S6.I1" class="ltx_enumerate">
<li id="Ch11.S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="Ch11.S6.I1.i1.p1" class="ltx_para">
<p id="Ch11.S6.I1.i1.p1.1" class="ltx_p"><span id="Ch11.S6.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Focused Perception and Reflection:</span> An agent observes an anomaly ("Object shape unexpected" <math id="Ch11.S6.I1.i1.p1.m1" class="ltx_Math" alttext="\in\Sigma_{perc}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\in\Sigma_{perc}</annotation></semantics></math>). High activation in <math id="Ch11.S6.I1.i1.p1.m2" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math> triggers activation of <math id="Ch11.S6.I1.i1.p1.m3" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math> and <math id="Ch11.S6.I1.i1.p1.m4" class="ltx_Math" alttext="\Sigma_{narr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{narr}</annotation></semantics></math>. The agent consults past experiences (<math id="Ch11.S6.I1.i1.p1.m5" class="ltx_Math" alttext="\phi|_{\Sigma_{narr}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><annotation encoding="application/x-tex">\phi|_{\Sigma_{narr}}</annotation></semantics></math>) and evaluates significance (<math id="Ch11.S6.I1.i1.p1.m6" class="ltx_Math" alttext="\phi|_{\Sigma_{refl}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></msub><annotation encoding="application/x-tex">\phi|_{\Sigma_{refl}}</annotation></semantics></math>), leading to a revised understanding ("This might be the damaged component mentioned earlier" <math id="Ch11.S6.I1.i1.p1.m7" class="ltx_Math" alttext="\in\Sigma_{refl}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\in\Sigma_{refl}</annotation></semantics></math>). Information flows selectively between relevant sectors.</p>
</div></li>
<li id="Ch11.S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="Ch11.S6.I1.i2.p1" class="ltx_para">
<p id="Ch11.S6.I1.i2.p1.1" class="ltx_p"><span id="Ch11.S6.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Plan Reset and Adaptation:</span> An agent executing a plan (<math id="Ch11.S6.I1.i2.p1.m1" class="ltx_Math" alttext="\phi|_{\Sigma_{plan}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></msub><annotation encoding="application/x-tex">\phi|_{\Sigma_{plan}}</annotation></semantics></math>) encounters an unexpected obstacle detected in <math id="Ch11.S6.I1.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math>. A meta-controller detects the conflict between <math id="Ch11.S6.I1.i2.p1.m3" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math> and <math id="Ch11.S6.I1.i2.p1.m4" class="ltx_Math" alttext="\Sigma_{plan}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{plan}</annotation></semantics></math>, triggers <math id="Ch11.S6.I1.i2.p1.m5" class="ltx_Math" alttext="K_{plan}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">K_{plan}</annotation></semantics></math> to erase the invalid plan, preserves memory in <math id="Ch11.S6.I1.i2.p1.m6" class="ltx_Math" alttext="\Sigma_{narr}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{narr}</annotation></semantics></math>, and initiates a replanning process by activating <math id="Ch11.S6.I1.i2.p1.m7" class="ltx_Math" alttext="\Sigma_{plan}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{plan}</annotation></semantics></math> with new input derived from <math id="Ch11.S6.I1.i2.p1.m8" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math> and <math id="Ch11.S6.I1.i2.p1.m9" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math>.</p>
</div></li>
<li id="Ch11.S6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="Ch11.S6.I1.i3.p1" class="ltx_para">
<p id="Ch11.S6.I1.i3.p1.1" class="ltx_p"><span id="Ch11.S6.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Load-Based Mode Switching:</span> During a high-intensity task, the activation load <math id="Ch11.S6.I1.i3.p1.m1" class="ltx_Math" alttext="\lambda(\Sigma_{perc},\phi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(\Sigma_{perc},\phi)</annotation></semantics></math> and <math id="Ch11.S6.I1.i3.p1.m2" class="ltx_Math" alttext="\lambda(\Sigma_{plan},\phi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(\Sigma_{plan},\phi)</annotation></semantics></math> become very high. A control policy detects this and reduces <math id="Ch11.S6.I1.i3.p1.m3" class="ltx_Math" alttext="\alpha_{refl}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{refl}(t)</annotation></semantics></math> and <math id="Ch11.S6.I1.i3.p1.m4" class="ltx_Math" alttext="\alpha_{narr}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{narr}(t)</annotation></semantics></math>, effectively shifting the agent into a more reactive mode focused on immediate perception and action, suppressing deeper reflection until the load decreases.</p>
</div></li>
<li id="Ch11.S6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="Ch11.S6.I1.i4.p1" class="ltx_para">
<p id="Ch11.S6.I1.i4.p1.1" class="ltx_p"><span id="Ch11.S6.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Parallel Processing:</span> Receiving a complex instruction like "Check the pressure, but only if the safety interlock is engaged," might simultaneously update <math id="Ch11.S6.I1.i4.p1.m1" class="ltx_Math" alttext="\Sigma_{plan}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{plan}</annotation></semantics></math> ("Add task: check pressure"), <math id="Ch11.S6.I1.i4.p1.m2" class="ltx_Math" alttext="\Sigma_{perc}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{perc}</annotation></semantics></math> ("Need to check interlock status"), and <math id="Ch11.S6.I1.i4.p1.m3" class="ltx_Math" alttext="\Sigma_{refl}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{refl}</annotation></semantics></math> ("Conditional execution required"). Beliefs develop concurrently in relevant sectors.</p>
</div></li>
</ol>
<p id="Ch11.S6.p1.2" class="ltx_p">These examples show how sectoral structure enables targeted updates, selective forgetting, adaptive control, and parallel processing, contributing to more robust and flexible cognitive behavior.</p>
</div>
</section>
<section id="Ch11.S7" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">11.7. </span>Conclusion: Stratification as Organization</h4>

<div id="Ch11.S7.p1" class="ltx_para">
<p id="Ch11.S7.p1.1" class="ltx_p">Semantic sectors introduce essential functional stratification into the agent’s belief space <math id="Ch11.S7.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>. By partitioning or organizing <math id="Ch11.S7.p1.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> into coherent, addressable subregions based on cognitive role—such as perception, narrative, planning, and reflection—we move beyond a monolithic view of belief towards a modular architecture.</p>
</div>
<div id="Ch11.S7.p2" class="ltx_para">
<p id="Ch11.S7.p2.1" class="ltx_p">This stratification is crucial for enabling selective epistemic operations: targeted assimilation, sector-specific nullification or annihilation, and sector-aware control policies. It supports dynamic mode switching, allowing agents to adapt their cognitive posture by modulating sector activations (<math id="Ch11.S7.p2.m1" class="ltx_Math" alttext="\vec{\alpha}(t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t)</annotation></semantics></math>). This functional modularity provides the precision necessary for managing complex internal states, resolving conflicts locally, focusing attention (allocating <math id="Ch11.S7.p2.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>), and preserving cognitive coherence (<math id="Ch11.S7.p2.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>) during ongoing interaction and learning.</p>
</div>
<div id="Ch11.S7.p3" class="ltx_para">
<p id="Ch11.S7.p3.1" class="ltx_p">Semantic sectors are, in essence, the operating system underlying intelligent belief management. They provide the structure necessary for an agent to think in parts, to regulate distinct streams of thought, and to maintain stability while adapting dynamically. Stratification does not fragment thought; it organizes it, providing the foundation for scalable, controllable, and introspectively capable artificial minds.</p>
</div>
<section id="Ch11.S7.SSx1" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection">Chapter Summary</h5>

<div id="Ch11.S7.SSx1.p1" class="ltx_para">
<p id="Ch11.S7.SSx1.p1.1" class="ltx_p">This chapter introduces Semantic Sectors (<math id="Ch11.S7.SSx1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>) as a principle for organizing the belief space <math id="Ch11.S7.SSx1.p1.m2" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> based on functional modularity, complementing the vertical structure provided by semantic scaling. It proposes that <math id="Ch11.S7.SSx1.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> can be stratified into potentially overlapping, addressable subregions (e.g., <math id="Ch11.S7.SSx1.p1.m4" class="ltx_Math" alttext="\Sigma_{perc},\Sigma_{plan},\Sigma_{narr},\Sigma_{refl}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\Sigma_{perc},\Sigma_{plan},\Sigma_{narr},\Sigma_{refl}</annotation></semantics></math>), each associated with distinct cognitive functions or content types. This sectoral organization, motivated by cognitive science and control principles, enables targeted epistemic operations, allowing processes like Assimilation (<math id="Ch11.S7.SSx1.p1.m5" class="ltx_Math" alttext="A_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">A_{\Sigma}</annotation></semantics></math>), Nullification (<math id="Ch11.S7.SSx1.p1.m6" class="ltx_Math" alttext="N_{t}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>t</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">N_{t}^{\Sigma}</annotation></semantics></math>), or Annihilation (<math id="Ch11.S7.SSx1.p1.m7" class="ltx_Math" alttext="K_{\Sigma}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi mathvariant="normal">Σ</mi></msub><annotation encoding="application/x-tex">K_{\Sigma}</annotation></semantics></math>) to be applied selectively. The chapter explores the dynamics of sector activation (<math id="Ch11.S7.SSx1.p1.m8" class="ltx_Math" alttext="\vec{\alpha}(t)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\alpha}(t)</annotation></semantics></math>), modeling cognitive mode switching as changes in the relative activation of different sectors. This structure supports sector-specific monitoring (e.g., coherence <math id="Ch11.S7.SSx1.p1.m9" class="ltx_Math" alttext="\kappa(\Sigma,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(\Sigma,\phi)</annotation></semantics></math>, load <math id="Ch11.S7.SSx1.p1.m10" class="ltx_Math" alttext="\lambda(\Sigma,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(\Sigma,\phi)</annotation></semantics></math>) and control policies sensitive to functional context. Semantic sectors provide the necessary architecture for managing cognitive complexity, focusing attention (effort <math id="Ch11.S7.SSx1.p1.m11" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>), regulating internal processes modularly, and enabling specialized reasoning within a unified belief space.</p>
</div>
</section>
</section>
</section>
<section id="Ch12" class="ltx_chapter">
<h3 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 12 </span>Semantic Geometry</h3>

<section id="Ch12.S1" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">12.1. </span>Introduction: Unifying Structure</h4>

<div id="Ch12.S1.p1" class="ltx_para">
<p id="Ch12.S1.p1.1" class="ltx_p">The preceding chapters introduced two fundamental organizing principles for the semantic state space <math id="Ch12.S1.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>: Semantic Scaling (Chapter <a href="#Ch10" title="Chapter 10 Semantic Scaling ‣ Part III Structuring Belief: Modularity and Abstraction ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), which stratifies belief vertically by abstraction level <math id="Ch12.S1.p1.m2" class="ltx_Math" alttext="\Phi^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{(k)}</annotation></semantics></math>, and Semantic Sectors (Chapter <a href="#Ch11" title="Chapter 11 Semantic Sectors ‣ Part III Structuring Belief: Modularity and Abstraction ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), which provide functional modularity horizontally via regions <math id="Ch12.S1.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. While powerful individually, their true potential emerges when unified within a cohesive geometric framework.</p>
</div>
<div id="Ch12.S1.p2" class="ltx_para">
<p id="Ch12.S1.p2.1" class="ltx_p">This chapter introduces Semantic Geometry, a model that synthesizes these two dimensions—abstraction and function—to construe the belief space <math id="Ch12.S1.p2.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> as a structured epistemic manifold. Within this geometry, each belief state <math id="Ch12.S1.p2.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> (or its components <math id="Ch12.S1.p2.m3" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math>) can be conceptually positioned using coordinates <math id="Ch12.S1.p2.m4" class="ltx_Math" alttext="(\Sigma,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,k)</annotation></semantics></math> that specify both its functional modality and its level of generality.</p>
</div>
<div id="Ch12.S1.p3" class="ltx_para">
<p id="Ch12.S1.p3.1" class="ltx_p">This geometric perspective transforms our understanding of belief dynamics. Epistemic operations like assimilation (<math id="Ch12.S1.p3.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>), abstraction (<math id="Ch12.S1.p3.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>), elaboration (<math id="Ch12.S1.p3.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>), reflection (<math id="Ch12.S1.p3.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>), nullification (<math id="Ch12.S1.p3.m5" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>), and even control policies are no longer viewed as disparate transformations but as structured trajectories across this semantic manifold. This framework provides agents with:</p>
<ul id="Ch12.S1.I1" class="ltx_itemize">
<li id="Ch12.S1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch12.S1.I1.i1.p1" class="ltx_para">
<p id="Ch12.S1.I1.i1.p1.1" class="ltx_p">A unified space for representing diverse belief types.</p>
</div></li>
<li id="Ch12.S1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch12.S1.I1.i2.p1" class="ltx_para">
<p id="Ch12.S1.I1.i2.p1.1" class="ltx_p">Structure for modular, depth-aware reasoning and control.</p>
</div></li>
<li id="Ch12.S1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch12.S1.I1.i3.p1" class="ltx_para">
<p id="Ch12.S1.I1.i3.p1.1" class="ltx_p">A basis for defining semantic distance and coherence across sectors and scales.</p>
</div></li>
<li id="Ch12.S1.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch12.S1.I1.i4.p1" class="ltx_para">
<p id="Ch12.S1.I1.i4.p1.1" class="ltx_p">A language for modeling belief evolution as continuous motion and flow.</p>
</div></li>
</ul>
<p id="Ch12.S1.p3.2" class="ltx_p">Semantic geometry turns the internal landscape of belief into a navigable space, providing not just a map of what an agent believes, but a structure for how it thinks and moves through meaning.</p>
</div>
</section>
<section id="Ch12.S2" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">12.2. </span>Geometric Construction of Belief Space</h4>

<div id="Ch12.S2.p1" class="ltx_para">
<p id="Ch12.S2.p1.1" class="ltx_p">We construct the belief space <math id="Ch12.S2.p1.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> as a manifold structured by the two orthogonal axes identified previously: semantic sector (<math id="Ch12.S2.p1.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>) and abstraction level (<math id="Ch12.S2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>).</p>
</div>
<div id="Ch12.S2.p2" class="ltx_para">
<p id="Ch12.S2.p2.1" class="ltx_p"><span id="Ch12.S2.p2.1.1" class="ltx_text ltx_font_bold">Definition (Stratified Manifold):</span> The semantic state space <math id="Ch12.S2.p2.m1" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is the union of subspaces <math id="Ch12.S2.p2.m2" class="ltx_Math" alttext="\Sigma^{(k)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Sigma^{(k)}</annotation></semantics></math>, where <math id="Ch12.S2.p2.m3" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is the set of defined semantic sectors and <math id="Ch12.S2.p2.m4" class="ltx_Math" alttext="k\in\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}_{\geq 0}</annotation></semantics></math> is the abstraction level:</p>
<table id="Ch12.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch12.Ex1.m1" class="ltx_Math" alttext="\Phi=\bigcup_{\Sigma\in\mathcal{S}}\bigcup_{k\in\mathbb{Z}_{\geq 0}}\Sigma^{(k)}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">⋃</mo><mrow><mi mathvariant="normal">Σ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow></munder><msup><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi=\bigcup_{\Sigma\in\mathcal{S}}\bigcup_{k\in\mathbb{Z}_{\geq 0}}\Sigma^{(k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch12.S2.p2.2" class="ltx_p">where <math id="Ch12.S2.p2.m5" class="ltx_Math" alttext="\Sigma^{(k)}=\Sigma\cap\Phi^{(k)}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mi mathvariant="normal">Σ</mi><mo>∩</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma^{(k)}=\Sigma\cap\Phi^{(k)}</annotation></semantics></math> represents the subset of belief space corresponding to sector <math id="Ch12.S2.p2.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> at abstraction level <math id="Ch12.S2.p2.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
<div id="Ch12.S2.p3" class="ltx_para">
<p id="Ch12.S2.p3.1" class="ltx_p">This construction yields a conceptual grid or surface where each cell <math id="Ch12.S2.p3.m1" class="ltx_Math" alttext="(\Sigma,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,k)</annotation></semantics></math> holds beliefs of a specific type and abstraction level.</p>
</div>
<figure id="Ch12.F1" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch12.F1.pic1" class="ltx_picture ltx_centering" height="303.63" overflow="visible" version="1.1" viewBox="0 0 453.44 303.63" width="453.44"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,303.63) matrix(1 0 0 -1 0 0) translate(119.05,0) translate(0,68.67)"><g stroke-width="0.8pt"><path style="fill:none" d="M -59.06 -59.06 L 215.43 -59.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 215.98 -59.06)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 221.7 -62.57)"><foreignObject style="--ltx-fo-width:7.39em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="94.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch12.F1.pic1.1" class="ltx_text" style="font-size:90%;">Semantic Sector <math id="Ch12.F1.pic1.m1" class="ltx_Math" alttext="\Sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Sigma_{i}</annotation></semantics></math></span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -59.06 -59.06 L -59.06 215.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 -59.06 215.98)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000