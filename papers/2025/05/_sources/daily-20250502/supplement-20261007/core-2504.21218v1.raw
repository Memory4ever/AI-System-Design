</foreignObject></g><path style="fill:none" d="M -4.74 -68.54 L -23.98 -107.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.44728 -0.8944 0.8944 -0.44728 -24.23 -107.5)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 14.72 -121.48)"><foreignObject style="--ltx-fo-width:2.31em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.14em;font-size:9.25pt;" height="10.27" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="29.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F2.pic1.m7" class="ltx_Math" alttext="A_{\text{conf}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mtext mathsize="0.900em">conf</mtext></msub><annotation encoding="application/x-tex">A_{\text{conf}}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 4.74 -68.54 L 23.88 -106.82"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.44725 -0.89441 0.89441 0.44725 24.13 -107.31)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.7 -121.48)"><foreignObject style="--ltx-fo-width:2.01em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.14em;font-size:9.25pt;" height="10.27" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="25.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F2.pic1.m8" class="ltx_Math" alttext="A_{\text{abs}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mtext mathsize="0.900em">abs</mtext></msub><annotation encoding="application/x-tex">A_{\text{abs}}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 14.23 -68.54 L 72.21 -107.19"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.83208 -0.55467 0.55467 0.83208 72.67 -107.5)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 147.02 -62.17)"><foreignObject style="--ltx-fo-width:9.04em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="115.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F2.pic1.4" class="ltx_text" style="font-size:90%;">Depth of Integration</span></span></span></foreignObject></g><path style="fill:none" d="M 37.09 -10.7 L 166.58 -48.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.96083 -0.27713 0.27713 0.96083 167.11 -48.2)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 125.21 -122.43)"><foreignObject style="--ltx-fo-width:3.2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="40.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F2.pic1.5" class="ltx_text" style="font-size:90%;">Surface</span></span></span></foreignObject></g><path style="fill:none" d="M 194.03 -69.76 L 155.94 -107.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.70715 -0.70705 0.70705 -0.70715 155.55 -108.23)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 176.25 -122.43)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="56.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F2.pic1.6" class="ltx_text" style="font-size:90%;">Structural</span></span></span></foreignObject></g><path style="fill:none" d="M 204.72 -69.76 L 204.72 -107.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 204.72 -108.07)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 242.62 -122.43)"><foreignObject style="--ltx-fo-width:3.33em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="42.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F2.pic1.7" class="ltx_text" style="font-size:90%;">Schema</span></span></span></foreignObject></g><path style="fill:none" d="M 215.42 -69.76 L 253.51 -107.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.70715 -0.70705 0.70705 0.70715 253.9 -108.23)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch13.F2.3" class="ltx_text" style="font-size:90%;">Figure 13.2</span>. </span><span id="Ch13.F2.4" class="ltx_text" style="font-size:90%;">Taxonomy of assimilation operators categorized by input source (e.g., perception, language, simulation), assimilation mode (elaborative, corrective, confirmatory, abstracting), and depth of integration (surface-level, structural, schema-modifying). This hierarchy supports modular design of belief integration processes.</span></figcaption>
</figure>
<div id="Ch13.S4.p3" class="ltx_para">
<p id="Ch13.S4.p3.1" class="ltx_p">A specific assimilation event might involve a combination of these (e.g., corrective assimilation of perceptual input at the structural level). This taxonomy highlights that <math id="Ch13.S4.p3.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> represents a family of related processes for integrating object-level information, distinct from the meta-level integration performed by <math id="Ch13.S4.p3.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. The following sections detail some key subtypes of <math id="Ch13.S4.p3.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.</p>
</div>
</section>
<section id="Ch13.S5" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">13.5. </span>Elaborative Assimilation (<math id="Ch13.S5.m1" class="ltx_Math" alttext="A_{\text{elab}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mtext>elab</mtext></msub><annotation encoding="application/x-tex">A_{\text{elab}}</annotation></semantics></math>)</h4>

<div id="Ch13.S5.p1" class="ltx_para">
<p id="Ch13.S5.p1.1" class="ltx_p">Elaborative assimilation focuses on enriching the current belief state <math id="Ch13.S5.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> by not only incorporating the input <math id="Ch13.S5.p1.m2" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math> but also generating relevant inferences, predictions, or contextual links based on it. Notionally:</p>
<table id="Ch13.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch13.Ex2.m1" class="ltx_Math" alttext="\phi_{new}=\phi\cup\phi_{input}\cup\phi_{elab}" display="block" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mrow><mi>ϕ</mi><mo>∪</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi>ϕ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\phi_{new}=\phi\cup\phi_{input}\cup\phi_{elab}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch13.S5.p1.2" class="ltx_p">where <math id="Ch13.S5.p1.m3" class="ltx_Math" alttext="\phi_{elab}=\{\varphi^{elab}_{j}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>φ</mi><mi>j</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\phi_{elab}=\{\varphi^{elab}_{j}\}</annotation></semantics></math> is a set of generated elaborations. The mechanics involve applying elaboration functions or rules <math id="Ch13.S5.p1.m4" class="ltx_Math" alttext="E_{k}:\Phi\times\phi_{input}\rightarrow\{\varphi^{elab}_{j}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>k</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>φ</mi><mi>j</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{k}:\Phi\times\phi_{input}\rightarrow\{\varphi^{elab}_{j}\}</annotation></semantics></math> that trigger based on patterns in the input and the current context <math id="Ch13.S5.p1.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Elaborations might:</p>
<ul id="Ch13.S5.I1" class="ltx_itemize">
<li id="Ch13.S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S5.I1.i1.p1" class="ltx_para">
<p id="Ch13.S5.I1.i1.p1.1" class="ltx_p">Complete partial information.</p>
</div></li>
<li id="Ch13.S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S5.I1.i2.p1" class="ltx_para">
<p id="Ch13.S5.I1.i2.p1.1" class="ltx_p">Link input to existing goals or schemas in <math id="Ch13.S5.I1.i2.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>.</p>
</div></li>
<li id="Ch13.S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S5.I1.i3.p1" class="ltx_para">
<p id="Ch13.S5.I1.i3.p1.1" class="ltx_p">Predict immediate consequences or affordances.</p>
</div></li>
<li id="Ch13.S5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S5.I1.i4.p1" class="ltx_para">
<p id="Ch13.S5.I1.i4.p1.1" class="ltx_p">Retrieve relevant associated memories (via the <math id="Ch13.S5.I1.i4.p1.m1" class="ltx_Math" alttext="Q\rightarrow R" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo stretchy="false">→</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">Q\rightarrow R</annotation></semantics></math> process, Part <a href="#Pt5" title="Part V Semantic Memory: Retrieval and Integration ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a>).</p>
</div></li>
</ul>
<p id="Ch13.S5.p1.3" class="ltx_p"><span id="Ch13.S5.p1.3.1" class="ltx_text ltx_font_bold">Example:</span> If <math id="Ch13.S5.p1.m6" class="ltx_Math" alttext="\phi_{current}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{current}</annotation></semantics></math> contains {"Task is to inspect control panel"} and <math id="Ch13.S5.p1.m7" class="ltx_Math" alttext="\phi_{input}=X(s)=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{input}=X(s)=</annotation></semantics></math> {"Control panel door is ajar"}, then <math id="Ch13.S5.p1.m8" class="ltx_Math" alttext="A_{elab}(\phi_{current},\phi_{input})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{elab}(\phi_{current},\phi_{input})</annotation></semantics></math> might yield <math id="Ch13.S5.p1.m9" class="ltx_Math" alttext="\phi_{new}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{new}</annotation></semantics></math> containing the original beliefs plus <math id="Ch13.S5.p1.m10" class="ltx_Math" alttext="\phi_{elab}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{elab}=</annotation></semantics></math> {"Panel appears accessible", "Inspection task can likely proceed"}.</p>
</div>
<figure id="Ch13.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch13.F3.pic1" class="ltx_picture ltx_centering" height="121.61" overflow="visible" version="1.1" viewBox="0 0 554.74 121.61" width="554.74"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,121.61) matrix(1 0 0 -1 0 0) translate(79.29,0) translate(0,11.14)"><g stroke-width="0.8pt"><path style="fill:none" d="M -78.74 29.22 h 157.48 v 20.29 h -157.48 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -64.2 36.26)"><foreignObject style="--ltx-fo-width:10.06em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="128.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F3.pic1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math><span id="Ch13.F3.pic1.1" class="ltx_text" style="font-size:90%;">: Current Belief State</span></span></span></foreignObject></g><path style="fill:none" d="M -78.74 -10.58 h 157.48 v 21.16 h -157.48 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -50.4 -2.68)"><foreignObject style="--ltx-fo-width:7.88em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.26em;font-size:9.25pt;" height="11.94" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="100.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F3.pic1.m2" class="ltx_Math" alttext="\phi_{\text{input}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">input</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{input}}</annotation></semantics></math><span id="Ch13.F3.pic1.2" class="ltx_text" style="font-size:90%;">: New Input</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 273.99 109.92 L 119.71 109.92 C 116.65 109.92 114.17 107.44 114.17 104.39 L 114.17 92.47 C 114.17 89.41 116.65 86.93 119.71 86.93 L 273.99 86.93 C 277.05 86.93 279.53 89.41 279.53 92.47 L 279.53 104.39 C 279.53 107.44 277.05 109.92 273.99 109.92 Z M 114.17 86.93"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 120.69 93.96)"><foreignObject style="--ltx-fo-width:11.9em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="13.77" overflow="visible" transform="matrix(1 0 0 -1 0 11.34)" width="152.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F3.pic1.m3" class="ltx_Math" alttext="\varphi^{\text{elab}}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">φ</mi><mn mathsize="0.900em">1</mn><mtext mathsize="0.900em">elab</mtext></msubsup><annotation encoding="application/x-tex">\varphi^{\text{elab}}_{1}</annotation></semantics></math><span id="Ch13.F3.pic1.3" class="ltx_text" style="font-size:90%;">: Inferred consequence</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 273.99 70.55 L 119.71 70.55 C 116.65 70.55 114.17 68.07 114.17 65.01 L 114.17 53.1 C 114.17 50.04 116.65 47.56 119.71 47.56 L 273.99 47.56 C 277.05 47.56 279.53 50.04 279.53 53.1 L 279.53 65.01 C 279.53 68.07 277.05 70.55 273.99 70.55 Z M 114.17 47.56"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 135.34 54.59)"><foreignObject style="--ltx-fo-width:9.64em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="13.77" overflow="visible" transform="matrix(1 0 0 -1 0 11.34)" width="123.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F3.pic1.m4" class="ltx_Math" alttext="\varphi^{\text{elab}}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">φ</mi><mn mathsize="0.900em">2</mn><mtext mathsize="0.900em">elab</mtext></msubsup><annotation encoding="application/x-tex">\varphi^{\text{elab}}_{2}</annotation></semantics></math><span id="Ch13.F3.pic1.4" class="ltx_text" style="font-size:90%;">: Contextual link</span></span></span></foreignObject></g><path style="fill:none" d="M 312.51 48.91 h 162.39 v 20.29 h -162.39 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 317.12 55.94)"><foreignObject style="--ltx-fo-width:11.99em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="153.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F3.pic1.m5" class="ltx_Math" alttext="\phi_{\text{new}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">new</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{new}}</annotation></semantics></math><span id="Ch13.F3.pic1.5" class="ltx_text" style="font-size:90%;">: Enriched Belief State</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 35.67 50.07 L 150.99 84.66"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.95784 0.28732 -0.28732 0.95784 147.96 83.75)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 37.12 11.14 L 150.99 45.29"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.95784 0.28732 -0.28732 0.95784 147.96 44.38)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 280.08 98.43 L 393.7 98.43 L 393.7 75.72"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 393.7 78.89)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 280.08 59.06 L 305.99 59.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 302.82 59.06)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 79.29 0 L 393.7 0 L 393.7 42.39"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 393.7 39.22)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch13.F3.3" class="ltx_text" style="font-size:90%;">Figure 13.3</span>. </span><span id="Ch13.F3.4" class="ltx_text" style="font-size:90%;">Elaborative assimilation <math id="Ch13.F3.m6" class="ltx_Math" alttext="A_{\text{elab}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mtext>elab</mtext></msub><annotation encoding="application/x-tex">A_{\text{elab}}</annotation></semantics></math> enriches the current belief state <math id="Ch13.F3.m7" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> by integrating new input <math id="Ch13.F3.m8" class="ltx_Math" alttext="\phi_{\text{input}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mtext>input</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{input}}</annotation></semantics></math> and generating relevant elaborations <math id="Ch13.F3.m9" class="ltx_Math" alttext="\{\varphi^{\text{elab}}_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><msubsup><mi>φ</mi><mi>i</mi><mtext>elab</mtext></msubsup><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow><annotation encoding="application/x-tex">\{\varphi^{\text{elab}}_{i}\}</annotation></semantics></math>, resulting in an updated belief state <math id="Ch13.F3.m10" class="ltx_Math" alttext="\phi_{\text{new}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mtext>new</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{new}}</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="Ch13.S5.p2" class="ltx_para">
<p id="Ch13.S5.p2.1" class="ltx_p">This mode primarily satisfies desiderata D1 (integration), D2 (coherence, as elaborations are context-based), D6 (anchoring new links), and D7 (locality). It is fundamental for building rich, interconnected belief structures from sparse input.</p>
</div>
</section>
<section id="Ch13.S6" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">13.6. </span>Corrective Assimilation (<math id="Ch13.S6.m1" class="ltx_Math" alttext="A_{\text{corr}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mtext>corr</mtext></msub><annotation encoding="application/x-tex">A_{\text{corr}}</annotation></semantics></math>)</h4>

<div id="Ch13.S6.p1" class="ltx_para">
<p id="Ch13.S6.p1.1" class="ltx_p">Corrective assimilation handles inputs <math id="Ch13.S6.p1.m1" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math> that conflict with the existing belief state <math id="Ch13.S6.p1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Its primary function is to restore coherence <math id="Ch13.S6.p1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> by revising <math id="Ch13.S6.p1.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> before or during the integration of the new information (Desideratum D4). The core components are:</p>
<table id="Ch13.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch13.Ex3.m1" class="ltx_Math" alttext="\phi_{new}=(\phi\setminus R_{\text{rev}}(\phi,\phi_{input}))\cup\phi^{\prime}_{input}" display="block" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∖</mo><mrow><msub><mi>R</mi><mtext>rev</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><msubsup><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\phi_{new}=(\phi\setminus R_{\text{rev}}(\phi,\phi_{input}))\cup\phi^{\prime}_{input}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<ul id="Ch13.S6.I1" class="ltx_itemize">
<li id="Ch13.S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S6.I1.i1.p1" class="ltx_para">
<p id="Ch13.S6.I1.i1.p1.1" class="ltx_p"><span id="Ch13.S6.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Conflict Detection:</span> Identifying contradictions between expressions <math id="Ch13.S6.I1.i1.p1.m1" class="ltx_Math" alttext="\varphi_{i}\in\phi" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo>∈</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\varphi_{i}\in\phi</annotation></semantics></math> and <math id="Ch13.S6.I1.i1.p1.m2" class="ltx_Math" alttext="\varphi_{j}\in\phi_{input}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>j</mi></msub><mo>∈</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\varphi_{j}\in\phi_{input}</annotation></semantics></math> using a predicate <math id="Ch13.S6.I1.i1.p1.m3" class="ltx_Math" alttext="\text{Contradict}(\varphi_{i},\varphi_{j})" display="inline" intent=":literal"><semantics><mrow><mtext>Contradict</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>φ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Contradict}(\varphi_{i},\varphi_{j})</annotation></semantics></math>. This might detect factual opposition, policy violations, or constraint mismatches.</p>
</div></li>
<li id="Ch13.S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S6.I1.i2.p1" class="ltx_para">
<p id="Ch13.S6.I1.i2.p1.1" class="ltx_p"><span id="Ch13.S6.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Revision (<math id="Ch13.S6.I1.i2.p1.m1" class="ltx_Math" alttext="R_{\text{rev}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext class="ltx_mathvariant_bold">rev</mtext></msub><annotation encoding="application/x-tex">R_{\text{rev}}</annotation></semantics></math>):</span> Determining which belief(s) to retract or modify. <math id="Ch13.S6.I1.i2.p1.m2" class="ltx_Math" alttext="R_{\text{rev}}(\phi,\phi_{input})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mtext>rev</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{\text{rev}}(\phi,\phi_{input})</annotation></semantics></math> returns the set of expressions from <math id="Ch13.S6.I1.i2.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> targeted for removal or revision based on the detected conflict. Revision strategies can range from simple retraction to more complex mechanisms based on belief strength, anchoring <math id="Ch13.S6.I1.i2.p1.m4" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>, or source credibility.</p>
</div></li>
<li id="Ch13.S6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S6.I1.i3.p1" class="ltx_para">
<p id="Ch13.S6.I1.i3.p1.1" class="ltx_p"><span id="Ch13.S6.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Integration:</span> Incorporating the (potentially modified) input <math id="Ch13.S6.I1.i3.p1.m1" class="ltx_Math" alttext="\phi^{\prime}_{input}" display="inline" intent=":literal"><semantics><msubsup><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\phi^{\prime}_{input}</annotation></semantics></math> into the revised state <math id="Ch13.S6.I1.i3.p1.m2" class="ltx_Math" alttext="(\phi\setminus R_{\text{rev}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∖</mo><msub><mi>R</mi><mtext>rev</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\phi\setminus R_{\text{rev}})</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="Ch13.S6.p1.2" class="ltx_p"><span id="Ch13.S6.p1.2.1" class="ltx_text ltx_font_bold">Example:</span> If <math id="Ch13.S6.p1.m5" class="ltx_Math" alttext="\phi=" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi=</annotation></semantics></math> {"Panel is closed", "Manual override required"} and <math id="Ch13.S6.p1.m6" class="ltx_Math" alttext="\phi_{input}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{input}=</annotation></semantics></math> {"Panel is open"}, <math id="Ch13.S6.p1.m7" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math> would likely identify "Panel is closed" and perhaps "Manual override required" for removal via <math id="Ch13.S6.p1.m8" class="ltx_Math" alttext="R_{\text{rev}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>rev</mtext></msub><annotation encoding="application/x-tex">R_{\text{rev}}</annotation></semantics></math>. The resulting <math id="Ch13.S6.p1.m9" class="ltx_Math" alttext="\phi_{new}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{new}</annotation></semantics></math> would contain {"Panel is open"}. Subsequent elaboration might then add "Inspection may proceed without override."</p>
</div>
<figure id="Ch13.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch13.F4.pic1" class="ltx_picture ltx_centering" height="69.43" overflow="visible" version="1.1" viewBox="0 0 571.97 69.43" width="571.97"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,69.43) matrix(1 0 0 -1 0 0) translate(89.14,0) translate(0,-20.02)"><g stroke-width="0.8pt"><path style="fill:none" d="M -88.58 68.59 h 177.17 v 20.29 h -177.17 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -64.2 75.63)"><foreignObject style="--ltx-fo-width:10.06em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="128.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F4.pic1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math><span id="Ch13.F4.pic1.1" class="ltx_text" style="font-size:90%;">: Current Belief State</span></span></span></foreignObject></g><path style="fill:none" d="M -88.58 20.91 h 177.17 v 21.16 h -177.17 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -83.29 28.82)"><foreignObject style="--ltx-fo-width:13.01em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.26em;font-size:9.25pt;" height="11.94" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="166.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F4.pic1.m2" class="ltx_Math" alttext="\phi_{\text{input}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">input</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{input}}</annotation></semantics></math><span id="Ch13.F4.pic1.2" class="ltx_text" style="font-size:90%;">: New Conflicting Input</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 279.9 87.68 L 113.8 87.68 C 110.75 87.68 108.27 85.2 108.27 82.14 L 108.27 75.34 C 108.27 72.28 110.75 69.8 113.8 69.8 L 279.9 69.8 C 282.96 69.8 285.43 72.28 285.43 75.34 L 285.43 82.14 C 285.43 85.2 282.96 87.68 279.9 87.68 Z M 108.27 69.8"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 145.56 74.42)"><foreignObject style="--ltx-fo-width:8.01em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="102.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F4.pic1.3" class="ltx_text" style="font-size:90%;">Conflict Detection</span></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 280.47 42.42 L 113.23 42.42 C 110.17 42.42 107.69 39.95 107.69 36.89 L 107.69 26.1 C 107.69 23.05 110.17 20.57 113.23 20.57 L 280.47 20.57 C 283.53 20.57 286.01 23.05 286.01 26.1 L 286.01 36.89 C 286.01 39.95 283.53 42.42 280.47 42.42 Z M 107.69 20.57"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 112.31 28.47)"><foreignObject style="--ltx-fo-width:6.84em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="87.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F4.pic1.4" class="ltx_text" style="font-size:90%;">Belief Revision </span><math id="Ch13.F4.pic1.m3" class="ltx_Math" alttext="R_{\text{rev}}(\phi,\phi_{\text{input}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">R</mi><mtext mathsize="0.900em">rev</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">ϕ</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">input</mtext></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{\text{rev}}(\phi,\phi_{\text{input}})</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 305.12 68.59 h 177.17 v 20.29 h -177.17 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 320.29 75.63)"><foreignObject style="--ltx-fo-width:11.47em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="146.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F4.pic1.m4" class="ltx_Math" alttext="\phi_{\text{new}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">new</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{new}}</annotation></semantics></math><span id="Ch13.F4.pic1.5" class="ltx_text" style="font-size:90%;">: Revised Belief State</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 89.14 78.74 L 101.75 78.74"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 98.58 78.74)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 46.38 42.63 L 151.52 67.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.9724 0.23334 -0.23334 0.9724 148.44 67.12)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 196.85 69.25 L 196.85 48.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 196.85 52.11)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 286.56 31.5 L 393.7 31.5 L 393.7 62.08"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 393.7 58.91)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch13.F4.3" class="ltx_text" style="font-size:90%;">Figure 13.4</span>. </span><span id="Ch13.F4.4" class="ltx_text" style="font-size:90%;">Corrective assimilation <math id="Ch13.F4.m7" class="ltx_Math" alttext="A_{\text{corr}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mtext>corr</mtext></msub><annotation encoding="application/x-tex">A_{\text{corr}}</annotation></semantics></math> detects contradictions between the current belief state <math id="Ch13.F4.m8" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> and new input <math id="Ch13.F4.m9" class="ltx_Math" alttext="\phi_{\text{input}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mtext>input</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{input}}</annotation></semantics></math>, revises <math id="Ch13.F4.m10" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> via a belief revision process <math id="Ch13.F4.m11" class="ltx_Math" alttext="R_{\text{rev}}(\phi,\phi_{\text{input}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mtext>rev</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msub><mi>ϕ</mi><mtext>input</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{\text{rev}}(\phi,\phi_{\text{input}})</annotation></semantics></math>, and integrates the corrected information to form an updated belief state <math id="Ch13.F4.m12" class="ltx_Math" alttext="\phi_{\text{new}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mtext>new</mtext></msub><annotation encoding="application/x-tex">\phi_{\text{new}}</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="Ch13.S6.p2" class="ltx_para">
<p id="Ch13.S6.p2.1" class="ltx_p">Corrective assimilation is crucial for maintaining consistency and adapting beliefs when the environment or information source provides contradictory evidence.</p>
</div>
</section>
<section id="Ch13.S7" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">13.7. </span>Abstracting Assimilation (<math id="Ch13.S7.m1" class="ltx_Math" alttext="A_{\text{abs}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mtext>abs</mtext></msub><annotation encoding="application/x-tex">A_{\text{abs}}</annotation></semantics></math>)</h4>

<div id="Ch13.S7.p1" class="ltx_para">
<p id="Ch13.S7.p1.1" class="ltx_p">Abstracting assimilation integrates new input <math id="Ch13.S7.p1.m1" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math> in a way that promotes generalization or compression, often by identifying patterns across <math id="Ch13.S7.p1.m2" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math> and the existing state <math id="Ch13.S7.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Instead of just adding information, it may replace specific instances with a more general rule or schema, potentially involving the Abstraction operator <math id="Ch13.S7.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. Notionally:</p>
<table id="Ch13.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch13.Ex4.m1" class="ltx_Math" alttext="\phi_{new}=(\phi\setminus\{\varphi_{i1},\dots,\varphi_{im}\})\cup\phi_{gen}" display="block" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><msub><mi>ϕ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\phi_{new}=(\phi\setminus\{\varphi_{i1},\dots,\varphi_{im}\})\cup\phi_{gen}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch13.S7.p1.2" class="ltx_p">where <math id="Ch13.S7.p1.m5" class="ltx_Math" alttext="\{\varphi_{i1},\dots,\varphi_{im}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\varphi_{i1},\dots,\varphi_{im}\}</annotation></semantics></math> are specific beliefs (potentially including some from <math id="Ch13.S7.p1.m6" class="ltx_Math" alttext="\phi_{input}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{input}</annotation></semantics></math>) that are summarized or generalized by the newly constructed abstract belief <math id="Ch13.S7.p1.m7" class="ltx_Math" alttext="\phi_{gen}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{gen}</annotation></semantics></math> (which might reside at a higher abstraction level <math id="Ch13.S7.p1.m8" class="ltx_Math" alttext="\Phi^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{(k+1)}</annotation></semantics></math>).</p>
</div>
<figure id="Ch13.F5" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch13.F5.pic1" class="ltx_picture ltx_centering" height="127.15" overflow="visible" version="1.1" viewBox="0 0 396.88 127.15" width="396.88"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="translate(0,127.15) matrix(1 0 0 -1 0 0) translate(82.76,0) translate(0,18.02)"><path style="fill:none" d="M -82.2 88.28 h 164.41 v 20.29 h -164.41 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -77.59 95.31)"><foreignObject style="--ltx-fo-width:12.29em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="157.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F5.pic1.m1" class="ltx_Math" alttext="\varphi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">φ</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">\varphi_{1}</annotation></semantics></math><span id="Ch13.F5.pic1.1" class="ltx_text" style="font-size:90%;">: Valve A check complete</span></span></span></foreignObject></g><path style="fill:none" d="M -81.94 48.91 h 163.87 v 20.29 h -163.87 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -77.33 55.94)"><foreignObject style="--ltx-fo-width:12.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="156.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F5.pic1.m2" class="ltx_Math" alttext="\varphi_{2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">φ</mi><mn mathsize="0.900em">2</mn></msub><annotation encoding="application/x-tex">\varphi_{2}</annotation></semantics></math><span id="Ch13.F5.pic1.2" class="ltx_text" style="font-size:90%;">: Valve B check complete</span></span></span></foreignObject></g><path style="fill:none" d="M -82.03 9.54 h 164.05 v 20.29 h -164.05 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -77.41 16.57)"><foreignObject style="--ltx-fo-width:12.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="156.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F5.pic1.m3" class="ltx_Math" alttext="\varphi_{3}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">φ</mi><mn mathsize="0.900em">3</mn></msub><annotation encoding="application/x-tex">\varphi_{3}</annotation></semantics></math><span id="Ch13.F5.pic1.3" class="ltx_text" style="font-size:90%;">: Valve C check complete</span></span></span></foreignObject></g><path style="fill:none" d="M 308.03 69.53 L 125.04 69.53 C 121.98 69.53 119.5 67.05 119.5 64 L 119.5 54.11 C 119.5 51.06 121.98 48.58 125.04 48.58 L 308.03 48.58 C 311.09 48.58 313.57 51.06 313.57 54.11 L 313.57 64 C 313.57 67.05 311.09 69.53 308.03 69.53 Z M 119.5 48.58"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 124.12 56.27)"><foreignObject style="--ltx-fo-width:14.61em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="11.73" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="186.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch13.F5.pic1.m4" class="ltx_Math" alttext="\phi_{gen}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">ϕ</mi><mrow><mi mathsize="0.900em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msub><annotation encoding="application/x-tex">\phi_{gen}</annotation></semantics></math><span id="Ch13.F5.pic1.4" class="ltx_text" style="font-size:90%;">: All required valves checked</span></span></span></foreignObject></g><path style="fill:none" d="M 82.76 98.43 L 216.54 98.43 L 216.54 76.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 216.54 79.22)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 82.49 59.06 L 112.99 59.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 109.82 59.06)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 82.58 19.69 L 216.54 19.69 L 216.54 42.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 216.54 38.89)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 13.61 -10.99)"><foreignObject style="--ltx-fo-width:11.24em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="143.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch13.F5.pic1.5" class="ltx_text" style="font-size:90%;">Abstracting Assimilation </span><math id="Ch13.F5.pic1.m5" class="ltx_Math" alttext="A_{\text{abs}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">A</mi><mtext mathsize="0.900em">abs</mtext></msub><annotation encoding="application/x-tex">A_{\text{abs}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch13.F5.3" class="ltx_text" style="font-size:90%;">Figure 13.5</span>. </span><span id="Ch13.F5.4" class="ltx_text" style="font-size:90%;">Abstracting assimilation detects a pattern across input beliefs and replaces them with a generalized, higher-level belief. In this example, individual valve check messages are summarized as a single abstract belief, enabling compression and efficient reasoning.</span></figcaption>
</figure>
<div id="Ch13.S7.p2" class="ltx_para">
<p id="Ch13.S7.p2.1" class="ltx_p"><span id="Ch13.S7.p2.1.1" class="ltx_text ltx_font_bold">Example:</span> After assimilating <math id="Ch13.S7.p2.m1" class="ltx_Math" alttext="\phi_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{1}=</annotation></semantics></math> {"Valve A check complete"}, <math id="Ch13.S7.p2.m2" class="ltx_Math" alttext="\phi_{2}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{2}=</annotation></semantics></math> {"Valve B check complete"}, <math id="Ch13.S7.p2.m3" class="ltx_Math" alttext="\ldots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\ldots</annotation></semantics></math>, <math id="Ch13.S7.p2.m4" class="ltx_Math" alttext="\phi_{N}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>N</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{N}=</annotation></semantics></math> {"Valve N check complete"}, <math id="Ch13.S7.p2.m5" class="ltx_Math" alttext="A_{abs}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">A_{abs}</annotation></semantics></math> might recognize the pattern, remove the individual completion messages via <math id="Ch13.S7.p2.m6" class="ltx_Math" alttext="R_{\text{rev}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mtext>rev</mtext></msub><annotation encoding="application/x-tex">R_{\text{rev}}</annotation></semantics></math>, and add the summary belief <math id="Ch13.S7.p2.m7" class="ltx_Math" alttext="\phi_{gen}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\phi_{gen}=</annotation></semantics></math> {"All required valves checked"} at level <math id="Ch13.S7.p2.m8" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>.</p>
</div>
<div id="Ch13.S7.p3" class="ltx_para">
<p id="Ch13.S7.p3.1" class="ltx_p">This operator is crucial for learning from repeated experience, forming procedural or conceptual abstractions, reducing memory load (<math id="Ch13.S7.p3.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>), and enabling more efficient high-level reasoning. It often involves more complex pattern detection and structural reorganization than other assimilation modes.</p>
</div>
</section>
<section id="Ch13.S8" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">13.8. </span>Conclusion: Assimilation’s Role in Dynamics</h4>

<div id="Ch13.S8.p1" class="ltx_para">
<p id="Ch13.S8.p1.1" class="ltx_p">Assimilation, represented by the family of operators <math id="Ch13.S8.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, is the primary engine driving the constructive evolution of an agent’s belief state <math id="Ch13.S8.p1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> in response to new object-level information, whether external or internal. We have identified several key types:</p>
<ul id="Ch13.S8.I1" class="ltx_itemize">
<li id="Ch13.S8.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S8.I1.i1.p1" class="ltx_para">
<p id="Ch13.S8.I1.i1.p1.1" class="ltx_p">Elaborative (<math id="Ch13.S8.I1.i1.p1.m1" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math>): Enriches beliefs with context and inference.</p>
</div></li>
<li id="Ch13.S8.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S8.I1.i2.p1" class="ltx_para">
<p id="Ch13.S8.I1.i2.p1.1" class="ltx_p">Corrective (<math id="Ch13.S8.I1.i2.p1.m1" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math>): Resolves conflicts and maintains coherence.</p>
</div></li>
<li id="Ch13.S8.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S8.I1.i3.p1" class="ltx_para">
<p id="Ch13.S8.I1.i3.p1.1" class="ltx_p">Abstracting (<math id="Ch13.S8.I1.i3.p1.m1" class="ltx_Math" alttext="A_{abs}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">A_{abs}</annotation></semantics></math>): Generalizes patterns and compresses information.</p>
</div></li>
<li id="Ch13.S8.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch13.S8.I1.i4.p1" class="ltx_para">
<p id="Ch13.S8.I1.i4.p1.1" class="ltx_p">(Confirmatory (<math id="Ch13.S8.I1.i4.p1.m1" class="ltx_Math" alttext="A_{conf}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><annotation encoding="application/x-tex">A_{conf}</annotation></semantics></math>) also mentioned in taxonomy).</p>
</div></li>
</ul>
</div>
<div id="Ch13.S8.p2" class="ltx_para">
<p id="Ch13.S8.p2.1" class="ltx_p">These operators, while distinct in function and effect, all adhere to core desiderata ensuring that belief updates are integrated meaningfully, selectively, and coherently into the existing structure of <math id="Ch13.S8.p2.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. They allow for adaptation, revision, and learning based on interaction and simulation.</p>
</div>
<div id="Ch13.S8.p3" class="ltx_para">
<p id="Ch13.S8.p3.1" class="ltx_p">Assimilation is the counterpoint to the processes of decay (Nullification <math id="Ch13.S8.p3.m1" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>, Chapter <a href="#Ch14" title="Chapter 14 Nullification ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and erasure (Annihilation <math id="Ch13.S8.p3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, Chapter <a href="#Ch15" title="Chapter 15 Annihilation ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). While <math id="Ch13.S8.p3.m3" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> and <math id="Ch13.S8.p3.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> model the dissolution or removal of belief, <math id="Ch13.S8.p3.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> models its growth, refinement, and adaptation based on object-level input. (The integration of meta-level input is handled separately by <math id="Ch13.S8.p3.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, Chapter <a href="#Ch28" title="Chapter 28 Meta-Assimilation: Integrating Introspective Beliefs ‣ Part VIII Meta-Cognition and Recursive Regulation ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>). Together, <math id="Ch13.S8.p3.m7" class="ltx_Math" alttext="A,M,N_{t},K,\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>M</mi><mo>,</mo><msub><mi>N</mi><mi>t</mi></msub><mo>,</mo><mi>K</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">A,M,N_{t},K,\Lambda</annotation></semantics></math>, and <math id="Ch13.S8.p3.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> define the fundamental dynamics governing the lifecycle of belief within the semantic state space <math id="Ch13.S8.p3.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>. Understanding assimilation (<math id="Ch13.S8.p3.m10" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>) is key to understanding how agents learn about the world and maintain a coherent epistemic grasp.</p>
</div>
<section id="Ch13.S8.SSx1" class="ltx_subsection">
<h5 class="ltx_title ltx_title_subsection">Chapter Summary</h5>

<div id="Ch13.S8.SSx1.p1" class="ltx_para">
<p id="Ch13.S8.SSx1.p1.1" class="ltx_p">This chapter details the Assimilation operator (<math id="Ch13.S8.SSx1.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>), the fundamental process for integrating new, structured, object-level information (<math id="Ch13.S8.SSx1.p1.m2" class="ltx_Math" alttext="\Phi_{input}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\Phi_{input}</annotation></semantics></math>)—derived from perception, communication, simulation, or memory retrieval—into the agent’s existing belief state (<math id="Ch13.S8.SSx1.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>). Defined as <math id="Ch13.S8.SSx1.p1.m4" class="ltx_Math" alttext="A:\Phi\times\Phi_{input}\rightarrow\Phi" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">Φ</mi></mrow></mrow><annotation encoding="application/x-tex">A:\Phi\times\Phi_{input}\rightarrow\Phi</annotation></semantics></math>, assimilation is presented not as mere addition, but as an active, context-sensitive, and structure-preserving operation crucial for learning and adaptation. The chapter outlines key desiderata for <math id="Ch13.S8.SSx1.p1.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, including semantic integration, coherence (<math id="Ch13.S8.SSx1.p1.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>) preservation, salience filtering, conflict revision, and anchoring (<math id="Ch13.S8.SSx1.p1.m7" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>). A taxonomy of assimilation operators is proposed, classifying them by input source (e.g., <math id="Ch13.S8.SSx1.p1.m8" class="ltx_Math" alttext="A_{perc},A_{text}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi>A</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">A_{perc},A_{text}</annotation></semantics></math>), function (e.g., elaborative <math id="Ch13.S8.SSx1.p1.m9" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math>, corrective <math id="Ch13.S8.SSx1.p1.m10" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math>, abstracting <math id="Ch13.S8.SSx1.p1.m11" class="ltx_Math" alttext="A_{abs}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">A_{abs}</annotation></semantics></math>), and depth of integration. The mechanisms of key subtypes <math id="Ch13.S8.SSx1.p1.m12" class="ltx_Math" alttext="A_{elab}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">A_{elab}</annotation></semantics></math> (enriching context), <math id="Ch13.S8.SSx1.p1.m13" class="ltx_Math" alttext="A_{corr}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">A_{corr}</annotation></semantics></math> (resolving conflicts), and <math id="Ch13.S8.SSx1.p1.m14" class="ltx_Math" alttext="A_{abs}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">A_{abs}</annotation></semantics></math> (generalizing patterns) are discussed. Assimilation is positioned as the primary constructive dynamic for object-level belief evolution, distinct from meta-level integration (<math id="Ch13.S8.SSx1.p1.m15" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>) and acting as a counterpoint to the dissipative dynamics of Nullification (<math id="Ch13.S8.SSx1.p1.m16" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>) and Annihilation (<math id="Ch13.S8.SSx1.p1.m17" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>).</p>
</div>
</section>
</section>
</section>
<section id="Ch14" class="ltx_chapter">
<h3 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 14 </span>Nullification</h3>

<section id="Ch14.S1" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14.1. </span>Introduction: The Dissolution of Belief</h4>

<div id="Ch14.S1.p1" class="ltx_para">
<p id="Ch14.S1.p1.1" class="ltx_p">Assimilation, as detailed in Chapter <a href="#Ch13" title="Chapter 13 Assimilation ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>, describes the constructive process by which belief states <math id="Ch14.S1.p1.m1" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math> are formed and updated. However, cognition involves not only the accumulation but also the dissolution of belief. Information becomes outdated, attention shifts, memory fades. This chapter introduces nullification, the process modeling the gradual deactivation, forgetting, or softening of structured beliefs over time due to lack of reinforcement or active processing.</p>
</div>
<div id="Ch14.S1.p2" class="ltx_para">
<p id="Ch14.S1.p2.1" class="ltx_p">Nullification stands in contrast to both assimilation (<math id="Ch14.S1.p2.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, construction) and annihilation (<math id="Ch14.S1.p2.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, abrupt erasure, Chapter <a href="#Ch15" title="Chapter 15 Annihilation ‣ Part IV Epistemic Dynamics: Evolution of Thought ‣ Theoretical Foundations for Semantic Cognition in Artificial Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). It represents a continuous, often passive drift towards the epistemic vacuum <math id="Ch14.S1.p2.m3" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. We model nullification via a temporally indexed operator <math id="Ch14.S1.p2.m4" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>:</p>
<table id="Ch14.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch14.Ex1.m1" class="ltx_Math" alttext="N_{t}:\Phi\rightarrow\Phi" display="block" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Φ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Φ</mi></mrow></mrow><annotation encoding="application/x-tex">N_{t}:\Phi\rightarrow\Phi</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch14.S1.p2.2" class="ltx_p">such that for any initial state <math id="Ch14.S1.p2.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, the belief state evolves over time <math id="Ch14.S1.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> under nullification, <math id="Ch14.S1.p2.m7" class="ltx_Math" alttext="\phi_{t}=N_{t}(\phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{t}=N_{t}(\phi)</annotation></semantics></math>, with the property that</p>
<table id="Ch14.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch14.Ex2.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}N_{t}(\phi)\in\Omega" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}N_{t}(\phi)\in\Omega</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch14.S1.p2.3" class="ltx_p">Nullification captures the dynamics of natural forgetting, semantic decay, cognitive dormancy, and introspective release. It provides a pathway back towards epistemic neutrality that preserves continuity and potential for reactivation, unlike the discontinuity of annihilation. It allows agents to "rest" cognitively, shedding unused structure gracefully without catastrophic collapse.</p>
</div>
</section>
<section id="Ch14.S2" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14.2. </span>Philosophical and Cognitive Motivations</h4>

<div id="Ch14.S2.p1" class="ltx_para">
<p id="Ch14.S2.p1.1" class="ltx_p">The capacity to forget, or allow beliefs to fade, is not merely a limitation but a crucial functional aspect of robust cognition. Philosophically, forgetting prevents cognitive paralysis from information overload and allows focus to shift to relevant information. A mind that remembers everything perfectly may be less adaptive than one that prunes selectively. Constructivist views align with this, seeing memory not as static storage but as a dynamic structure maintained through active use; unused or unsupported beliefs naturally decay.</p>
</div>
<div id="Ch14.S2.p2" class="ltx_para">
<p id="Ch14.S2.p2.1" class="ltx_p">Cognitive psychology provides ample evidence supporting gradual belief decay. Decay theories posit that memory traces fade without rehearsal. Interference theories suggest that overlapping information can weaken specific beliefs. Attention plays a critical role; unattended or non-salient information is less likely to persist. Furthermore, neuroscience suggests active biological mechanisms are involved in forgetting, indicating it is a regulated, not purely passive, process.</p>
</div>
<div id="Ch14.S2.p3" class="ltx_para">
<p id="Ch14.S2.p3.1" class="ltx_p">Nullification aims to formalize these dynamics. Unlike the "hard reset" model common in many AI systems, which represents an abrupt external intervention, nullification models the internal, continuous drift towards semantic silence observed in natural cognition. This allows for graceful degradation, preserves a sense of identity continuity (as the agent doesn’t cease to exist, its beliefs merely fade), and allows for the possibility of reactivation, mirroring how forgotten memories can sometimes resurface. Nullification completes the cognitive cycle initiated by assimilation: structure emerges from silence, is maintained through use, and dissolves back into silence when inactive.</p>
</div>
</section>
<section id="Ch14.S3" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14.3. </span>Formal Definition of Nullification</h4>

<div id="Ch14.S3.p1" class="ltx_para">
<p id="Ch14.S3.p1.1" class="ltx_p">We formalize nullification as a time-dependent transformation <math id="Ch14.S3.p1.m1" class="ltx_Math" alttext="N_{t}:\Phi\rightarrow\Phi" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Φ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Φ</mi></mrow></mrow><annotation encoding="application/x-tex">N_{t}:\Phi\rightarrow\Phi</annotation></semantics></math> that models the gradual erosion of semantic structure within a belief state <math id="Ch14.S3.p1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>.</p>
</div>
<div id="Ch14.S3.p2" class="ltx_para">
<p id="Ch14.S3.p2.1" class="ltx_p"><span id="Ch14.S3.p2.1.1" class="ltx_text ltx_font_bold">Definition (Nullification Operator):</span> Let <math id="Ch14.S3.p2.m1" class="ltx_Math" alttext="\phi_{t}=N_{t}(\phi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{t}=N_{t}(\phi)</annotation></semantics></math> be the belief state resulting from applying nullification for duration <math id="Ch14.S3.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to state <math id="Ch14.S3.p2.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. <math id="Ch14.S3.p2.m4" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> must satisfy <math id="Ch14.S3.p2.m5" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}N_{t}(\phi)\in\Omega" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mi mathvariant="normal">Ω</mi></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}N_{t}(\phi)\in\Omega</annotation></semantics></math>.</p>
</div>
<div id="Ch14.S3.p3" class="ltx_para">
<p id="Ch14.S3.p3.1" class="ltx_p">A cognitively plausible <math id="Ch14.S3.p3.m1" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> should exhibit several properties:</p>
<ul id="Ch14.S3.I1" class="ltx_itemize">
<li id="Ch14.S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S3.I1.i1.p1" class="ltx_para">
<p id="Ch14.S3.I1.i1.p1.1" class="ltx_p"><span id="Ch14.S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Monotonic Weakening:</span> The "amount" or "density" of semantic content should generally decrease or stay the same over time. If <math id="Ch14.S3.I1.i1.p1.m1" class="ltx_Math" alttext="S(\phi)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(\phi)</annotation></semantics></math> measures semantic content, then <math id="Ch14.S3.I1.i1.p1.m2" class="ltx_Math" alttext="S(N_{t_{2}}(\phi))\leq S(N_{t_{1}}(\phi))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S(N_{t_{2}}(\phi))\leq S(N_{t_{1}}(\phi))</annotation></semantics></math> for <math id="Ch14.S3.I1.i1.p1.m3" class="ltx_Math" alttext="t_{2}&gt;t_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>&gt;</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t_{2}&gt;t_{1}</annotation></semantics></math>.</p>
</div></li>
<li id="Ch14.S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S3.I1.i2.p1" class="ltx_para">
<p id="Ch14.S3.I1.i2.p1.1" class="ltx_p"><span id="Ch14.S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Anchor Sensitivity:</span> Beliefs that are strongly anchored (due to recency, frequency of use, structural centrality, or explicit designation) should decay more slowly than unanchored or peripheral beliefs.</p>
</div></li>
<li id="Ch14.S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S3.I1.i3.p1" class="ltx_para">
<p id="Ch14.S3.I1.i3.p1.1" class="ltx_p"><span id="Ch14.S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Locality Preservation:</span> Nullification should preferentially affect weakly connected or isolated parts of the belief structure before disrupting core, highly integrated components. Coherent clusters tend to resist decay longer.</p>
</div></li>
<li id="Ch14.S3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S3.I1.i4.p1" class="ltx_para">
<p id="Ch14.S3.I1.i4.p1.1" class="ltx_p"><span id="Ch14.S3.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Continuity:</span> The transformation should be gradual over time, representing smooth decay rather than sudden disappearance (unlike Annihilation, <math id="Ch14.S3.I1.i4.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>).</p>
</div></li>
</ul>
<p id="Ch14.S3.p3.2" class="ltx_p">One way to implement this is elementwise. Let <math id="Ch14.S3.p3.m2" class="ltx_Math" alttext="\phi=\{\varphi_{1},\dots,\varphi_{n}\}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>φ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>φ</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\phi=\{\varphi_{1},\dots,\varphi_{n}\}</annotation></semantics></math>. Associate each expression <math id="Ch14.S3.p3.m3" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math> with a persistence function <math id="Ch14.S3.p3.m4" class="ltx_Math" alttext="d_{i}(t):\mathbb{R}^{+}\rightarrow[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mo>+</mo></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t):\mathbb{R}^{+}\rightarrow[0,1]</annotation></semantics></math>, where <math id="Ch14.S3.p3.m5" class="ltx_Math" alttext="d_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)</annotation></semantics></math> decreases monotonically towards 0 as <math id="Ch14.S3.p3.m6" class="ltx_Math" alttext="t\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">t\rightarrow\infty</annotation></semantics></math>. Define a persistence threshold <math id="Ch14.S3.p3.m7" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>. Then, the nullified state is:</p>
<table id="Ch14.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch14.Ex3.m1" class="ltx_Math" alttext="N_{t}(\phi)=\{\varphi_{i}\in\phi\mid d_{i}(t)&gt;\delta\}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo>∈</mo><mi>ϕ</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>δ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N_{t}(\phi)=\{\varphi_{i}\in\phi\mid d_{i}(t)&gt;\delta\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Ch14.S3.p3.3" class="ltx_p">The dynamics of <math id="Ch14.S3.p3.m8" class="ltx_Math" alttext="d_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)</annotation></semantics></math> determine the specific decay behavior. For example, <math id="Ch14.S3.p3.m9" class="ltx_Math" alttext="\frac{d}{dt}d_{i}(t)=-\lambda_{i}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}d_{i}(t)=-\lambda_{i}(t)</annotation></semantics></math>, where the decay rate <math id="Ch14.S3.p3.m10" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> depends on factors like anchoring strength <math id="Ch14.S3.p3.m11" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math>.</p>
</div>
<figure id="Ch14.F1" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch14.F1.pic1" class="ltx_picture ltx_centering" height="220.9" overflow="visible" version="1.1" viewBox="0 0 349.37 220.9" width="349.37"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="translate(0,220.9) matrix(1 0 0 -1 0 0) translate(45.64,0) translate(0,22.89)"><path style="fill:none" d="M 0 0 L 249.94 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 246.77 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 261.07 -4.25)"><foreignObject style="--ltx-fo-width:2.61em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="33.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch14.F1.pic1.1" class="ltx_text" style="font-size:90%;">Time <math id="Ch14.F1.pic1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></span></span></span></foreignObject></g><path style="fill:none" d="M 0 0 L 0 171.2"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 168.03)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -41.03 184.75)"><foreignObject style="--ltx-fo-width:6.41em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="82.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch14.F1.pic1.2" class="ltx_text" style="font-size:90%;">Belief strength</span></span></span></foreignObject></g><path style="fill:none" d="M 0 157.48 C 0 157.48 7.11 149.14 9.84 146.1 C 12.57 143.06 16.95 138.37 19.69 135.54 C 22.42 132.72 26.8 128.37 29.53 125.75 C 32.26 123.13 36.64 119.09 39.37 116.66 C 42.1 114.23 46.48 110.49 49.21 108.23 C 51.94 105.98 56.32 102.51 59.06 100.41 C 61.79 98.32 66.17 95.1 68.9 93.16 C 71.63 91.22 76.01 88.23 78.74 86.43 C 81.47 84.63 85.85 81.85 88.58 80.18 C 91.31 78.51 95.69 75.94 98.43 74.39 C 101.16 72.84 105.54 70.45 108.27 69.01 C 111 67.58 115.38 65.36 118.11 64.03 C 120.84 62.69 125.22 60.64 127.95 59.4 C 130.68 58.16 135.06 56.26 137.8 55.11 C 140.53 53.96 144.91 52.19 147.64 51.13 C 150.37 50.06 154.75 48.42 157.48 47.43 C 160.21 46.44 164.59 44.92 167.32 44 C 170.05 43.09 174.43 41.68 177.17 40.83 C 179.9 39.97 184.28 38.66 187.01 37.88 C 189.74 37.09 194.12 35.87 196.85 35.14 C 199.58 34.41 203.96 33.28 206.69 32.6 C 209.42 31.92 213.8 30.87 216.54 30.24 C 219.27 29.61 223.65 28.64 226.38 28.06 C 227.34 27.85 228.85 27.54 230.4 27.22"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.97975 -0.20023 0.20023 0.97975 227.27 27.86)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 55.12 0.83 L 55.12 106.3"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 55.12 0.55)"><path style="fill:none" d="M 0 4.29 L 0 -4.29"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0.83 106.3 L 55.12 106.3"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 0.55 106.3)"><path style="fill:none" d="M 0 4.29 L 0 -4.29"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.16 -13.85)"><foreignObject style="--ltx-fo-width:2.02em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.35em;font-size:9.25pt;" height="12.94" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="25.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch14.F1.pic1.m2" class="ltx_Math" alttext="T_{1/2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">T</mi><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2</mn></mrow></msub><annotation encoding="application/x-tex">T_{1/2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -21.07 103.49)"><foreignObject style="--ltx-fo-width:0.83em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.62" overflow="visible" transform="matrix(1 0 0 -1 0 5.62)" width="10.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch14.F1.pic1.m3" class="ltx_Math" alttext="\frac{1}{2}" display="inline" intent=":literal"><semantics><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{2}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="0.8pt,2.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0.83 39.37 L 244.09 39.37"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 0.55 39.37)"><path style="fill:none" d="M 0 4.29 L 0 -4.29"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 246.29 37.43)"><foreignObject style="--ltx-fo-width:0.89em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.12em;font-size:9.25pt;" height="6.85" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="11.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch14.F1.pic1.m4" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0 13.78 L 238.13 13.78"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 234.96 13.78)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 247.35 9.52)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="9.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch14.F1.pic1.m5" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 112.23 83.5)"><foreignObject style="--ltx-fo-width:2.15em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="27.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="Ch14.F1.pic1.m6" class="ltx_Math" alttext="\varphi_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">φ</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{i}(t)</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch14.F1.3" class="ltx_text" style="font-size:90%;">Figure 14.1</span>. </span><span id="Ch14.F1.4" class="ltx_text" style="font-size:90%;">Temporal decay of a belief fragment <math id="Ch14.F1.m6" class="ltx_Math" alttext="\varphi_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{i}(t)</annotation></semantics></math> under nullification <math id="Ch14.F1.m7" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math>. The semantic half-life <math id="Ch14.F1.m8" class="ltx_Math" alttext="T_{1/2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">T_{1/2}</annotation></semantics></math> determines when the belief decays to half strength. Anchoring level <math id="Ch14.F1.m9" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> provides resistance to full nullification. The state asymptotically approaches the epistemic vacuum <math id="Ch14.F1.m10" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>.</span></figcaption>
</figure>
</section>
<section id="Ch14.S4" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14.4. </span>Persistence, Anchoring, and Semantic Half-Life</h4>

<div id="Ch14.S4.p1" class="ltx_para">
<p id="Ch14.S4.p1.1" class="ltx_p">The rate at which beliefs fade under nullification depends on their stability, captured by persistence and anchoring.</p>
</div>
<div id="Ch14.S4.p2" class="ltx_para">
<p id="Ch14.S4.p2.1" class="ltx_p"><span id="Ch14.S4.p2.1.1" class="ltx_text ltx_font_bold">Definition (Persistence Function):</span> <math id="Ch14.S4.p2.m1" class="ltx_Math" alttext="d_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)</annotation></semantics></math> quantifies the remaining strength or activation of belief <math id="Ch14.S4.p2.m2" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math> after time <math id="Ch14.S4.p2.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> of nullification, with <math id="Ch14.S4.p2.m4" class="ltx_Math" alttext="d_{i}(0)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{i}(0)=1</annotation></semantics></math> (or initial strength) and <math id="Ch14.S4.p2.m5" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}d_{i}(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}d_{i}(t)=0</annotation></semantics></math>. Common forms include exponential decay (<math id="Ch14.S4.p2.m6" class="ltx_Math" alttext="d_{i}(t)=e^{-\lambda_{i}t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">d_{i}(t)=e^{-\lambda_{i}t}</annotation></semantics></math>) or linear decay (<math id="Ch14.S4.p2.m7" class="ltx_Math" alttext="d_{i}(t)=\max(0,1-\lambda_{i}t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)=\max(0,1-\lambda_{i}t)</annotation></semantics></math>).</p>
</div>
<div id="Ch14.S4.p3" class="ltx_para">
<p id="Ch14.S4.p3.1" class="ltx_p"><span id="Ch14.S4.p3.1.1" class="ltx_text ltx_font_bold">Definition (Anchoring):</span> The anchoring score <math id="Ch14.S4.p3.m1" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> of an expression <math id="Ch14.S4.p3.m2" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math> represents its resistance to nullification. Anchoring can depend on factors like:</p>
<ul id="Ch14.S4.I1" class="ltx_itemize">
<li id="Ch14.S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S4.I1.i1.p1" class="ltx_para">
<p id="Ch14.S4.I1.i1.p1.1" class="ltx_p">Frequency or recency of use/retrieval/assimilation.</p>
</div></li>
<li id="Ch14.S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S4.I1.i2.p1" class="ltx_para">
<p id="Ch14.S4.I1.i2.p1.1" class="ltx_p">Semantic centrality or structural connectedness within <math id="Ch14.S4.I1.i2.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>.</p>
</div></li>
<li id="Ch14.S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S4.I1.i3.p1" class="ltx_para">
<p id="Ch14.S4.I1.i3.p1.1" class="ltx_p">Explicit marking (e.g., as a goal, core belief, or policy component).</p>
</div></li>
<li id="Ch14.S4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S4.I1.i4.p1" class="ltx_para">
<p id="Ch14.S4.I1.i4.p1.1" class="ltx_p">Relevance to active tasks or semantic sectors <math id="Ch14.S4.I1.i4.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="Ch14.S4.p3.2" class="ltx_p">Anchoring modulates the decay rate: <math id="Ch14.S4.p3.m3" class="ltx_Math" alttext="\lambda_{i}=\lambda_{0}\cdot f(a_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>λ</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i}=\lambda_{0}\cdot f(a_{i})</annotation></semantics></math>, where <math id="Ch14.S4.p3.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is a decreasing function (e.g., <math id="Ch14.S4.p3.m5" class="ltx_Math" alttext="f(a_{i})=1/(1+a_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(a_{i})=1/(1+a_{i})</annotation></semantics></math> or <math id="Ch14.S4.p3.m6" class="ltx_Math" alttext="e^{-ca_{i}}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow></mrow></msup><annotation encoding="application/x-tex">e^{-ca_{i}}</annotation></semantics></math>). <span id="Ch14.S4.p3.2.1" class="ltx_text ltx_font_bold">Crucially, higher anchoring <math id="Ch14.S4.p3.m7" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> leads to a lower decay rate <math id="Ch14.S4.p3.m8" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math>.</span> Highly anchored beliefs decay slowly (<math id="Ch14.S4.p3.m9" class="ltx_Math" alttext="\lambda_{i}\approx 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i}\approx 0</annotation></semantics></math>), while weakly anchored ones fade quickly.</p>
</div>
<div id="Ch14.S4.p4" class="ltx_para">
<p id="Ch14.S4.p4.1" class="ltx_p"><span id="Ch14.S4.p4.1.1" class="ltx_text ltx_font_bold">Definition (Semantic Half-Life):</span> <math id="Ch14.S4.p4.m1" class="ltx_Math" alttext="T_{1/2}(\varphi_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{1/2}(\varphi_{i})</annotation></semantics></math> is the time required for the persistence <math id="Ch14.S4.p4.m2" class="ltx_Math" alttext="d_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)</annotation></semantics></math> to decay below a threshold <math id="Ch14.S4.p4.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>: <math id="Ch14.S4.p4.m4" class="ltx_Math" alttext="T_{1/2}(\varphi_{i})=\min\{t\mid d_{i}(t)\leq\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>t</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>δ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1/2}(\varphi_{i})=\min\{t\mid d_{i}(t)\leq\delta\}</annotation></semantics></math>. It provides a measure of the belief’s expected lifespan under neglect.</p>
</div>
<div id="Ch14.S4.p5" class="ltx_para">
<p id="Ch14.S4.p5.1" class="ltx_p">Decay rates <math id="Ch14.S4.p5.m1" class="ltx_Math" alttext="\lambda_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i}(t)</annotation></semantics></math> need not be constant; they can vary based on the evolving context within <math id="Ch14.S4.p5.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> or external attentional signals, allowing for adaptive nullification dynamics. Agents might even use persistence information for control, for instance, by refreshing beliefs whose <math id="Ch14.S4.p5.m3" class="ltx_Math" alttext="d_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}(t)</annotation></semantics></math> approaches <math id="Ch14.S4.p5.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</p>
</div>
</section>
<section id="Ch14.S5" class="ltx_section">
<h4 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14.5. </span>Nullification Trajectories</h4>

<div id="Ch14.S5.p1" class="ltx_para">
<p id="Ch14.S5.p1.1" class="ltx_p">Nullification defines a trajectory <math id="Ch14.S5.p1.m1" class="ltx_Math" alttext="\gamma_{\phi}(t)=N_{t}(\phi)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>N</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{\phi}(t)=N_{t}(\phi)</annotation></semantics></math> for each initial state <math id="Ch14.S5.p1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, tracing a path through the semantic state space <math id="Ch14.S5.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> towards the epistemic vacuum <math id="Ch14.S5.p1.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. These trajectories exhibit characteristic structural changes:</p>
<ul id="Ch14.S5.I1" class="ltx_itemize">
<li id="Ch14.S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S5.I1.i1.p1" class="ltx_para">
<p id="Ch14.S5.I1.i1.p1.1" class="ltx_p"><span id="Ch14.S5.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Detail Loss:</span> Peripheral, less anchored, or highly specific expressions (often at lower abstraction levels <math id="Ch14.S5.I1.i1.p1.m1" class="ltx_Math" alttext="\Phi^{(0)}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\Phi^{(0)}</annotation></semantics></math>) tend to decay first.</p>
</div></li>
<li id="Ch14.S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S5.I1.i2.p1" class="ltx_para">
<p id="Ch14.S5.I1.i2.p1.1" class="ltx_p"><span id="Ch14.S5.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Fragmentation:</span> As links (represented by shared context or structure) decay, coherent clusters of belief may break apart into disconnected fragments before disappearing entirely.</p>
</div></li>
<li id="Ch14.S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S5.I1.i3.p1" class="ltx_para">
<p id="Ch14.S5.I1.i3.p1.1" class="ltx_p"><span id="Ch14.S5.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Core Preservation:</span> Highly interconnected or strongly anchored core beliefs often persist longer, forming temporary stable structures even as the rest of <math id="Ch14.S5.I1.i3.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> dissolves. The trajectory might appear to collapse inwards towards these cores.</p>
</div></li>
<li id="Ch14.S5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch14.S5.I1.i4.p1" class="ltx_para">
<p id="Ch14.S5.I1.i4.p1.1" class="ltx_p"><span id="Ch14.S5.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Asymptotic Approach to <math id="Ch14.S5.I1.i4.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>:</span> Eventually, all expressions fall below the persistence threshold <math id="Ch14.S5.I1.i4.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>, and the state <math id="Ch14.S5.I1.i4.p1.m3" class="ltx_Math" alttext="\gamma_{\phi}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{\phi}(t)</annotation></semantics></math> enters the equivalence class <math id="Ch14.S5.I1.i4.p1.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<figure id="Ch14.F2" class="ltx_figure"><span class="ltx_inline-block"><svg id="Ch14.F2.pic1" class="ltx_picture ltx_centering" height="177.72" overflow="visible" version="1.1" viewBox="0 0 377.91 177.72" width="377.91"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,177.72) matrix(1 0 0 -1 0 0) translate(113.28,0) translate(0,18.29)"><g stroke-width="0.8pt"><path style="fill:none" d="M 0 0 L 215.43 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 215.98 0)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 221.7 -13.68)"><foreignObject style="--ltx-fo-width:2.61em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="33.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch14.F2.pic1.1" class="ltx_text" style="font-size:90%;">Time <math id="Ch14.F2.pic1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 0 L 0 137.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 1.0 -1.0 0.0 0 138.03)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -108.66 146.17)"><foreignObject style="--ltx-fo-width:8.11em;--ltx-fo-heig