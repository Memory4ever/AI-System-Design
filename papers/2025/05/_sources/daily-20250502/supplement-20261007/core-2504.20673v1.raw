</span>
<span id="lstnumberx5" class="ltx_listingline"><span id="lstnumberx5.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">    </span><span id="lstnumberx5.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#000000;">return</span><span id="lstnumberx5.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">result_sum</span>
</span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A4.SS1.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS1.p4.pic1" class="ltx_picture" height="77.99" overflow="visible" version="1.1" viewBox="0 0 653.15 77.99" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,77.99) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4682B4;" fill="#4682B4" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 77.99 L 653.15 77.99 L 653.15 0 Z"></path></g><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 1.97 L 1.97 37.89 L 651.18 37.89 L 651.18 1.97 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 62.48)"><foreignObject style="--ltx-fo-width:38.32em;--ltx-fo-height:0.69em;--ltx-fo-depth:1.35em;font-size:10pt;" height="28.29" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="530.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
