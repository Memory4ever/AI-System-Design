<td id="S3.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" rowspan="2"><span id="S3.T2.2.1.4.1" class="ltx_text">CM</span></td>
<td id="S3.T2.2.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" rowspan="2"><span id="S3.T2.2.1.5.1" class="ltx_text">CR</span></td>
