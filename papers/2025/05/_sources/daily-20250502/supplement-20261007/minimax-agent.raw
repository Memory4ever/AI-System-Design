or: inherit !important;\n  border: none !important;\n}\n\n.code-image-placeholder {\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  padding: 16px;\n  background: #F8FAFC;\n  color: #475569;\n  font-size: 14px;\n  line-height: 22px;\n  margin: 16px 0 24px;\n}\n\n.dark .code-image-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.code-screenshot {\n  display: block;\n  width: 100%;\n  margin: 16px 0 24px;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-screenshot {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.code-community-panel {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 180px;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  padding: 20px;\n  margin: 16px 0 8px;\n  background: #FFFFFF;\n}\n\n.code-community-panel p {\n  margin-bottom: 0;\n}\n\n.code-qr-placeholder {\n  display: flex;\n  min-height: 180px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  background: #F8FAFC;\n  color: #334155;\n  text-align: center;\n}\n\n.code-qr-placeholder small {\n  max-width: 140px;\n  color: #64748B;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.code-community-qr {\n  display: block;\n  width: 180px;\n  max-width: 100%;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-community-panel {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.dark .code-qr-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.dark .code-qr-placeholder small {\n  color: #94A3B8;\n}\n\n@media (max-width: 640px) {\n  .code-community-panel {\n    grid-template-columns: 1fr;\n  }\n\n  .code-qr-placeholder {\n    min-height: 220px;\n  }\n}\n\nbody:has(.question-standalone-marker) header,\nbody:has(.question-standalone-marker) #navbar,\nbody:has(.questi