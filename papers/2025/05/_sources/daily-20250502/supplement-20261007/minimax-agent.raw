Date = new Date('2024-01-01').getTime();\n  const today = new Date().getTime();\n  const daysSinceStart = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));\n  const dateNum = parseInt(new Date().toISOString().slice(0, 10).replace(/-/g, ''), 10);\n  const dailyIncrement = 50 + (dateNum % 40);\n  const ratingCount = baseCount + Math.floor(daysSinceStart * (dailyIncrement - 20));\n\n  const schema = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      {\n        '@type': 'SoftwareApplication',\n        '@id': PRODUCT_URL + '/#softwareapplication',\n        name: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        operatingSystem: 'Web, Windows, Mac, iOS, Android',\n        applicationCategory: 'ProductivityApplication',\n        aggregateRating: {\n          '@type': 'AggregateRating',\n          ratingValue: 4.9,\n          bestRating: 5,\n          ratingCount: ratingCount,\n        },\n        offers: {\n          '@type': 'Offer',\n          price: '0',\n          priceCurrency: 'USD',\n        },\n        logo: {\n          '@type': 'ImageObject',\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n          inLanguage: LANGUAGE,\n          url: LOGO_URL,\n          contentUrl: LOGO_URL,\n          caption: PRODUCT_NAME,\n        },\n        mainEntityOfPage: {\n          '@type': 'WebPage',\n          '@id': PRODUCT_URL + '/#webpage',\n        },\n        creator: {\n          '@type': 'Organization',\n          name: 'MiniMax',\n          url: MINIMAX_URL,\n        },\n        features: [\n          'Full-Stack Web App Development',\n          'PPT \u0026 Presentation Generation',\n          'Deep Research \u0026 Analysis',\n          'Browser Automation',\n          'Code Generation',\n          'MCP Ecosystem Integration',\n          'Multimodal Content Creation',\n        ],\n      },\n      {\n        '@type': 'WebSite',\n        '@id': PRODUCT_URL + '/#website',\n        url: PRODUCT_URL,\n        name: PRODUCT_NAME,\n        description: DESCRIPTION,\n        publisher: { '@id': PRODUCT_URL + '/#organization' },\n        inLanguage: LANGUAGE,\n        copyrightHolder: { '@id': PRODUCT_URL + '/#organization' },\n      },\n      {\n        '@type': 'WebPage',\n        '@id': PRODUCT_URL + '/#webpage',\n        url: window.location.href,\n        name: document.title,\n        about: { '@id': PRODUCT_URL + '/#organization' },\n        isPartOf: { '@id': PRODUCT_URL + '/#website' },\n        primaryImageOfPage: { '@id': PRODUCT_URL + '/#primaryimage' },\n        image: { '@id': PRODUCT_URL + '/#primaryimage' },\n        thumbnailUrl: LOGO_URL,\n        datePublished: new Date().toISOString(),\n        dateModified: new Date().toISOString(),\n        description: DESCRIPTION,\n        inLanguage: LANGUAGE,\n      },\n      {\n        '@type': 'ImageObject',\n        inLanguage: LANGUAGE,\n        '@id': PRODUCT_URL + '/#primaryimage',\n        url: LOGO_URL,\n        contentUrl: LOGO_URL,\n        width: 80,\n        height: 80,\n      },\n      {\n        '@type': 'BreadcrumbList',\n        '@id': PRODUCT_URL + '/#breadcrumb',\n        itemListElement: [\n          {\n            '@type': 'ListItem',\n            position: 1,\n            name: 'MiniMax Agent',\n            item: PRODUCT_URL,\n          },\n          {\n            '@type': 'ListItem',\n            position: 2,\n            name: document.title,\n            item: window.location.href,\n          },\n        ],\n      },\n      {\n        '@type': ['Organization', 'Brand'],\n        '@id': PRODUCT_URL + '/#organization',\n        name: PRODUCT_NAME,\n        legalName: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        description: DESCRIPTION,\n        logo: {\n          '@type': 'ImageObject',\n          inLanguage: LANGUAGE,\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n        },\n        parentOrganization: {\n          '@type': ['Organization', 'Brand'],\n          name: 'MiniMax',\n          legalName: 'MiniMax',\n 