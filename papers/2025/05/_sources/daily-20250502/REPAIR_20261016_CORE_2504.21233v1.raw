<td id="S2.T1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">71.8</td>
<td id="S2.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">36.9</td></tr>
<tr id="S2.T1.3.1.3" class="ltx_tr">
<td id="S2.T1.3.1.3.1" class="ltx_td ltx_align_left">Phi-4-Mini + LIMO</td>
<td id="S2.T1.3.1.3.2" class="ltx_td ltx_align_center">6.7</td>
<td id="S2.T1.3.1.3.3" class="ltx_td ltx_align_center">57.8</td>
<td id="S2.T1.3.1.3.4" class="ltx_td ltx_align_center">24.8</td></tr>
<tr id="S2.T1.3.1.4" class="ltx_tr">
<td id="S2.T1.3.1.4.1" class="ltx_td ltx_align_left">Phi-4-Mini + S1K</td>
