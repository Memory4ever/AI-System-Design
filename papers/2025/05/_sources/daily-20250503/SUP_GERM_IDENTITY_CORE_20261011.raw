/mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>W</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mi>h</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>h</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mtext> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>l</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.222em" stretchy="false">]</mo></mrow><mo rspace="0.222em">\</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\penalty\ W_{Kl}^{h\top}W_{Ql}^{h}+{\rm LRA}_{r}(W_{2,l-1}^{-1\top}\overline{W}_{2,l-1}^{\top}\overline{W}_{Kl}^{h\top}\overline{W}_{Ql}^{h}\overline{W}_{2,l-1}W_{2,l-1}^{-1}-W_{Kl}^{h\top}W_{Ql}^{h}),\text{ for all }h\in[H],l\in[L]\backslash\{1\},</annotation></semantics></math></td>
