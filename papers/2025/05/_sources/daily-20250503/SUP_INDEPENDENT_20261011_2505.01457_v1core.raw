<h1 class="ltx_title ltx_title_document" style="font-size:90%;">A Multi-Granularity Multimodal Retrieval Framework for Multimodal Document Tasks</h1>
<div class="ltx_authors">
<span class="ltx_creator ltx_role_author">
<span class="ltx_personname"><span id="id2" class="ltx_text" style="font-size:90%;">Mingjun Xu</span><sup id="id3" class="ltx_sup"><span id="id3.1" class="ltx_text" style="font-size:90%;">1</span></sup>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname"><span id="id4" class="ltx_text" style="font-size:90%;">Zehui Wang</span><sup id="id5" class="ltx_sup"><span id="id5.1" class="ltx_text" style="font-size:90%;">1</span></sup>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname"><span id="id6" class="ltx_text" style="font-size:90%;">Hengxing Cai</span><sup id="id7" class="ltx_sup"><span id="id7.1" class="ltx_text" style="font-size:90%;">1,2</span></sup>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname"><span id="id8" class="ltx_text" style="font-size:90%;">Renxin Zhong</span><sup id="id9" class="ltx_sup"><span id="id9.1" class="ltx_text" style="font-size:90%;">2</span></sup>
</span></span></div>
<div class="ltx_dates"><span id="id10" class="ltx_text" style="font-size:90%;">
</span><sup id="id11" class="ltx_sup"><span id="id11.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></sup><span id="id12" class="ltx_text" style="font-size:90%;">
DP Technology </span>
<br class="ltx_break"><sup id="id13" class="ltx_sup"><span id="id13.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2</span></sup><span id="id14" class="ltx_text" style="font-size:90%;">
