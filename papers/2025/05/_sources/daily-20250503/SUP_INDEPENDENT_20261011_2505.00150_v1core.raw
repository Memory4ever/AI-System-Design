<tr id="S5.T2.6.2" class="ltx_tr">
<th id="S5.T2.6.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S5.T2.6.2.1.1" class="ltx_text">Q1</span></th>
<th id="S5.T2.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">NH</th>
<td id="S5.T2.6.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m1" class="ltx_Math" alttext="\mathbf{295_{60.2\%}}" display="inline" intent=":literal"><semantics><msub><mn>𝟐𝟗𝟓</mn><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">60.2</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">\mathbf{295_{60.2\%}}</annotation></semantics></math></td>
<td id="S5.T2.6.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m2" class="ltx_Math" alttext="\mathbf{558_{88.4\%}}" display="inline" intent=":literal"><semantics><msub><mn>𝟓𝟓𝟖</mn><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">88.4</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">\mathbf{558_{88.4\%}}</annotation></semantics></math></td></tr>
<tr id="S5.T2.6.3" class="ltx_tr">
<th id="S5.T2.6.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">H</th>
<td id="S5.T2.6.3.2" class="ltx_td ltx_align_center"><math id="S5.T2.m3" class="ltx_Math" alttext="195_{39.8\%}" display="inline" intent=":literal"><semantics><msub><mn>195</mn><mrow><mn>39.8</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">195_{39.8\%}</annotation></semantics></math></td>
<td id="S5.T2.6.3.3" class="ltx_td ltx_align_center"><math id="S5.T2.m4" class="ltx_Math" alttext="73_{11.6\%}" display="inline" intent=":literal"><semantics><msub><mn>73</mn><mrow><mn>11.6</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">73_{11.6\%}</annotation></semantics></math></td></tr>
<tr id="S5.T2.6.4" class="ltx_tr">
<th id="S5.T2.6.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S5.T2.6.4.1.1" class="ltx_text">Q2</span></th>
<th id="S5.T2.6.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">NC</th>
<td id="S5.T2.6.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m5" class="ltx_Math" alttext="89_{18.2\%}" display="inline" intent=":literal"><semantics><msub><mn>89</mn><mrow><mn>18.2</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">89_{18.2\%}</annotation></semantics></math></td>
<td id="S5.T2.6.4.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m6" class="ltx_Math" alttext="98_{15.5\%}" display="inline" intent=":literal"><semantics><msub><mn>98</mn><mrow><mn>15.5</mn><mo>%</mo></mrow></msub><annotation encoding="application/x-tex">98_{15.5\%}</annotation></semantics></math></td></tr>
