s="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.61)"><g style="--ltx-fill-color:#808080;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#808080" transform="matrix(1 0 0 -1 0 0) translate(2.35,0)"><path d="M -2.08 -2.77 h 4.15 v 11.07 h -4.15 Z M 6.23 -2.77 h 4.15 v 8.3 h -4.15 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 13.01 0) translate(17.66,0) matrix(1.0 0.0 0.0 1.0 -14.89 -3.69)"><foreignObject style="--ltx-fo-width:2.15em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="29.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F10.sf12.pic1.6" class="ltx_text">CPU</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" transform="matrix(1 0 0 -1 48.33 0) translate(2.35,0)"><path style="fill:none" d="M -2.08 -2.77 h 4.15 v 11.07 h -4.15 Z M 6.23 -2.77 h 4.15 v 8.3 h -4.15 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 61.34 0) translate(26.35,0) matrix(1.0 0.0 0.0 1.0 -23.58 -3.77)"><foreignObject style="--ltx-fo-width:3.41em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="47.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F10.sf12.pic1.7" class="ltx_text">Elapsed</span></span></span></foreignObject></g></g></g></g></g></g></g></g></svg></span>
</span></div>
