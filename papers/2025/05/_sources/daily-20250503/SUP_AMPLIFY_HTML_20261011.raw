<td id="S5.T1.2.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">
<span id="S5.T1.2.2.2.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T1.2.2.2.1.1" class="ltx_p">Healthcare Professionals (Physicians, Nurses, Pediatricians, Midwives), Public Health Experts</span>
</span></td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<th id="S5.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Education</th>
<td id="S5.T1.2.3.2" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="S5.T1.2.3.2.1" class="ltx_inline-block ltx_align_top">
