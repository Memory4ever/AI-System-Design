<th id="A2.T7.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Health</th>
<td id="A2.T7.2.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">
