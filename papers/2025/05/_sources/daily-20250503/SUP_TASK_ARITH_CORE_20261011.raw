<th id="S2.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_l ltx_border_r ltx_border_t" colspan="2">BM25</th>
<th id="S2.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.091</th>
<th id="S2.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.637</th>
<th id="S2.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.691</th>
<th id="S2.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">.649</th>
<th id="S2.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.247</th>
<th id="S2.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.404</th>
<th id="S2.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">.343</th>
<th id="S2.T1.2.1.3.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">.154</th>
