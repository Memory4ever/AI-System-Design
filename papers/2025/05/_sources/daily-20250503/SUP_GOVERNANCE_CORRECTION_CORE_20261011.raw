<td id="S3.T3.4.5.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.5.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">282</span></td>
<td id="S3.T3.4.5.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.5.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">971</span></td>
