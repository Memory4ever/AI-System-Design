<td id="S3.T3.4.3.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.3.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">9</span></td>
<td id="S3.T3.4.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.3.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">880</span></td>
<td id="S3.T3.4.3.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.3.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1,239</span></td>
<td id="S3.T3.4.3.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.3.6.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">26%</span></td></tr>
<tr id="S3.T3.4.4" class="ltx_tr">
