<td id="S3.T3.4.5.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S3.T3.4.5.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">28</span></td>
