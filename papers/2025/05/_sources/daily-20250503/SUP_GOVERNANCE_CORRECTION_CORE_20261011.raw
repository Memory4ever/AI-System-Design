<td id="S3.T3.4.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.4.2.4.1" class="ltx_text ltx_font_italic">Academic AI</span></td>
<td id="S3.T3.4.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.4.2.5.1" class="ltx_text ltx_font_italic">Corporate AI</span></td>
<td id="S3.T3.4.2.6" class="ltx_td"></td></tr>
