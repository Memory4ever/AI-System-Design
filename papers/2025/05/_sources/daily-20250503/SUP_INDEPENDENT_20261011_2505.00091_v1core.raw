</span></td>
<td id="S4.T1.4.3.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.4.3.4.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S4.T1.4.3.4.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.4.3.4.1.1.1" class="ltx_text" style="font-size:80%;">2.1</span></span>
</span></td>
<td id="S4.T1.4.3.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.4.3.5.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S4.T1.4.3.5.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.4.3.5.1.1.1" class="ltx_text" style="font-size:80%;">85%</span></span>
</span></td></tr>
<tr id="S4.T1.4.4" class="ltx_tr">
<td id="S4.T1.4.4.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.4.4.1.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S4.T1.4.4.1.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.4.4.1.1.1.1" class="ltx_text" style="font-size:80%;">GPT-4o</span></span>
