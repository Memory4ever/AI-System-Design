<span id="S4.T3.4.4.7.1.1" class="ltx_p ltx_align_center"><span id="S4.T3.4.4.7.1.1.1" class="ltx_text ltx_font_bold">99.73%</span></span>
</span></td>
<td id="S4.T3.4.4.8" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.15pt;padding-bottom:1.15pt;">
