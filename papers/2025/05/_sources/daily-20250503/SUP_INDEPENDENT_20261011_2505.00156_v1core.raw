<span id="S3.T1.5.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span title="Large Vision Language Model" class="ltx_glossaryref" style="font-size:80%;">LVLM</span><span id="S3.T1.5.1.2.2.1.1.1.1" class="ltx_text" style="font-size:80%;"> Head Weight</span></span></span>
<span id="S3.T1.5.1.2.2.1.2" class="ltx_tr">
<span id="S3.T1.5.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S3.T1.m2" class="ltx_Math" alttext="p^{head}_{\text{LVLM}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">p</mi><mtext mathsize="0.800em">LVLM</mtext><mrow><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow></msubsup><annotation encoding="application/x-tex">p^{head}_{\text{LVLM}}</annotation></semantics></math></span></span>
