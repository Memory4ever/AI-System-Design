<td id="S4.T8.5.3.2" class="ltx_td ltx_align_right">0.39</td>
<td id="S4.T8.5.3.3" class="ltx_td ltx_align_right">0.35</td>
<td id="S4.T8.5.3.4" class="ltx_td ltx_align_right">0.44</td></tr>
<tr id="S4.T8.5.4" class="ltx_tr">
<td id="S4.T8.5.4.1" class="ltx_td ltx_align_left ltx_border_bb"><span title="Qwen2-VL-2B-Instruct+Qwen2.5-1.5B-Instruct" class="ltx_glossaryref">V3LMA-Q-mini</span></td>
<td id="S4.T8.5.4.2" class="ltx_td ltx_align_right ltx_border_bb">0.26</td>
<td id="S4.T8.5.4.3" class="ltx_td ltx_align_right ltx_border_bb">0.25</td>
