<td id="S4.T8.5.2.2" class="ltx_td ltx_align_right ltx_border_t">0.38</td>
<td id="S4.T8.5.2.3" class="ltx_td ltx_align_right ltx_border_t">0.33</td>
<td id="S4.T8.5.2.4" class="ltx_td ltx_align_right ltx_border_t">0.44</td></tr>
