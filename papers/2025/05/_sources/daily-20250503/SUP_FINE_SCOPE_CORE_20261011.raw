<td id="S4.T4.8.13.2" class="ltx_td ltx_align_center"><span id="S4.T4.8.13.2.1" class="ltx_text ltx_markedasmath ltx_font_bold" style="font-size:90%;--ltx-bg-color:#DEDEFF;">31.17</span></td>
