<td id="A3.T5.3.1.3.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><a href="https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct</a></td></tr>
