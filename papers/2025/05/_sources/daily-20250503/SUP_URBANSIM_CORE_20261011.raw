<tr id="A5.T6.6.7" class="ltx_tr">
<td id="A5.T6.6.7.1" class="ltx_td ltx_align_left">Train batch size</td>
<td id="A5.T6.6.7.2" class="ltx_td ltx_align_left"><math id="A5.T6.m5" class="ltx_Math" alttext="1024\times 24(n_{env}\times n_{step})" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1024</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>24</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1024\times 24(n_{env}\times n_{step})</annotation></semantics></math></td></tr>
