<td id="A5.T4.6.1.17.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T4.m14" class="ltx_Math" alttext="\frac{1}{T_{F}-T_{S}}\sum_{t=1}^{T_{F}-T_{S}}\sum_{i}\frac{max(torque_{i}\cdot v_{i},0)}{m\cdot g\cdot v_{body}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><msub><mi>T</mi><mi>F</mi></msub><mo>−</mo><msub><mi>T</mi><mi>S</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>T</mi><mi>F</mi></msub><mo>−</mo><msub><mi>T</mi><mi>S</mi></msub></mrow></msubsup><mrow><msub><mo>∑</mo><mi>i</mi></msub><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>g</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>v</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{T_{F}-T_{S}}\sum_{t=1}^{T_{F}-T_{S}}\sum_{i}\frac{max(torque_{i}\cdot v_{i},0)}{m\cdot g\cdot v_{body}}</annotation></semantics></math></td></tr>
