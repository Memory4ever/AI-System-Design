<tr id="A5.T6.6.6" class="ltx_tr">
<td id="A5.T6.6.6.1" class="ltx_td ltx_align_left">Clip parameter <math id="A5.T6.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></td>
