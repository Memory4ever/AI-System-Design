<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.4" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="S4.F4.5" class="ltx_text" style="font-size:90%;">Qualitative comparison with state-of-the-art methods on weather removal.</span></figcaption>
</figure>
<figure id="S4.F5" class="ltx_figure">
<div id="S4.F5.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:496.9pt;height:116.8pt;vertical-align:-57.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-201.4pt,47.3pt) scale(0.55221765989986,0.55221765989986) ;">
<table id="S4.F5.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.F5.3.1.1" class="ltx_tr">
<td id="S4.F5.3.1.1.1" class="ltx_td ltx_nopad_r" style="padding-bottom: 1.99997pt;padding-left:1.0pt;padding-right:1.0pt;"></td>
<td id="S4.F5.3.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: 1.99997pt;padding-left:1.0pt;padding-right:1.0pt;">Input</td>
<td id="S4.F5.3.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: 1.99997pt;padding-left:1.0pt;padding-right:1.0pt;">AnyV2V <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite></td>
