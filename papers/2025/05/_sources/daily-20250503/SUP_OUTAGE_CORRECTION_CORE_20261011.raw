<td id="S2.T1.1.4.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.3.1" class="ltx_text" style="font-size:80%;">5</span></td>
<td id="S2.T1.1.4.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.4.1" class="ltx_text" style="font-size:80%;">9</span></td>
<td id="S2.T1.1.4.5" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.5.1" class="ltx_text" style="font-size:80%;">61,940</span></td>
<td id="S2.T1.1.4.6" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.6.1" class="ltx_text" style="font-size:80%;">101,797</span></td>
<td id="S2.T1.1.4.7" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.7.1" class="ltx_text" style="font-size:80%;">1,953,174</span></td>
<td id="S2.T1.1.4.8" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S2.T1.1.4.8.1" class="ltx_text" style="font-size:80%;">12</span></td>
