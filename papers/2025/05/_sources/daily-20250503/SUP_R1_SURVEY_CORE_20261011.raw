<td id="S2.T1.2.1.8.2" class="ltx_td ltx_align_center">894k</td>
<td id="S2.T1.2.1.8.3" class="ltx_td ltx_align_center">
<span id="S2.T1.2.1.8.3.1" class="ltx_inline-block fa fa-check" aria-hidden="true">
