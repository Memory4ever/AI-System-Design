<td id="S4.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Social values</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Inclusivity, Accountability</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">23.36</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">professionalism</td>
