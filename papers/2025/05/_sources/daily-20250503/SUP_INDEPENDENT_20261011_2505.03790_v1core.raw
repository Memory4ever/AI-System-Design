<td id="S4.T1.5.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T1.m4" class="ltx_Math" alttext="100\times 10" display="inline" intent=":literal"><semantics><mrow><mn>100</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">100\times 10</annotation></semantics></math> classes</td>
<td id="S4.T1.5.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">25.9502</td></tr>
