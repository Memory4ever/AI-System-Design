<td id="S4.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">77.2</td>
<td id="S4.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">-</td></tr>
