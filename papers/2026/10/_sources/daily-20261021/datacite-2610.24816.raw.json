{"data":{"id":"10.48550/arxiv.2610.24816","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.24816","prefix":"10.48550","suffix":"arxiv.2610.24816","identifiers":[{"identifier":"2610.24816","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.24816"}],"creators":[{"name":"Zheng, Xu","nameType":"Personal","givenName":"Xu","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Wei","nameType":"Personal","givenName":"Wei","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Zhuomin","nameType":"Personal","givenName":"Zhuomin","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Dongkuan","nameType":"Personal","givenName":"Dongkuan","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Sha, Mo","nameType":"Personal","givenName":"Mo","familyName":"Sha","affiliation":[],"nameIdentifiers":[]},{"name":"Ni, Jingchao","nameType":"Personal","givenName":"Jingchao","familyName":"Ni","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Dongsheng","nameType":"Personal","givenName":"Dongsheng","familyName":"Luo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"First-Order LoRA Training with Phone NPUs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-17T18:49:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-20T00:56:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"On-device fine-tuning lets a large language model (LLM) learn from its user's private data without uploading it. Low-rank adaptation (LoRA) reduces the trainable parameters, but each first-order training step still multiplies by the frozen base-model weights during the forward pass, activation recomputation, and input-gradient computation. A phone's neural processing unit (NPU) already holds these weights for inference; using it for training also requires computing input gradients, which its inference interface does not support. We present a system that runs all three frozen-weight products on the NPU while keeping the training graph, adapters, and optimizer on the CPU. Its input-gradient kernels reuse the resident weight tiles and the forward dequantizer, avoiding a transposed weight copy and ensuring forward and backward use the same effective weights. To preserve usable gradients, the system selects precision by gradient sensitivity and applies a per-row range guard for half-precision (FP16) outputs. Its runtime fuses the remaining CPU operators and overlaps NPU execution with adapter computation, while resumable execution and thermal pacing let training proceed as a background job. We evaluate it on two Qualcomm Snapdragon platforms using four LLMs from the Qwen and Llama families. Our workloads cover nightly personalization with labels supplied on the phone and the public LaMP-2 benchmark; comparisons include an optimized CPU trainer, a phone-GPU trainer, forward-only training, and GPU-trained references.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.24816","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-20T04:23:06.000Z","registered":"2026-10-20T04:23:06.000Z","published":"2026","updated":"2026-10-20T04:23:07.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.24816","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}