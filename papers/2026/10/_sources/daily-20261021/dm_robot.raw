                    </picture>
                    <div class="glue-card__content">
                      <div class="glue-card__tags glue-spacer-2-top">
                        
                            
                            
                            <span class="glue-label">Mobile</span>
                            
                            <span class="glue-label">AI</span>
                            
                            
