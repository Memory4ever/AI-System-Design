tribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="style.css">[class*="ask-ai"],
[id*="ask-ai"],
[class*="AskAI"],
button[aria-label*="Ask AI"] {
  display: none !important;
}

article h2 {
  display: inline-block;
  padding: 2px 14px;
  border-radius: 16px;
  background-color: #EBF5FF;
  color: #0969DA;
  font-size: 14px;
  font-weight: 500;
  border: 1px solid #B6D4FE;
  margin-top: 2rem;
}

/* techblog 索引页:日期 H2 不要 chip 样式,改为分组分隔的小标题 */
article .techblog-list h2,
.techblog-list h2 {
  display: block !important;
  background-color: transparent !important;
  border: none !important;
  border-top: 1px solid #E5E7EB !important;
  border-radius: 0 !important;
  padding: 2rem 0 0 0 !important;
  color: #374151 !important;
  font-size: 16px !important;
  font-weight: 500 !important;
  margin-top: 2.5rem !important;
  margin-bottom: 0.5rem !important;
}

/* 第一个日期保留顶部线,作为引导语和文章列表的分隔 */
.techblog-list h2:first-of-type {
  margin-top: 2.5rem !important;
}

.dark .techblog-list h2 {
  color: #E5E7EB !important;
  border-top-color: #374151 !important;
}

/* 减少 TOC 点击时的"抽搐":让滚动停在留白位置而不是顶到边 */
.techblog-list h2,
.techblog-list h3 {
  scroll-margin-top: 80px;
}

#footer a[href*="mintlify"],
[class*="attribution"],
footer a[href*="mintlify"] {
  display: none !important;
}

img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

@media (min-width: 1024px) {
  #sidebar {
    top: max(
      calc(var(--mintlify-slot-header-height, 7rem) + var(--banner-height, 0px)),
      5rem
    ) !important;
  }
}

@media (max-width: 1023px) {
  #sidebar > div:first-child,
  #sidebar-content > div:first-child {
    padding-top: 16px !important;
  }
}

.code-docs h2,
.code-docs h3 {
  display: block !important;
  padding: 0 !important;
  border-radius: 0 !important;
  background-color: transparent !important;
  color: inherit !important;
  border: none !important;
}

.code-image-placeholder {
  border: 1px dashed #CBD5E1;
  border-radius: 8px;
  padding: 16px;
  background: #F8FAFC;
  color: #475569;
  font-size: 14px;
  line-height: 22px;
  margin: 16px 0 24px;
}

.dark .code-image-placeholder {
  border-color: #475569;
  background: #111827;
  color: #CBD5E1;
}

.code-screenshot {
  display: block;
  width: 100%;
  margin: 16px 0 24px;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  background: #FFFFFF;
}

.dark .code-screenshot {
  border-color: #334155;
  background: #0F172A;
}

.code-community-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180px;
  gap: 24px;
  align-items: center;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 20px;
  margin: 16px 0 8px;
  background: #FFFFFF;
}

.code-community-panel p {
  margin-bottom: 0;
}

.code-qr-placeholder {
  display: flex;
  min-height: 180px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px dashed #CBD5E1;
  border-radius: 8px;
  background: #F8FAFC;
  color: #334155;
  text-align: center;
}

.code-qr-placeholder small {
  max-width: 140px;
  color: #64748B;
  font-size: 12px;
  line-height: 18px;
}

.code-community-qr {
  display: block;
  width: 180px;
  max-width: 100%;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  background: #FFFFFF;
}

.dark .code-community-panel {
  border-color: #334155;
  background: #0F172A;
}

.dark .code-qr-placeholder {
  border-color: #475569;
  background: #111827;
  color: #CBD5E1;
}

.dark .code-qr-placeholder small {
  color: #94A3B8;
}

@media (max-width: 640px) {
  .code-community-panel {
    grid-template-columns: 1fr;
  }

  .code-qr-placeholder {
    min-height: 220px;
  }
}

body:has(.question-standalone-marker) header,
body:has(.question-standalone-marker) #navbar,
body:has(.question-standalone-marker) #sidebar,
body:has(.question-standalone-marker) #sidebar-content,
