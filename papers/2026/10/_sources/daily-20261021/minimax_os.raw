 h2 {\n  display: block !important;\n  background-color: transparent !important;\n  border: none !important;\n  border-top: 1px solid #E5E7EB !important;\n  border-radius: 0 !important;\n  padding: 2rem 0 0 0 !important;\n  color: #374151 !important;\n  font-size: 16px !important;\n  font-weight: 500 !important;\n  margin-top: 2.5rem !important;\n  margin-bottom: 0.5rem !important;\n}\n\n/* 第一个日期保留顶部线,作为引导语和文章列表的分隔 */\n.techblog-list h2:first-of-type {\n  margin-top: 2.5rem !important;\n}\n\n.dark .techblog-list h2 {\n  color: #E5E7EB !important;\n  border-top-color: #374151 !important;\n}\n\n/* 减少 TOC 点击时的\"抽搐\":让滚动停在留白位置而不是顶到边 */\n.techblog-list h2,\n.techblog-list h3 {\n  scroll-margin-top: 80px;\n}\n\n#footer a[href*=\"mintlify\"],\n[class*=\"attribution\"],\nfooter a[href*=\"mintlify\"] {\n  display: none !important;\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n  object-fit: contain;\n}\n\n@media (min-width: 1024px) {\n  #sidebar {\n    top: max(\n      calc(var(--mintlify-slot-header-height, 7rem) + var(--banner-height, 0px)),\n      5rem\n    ) !important;\n  }\n}\n\n@media (max-width: 1023px) {\n  #sidebar \u003e div:first-child,\n  #sidebar-content \u003e div:first-child {\n    padding-top: 16px !important;\n  }\n}\n\n.code-docs h2,\n.code-docs h3 {\n  display: block !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n  color: inherit !important;\n  border: none !important;\n}\n\n.code-image-placeholder {\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  padding: 16px;\n  background: #F8FAFC;\n  color: #475569;\n  font-size: 14px;\n  line-height: 22px;\n  margin: 16px 0 24px;\n}\n\n.dark .code-image-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.code-screenshot {\n  display: block;\n  width: 100%;\n  margin: 16px 0 24px;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-screenshot {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.code-community-panel {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 180px;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  padding: 20px;\n  margin: 16px 0 8px;\n  background: #FFFFFF;\n}\n\n.code-community-panel p {\n  margin-bottom: 0;\n}\n\n.code-qr-placeholder {\n  display: flex;\n  min-height: 180px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  background: #F8FAFC;\n  color: #334155;\n  text-align: center;\n}\n\n.code-qr-placeholder small {\n  max-width: 140px;\n  color: #64748B;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.code-community-qr {\n  display: block;\n  width: 180px;\n  max-width: 100%;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-community-panel {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.dark .code-qr-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.dark .code-qr-placeholder small {\n  color: #94A3B8;\n}\n\n@media (max-width: 640px) {\n  .code-community-panel {\n    grid-template-columns: 1fr;\n  }\n\n  .code-qr-placeholder {\n    min-height: 220px;\n  }\n}\n\nbody:has(.question-standalone-marker) header,\nbody:has(.question-standalone-marker) #navbar,\nbody:has(.question-standalone-marker) #sidebar,\nbody:has(.question-standalone-marker) #sidebar-content,\nbody:has(.question-standalone-marker) footer,\nbody:has(.question-standalone-marker) [class*=\"navbar\"],\nbody:has(.question-standalone-marker) [class*=\"Navbar\"],\nbody:has(.question-standalone-marker) [class*=\"sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"Sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"search\"],\nbody:has(.question-standalone-marker) [class*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"搜索\"],\nbody:has(.question-standalone-marker) [role=\"search\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) #table-of-contents-layout,\nbody:has(.question-standalone-marker) [aria-label=\"目录\"],\nbody:has(.question-standalone-marker) [aria-label=\"Contents\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) main,\nbody:has(.question-standalone-marker) article {\n  padding-top: 0 !important;\n}\n\nbody:has(.question-standalone-marker) article {\n  max-width: 900px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n}\n"])</script><script>self.__next_f.push([1,"4b:[\"$\",\"$L58\",null,{\"cssFiles\":[{\"_id\":\"69c3de127ba705a281f56bac\",\"filePath\":\"style.css\",\"subdomain\":\"agent-en\",\"__v\":0,\"content\":\"$59\"}]}]\n5b:T147f,"])</script><script>self.__next_f.push([1,"(() =\u003e {\n  const PRODUCT_URL = 'https://agent.minimax.io';\n  const PRODUCT_NAME = 'MiniMax Agent';\n  const MINIMAX_URL = 'https://www.minimax.io';\n  const LOGO_URL = 'https://file.cdn.minimax.io/public/969d635c-cab6-45cc-8d61-47c9fe40c81f.png';\n  const LANGUAGE = 'en-US';\n  const DESCRIPTION = 'MiniMax Agent is a general-purpose AI agent that builds full-stack web apps, presentations, deep research reports, and more. Powered by a multi-agent system.';\n\n  const baseCount = 32182;\n  const startDate = new Date('2024-01-01').getTime();\n  const today = new Date().getTime();\n  const daysSinceStart = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));\n  const dateNum = parseInt(new Date().toISOString().slice(0, 10).replace(/-/g, ''), 10);\n  const dailyIncrement = 50 + (dateNum % 40);\n  const ratingCount = baseCount + Math.floor(daysSinceStart * (dailyIncrement - 20));\n\n  const schema = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      {\n        '@type': 'SoftwareApplication',\n        '@id': PRODUCT_URL + '/#softwareapplication',\n        name: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        operatingSystem: 'Web, Windows, Mac, iOS, Android',\n        applicationCategory: 'ProductivityApplication',\n        aggregateRating: {\n          '@type': 'AggregateRating',\n          ratingValue: 4.9,\n          bestRating: 5,\n          ratingCount: ratingCount,\n        },\n        offers: {\n          '@type': 'Offer',\n          price: '0',\n          priceCurrency: 'USD',\n        },\n        logo: {\n          '@type': 'ImageObject',\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n          inLanguage: LANGUAGE,\n          url: LOGO_URL,\n          contentUrl: LOGO_URL,\n          caption: PRODUCT_NAME,\n        },\n        mainEntityOfPage: {\n          '@type': 'WebPage',\n          '@id': PRODUCT_URL + '/#webpage',\n        },\n        creator: {\n          '@type': 'Organization',\n          name: 'MiniMax',\n          url: MINIMAX_URL,\n        },\n        features: [\n          'Full-Stack Web App Development',\n          'PPT \u0026 Presentation Generation',\n          'Deep Research \u0026 Analysis',\n          'Browser Automation',\n          'Code Generation',\n          'MCP Ecosystem Integration',\n          'Multimodal Content Creation',\n        ],\n      },\n      {\n        '@type': 'WebSite',\n        '@id': PRODUCT_URL + '/#website',\n        url: PRODUCT_URL,\n        name: PRODUCT_NAME,\n        description: DESCRIPTION,\n        publisher: { '@id': PRODUCT_URL + '/#organization' },\n        inLanguage: LANGUAGE,\n        copyrightHolder: { '@id': PRODUCT_URL + '/#organization' },\n      },\n      {\n        '@type': 'WebPage',\n        '@id': PRODUCT_URL + '/#webpage',\n        url: window.location.href,\n        name: document.title,\n        about: { '@id': PRODUCT_URL + '/#organization' },\n        isPartOf: { '@id': PRODUCT_URL + '/#website' },\n        primaryImageOfPage: { '@id': PRODUCT_URL + '/#primaryimage' },\n        image: { '@id': PRODUCT_URL + '/#primaryimage' },\n        thumbnailUrl: LOGO_URL,\n        datePublished: new Date().toISOString(),\n        dateModified: new Date().toISOString(),\n        description: DESCRIPTION,\n        inLanguage: LANGUAGE,\n      },\n      {\n        '@type': 'ImageObject',\n        inLanguage: LANGUAGE,\n        '@id': PRODUCT_URL + '/#primaryimage',\n        url: LOGO_URL,\n        contentUrl: LOGO_URL,\n        width: 80,\n        height: 80,\n      },\n      {\n        '@type': 'BreadcrumbList',\n        '@id': PRODUCT_URL + '/#breadcrumb',\n        itemListElement: [\n          {\n            '@type': 'ListItem',\n            position: 1,\n            name: 'MiniMax Agent',\n            item: PRODUCT_URL,\n          },\n          {\n            '@type': 'ListItem',\n            position: 2,\n            name: document.title,\n            item: window.location.href,\n          },\n        ],\n      },\n      {\n        '@type': ['Organization', 'Brand'],\n        '@id': PRODUCT_URL + '/#organization',\n        name: PRODUCT_NAME,\n        legalName: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        description: DESCRIPTION,\n        logo: {\n          '@type': 'ImageObject',\n          inLanguage: LANGUAGE,\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n        },\n        parentOrganization: {\n          '@type': ['Organization', 'Brand'],\n          name: 'MiniMax',\n          legalName: 'MiniMax',\n          url: MINIMAX_URL,\n          description: 'MiniMax is a leading general artificial intelligence technology company.',\n          logo: {\n            '@type': 'ImageObject',\n            inLanguage: LANGUAGE,\n            '@id': MINIMAX_URL + '/#schema/logo/image',\n            url: LOGO_URL,\n            contentUrl: LOGO_URL,\n            caption: 'MiniMax',\n          },\n          sameAs: [\n            'https://www.linkedin.com/company/minimax-ai/',\n            'https://en.wikipedia.org/wiki/MiniMax_(company)',\n            'https://x.com/MiniMax_AI',\n            'https://github.com/MiniMax-AI',\n            'https://discord.com/invite/hvvt8hAye6',\n          ],\n        },\n      },\n    ],\n  };\n\n  const script = document.createElement('script');\n  script.type = 'application/ld+json';\n  script.textContent = JSON.stringify(schema);\n  document.head.appendChild(script);\n})();\n"])</script><script>self.__next_f.push([1,"4c:[\"$\",\"$L5a\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69c794007ba705a2811a3dae\",\"filePath\":\"scripts/seo-schema.js\",\"subdomain\":\"agent-en\",\"__v\":0,\"content\":\"$5b\"}]}]\n5e:T32b1,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,blockquote:`blockquote`,li:`li`,ol:`ol`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Heading,OptimizedImage}=_components;if(!Heading)_missingMdxReference(`Heading`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`After graduating in computer science, I spent four years working as an analyst in finance.`}),`\n`,_jsx(_components.p,{children:`Four years of coding and four years of writing put me at both ends at once: among the people who build tools, and among the people who live in them.`}),`\n`,_jsx(_components.p,{children:`After following generation after generation of compute chips, and after many late nights wrestling with disconnected research reports, Excel models and industry data, I noticed something. In real professional work, the rare judgments, the ones that often take only a moment, are separated from the finished result by a mountain of simple but tedious work: collating, formatting, polishing. These are skills any intern is expected to have. Perhaps every industry is still waiting for a genuinely efficient tool.`}),`\n`,_jsx(_components.p,{children:`After ChatGPT broke through, I built Dify workflows and agentic search, and designed PaiWork, a vertical workbench for finance that users loved. That hands-on work, and the wider view I gained after joining MiniMax, led me to an architectural conclusion that keeps getting sharper: more than an agent, every industry needs a native environment where agents and people work closely together in one cohesive place. That is where the idea of Mini App came from.`}),`\n`,_jsx(_components.p,{children:`In short, a Mini App is a product that:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`Installs as a standard plugin, where every capability is pluggable;`}),`\n`,_jsx(_components.li,{children:`Calls all of the Agent’s external capabilities (MCP / CLI) and shares the full context (projects and conversations) with the Agent;`}),`\n`,_jsx(_components.li,{children:`Exposes all of its own capabilities back to the Agent;`}),`\n`,_jsx(_components.li,{children:`Comes with a complete frontend, with one core mission: letting humans and AI work in the same environment.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`I want to unpack the thinking behind Mini App from two angles.`}),`\n`,_jsx(Heading,{level:`2`,id:`1-why-a-coding-agent-makes-a-poor-personal-workbench`,children:`1. Why a coding agent makes a poor personal workbench`}),`\n`,_jsx(_components.p,{children:`Put a modern domain expert’s work next to a programmer’s and two things stand out: attention is split in almost the same way, yet the foundations underneath are completely different.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=a59661c60ea30fa9734b41bb29a6c3f6`,alt:`Same kind of work, different foundations: programmers and domain experts have the same shape of work in their environments, where context lives and how attention is split, but the foundation agents rely on is completely different`,\"data-og-width\":`1200`,width:`1200`,\"data-og-height\":`810`,height:`810`,\"data-path\":`images/techblog/agent-as-os/fig1-isomorphism.svg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=280\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=07776730ddacc14f93b98e64bccc4eb7 280w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=560\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=0bc964e401dcdd8bda8d1ac1e4a87ca8 560w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=840\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=c61cef833cc9522d8f7cf95d641b6772 840w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=1100\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=7debe241ec426356f2c480ec420c26a1 1100w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=1650\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=955bf499569aaa9f714c72dd41bfe889 1650w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig1-isomorphism.svg?w=2500\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=b457c30a191f292f3de87007f424b35f 2500w`}),`\n`,_jsx(_components.p,{children:`A modern domain expert works inside professional software and SaaS tools: EDA for chip engineers, CAD for industrial designers, trading terminals for financial analysts, and Office for nearly everyone. Their context is scattered across every corner of the system. More than half of their attention may go to understanding the project and reading the wider environment; the actual “writing” takes less than half. The same is now true of programmers who already rely heavily on coding agents.`}),`\n`,_jsx(_components.p,{children:`But the same structure on top does not mean the same foundation underneath. Today’s office agents are fixated on one-shot delivery, which is a cardinal sin for productivity tools. Even in professional software engineering, very few projects can be written once and shipped. And code at least has compilers and scripts to pinpoint defects; in most industries, the only checker is a person.`}),`\n`,_jsx(_components.p,{children:`AI in the lab can solve a lot of problems. But the real moat in every industry is the loop: ask a question, solve it, then ask the next one. While an expert reads the whole environment and frames the question, the judgments that set the direction live in their feel for the full context. No black-box “one prompt and done” can stand in for that.`}),`\n`,_jsx(_components.p,{children:`So we arrived at the first line of the Mini App philosophy:`}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`Real productivity in every industry is still rooted in highly specialized work environments. A plain chat UI cannot replace the precise control and rich views of professional tools. The professional workflow of the future should not ask users to leave their workbench to accommodate AI. It should let professional environments and AI grow together.`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`2-not-an-entry-point-building-the-agent-into-the-computer-as-a-system-service`,children:`2. Not an entry point: building the agent into the computer as a system service`}),`\n`,_jsx(_components.p,{children:`In the coding-agent era, the lucky few that became the entry point may already be earning tens of billions of dollars in ARR. But measured against the end goal of “Intelligence with Everyone”, programmers are a small group. An entry-point model built for that small group, one that already shares Bash as a common protocol, simply does not carry over to every other industry.`}),`\n`,_jsx(_components.p,{children:`Recent moves across the industry keep proving the point: try to take over everything through a single surface-level agent entry point, and you inevitably break who owns the interaction and how the ecosystem is ordered.`}),`\n`,_jsx(_components.p,{children:`That is why, in building Mini App, we passed on the narrow door of grabbing the entry point and chose an architecture that goes deep into the foundation:`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=dae5acfe85c7e393a2d69b7265e7a25f`,alt:`Agent as OS: the domain expert owns the interaction; Mini App workspaces call both Agent OS and classic system services; Agent OS unifies context and tool protocols, schedules agent tasks and serves inference, and runs on classic services such as memory management, thread scheduling and sockets; CPU / GPU sits at the bottom`,\"data-og-width\":`1200`,width:`1200`,\"data-og-height\":`950`,height:`950`,\"data-path\":`images/techblog/agent-as-os/fig2-agent-as-os.svg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=280\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=b3f872ab39cd91ec102ed3530947b715 280w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=560\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=080fa98c7886ce7dc7f5fcab8cd7e918 560w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=840\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=6fd22d2e7e439f4af0d5d8e6806a37aa 840w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=1100\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=e76fca3c97f39f217048ce72f61be289 1100w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=1650\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=f6cdaf4b5e6e49a24f131779ead91310 1650w, https://mintcdn.com/agent-en/RHbrCI8ESK8Rv5Nc/images/techblog/agent-as-os/fig2-agent-as-os.svg?w=2500\u0026fit=max\u0026auto=format\u0026n=RHbrCI8ESK8Rv5Nc\u0026q=85\u0026s=e9d0c701fc0367d9f91ee1b27ed467ce 2500w`}),`\n`,_jsx(_components.p,{children:`If compute is electricity, the agent should be the operating system. A good harness should not be built as an entry point. It should run quietly underneath, like kernel scheduling or a file system: taking over the context and tool protocols scattered across the system, and turning AI into an atomic capability that any professional environment can draw on.`}),`\n`,_jsxs(_components.p,{children:[`Once the agent is built in as a system service, the modern computer finally becomes a cohesive professional workspace, where plugins are software and plugins are apps. `,_jsx(_components.strong,{children:`Agent plugins let you reshape the agent; Mini Apps let you build applications on top of it.`}),` The host takes care of everything at the system level, and developers only write the interface and the business logic.`]}),`\n`,_jsx(_components.p,{children:`Going one step further, we got clear on what Mini App sets out to do:`}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`By building professional-grade Mini Apps that grow on top of Agent OS, we aim to connect the specialized interfaces of every vertical with the AI-native compute underneath, and reshape how every industry works.`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`related-links`,children:`Related links`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Thoughts on AI phones: `,_jsx(_components.a,{href:`https://github.com/HanZijie/agentos-android`,children:`HanZijie/agentos-android`})]}),`\n`,_jsxs(_components.li,{children:[`Join the Mini App ecosystem: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/MiniMax-Code-MiniApps/tree/main`,children:`MiniMax-AI/MiniMax-Code-MiniApps`})]}),`\n`,_jsxs(_components.li,{children:[`Contribute plugins to MiniMax Code: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/MiniMax-Code-Plugins`,children:`MiniMax-AI/MiniMax-Code-Plugins`})]}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`A few fun Mini Apps`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`For vibe modelers: 3D printing, just by typing: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/MiniMax-Code-MiniApps/tree/main/plugins/hanzijie/cq-viewer`,children:`hanzijie/cq-viewer`})]}),`\n`,_jsxs(_components.li,{children:[`A renaissance for old-school, hand-written coding: `,_jsx(_components.a,{href:`https://github.com/TrentChou/MiniMax-Code-MiniApps/tree/add-text-editor`,children:`trentchou/text-editor`})]}),`\n`,_jsxs(_components.li,{children:[`Let AI help you find the island where your heart belongs: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/MiniMax-Code-MiniApps/tree/main/plugins/yujiachen-y/xinyu-daily`,children:`yujiachen-y/xinyu-daily`})]}),`\n`,_jsxs(_components.li,{children:[`Every AI-native designer needs a gallery: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/MiniMax-Code-MiniApps/tree/main/plugins/zch0227/anatomy-gallery`,children:`zch0227/anatomy-gallery`})]}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"$L5c\",null,{\"slug\":\"techblog/agent-as-os\",\"pageMetadata\":\"$33:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5d\",null,{\"mdxSource\":{\"compiledSource\":\"$5e\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Product Diary: Building Professional-Grade Mini Apps on Agent OS\",\"sidebarTitle\":\"Product Diary: Building Professional-Grade Mini Apps on Agent OS\",\"description\":\"From chatbots and workflows to agents, and now Mini Apps: why we chose to build the agent into the computer as a system service.\",\"og:title\":\"Product Diary: Building Professional-Grade Mini Apps on Agent OS\",\"og:description\":\"From chatbots and workflows to agents, and now Mini Apps: why we chose to build the agent into the computer as a system service.\",\"href\":\"/techblog/agent-as-os\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"agent.minimax.io/docs\"}]}]\n"])</script></body></html>