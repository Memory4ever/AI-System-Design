{"data":{"id":"10.48550/arxiv.2610.26834","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.26834","prefix":"10.48550","suffix":"arxiv.2610.26834","identifiers":[{"identifier":"2610.26834","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.26834"}],"creators":[{"name":"Hartl, Anamaria-Roberta","nameType":"Personal","givenName":"Anamaria-Roberta","familyName":"Hartl","affiliation":[],"nameIdentifiers":[]},{"name":"Zólyomi, Levente","nameType":"Personal","givenName":"Levente","familyName":"Zólyomi","affiliation":[],"nameIdentifiers":[]},{"name":"List, Michael","nameType":"Personal","givenName":"Michael","familyName":"List","affiliation":[],"nameIdentifiers":[]},{"name":"Klambauer, Günter","nameType":"Personal","givenName":"Günter","familyName":"Klambauer","affiliation":[],"nameIdentifiers":[]},{"name":"Böck, Sebastian","nameType":"Personal","givenName":"Sebastian","familyName":"Böck","affiliation":[],"nameIdentifiers":[]},{"name":"Hochreiter, Sepp","nameType":"Personal","givenName":"Sepp","familyName":"Hochreiter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kronecker Delta Rule for Long Context Linear Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-19T17:56:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-20T02:47:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We propose KronLSTM, a linear attention architecture based on the Kronecker Delta Rule, a novel update rule for associative matrix memories. KronLSTM extends the xLSTM family with a memory-revision mechanism that corrects targeted associations while modifying the memory only along a single direction in matrix space. This minimally invasive memory revision reduces interference with previously stored information compared with delta-rule updates, making it particularly well suited for long-context language modeling. The resulting memory dynamics can be mathematically described as a Markov chain that converges to a steady-state distribution, while the expected norm of the memory matrix remains uniformly bounded throughout the entire input sequence. Hence, KronLSTM ensures stable memory dynamics without requiring additional normalization and stabilization mechanisms for the memory state. Experiments show that KronLSTM is competitive with, and often outperforms, existing linear attention architectures, including models of the (Gated) DeltaNet family, with particularly strong performance on long context benchmarks. These results establish the Kronecker Delta Rule as an effective and analytically tractable foundation for stable associative memory in recurrent linear attention architectures. Our code (https://github.com/NX-AI/KronLSTM) and models (https://huggingface.co/collections/NX-AI/kronlstm) are open-source.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.26834","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-20T05:07:46.000Z","registered":"2026-10-20T05:07:47.000Z","published":"2026","updated":"2026-10-20T05:07:47.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.26834","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}