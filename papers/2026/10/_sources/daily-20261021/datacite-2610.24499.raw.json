{"data":{"id":"10.48550/arxiv.2610.24499","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.24499","prefix":"10.48550","suffix":"arxiv.2610.24499","identifiers":[{"identifier":"2610.24499","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.24499"}],"creators":[{"name":"Wang, Yu","nameType":"Personal","givenName":"Yu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zhu","nameType":"Personal","givenName":"Zhu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Ning","nameType":"Personal","givenName":"Ning","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yifan","nameType":"Personal","givenName":"Yifan","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Xiu","nameType":"Personal","givenName":"Xiu","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Bin","nameType":"Personal","givenName":"Bin","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Zhiwen","nameType":"Personal","givenName":"Zhiwen","familyName":"Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TideKV: Delayed KV Eviction via Layer-Wise Chunked Prefill for Memory-Efficient Long-Context LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-17T06:44:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-20T00:35:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Long-context large language model (LLM) inference is important for modern intelligent applications but remains constrained by peak memory during prompt prefill. Existing KV cache compression reduces decoding memory but typically requires full-prompt prefill to preserve global context, retaining a high construction peak. Online chunk-level eviction lowers memory earlier but selects before each layer has observed the complete prompt, potentially degrading cache construction and decoding. We present TideKV, an on-GPU cache-construction architecture using layer-major delayed eviction. TideKV processes all prompt chunks within each Transformer layer, retains full-prompt KV only for the active layer, and evicts at layer end. This schedule preserves full-prompt-aware selection while reducing activation and temporary memory. Experiments across multiple computing platforms show that TideKV preserves the inference quality and final cache size of the evaluated compression methods. At 64K on A100, it reduces the construction-time transient footprint by 83.89%. On RTX 4090, it increases time to first token by only 1.06% at 64K and enables 128K prefill. TideKV also completes 128K on Jetson, whereas matched post-prefill compression runs out of memory on both resource-constrained platforms. These results show that delayed layer-end eviction substantially expands feasible context lengths without sacrificing cache utility.","descriptionType":"Abstract"},{"description":"Accepted by The Journal of Systems Architecture","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.24499","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-20T04:16:03.000Z","registered":"2026-10-20T04:16:04.000Z","published":"2026","updated":"2026-10-20T04:16:04.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.24499","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}