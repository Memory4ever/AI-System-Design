{"data":{"id":"10.48550/arxiv.2610.25679","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.25679","prefix":"10.48550","suffix":"arxiv.2610.25679","identifiers":[{"identifier":"2610.25679","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.25679"}],"creators":[{"name":"Xu, Liang","nameType":"Personal","givenName":"Liang","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Shen, Shufan","nameType":"Personal","givenName":"Shufan","familyName":"Shen","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Zhongni","nameType":"Personal","givenName":"Zhongni","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yufei","nameType":"Personal","givenName":"Yufei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Wei","nameType":"Personal","givenName":"Wei","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Guojun","nameType":"Personal","givenName":"Guojun","familyName":"Yin","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Shuhui","nameType":"Personal","givenName":"Shuhui","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LOOP: Recovery-Aligned Iterative Layer Pruning via On-Policy Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-19T02:30:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-20T01:44:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Layer-level pruning is attractive for large language model (LLM) deployment as it reduces the model size while preserving a dense architecture that can be efficiently executed on standard hardware. Current methods typically follow a one-shot paradigm, which first removes selected layers to reach a target model size and then performs additional training to recover model capabilities. However, pruning directly to the target size can substantially degrade reasoning capabilities, making subsequent recovery more difficult under a limited training budget. Moreover, this paradigm separates layer selection from recovery, limiting the use of recovery information to guide selection and potentially hindering the recovery of reasoning capabilities. To address these limitations, we propose LOOP, a Layer-level Recovery-Oriented On-Policy Pruning framework that interleaves pruning and recovery across multiple shots. In each shot, LOOP removes a single layer and performs short on-policy distillation, mitigating the abrupt degradation in reasoning capabilities associated with one-shot pruning. To guide layer selection in subsequent shots, LOOP reuses on-policy trajectories and optimization signals from recovery to jointly assess each remaining layer's reasoning contribution and recovery sensitivity, thereby making layer selection recovery-aware. Evaluations on several benchmarks show that LOOP consistently outperforms one-shot baselines in average accuracy across different model scales and pruning ratios.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.25679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-20T04:42:07.000Z","registered":"2026-10-20T04:42:08.000Z","published":"2026","updated":"2026-10-20T04:42:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.25679","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}