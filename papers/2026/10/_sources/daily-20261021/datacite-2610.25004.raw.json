{"data":{"id":"10.48550/arxiv.2610.25004","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.25004","prefix":"10.48550","suffix":"arxiv.2610.25004","identifiers":[{"identifier":"2610.25004","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.25004"}],"creators":[{"name":"Chen, Tieyuan","nameType":"Personal","givenName":"Tieyuan","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Huabin","nameType":"Personal","givenName":"Huabin","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yingtao","nameType":"Personal","givenName":"Yingtao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shijie","nameType":"Personal","givenName":"Shijie","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Tengyu","nameType":"Personal","givenName":"Tengyu","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Weiyao","nameType":"Personal","givenName":"Weiyao","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Jianguo","nameType":"Personal","givenName":"Jianguo","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UpLoop: Upcycling Large Language Models with Gated Loop"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-18T04:19:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-20T01:06:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Looped large language models trade parameter storage for recurrent computation, but most are trained from scratch. In practice, pretraining with looped depth is expensive, making post-training upcycling of a pretrained non-looped LLM an attractive alternative. We introduce \\textbf{UpLoop}, a post-training recipe based on \\emph{layer-wise} recurrence. Instead of looping a whole model or a middle block, UpLoop loops each selected layer locally, preserving the pretrained depth hierarchy and avoiding feature-space mismatch. To make loop execution useful, we add hidden-wise gates on the attention and MLP residual branches, so later loops act as progressive refinements rather than redundant rewrites. Empirically, UpLoop breaks the commonly observed saturation at two loops ($R=2$) in prior looped models. Starting from Qwen3-4B Base and applying SFT, UpLoop improves the average accuracy across 20 benchmarks by 6.17\\% at $R=3$. We use $R=3$ as the main setting for the best accuracy--cost trade-off, while both native and extrapolated $R=4$ yield further gains.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.25004","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-20T04:27:15.000Z","registered":"2026-10-20T04:27:1