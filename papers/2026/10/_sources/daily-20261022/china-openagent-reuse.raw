    {
      "sha": "77dfda1fc2f3e010e9e6faf633b2dd42d572b8a6",
      "filename": "services/core/internal/sandbox/node/generation_json_test.go",
      "status": "modified",
      "additions": 18,
      "deletions": 0,
      "changes": 18,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fgeneration_json_test.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fgeneration_json_test.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fgeneration_json_test.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -123,3 +123,21 @@ func TestCheckpointGenerationHealthJSONRoundTrip(t *testing.T) {\n \t\t})\n \t}\n }\n+\n+func TestPreparationFramesSurviveStrictFrame(t *testing.T) {\n+\tq := request{DeploymentGeneration: 1, ID: uuid.NewString(), Sequence: 1, ConnectionID: uuid.NewString(), OwnerEpoch: 1, Operation: \"restore_preparation\", TimeoutMillis: 60000, Reference: reference(), Key: strings.Repeat(\"a\", 64)}\n+\tout := response{ID: q.ID, ConnectionID: q.ConnectionID, Restored: true}\n+\tfor _, f := range []frame{{Version: ProtocolVersion, Type: \"request\", Request: &q}, {Version: ProtocolVersion, Type: \"response\", Response: &out}} {\n+\t\traw, err := json.Marshal(f)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tdecoded, err := decodeFrame(raw)\n+\t\tif err != nil {\n+\t\t\tt.Fatal(\"preparation frame rejected\", f.Type, err)\n+\t\t}\n+\t\tif (decoded.Request != nil && decoded.Request.Key != q.Key) || (decoded.Response != nil && !decoded.Response.Restored) {\n+\t\t\tt.Fatal(\"preparation field lost\", f.Type)\n+\t\t}\n+\t}\n+}"
    },
