      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fmicrosandbox%2Fprovider.go",
