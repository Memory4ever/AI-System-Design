      "sha": "b9b9873b9f3853c93fb232bde65b800886c8ae12",
      "filename": "services/core/internal/sandbox/node/generation_json.go",
      "status": "modified",
      "additions": 2,
      "deletions": 2,
      "changes": 4,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fgeneration_json.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fgeneration_json.go",
