    {
      "sha": "4a8b5b34c61247da3aa92b81e2d8e9f334afc0ed",
      "filename": "services/core/internal/sandbox/node/proxy.go",
      "status": "modified",
      "additions": 8,
      "deletions": 0,
      "changes": 8,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fproxy.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fproxy.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fproxy.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -154,6 +154,14 @@ func (p *provider) DeleteSnapshot(ctx context.Context, r sandbox.Reference, s sa\n func (p *provider) RunCommandCompute(ctx context.Context, r sandbox.Reference, c sandbox.Compute, v sandbox.Command) (sandbox.CommandResult, error) {\n \treturn p.command(ctx, request{Operation: \"command_compute\", Reference: r, Compute: &c, Command: &v})\n }\n+func (p *provider) RestorePreparation(ctx context.Context, r sandbox.Reference, key string) (bool, error) {\n+\tout, e := p.call(ctx, request{Operation: \"restore_preparation\", Reference: r, Key: key})\n+\treturn out.Restored && e == nil, e\n+}\n+func (p *provider) SavePreparation(ctx context.Context, r sandbox.Reference, key string) error {\n+\t_, e := p.call(ctx, request{Operation: \"save_preparation\", Reference: r, Key: key})\n+\treturn e\n+}\n func (p *provider) ResumeCompute(ctx context.Context, r sandbox.Reference, c sandbox.Compute) (sandbox.ComputeState, error) {\n \treturn p.state(ctx, request{Operation: \"resume_compute\", Reference: r, Compute: &c})\n }"
    },
    {
      "sha": "087466bf45c8fede12c665106576366ce498abf4",
      "filename": "services/core/internal/sandbox/node/wire.go",
      "status": "modified",
      "additions": 12,
      "deletions": 0,
      "changes": 12,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fwire.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fwire.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fsandbox%2Fnode%2Fwire.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -98,6 +98,8 @@ type request struct {\n \tResume      *sandbox.ResumeRequest    `json:\"resume,omitempty\"`\n \tSnapshot    *sandbox.SnapshotIdentity `json:\"snapshot,omitempty\"`\n \tObservation *runtimeobs.Target        `json:\"observation,omitempty\"`\n+\t// Key is the opaque preparation cache key of the preparation operations.\n+\tKey string `json:\"key,omitempty\"`\n }\n \n type response struct {\n@@ -110,6 +112,7 @@ type response struct {\n \tState        *sandbox.ComputeState              `json:\"state,omitempty\"`\n \tCommand      *sandbox.CommandResult             `json:\"command,omitempty\"`\n \tSample       *runtimeobs.Sample                 `json:\"sample,omitempty\"`\n+\tRestored     bool                               `json:\"restored,omitempty\"`\n }\n \n type frame struct {\n@@ -263,6 +266,10 @@ func (q request) validate() error {\n \t\tif count == 0 {\n \t\t\treturn nil\n \t\t}\n+\tcase \"restore_preparation\", \"save_preparation\":\n+\t\tif count == 0 && q.Key != \"\" && len(q.Key) <= 256 {\n+\t\t\treturn nil\n+\t\t}\n \tcase \"new_compute\":\n \t\tif count == 0 || count == 1 && q.Snapshot != nil {\n \t\t\treturn nil\n@@ -332,6 +339,10 @@ func execute(ctx context.Context, p sandbox.SandboxProvider, q request) (respons\n \tcase \"command\":\n \t\tcommand, err = p.RunCommand(ctx, q.Reference, *q.Command)\n \t\tout.Command = &command\n+\tcase \"restore_preparation\":\n+\t\tout.Restored, err = p.RestorePreparation(ctx, q.Reference, q.Key)\n+\tcase \"save_preparation\":\n+\t\terr = p.SavePreparation(ctx, q.Reference, q.Key)\n \tdefault:\n \t\tvar state sandbox.ComputeState\n \t\tvar compute sandbox.Compute\n@@ -380,6 +391,7 @@ func execute(ctx context.Context, p sandbox.SandboxProvider, q request) (respons\n \t\t}\n \t\tout.Command = nil\n \t\tout.Compute = nil\n+\t\tout.Restored = false\n \t}\n \treturn out, err\n }"
    },
    {
      "sha": "acc47ccc16f09d3b4b285ff0376ac43fd399de54",
      "filename": "services/core/internal/sandbox/sandbox_provider.go",
      "status": "modified",
      "additions": 13,
      "deletions": 0,
      "changes": 13,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -118,6 +118,13 @@ type SandboxProvider interface {\n \t// ResumeCompute thaws only the same resident instance after an aborted pause.\n \tResumeCompute(context.Context, Reference, Compute) (ComputeState, error)\n \n+\t// The preparation cache keeps the Environment filesystem left by one finished\n+\t// preparation. Key is opaque and the adapter owns storage and lifetime. Both\n+\t// address the allocation's initial compute and share one declaration.\n+\t// RestorePreparation returns false when it holds no valid entry.\n+\tRestorePreparation(ctx context.Context, r Reference, key string) (bool, error)\n+\tSavePreparation(ctx context.Context, r Reference, key string) error\n+\n \t// Observe reads one owned Runtime instance after verifying its ownership. It\n \t// never renews, restarts or stops compute.\n \tObserve(context.Context, runtimeobs.Target) (runtimeobs.Sample, error)\n@@ -130,6 +137,9 @@ var requiredOperations = []string{\"Create\", \"GetInfo\", \"Renew\", \"Kill\", \"RunComm\n // restore support cannot safely own a compute incarnation.\n var checkpointOperations = []string{\"Initial\", \"NewCompute\", \"GetCompute\", \"Suspend\", \"Resume\", \"KillCompute\", \"DeleteSnapshot\", \"RunCommandCompute\", \"ResumeCompute\"}\n \n+// preparationOperations are both supported or both unsupported.\n+var preparationOperations = []string{\"RestorePreparation\", \"SavePreparation\"}\n+\n // Compute identifies one incarnation of an allocation. Name is provider-derived.\n // ID is empty only until the original create or restore result is observed.\n type Compute struct {\n@@ -254,6 +264,9 @@ func ValidateOperations(operations providercontract.Operations) error {\n \t\t\treturn fmt.Errorf(\"%w: incomplete checkpoint lifecycle\", providercontract.ErrContract)\n \t\t}\n \t}\n+\tif operations[preparationOperations[0]].State != operations[preparationOperations[1]].State {\n+\t\treturn fmt.Errorf(\"%w: incomplete preparation cache\", providercontract.ErrContract)\n+\t}\n \treturn nil\n }\n "
    },
    {
      "sha": "1cbde45ab2a8d88b21abfd38ba5aa7b4faa77870",
      "filename": "services/core/internal/sandbox/sandbox_provider_test.go",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider_test.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider_test.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fsandbox%2Fsandbox_provider_test.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -16,7 +16,7 @@ func TestOperationGroupsPartitionTheInterface(t *testing.T) {\n \t\t\tmethods = append(methods, name)\n \t\t}\n \t}\n-\tgroups := slices.Concat(requiredOperations, checkpointOperations, []string{\"Observe\"})\n+\tgroups := slices.Concat(requiredOperations, checkpointOperations, preparationOperations, []string{\"Observe\"})\n \tslices.Sort(groups)\n \tif !slices.Equal(methods, groups) {\n \t\tt.Fatalf(\"SandboxProvider operations %v, groups %v\", methods, groups)"
    },
