      "deletions": 0,
      "changes": 4,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapabilities.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapabilities.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapabilities.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -150,6 +150,10 @@ func (b *Binding) loadCapabilitySnapshot(root *os.Root, input agentcapabilities.\n \t\treturn agentcapabilities.Manifest{}, agentcapabilities.ErrInvalid\n \t}\n \tmanifest, err := agentcapabilities.Load(root)\n+\tif err == nil && !completed && manifest.Identity != identity {\n+\t\t// A preparation restored from an identical earlier Session carries that Session's identity.\n+\t\terr = agentcapabilities.Rebind(root, &manifest, input, identity)\n+\t}\n \tif err != nil || agentcapabilities.ValidateSelection(manifest, input, identity) != nil {\n \t\treturn agentcapabilities.Manifest{}, agentcapabilities.ErrInvalid\n \t}"
    },
    {
      "sha": "8bb807e1964f422b53de2f977b2ac3cccd2a8091",
      "filename": "apps/daemon/internal/localworkspace/capability_preparation_test.go",
      "status": "modified",
      "additions": 8,
      "deletions": 8,
      "changes": 16,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_preparation_test.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_preparation_test.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_preparation_test.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -66,20 +66,20 @@ func TestPreparationFreezesLocalContentsAcrossReconnect(t *testing.T) {\n \tif err != nil || string(fresh[len(fresh)-6:]) != \"second\" {\n \t\tt.Fatal(\"new Session did not capture new source\", err)\n \t}\n-\t// Reusing a snapshot under another identity or selection cannot start native work.\n-\treconnect.stateKey = uuid.NewString()\n-\tchanged := configured\n-\tchanged.AgentStateKey = reconnect.stateKey\n-\tif _, err = reconnect.Prepare(t.Context(), changed); err == nil {\n-\t\tt.Fatal(\"foreign snapshot accepted\")\n-\t}\n-\tchanged = configured\n+\t// Reusing a snapshot under another selection cannot start native work, even\n+\t// for another Session.\n \tlocal := *configured.LocalEnvironment\n \tlocal.CapabilitySources = &agentcapabilities.Input{}\n+\tchanged := configured\n \tchanged.LocalEnvironment = &local\n \tif _, err = b.Prepare(t.Context(), changed); err == nil {\n \t\tt.Fatal(\"changed selection accepted\")\n \t}\n+\treconnect.stateKey = uuid.NewString()\n+\tchanged.AgentStateKey = reconnect.stateKey\n+\tif _, err = reconnect.Prepare(t.Context(), changed); err == nil {\n+\t\tt.Fatal(\"foreign snapshot accepted\")\n+\t}\n }\n \n func TestPreparationUsesOperatorSourcesAndLeavesFailuresInert(t *testing.T) {"
    },
    {
      "sha": "e1f4cbd3a1d5c5352595faee8adb5671491d5736",
      "filename": "apps/daemon/internal/localworkspace/capability_rebind_test.go",
      "status": "added",
      "additions": 37,
      "deletions": 0,
      "changes": 37,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_rebind_test.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_rebind_test.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/apps%2Fdaemon%2Finternal%2Flocalworkspace%2Fcapability_rebind_test.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -0,0 +1,37 @@\n+package localworkspace\n+\n+import (\n+\t\"testing\"\n+\n+\t\"github.com/MiniMax-AI/OpenAgentCore/internal/agentcapabilities\"\n+\t\"github.com/google/uuid\"\n+)\n+\n+func TestFinalizeRebindsIdenticalRestoredInstallation(t *testing.T) {\n+\tfirst, _ := testBinding(t)\n+\tsource := t.TempDir()\n+\twriteSourceSkill(t, source, \"restored\")\n+\tinput := agentcapabilities.Input{Directories: []string{source}}\n+\troot, unlock, err := first.openCapabilities(t.Context(), false)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdefer unlock()\n+\tif _, err = first.loadCapabilitySnapshot(root, input, first.capabilityIdentity(), false); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// The next Session's directory holds the files restored from the first.\n+\tnext, err := NewWithCapabilityDirectory(uuid.NewString(), uuid.NewString(), first.workspace, first.capabilityRoot)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif _, err = next.loadCapabilitySnapshot(root, agentcapabilities.Input{}, next.capabilityIdentity(), false); err == nil {\n+\t\tt.Fatal(\"different selection accepted\")\n+\t}\n+\tif _, err = next.loadCapabilitySnapshot(root, input, next.capabilityIdentity(), false); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif manifest, err := agentcapabilities.Load(root); err != nil || manifest.Identity != next.capabilityIdentity() {\n+\t\tt.Fatal(\"identity not rebound\", err)\n+\t}\n+}"
    },
    {
      "sha": "03dc6855165dba262a4cb2b3519ab4cb80c1d34a",
      "filename": "contracts/agents-api/environments.md",
      "status": "modified",
      "additions": 4,
      "deletions": 0,
      "changes": 4,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fenvironments.md",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fenvironments.md",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/contracts%2Fagents-api%2Fenvironments.md?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -316,6 +316,10 @@ The Session applies the Template first, then its own fields. Composition happens\n \n For comparison, an inline `openai_hosted` Session without a Template treats omitted and null `network` as enabled.\n \n+### Preparation reuse\n+\n+Core may start a hosted Environment from the result of an earlier preparation in the same Project whose effective configuration, after Template composition, is identical, for up to 24 hours after that preparation. Each Session still gets its own copy. Setup commands and package installation then do not run again for this Session. Only `/environment` is reused (see the workspace filesystem scope); HOME and other compute-local changes are not. Setup must not create per-Session unique values, perform external side effects that must happen per Session, or fetch credentials that expire within 24 hours; configurations that need this must differ, for example in `env` or `files`. A Provider that does not declare the [preparation cache](../../docs/sandbox-provider.md#explicit-operation-contracts) always prepares in full.\n+\n ### Restricted network\n \n `restricted` requires 1–100 exact ASCII hostnames in `allowed_domains`; subdomains and redirect targets need their own entries. Wildcards, URL or port syntax, IP literals, Unicode and trailing dots are rejected. Reads return the supplied spelling, order and duplicates; comparison uses a separate lowercase, deduplicated copy."
    },
    {
      "sha": "6edd472b8db39769376d091167e346e3e7a2c995",
      "filename": "contracts/agents-api/node-generation-protocol.md",
      "status": "modified",
      "additions": 3,
      "deletions": 1,
      "changes": 4,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fnode-generation-protocol.md",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fnode-generation-protocol.md",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/contracts%2Fagents-api%2Fnode-generation-protocol.md?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -85,12 +85,14 @@ Each operation carries its own arguments and returns the following result on suc\n | `suspend` | `Suspend` | `suspend` | `state` |\n | `resume` | `Resume` | `resume` | `state` |\n | `delete_snapshot` | `DeleteSnapshot` | `snapshot` | None |\n+| `restore_preparation` | `RestorePreparation` | `key` | `restored` |\n+| `save_preparation` | `SavePreparation` | `key` | None |\n \n A request whose `connection_id`, `owner_epoch` or `sequence` does not match closes the connection. A malformed request gets an `invalid` response. The node runs the request on the provider of the named `deployment_generation` and answers `unconfirmed` when it cannot. Core sends `create` and a `resume` that is not observe-only only to a generation that is ready on that node, and keeps at most 32 requests pending per connection.\n \n The budget is relative: the node anchors `timeout_ms` to its own clock on receipt and consumes it while the request waits in its queue, so the hosts' clocks need not agree. Core still bounds its own wait. A full node queue closes the connection.\n \n-The `response` frame carries `id` and `connection_id`. A successful response carries the result named in the operation table, with no result field for `kill`, `kill_compute` or `delete_snapshot`. A failed response carries an `error_code`:\n+The `response` frame carries `id` and `connection_id`. A successful response carries the result named in the operation table, with no result field for `kill`, `kill_compute`, `delete_snapshot` or `save_preparation`. A failed response carries an `error_code`:\n \n | `error_code` | Meaning |\n | --- | --- |"
    },
    {
      "sha": "3c0fd8c29a96520a142131bb6a04992213c2a9c6",
      "filename": "contracts/agents-api/zh/environments.md",
      "status": "modified",
      "additions": 5,
      "deletions": 1,
      "changes": 6,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fzh%2Fenvironments.md",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/contracts%2Fagents-api%2Fzh%2Fenvironments.md",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/contracts%2Fagents-api%2Fzh%2Fenvironments.md?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -1,7 +1,7 @@\n ---\n title: \"Environment 与模板\"\n source: contracts/agents-api/environments.md\n-source_hash: 3408e2c811042732d35227150533cf12a85cfcff8a5118d7eb62a5d68549cc8b\n+source_hash: f50217dd1fc465626ac7135a46b69cea0ee40fc14fd30141e23813018192cb5c\n ---\n \n Environment 是 Session 的执行资源，包括 Harness 运行所在的机器、工作区以及已完成准备的能力。Session 通过其 `environment` 配置创建 Environment；不存在独立的 create 调用。Environment 模板是 Session 创建时解析的可复用准备配置。本契约涵盖这两类资源、两种放置方式、输入接纳、能力准备、Skills、Plugins 和 MCP 连接来源。\n@@ -318,6 +318,10 @@ Session 会先应用模板，然后应用自身字段。组合仅在加密 Sessi\n \n 作为比较，不带模板的内联 `openai_hosted` Session 会将省略或为 null 的 `network` 视为启用。\n \n+### 准备复用 {#preparation-reuse}\n+\n+Core 可以用同一 Project 中较早一次准备的结果启动托管 Environment，前提是两者在 Template 组合之后的有效配置完全相同，且距该次准备不超过 24 小时。每个 Session 仍然得到自己的副本。此时设置命令和包安装不会为该 Session 再次运行。只复用 `/environment`（见工作区文件系统范围），HOME 和其他与计算实例本地相关的改动不会复用。设置过程不得产生每个 Session 唯一的值，不得执行必须按 Session 发生的外部副作用，也不得获取 24 小时内就会过期的凭据；需要这些行为的配置必须有所不同，例如在 `env` 或 `files` 上。未声明[准备缓存](../../../docs/zh/sandbox-provider.md#explicit-operation-contracts)的提供商始终完整准备。\n+\n ### 受限网络 {#restricted-network}\n \n `restricted` 要求在 `allowed_domains` 中提供 1–100 个精确 ASCII 主机名；子域名和重定向目标需要各自的条目。通配符、URL 或端口语法、IP 字面量、Unicode 和尾随点都会被拒绝。读取操作会返回提供的拼写、顺序和重复项；比较操作使用单独的小写去重副本。"
    },
    {
