      "sha": "2bf23bfeb72af585ec06572df1b6e6212f29865c",
      "filename": "services/core/tools/microsandbox-provider/backend.go",
      "status": "modified",
      "additions": 5,
      "deletions": 0,
      "changes": 5,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fbackend.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fbackend.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fbackend.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -45,6 +45,11 @@ func (b backend) run(ctx context.Context) (wire.Response, error) {\n \t\tdefer cancel()\n \t\tresult, e := runCommand(commandCtx, live, *b.q.Command, \"1000:1000\")\n \t\treturn wire.Response{Command: &result}, e\n+\tcase \"restore_preparation\":\n+\t\trestored, e := b.restorePreparation(ctx)\n+\t\treturn wire.Response{Restored: restored}, e\n+\tcase \"save_preparation\":\n+\t\treturn wire.Response{}, b.savePreparation(ctx)\n \tcase \"suspend\":\n \t\ts, e := b.suspend(ctx, *b.q.Suspend)\n \t\treturn wire.Response{State: &s}, e"
    },
    {
      "sha": "2582b3075e9910eed967c5489ed3c580216dc538",
      "filename": "services/core/tools/microsandbox-provider/preparation.go",
      "status": "added",
      "additions": 223,
      "deletions": 0,
      "changes": 223,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -0,0 +1,223 @@\n+//go:build linux\n+\n+package main\n+\n+import (\n+\t\"context\"\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"time\"\n+\n+\t\"github.com/MiniMax-AI/OpenAgentCore/services/core/internal/sandbox\"\n+\t\"github.com/google/uuid\"\n+\tsdk \"github.com/superradcompany/microsandbox/sdk/go\"\n+)\n+\n+// The preparation cache keeps one archive of the prepared /environment\n+// directories per Core-supplied key, image digest and workspace mode in a private\n+// directory under the Runtime home. The guest never sees it. An entry is valid\n+// for preparationTTL after its save.\n+const preparationTTL = 24 * time.Hour\n+\n+// preparedDirectories are what preparation writes, as created by the bootstrap.\n+// runtime-state belongs to the running daemon and is never copied.\n+var preparedDirectories = []string{\"initialization\", \"packages\", \"workspace\"}\n+\n+// The store holds at most this many bytes. A measured Environment archive is\n+// tens of MiB, so this keeps over a hundred of them and bounds the node's disk\n+// use; the TTL alone does not, because a busy node can save many keys in a day.\n+const maxPreparationBytes = 8 << 30\n+\n+// The guest archive lives on the root disk, outside /environment, so it is\n+// never part of the archive it carries.\n+const guestArchive = \"/tmp/oac-preparation.tar\"\n+\n+func (b backend) preparationStore() string {\n+\treturn filepath.Join(b.q.Config.RuntimeHome, \"preparation\")\n+}\n+\n+// preparationEntry names the archive for this key, scoped by the Runtime image\n+// digest and by whether /environment is an owned disk or an external directory.\n+func (b backend) preparationEntry() string {\n+\t_, digest, _ := strings.Cut(b.q.Config.Image, \"@\")\n+\tsum := sha256.Sum256([]byte(fmt.Sprintf(\"%s|%t|%s\", digest, b.q.Config.ExternalWorkspace, b.q.Key)))\n+\treturn filepath.Join(b.preparationStore(), hex.EncodeToString(sum[:])+\".tar\")\n+}\n+\n+func validPreparation(path string, now time.Time) bool {\n+\tst, err := os.Lstat(path)\n+\treturn err == nil && st.Mode().IsRegular() && now.Sub(st.ModTime()) < preparationTTL\n+}\n+\n+// preparationSandbox connects to the running compute and returns the host\n+// directory behind /environment, which is empty when the disk is owned.\n+func (b backend) preparationSandbox(ctx context.Context) (*sdk.Sandbox, string, error) {\n+\th, _, err := b.inspect(ctx, b.q.Compute)\n+\tif err != nil {\n+\t\treturn nil, \"\", err\n+\t}\n+\tlive, err := h.Connect(ctx)\n+\tif err != nil {\n+\t\treturn nil, \"\", err\n+\t}\n+\tvar config sdk.SandboxConfig\n+\tif b.q.Config.ExternalWorkspace && (json.Unmarshal([]byte(h.ConfigJSON()), &config) != nil || config.Labels[workspacePathLabel] == \"\") {\n+\t\tlive.Detach(context.Background())\n+\t\treturn nil, \"\", sandbox.ErrInvalid\n+\t}\n+\treturn live, config.Labels[workspacePathLabel], nil\n+}\n+\n+func guestRun(ctx context.Context, live *sdk.Sandbox, script string) error {\n+\tresult, err := runCommand(ctx, live, sandbox.Command{Args: []string{\"/bin/sh\", \"-c\", script}, Directory: \"/\"}, \"0:0\")\n+\tif err == nil && result.ExitCode != 0 {\n+\t\terr = errors.New(\"preparation command failed\")\n+\t}\n+\treturn err\n+}\n+\n+// hostTar copies the SDK's ownership xattrs of an external directory verbatim,\n+// so the helper never interprets them.\n+func hostTar(ctx context.Context, stdin *os.File, args ...string) error {\n+\tcmd := exec.CommandContext(ctx, \"tar\", append([]string{\"--xattrs\", \"--xattrs-include=*\"}, args...)...)\n+\tif stdin != nil {\n+\t\tcmd.Stdin = stdin\n+\t}\n+\treturn cmd.Run()\n+}\n+\n+func (b backend) restorePreparation(ctx context.Context) (bool, error) {\n+\tentry := b.preparationEntry()\n+\tif !validPreparation(entry, time.Now()) {\n+\t\treturn false, nil\n+\t}\n+\tctx, cancel := context.WithDeadline(ctx, b.q.Deadline)\n+\tdefer cancel()\n+\tlive, external, err := b.preparationSandbox(ctx)\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\tdefer live.Detach(context.Background())\n+\tif b.q.Config.ExternalWorkspace {\n+\t\t// The running guest sees the extracted files at once.\n+\t\tf, err := os.Open(entry)\n+\t\tif err != nil {\n+\t\t\treturn false, nil\n+\t\t}\n+\t\tdefer f.Close()\n+\t\terr = hostTar(ctx, f, \"-C\", external, \"-xf\", \"-\")\n+\t} else {\n+\t\tdefer b.removeGuestArchive(live)\n+\t\t// Nothing in /environment has changed until the extraction starts.\n+\t\tif live.FS().CopyFromHost(ctx, entry, guestArchive) != nil {\n+\t\t\treturn false, nil\n+\t\t}\n+\t\terr = guestRun(ctx, live, \"tar --xattrs --numeric-owner -C /environment -xf \"+guestArchive+\" && sync\")\n+\t}\n+\tif err != nil {\n+\t\t// A failed extraction fails this Session; later Sessions prepare in full.\n+\t\t_ = os.Remove(entry)\n+\t}\n+\treturn err == nil, err\n+}\n+\n+func (b backend) removeGuestArchive(live *sdk.Sandbox) {\n+\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n+\tdefer cancel()\n+\t_ = guestRun(ctx, live, \"rm -f \"+guestArchive)\n+}\n+\n+func (b backend) savePreparation(ctx context.Context) error {\n+\tctx, cancel := context.WithDeadline(ctx, b.q.Deadline)\n+\tdefer cancel()\n+\tlive, external, err := b.preparationSandbox(ctx)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tdefer live.Detach(context.Background())\n+\tstore := b.preparationStore()\n+\tif err = privateDirectory(store); err != nil {\n+\t\treturn err\n+\t}\n+\t// The temporary name does not exist yet, so a copy from the guest creates it.\n+\ttemporary := filepath.Join(store, \".tmp-\"+uuid.NewString())\n+\tdefer os.Remove(temporary)\n+\tif b.q.Config.ExternalWorkspace {\n+\t\tif err = guestRun(ctx, live, \"sync\"); err == nil {\n+\t\t\terr = hostTar(ctx, nil, append([]string{\"-C\", external, \"-cf\", temporary}, preparedDirectories...)...)\n+\t\t}\n+\t} else {\n+\t\tdefer b.removeGuestArchive(live)\n+\t\tif err = guestRun(ctx, live, \"sync && tar --xattrs --numeric-owner -C /environment -cf \"+guestArchive+\" \"+strings.Join(preparedDirectories, \" \")); err == nil {\n+\t\t\terr = live.FS().CopyToHost(ctx, guestArchive, temporary)\n+\t\t}\n+\t}\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tf, err := os.OpenFile(temporary, os.O_RDWR, 0)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\terr = f.Sync()\n+\tif closeErr := f.Close(); err == nil {\n+\t\terr = closeErr\n+\t}\n+\tif err == nil {\n+\t\terr = os.Chmod(temporary, 0600)\n+\t}\n+\tif err == nil {\n+\t\terr = os.Rename(temporary, b.preparationEntry())\n+\t}\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\t_ = prunePreparations(store, time.Now())\n+\treturn syncDirectory(store)\n+}\n+\n+// prunePreparations deletes expired entries, then the oldest while the store is\n+// over its bound.\n+func prunePreparations(store string, now time.Time) error {\n+\tentries, err := os.ReadDir(store)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\ttype kept struct {\n+\t\tpath     string\n+\t\tsize     int64\n+\t\tmodified time.Time\n+\t}\n+\tvar live []kept\n+\tvar total int64\n+\tfor _, entry := range entries {\n+\t\tinfo, err := entry.Info()\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tpath := filepath.Join(store, entry.Name())\n+\t\tif now.Sub(info.ModTime()) >= preparationTTL {\n+\t\t\t_ = os.Remove(path)\n+\t\t\tcontinue\n+\t\t}\n+\t\tlive = append(live, kept{path, info.Size(), info.ModTime()})\n+\t\ttotal += info.Size()\n+\t}\n+\tsort.Slice(live, func(i, j int) bool { return live[i].modified.Before(live[j].modified) })\n+\tfor _, entry := range live {\n+\t\tif total <= maxPreparationBytes {\n+\t\t\tbreak\n+\t\t}\n+\t\t_ = os.Remove(entry.path)\n+\t\ttotal -= entry.size\n+\t}\n+\treturn nil\n+}"
    },
    {
      "sha": "096ccde3eb123728ac031661f521513f599f59c0",
      "filename": "services/core/tools/microsandbox-provider/preparation_test.go",
      "status": "added",
      "additions": 35,
      "deletions": 0,
      "changes": 35,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation_test.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/c2ed21de2e3e0715dd6d382bee71188d7b365313/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation_test.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Ftools%2Fmicrosandbox-provider%2Fpreparation_test.go?ref=c2ed21de2e3e0715dd6d382bee71188d7b365313",
      "patch": "@@ -0,0 +1,35 @@\n+//go:build linux\n+\n+package main\n+\n+import (\n+\t\"context\"\n+\t\"os\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\twire \"github.com/MiniMax-AI/OpenAgentCore/services/core/internal/sandbox/microsandbox\"\n+)\n+\n+func TestExpiredPreparationIsNotRestored(t *testing.T) {\n+\tb := backend{q: wire.Request{Config: wire.Config{RuntimeHome: t.TempDir(), Image: \"image@sha256:\" + strings.Repeat(\"a\", 64)}, Key: strings.Repeat(\"b\", 64), Deadline: time.Now().Add(time.Minute)}}\n+\tif err := privateDirectory(b.preparationStore()); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tentry := b.preparationEntry()\n+\tif err := os.WriteFile(entry, []byte(\"archive\"), 0600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !validPreparation(entry, time.Now()) {\n+\t\tt.Fatal(\"fresh entry rejected\")\n+\t}\n+\told := time.Now().Add(-preparationTTL - time.Minute)\n+\tif err := os.Chtimes(entry, old, old); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t// An expired entry returns before the helper touches any compute.\n+\tif restored, err := b.restorePreparation(context.Background()); restored || err != nil {\n+\t\tt.Fatal(restored, err)\n+\t}\n+}"
    }
  ]
}
