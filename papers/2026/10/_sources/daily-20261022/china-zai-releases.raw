"enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"hobby-abuse-scan","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"dashboard-inbox","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false}],"isAtlas":false,"googleFontsInlined":false},"customCss":[{"filePath":"style.css","content":"#footer div:last-child{display:none}.md\\:h-10{height:3rem}.prose-dark :where(a):not(:where([class~=not-prose],[class~=not-prose] *)),.prose-dark :where(strong):not(:where([class~=not-prose],[class~=not-prose] *)){font-weight:900}"}],"page":{"pagePath":"release-notes/new-released","slug":"/release-notes/new-released","pageMetadata":{"title":"New Released","description":"Follow along with updates across Z.AI’s models","href":"/release-notes/new-released"},"description":{"compiledSource":"\"use strict\";\nconst {jsx: _jsx} = arguments[0];\nconst {useMDXComponents: _provideComponents} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    p: \"p\",\n    ..._provideComponents(),\n    ...props.components\n  };\n  return _jsx(_components.p, {\n    children: \"Follow along with updates across Z.AI’s models\"\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = {\n    ..._provideComponents(),\n    ...props.components\n  };\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","frontmatter":{},"scope":{}},"pageType":"default","mdx":{"mdxSource":{"compiledSource":"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,li:`li`,p:`p`,ul:`ul`,..._provideComponents(),...props.components},{Heading,Update}=_components;if(!Heading)_missingMdxReference(`Heading`,true);if(!Update)_missingMdxReference(`Update`,true);return _jsxs(_Fragment,{children:[_jsx(Heading,{level:`2`,id:`models`,children:`Models`}),`\n`,_jsx(Update,{label:`2026-08-26`,description:`  GLM-5.3-Flash`,id:`2026-08-26`,children:_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Native visual capabilities enable the model to observe interfaces, rendering results, and interaction feedback—creating a closed loop across code, browsers, and GUIs.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Efficient hybrid architecture: Combines linear and sparse attention with 320B total parameters and 18B activated, significantly reducing compute and KV-cache requirements.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Beyond coding: Supports office document and financial research workflows, autonomously breaking down goals, using tools, and refining outputs. Learn more in our `,_jsx(_components.a,{href:`/guides/vlm/glm-5.3-flash`,children:`documentation`}),`.*`]}),`\n`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2026-08-18`,description:`  GLM-5.3`,id:`2026-08-18`,children:_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Stronger Coding Capabilities: GLM-5.3 delivers a significant improvement in coding capabilities, achieving a 50% gain over GLM-5.2 on Z.ai Code Bench and reaching state-of-the-art (SOTA) performance among open-source models on public benchmarks, including Terminal Bench 3.0.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Emergent Cybersecurity Capabilities: GLM-5.3 matches Mythos 5 in white-box code review and vulnerability discovery. In collaboration with multiple cybersecurity teams, it has been tested on real-world targets and has identified a total of 2,436 vulnerabilities, including 1,097 medium- and high-severity vulnerabilities.Learn more in our `,_jsx(_components.a,{href:`https://docs.z.ai/guides/llm/glm-5.3`,children:`documentation`}),`.*`]}),`\n`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2026-06-16`,description:`  GLM-5.2`,id:`2026-06-16`,children:_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Supports 1M lossless context, significantly improving long-horizon task capabilities and reducing context drift and goal forgetting in complex tasks`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Achieves open-source SOTA performance on coding and long-horizon task benchmarks, delivering more stable results in complex system engineering and deep debugging`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Significantly improves the real-world developer experience, with more reliable project-level context handling, adherence to engineering standards, and multi-platform development. Learn more in our `,_jsx(_components.a,{href:`/guides/llm/glm-5.2`,children:`documentation`}),`.*`]}),`\n`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2026-04-07`,description:`  GLM-5.1`,id:`2026-04-07`,children:_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Designed for long-horizon tasks, GLM-5.1 can work independently for up to 8 hours in a single run, enabling a full loop from planning and execution to iterative refinement and final delivery.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`It demonstrates stronger engineering intelligence across autonomous planning, sustained execution, bug fixing, and strategy iteration, while achieving comprehensive capability alignment with Claude Opus 4.6. Built with multi-turn SFT, RL, and a process-quality evaluation framework, GLM-5.1 further improves stability, consistency, and tool use over extended tasks. Learn more in our `,_jsx(_components.a,{href:`/guides/llm/glm-5.1`,children:`documentation`}),`.*`]}),`\n`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2026-02-12`,description:`  GLM-5`,id:`2026-02-12`,children:_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Designed for complex system engineering and long-range Agent tasks, GLM-5 shifts the paradigm from coding to engineering, demonstrating strong deep-reasoning performance in backend architecture, complex algorithms, and stubborn bug fixing.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`It directly benchmarks against Claude Opus 4.5 in code-logic density and systems-engineering capability, and integrates DeepSeek Sparse Attention for higher token efficiency while preserving long-context quality.Learn more in our `,_jsx(_components.a,{href:`/guides/llm/glm-5`,children:`documentation`}),`.*`]}),`\n`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2026-01-14`,description:`  GLM-Image`,id:`2026-01-14`,children:_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`We’ve launched GLM-Image, a state-of-the-art image generation model built on a multimodal architecture and fully trained on domestic chips, combining autoregressive semantic understanding with diffusion-based decoding to deliver high-quality, controllable visual generation.`}),`\n`,_jsxs(_components.li,{children:[`The update significantly enhances performance in knowledge-intensive scenarios, with more stable and accurate text rendering inside images, making GLM-Image especially well suited for commercial design, educational illustrations, and content-rich visual applications.Learn more in our `,_jsx(_components.a,{href:`/guides/image/glm-image`,children:`documentation`}),`.*`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2025-12-22`,description:`  GLM-4.7`,id:`2025-12-22`,children:_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`We’ve released GLM-4.7, our foundation model with significant improvements in coding, reasoning, and agentic capabilities. It delivers more reliable code generation, stronger long-context understanding, and improved end-to-end task execution across real-world development workflows.`}),`\n`,_jsxs(_components.li,{children:[`The update brings open-source SOTA performance on major coding and reasoning benchmarks, enhanced agentic coding for goal-driven, multi-step tasks, and improved front-end and document generation quality. Learn more in our `,_jsx(_components.a,{href:`/guides/llm/glm-4.7`,children:`documentation`}),`.*`]}),`\n`]})}),`\n`,_jsx(Update,{label:`2025-09-30`,description:`  GLM-4.6`,id:`2025-09-30`,children:_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`We’ve launched GLM-4.6, the flagship coding model, showcasing enhanced performance in both public benchmarks and real-world programming tasks, making it the leading coding model in China.`}),`\n`,_jsxs(_components.li,{children:[`The update also expands the context window to 200K, improving its ability to handle longer code and complex agent tasks. Learn more in our `,_jsx(_components.a,{href:`/guides/llm/glm-4.6`,children:`documentation`}),`.*`]}),`\n`]})})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}","frontmatter":{},"scope":{"config":{},"pageMetadata":{"title":"New Released","description":"Follow along with updates across Z.AI’s models","href":"/release-notes/new-released"}}},"mdxSourceWithNoJs":null},"mdxExtracts":{"tableOfContents":[{"title":"Models","slug":"models","depth":2,"children":[]},{"title":"2026-08-26","slug":"2026-08-26","depth":1,