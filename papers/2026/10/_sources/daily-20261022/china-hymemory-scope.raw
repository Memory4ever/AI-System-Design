  "files": [
    {
      "sha": "f82a0b79cf25b52e3224998c69e47ca3af1b9a5d",
      "filename": "hy_memory/pipelines/_retrieval/intention.py",
      "status": "modified",
      "additions": 20,
      "deletions": 5,
      "changes": 25,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/514bf5c47bc22cc211a16990ec2908e6f62d6a21/hy_memory%2Fpipelines%2F_retrieval%2Fintention.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/514bf5c47bc22cc211a16990ec2908e6f62d6a21/hy_memory%2Fpipelines%2F_retrieval%2Fintention.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/hy_memory%2Fpipelines%2F_retrieval%2Fintention.py?ref=514bf5c47bc22cc211a16990ec2908e6f62d6a21",
      "patch": "@@ -10,8 +10,8 @@\n     节点的 layer 改写为 l2_fact（持久化 update_payload），并从意图结果里剔除——\n     过期意图变成普通历史事实，下次走 normal 召回；\n   - **判重（重点）**：对幸存意图按下述规则分组，同组只留一条本次返回：\n-        同 user_id + 同一天 memory_at + valid_until 相同（都为 None 或都相等）\n-        + cosine 相似度 ≥ MEMORY_DEDUP_THRESHOLD (默认 0.95)\n+        同 user_id + 同 agent_id + 同一天 memory_at + valid_until 相同\n+        （都为 None 或都相等）+ cosine 相似度 ≥ MEMORY_DEDUP_THRESHOLD (默认 0.95)\n     → 视为同一个意图的复本（extractor 复读机 / 多 session 重复表达）。\n     保留组里 `gmt_created` 最早的（老的先来先得，稳定 id）；\n   - **异步删库**：其余复本 fire-and-forget 从 VDB 删除，不影响本次调用 RT。\n@@ -112,11 +112,19 @@ def _partition_duplicates(\n     if len(hits) < 2:\n         return list(hits), []\n \n-    # 1. 按 (memory_at day, valid_until day) 分桶\n-    buckets: Dict[Tuple[Any, Any], List[int]] = {}\n+    # 1. 按 (user_id, agent_id, memory_at day, valid_until day) 分桶。\n+    #    user_id / agent_id 必须进键：多用户检索时不同用户的同一天意图可能\n+    #    文本、日期都相同，但它们是两个独立的租户数据；只按日期分桶会把其中\n+    #    一个判成复本并硬删除。\n+    buckets: Dict[Tuple[Any, Any, Any, Any], List[int]] = {}\n     for idx, h in enumerate(hits):\n         node = h.get(\"node\")\n-        key = (_memory_at_day(node), _valid_until_key(node))\n+        key = (\n+            getattr(node, \"user_id\", None) if node else None,\n+            getattr(node, \"agent_id\", None) if node else None,\n+            _memory_at_day(node),\n+            _valid_until_key(node),\n+        )\n         buckets.setdefault(key, []).append(idx)\n \n     def _gmt(h: Dict[str, Any]) -> float:\n@@ -229,6 +237,8 @@ async def recall_intentions(\n     *,\n     user_ids: Optional[List[str]] = None,\n     agent_ids: Optional[List[str]] = None,\n+    isolation_key: str = \"\",\n+    isolation_keys: Optional[List[str]] = None,\n     limit: int = 10,\n     now: Optional[datetime] = None,\n     stats_out: Optional[Dict[str, Any]] = None,\n@@ -243,6 +253,9 @@ async def recall_intentions(\n         query_embedding: 查询向量\n         user_ids: 用户隔离（单/多用户）\n         agent_ids: 可选 agent 过滤\n+        isolation_key / isolation_keys: 精确的 (user, agent, session) 隔离键。\n+            与其它召回通道一致：调用方在按 session 过滤时只生成这两项，\n+            user_ids / agent_ids 为 None；不把它们透传下去就会退化成全库检索。\n         limit: 召回上限（返回给上游的条数）\n         now: 当前时间（默认 datetime.now()，测试可注入）\n         stats_out: 可选 dict，本函数把分段耗时与数量**原地回填**进去，供调用方落\n@@ -283,6 +296,8 @@ def _stat(**kv: Any) -> None:\n             query_embedding=query_embedding,\n             user_ids=user_ids or None,\n             agent_ids=agent_ids,\n+            isolation_key=isolation_key,\n+            isolation_keys=isolation_keys,\n             layers=[MemoryLayer.L7_INTENTION],\n             limit=fetch_limit,\n             score_threshold=0.0,  # intention 不设语义门槛"
    },
    {
      "sha": "5a5180b342d8d4a65e7702bbdf955d88e7c58bc2",
      "filename": "hy_memory/pipelines/reader_base.py",
      "status": "modified",
      "additions": 2,
      "deletions": 0,
      "changes": 2,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/514bf5c47bc22cc211a16990ec2908e6f62d6a21/hy_memory%2Fpipelines%2Freader_base.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/514bf5c47bc22cc211a16990ec2908e6f62d6a21/hy_memory%2Fpipelines%2Freader_base.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/hy_memory%2Fpipelines%2Freader_base.py?ref=514bf5c47bc22cc211a16990ec2908e6f62d6a21",
      "patch": "@@ -1840,6 +1840,8 @@ async def _read_once(\n                     query_embedding,\n                     user_ids=isolation_params.get(\"user_ids\"),\n                     agent_ids=isolation_params.get(\"agent_ids\"),\n+                    isolation_key=isolation_params.get(\"isolation_key\") or \"\",\n+                    isolation_keys=isolation_params.get(\"isolation_keys\"),\n                     limit=request.intention_limit,\n                     stats_out=_intent_stats,\n                     include_sources=request.include_sources,"
    },
    {
      "sha": "89d5bce3f7790540e7e0b3ba57b28633004cad2e",
      "filename": "tests/test_intention_dedup.py",
      "status": "modified",
      "additions": 107,
      "deletions": 0,
      "changes": 107,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/514bf5c47bc22cc211a16990ec2908e6f62d6a21/tests%2Ftest_intention_dedup.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/514bf5c47bc22cc211a16990ec2908e6f62d6a21/tests%2Ftest_intention_dedup.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_intention_dedup.py?ref=514bf5c47bc22cc211a16990ec2908e6f62d6a21",
      "patch": "@@ -97,6 +97,8 @@ async def search(\n         self,\n         *,\n         query_embedding=None,\n+        isolation_key: str = \"\",\n+        isolation_keys=None,\n         user_ids=None,\n         agent_ids=None,\n         layers=None,\n@@ -110,6 +112,12 @@ async def search(\n         for nid, n in self._nodes.items():\n             if layers and n.layer not in layers:\n                 continue\n+            if isolation_keys:\n+                if n.get_isolation_key() not in isolation_keys:\n+                    continue\n+            elif isolation_key:\n+                if n.get_isolation_key() != isolation_key:\n+                    continue\n             if user_ids and n.user_id not in user_ids:\n                 continue\n             if agent_ids and n.agent_id not in agent_ids:\n@@ -256,6 +264,50 @@ def test_partition_duplicates_different_valid_until_keeps_both():\n     assert delete_ids == []\n \n \n+def test_partition_duplicates_different_users_keeps_both():\n+    \"\"\"不同用户的同一天、同意图文本不能被判为复本（更不能硬删他人数据）。\"\"\"\n+    same_ma = datetime(2025, 8, 6)\n+    same_vu = datetime(2025, 8, 8)\n+    alice = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"alice\", memory_at=same_ma, valid_until=same_vu,\n+        gmt_created=datetime(2025, 8, 1),\n+    )\n+    bob = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"bob\", memory_at=same_ma, valid_until=same_vu,\n+        gmt_created=datetime(2025, 8, 2),\n+    )\n+    hits = [\n+        {\"node_id\": alice.node_id, \"node\": alice, \"score\": 0.9},\n+        {\"node_id\": bob.node_id, \"node\": bob, \"score\": 0.9},\n+    ]\n+    kept, delete_ids = _partition_duplicates(hits, threshold=0.95)\n+    assert {h[\"node_id\"] for h in kept} == {alice.node_id, bob.node_id}\n+    assert delete_ids == []\n+\n+\n+def test_partition_duplicates_different_agents_keeps_both():\n+    \"\"\"同 user 下不同 agent 的意图也属于不同作用域，不能互相覆盖。\"\"\"\n+    same_ma = datetime(2025, 8, 6)\n+    same_vu = datetime(2025, 8, 8)\n+    a1 = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"u1\", agent_id=\"agent_a\",\n+        memory_at=same_ma, valid_until=same_vu,\n+        gmt_created=datetime(2025, 8, 1),\n+    )\n+    a2 = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"u1\", agent_id=\"agent_b\",\n+        memory_at=same_ma, valid_until=same_vu,\n+        gmt_created=datetime(2025, 8, 2),\n+    )\n+    hits = [\n+        {\"node_id\": a1.node_id, \"node\": a1, \"score\": 0.9},\n+        {\"node_id\": a2.node_id, \"node\": a2, \"score\": 0.9},\n+    ]\n+    kept, delete_ids = _partition_duplicates(hits, threshold=0.95)\n+    assert {h[\"node_id\"] for h in kept} == {a1.node_id, a2.node_id}\n+    assert delete_ids == []\n+\n+\n def test_partition_duplicates_low_cosine_keeps_both():\n     \"\"\"content 不同（cosine 低）→ 不判重，即使 memory_at / valid_until 同。\"\"\"\n     same_ma = datetime(2025, 8, 6)\n@@ -368,6 +420,61 @@ def test_recall_intentions_dedup_and_async_delete_end_to_end():\n     assert set(vs.delete_calls) == {p_ids[1], p_ids[2]}\n \n \n+def test_recall_intentions_forwards_isolation_keys():\n+    \"\"\"session 过滤路径只生成 isolation_keys；intention 必须原样透传给 VDB。\"\"\"\n+\n+    class _RecordingStore:\n+        def __init__(self):\n+            self.kwargs = None\n+\n+        async def search(self, **kwargs):\n+            self.kwargs = kwargs\n+            return []\n+\n+    vs = _RecordingStore()\n+    _run(recall_intentions(\n+        vs, [0.0], isolation_keys=[\"u1::a1::s1\"], limit=5,\n+    ))\n+    assert vs.kwargs[\"isolation_keys\"] == [\"u1::a1::s1\"]\n+    assert vs.kwargs[\"user_ids\"] is None\n+    assert vs.kwargs[\"agent_ids\"] is None\n+\n+    vs2 = _RecordingStore()\n+    _run(recall_intentions(\n+        vs2, [0.0], isolation_key=\"u1::a1::s1\", limit=5,\n+    ))\n+    assert vs2.kwargs[\"isolation_key\"] == \"u1::a1::s1\"\n+\n+\n+def test_recall_intentions_isolation_keys_prevent_cross_user_leak():\n+    \"\"\"带 isolation_keys 时只能召回该作用域的意图，且不会误删其他用户。\"\"\"\n+    vs = _FakeVectorStore()\n+    emb = _FakeEmbedByHash(dims=32)\n+    ma = datetime(2025, 8, 6)\n+    vu = datetime(2025, 8, 8)\n+\n+    alice = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"u1\", dims=32,\n+        memory_at=ma, valid_until=vu,\n+        embedding=emb.vec_for(\"用户明天要开会\"),\n+    )\n+    bob = _make_intention_node(\n+        \"用户明天要开会\", user_id=\"u2\", dims=32,\n+        memory_at=ma, valid_until=vu,\n+        embedding=emb.vec_for(\"用户明天要开会\"),\n+    )\n+    _run(vs.upsert(alice))\n+    _run(vs.upsert(bob))\n+\n+    hits = _run(recall_intentions(\n+        vs, emb.vec_for(\"用户明天要开会\"),\n+        isolation_keys=[\"u1::a1::s1\"], limit=10,\n+        now=datetime(2025, 8, 6, 12, 0),\n+    ))\n+    assert {h[\"node_id\"] for h in hits} == {alice.node_id}\n+    assert vs.delete_calls == []\n+\n+\n def test_recall_intentions_different_valid_until_all_returned():\n     \"\"\"两个 memory_at 相同、valid_until 不同的意图 → 都召回，都不删。\"\"\"\n     vs = _FakeVectorStore()"
    }
  ]
}
