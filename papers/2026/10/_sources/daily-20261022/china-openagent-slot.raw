      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/d893afb85247995ca057467c0f7c2832e9ae2f85/services%2Fcore%2Finternal%2Fdeployment%2Fplacement%2Fplacement.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/d893afb85247995ca057467c0f7c2832e9ae2f85/services%2Fcore%2Finternal%2Fdeployment%2Fplacement%2Fplacement.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fdeployment%2Fplacement%2Fplacement.go?ref=d893afb85247995ca057467c0f7c2832e9ae2f85",
      "patch": "@@ -86,11 +86,12 @@ type Node struct {\n \tID                   string\n \tOnline, ServingReady bool\n \t// ReadyGeneration is nil until the node serves a generation.\n-\tReadyGeneration        *uint64\n-\tTargetState            string\n-\tActive, Retained       int64\n-\tMaxActive, MaxRetained int\n-\tCoreURL                string\n+\tReadyGeneration *uint64\n+\tTargetState     string\n+\t// Reserved counts placements still waiting for their sandbox; Active includes them.\n+\tActive, Retained, Reserved int64\n+\tMaxActive, MaxRetained     int\n+\tCoreURL                    string\n }\n \n // Placement is the node and generation a new Session's Environment reserves."
    },
    {
      "sha": "018e69d794a2235cc23fd0ba6a700f1b58a6bfbc",
      "filename": "services/core/internal/deployment/suspension_pressure.go",
      "status": "modified",
      "additions": 4,
      "deletions": 2,
      "changes": 6,
      "blob_url": "https://github.com/MiniMax-AI/OpenAgentCore/blob/d893afb85247995ca057467c0f7c2832e9ae2f85/services%2Fcore%2Finternal%2Fdeployment%2Fsuspension_pressure.go",
      "raw_url": "https://github.com/MiniMax-AI/OpenAgentCore/raw/d893afb85247995ca057467c0f7c2832e9ae2f85/services%2Fcore%2Finternal%2Fdeployment%2Fsuspension_pressure.go",
      "contents_url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/contents/services%2Fcore%2Finternal%2Fdeployment%2Fsuspension_pressure.go?ref=d893afb85247995ca057467c0f7c2832e9ae2f85",
      "patch": "@@ -47,10 +47,12 @@ func fullNode(pressure SuspensionDemand, owner Allocation) *placement.Node {\n \n // canKeepFreeSlot allows suspending an allocation that stayed idle for\n // freeSlotIdle on a full node with no reclamation in flight. The node must\n-// also have a free retained slot, or the freed active slot admits no Session.\n+// also have a free retained slot, or the freed active slot admits no Session,\n+// and no placed Session waiting for its sandbox, which the node's lane would\n+// otherwise create only after this suspension.\n func canKeepFreeSlot(pressure SuspensionDemand, owner Allocation) bool {\n \tn := fullNode(pressure, owner)\n-\treturn n != nil && n.Retained < int64(n.MaxRetained) && !slices.Contains(pressure.InFlightNodes, owner.NodeID)\n+\treturn n != nil && n.Retained < int64(n.MaxRetained) && n.Reserved == 0 && !slices.Contains(pressure.InFlightNodes, owner.NodeID)\n }\n \n // canSuspendForDemand reports whether compatible waiting demand would place on"
    },
    {
      "sha": "6b90cb4a21860e8af1fa18a3007077162cbba6de",
      "filename": "services/core/internal/persistence/postgres/deploymentpg/suspension_pressure_test.go",
      "status": "modified",
