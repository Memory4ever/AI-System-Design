  {
    "sha": "a449ab75201e36a6ea9ba0510631c4e2b92bd692",
    "node_id": "C_kwDOUjI7ptoAKGE0NDlhYjc1MjAxZTM2YTZlYTliYTA1MTA2MzFjNGUyYjkyYmQ2OTI",
    "commit": {
      "author": {
        "name": "SaladDay",
        "email": "1203511142@qq.com",
        "date": "2026-10-21T13:50:25Z"
      },
      "committer": {
        "name": "GitHub",
        "email": "noreply@github.com",
        "date": "2026-10-21T13:50:25Z"
      },
      "message": "Keep a free slot on full nodes (#810)\n\n* Keep a free slot on full nodes\n\n* Give the free-slot inactivity its own limits row\n\n* Keep a free slot only where a Session can use it\n\nThe freed active slot admits no Session when the node's retained slots are\nfull, so the free-slot rule now also needs a free retained slot. SetCompute\nloads the suspension demand once for both checks.",
      "tree": {
        "sha": "6c402ff59efb54efd10efbd7cfe3cb107ec2fa86",
        "url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/git/trees/6c402ff59efb54efd10efbd7cfe3cb107ec2fa86"
      },
      "url": "https://api.github.com/repos/MiniMax-AI/OpenAgentCore/git/commits/a449ab75201e36a6ea9ba0510631c4e2b92bd692",
      "comment_count": 0,
      "verification": {
        "verified": true,
        "reason": "valid",
