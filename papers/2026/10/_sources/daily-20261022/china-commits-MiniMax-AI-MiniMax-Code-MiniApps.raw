    "parents": [
      {
        "sha": "0c187f399c430219cbb6ce93ecddfd45df29a735",
        "url": "https://api.github.com/repos/MiniMax-AI/MiniMax-Code-MiniApps/commits/0c187f399c430219cbb6ce93ecddfd45df29a735",
