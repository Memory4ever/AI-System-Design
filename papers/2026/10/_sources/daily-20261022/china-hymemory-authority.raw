      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/hy_memory%2Fdata%2Fcache_mysql.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/hy_memory%2Fdata%2Fcache_mysql.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -81,6 +81,21 @@\n     )\n     \"\"\",\n     \"\"\"\n+    CREATE TABLE IF NOT EXISTS write_outcomes (\n+        request_id VARCHAR(256) NOT NULL,\n+        user_id    VARCHAR(255) NOT NULL,\n+        agent_id   VARCHAR(255) NOT NULL DEFAULT '',\n+        session_id VARCHAR(255) NOT NULL DEFAULT '',\n+        operation  VARCHAR(32) NOT NULL,\n+        status     VARCHAR(32) NOT NULL,\n+        result_json LONGTEXT NOT NULL,\n+        created_at VARCHAR(64) NOT NULL,\n+        updated_at VARCHAR(64) NOT NULL,\n+        PRIMARY KEY (request_id),\n+        KEY idx_write_outcomes_owner (user_id, agent_id, session_id)\n+    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4\n+    \"\"\",\n+    \"\"\"\n     CREATE TABLE IF NOT EXISTS system_metrics (\n         minute_ts   VARCHAR(32) NOT NULL,\n         data        LONGTEXT NOT NULL,\n@@ -459,6 +474,62 @@ async def get_pipeline_logs(\n             logger.warning(f\"get_pipeline_logs failed: {e}\")\n             return []\n \n+    async def claim_write_outcome(\n+        self,\n+        request_id: str,\n+        user_id: str,\n+        agent_id: str,\n+        session_id: str,\n+        operation: str,\n+    ) -> Optional[Dict[str, Any]]:\n+        now = datetime.now().isoformat()\n+        inserted = await self._execute(\n+            \"\"\"\n+            INSERT IGNORE INTO write_outcomes (\n+                request_id, user_id, agent_id, session_id, operation,\n+                status, result_json, created_at, updated_at\n+            ) VALUES (%s, %s, %s, %s, %s, 'running', '{}', %s, %s)\n+            \"\"\",\n+            (request_id, user_id, agent_id, session_id, operation, now, now),\n+        )\n+        if inserted == 1:\n+            return None\n+        return await self.get_write_outcome(request_id)\n+\n+    async def finish_write_outcome(\n+        self,\n+        request_id: str,\n+        status: str,\n+        result: Dict[str, Any],\n+    ) -> bool:\n+        updated = await self._execute(\n+            \"\"\"\n+            UPDATE write_outcomes\n+            SET status = %s, result_json = %s, updated_at = %s\n+            WHERE request_id = %s\n+            \"\"\",\n+            (\n+                status,\n+                json.dumps(result, ensure_ascii=False, default=str),\n+                datetime.now().isoformat(),\n+                request_id,\n+            ),\n+        )\n+        return updated == 1\n+\n+    async def get_write_outcome(self, request_id: str) -> Optional[Dict[str, Any]]:\n+        row = await self._fetchone(\n+            \"SELECT * FROM write_outcomes WHERE request_id = %s\",\n+            (request_id,),\n+        )\n+        if row is None:\n+            return None\n+        try:\n+            row[\"result\"] = json.loads(row.pop(\"result_json\") or \"{}\")\n+        except (TypeError, json.JSONDecodeError):\n+            row[\"result\"] = {}\n+        return row\n+\n     # ================================================================\n     # System Metrics（分钟粒度落盘）\n     # ================================================================"
    },
    {
      "sha": "3cca357f701b15e373164cf3a05746d4ec17dce2",
      "filename": "hy_memory/data/cache_sqlite.py",
      "status": "modified",
      "additions": 96,
      "deletions": 0,
      "changes": 96,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/hy_memory%2Fdata%2Fcache_sqlite.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/hy_memory%2Fdata%2Fcache_sqlite.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/hy_memory%2Fdata%2Fcache_sqlite.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -87,6 +87,20 @@ async def _run_in_sqlite_pool(func, *args, **kwargs):\n CREATE INDEX IF NOT EXISTS idx_plog_request ON pipeline_logs_v2(request_id);\n CREATE INDEX IF NOT EXISTS idx_plog_user    ON pipeline_logs_v2(user_id);\n \n+CREATE TABLE IF NOT EXISTS write_outcomes (\n+    request_id   TEXT PRIMARY KEY,\n+    user_id      TEXT NOT NULL,\n+    agent_id     TEXT NOT NULL DEFAULT '',\n+    session_id   TEXT NOT NULL DEFAULT '',\n+    operation    TEXT NOT NULL,\n+    status       TEXT NOT NULL,\n+    result_json  TEXT NOT NULL DEFAULT '{}',\n+    created_at   TEXT NOT NULL,\n+    updated_at   TEXT NOT NULL\n+);\n+CREATE INDEX IF NOT EXISTS idx_write_outcomes_owner\n+ON write_outcomes(user_id, agent_id, session_id);\n+\n CREATE TABLE IF NOT EXISTS system_metrics (\n     minute_ts  TEXT PRIMARY KEY,\n     data       TEXT NOT NULL,\n@@ -414,6 +428,88 @@ def _query():\n             logger.warning(f\"get_pipeline_logs failed: {e}\")\n             return []\n \n+    # ================================================================\n+    # Durable write outcomes\n+    # ================================================================\n+\n+    async def claim_write_outcome(\n+        self,\n+        request_id: str,\n+        user_id: str,\n+        agent_id: str,\n+        session_id: str,\n+        operation: str,\n+    ) -> Optional[Dict[str, Any]]:\n+        def _claim():\n+            with self._lock:\n+                now = datetime.now().isoformat()\n+                cursor = self._conn.execute(\n+                    \"\"\"\n+                    INSERT OR IGNORE INTO write_outcomes (\n+                        request_id, user_id, agent_id, session_id, operation,\n+                        status, result_json, created_at, updated_at\n+                    ) VALUES (?, ?, ?, ?, ?, 'running', '{}', ?, ?)\n+                    \"\"\",\n+                    (request_id, user_id, agent_id, session_id, operation, now, now),\n+                )\n+                self._conn.commit()\n+                if cursor.rowcount == 1:\n+                    return None\n+                row = self._conn.execute(\n+                    \"SELECT * FROM write_outcomes WHERE request_id = ?\",\n+                    (request_id,),\n+                ).fetchone()\n+                return dict(row) if row else None\n+\n+        existing = await _run_in_sqlite_pool(_claim)\n+        if existing is None:\n+            return None\n+        return await self.get_write_outcome(request_id)\n+\n+    async def finish_write_outcome(\n+        self,\n+        request_id: str,\n+        status: str,\n+        result: Dict[str, Any],\n+    ) -> bool:\n+        def _finish():\n+            with self._lock:\n+                cursor = self._conn.execute(\n+                    \"\"\"\n+                    UPDATE write_outcomes\n+                    SET status = ?, result_json = ?, updated_at = ?\n+                    WHERE request_id = ?\n+                    \"\"\",\n+                    (\n+                        status,\n+                        json.dumps(result, ensure_ascii=False, default=str),\n+                        datetime.now().isoformat(),\n+                        request_id,\n+                    ),\n+                )\n+                self._conn.commit()\n+                return cursor.rowcount == 1\n+\n+        return await _run_in_sqlite_pool(_finish)\n+\n+    async def get_write_outcome(self, request_id: str) -> Optional[Dict[str, Any]]:\n+        def _get():\n+            with self._lock:\n+                row = self._conn.execute(\n+                    \"SELECT * FROM write_outcomes WHERE request_id = ?\",\n+                    (request_id,),\n+                ).fetchone()\n+                return dict(row) if row else None\n+\n+        row = await _run_in_sqlite_pool(_get)\n+        if row is None:\n+            return None\n+        try:\n+            row[\"result\"] = json.loads(row.pop(\"result_json\") or \"{}\")\n+        except (TypeError, json.JSONDecodeError):\n+            row[\"result\"] = {}\n+        return row\n+\n     # ================================================================\n     # System Metrics（分钟粒度落盘）\n     # ================================================================"
    },
    {
      "sha": "4ff1ec56303e36c7481933de1d53ac4cf20471df",
      "filename": "hy_memory/snapshot.py",
      "status": "added",
      "additions": 150,
      "deletions": 0,
      "changes": 150,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/hy_memory%2Fsnapshot.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/hy_memory%2Fsnapshot.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/hy_memory%2Fsnapshot.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,150 @@\n+\"\"\"Public, offline snapshot support for the SDK-owned local data plane.\"\"\"\n+\n+from __future__ import annotations\n+\n+import hashlib\n+import os\n+import shutil\n+from dataclasses import dataclass\n+from pathlib import Path\n+\n+\n+class DataPlaneSnapshotRejected(RuntimeError):\n+    def __init__(self, code: str) -> None:\n+        super().__init__(code)\n+        self.code = code\n+\n+\n+@dataclass(frozen=True)\n+class DataPlaneSnapshot:\n+    source_root: Path\n+    snapshot_root: Path\n+    files: tuple[dict[str, object], ...]\n+    total_bytes: int\n+\n+\n+@dataclass(frozen=True)\n+class DataPlaneRestore:\n+    restored_root: Path\n+    previous_root: Path | None\n+    files_restored: int\n+    total_bytes: int\n+\n+\n+def _sha256(path: Path) -> str:\n+    digest = hashlib.sha256()\n+    with path.open(\"rb\") as handle:\n+        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n+            digest.update(chunk)\n+    return digest.hexdigest()\n+\n+\n+def snapshot_local_data_plane(\n+    *,\n+    source_root: Path,\n+    target_root: Path,\n+    writers_stopped: bool,\n+) -> DataPlaneSnapshot:\n+    \"\"\"Copy one quiesced local SDK root and return a verified inventory.\n+\n+    Remote providers require their own export implementation and must not call\n+    this local-path contract.\n+    \"\"\"\n+    if not writers_stopped:\n+        raise DataPlaneSnapshotRejected(\"data_plane_snapshot_writers_running\")\n+    source = source_root.resolve()\n+    target = target_root.resolve()\n+    if source.is_symlink() or not source.is_dir():\n+        raise DataPlaneSnapshotRejected(\"data_plane_snapshot_source_invalid\")\n+    if target.exists():\n+        raise DataPlaneSnapshotRejected(\"data_plane_snapshot_target_exists\")\n+\n+    try:\n+        target.mkdir(parents=True)\n+        for root, directories, files in os.walk(source, followlinks=False):\n+            root_path = Path(root)\n+            relative = root_path.relative_to(source)\n+            target_directory = target / relative\n+            target_directory.mkdir(parents=True, exist_ok=True)\n+            for name in directories:\n+                if (root_path / name).is_symlink():\n+                    raise DataPlaneSnapshotRejected(\"data_plane_snapshot_symlink\")\n+            for name in files:\n+                item = root_path / name\n+                if item.is_symlink():\n+                    raise DataPlaneSnapshotRejected(\"data_plane_snapshot_symlink\")\n+                shutil.copy2(item, target_directory / name)\n+\n+        inventory: list[dict[str, object]] = []\n+        for path in sorted(item for item in target.rglob(\"*\") if item.is_file()):\n+            inventory.append(\n+                {\n+                    \"path\": path.relative_to(target).as_posix(),\n+                    \"bytes\": path.stat().st_size,\n+                    \"sha256\": _sha256(path),\n+                }\n+            )\n+        for item in inventory:\n+            copied = target / str(item[\"path\"])\n+            if copied.stat().st_size != item[\"bytes\"] or _sha256(copied) != item[\"sha256\"]:\n+                raise DataPlaneSnapshotRejected(\"data_plane_snapshot_verify_failed\")\n+    except DataPlaneSnapshotRejected:\n+        shutil.rmtree(target, ignore_errors=True)\n+        raise\n+    except OSError as error:\n+        shutil.rmtree(target, ignore_errors=True)\n+        raise DataPlaneSnapshotRejected(\"data_plane_snapshot_failed\") from error\n+\n+    return DataPlaneSnapshot(\n+        source_root=source,\n+        snapshot_root=target,\n+        files=tuple(inventory),\n+        total_bytes=sum(int(item[\"bytes\"]) for item in inventory),\n+    )\n+\n+\n+def restore_local_data_plane(\n+    *,\n+    snapshot_root: Path,\n+    target_root: Path,\n+    writers_stopped: bool,\n+    protective_root: Path | None = None,\n+) -> DataPlaneRestore:\n+    \"\"\"Replace one local SDK root from a verified snapshot with rollback.\"\"\"\n+    if not writers_stopped:\n+        raise DataPlaneSnapshotRejected(\"data_plane_restore_writers_running\")\n+    source = snapshot_root.resolve()\n+    target = target_root.resolve()\n+    protective = (\n+        protective_root.resolve()\n+        if protective_root is not None\n+        else target.parent / f\".{target.name}.pre-restore\"\n+    )\n+    staging = target.parent / f\".{target.name}.restore.tmp\"\n+    if target.is_symlink() or protective.exists() or staging.exists():\n+        raise DataPlaneSnapshotRejected(\"data_plane_restore_target_unsafe\")\n+\n+    copied = snapshot_local_data_plane(\n+        source_root=source,\n+        target_root=staging,\n+        writers_stopped=True,\n+    )\n+    previous: Path | None = None\n+    try:\n+        if target.exists():\n+            target.replace(protective)\n+            previous = protective\n+        staging.replace(target)\n+    except OSError as error:\n+        if previous is not None and previous.exists() and not target.exists():\n+            previous.replace(target)\n+            previous = None\n+        shutil.rmtree(staging, ignore_errors=True)\n+        raise DataPlaneSnapshotRejected(\"data_plane_restore_replace_failed\") from error\n+\n+    return DataPlaneRestore(\n+        restored_root=target,\n+        previous_root=previous,\n+        files_restored=len(copied.files),\n+        total_bytes=copied.total_bytes,\n+    )"
    },
    {
      "sha": "3b359a4820829d0cbe530dfa36d6051d1d3f3c89",
      "filename": "tests/test_cache_backend_parity.py",
      "status": "modified",
      "additions": 13,
      "deletions": 0,
      "changes": 13,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_cache_backend_parity.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_cache_backend_parity.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_cache_backend_parity.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -24,6 +24,9 @@\n STATEFUL_METHODS = [\n     \"get_episode_state\",\n     \"upsert_episode_state\",\n+    \"claim_write_outcome\",\n+    \"finish_write_outcome\",\n+    \"get_write_outcome\",\n ]\n \n BACKENDS = [\n@@ -70,6 +73,16 @@ def test_episode_state_table_declared(backend):\n     )\n \n \n+@pytest.mark.parametrize(\"backend\", BACKENDS)\n+def test_write_outcomes_table_declared(backend):\n+    import hy_memory.data.cache_mysql as m\n+    import hy_memory.data.cache_sqlite as s\n+\n+    mod = s if backend is SqliteCache else m\n+    src = inspect.getsource(mod)\n+    assert \"CREATE TABLE IF NOT EXISTS write_outcomes\" in src\n+\n+\n class TestRollingSummaryFullyRemoved:\n     \"\"\"rolling summary 已整体移除，残留引用会让应用在启动路径报错。\"\"\"\n "
    },
    {
      "sha": "fc49b23be74df25fa9519fddf74356456eb790cc",
      "filename": "tests/test_data_plane_snapshot.py",
      "status": "added",
      "additions": 125,
      "deletions": 0,
      "changes": 125,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_data_plane_snapshot.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_data_plane_snapshot.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_data_plane_snapshot.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,125 @@\n+from __future__ import annotations\n+\n+import hashlib\n+\n+import pytest\n+\n+from hy_memory.snapshot import (\n+    DataPlaneSnapshotRejected,\n+    restore_local_data_plane,\n+    snapshot_local_data_plane,\n+)\n+\n+\n+def _sha256(path):\n+    return hashlib.sha256(path.read_bytes()).hexdigest()\n+\n+\n+def test_snapshot_copies_and_verifies_local_sdk_tree(tmp_path):\n+    source = tmp_path / \"source\"\n+    (source / \"vector\").mkdir(parents=True)\n+    (source / \"vector\" / \"nodes.bin\").write_bytes(b\"vector\")\n+    (source / \"cache.sqlite3\").write_bytes(b\"cache\")\n+    target = tmp_path / \"snapshot\"\n+\n+    result = snapshot_local_data_plane(\n+        source_root=source,\n+        target_root=target,\n+        writers_stopped=True,\n+    )\n+\n+    assert {item[\"path\"] for item in result.files} == {\n+        \"cache.sqlite3\",\n+        \"vector/nodes.bin\",\n+    }\n+    for item in result.files:\n+        copied = target / item[\"path\"]\n+        assert copied.stat().st_size == item[\"bytes\"]\n+        assert _sha256(copied) == item[\"sha256\"]\n+    assert result.total_bytes == len(b\"vector\") + len(b\"cache\")\n+\n+\n+def test_snapshot_refuses_active_writers(tmp_path):\n+    source = tmp_path / \"source\"\n+    source.mkdir()\n+    with pytest.raises(DataPlaneSnapshotRejected) as caught:\n+        snapshot_local_data_plane(\n+            source_root=source,\n+            target_root=tmp_path / \"snapshot\",\n+            writers_stopped=False,\n+        )\n+    assert caught.value.code == \"data_plane_snapshot_writers_running\"\n+\n+\n+def test_snapshot_rejects_symlink_and_removes_partial_target(tmp_path):\n+    source = tmp_path / \"source\"\n+    source.mkdir()\n+    outside = tmp_path / \"outside\"\n+    outside.write_text(\"outside\", encoding=\"utf-8\")\n+    try:\n+        (source / \"linked\").symlink_to(outside)\n+    except OSError:\n+        pytest.skip(\"symlinks unavailable\")\n+    target = tmp_path / \"snapshot\"\n+\n+    with pytest.raises(DataPlaneSnapshotRejected) as caught:\n+        snapshot_local_data_plane(\n+            source_root=source,\n+            target_root=target,\n+            writers_stopped=True,\n+        )\n+    assert caught.value.code == \"data_plane_snapshot_symlink\"\n+    assert not target.exists()\n+\n+\n+def test_snapshot_target_must_not_exist(tmp_path):\n+    source = tmp_path / \"source\"\n+    target = tmp_path / \"snapshot\"\n+    source.mkdir()\n+    target.mkdir()\n+    with pytest.raises(DataPlaneSnapshotRejected) as caught:\n+        snapshot_local_data_plane(\n+            source_root=source,\n+            target_root=target,\n+            writers_stopped=True,\n+        )\n+    assert caught.value.code == \"data_plane_snapshot_target_exists\"\n+\n+\n+def test_restore_replaces_data_plane_and_keeps_protective_copy(tmp_path):\n+    snapshot = tmp_path / \"snapshot\"\n+    target = tmp_path / \"live\"\n+    (snapshot / \"vector\").mkdir(parents=True)\n+    (snapshot / \"vector\" / \"nodes.bin\").write_bytes(b\"new\")\n+    (target / \"vector\").mkdir(parents=True)\n+    (target / \"vector\" / \"nodes.bin\").write_bytes(b\"old\")\n+    protective = tmp_path / \"previous\"\n+\n+    result = restore_local_data_plane(\n+        snapshot_root=snapshot,\n+        target_root=target,\n+        protective_root=protective,\n+        writers_stopped=True,\n+    )\n+\n+    assert (target / \"vector\" / \"nodes.bin\").read_bytes() == b\"new\"\n+    assert (protective / \"vector\" / \"nodes.bin\").read_bytes() == b\"old\"\n+    assert result.previous_root == protective\n+    assert result.files_restored == 1\n+\n+\n+def test_restore_refuses_active_writers_without_touching_live_data(tmp_path):\n+    snapshot = tmp_path / \"snapshot\"\n+    target = tmp_path / \"live\"\n+    snapshot.mkdir()\n+    target.mkdir()\n+    (target / \"value\").write_text(\"old\", encoding=\"utf-8\")\n+\n+    with pytest.raises(DataPlaneSnapshotRejected) as caught:\n+        restore_local_data_plane(\n+            snapshot_root=snapshot,\n+            target_root=target,\n+            writers_stopped=False,\n+        )\n+    assert caught.value.code == \"data_plane_restore_writers_running\"\n+    assert (target / \"value\").read_text(encoding=\"utf-8\") == \"old\""
    },
    {
      "sha": "db1f6e6eab0bbcc58d38def94d636e609149050d",
      "filename": "tests/test_delete_complete.py",
      "status": "added",
      "additions": 120,
      "deletions": 0,
      "changes": 120,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_delete_complete.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_delete_complete.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_delete_complete.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,120 @@\n+from __future__ import annotations\n+\n+from unittest.mock import AsyncMock\n+\n+import pytest\n+\n+from hy_memory.client import HyMemoryClient\n+from hy_memory.config import MemoryConfig\n+from hy_memory.models.memory import MemoryLayer, MemoryNode\n+\n+\n+class VectorStore:\n+    _collection_name = \"test\"\n+\n+    def __init__(self, node=None, *, delete_result=True):\n+        self.node = node\n+        self.delete_result = delete_result\n+\n+    async def get_by_id(self, _memory_id):\n+        return self.node\n+\n+    async def delete(self, _memory_id):\n+        result = self.node is not None and self.delete_result\n+        if result:\n+            self.node = None\n+        return result\n+\n+    async def delete_retrieval_clauses(self, _memory_id):\n+        return None\n+\n+\n+class GraphStore:\n+    def __init__(self, node=None, *, delete_result=True, lookup_error=False):\n+        self.node = node\n+        self.delete_result = delete_result\n+        self.lookup_error = lookup_error\n+\n+    async def get_node(self, _memory_id):\n+        if self.lookup_error:\n+            raise RuntimeError(\"graph unavailable\")\n+        return self.node\n+\n+    async def delete_node(self, _memory_id):\n+        if self.delete_result:\n+            self.node = None\n+        return self.delete_result\n+\n+\n+def _node():\n+    return MemoryNode(\n+        node_id=\"m1\",\n+        user_id=\"u1\",\n+        agent_id=\"a1\",\n+        session_id=\"s1\",\n+        content=\"body\",\n+        layer=MemoryLayer.L2_FACT,\n+    )\n+\n+\n+def _client(vector, graph):\n+    client = HyMemoryClient.__new__(HyMemoryClient)\n+    client._vector_store = vector\n+    client._graph_store = graph\n+    client._history_store = None\n+    client._config = MemoryConfig.from_dict(\n+        {\"vector_store\": {\"provider\": \"faiss\", \"collection_name\": \"test\"}}\n+    )\n+    client._maybe_store_op_log = AsyncMock()\n+    client._cleanup_graph_evidence = AsyncMock(return_value=True)\n+    return client\n+\n+\n+@pytest.mark.asyncio\n+async def test_delete_succeeds_only_when_every_existing_store_is_deleted():\n+    client = _client(VectorStore(_node()), GraphStore(_node()))\n+    result = await HyMemoryClient.async_delete.__wrapped__(client, \"m1\")\n+\n+    assert result[\"success\"] is True\n+    assert result[\"deleted_count\"] == 1\n+    assert result[\"vdb_deleted\"] is True\n+    assert result[\"graph_deleted\"] is True\n+    assert result[\"partial\"] is False\n+    assert result[\"error_code\"] is None\n+\n+\n+@pytest.mark.asyncio\n+async def test_graph_failure_is_reported_as_partial_not_success():\n+    client = _client(\n+        VectorStore(_node()),\n+        GraphStore(_node(), delete_result=False),\n+    )\n+    result = await HyMemoryClient.async_delete.__wrapped__(client, \"m1\")\n+\n+    assert result[\"success\"] is False\n+    assert result[\"deleted_count\"] == 0\n+    assert result[\"vdb_deleted\"] is True\n+    assert result[\"graph_deleted\"] is False\n+    assert result[\"partial\"] is True\n+    assert result[\"error_code\"] == \"delete_incomplete\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_graph_only_memory_can_be_physically_deleted():\n+    client = _client(VectorStore(None), GraphStore(_node()))\n+    result = await HyMemoryClient.async_delete.__wrapped__(client, \"m1\")\n+\n+    assert result[\"success\"] is True\n+    assert result[\"vdb_deleted\"] is False\n+    assert result[\"graph_deleted\"] is True\n+    assert result[\"deleted_count\"] == 1\n+\n+\n+@pytest.mark.asyncio\n+async def test_graph_lookup_failure_never_collapses_to_not_found_success():\n+    client = _client(VectorStore(None), GraphStore(lookup_error=True))\n+    result = await HyMemoryClient.async_delete.__wrapped__(client, \"m1\")\n+\n+    assert result[\"success\"] is False\n+    assert result[\"partial\"] is False\n+    assert result[\"error_code\"] == \"delete_incomplete\""
    },
    {
      "sha": "ce8569e6874947451150403bd4dcd38318a46ff2",
      "filename": "tests/test_list_layer_filter_client.py",
      "status": "modified",
      "additions": 76,
      "deletions": 3,
      "changes": 79,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_list_layer_filter_client.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_list_layer_filter_client.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_list_layer_filter_client.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -31,7 +31,12 @@ def run(coro):\n DIMS = 32\n \n \n-def _node(user_id=\"u1\", content=\"x\", layer=MemoryLayer.L2_FACT):\n+def _node(\n+    user_id=\"u1\",\n+    content=\"x\",\n+    layer=MemoryLayer.L2_FACT,\n+    status=MemoryStatus.ACTIVE,\n+):\n     import random\n     n = MemoryNode(\n         node_id=str(uuid.uuid4()),\n@@ -40,8 +45,8 @@ def _node(user_id=\"u1\", content=\"x\", layer=MemoryLayer.L2_FACT):\n         session_id=\"s1\",\n         content=content,\n         layer=layer,\n-        status=MemoryStatus.ACTIVE,\n-        is_latest=True,\n+        status=status,\n+        is_latest=status == MemoryStatus.ACTIVE,\n     )\n     vec = [random.gauss(0, 1) for _ in range(DIMS)]\n     norm = sum(v * v for v in vec) ** 0.5\n@@ -104,6 +109,22 @@ def test_invalid_raises_not_silently_ignored(self):\n             HyMemoryClient._normalize_layers([\"l3_identity\"])\n \n \n+class TestNormalizeStatuses:\n+    def test_none_and_empty_preserve_active_default(self):\n+        assert HyMemoryClient._normalize_statuses(None) is None\n+        assert HyMemoryClient._normalize_statuses([]) is None\n+\n+    def test_string_and_enum_values_are_deduplicated(self):\n+        got = HyMemoryClient._normalize_statuses(\n+            [\"superseded\", MemoryStatus.SHADOW, \"superseded\"]\n+        )\n+        assert got == [MemoryStatus.SUPERSEDED, MemoryStatus.SHADOW]\n+\n+    def test_invalid_status_raises(self):\n+        with pytest.raises(ValueError):\n+            HyMemoryClient._normalize_statuses([\"deleted\"])\n+\n+\n class TestVdbBucketLayerFilter:\n     def _seed(self, store):\n         run(store.upsert_batch([\n@@ -163,6 +184,24 @@ def test_raw_mixed_with_other_layers_only_drops_raw(self, faiss_store):\n         ))\n         assert [m[\"content\"] for m in got[\"memories\"]] == [\"fact\"]\n \n+    def test_status_filter_defaults_to_active_and_can_read_superseded(self, faiss_store):\n+        run(faiss_store.upsert_batch([\n+            _node(content=\"active\", status=MemoryStatus.ACTIVE),\n+            _node(content=\"old\", status=MemoryStatus.SUPERSEDED),\n+            _node(content=\"hidden\", status=MemoryStatus.SHADOW),\n+        ]))\n+\n+        default_page = run(_client_with(faiss_store)._list_vdb_bucket(\n+            user_id=\"u1\", agent_id=None, limit=100, offset=0, order=\"desc\",\n+        ))\n+        assert [m[\"content\"] for m in default_page[\"memories\"]] == [\"active\"]\n+\n+        lifecycle_page = run(_client_with(faiss_store)._list_vdb_bucket(\n+            user_id=\"u1\", agent_id=None, limit=100, offset=0, order=\"desc\",\n+            statuses=[MemoryStatus.SUPERSEDED, MemoryStatus.SHADOW],\n+        ))\n+        assert {m[\"content\"] for m in lifecycle_page[\"memories\"]} == {\"old\", \"hidden\"}\n+\n     def test_layer_filter_composes_with_multi_user(self, faiss_store):\n         \"\"\"R3 与 R1 叠加：多用户 + 层级筛选同时生效。\"\"\"\n         run(faiss_store.upsert_batch([\n@@ -215,3 +254,37 @@ def test_no_layers_still_queries(self):\n             user_id=\"u1\", agent_id=None, limit=10, offset=0, order=\"desc\",\n         ))\n         assert calls == [1], \"不传 layers 时行为与改动前一致\"\n+\n+    def test_graph_status_filter_matches_vdb_contract(self):\n+        active = _node(content=\"active graph\", layer=MemoryLayer.L6_SCHEMA)\n+        old = _node(\n+            content=\"old graph\",\n+            layer=MemoryLayer.L6_SCHEMA,\n+            status=MemoryStatus.SUPERSEDED,\n+        )\n+\n+        class GraphStore:\n+            async def get_all_nodes(self, *_args, **_kwargs):\n+                return [active, old]\n+\n+            async def close(self):\n+                return None\n+\n+        c = HyMemoryClient.__new__(HyMemoryClient)\n+\n+        async def _acquire():\n+            return GraphStore(), True\n+\n+        c._acquire_graph_store_for_purge = _acquire\n+        default_page = run(c._list_graph_bucket(\n+            user_id=\"u1\", agent_id=None, limit=10, offset=0, order=\"desc\",\n+            layers=[MemoryLayer.L6_SCHEMA],\n+        ))\n+        assert [item[\"content\"] for item in default_page[\"nodes\"]] == [\"active graph\"]\n+\n+        old_page = run(c._list_graph_bucket(\n+            user_id=\"u1\", agent_id=None, limit=10, offset=0, order=\"desc\",\n+            layers=[MemoryLayer.L6_SCHEMA],\n+            statuses=[MemoryStatus.SUPERSEDED],\n+        ))\n+        assert [item[\"content\"] for item in old_page[\"nodes\"]] == [\"old graph\"]"
    },
    {
      "sha": "20d71f5fd601c954594a5a6c105bbdd8a1cb542c",
      "filename": "tests/test_raw_public_api.py",
      "status": "added",
      "additions": 162,
      "deletions": 0,
      "changes": 162,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_raw_public_api.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_raw_public_api.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_raw_public_api.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,162 @@\n+from __future__ import annotations\n+\n+from unittest.mock import AsyncMock\n+\n+import pytest\n+\n+from hy_memory.client import HyMemoryClient\n+from hy_memory.models.memory import MemoryLayer\n+\n+\n+class OutcomeCache:\n+    def __init__(self):\n+        self.rows = {}\n+\n+    async def claim_write_outcome(\n+        self, request_id, user_id, agent_id, session_id, operation\n+    ):\n+        if request_id in self.rows:\n+            return self.rows[request_id]\n+        self.rows[request_id] = {\n+            \"request_id\": request_id,\n+            \"user_id\": user_id,\n+            \"agent_id\": agent_id,\n+            \"session_id\": session_id,\n+            \"operation\": operation,\n+            \"status\": \"running\",\n+            \"result\": {},\n+        }\n+        return None\n+\n+    async def finish_write_outcome(self, request_id, status, result):\n+        self.rows[request_id].update(status=status, result=dict(result))\n+        return True\n+\n+    async def get_write_outcome(self, request_id):\n+        return self.rows.get(request_id)\n+\n+\n+class RawStore:\n+    def __init__(self):\n+        self.nodes = {}\n+        self.upserts = 0\n+\n+    async def get_by_id(self, node_id):\n+        return self.nodes.get(node_id)\n+\n+    async def upsert(self, node):\n+        self.upserts += 1\n+        self.nodes[node.node_id] = node\n+        return node.node_id\n+\n+    async def list_by_user(\n+        self,\n+        *,\n+        user_id,\n+        agent_id=None,\n+        include_sources=None,\n+        **_kwargs,\n+    ):\n+        return [\n+            node\n+            for node in self.nodes.values()\n+            if node.user_id == user_id\n+            and (agent_id is None or node.agent_id == agent_id)\n+            and (not include_sources or node.source in include_sources)\n+        ]\n+\n+\n+def _client():\n+    client = HyMemoryClient.__new__(HyMemoryClient)\n+    client._cache = OutcomeCache()\n+    client._vector_store = RawStore()\n+    client._embed_service = AsyncMock()\n+    client._embed_service.embed.return_value = [0.1, 0.2]\n+    return client\n+\n+\n+@pytest.mark.asyncio\n+async def test_import_raw_preserves_identity_without_extraction():\n+    client = _client()\n+    result = await HyMemoryClient.async_import_raw.__wrapped__(\n+        client,\n+        \"verbatim\",\n+        user_id=\"u1\",\n+        agent_id=\"a1\",\n+        session_id=\"s1\",\n+        source=\"cursor\",\n+        raw_id=\"raw-1\",\n+        request_id=\"request-1\",\n+        metadata={\"role\": \"user\", \"source_order\": 7},\n+    )\n+\n+    assert result == {\n+        \"success\": True,\n+        \"raw_id\": \"raw-1\",\n+        \"request_id\": \"request-1\",\n+    }\n+    node = client._vector_store.nodes[\"raw-1\"]\n+    assert node.layer == MemoryLayer.L1_RAW\n+    assert node.content == \"verbatim\"\n+    assert node.custom[\"role\"] == \"user\"\n+    assert node.custom[\"source_order\"] == 7\n+    assert node.custom[\"input_kind\"] == \"raw_exact_import\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_import_raw_request_replay_does_not_write_twice():\n+    client = _client()\n+    first = await HyMemoryClient.async_import_raw.__wrapped__(\n+        client, \"same\", user_id=\"u1\", raw_id=\"raw-1\", request_id=\"request-1\"\n+    )\n+    second = await HyMemoryClient.async_import_raw.__wrapped__(\n+        client, \"same\", user_id=\"u1\", raw_id=\"raw-1\", request_id=\"request-1\"\n+    )\n+\n+    assert second == {**first, \"replayed\": True}\n+    assert client._vector_store.upserts == 1\n+\n+\n+@pytest.mark.asyncio\n+async def test_existing_raw_id_must_match_exact_content_and_owner():\n+    client = _client()\n+    await HyMemoryClient.async_import_raw.__wrapped__(\n+        client, \"first\", user_id=\"u1\", raw_id=\"raw-1\", request_id=\"request-1\"\n+    )\n+\n+    with pytest.raises(ValueError, match=\"different source content\"):\n+        await HyMemoryClient.async_import_raw.__wrapped__(\n+            client, \"changed\", user_id=\"u1\", raw_id=\"raw-1\", request_id=\"request-2\"\n+        )\n+\n+\n+@pytest.mark.asyncio\n+async def test_raw_get_and_list_use_explicit_api():\n+    client = _client()\n+    for raw_id, session_id, source in (\n+        (\"raw-1\", \"s1\", \"cursor\"),\n+        (\"raw-2\", \"s2\", \"claude\"),\n+    ):\n+        await HyMemoryClient.async_import_raw.__wrapped__(\n+            client,\n+            raw_id,\n+            user_id=\"u1\",\n+            session_id=session_id,\n+            source=source,\n+            raw_id=raw_id,\n+            request_id=f\"request-{raw_id}\",\n+        )\n+\n+    item = await HyMemoryClient.async_get_raw.__wrapped__(client, \"raw-1\")\n+    assert item[\"raw_id\"] == \"raw-1\"\n+    assert item[\"content\"] == \"raw-1\"\n+\n+    page = await HyMemoryClient.async_list_raw.__wrapped__(\n+        client,\n+        user_id=\"u1\",\n+        source=\"claude\",\n+        limit=10,\n+        offset=0,\n+    )\n+    assert page[\"total\"] == 1\n+    assert [item[\"raw_id\"] for item in page[\"raw\"]] == [\"raw-2\"]"
    },
    {
      "sha": "a4656bd49d904fa862c0dbb78ad5519d5f63da42",
      "filename": "tests/test_write_outcome_cache.py",
      "status": "added",
      "additions": 47,
      "deletions": 0,
      "changes": 47,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_write_outcome_cache.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_write_outcome_cache.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_write_outcome_cache.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,47 @@\n+from __future__ import annotations\n+\n+import pytest\n+\n+from hy_memory.config import MemoryConfig\n+from hy_memory.data.cache_sqlite import SqliteCache\n+\n+\n+@pytest.fixture\n+async def cache(tmp_path):\n+    config = MemoryConfig.from_dict(\n+        {\"cache\": {\"backend\": \"sqlite\", \"db_path\": str(tmp_path / \"cache.sqlite3\")}}\n+    )\n+    value = SqliteCache(config)\n+    await value.initialize()\n+    yield value\n+    await value.close()\n+\n+\n+@pytest.mark.asyncio\n+async def test_claim_is_atomic_and_returns_existing_scope(cache):\n+    claimed = await cache.claim_write_outcome(\"r1\", \"u1\", \"a1\", \"s1\", \"add\")\n+    assert claimed is None\n+\n+    existing = await cache.claim_write_outcome(\"r1\", \"u1\", \"a1\", \"s1\", \"add\")\n+    assert existing[\"status\"] == \"running\"\n+    assert existing[\"user_id\"] == \"u1\"\n+    assert existing[\"operation\"] == \"add\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_terminal_result_round_trips(cache):\n+    await cache.claim_write_outcome(\"r2\", \"u1\", \"a1\", \"s1\", \"add_extracted\")\n+    assert await cache.finish_write_outcome(\n+        \"r2\",\n+        \"succeeded\",\n+        {\"success\": True, \"memory_ids\": [\"m1\", \"m2\"]},\n+    )\n+\n+    outcome = await cache.get_write_outcome(\"r2\")\n+    assert outcome[\"status\"] == \"succeeded\"\n+    assert outcome[\"result\"] == {\"success\": True, \"memory_ids\": [\"m1\", \"m2\"]}\n+\n+\n+@pytest.mark.asyncio\n+async def test_missing_outcome_is_distinct_from_running(cache):\n+    assert await cache.get_write_outcome(\"missing\") is None"
    },
    {
      "sha": "960f6b9bd7a29f079ab4632961f5329af557b73c",
      "filename": "tests/test_write_outcome_client.py",
      "status": "added",
      "additions": 128,
      "deletions": 0,
      "changes": 128,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_write_outcome_client.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/fd12c8f1c0f0c6b3e81120605b675d43119c0ee8/tests%2Ftest_write_outcome_client.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/tests%2Ftest_write_outcome_client.py?ref=fd12c8f1c0f0c6b3e81120605b675d43119c0ee8",
      "patch": "@@ -0,0 +1,128 @@\n+from __future__ import annotations\n+\n+from unittest.mock import AsyncMock\n+\n+import pytest\n+\n+from hy_memory.client import HyMemoryClient\n+\n+\n+class OutcomeCache:\n+    def __init__(self):\n+        self.rows: dict[str, dict] = {}\n+\n+    async def claim_write_outcome(\n+        self,\n+        request_id,\n+        user_id,\n+        agent_id,\n+        session_id,\n+        operation,\n+    ):\n+        existing = self.rows.get(request_id)\n+        if existing is not None:\n+            return existing\n+        self.rows[request_id] = {\n+            \"request_id\": request_id,\n+            \"user_id\": user_id,\n+            \"agent_id\": agent_id,\n+            \"session_id\": session_id,\n+            \"operation\": operation,\n+            \"status\": \"running\",\n+            \"result\": {},\n+        }\n+        return None\n+\n+    async def finish_write_outcome(self, request_id, status, result):\n+        row = self.rows.get(request_id)\n+        if row is None:\n+            return False\n+        row.update(status=status, result=dict(result))\n+        return True\n+\n+    async def get_write_outcome(self, request_id):\n+        return self.rows.get(request_id)\n+\n+\n+def _client():\n+    client = HyMemoryClient.__new__(HyMemoryClient)\n+    client._cache = OutcomeCache()\n+    return client\n+\n+\n+@pytest.mark.asyncio\n+async def test_same_request_replays_terminal_result_without_writing_twice():\n+    client = _client()\n+    client._async_add_impl = AsyncMock(\n+        return_value={\"success\": True, \"request_id\": \"r1\", \"memory_id\": \"m1\"}\n+    )\n+\n+    first = await HyMemoryClient.async_add.__wrapped__(\n+        client, \"hello\", user_id=\"u1\", request_id=\"r1\"\n+    )\n+    second = await HyMemoryClient.async_add.__wrapped__(\n+        client, \"hello\", user_id=\"u1\", request_id=\"r1\"\n+    )\n+\n+    assert first[\"memory_id\"] == \"m1\"\n+    assert second == {**first, \"replayed\": True}\n+    client._async_add_impl.assert_awaited_once()\n+\n+\n+@pytest.mark.asyncio\n+async def test_exception_marks_outcome_unknown_and_blocks_blind_retry():\n+    client = _client()\n+    client._async_add_impl = AsyncMock(side_effect=RuntimeError(\"after commit is unknown\"))\n+\n+    with pytest.raises(RuntimeError):\n+        await HyMemoryClient.async_add.__wrapped__(\n+            client, \"hello\", user_id=\"u1\", request_id=\"r2\"\n+        )\n+\n+    replay = await HyMemoryClient.async_add.__wrapped__(\n+        client, \"hello\", user_id=\"u1\", request_id=\"r2\"\n+    )\n+    assert replay[\"success\"] is False\n+    assert replay[\"outcome_status\"] == \"unknown\"\n+    assert replay[\"error_code\"] == \"write_outcome_not_terminal\"\n+    client._async_add_impl.assert_awaited_once()\n+\n+\n+@pytest.mark.asyncio\n+async def test_request_id_cannot_cross_write_scope():\n+    client = _client()\n+    client._async_add_impl = AsyncMock(\n+        return_value={\"success\": True, \"request_id\": \"r3\", \"memory_id\": \"m1\"}\n+    )\n+    await HyMemoryClient.async_add.__wrapped__(\n+        client, \"hello\", user_id=\"u1\", agent_id=\"a1\", request_id=\"r3\"\n+    )\n+\n+    with pytest.raises(ValueError, match=\"another write scope\"):\n+        await HyMemoryClient.async_add.__wrapped__(\n+            client, \"hello\", user_id=\"u2\", agent_id=\"a1\", request_id=\"r3\"\n+        )\n+\n+\n+@pytest.mark.asyncio\n+async def test_add_extracted_uses_the_same_idempotent_outcome_contract():\n+    client = _client()\n+    client._async_add_extracted_impl = AsyncMock(\n+        return_value={\n+            \"success\": True,\n+            \"request_id\": \"r4\",\n+            \"memory_id\": \"m1\",\n+            \"memory_ids\": [\"m1\"],\n+        }\n+    )\n+\n+    first = await HyMemoryClient.async_add_extracted.__wrapped__(\n+        client, [\"fact\"], user_id=\"u1\", request_id=\"r4\"\n+    )\n+    second = await HyMemoryClient.async_add_extracted.__wrapped__(\n+        client, [\"fact\"], user_id=\"u1\", request_id=\"r4\"\n+    )\n+\n+    assert first[\"memory_ids\"] == [\"m1\"]\n+    assert second == {**first, \"replayed\": True}\n+    client._async_add_extracted_impl.assert_awaited_once()"
    }
  ]
}
