    "parents": [
      {
        "sha": "4bc918af7a0a65e7cd12ed410eb60ac6eee63c5c",
        "url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/commits/4bc918af7a0a65e7cd12ed410eb60ac6eee63c5c",
        "html_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/commit/4bc918af7a0a65e7cd12ed410eb60ac6eee63c5c"
      }
