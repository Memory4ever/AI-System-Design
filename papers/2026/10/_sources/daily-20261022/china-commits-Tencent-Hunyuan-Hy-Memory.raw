      }
    ]
  },
  {
    "sha": "55bf946bccef289f80a20aa9c0b0c6a0fdbe7fb3",
    "node_id": "C_kwDOVK7UKNoAKDU1YmY5NDZiY2NlZjI4OWY4MGEyMGFhOWMwYjBjNmEwZmRiZTdmYjM",
    "commit": {
      "author": {
        "name": "u7-u7",
        "email": "116776533+u7-u7@users.noreply.github.com",
        "date": "2026-10-21T04:19:51Z"
      },
      "committer": {
        "name": "GitHub",
        "email": "noreply@github.com",
        "date": "2026-10-21T04:19:51Z"
      },
      "message": "fix(episode): read series timestamps back in local time (#94)\n\nSeries episode memory_at used datetime.utcfromtimestamp() on values produced\nby datetime.timestamp(). That yields a naive UTC datetime, which the vector\npayload later re-interprets as local time, shifting the stored timestamp by\nthe machine's UTC offset (8 hours on Asia/Shanghai).\n\nRound-trip through datetime.fromtimestamp() instead, and cover the wall-clock\nround trip with a non-UTC TZ regression.\n\nCo-authored-by: qiye.sjh <shijiahao_0802@youzan.com>\nCo-authored-by: Claude Code <noreply@anthropic.com>",
      "tree": {
        "sha": "1ba7d750dfb9244de7641af876f27bfadfb16e28",
        "url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/git/trees/1ba7d750dfb9244de7641af876f27bfadfb16e28"
      },
      "url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/git/commits/55bf946bccef289f80a20aa9c0b0c6a0fdbe7fb3",
      "comment_count": 0,
      "verification": {
        "verified": true,
        "reason": "valid",
        "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq2D1nCRC1aQ7uu5UhlAAAu3EQAH5p63NHCmjA4sMvtHLzZFPE\nZrB+mTfMOzWq3/Ww//eK10Z+aHIyALuY5l6MnxglU4C/+Miq4EAU8Sx0IN75nZHv\ntOWV6CZgSwgg4UpwNloRHuX9WIbb0ytePR+5HBS92tHMC344JiYFD3iAEqUeTnP0\nlPF67PanlkT2vuh/qHN7LuIVT0uAhAUGCKhOrp6xqWrG3JbKdD54WPmTpe0xB+T6\ne9ExX1Ml1DtkICsUEkHQWsquj2qOGQMfqefTHULUsCdwUJTpcZw6KPkeEnBLW8H8\nxN4R1oW338HixP7mWPqhuC5H8Equ419t+P+pp9yDhrB/6Ihd2cDxQ8NGJsAzYn6B\n4gq+OVRykOsMLm33/aRXb716LZ6HX00vXYQUFZJ4Jh5tMRP38XO6TDqZZ+Zou77D\nhVjWTRnkZ8czk9M7KDmWwg6LOucsHkL1loELlv6TyXiZZg2JBptiWqXgmssZyPCN\nclBFcAidzIvNv+weSwt3g+jlaOfGGLBTfgTeQCBAYIGb1q2gBiejJoliDtaWRdj3\nohIIullI+ZHtqIrOtDu4KKxwdBOAk0mhnBYONwwPdGioMVunRTurz3qcAs7cZUdI\niUNBb9fxQgKDKkV91yC6unBRm2OC5WgmF1vIZ9iH6WWVIwY5ACs09nSmH84lQENz\n6CHP/YgVmn/SMAk3zYbu\n=RRcX\n-----END PGP SIGNATURE-----\n",
        "payload": "tree 1ba7d750dfb9244de7641af876f27bfadfb16e28\nparent 14fcc6fe3805060fb9607348d1125dcb6b43a0c4\nauthor u7-u7 <116776533+u7-u7@users.noreply.github.com> 1792556391 +0800\ncommitter GitHub <noreply@github.com> 1792556391 +0800\n\nfix(episode): read series timestamps back in local time (#94)\n\nSeries episode memory_at used datetime.utcfromtimestamp() on values produced\nby datetime.timestamp(). That yields a naive UTC datetime, which the vector\npayload later re-interprets as local time, shifting the stored timestamp by\nthe machine's UTC offset (8 hours on Asia/Shanghai).\n\nRound-trip through datetime.fromtimestamp() instead, and cover the wall-clock\nround trip with a non-UTC TZ regression.\n\nCo-authored-by: qiye.sjh <shijiahao_0802@youzan.com>\nCo-authored-by: Claude Code <noreply@anthropic.com>",
        "verified_at": "2026-10-21T04:19:51Z"
      }
    },
