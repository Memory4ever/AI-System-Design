      "sha": "d50c4fa0197aa5b22ff3e314623909a01b205b84",
      "filename": "memhub/apps/core/src/one_memory/api.py",
      "status": "modified",
      "additions": 3,
      "deletions": 3,
      "changes": 6,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/0a9b10dbfc1371ed667de1cd760b736fe4bb1499/memhub%2Fapps%2Fcore%2Fsrc%2Fone_memory%2Fapi.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/0a9b10dbfc1371ed667de1cd760b736fe4bb1499/memhub%2Fapps%2Fcore%2Fsrc%2Fone_memory%2Fapi.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/memhub%2Fapps%2Fcore%2Fsrc%2Fone_memory%2Fapi.py?ref=0a9b10dbfc1371ed667de1cd760b736fe4bb1499",
      "patch": "@@ -1685,7 +1685,7 @@ async def unhandled_error(request: Request, error: Exception) -> JSONResponse:\n     # --- Reader-only internal endpoints. Registered here, before the public\n     # routes below; no early return, so every route after this still registers.\n \n-    @app.get(\"/internal/semantic-ids\")\n+    @app.get(\"/internal/semantic-ids\", dependencies=protected)\n     async def internal_semantic_ids(\n         query: str = Query(min_length=1, max_length=2_000),\n         limit: int = Query(default=12, ge=1, le=20),\n@@ -1697,7 +1697,7 @@ async def internal_semantic_ids(\n             return {\"ids\": []}\n         return {\"ids\": [memory_id for memory_id, _score in hits]}\n \n-    @app.post(\"/internal/call-event\")\n+    @app.post(\"/internal/call-event\", dependencies=protected)\n     async def internal_call_event(request: Request) -> dict[str, bool]:\n         \"\"\"Side effects the Reader cannot write: it opens with query_only.\"\"\"\n         try:\n@@ -1716,7 +1716,7 @@ async def internal_call_event(request: Request) -> dict[str, bool]:\n             return {\"recorded\": False}\n         return {\"recorded\": bool(recorded)}\n \n-    @app.get(\"/internal/graph-snapshot\")\n+    @app.get(\"/internal/graph-snapshot\", dependencies=protected)\n     async def internal_graph_snapshot(\n         limit: int = Query(default=160, ge=1, le=300),\n     ) -> dict[str, object]:"
    },
    {
      "sha": "a52526f2009e835f1d9d65174aa62f767d22b496",
      "filename": "memhub/apps/core/tests/test_auth.py",
      "status": "modified",
      "additions": 41,
      "deletions": 0,
      "changes": 41,
      "blob_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/blob/0a9b10dbfc1371ed667de1cd760b736fe4bb1499/memhub%2Fapps%2Fcore%2Ftests%2Ftest_auth.py",
      "raw_url": "https://github.com/Tencent-Hunyuan/Hy-Memory/raw/0a9b10dbfc1371ed667de1cd760b736fe4bb1499/memhub%2Fapps%2Fcore%2Ftests%2Ftest_auth.py",
      "contents_url": "https://api.github.com/repos/Tencent-Hunyuan/Hy-Memory/contents/memhub%2Fapps%2Fcore%2Ftests%2Ftest_auth.py?ref=0a9b10dbfc1371ed667de1cd760b736fe4bb1499",
      "patch": "@@ -55,3 +55,44 @@ def test_browser_origin_is_checked_in_addition_to_token() -> None:\n         )\n         == 200\n     )\n+\n+\n+async def internal_request(\n+    path: str,\n+    *,\n+    token: str | None,\n+    method: str = \"GET\",\n+) -> int:\n+    settings = Settings(api_token=SecretStr(\"test-token\"))\n+    app = create_app(settings)\n+    headers = {}\n+    if token:\n+        headers[\"Authorization\"] = f\"Bearer {token}\"\n+    async with AsyncClient(\n+        transport=ASGITransport(app=app),\n+        base_url=\"http://test\",\n+    ) as client:\n+        response = await client.request(method, path, headers=headers, json={})\n+    return response.status_code\n+\n+\n+def test_reader_internal_endpoints_require_local_token() -> None:\n+    for path in (\n+        \"/internal/semantic-ids?query=anything\",\n+        \"/internal/graph-snapshot\",\n+    ):\n+        assert asyncio.run(internal_request(path, token=None)) == 401\n+        assert asyncio.run(internal_request(path, token=\"test-token\")) == 200\n+\n+    assert (\n+        asyncio.run(\n+            internal_request(\"/internal/call-event\", token=None, method=\"POST\")\n+        )\n+        == 401\n+    )\n+    assert (\n+        asyncio.run(\n+            internal_request(\"/internal/call-event\", token=\"test-token\", method=\"POST\")\n+        )\n+        == 200\n+    )"
    }
  ]
