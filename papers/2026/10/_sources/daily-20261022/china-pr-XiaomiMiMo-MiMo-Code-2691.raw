  "number": 2691,
  "state": "closed",
  "locked": false,
  "title": "refactor(session): stop rewriting persisted tool output to shrink context",
  "user": {
    "login": "wqymi",
    "id": 293091852,
    "node_id": "U_kgDOEXg6DA",
    "avatar_url": "https://avatars.githubusercontent.com/u/293091852?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/wqymi",
    "html_url": "https://github.com/wqymi",
    "followers_url": "https://api.github.com/users/wqymi/followers",
    "following_url": "https://api.github.com/users/wqymi/following{/other_user}",
    "gists_url": "https://api.github.com/users/wqymi/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/wqymi/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/wqymi/subscriptions",
    "organizations_url": "https://api.github.com/users/wqymi/orgs",
    "repos_url": "https://api.github.com/users/wqymi/repos",
    "events_url": "https://api.github.com/users/wqymi/events{/privacy}",
    "received_events_url": "https://api.github.com/users/wqymi/received_events",
