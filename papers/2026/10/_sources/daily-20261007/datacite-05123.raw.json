{"data":{"id":"10.48550/arxiv.2610.05123","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.05123","prefix":"10.48550","suffix":"arxiv.2610.05123","identifiers":[{"identifier":"2610.05123","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.05123"}],"creators":[{"name":"Yang, Weiling","nameType":"Personal","givenName":"Weiling","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Junwen","nameType":"Personal","givenName":"Junwen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Dong, Dezun","nameType":"Personal","givenName":"Dezun","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Jianbin","nameType":"Personal","givenName":"Jianbin","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Enda","nameType":"Personal","givenName":"Enda","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Zhe","nameType":"Personal","givenName":"Zhe","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Deng, Xiaopeng","nameType":"Personal","givenName":"Xiaopeng","familyName":"Deng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HiNa-MoE: High-Performance, Non-Intrusive MoE Inference on CPUs with Matrix Engines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-04T11:08:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-06T01:21:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Mixture-of-Experts (MoE) inference is increasingly deployed in local and on-premise environments, where expert parameters often exceed GPU memory capacity. In latency-sensitive, low-concurrency settings, repeatedly staging routed-expert weights from CPU memory to the GPU can be prohibitive, leaving routed-expert feed-forward networks (FFNs) on the critical path of multi-socket CPUs. Existing CPU accelerations often rely on intrusive, hardware- or topology-specific requirements, such as AMX-specific weight layouts or manual NUMA-aware placement. These requirements reduce portability and complicate integration with standard CPU-GPU offloading pipelines. We present HiNa-MoE, a high-performance, non-intrusive operator library for MoE inference on CPUs with Intel AMX. HiNa-MoE (1) exploits AMX with an optimized micro-kernel that keeps expert weights in standard layouts and instead fuses lightweight layout transforms into token gathering and stores; (2) applies NUMA-aware task partitioning under a simple page-interleaved policy without modifying the framework allocator; and (3) converts decode-phase memory matrix-vector operations into small matrix-matrix execution to utilize AMX. Across multiple MoE models, HiNa-MoE achieves up to 3.37x speedup for FFN kernels and up to 2.09x end-to-end inference speedup over state-of-the-art baselines, while remaining plug-and-play with existing frameworks and deployment workflows.","descriptionType":"Abstract"},{"description":"Accepted by PACT 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.05123","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-06T04:50:44.000Z","registered":"2026-10-06T04:50:45.000Z","published":"2026","updated":"2026-10-06T04:50:45.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.05123","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}