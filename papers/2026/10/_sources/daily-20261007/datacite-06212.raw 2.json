{"data":{"id":"10.48550/arxiv.2610.06212","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.06212","prefix":"10.48550","suffix":"arxiv.2610.06212","identifiers":[{"identifier":"2610.06212","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.06212"}],"creators":[{"name":"Wei, Yangbo","nameType":"Personal","givenName":"Yangbo","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Qian, Junhong","nameType":"Personal","givenName":"Junhong","familyName":"Qian","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Su, Zhenyu","nameType":"Personal","givenName":"Zhenyu","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qifan","nameType":"Personal","givenName":"Qifan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Shaoqiang","nameType":"Personal","givenName":"Shaoqiang","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Rumin","nameType":"Personal","givenName":"Rumin","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Chen","nameType":"Personal","givenName":"Chen","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"He, Lei","nameType":"Personal","givenName":"Lei","familyName":"He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Serve Now or Improve Later? Scheduling Self-Evolution in Online Agent Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-05T12:22:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-06T02:22:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Online agents can improve future service by constructing reusable tools, guidance, or model states, but this work competes with current requests for the same GPUs. Exploiting idle compute for self-evolution faces a fundamental systems constraint: benefits arrive only after an artifact is published and used, while pausing evolution leaves service capacity waiting for memory release and runtime recovery. An investment worth completing may therefore be worth postponing. We present LearnSched, a state-aware scheduler that brings the reuse window of a capability and the timely return of compute into a common investment model. LearnSched incorporates candidate progress, checkpoint overhead, and the current recovery path into action values. Under the same information and capacity constraints, it uses one-step counterfactual rollout to choose progress, checkpointing, or waiting relative to a fully costed window policy. We characterize handoff costs through independent A100 component measurements and evaluate action selection in 1920 paired finite-model scenarios. When cold recovery is expensive, waiting for longer execution windows can improve net value by avoiding handoffs; in evaluated warm-recovery scenarios, the strong window policy already achieves the same value. Retaining recoverable state can shorten capacity return and reduce the need for complex evolution scheduling.","descriptionType":"Abstract"},{"description":"21 pages, 17 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.06212","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-06T05:19:51.000Z","registered":"2026-10-06T05:19:52.000Z","published":"2026","updated":"2026-10-06T05:19:52.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.06212","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}