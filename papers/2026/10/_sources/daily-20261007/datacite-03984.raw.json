{"data":{"id":"10.48550/arxiv.2610.03984","type":"dois","attributes":{"doi":"10.48550/arxiv.2610.03984","prefix":"10.48550","suffix":"arxiv.2610.03984","identifiers":[{"identifier":"2610.03984","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2610.03984"}],"creators":[{"name":"Mohsin, Muhammad Ahmed","nameType":"Personal","givenName":"Muhammad Ahmed","familyName":"Mohsin","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Myeongsoo","nameType":"Personal","givenName":"Myeongsoo","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Ruan, Kangrui","nameType":"Personal","givenName":"Kangrui","familyName":"Ruan","affiliation":[],"nameIdentifiers":[]},{"name":"Garg, Shweta","nameType":"Personal","givenName":"Shweta","familyName":"Garg","affiliation":[],"nameIdentifiers":[]},{"name":"Kumar, Varun","nameType":"Personal","givenName":"Varun","familyName":"Kumar","affiliation":[],"nameIdentifiers":[]},{"name":"Ramanathan, Murali Krishna","nameType":"Personal","givenName":"Murali Krishna","familyName":"Ramanathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Teaching Agents to Code Reliably"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-10-02T19:47:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-06T00:11:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Autonomous coding agents solve repository issues by reading code, running commands, editing files, and submitting patches. Extra inference-time compute yields gains only when it produces a useful repair and supplies reliable evidence for choosing one. Three behaviors decide both, and we argue they are teachable rather than byproducts of scale, so a policy can carry them instead of a scaffold. Location diversity remains narrow, since attempts return to the same site and extra samples add no coverage. Edit diversity is left unexploited, since methodologies that differ resolve complementary issues no single run reaches. Verification misleads, since a test the agent writes for its own patch accepts many incorrect ones. Directing search by execution feedback and scoring each patch against its own reverted tree resolves 52.8% of SWE-bench Verified using 48.1% of the agent-steps an eight-sample baseline spends. Training moves these behaviors into the policy. On the 270 issues held out from SFT and RL training, weighted supervised fine-tuning raises pass@1 from 31.9% to 35.2% and pass@8 from 46.7% to 51.1%. A reinforcement objective then trains the verifier against gold-labeled repairs and incorrect variants, crediting the assertions that detect them. It raises pass@1 to 43.0% and pass@8 to 60.7%, lifts verifier precision from 26.8% to 41.7%, and more than halves false acceptance. Resolution improves on two of three out-of-distribution suites and verifier precision on all three, and the gains hold at 7B, 14B, and 30B against published coder baselines.","descriptionType":"Abstract"},{"description":"Submitted to ICLR 2027","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2610.03984","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-10-06T04:17:41.000Z","registered":"2026-10-06T04:17:42.000Z","published":"2026","updated":"2026-10-06T04:17:42.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2610.03984","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}