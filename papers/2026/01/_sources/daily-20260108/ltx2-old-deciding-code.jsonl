{"url":"https://raw.githubusercontent.com/Lightricks/LTX-2/9ce438b35384556a386b61c528bc8d9b1f370630/packages/ltx-pipelines/src/ltx_pipelines/utils/helpers.py","selected_lines":[{"line":349,"text":"def guider_denoising_func("},{"line":350,"text":"    guider: GuiderProtocol,"},{"line":351,"text":"    v_context_p: torch.Tensor,"},{"line":352,"text":"    v_context_n: torch.Tensor,"},{"line":353,"text":"    a_context_p: torch.Tensor,"},{"line":354,"text":"    a_context_n: torch.Tensor,"},{"line":355,"text":"    transformer: X0Model,"},{"line":356,"text":") -> DenoisingFunc:"},{"line":357,"text":"    def guider_denoising_step("},{"line":358,"text":"        video_state: LatentState, audio_state: LatentState, sigmas: torch.Tensor, step_index: int"},{"line":359,"text":"    ) -> tuple[torch.Tensor, torch.Tensor]:"},{"line":360,"text":"        sigma = sigmas[step_index]"},{"line":361,"text":"        pos_video = modality_from_latent_state(video_state, v_context_p, sigma)"},{"line":362,"text":"        pos_audio = modality_from_latent_state(audio_state, a_context_p, sigma)"},{"line":363,"text":""},{"line":364,"text":"        denoised_video, denoised_audio = transformer(video=pos_video, audio=pos_audio, perturbations=None)"},{"line":365,"text":"        if guider.enabled():"},{"line":366,"text":"            neg_video = modality_from_latent_state(video_state, v_context_n, sigma)"},{"line":367,"text":"            neg_audio = modality_from_latent_state(audio_state, a_context_n, sigma)"},{"line":368,"text":""},{"line":369,"text":"            neg_denoised_video, neg_denoised_audio = transformer(video=neg_video, audio=neg_audio, perturbations=None)"},{"line":370,"text":""},{"line":371,"text":"            denoised_video = denoised_video + guider.delta(denoised_video, neg_denoised_video)"},{"line":372,"text":"            denoised_audio = denoised_audio + guider.delta(denoised_audio, neg_denoised_audio)"},{"line":373,"text":""},{"line":374,"text":"        return denoised_video, denoised_audio"},{"line":375,"text":""},{"line":376,"text":"    return guider_denoising_step"},{"line":377,"text":""},{"line":378,"text":""},{"line":379,"text":"def denoise_audio_video(  # noqa: PLR0913"},{"line":380,"text":"    output_shape: VideoPixelShape,"},{"line":381,"text":"    conditionings: list[ConditioningItem],"},{"line":382,"text":"    noiser: Noiser,"},{"line":383,"text":"    sigmas: torch.Tensor,"},{"line":384,"text":"    stepper: DiffusionStepProtocol,"},{"line":385,"text":"    denoising_loop_fn: DenoisingLoopFunc,"},{"line":386,"text":"    components: PipelineComponents,"},{"line":387,"text":"    dtype: torch.dtype,"},{"line":388,"text":"    device: torch.device,"},{"line":389,"text":"    noise_scale: float = 1.0,"},{"line":390,"text":"    initial_video_latent: torch.Tensor | None = None,"},{"line":391,"text":"    initial_audio_latent: torch.Tensor | None = None,"},{"line":392,"text":") -> tuple[LatentState, LatentState]:"},{"line":393,"text":"    video_state, video_tools = noise_video_state("},{"line":394,"text":"        output_shape=output_shape,"},{"line":395,"text":"        noiser=noiser,"},{"line":396,"text":"        conditionings=conditionings,"},{"line":397,"text":"        components=components,"},{"line":398,"text":"        dtype=dtype,"},{"line":399,"text":"        device=device,"},{"line":400,"text":"        noise_scale=noise_scale,"},{"line":401,"text":"        initial_latent=initial_video_latent,"},{"line":402,"text":"    )"},{"line":403,"text":"    audio_state, audio_tools = noise_audio_state("},{"line":404,"text":"        output_shape=output_shape,"},{"line":405,"text":"        noiser=noiser,"},{"line":406,"text":"        conditionings=[],"},{"line":407,"text":"        components=components,"},{"line":408,"text":"        dtype=dtype,"},{"line":409,"text":"        device=device,"},{"line":410,"text":"        noise_scale=noise_scale,"},{"line":411,"text":"        initial_latent=initial_audio_latent,"},{"line":412,"text":"    )"},{"line":413,"text":""},{"line":414,"text":"    video_state, audio_state = denoising_loop_fn("},{"line":415,"text":"        sigmas,"},{"line":416,"text":"        video_state,"},{"line":417,"text":"        audio_state,"},{"line":418,"text":"        stepper,"},{"line":419,"text":"    )"},{"line":420,"text":""},{"line":421,"text":"    video_state = video_tools.clear_conditioning(video_state)"},{"line":422,"text":"    video_state = video_tools.unpatchify(video_state)"},{"line":423,"text":"    audio_state = audio_tools.clear_conditioning(audio_state)"},{"line":424,"text":"    audio_state = audio_tools.unpatchify(audio_state)"},{"line":425,"text":""},{"line":426,"text":"    return video_state, audio_state"},{"line":427,"text":""},{"line":428,"text":""},{"line":429,"text":"_UNICODE_REPLACEMENTS = str.maketrans(\"\\u2018\\u2019\\u201c\\u201d\\u2014\\u2013\\u00a0\\u2032\\u2212\", \"''\\\"\\\"-- '-\")"},{"line":430,"text":""},{"line":431,"text":""}]}
