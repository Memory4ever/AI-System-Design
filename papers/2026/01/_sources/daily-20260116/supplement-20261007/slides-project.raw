  <script type="application/json" data-target="react-app.embeddedData">{"payload":{"codeViewRepoRoute":{"path":"/","refInfo":{"name":"main","listCacheKey":"v0:1768211155.0","canEdit":false,"refType":"branch","currentOid":"b202e60c39e19c5f9da57029fe53ff189e6642b0"},"tree":{"items":[{"name":"dataset","path":"dataset","contentType":"directory"},{"name":"docs","path":"docs","contentType":"directory"},{"name":"eval","path":"eval","contentType":"directory"},{"name":"examples/Slides","path":"examples/Slides","contentType":"directory","hasSimplifiedPath":true},{"name":"images","path":"images","contentType":"directory"},{"name":"results","path":"results","contentType":"directory"},{"name":"README.md","path":"README.md","contentType":"file"}],"totalCount":7,"templateDirectorySuggestionUrl":null,"readme":null,"showBranchInfobar":false},"userNameDisplayConfiguration":null,"treeExpanded":false,"symbolsExpanded":false,"copilotSWEAgentEnabled":false,"copilotAccessAllowed":false,"isOverview":true,"overview":{"banners":{"shouldRecommendReadme":false,"isPersonalRepo":false,"showUseActionBanner":false,"actionSlug":null,"actionId":null,"showProtectBranchBanner":false,"requiredCustomPropertyValuesMissingCount":0,"transactionalMessageBanner":null,"publishBannersInfo":{"dismissActionNoticePath":"/settings/dismiss-notice/publish_action_from_repo","releasePath":"/YunqiaoYang/SlidesGen-Bench/releases/new?marketplace=true","showPublishActionBanner":false},"interactionLimitBanner":null,"showInvitationBanner":false,"inviterName":null,"actionsMigrationBannerInfo":{"releaseTags":[],"showImmutableActionsMigrationBanner":false,"initialMigrationStatus":null},"copilotSurveyBanner":null,"showSpammyBanner":false,"blockedContributorsBanner":null,"codespacesSurveyBanner":null},"codeButton":{"contactPath":"/contact","isEnterprise":false,"local":{"protocolInfo":{"httpAvailable":true,"sshAvailable":null,"httpUrl":"https://github.com/YunqiaoYang/SlidesGen-Bench.git","showCloneWarning":null,"sshUrl":null,"sshCertificatesRequired":null,"sshCertificatesAvailable":null,"ghCliUrl":"gh repo clone YunqiaoYang/SlidesGen-Bench","defaultProtocol":"http","newSshKeyUrl":"/settings/ssh/new","setProtocolPath":"/users/set_protocol?protocol_type=clone"},"platformInfo":{"cloneUrl":"https://desktop.github.com","showVisualStudioCloneButton":false,"visualStudioCloneUrl":"https://windows.github.com","showXcodeCloneButton":false,"xcodeCloneUrl":"xcode://clone?repo=https%3A%2F%2Fgithub.com%2FYunqiaoYang%2FSlidesGen-Bench","zipballUrl":"/YunqiaoYang/SlidesGen-Bench/archive/refs/heads/main.zip"}},"newCodespacePath":"/codespaces/new?hide_repo_select=true\u0026repo=1132674557"},"popovers":{"rename":null,"renamedParentRepo":null},"commitCount":"14","overviewFiles":[{"displayName":"README.md","repoName":"SlidesGen-Bench","refName":"main","path":"README.md","preferredFileType":"readme","tabName":"README","richText":"\u003carticle class=\"markdown-body entry-content container-lg\" itemprop=\"text\"\u003e\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/images/logo.png\"\u003e\u003cimg src=\"/YunqiaoYang/SlidesGen-Bench/raw/main/images/logo.png\" alt=\"SlidesGen-Bench Logo\" width=\"400\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003cb\u003e🎯 A Comprehensive Benchmark for Evaluating AI-Generated Presentations\u003c/b\u003e\n\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003cb\u003e✅ Accepted at EMNLP 2026 (Main Conference)\u003c/b\u003e\n\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca href=\"https://arxiv.org/abs/2601.09487\" rel=\"nofollow\"\u003e\n    \u003cimg src=\"https://camo.githubusercontent.com/0f8e74fd29543dd1123e17bd60c0a87a5531b16646033637bbfc4940e3e95ec5/68747470733a2f2f696d672e736869656c64732e696f2f62616467652ff09f938425323050617065722d61725869762d623331623162\" alt=\"Paper\" data-canonical-src=\"https://img.shields.io/badge/📄%20Paper-arXiv-b31b1b\" style=\"max-width: 100%;\"\u003e\n  \u003c/a\u003e\n  \u003ca href=\"https://huggingface.co/datasets/Yqy6/Slides-Align\" rel=\"nofollow\"\u003e\n    \u003cimg src=\"https://camo.githubusercontent.com/a346aa2fa244be74b0850963b8171c18f76077acdc997e1143b7387025cfcb41/68747470733a2f2f696d672e736869656c64732e696f2f62616467652ff09fa497253230446174617365742d536c696465732d2d416c69676e312e356b2d79656c6c6f77\" alt=\"Dataset\" data-canonical-src=\"https://img.shields.io/badge/🤗%20Dataset-Slides--Align1.5k-yellow\" style=\"max-width: 100%;\"\u003e\n  \u003c/a\u003e\n  \u003ca href=\"https://slidesgenbench.yqy314.top/\" rel=\"nofollow\"\u003e\n    \u003cimg src=\"https://camo.githubusercontent.com/ccea2b1f3dea3c262dfe036361d196f06892509fee7bcde08c5adb1521e6fabb/68747470733a2f2f696d672e736869656c64732e696f2f62616467652ff09f8c90253230486f6d65706167652d576562736974652d626c7565\" alt=\"Homepage\" data-canonical-src=\"https://img.shields.io/badge/🌐%20Homepage-Website-blue\" style=\"max-width: 100%;\"\u003e\n  \u003c/a\u003e\n  \u003ca href=\"#license\"\u003e\n    \u003cimg src=\"https://camo.githubusercontent.com/784362b26e4b3546254f1893e778ba64616e362bd6ac791991d2c9e880a3a64e/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f4c6963656e73652d4d49542d677265656e2e737667\" alt=\"License\" data-canonical-src=\"https://img.shields.io/badge/License-MIT-green.svg\" style=\"max-width: 100%;\"\u003e\n  \u003c/a\u003e\n\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca href=\"#-abstract\"\u003eAbstract\u003c/a\u003e •\n  \u003ca href=\"#-installation\"\u003eInstallation\u003c/a\u003e •\n  \u003ca href=\"#-evaluation-pipeline\"\u003eEvaluation\u003c/a\u003e •\n  \u003ca href=\"#-benchmark-results\"\u003eResults\u003c/a\u003e •\n  \u003ca href=\"#-slides-align15k-dataset\"\u003eDataset\u003c/a\u003e •\n  \u003ca href=\"#-license\"\u003eLicense\u003c/a\u003e\n\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e📖 Abstract\u003c/h2\u003e\u003ca id=\"user-content--abstract\" class=\"anchor\" aria-label=\"Permalink: 📖 Abstract\" href=\"#-abstract\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe rapid evolution of Large Language Models (LLMs) has fostered diverse paradigms for automated slide generation, ranging from template-based file generation and code-driven layouts to image-centric synthesis. However, evaluating these heterogeneous systems remains challenging, as existing protocols often struggle to provide comparable scores across architectures or rely on uncalibrated judgments.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eIn this paper, we introduce \u003cstrong\u003eSlidesGen-Bench\u003c/strong\u003e, a structured evaluation protocol that assesses slide generation along three practically important dimensions:\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth align=\"center\"\u003eDimension\u003c/th\u003e\n\u003cth align=\"left\"\u003eEvaluation\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e📝 \u003cstrong\u003eContent Fidelity\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eVLM-based \u003cstrong\u003eQuizBank\u003c/strong\u003e \"open-book\" exam that quantifies information retention from the source document\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e🎨 \u003cstrong\u003eVisual Aesthetics\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eComputational metrics — \u003cstrong\u003eHarmony, Engagement, Usability, Visual Rhythm\u003c/strong\u003e — grounded in cognitive load theory and visual ergonomics\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e✏️ \u003cstrong\u003eEditability\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003ePEI\u003c/strong\u003e (Presentation Editability Intelligence), a hierarchical L0–L5 scale via format-conditional structural parsing of the generated files\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003eTo compare heterogeneous systems under one framework, all outputs are projected into the visual domain for content and aesthetic assessment, while editability is evaluated by directly parsing the underlying structural files. Each dimension is quantified with structured, verifiable pipelines rather than monolithic LLM judgment. For the highly subjective aesthetic dimensions, we construct the \u003cstrong\u003eSlides-Align1.5k\u003c/strong\u003e human preference dataset and show that our computational metrics align with human judgment substantially better than standard LLM-as-a-Judge baselines.\u003c/p\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/images/main-pipeline.jpg\"\u003e\u003cimg src=\"/YunqiaoYang/SlidesGen-Bench/raw/main/images/main-pipeline.jpg\" alt=\"Main Pipeline\" width=\"800\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e🚀 Installation\u003c/h2\u003e\u003ca id=\"user-content--installation\" class=\"anchor\" aria-label=\"Permalink: 🚀 Installation\" href=\"#-installation\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"# Clone the repository\ngit clone https://github.com/yunqiaoyang/SlidesGen-Bench.git\ncd SlidesGen-Bench\n\n# Install dependencies\npip install -r requirements.txt\"\u003e\u003cpre\u003e\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e Clone the repository\u003c/span\u003e\ngit clone https://github.com/yunqiaoyang/SlidesGen-Bench.git\n\u003cspan class=\"pl-c1\"\u003ecd\u003c/span\u003e SlidesGen-Bench\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e Install dependencies\u003c/span\u003e\npip install -r requirements.txt\u003c/pre\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e📦 Additional Setup\u003c/h3\u003e\u003ca id=\"user-content--additional-setup\" class=\"anchor\" aria-label=\"Permalink: 📦 Additional Setup\" href=\"#-additional-setup\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eConfigure \u003cstrong\u003ePaddleOCR DocLayout Detection\u003c/strong\u003e for layout analysis:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e📖 \u003ca href=\"https://www.paddleocr.ai/latest/version3.x/module_usage/layout_detection.html#_4\" rel=\"nofollow\"\u003ePaddleOCR Documentation\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eWe use the \u003ccode\u003ePP-DocLayout_plus-L\u003c/code\u003e model.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e📑 PPTX to Image Conversion\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eFor PPTX files, we use \u003cstrong\u003eLibreOffice\u003c/strong\u003e for conversion:\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e📖 \u003ca href=\"https://www.libreoffice.org/get-help/documentation/\" rel=\"nofollow\"\u003eOfficial LibreOffice Documentation\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e🔬 Evaluation Pipeline\u003c/h2\u003e\u003ca id=\"user-content--evaluation-pipeline\" class=\"anchor\" aria-label=\"Permalink: 🔬 Evaluation Pipeline\" href=\"#-evaluation-pipeline\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe benchmark projects all outputs into consistent visual renderings and structural schemas before evaluation. Content and aesthetic evaluation operate on rendered visual outputs (making scores comparable across template-based, code-driven, and image-centric systems), while editability is measured through format-conditional structural parsing.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e📝 Step 1: Content Evaluation (QuizBank)\u003c/h3\u003e\u003ca id=\"user-content--step-1-content-evaluation-quizbank\" class=\"anchor\" aria-label=\"Permalink: 📝 Step 1: Content Evaluation (QuizBank)\" href=\"#-step-1-content-evaluation-quizbank\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eContent quality is evaluated with a structured VLM-based \u003cstrong\u003eQuizBank\u003c/strong\u003e protocol, constructed from the source documents themselves rather than a single black-box LLM prompt.\u003c/p\u003e\n\u003cdetails\u003e\u003csummary\u003eDetails\u003c/summary\u003e\n\u003cb\u003e🧩 QuizBank Construction\u003c/b\u003e\n\u003cp dir=\"auto\"\u003eThe QuizBank is built by a three-phase multi-agent pipeline on the source documents:\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003ePhase I — Drafting:\u003c/strong\u003e A \u003cem\u003eForensic Analyst\u003c/em\u003e agent scans the full source document (100k+ tokens) and extracts high-value information into a draft JSON of key points.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePhase II — Critic:\u003c/strong\u003e A cyclic feedback loop performs hallucination checks, quote verification, and gap expansion, producing a refined evidence JSON.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePhase III — Exam Setting:\u003c/strong\u003e An \u003cem\u003eExam Setter\u003c/em\u003e agent converts the evidence into a standardized probe of exactly \u003cstrong\u003e10 MCQs per document\u003c/strong\u003e — 5 Concept Questions (high-level understanding) and 5 Data Questions (specific details). All questions are manually verified by the authors.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp align=\"center\" dir=\"auto\"\u003e\n  \u003ca target=\"_blank\" rel=\"noopener noreferrer\" href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/images/quizbank-pipeline.png\"\u003e\u003cimg src=\"/YunqiaoYang/SlidesGen-Bench/raw/main/images/quizbank-pipeline.png\" alt=\"QuizBank Construction Pipeline\" width=\"800\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003c/p\u003e\n\u003c/details\u003e\n\u003cdetails\u003e\u003csummary\u003eDetails\u003c/summary\u003e\n\u003cb\u003e📖 QuizBank Evaluation (Open-Book Exam)\u003c/b\u003e\n\u003cp dir=\"auto\"\u003eTo decouple visual extraction from semantic comprehension, slides are first parsed into structured Markdown by a VLM; the evaluator VLM then answers QuizBank questions relying \u003cem\u003esolely\u003c/em\u003e on this slide-derived context. Accuracy rates serve as a proxy for content quality. A human audit shows that only \u003cstrong\u003e1.2%\u003c/strong\u003e of errors stem from VLM extraction failures.\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"# Run content evaluation\npython eval/quantitative_eval.py --products Kimi-Standard Kimi-Smart Kimi-Banana NotebookLM Quake Zhipu Gamma Skywork Skywork-Banana --source-mode all --eval-mode content_only --use-grids --workers 4\n\n# Calculate quiz accuracy and generate results\npython eval/calculate_quiz_accuracy.py --input results/content_eval.json --quiz-data dataset/slidegen-test.json --output results\"\u003e\u003cpre\u003e\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e Run content evaluation\u003c/span\u003e\npython eval/quantitative_eval.py --products Kimi-Standard Kimi-Smart Kimi-Banana NotebookLM Quake Zhipu Gamma Skywork Skywork-Banana --source-mode all --eval-mode content_only --use-grids --workers 4\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e Calculate quiz accuracy and generate results\u003c/span\u003e\npython eval/calculate_quiz_accuracy.py --input results/content_eval.json --quiz-data dataset/slidegen-test.json --output results\u003c/pre\u003e\u003c/div\u003e\n\u003c/details\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e🎨 Step 2: Aesthetics Evaluation\u003c/h3\u003e\u003ca id=\"user-content--step-2-aesthetics-evaluation\" class=\"anchor\" aria-label=\"Permalink: 🎨 Step 2: Aesthetics Evaluation\" href=\"#-step-2-aesthetics-evaluation\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e📐 Core Aesthetics Metrics\u003c/h4\u003e\u003ca id=\"user-content--core-aesthetics-metrics\" class=\"anchor\" aria-label=\"Permalink: 📐 Core Aesthetics Metrics\" href=\"#-core-aesthetics-metrics\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eFour computational metrics, grounded in cognitive load theory and visual ergonomics, assess both the \u003cem\u003espatial quality\u003c/em\u003e (single slide) and the \u003cem\u003etemporal coherence\u003c/em\u003e (deck pacing):\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth align=\"left\"\u003eMetric\u003c/th\u003e\n\u003cth align=\"left\"\u003eDescription\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eHarmony\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003e🎨 Fit to harmonic hue templates in HSV space, with a deck-level penalty for cross-slide inconsistency\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eEngagement\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003e🌈 Colorfulness via Hasler \u0026amp; Süsstrunk's opponent-channel method, plus a deck-level pacing score\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eUsability\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003e🔲 Layout-aware figure-ground contrast within detected text regions (WCAG luminance, logarithmic normalization to the 21:1 ratio)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eVisual Rhythm\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003e📊 \u003cstrong\u003eVisualHRV\u003c/strong\u003e: subband entropy for per-slide clutter combined with RMSSD for temporal variability\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python eval/aesthetics_metrics.py IMAGE_PATH [OPTIONS]\"\u003e\u003cpre\u003epython eval/aesthetics_metrics.py IMAGE_PATH [OPTIONS]\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eExample Usage:\u003c/strong\u003e\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python eval/quantitative_eval.py --eval-mode aesthetics_only --products Your_product\"\u003e\u003cpre\u003epython eval/quantitative_eval.py --eval-mode aesthetics_only --products Your_product\u003c/pre\u003e\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e📖 For detailed configuration, see \u003ca href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/docs/Aesthetics_config.md\"\u003eAesthetics Configuration Guide\u003c/a\u003e\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e🤖 LLM-as-Judge Methods\u003c/h4\u003e\u003ca id=\"user-content--llm-as-judge-methods\" class=\"anchor\" aria-label=\"Permalink: 🤖 LLM-as-Judge Methods\" href=\"#-llm-as-judge-methods\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eWe also provide LLM-based evaluation methods (used as baselines in the paper):\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth align=\"left\"\u003eMethod\u003c/th\u003e\n\u003cth align=\"left\"\u003eDescription\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eLLM Rating\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eDirect scoring by language models\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"left\"\u003e\u003cstrong\u003eLLM Arena\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003ePairwise comparison with ELO ranking\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e📖 See \u003ca href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/docs/LLM_EVALUATION.md\"\u003eLLM Evaluation Guide\u003c/a\u003e for detailed documentation\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e✏️ Step 3: Presentation Editability Intelligence (PEI)\u003c/h3\u003e\u003ca id=\"user-content-️-step-3-presentation-editability-intelligence-pei\" class=\"anchor\" aria-label=\"Permalink: ✏️ Step 3: Presentation Editability Intelligence (PEI)\" href=\"#️-step-3-presentation-editability-intelligence-pei\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eEvaluate presentation editability with the \u003cstrong\u003ePEI\u003c/strong\u003e framework — a hierarchical scale from static visual mimicry (L0–L2) to fully editable, narrative presentations (L3–L5), scored with a dependency-based \u003cstrong\u003eknockout rule\u003c/strong\u003e (failing a lower level precludes credit at higher ones). The benchmark evaluates PEI levels fully automatically by parsing the underlying structural files (Office Open XML schemas via \u003ccode\u003epython-pptx\u003c/code\u003e, DOM trees for HTML).\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth align=\"center\"\u003eLevel\u003c/th\u003e\n\u003cth align=\"left\"\u003eClass Name\u003c/th\u003e\n\u003cth align=\"left\"\u003eTechnical Hallmark\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL5\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eCinematic\u003c/td\u003e\n\u003ctd align=\"left\"\u003eAnimation logic, native media embeds\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL4\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eParametric\u003c/td\u003e\n\u003ctd align=\"left\"\u003eNative data objects (\u003ccode\u003e\u0026lt;c:chart\u0026gt;\u003c/code\u003e, SmartArt)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL3\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eStructural\u003c/td\u003e\n\u003ctd align=\"left\"\u003eGlobal masters (\u003ccode\u003e\u0026lt;p:sldMaster\u0026gt;\u003c/code\u003e), logical grouping\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL2\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eVector\u003c/td\u003e\n\u003ctd align=\"left\"\u003eSVG paths, scalable vector primitives\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL1\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003ePatchwork\u003c/td\u003e\n\u003ctd align=\"left\"\u003eEditable text, raster backgrounds\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd align=\"center\"\u003e\u003cstrong\u003eL0\u003c/strong\u003e\u003c/td\u003e\n\u003ctd align=\"left\"\u003eStatic\u003c/td\u003e\n\u003ctd align=\"left\"\u003eFully flattened pixels\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e📄 \u003cstrong\u003eReference:\u003c/strong\u003e \u003ca href=\"/YunqiaoYang/SlidesGen-Bench/blob/main/docs/pei.md\"\u003ePEI Evaluation Protocol\u003c/a\u003e\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e👥 Step 4: Reliability Verification via Human Alignment\u003c/h3\u003e\u003ca id=\"user-content--step-4-reliability-verification-via-human-alignment\" class=\"anchor\" aria-label=\"Permalink: 👥 Step 4: Reliability Verification via Human Alignment\" href=\"#-step-4-reliability-verification-via-human-alignment\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eTo verify the reliability of the evaluation scheme, the benchmark integrates a human-preference validation stage on the \u003cstrong\u003eSlides-Align1.5k\u003c/strong\u003e dataset. Reliability is quantified with three indicators: \u003cstrong\u003eAverage Spearman correlation\u003c/strong\u003e, its \u003cstrong\u003eStandard Deviation\u003c/strong\u003e, and the \u003cstrong\u003eAverage Identical ratio\u003c/strong\u003e.\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e🏆 Benchmark Results\u003c/h2\u003e\u003ca id=\"user-content--benchmark-results\" class=\"anchor\" aria-label=\"Permalink: 🏆 Benchmark Results\" href=\"#-benchmark-results\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e The reported results are a \u003cstrong\u003edated v1.0 snapshot\u003c/strong\u003e: all commercial systems were accessed between November and December 2025. All generated artifacts and scoring scripts are open-sourced to support reruns and versioned updates.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e📝 Content: QuizBank Accuracy (%)\u003c/h3\u003e\u003ca id=\"user-content--content-quizbank-accuracy-\" class=\"anchor\" aria-label=\"Permalink: 📝 Content: QuizBank Accuracy (%)\" href=\"#-content-quizbank-accuracy-\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth align=\"left\"\u003eProduct\u003c/th\u003e\n\u003cth align=\"center\"\u003eBrand Promote\u003c/th\u003e\n\u003cth align=\"center\"\u003eBusiness Plan\u003c/th\u003e\n\u003