<th id="S4.T1.5.15.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r ltx_border_t"><span id="S4.T1.5.15.1.1" class="ltx_text" style="font-size:90%;">13</span></th>
<td id="S4.T1.5.15.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.5.15.2.1" class="ltx_text" style="font-size:90%;">All</span></td>
<td id="S4.T1.5.15.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.5.15.3.1" class="ltx_text" style="font-size:90%;">51.54%+-24.52</span></td>
<td id="S4.T1.5.15.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.5.15.4.1" class="ltx_text" style="font-size:90%;">20.22%+-18</span></td>
