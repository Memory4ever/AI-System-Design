{"data":{"id":"10.48550/arxiv.2601.09215","type":"dois","attributes":{"doi":"10.48550/arxiv.2601.09215","prefix":"10.48550","suffix":"arxiv.2601.09215","identifiers":[{"identifier":"2601.09215","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2601.09215"}],"creators":[{"name":"Zhang, Feng","nameType":"Personal","givenName":"Feng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shijia","nameType":"Personal","givenName":"Shijia","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Chunmao","nameType":"Personal","givenName":"Chunmao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Zhanyu","nameType":"Personal","givenName":"Zhanyu","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Jun","nameType":"Personal","givenName":"Jun","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Jiuchong","nameType":"Personal","givenName":"Jiuchong","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Hao, Jinghua","nameType":"Personal","givenName":"Jinghua","familyName":"Hao","affiliation":[],"nameIdentifiers":[]},{"name":"He, Renqing","nameType":"Personal","givenName":"Renqing","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Jingwen","nameType":"Personal","givenName":"Jingwen","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Han","nameType":"Personal","givenName":"Han","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UserLM-R1: Modeling Human Reasoning in User Language Models with Multi-Reward Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-01-14T06:42:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-15T01:22:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"User simulators serve as the critical interactive environment for agent post-training, and an ideal user simulator generalizes across domains and proactively engages in negotiation by challenging or bargaining. However, current methods exhibit two issues. They rely on static and context-unaware profiles, necessitating extensive manual redesign for new scenarios, thus limiting generalizability. Moreover, they neglect human strategic thinking, leading to vulnerability to agent manipulation. To address these issues, we propose UserLM-R1, a novel user language model with reasoning capability. Specifically, we first construct comprehensive user profiles with both static roles and dynamic scenario-specific goals for adaptation to diverse scenarios. Then, we propose a goal-driven decision-making policy to generate high-quality rationales before producing responses, and further refine the reasoning and improve strategic capabilities with supervised fine-tuning and multi-reward reinforcement learning. Extensive experimental results demonstrate that UserLM-R1 outperforms competitive baselines, particularly on the more challenging adversarial set.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2601.09215","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-01-15T02:40:49.000Z","registered":"2026-01-15T02:40:50.000Z","published":"2026","updated":"2026-01-15T02:40:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2601.09215","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}