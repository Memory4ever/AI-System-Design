<span id="A1.I4.i5.I1.i1.p1.1" class="ltx_p"><span id="A1.I4.i5.I1.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Vector: </span><span id="A1.I4.i5.I1.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.00, 0.05, 0.04, -0.81]</span></span>
</span></span>
<span id="A1.I4.i5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I4.i5.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
