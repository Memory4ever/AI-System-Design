<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_Math" alttext="~=\mathbf{0.104666}" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" lspace="0.608em" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" class="ltx_mathvariant_bold" mathcolor="#000000" mathvariant="bold">0.104666</mn></mrow><annotation encoding="application/x-tex">~=\mathbf{0.104666}</annotation></semantics></math></span>
