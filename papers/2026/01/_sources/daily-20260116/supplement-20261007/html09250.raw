<span id="A1.I4.i5.p1.1" class="ltx_p"><span id="A1.I4.i5.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">R5</span></span>
<span id="A1.I4.i5.I1" class="ltx_itemize">
