<span id="A1.I4.i2.I1.i3.p1.1" class="ltx_p"><span id="A1.I4.i2.I1.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Squared deviations: </span><span id="A1.I4.i2.I1.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.01380625, 0.01265625, 0.11055625, 0.10725625]</span></span>
</span></span>
<span id="A1.I4.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I4.i2.I1.i4.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A1.I4.i2.I1.i4.p1" class="ltx_para">
<span id="A1.I4.i2.I1.i4.p1.1" class="ltx_p"><span id="A1.I4.i2.I1.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Population variance (R2) </span><math id="A1.I4.i2.I1.i4.p1.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math><span id="A1.I4.i2.I1.i4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I4.i2.I1.i4.p1.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">0.061069</span></span>
</span></span>
</span>
</span></span>
<span id="A1.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I4.i3.p1" class="ltx_para">
<span id="A1.I4.i3.p1.1" class="ltx_p"><span id="A1.I4.i3.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">R3</span></span>
<span id="A1.I4.i3.I1" class="ltx_itemize">
