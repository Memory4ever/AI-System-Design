<span id="A1.I6.i5.p1.1" class="ltx_p"><span id="A1.I6.i5.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">R5:</span><span id="A1.I6.i5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="A1.I6.i5.p1.m1" class="ltx_Math" alttext="\theta_{cf}=0.132650\Rightarrow\hat{\theta}_{cf}=0.530600" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.132650</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.530600</mn></mrow><annotation encoding="application/x-tex">\theta_{cf}=0.132650\Rightarrow\hat{\theta}_{cf}=0.530600</annotation></semantics></math><span id="A1.I6.i5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">;  </span><math id="A1.I6.i5.p1.m2" class="ltx_Math" alttext="R=\tfrac{1}{2}(0.530600)+\tfrac{1}{2}(0.85962)=\mathbf{0.695110}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" 