</span></span>
<span id="A1.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I6.i3.p1" class="ltx_para">
<span id="A1.I6.i3.p1.1" class="ltx_p"><span id="A1.I6.i3.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">R3:</span><span id="A1.I6.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="A1.I6.i3.p1.m1" class="ltx_Math" alttext="\theta_{cf}=0.029075\Rightarrow\hat{\theta}_{cf}=0.116300" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.029075</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.116300</mn></mrow><annotation encoding="application/x-tex">\theta_{cf}=0.029075\Rightarrow\hat{\theta}_{cf}=0.116300</annotation></semantics></math><span id="A1.I6.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">;  </span><math id="A1.I6.i3.p1.m2" class="ltx_Math" alttext="R=\tfrac{1}{2}(0.116300)+\tfrac{1}{2}(0.85962)=\mathbf{0.487960}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.116300</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.85962</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" class="ltx_mathvariant_bold" mathcolor="#000000" mathvariant="bold">0.487960</mn></mrow><annotation encoding="application/x-tex">R=\tfrac{1}{2}(0.116300)+\tfrac{1}{2}(0.85962)=\mathbf{0.487960}</annotation></semantics></math><span id="A1.I6.i3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">  (</span><span id="A1.I6.i3.p1.1.5" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">mitigate</span><span id="A1.I6.i3.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></span>
</span></span>
<span id="A1.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
