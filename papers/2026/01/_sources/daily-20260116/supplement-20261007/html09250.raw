<span id="A1.I7.i6.p1.1" class="ltx_p"><span id="A1.I7.i6.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Final SFV (before):</span></span>
<span id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\boxed{0.104666\pm 0.050488}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.104666</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.050488</mn></mrow></menclose><annotation encoding="application/x-tex">\boxed{0.104666\pm 0.050488}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
</span>
<span id="A1.p1.pic1.2.15" class="ltx_p"><span id="A1.p1.pic1.2.15.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">After mitigation:<span id="A1.p1.pic1.2.15.1.1" class="ltx_text"></span></span></span>
<span id="A1.I8" class="ltx_itemize">
<span id="A1.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I8.i1.p1" class="ltx_para">
<span id="A1.I8.i1.p1.1" class="ltx_p"><math id="A1.I8.i1.p1.m1" class="ltx_Math" alttext="\theta_{cf}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{cf}</annotation></semantics></math><span id="A1.I8.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> values:
</span><span id="A1.I8.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.000069, 0.000069, 0.000069, 0.000069, 0.000069]</span></span>
</span></span>
<span id="A1.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I8.i2.p1" class="ltx_para">
<span id="A1.I8.i2.p1.1" class="ltx_p"><span id="A1.I8.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Mean:</span></span>
<span id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\mu=0.000069" display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.000069</mn></mrow><annotation encoding="application/x-tex">\mu=0.000069</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
<span id="A1.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I8.i3.p1" class="ltx_para">
<span id="A1.I8.i3.p1.1" class="ltx_p"><span id="A1.I8.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">All deviations are zero:</span></span>
<span id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="(x_{i}-\mu)^{2}=0" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">(x_{i}-\mu)^{2}=0</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
<span id="A1.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I8.i4.p1" class="ltx_para">
<span id="A1.I8.i4.p1.1" class="ltx_p"><span id="A1.I8.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Variance and std:</span></span>
<span id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\sigma^{2}=0,\quad\sigma=0" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}=0,\quad\sigma=0</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
<span id="A1.I8.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I8.i5.p1" class="ltx_para">
<span id="A1.I8.i5.p1.1" class="ltx_p"><span id="A1.I8.i5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Final SFV (after):</span></span>
<span id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\boxed{0.000069\pm 0.000000}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.000069</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.000000</mn></mrow></menclose><annotation encoding="application/x-tex">\boxed{0.000069\pm 0.000000}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
</span>
<span id="A1.p1.pic1.2.16" class="ltx_p"><span id="A1.p1.pic1.2.16.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Step 7: Entity Fairness Dispersion (EFD).<span id="A1.p1.pic1.2.16.1.1" class="ltx_text ltx_font_medium">
For each entity index <math id="A1.p1.pic1.m14" class="ltx_Math" alttext="j\in\{1,2,3,4\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,2,3,4\}</annotation></semantics></math>, take the <em id="A1.p1.pic1.2.16.1.1.1" class="ltx_emph ltx_font_italic">population variance across the five records</em> (column-wise variance on <span id="A1.p1.pic1.2.16.1.1.2" class="ltx_text ltx_font_typewriter">sigma_q_e</span>). This gives four numbers (one per entity); EFD is reported as <em id="A1.p1.pic1.2.16.1.1.3" class="ltx_emph ltx_font_italic">mean<math id="A1.p1.pic1.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>population std</em> over these four.</span></span></span>
<span id="A1.p1.pic1.2.17" class="ltx_p"><span id="A1.p1.pic1.2.17.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Per-entity variance example (Entity 2 across records).<span id="A1.p1.pic1.2.17.1.1" class="ltx_text"></span></span></span>
<span id="A1.I9" class="ltx_itemize">
<span id="A1.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I9.i1.p1" class="ltx_para">
<span id="A1.I9.i1.p1.1" class="ltx_p"><span id="A1.I9.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Values (Entity 2 across </span><math id="A1.I9.i1.p1.m1" class="ltx_Math" alttext="R1{\ldots}R5" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn></mrow><annotation encoding="application/x-tex">R1{\ldots}R5</annotation></semantics></math><span id="A1.I9.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">): </span><span id="A1.I9.i1.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.07, -0.42, -0.85, 0.10, 0.05]</span></span>
</span></span>
<span id="A1.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I9.i2.p1" class="ltx_para">
<span id="A1.I9.i2.p1.1" class="ltx_p"><span id="A1.I9.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Mean </span><math id="A1.I9.i2.p1.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math><span id="A1.I9.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I9.i2.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">-0.2100</span></span>
</span></span>
<span id="A1.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I9.i3.p1" class="ltx_para">
<span id="A1.I9.i3.p1.1" class="ltx_p"><span id="A1.I9.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Squared deviations </span><math id="A1.I9.i3.p1.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math><span id="A1.I9.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I9.i3.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.078400, 0.044100, 0.409600, 0.096100, 0.067600]</span></span>
</span></span>
<span id="A1.I9.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I9.i4.p1" class="ltx_para">
<span id="A1.I9.i4.p1.1" class="ltx_p"><span id="A1.I9.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Population variance (divide by </span><math id="A1.I9.i4.p1.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math><span id="A1.I9.i4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">) </span><math id="A1.I9.i4.p1.m2" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math><span id="A1.I9.i4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I9.i4.p1.1.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">0.139160</span></span>
</span></span>
</span>
<span id="A1.p1.pic1.2.18" class="ltx_p"><span id="A1.p1.pic1.2.18.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">EFD vector (all four entities).<span id="A1.p1.pic1.2.18.1.1" class="ltx_text"></span></span></span>
<span id="A1.I10" class="ltx_itemize">
<span id="A1.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I10.i1.p1" class="ltx_para">
<span id="A1.I10.i1.p1.1" class="ltx_p"><span id="A1.I10.i1.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Before:</span><span id="A1.I10.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I10.i1.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.151016, 0.139160, 0.075256, 0.024456]</span></span>
</span></span>
<span id="A1.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I10.i2.p1" class="ltx_para">
<span id="A1.I10.i2.p1.1" class="ltx_p"><span id="A1.I10.i2.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">After:</span><span id="A1.I10.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I10.i2.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0.002496, 0.002496, 0.002496, 0.002496]</span></span>
</span></span>
</span>
<span id="A1.p1.pic1.2.19" class="ltx_p"><span id="A1.p1.pic1.2.19.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Compute EFD (mean) and population std across the four entity variances.<span id="A1.p1.pic1.2.19.1.1" class="ltx_text"></span></span></span>
<span id="A1.p1.pic1.2.20" class="ltx_p"><span id="A1.p1.pic1.2.20.1" class="ltx_text ltx_underline" style="--ltx-fg-color:#000000;">Before mitigation</span><span id="A1.p1.pic1.2.20.2" class="ltx_text"></span></span>
<span id="A1.I11" class="ltx_itemize">
<span id="A1.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I11.i1.p1" class="ltx_para">
<span id="A1.I11.i1.p1.1" class="ltx_p"><span id="A1.I11.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Mean (EFD):</span></span>
<span id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\mu=\frac{0.151016+0.139160+0.075256+0.024456}{4}=\mathbf{0.097472}" display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.151016</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.139160</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.075256</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.024456</mn></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" class="ltx_mathvariant_bold" mathcolor="#000000" mathvariant="bold">0.097472</mn></mrow><annotation encoding="application/x-tex">\mu=\frac{0.151016+0.139160+0.075256+0.024456}{4}=\mathbf{0.097472}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
<span id="A1.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A1.I11.i2.p1" class="ltx_para">
<span id="A1.I11.i2.p1.1" class="ltx_p"><span id="A1.I11.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Squared deviations:</span></span>
<span id="A1.Ex19" class="ltx_equation ltx_eqn_table">

