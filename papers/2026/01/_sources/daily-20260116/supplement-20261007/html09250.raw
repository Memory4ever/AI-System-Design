<span id="A1.I4.i1.I1.i2.p1.1" class="ltx_p"><span id="A1.I4.i1.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Mean </span><math id="A1.I4.i1.I1.i2.p1.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math><span id="A1.I4.i1.I1.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.I4.i1.I1.i2.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">-0.1775</span></span>
</span></span>
