mathcolor="#000000">2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.562275</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.85962</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" class="ltx_mathvariant_bold" mathcolor="#000000" mathvariant="bold">0.710947</mn></mrow><annotation encoding="application/x-tex">R=\tfrac{1}{2}(0.562275)+\tfrac{1}{2}(0.85962)=\mathbf{0.710947}</annotation></semantics></math><span id="A1.I6.i4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">  (</span><span id="A1.I6.i4.p1.1.5" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">mitigate</span><span id="A1.I6.i4.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></span>
</span></span>
<span id="A1.I6.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
