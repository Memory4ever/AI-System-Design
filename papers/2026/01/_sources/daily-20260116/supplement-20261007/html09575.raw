<td id="S5.T5.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t">yes</td>
<td id="S5.T5.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t">&gt;1 hr</td></tr>
<tr id="S5.T5.4.1.3" class="ltx_tr">
<th id="S5.T5.4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ObjectGS <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib77" title="" class="ltx_ref">Zhu et al., 2025</a>]</cite></th>
