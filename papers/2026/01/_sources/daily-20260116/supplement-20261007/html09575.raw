<tr id="S5.T5.4.1.4" class="ltx_tr">
<th id="S5.T5.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t">OpenVoxel (Ours)</th>
<td id="S5.T5.4.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">no</td>
