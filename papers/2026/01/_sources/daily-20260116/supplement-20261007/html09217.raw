<span id="S3.Ex60"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex60.2.1" class="ltx_text ltx_inline-block" style="width:0.0pt;--ltx-fg-color:#0000FF;">// <math id="S3.Ex60.m1" class="ltx_math_unparsed" alttext="\Gamma;\iota_{\mathit{in}}=\epsilon\land\iota_{\mathit{out}}=0\cdots(N-2)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathvariant="normal">Γ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">;</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ϵ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑜𝑢𝑡</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋯</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma;\iota_{\mathit{in}}=\epsilon\land\iota_{\mathit{out}}=0\cdots(N-2)</annotation></semantics></math></span></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright" colspan="4"></span></span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>Translation for the running example. The left side shows the original program, and the right side shows the transformed program.
Comments indicate <math id="S3.F7.m2" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> at each program point.
(Here, for simplicity, we omit conditions that are not relevant to buffering or stream replacement.)</figcaption>
</figure>
<div id="Thmexample3" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample3.1" class="ltx_text ltx_font_bold">Example 3</span></span></h6>
<div id="Thmexample3.p1" class="ltx_para">
<p id="Thmexample3.p1.1" class="ltx_p">Recall the program in Example <a href="#Thmexample1" title="Example 1 ‣ 2.1 Syntax of the Languages ‣ 2 Language ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>:</p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex62.m1" class="ltx_Math" alttext="\displaystyle\mathbf{for}(x:=0;x\neq N;x:=x+1)" display="inline" intent=":literal"><semantics><mrow><mi>𝐟𝐨𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mi>N</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{for}(x:=0;x\neq N;x:=x+1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\{in[x]:=x\};" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>i</mi><mi>n</mi><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>:=</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\{in[x]:=x\};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\mathbf{for}(x:=0;x\neq N-1;x:=x+1)" display="inline" intent=":literal"><semantics><mrow><mi>𝐟𝐨𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{for}(x:=0;x\neq N-1;x:=x+1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\quad\{y_{0}:=in[x];y_{1}:=in[x+1];z_{0}:=y_{0}+y_{1};z_{1}:=z_{0}/2;out[x]:=z_{1}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>:=</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>;</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>:=</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>;</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>:=</mo><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>+</mo><msub><mi>y</mi><mn>1</mn></msub></mrow></mrow><mo>;</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>:=</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>/</mo><mn>2</mn></mrow></mrow><mo>;</mo><mrow><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow><mo>:=</mo><msub><mi>z</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\{y_{0}:=in[x];y_{1}:=in[x+1];z_{0}:=y_{0}+y_{1};z_{1}:=z_{0}/2;out[x]:=z_{1}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample3.p1.2" class="ltx_p">It is transformed as shown in Figure <a href="#S3.F7" title="Figure 7 ‣ 3.2 Translation Rules ‣ 3 Formalization of Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.
For readability, instead of showing a derivation tree based on the transformation rules,
the figure shows the source and target programs side-by-side, with <math id="Thmexample3.p1.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> for each program point
shown as a comment.
The type environment <math id="Thmexample3.p1.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> used in the translation is:</p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex66.m1" class="ltx_Math" alttext="\displaystyle\mathit{in}\mathbin{:}\mathbf{rarray},\mathit{out}\mathbin{:}\mathbf{warray},y_{0}\mathbin{:}\mathbf{int},y_{1}\mathbin{:}\mathbf{int},z_{0}\mathbin{:}\mathbf{int},z_{1}\mathbin{:}\mathbf{int},b_{0}\mathbin{:}\mathbf{buf},b_{1}\mathbin{:}\mathbf{buf}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑖𝑛</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><mi>𝑜𝑢𝑡</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐛𝐮𝐟</mi></mrow><mo>,</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐛𝐮𝐟</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathit{in}\mathbin{:}\mathbf{rarray},\mathit{out}\mathbin{:}\mathbf{warray},y_{0}\mathbin{:}\mathbf{int},y_{1}\mathbin{:}\mathbf{int},z_{0}\mathbin{:}\mathbf{int},z_{1}\mathbin{:}\mathbf{int},b_{0}\mathbin{:}\mathbf{buf},b_{1}\mathbin{:}\mathbf{buf}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample3.p1.3" class="ltx_p">For example, the three lines before the second for-loop represent the judgment:</p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex67.m1" class="ltx_math_unparsed" alttext="\displaystyle\Gamma^{\sharp}\vdash\{\iota_{\mathit{in}}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">♯</mi></msup><mo>⊢</mo><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>𝑖𝑛</mi></msub><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Gamma^{\sharp}\vdash\{\iota_{\mathit{in}}=0</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex67.m2" class="ltx_math_unparsed" alttext="\displaystyle\cdots(N-1)\land\iota_{\mathit{out}}=\emptyset\}\bullet\Longrightarrow" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∧</mo><msub><mi>ι</mi><mi>𝑜𝑢𝑡</mi></msub><mo>=</mo><mi mathvariant="normal">∅</mi><mo rspace="0.055em" stretchy="false">}</mo><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdots(N-1)\land\iota_{\mathit{out}}=\emptyset\}\bullet\Longrightarrow</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex68.m1" class="ltx_math_unparsed" alttext="\displaystyle b_{0}:={\mathit{in}}.read()\{\iota_{\mathit{in}}=1\cdots(N-1)\land\iota_{\mathit{out}}=\emptyset\land b_{0}=\mathit{in}[0]\}." display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mn>0</mn></msub><mo>:=</mo><mi>𝑖𝑛</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>𝑖𝑛</mi></msub><mo>=</mo><mn>1</mn><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∧</mo><msub><mi>ι</mi><mi>𝑜𝑢𝑡</mi></msub><mo>=</mo><mi mathvariant="normal">∅</mi><mo>∧</mo><msub><mi>b</mi><mn>0</mn></msub><mo>=</mo><mi>𝑖𝑛</mi><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle b_{0}:={\mathit{in}}.read()\{\iota_{\mathit{in}}=1\cdots(N-1)\land\iota_{\mathit{out}}=\emptyset\land b_{0}=\mathit{in}[0]\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample3.p1.4" class="ltx_p">It is obtained by using the rules <span id="Thmexample3.p1.4.1" class="ltx_text ltx_font_smallcaps">Tr-InsRBuf</span> and <span id="Thmexample3.p1.4.2" class="ltx_text ltx_font_smallcaps">Tr-InsConseq</span> as in the previous example.
∎</p>
</div>
</div>
<div id="S3.SS2.p9" class="ltx_para">
<p id="S3.SS2.p9.1" class="ltx_p">Note that the order of array access does not matter
as long as the producer and consumer follow the same access sequence.
For example, consider a filter program that reads only the even indices of the input array.
In this case, the access sequence in the pre-/post-condition becomes <math id="S3.SS2.p9.m1" class="ltx_math_unparsed" alttext="\iota_{\mathit{in}}=0\cdot 2\cdots(2N-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>𝑖𝑛</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mi>N</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota_{\mathit{in}}=0\cdot 2\cdots(2N-2)</annotation></semantics></math>.
While Vitis HLS cannot apply burst data transfer optimization to such non-consecutive patterns,
our translation treats them in the same way as for a program with consecutive accesses.
Similarly, the programs in Figure <a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> can be translated identically,
regardless of whether the access order is forward or reversed.</p>
</div>
<div id="Thmexample4" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample4.1" class="ltx_text ltx_font_bold">Example 4</span></span></h6>
<div id="Thmexample4.p1" class="ltx_para">
<p id="Thmexample4.p1.1" class="ltx_p">Figure <a href="#S3.F8" title="Figure 8 ‣ 3.2 Translation Rules ‣ 3 Formalization of Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> shows a translation
for a program that merges two arrays <math id="Thmexample4.p1.m1" class="ltx_Math" alttext="\mathit{in}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝑖𝑛</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathit{in}_{1}</annotation></semantics></math> and <math id="Thmexample4.p1.m2" class="ltx_Math" alttext="\mathit{in}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝑖𝑛</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathit{in}_{2}</annotation></semantics></math> into <math id="Thmexample4.p1.m3" class="ltx_Math" alttext="\mathit{out}" display="inline" intent=":literal"><semantics><mi>𝑜𝑢𝑡</mi><annotation encoding="application/x-tex">\mathit{out}</annotation></semantics></math> in the increasing order,
assuming that the elements of <math id="Thmexample4.p1.m4" class="ltx_Math" alttext="\mathit{in}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝑖𝑛</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathit{in}_{1}</annotation></semantics></math> and <math id="Thmexample4.p1.m5" class="ltx_Math" alttext="\mathit{in}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝑖𝑛</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathit{in}_{2}</annotation></semantics></math> are sorted in the increasing order. For readability, the example uses the ordinary if-expressions, which is easy to support.
As in Example <a href="#Thmexample3" title="Example 3 ‣ 3.2 Translation Rules ‣ 3 Formalization of Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the source and target of the stream translation
are shown side-by-side, and comments denote <math id="Thmexample4.p1.m6" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> used at each program point.
We write <math id="Thmexample4.p1.m7" class="ltx_Math" alttext="i..j" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0.0835em">.</mo></mrow><mo lspace="0.0835em" rspace="0.167em">.</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i..j</annotation></semantics></math> for the sequence consisting of integers from <math id="Thmexample4.p1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> to <math id="Thmexample4.p1.m9" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>; it denotes the empty sequence
<math id="Thmexample4.p1.m10" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> when <math id="Thmexample4.p1.m11" class="ltx_Math" alttext="i&gt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&gt;j</annotation></semantics></math>.
The type environment <math id="Thmexample4.p1.m12" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> is <math id="Thmexample4.p1.m13" class="ltx_Math" alttext="\mathit{in}_{1}\mathbin{:}\mathbf{rarray},\mathit{in}_{2}\mathbin{:}\mathbf{rarray},\mathit{out}\mathbin{:}\mathbf{warray},i\mathbin{:}\mathbf{int},j\mathbin{:}\mathbf{int},k\mathbin{:}\mathbf{int},x\mathbin{:}\mathbf{int},N\mathbin{:}\mathbf{int}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑖𝑛</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><msub><mi>𝑖𝑛</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><mi>𝑜𝑢𝑡</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><mi>i</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mo>,</mo><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow></mrow><annotation encoding="application/x-tex">\mathit{in}_{1}\mathbin{:}\mathbf{rarray},\mathit{in}_{2}\mathbin{:}\mathbf{rarray},\mathit{out}\mathbin{:}\mathbf{warray},i\mathbin{:}\mathbf{int},j\mathbin{:}\mathbf{int},k\mathbin{:}\mathbf{int},x\mathbin{:}\mathbf{int},N\mathbin{:}\mathbf{int}</annotation></semantics></math>. In this example, the loop invariant <math id="Thmexample4.p1.m14" class="ltx_Math" alttext="i+j=k&lt;2N\land i\leq N\land j\leq N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>=</mo><mi>k</mi><mo>&lt;</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>∧</mo><mi>i</mi></mrow><mo>≤</mo><mrow><mi>N</mi><mo>∧</mo><mi>j</mi></mrow><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i+j=k&lt;2N\land i\leq N\land j\leq N</annotation></semantics></math> is required for the translation.
In fact, in order to ensure that <math id="Thmexample4.p1.m15" class="ltx_Math" alttext="i\in\iota_{\mathit{in}_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ι</mi><msub><mi>𝑖𝑛</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">i\in\iota_{\mathit{in}_{1}}</annotation></semantics></math> in the first conditional branch, the condition <math id="Thmexample4.p1.m16" class="ltx_Math" alttext="i&lt;N" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i&lt;N</annotation></semantics></math> is required,
which can be obtained by the entailment
<math id="Thmexample4.p1.m17" class="ltx_Math" alttext="i+j&lt;2N\land j=N\Rightarrow i&lt;N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>&lt;</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>∧</mo><mi>j</mi></mrow><mo>=</mo><mi>N</mi><mo stretchy="false">⇒</mo><mi>i</mi><mo>&lt;</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i+j&lt;2N\land j=N\Rightarrow i&lt;N</annotation></semantics></math>.
Here, <math id="Thmexample4.p1.m18" class="ltx_Math" alttext="i+j&lt;2N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>j</mi></mrow><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">i+j&lt;2N</annotation></semantics></math> and <math id="Thmexample4.p1.m19" class="ltx_Math" alttext="j=N" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">j=N</annotation></semantics></math> respectively come from the loop invariant and the branching condition.
Thanks to the use of relational Hoare logic, we can correctly reason about such invariants.
∎</p>
</div>
</div>
<figure id="S3.F8" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F8.pic1" class="ltx_picture" height="602.36" overflow="visible" version="1.1" viewBox="0 0 493.64 602.36" width="493.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,602.36) matrix(1 0 0 -1 0 0) translate(248.03,0) translate(0,299.22)"><g style="--ltx-stroke-color:#F2F9F9;--ltx-fill-color:#F2F9F9;--ltx-fg-color:#F2F9F9;" color="#F2F9F9" fill="#F2F9F9" stroke="#F2F9F9"><path style="stroke:none" d="M -248.03 -299.21 M -248.03 -292.29 L -248.03 296.23 C -248.03 300.05 -244.93 303.15 -241.11 303.15 L -50.23 303.15 C -46.4 303.15 -43.31 300.05 -43.31 296.23 L -43.31 -292.29 C -43.31 -296.12 -46.4 -299.21 -50.23 -299.21 L -241.11 -299.21 C -244.93 -299.21 -248.03 -296.12 -248.03 -292.29 Z M -43.31 303.15"></path></g><g style="--ltx-stroke-color:#FFF9F2;--ltx-fill-color:#FFF9F2;--ltx-fg-color:#FFF9F2;" color="#FFF9F2" fill="#FFF9F2" stroke="#FFF9F2"><path style="stroke:none" d="M 19.69 -299.21 M 19.69 -292.29 L 19.69 296.23 C 19.69 300.05 22.78 303.15 26.6 303.15 L 217.49 303.15 C 221.31 303.15 224.41 300.05 224.41 296.23 L 224.41 -292.29 C 224.41 -296.12 221.31 -299.21 217.49 -299.21 L 26.6 -299.21 C 22.78 -299.21 19.69 -296.12 19.69 -292.29 Z M 224.41 303.15"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -240.99 -3.46)"><foreignObject style="--ltx-fo-width:34.5em;--ltx-fo-height:14.78em;--ltx-fo-depth:14.28em;font-size:10pt;" height="402.11" overflow="visible" transform="matrix(1 0 0 -1 0 204.52)" width="477.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F8.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:34.5em;">
<span id="S3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="S3.Ex69"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex69.2.1" class="ltx_text ltx_inline-block" style="font-size:80%;width:0.0pt;--ltx-fg-color:#0000FF;">// <math id="S3.Ex69.m1" class="ltx_Math" alttext="\iota_{\mathit{in}_{1}}=\iota_{\mathit{in}_{2}}=0..(N-1)\land\iota_{\mathit{out}}=\epsilon\land i=j=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></msub></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msub></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.0835em">.</mo></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0.0835em" mathcolor="#0000FF" rspace="0.167em">.</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑜𝑢𝑡</mi></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ϵ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">j</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn></mrow></mrow><annotation encoding="application/x-tex">\iota_{\mathit{in}_{1}}=\iota_{\mathit{in}_{2}}=0..(N-1)\land\iota_{\mathit{out}}=\epsilon\land i=j=0</annotation></semantics></math></span></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright" colspan="4"></span></span></span>
<span id="S3.Ex70"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex70.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbf{for}(k:=0;k\neq N*2;k:=k+1)\{" display="inline" intent=":literal"><semantics><mrow><mi>𝐟𝐨𝐫</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>:=</mo><mn>0</mn><mo>;</mo><mi>k</mi><mo>≠</mo><mi>N</mi><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn><mo>;</mo><mi>k</mi><mo>:=</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{for}(k:=0;k\neq N*2;k:=k+1)\{</annotation></semantics></math></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex70.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbf{for}(k:=0;k\neq N*2;k:=k+1)\{\hskip 15.00002pt" display="inline" intent=":literal"><semantics><mrow><mi>𝐟𝐨𝐫</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>:=</mo><mn>0</mn><mo>;</mo><mi>k</mi><mo>≠</mo><mi>N</mi><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn><mo>;</mo><mi>k</mi><mo>:=</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{for}(k:=0;k\neq N*2;k:=k+1)\{\hskip 15.00002pt</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="S3.Ex71"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex71.2.1" class="ltx_text ltx_inline-block" style="font-size:80%;width:0.0pt;--ltx-fg-color:#0000FF;">// <math id="S3.Ex71.m1" class="ltx_Math" alttext="\iota_{\mathit{in}_{1}}=i..(N-1)\land\iota_{\mathit{in}_{2}}=j..(N-1)\land\iota_{\mathit{out}}=0..(k-1)\land i+j=k&lt;2N" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></msub></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.0835em">.</mo></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0.0835em" mathcolor="#0000FF" rspace="0.167em">.</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msub></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">j</mi></mrow></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.0835em">.</mo></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0.0835em" mathcolor="#0000FF" rspace="0.167em">.</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑜𝑢𝑡</mi></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn></mrow></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.0835em">.</mo></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0.0835em" mathcolor="#0000FF" rspace="0.167em">.</mo><mrow><mrow><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">j</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">&lt;</mo><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{\mathit{in}_{1}}=i..(N-1)\land\iota_{\mathit{in}_{2}}=j..(N-1)\land\iota_{\mathit{out}}=0..(k-1)\land i+j=k&lt;2N</annotation></semantics></math></span></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright" colspan="4"></span></span></span>
<span id="S3.Ex72"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex72.2.1" class="ltx_text ltx_inline-block" style="width:0.0pt;--ltx-fg-color:#0000FF;">        <math id="S3.Ex72.m1" class="ltx_Math" alttext="{}\land i\leq N\land j\leq N" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">≤</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">j</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">≤</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi></mrow><annotation encoding="application/x-tex">{}\land i\leq N\land j\leq N</annotation></semantics></math></span></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright" colspan="4"></span></span></span>
<span id="S3.Ex73"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex73.m1" class="ltx_math_unparsed" alttext="\displaystyle\ \ \mathbf{if}\ j=N\ \{" display="inline" intent=":literal"><semantics><mrow><mi>𝐢𝐟</mi><mi>j</mi><mo>=</mo><mi>N</mi><mo lspace="0.500em" stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \ \mathbf{if}\ j=N\ \{</annotation></semantics></math></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex73.m2" class="ltx_math_unparsed" alttext="\displaystyle\ \ \mathbf{if}\ j=N\ \{" display="inline" intent=":literal"><semantics><mrow><mi>𝐢𝐟</mi><mi>j</mi><mo>=</mo><mi>N</mi><mo lspace="0.500em" stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \ \mathbf{if}\ j=N\ \{</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="S3.Ex74"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
