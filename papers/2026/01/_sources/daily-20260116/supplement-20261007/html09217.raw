\Gamma\vdash e:\mathbf{int}\quad\quad\Gamma(b)=\mathbf{buf}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{e\not\in\iota_{a}\land[x/b,a\{e\mapsto x\}/a]\mathcal{B}\}a[e]:=x\Longrightarrow b:=x\{\mathcal{B}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐢𝐧𝐭</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mi>e</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐛𝐮𝐟</mi></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi>e</mi><mo>∉</mo><mi>ι</mi><msub><mrow></mrow><mi>a</mi></msub><mo>∧</mo><mo stretchy="false">[</mo><mi>x</mi><mo>/</mo><mi>b</mi><mo>,</mo><mi>a</mi><mo stretchy="false">{</mo><mi>e</mi><mo stretchy="false">↦</mo><mi>x</mi><mo stretchy="false">}</mo><mo>/</mo><mi>a</mi><mo stretchy="false">]</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo><mi>a</mi><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo><mo>:=</mo><mi>x</mi><mo stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>x</mi><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma(x)=\mathbf{int}\quad\quad\Gamma(a)=\mathbf{warray}\\
\Gamma\vdash e:\mathbf{int}\quad\quad\Gamma(b)=\mathbf{buf}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{e\not\in\iota_{a}\land[x/b,a\{e\mapsto x\}/a]\mathcal{B}\}a[e]:=x\Longrightarrow b:=x\{\mathcal{B}\}\end{array}}</annotation></semantics></math></span> </span>
