\langle R\{x\mapsto k\},H,s^{\prime}\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\quad s^{\prime}\equiv{s;\mathbf{for}(x:=x+n;x\neq m;x:=x+n)s}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,H,\mathbf{for}(x:=e;x\neq m;x:=x+n)s\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><mi>e</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">⇓</mo><mi>k</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mi>k</mi><mo>≠</mo><mi>m</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">⟨</mo><mi>R</mi><mo stretchy="false">{</mo><mi>x</mi><mo stretchy="false">↦</mo><mi>k</mi><mo stretchy="false">}</mo><mo>,</mo><mi>H</mi><mo>,</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⟩</mo><mo stretchy="false">⇓</mo><mo stretchy="false">⟨</mo><mi>R</mi><msup><mrow></mrow><mo>′</mo></msup><mo>,</mo><mi>H</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⟩</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo>≡</mo><mi>s</mi><mo>;</mo><mi>𝐟𝐨𝐫</mi><mo stretchy="false">(</mo><mi>x</mi><mo>:=</mo><mi>x</mi><mo>+</mo><mi>n</mi><mo>;</mo><mi>x</mi><mo>≠</mo><mi>m</mi><mo>;</mo><mi>x</mi><mo>:=</mo><mi>x</mi><mo>+</mo><mi>n</mi><mo stretchy="false">)</mo><mi>s</mi></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mrow><mrow><mi>𝐟𝐨𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mi>m</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">⇓</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\langle R,e\rangle\Downarrow k\quad\quad k\neq m\\
\langle R\{x\mapsto k\},H,s^{\prime}\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\quad s^{\prime}\equiv{s;\mathbf{for}(x:=x+n;x\neq m;x:=x+n)s}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,H,\mathbf{for}(x:=e;x\neq m;x:=x+n)s\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}</annotation></semantics></math></span> </span>
