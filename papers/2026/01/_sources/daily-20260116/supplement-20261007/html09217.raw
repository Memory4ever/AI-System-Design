<mo stretchy="false">⟹</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\models\mathcal{B}\Rightarrow\mathcal{B}_{1}\quad\quad\Gamma\vdash\{\mathcal{B}_{1}\}s\Longrightarrow t\{\mathcal{B}_{1}^{\prime}\}\quad\quad\models\mathcal{B}_{1}^{\prime}\Rightarrow\mathcal{B}^{\prime}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}s\Longrightarrow t\{\mathcal{B}^{\prime}\}\end{array}}</annotation></semantics></math></span> </span> <span id="S3.F6.12.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S3.F6.12.1.2.1" class="ltx_text ltx_font_smallcaps">Tr-Conseq</span>)</span></span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S3.F6.13" class="ltx_p ltx_figure_panel"><span id="S3.F6.13.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.13.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.13.1.1.1" class="ltx_text"><math id="S3.F6.m13" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\models\mathcal{B}\Rightarrow\mathcal{B}_{1}\quad\quad\Gamma\vdash\{\mathcal{B}_{1}\}\bullet\Longrightarrow t\{\mathcal{B}_{1}^{\prime}\}\quad\quad\models\mathcal{B}_{1}^{\prime}\Rightarrow\mathcal{B}^{\prime}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mo>⊧</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">⇒</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msub><mrow></mrow><mn>1</mn></msub><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">}</mo><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>t</mi><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo><mo>⊧</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⇒</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo rspace="0.055em" stretchy="false">}</mo><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>t</mi><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\models\mathcal{B}\Rightarrow\mathcal{B}_{1}\quad\quad\Gamma\vdash\{\mathcal{B}_{1}\}\bullet\Longrightarrow t\{\mathcal{B}_{1}^{\prime}\}\quad\quad\models\mathcal{B}_{1}^{\prime}\Rightarrow\mathcal{B}^{\prime}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}\end{array}}</annotation></semantics></math></span> </span> <span id="S3.F6.13.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S3.F6.13.1.2.1" class="ltx_text ltx_font_smallcaps">Tr-InsConseq</span>)</span></span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S3.F6.14" class="ltx_p ltx_figure_panel"><span id="S3.F6.14.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.14.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.14.1.1.1" class="ltx_text"><math id="S3.F6.m14" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma^{\sharp}\vdash\{\mathcal{B}\}s\Longrightarrow t\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}[s]_{K}\Longrightarrow[t]_{K}\{\mathcal{B}^{\prime}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><msup><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">♯</mi></msup><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">⟹</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mi>s</mi><mo stretchy="false">]</mo></mrow><mi>K</mi></msub></mrow><mo stretchy="false">⟹</mo><mrow><msub><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma^{\sharp}\vdash\{\mathcal{B}\}s\Longrightarrow t\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}[s]_{K}\Longrightarrow[t]_{K}\{\mathcal{B}^{\prime}\}\end{array}}</annotation></semantics></math></span> </span> <span id="S3.F6.14.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S3.F6.14.1.2.1" class="ltx_text ltx_font_smallcaps">Tr-Kernel</span>)</span></span></p></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Translation rules. <math id="S3.F6.m18" class="ltx_Math" alttext="\Gamma\vdash e:\mathbf{int}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mi>e</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><annotation encoding="application/x-tex">\Gamma\vdash e:\mathbf{int}</annotation></semantics></math> means that all the variables in <math id="S3.F6.m19" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> have type <math id="S3.F6.m20" class="ltx_Math" alttext="\mathbf{int}" display="inline" intent=":literal"><semantics><mi>𝐢𝐧𝐭</mi><annotation encoding="application/x-tex">\mathbf{int}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">The translation relation <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="\Gamma\vdash\{\mathcal{B}\}s\Longrightarrow tab\{\mathcal{B}^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">⟹</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma\vdash\{\mathcal{B}\}s\Longrightarrow tab\{\mathcal{B}^{\prime}\}</annotation></semantics></math> is defined by the rules in Figure <a href="#S3.F6" title="Figure 6 ‣ 3.2 Translation Rules ‣ 3 Formalization of Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.
In the figure, <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="[e_{1}/x_{1},\ldots,e_{n}/x_{n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>/</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>e</mi><mi>n</mi></msub><mo>/</mo><msub><mi>x</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[e_{1}/x_{1},\ldots,e_{n}/x_{n}]</annotation></semantics></math> denotes the simultaneous substitutions of <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="e_{1},\ldots,e_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">e_{1},\ldots,e_{n}</annotation></semantics></math> for <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="x_{1},\ldots,x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\ldots,x_{n}</annotation></semantics></math>.
The expression <math id="S3.SS2.p1.m5" class="ltx_math_unparsed" alttext="a\{e\mapsto x\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mrow><mo stretchy="false">{</mo><mi>e</mi><mo stretchy="false">↦</mo><mi>x</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\{e\mapsto x\}</annotation></semantics></math> denotes the array obtained from <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> by replacing the value at index <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> with <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>;
the syntax of the assertion language for describing <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> is given in Appendix <a href="#Pt0.A1" title="Appendix 0.A Correctness of the Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">0.A</span></a>.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">Most of the rules in the figure are analogous to the corresponding (partial correctness) rules of Hoare logic.
In the rule <span id="S3.SS2.p2.1.1" class="ltx_text ltx_font_smallcaps">Tr-ReadMem</span>, a read from the array <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is translated to a read from the buffer variable <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>,
on the assumption that the value of <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> has already been copied to <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>; that is achieved by the rule <span id="S3.SS2.p2.1.2" class="ltx_text ltx_font_smallcaps">Tr-InsRBuf</span> explained later.
Thus, when <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> is accessed for the first time, <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="x:=a[e]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=a[e]</annotation></semantics></math> is translated to <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="b:={a}.read();x:=b" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>:=</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mrow><mi>x</mi><mo>:=</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">b:={a}.read();x:=b</annotation></semantics></math>, which can be optimized to
<math id="S3.SS2.p2.m8" class="ltx_Math" alttext="x:={a}.read()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>:=</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:={a}.read()</annotation></semantics></math> if the value of <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> is not used later; this redundancy is for the sake of simplicity, and in the actual implementation,
<math id="S3.SS2.p2.m10" class="ltx_Math" alttext="x:=a[e]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=a[e]</annotation></semantics></math> is just transformed to <math id="S3.SS2.p2.m11" class="ltx_Math" alttext="x:={a}.read()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>:=</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:={a}.read()</annotation></semantics></math> if <math id="S3.SS2.p2.m12" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> is not accessed more than once.
The pre-condition <math id="S3.SS2.p2.m13" class="ltx_Math" alttext="b=a[e]" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=a[e]</annotation></semantics></math> asserts that <math id="S3.SS2.p2.m14" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> indeed holds the value of <math id="S3.SS2.p2.m15" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math>. We additionally require
<math id="S3.SS2.p2.m16" class="ltx_Math" alttext="[b/x]\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo>/</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">[b/x]\mathcal{B}</annotation></semantics></math> as a pre-condition to ensure that <math id="S3.SS2.p2.m17" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> holds after the execution of <math id="S3.SS2.p2.m18" class="ltx_Math" alttext="x:=a[e]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=a[e]</annotation></semantics></math> and <math id="S3.SS2.p2.m19" class="ltx_Math" alttext="x:=b" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">x:=b</annotation></semantics></math>.
This is analogous to the rule <math id="S3.SS2.p2.m20" class="ltx_Math" alttext="\{[b/x]\mathcal{B}\}x:=b\{\mathcal{B}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo>/</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>:=</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{[b/x]\mathcal{B}\}x:=b\{\mathcal{B}\}</annotation></semantics></math> for assignment in the standard Hoare logic.
In our case, <math id="S3.SS2.p2.m21" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is updated to <math id="S3.SS2.p2.m22" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> and <math id="S3.SS2.p2.m23" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> respectively in the source and target programs, but requiring
<math id="S3.SS2.p2.m24" class="ltx_Math" alttext="[b/x]\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo>/</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">[b/x]\mathcal{B}</annotation></semantics></math> suffices since the other condition <math id="S3.SS2.p2.m25" class="ltx_Math" alttext="b=a[e]" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=a[e]</annotation></semantics></math> ensures that <math id="S3.SS2.p2.m26" class="ltx_Math" alttext="[a[e]/x]\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">[a[e]/x]\mathcal{B}</annotation></semantics></math> also holds.</p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">Similarly, in the rule <span id="S3.SS2.p3.1.1" class="ltx_text ltx_font_smallcaps">Tr-WriteMem</span>, a write to the array <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is translated to a write to the buffer variable <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>.
The code for writing the contents of the buffer to the stream is then inserted by the rule <span id="S3.SS2.p3.1.2" class="ltx_text ltx_font_smallcaps">Tr-InsWBuf</span> explained later.
Thus, if <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> is updated just once in the source program, <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="a[e]:=x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><mo>:=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">a[e]:=x</annotation></semantics></math> is translated to <math id="S3.SS2.p3.m5" class="ltx_Math" alttext="b:=x;{a}.write(b)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>b</mi><mo>:=</mo><mi>x</mi></mrow><mo>;</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b:=x;{a}.write(b)</annotation></semantics></math>, which can be optimized
to <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="{a}.write(x)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{a}.write(x)</annotation></semantics></math>.
This is again for the sake of simplicity; <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="a[e]:=x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><mo>:=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">a[e]:=x</annotation></semantics></math> is directly translated to <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="{a}.write(x)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{a}.write(x)</annotation></semantics></math> in the actual implementation in such a case.
The pre-condition <math id="S3.SS2.p3.m9" class="ltx_Math" alttext="e\not\in\iota_{a}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∉</mo><msub><mi>ι</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">e\not\in\iota_{a}</annotation></semantics></math> checks that <math id="S3.SS2.p3.m10" class="ltx_Math" alttext="a[e]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[e]</annotation></semantics></math> has not been written before. The part <math id="S3.SS2.p3.m11" class="ltx_math_unparsed" alttext="[x/b,a\{e\mapsto x\}/a]\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>x</mi><mo>/</mo><mi>b</mi><mo>,</mo><mi>a</mi><mrow><mo stretchy="false">{</mo><mi>e</mi><mo stretchy="false">↦</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><mo>/</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">[x/b,a\{e\mapsto x\}/a]\mathcal{B}</annotation></semantics></math> corresponds to the precondition for
the two successive assignments <math id="S3.SS2.p3.m12" class="ltx_Math" alttext="a[e]:=x;b:=x" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo></mrow></mrow><mo>:=</mo><mi>x</mi></mrow><mo>;</mo><mrow><mi>b</mi><mo>:=</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">a[e]:=x;b:=x</annotation></semantics></math> in the standard Hoare logic.
Here, the substitution can be applied in parallel because
the two assignments do not interfere; note that (i) the buffer variable <math id="S3.SS2.p3.m13" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> may occur only in the target program,
and (ii) the array variable <math id="S3.SS2.p3.m14" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in pre-/post-conditions refers to that of the source program.</p>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">The rules <span id="S3.SS2.p4.1.1" class="ltx_text ltx_font_smallcaps">Tr-Assign</span>, <span id="S3.SS2.p4.1.2" class="ltx_text ltx_font_smallcaps">Tr-Seq</span>, and <span id="S3.SS2.p4.1.3" class="ltx_text ltx_font_smallcaps">Tr-If</span> are just relational versions of the corresponding rules
for Hoare logic. The rule <span id="S3.SS2.p4.1.4" class="ltx_text ltx_font_smallcaps">Tr-For</span> is also essentially a relational version of the rule for loops in Hoare logic,
except that we chose for-statements as primitives instead of while-statements.
With while-statements as primitives, the rule <span id="S3.SS2.p4.1.5" class="ltx_text ltx_font_smallcaps">Tr-For</span> would be derived from the following rule:</p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p"><span id="S3.SS2.p5.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.SS2.p5.1.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.SS2.p5.1.1.1.1" class="ltx_text"><math id="S3.SS2.p5.m1" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\land\mathit{cond}\}s\Longrightarrow t\{\mathcal{B}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\mathbf{while}\ \mathit{cond}\ \mathbf{do}\ s\Longrightarrow\mathbf{while}\ \mathit{cond}\ \mathbf{do}\ t\{\mathcal{B}\land\neg\mathit{cond}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mi>𝑐𝑜𝑛𝑑</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">⟹</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐰𝐡𝐢𝐥𝐞</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝑐𝑜𝑛𝑑</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝐝𝐨</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">⟹</mo><mrow><mi>𝐰𝐡𝐢𝐥𝐞</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝑐𝑜𝑛𝑑</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝐝𝐨</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mrow><mo rspace="0.167em">¬</mo><mi>𝑐𝑜𝑛𝑑</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\land\mathit{cond}\}s\Longrightarrow t\{\mathcal{B}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\mathbf{while}\ \mathit{cond}\ \mathbf{do}\ s\Longrightarrow\mathbf{while}\ \mathit{cond}\ \mathbf{do}\ t\{\mathcal{B}\land\neg\mathit{cond}\}\end{array}}</annotation></semantics></math></span> </span>
 </span><span id="S3.SS2.p5.1.2" class="ltx_text ltx_inline-block" style="width:345.0pt;"> <span id="S3.SS2.p5.1.2.1" class="ltx_text">(<span id="S3.SS2.p5.1.2.1.1" class="ltx_text ltx_font_smallcaps">Tr-While</span>)</span></span></p>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p">Note that, using a while-statement, <math id="S3.SS2.p6.m1" class="ltx_Math" alttext="\mathbf{for}(x:=e;x\neq m;x:=x+n)s" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐟𝐨𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mi>m</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">\mathbf{for}(x:=e;x\neq m;x:=x+n)s</annotation></semantics></math> can be expressed as
<math id="S3.SS2.p6.m2" class="ltx_Math" alttext="x:=e;\mathbf{while}\ x\neq m\ \mathbf{do}\ (s;x:=x+n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><mo>;</mo><mrow><mrow><mi>𝐰𝐡𝐢𝐥𝐞</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>x</mi></mrow><mo>≠</mo><mrow><mi>m</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝐝𝐨</mi><mo lspace="0.500em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=e;\mathbf{while}\ x\neq m\ \mathbf{do}\ (s;x:=x+n)</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p">The rules <span id="S3.SS2.p7.1.1" class="ltx_text ltx_font_smallcaps">Tr-InsertL</span> and <span id="S3.SS2.p7.1.2" class="ltx_text ltx_font_smallcaps">Tr-InsertR</span> are for inserting buffering commands.
Here, we use the auxiliary relation <math id="S3.SS2.p7.m1" class="ltx_math_unparsed" alttext="\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>t</mi><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}</annotation></semantics></math> (where <math id="S3.SS2.p7.m2" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math> can be considered a skip command)
for inserting <math id="S3.SS2.p7.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> in the target program.
The rule <span id="S3.SS2.p7.1.3" class="ltx_text ltx_font_smallcaps">Tr-InsRBuf</span> is for copying a value from a stream to a buffer.
The substitution <math id="S3.SS2.p7.m4" class="ltx_Math" alttext="[\mathit{tail}(\iota_{a})/\iota_{a}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>𝑡𝑎𝑖𝑙</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ι</mi><mi>a</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\mathit{tail}(\iota_{a})/\iota_{a}]</annotation></semantics></math> reflects the
update (<math id="S3.SS2.p7.m5" class="ltx_Math" alttext="\iota_{a}:=\mathit{tail}(\iota_{a})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>:=</mo><mrow><mi>𝑡𝑎𝑖𝑙</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}:=\mathit{tail}(\iota_{a})</annotation></semantics></math>) of the sequence of array indices stored in the stream.
Here, <math id="S3.SS2.p7.m6" class="ltx_Math" alttext="\mathit{head}(J)" display="inline" intent=":literal"><semantics><mrow><mi>ℎ𝑒𝑎𝑑</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathit{head}(J)</annotation></semantics></math> denotes the first element of the sequence <math id="S3.SS2.p7.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, <math id="S3.SS2.p7.m8" class="ltx_Math" alttext="\mathit{tail}(J)" display="inline" intent=":literal"><semantics><mrow><mi>𝑡𝑎𝑖𝑙</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathit{tail}(J)</annotation></semantics></math> denotes the sequence obtained by removing the first element from <math id="S3.SS2.p7.m9" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>.
In the rule <span id="S3.SS2.p7.1.4" class="ltx_text ltx_font_smallcaps">Tr-InsWBuf</span> for copying a value from a buffer to a stream,
the pre-condition <math id="S3.SS2.p7.m10" class="ltx_Math" alttext="n\not\in\iota_{a}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∉</mo><msub><mi>ι</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">n\not\in\iota_{a}</annotation></semantics></math> checks that <math id="S3.SS2.p7.m11" class="ltx_Math" alttext="a[n]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[n]</annotation></semantics></math> has not been written before. The substitution
<math id="S3.SS2.p7.m12" class="ltx_Math" alttext="[(\iota_{a}\cdot n)/\iota_{a}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>ι</mi><mi>a</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(\iota_{a}\cdot n)/\iota_{a}]</annotation></semantics></math> reflects the fact that the value of <math id="S3.SS2.p7.m13" class="ltx_Math" alttext="a[n]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[n]</annotation></semantics></math> is added at the end of the stream.
Here, <math id="S3.SS2.p7.m14" class="ltx_Math" alttext="J_{1}\cdot J_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>J</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">J_{1}\cdot J_{2}</annotation></semantics></math> denotes the concatenation of two sequences <math id="S3.SS2.p7.m15" class="ltx_Math" alttext="J_{1}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>1</mn></msub><annotation encoding="application/x-tex">J_{1}</annotation></semantics></math> and <math id="S3.SS2.p7.m16" class="ltx_Math" alttext="J_{2}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>2</mn></msub><annotation encoding="application/x-tex">J_{2}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p8" class="ltx_para">
<p id="S3.SS2.p8.1" class="ltx_p">The rule <span id="S3.SS2.p8.1.1" class="ltx_text ltx_font_smallcaps">Tr-InsMove</span> is for moving the value of a buffer or integer variable to another buffer variable;
that is needed, for example, for inserting <span id="S3.SS2.p8.1.2" class="ltx_text ltx_markedasmath ltx_font_typewriter">b0 = b1</span> in Figure <a href="#S1.F2" title="Figure 2 ‣ 1 Introduction ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> given in Section <a href="#S1" title="1 Introduction ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
The rules <span id="S3.SS2.p8.1.3" class="ltx_text ltx_font_smallcaps">Tr-Conseq</span> and <span id="S3.SS2.p8.1.4" class="ltx_text ltx_font_smallcaps">Tr-InsConseq</span> are for adjusting pre-/post-conditions, corresponding to the consequence rule of
the standard Hoare logic.
The rule <span id="S3.SS2.p8.1.5" class="ltx_text ltx_font_smallcaps">Tr-Kernel</span> handles the swapping of read-only and write-only array types when entering a kernel function.
The operation <math id="S3.SS2.p8.m2" class="ltx_Math" alttext="\Gamma^{\sharp}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Γ</mi><mi mathvariant="normal">♯</mi></msup><annotation encoding="application/x-tex">\Gamma^{\sharp}</annotation></semantics></math> on type environments flips between read/write-only array types, as defined by:</p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.EGx6.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.EGx6.m1" class="ltx_Math" alttext="\displaystyle(a_{1}\mathbin{:}\tau_{1},\ldots,a_{n}\mathbin{:}\tau_{n})^{\sharp}=a_{1}\mathbin{:}\tau_{1}^{\sharp},\ldots,a_{n}\mathbin{:}\tau_{n}^{\sharp}\qquad{\tau}^{\sharp}=\left\{\begin{array}[]{ll}\mathbf{rarray}&amp;\text{if }\tau=\mathbf{warray}\\
\mathbf{warray}&amp;\text{if }\tau=\mathbf{rarray}\\
\tau&amp;\text{otherwise}\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msub><mi>τ</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">♯</mi></msup><mo>=</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msubsup><mi>τ</mi><mn>1</mn><mi mathvariant="normal">♯</mi></msubsup></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msubsup><mi>τ</mi><mi>n</mi><mi mathvariant="normal">♯</mi></msubsup></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msup><mi>τ</mi><mi mathvariant="normal">♯</mi></msup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>=</mo><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>=</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>τ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(a_{1}\mathbin{:}\tau_{1},\ldots,a_{n}\mathbin{:}\tau_{n})^{\sharp}=a_{1}\mathbin{:}\tau_{1}^{\sharp},\ldots,a_{n}\mathbin{:}\tau_{n}^{\sharp}\qquad{\tau}^{\sharp}=\left\{\begin{array}[]{ll}\mathbf{rarray}&amp;\text{if }\tau=\mathbf{warray}\\
\mathbf{warray}&amp;\text{if }\tau=\mathbf{rarray}\\
\tau&amp;\text{otherwise}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p8.2" class="ltx_p">This flipping is necessary because arrays read (resp. written) inside the kernel are written (resp. read) by the host code.</p>
</div>
<div id="Thmexample2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample2.1" class="ltx_text ltx_font_bold">Example 2</span></span></h6>
<div id="Thmexample2.p1" class="ltx_para">
<p id="Thmexample2.p1.1" class="ltx_p">Recall the following judgment considered in Section <a href="#S3.SS1" title="3.1 Translation Relation ‣ 3 Formalization of Translation ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>.</p>
<table id="S3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex25.m1" class="ltx_math_unparsed" alttext="\Gamma\vdash\{\iota_{a}=1\cdot J\}x:=a[1]\Longrightarrow b:={a}.read();x:=b\{\iota_{a}=J\land x=b=a[1]\}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mi>x</mi><mo>:=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow><mo>;</mo><mi>x</mi><mo>:=</mo><mi>b</mi><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi><mo>∧</mo><mi>x</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Gamma\vdash\{\iota_{a}=1\cdot J\}x:=a[1]\Longrightarrow b:={a}.read();x:=b\{\iota_{a}=J\land x=b=a[1]\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample2.p1.2" class="ltx_p">It is obtained from the following two judgments by using <span id="Thmexample2.p1.2.1" class="ltx_text ltx_font_smallcaps">Tr-InsertL</span>:</p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle\Gamma\vdash\{\iota_{a}=1\cdot J\}\bullet\Longrightarrow b:={a}.read()\{\iota_{a}=J\land b=a[1]\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi><mo>∧</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Gamma\vdash\{\iota_{a}=1\cdot J\}\bullet\Longrightarrow b:={a}.read()\{\iota_{a}=J\land b=a[1]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\Gamma\vdash\{\iota_{a}=J\land b=a[1]\}x:=a[1]\Longrightarrow x:=b\{\iota_{a}=J\land x=b=a[1]\}." display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi><mo>∧</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mi>x</mi><mo>:=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟹</mo><mi>x</mi><mo>:=</mo><mi>b</mi><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi><mo>∧</mo><mi>x</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Gamma\vdash\{\iota_{a}=J\land b=a[1]\}x:=a[1]\Longrightarrow x:=b\{\iota_{a}=J\land x=b=a[1]\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample2.p1.3" class="ltx_p">The first judgment is obtained as follows.</p>
<table id="S3.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex28.m1" class="ltx_Math" alttext="\Gamma\vdash\{\iota_{a}=1\cdot J\}\bullet\Longrightarrow b:={a}.read()\{\mathcal{B}\}\Gamma\vdash\{\mathit{head}(\iota_{a})=1\land[a[1]/b,\mathit{tail}(\iota_{a})/\iota_{a}]\mathcal{B}\}\bullet\Longrightarrow b:={a}.read()\{\mathcal{B}\}" display="block" intent=":literal"><semantics><mtable align="bottom" columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mtable align="bottom" columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mphantom></mphantom></mtd><mtd rowspan="3"><mtext class="ltx_font_smallcaps" mathsize="0.900em">(Tr-InsRBuf)</mtext></mtd></mtr><mtr><mtd><mover accent="true"><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi>ℎ𝑒𝑎𝑑</mi><mo stretchy="false">(</mo><mi>ι</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mo>=</mo><mn>1</mn><mo>∧</mo><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo><mo>/</mo><mi>b</mi><mo>,</mo><mi>𝑡𝑎𝑖𝑙</mi><mo stretchy="false">(</mo><mi>ι</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">)</mo><mo>/</mo><mi>ι</mi><msub><mrow></mrow><mi>a</mi></msub><mo stretchy="false">]</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo rspace="0.055em" stretchy="false">}</mo><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mo stretchy="false">(</mo><mo stretchy="false">)</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo class="ltx_mathvariant_italic" mathvariant="italic">‾</mo></mover></mtd></mtr></mtable></mtd><mtd rowspan="3"><mtext class="ltx_font_smallcaps" mathsize="0.900em">(Tr-InsConseq)</mtext></mtd></mtr><mtr><mtd><mover accent="true"><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi>ι</mi><msub><mrow></mrow><mi>a</mi></msub><mo>=</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi><mo rspace="0.055em" stretchy="false">}</mo><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mo stretchy="false">(</mo><mo stretchy="false">)</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo class="ltx_mathvariant_italic" mathvariant="italic">‾</mo></mover></mtd></mtr></mtable><annotation encoding="application/x-tex">\Gamma\vdash\{\iota_{a}=1\cdot J\}\bullet\Longrightarrow b:={a}.read()\{\mathcal{B}\}\Gamma\vdash\{\mathit{head}(\iota_{a})=1\land[a[1]/b,\mathit{tail}(\iota_{a})/\iota_{a}]\mathcal{B}\}\bullet\Longrightarrow b:={a}.read()\{\mathcal{B}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample2.p1.4" class="ltx_p">Here, <math id="Thmexample2.p1.m1" class="ltx_Math" alttext="\mathcal{B}\equiv\iota_{a}=J\land b=a[1]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>≡</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mi>J</mi><mo>∧</mo><mi>b</mi></mrow><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}\equiv\iota_{a}=J\land b=a[1]</annotation></semantics></math>.
Note that
<math id="Thmexample2.p1.m2" class="ltx_Math" alttext="\iota_{a}=1\cdot J" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}=1\cdot J</annotation></semantics></math> implies
<math id="Thmexample2.p1.m3" class="ltx_Math" alttext="\mathit{head}(\iota_{a})=1\land[a[1]/b,\mathit{tail}(\iota_{a})/\iota_{a}]\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℎ𝑒𝑎𝑑</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>∧</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>b</mi></mrow><mo>,</mo><mrow><mrow><mi>𝑡𝑎𝑖𝑙</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ι</mi><mi>a</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathit{head}(\iota_{a})=1\land[a[1]/b,\mathit{tail}(\iota_{a})/\iota_{a}]\mathcal{B}</annotation></semantics></math>, i.e., <math id="Thmexample2.p1.m4" class="ltx_Math" alttext="\mathit{head}(\iota_{a})=1\land\mathit{tail}(\iota_{a})=J\land a[1]=a[1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℎ𝑒𝑎𝑑</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>∧</mo><mrow><mi>𝑡𝑎𝑖𝑙</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>J</mi><mo>∧</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathit{head}(\iota_{a})=1\land\mathit{tail}(\iota_{a})=J\land a[1]=a[1]</annotation></semantics></math>.
The second judgment can be obtained by using
<span id="Thmexample2.p1.4.1" class="ltx_text ltx_font_smallcaps">Tr-ReadMem</span> and <span id="Thmexample2.p1.4.2" class="ltx_text ltx_font_smallcaps">Tr-InsConseq</span>. ∎</p>
</div>
</div>
<figure id="S3.F7" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F7.pic1" class="ltx_picture" height="602.36" overflow="visible" version="1.1" viewBox="0 0 497.57 602.36" width="497.57"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,602.36) matrix(1 0 0 -1 0 0) translate(251.97,0) translate(0,299.22)"><g style="--ltx-stroke-color:#F2F9F9;--ltx-fill-color:#F2F9F9;--ltx-fg-color:#F2F9F9;" color="#F2F9F9" fill="#F2F9F9" stroke="#F2F9F9"><path style="stroke:none" d="M -251.97 -299.21 M -251.97 -292.29 L -251.97 296.23 C -251.97 300.05 -248.87 303.15 -245.05 303.15 L -50.23 303.15 C -46.4 303.15 -43.31 300.05 -43.31 296.23 L -43.31 -292.29 C -43.31 -296.12 -46.4 -299.21 -50.23 -299.21 L -245.05 -299.21 C -248.87 -299.21 -251.97 -296.12 -251.97 -292.29 Z M -43.31 303.15"></path></g><g style="--ltx-stroke-color:#FFF9F2;--ltx-fill-color:#FFF9F2;--ltx-fg-color:#FFF9F2;" color="#FFF9F2" fill="#FFF9F2" stroke="#FFF9F2"><path style="stroke:none" d="M 15.75 -299.21 M 15.75 -292.29 L 15.75 296.23 C 15.75 300.05 18.85 303.15 22.67 303.15 L 217.49 303.15 C 221.31 303.15 224.41 300.05 224.41 296.23 L 224.41 -292.29 C 224.41 -296.12 221.31 -299.21 217.49 -299.21 L 22.67 -299.21 C 18.85 -299.21 15.75 -296.12 15.75 -292.29 Z M 224.41 303.15"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -240.99 -3.46)"><foreignObject style="--ltx-fo-width:34.5em;--ltx-fo-height:16.58em;--ltx-fo-depth:16.08em;font-size:10pt;" height="452.04" overflow="visible" transform="matrix(1 0 0 -1 0 229.48)" width="477.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F7.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:34.5em;">
<span id="S3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="S3.Ex29"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex29.2.1" class="ltx_text ltx_inline-block" style="width:0.0pt;--ltx-fg-color:#0000FF;">// <math id="S3.Ex29.m1" class="ltx_Math" alttext="\Gamma;\iota_{\mathit{in}}=\iota_{\mathit{out}}=\epsilon" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathvariant="normal">Γ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">;</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑜𝑢𝑡</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\Gamma;\iota_{\mathit{in}}=\iota_{\mathit{out}}=\epsilon</annotation></semantics></math></span></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright" colspan="4"></span></span></span>
<span id="S3.Ex30"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbf{for}(x:=0;x\neq N;x:=x+1)\{" display="inline" intent=":literal"><semantics><mrow><mi>𝐟𝐨𝐫</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>:=</mo><mn>0</mn><mo>;</mo><mi>x</mi><mo>≠</mo><mi>N</mi><mo>;</mo><mi>x</mi><mo>:=</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{for}(x:=0;x\neq N;x:=x+1)\{</annotation></semantics></math></span>
<span class="ltx_td ltx_eqn_cell"></span>
