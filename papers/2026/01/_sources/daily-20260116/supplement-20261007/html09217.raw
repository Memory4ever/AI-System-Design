<p id="S3.F6.4" class="ltx_p ltx_figure_panel"><span id="S3.F6.4.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.4.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.4.1.1.1" class="ltx_text"><math id="S3.F6.m4" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}s_{1}\Longrightarrow t_{1}\{\mathcal{B}^{\prime\prime}\}\quad\quad\Gamma\vdash\{\mathcal{B}^{\prime\prime}\}s_{2}\Longrightarrow t_{2}\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}s_{1};s_{2}\Longrightarrow t_{1};t_{2}\{\mathcal{B}^{\prime}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub></mrow><mo stretchy="false">⟹</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′′</mo></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo stretchy="false">⟹</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo>;</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">⟹</mo><mi>t</mi><msub><mrow></mrow><mn>1</mn></msub><mo>;</mo><mi>t</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}s_{1}\Longrightarrow t_{1}\{\mathcal{B}^{\prime\prime}\}\quad\quad\Gamma\vdash\{\mathcal{B}^{\prime\prime}\}s_{2}\Longrightarrow t_{2}\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}s_{1};s_{2}\Longrightarrow t_{1};t_{2}\{\mathcal{B}^{\prime}\}\end{array}}</annotation></semantics></math></span> </span> <span id="S3.F6.4.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S3.F6.4.1.2.1" class="ltx_text ltx_font_smallcaps">Tr-Seq</span>)</span></span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S3.F6.5" class="ltx_p ltx_figure_panel"><span id="S3.F6.5.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.5.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.5.1.1.1" class="ltx_text"><math id="S3.F6.m5" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma(x)=\mathbf{int}\quad\quad\Gamma\vdash\{\mathcal{B}\land x\neq 0\}s_{1}\Longrightarrow t_{1}\{\mathcal{B}^{\prime}\}\\
\Gamma\vdash\{\mathcal{B}\land x=0\}s_{2}\Longrightarrow t_{2}\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\mathbf{if}\ x\ \mathbf{then}\ s_{1}\ \mathbf{else}\ {s_{2}}\Longrightarrow\mathbf{if}\ x\ \mathbf{then}\ t_{1}\ \mathbf{else}\ {t_{2}}\{\mathcal{B}^{\prime}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable rowspacing="0pt"><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>𝐢𝐧𝐭</mi><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mi>x</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">⟹</mo><mi>t</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mi>x</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">⟹</mo><mi>t</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐢𝐟</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝐭𝐡𝐞𝐧</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐞𝐥𝐬𝐞</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo stretchy="false">⟹</mo><mrow><mi>𝐢𝐟</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>𝐭𝐡𝐞𝐧</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐞𝐥𝐬𝐞</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>t</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma(x)=\mathbf{int}\quad\quad\Gamma\vdash\{\mathcal{B}\land x\neq 0\}s_{1}\Longrightarrow t_{1}\{\mathcal{B}^{\prime}\}\\
\Gamma\vdash\{\mathcal{B}\land x=0\}s_{2}\Longrightarrow t_{2}\{\mathcal{B}^{\prime}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\}\mathbf{if}\ x\ \mathbf{then}\ s_{1}\ \mathbf{else}\ {s_{2}}\Longrightarrow\mathbf{if}\ x\ \mathbf{then}\ t_{1}\ \mathbf{else}\ {t_{2}}\{\mathcal{B}^{\prime}\}\end{array}}</annotation></semantics></math></span> </span>
 </span><span id="S3.F6.5.2" class="ltx_text ltx_inline-block" style="width:345.0pt;"> <span id="S3.F6.5.2.1" class="ltx_text">(<span id="S3.F6.5.2.1.1" class="ltx_text ltx_font_smallcaps">Tr-If</span>)</span></span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S3.F6.6" class="ltx_p ltx_figure_panel"><span id="S3.F6.6.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.6.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.6.1.1.1" class="ltx_text"><math id="S3.F6.m6" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\land x\neq m\}s\Longrightarrow t\{[x+n/x]\mathcal{B}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{[e/x]\mathcal{B}\}\mathbf{for}(x:=e;x\neq m;x:=x+n)s\\
\Longrightarrow\mathbf{for}(x:=e;x\neq m;x:=x+n)t\{\mathcal{B}\land x=m\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mi>x</mi><mo>≠</mo><mi>m</mi><mo stretchy="false">}</mo><mi>s</mi><mo stretchy="false">⟹</mo><mi>t</mi><mo stretchy="false">{</mo><mo stretchy="false">[</mo><mi>x</mi><mo>+</mo><mi>n</mi><mo>/</mo><mi>x</mi><mo stretchy="false">]</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable><mtable rowspacing="0pt"><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>e</mi><mo>/</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟𝐨𝐫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mi>m</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">⟹</mo><mi>𝐟𝐨𝐫</mi><mo stretchy="false">(</mo><mi>x</mi><mo>:=</mo><mi>e</mi><mo>;</mo><mi>x</mi><mo>≠</mo><mi>m</mi><mo>;</mo><mi>x</mi><mo>:=</mo><mi>x</mi><mo>+</mo><mi>n</mi><mo stretchy="false">)</mo><mi>t</mi><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>∧</mo><mi>x</mi><mo>=</mo><mi>m</mi><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma\vdash\{\mathcal{B}\land x\neq m\}s\Longrightarrow t\{[x+n/x]\mathcal{B}\}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{[e/x]\mathcal{B}\}\mathbf{for}(x:=e;x\neq m;x:=x+n)s\\
\Longrightarrow\mathbf{for}(x:=e;x\neq m;x:=x+n)t\{\mathcal{B}\land x=m\}\end{array}}</annotation></semantics></math></span> </span>
