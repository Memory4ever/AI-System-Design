<section id="Pt0.A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 0.A </span>Correctness of the Translation</h2>

<section id="Pt0.A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">0.A.1 </span>Assertion language</h3>

<div id="Pt0.A1.SS1.p1" class="ltx_para">
<p id="Pt0.A1.SS1.p1.1" class="ltx_p">We define the syntax and the semantics of the assertion language that was only informally given in the body of the paper.</p>
</div>
<div id="Pt0.A1.SS1.p2" class="ltx_para">
<p id="Pt0.A1.SS1.p2.1" class="ltx_p">The grammar of the assertion language as follows:</p>
<table id="Pt0.A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Pt0.A1.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex108.m1" class="ltx_Math" alttext="\displaystyle\text{(array term)}\quad{\color[rgb]{1,0,1}\mathtt{a}}" display="inline" intent=":literal"><semantics><mrow><mtext>(array term)</mtext><mspace style="width:1em;" width="1em"></mspace><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚊</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{(array term)}\quad{\color[rgb]{1,0,1}\mathtt{a}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex108.m2" class="ltx_math_unparsed" alttext="\displaystyle\Coloneqq a\mid{\color[rgb]{1,0,1}\mathtt{a}}\{{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mapsto{\color[rgb]{1,0,1}\mathtt{e}}_{2}\}" display="inline" intent=":literal"><semantics><mrow><mo>⩴</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚊</mi><mrow><mo stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Coloneqq a\mid{\color[rgb]{1,0,1}\mathtt{a}}\{{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mapsto{\color[rgb]{1,0,1}\mathtt{e}}_{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Pt0.A1.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex109.m1" class="ltx_Math" alttext="\displaystyle\text{(integer term)}\quad{\color[rgb]{1,0,1}\mathtt{e}}" display="inline" intent=":literal"><semantics><mrow><mtext>(integer term)</mtext><mspace style="width:1em;" width="1em"></mspace><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{(integer term)}\quad{\color[rgb]{1,0,1}\mathtt{e}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex109.m2" class="ltx_Math" alttext="\displaystyle\Coloneqq e\mid{\color[rgb]{1,0,1}\mathtt{a}}[{\color[rgb]{1,0,1}\mathtt{e}}]\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mathbin{\mathtt{op}}{\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid\mathit{head}({\color[rgb]{1,0,1}\mathcal{I}})" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩴</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mrow><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚊</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">𝚘𝚙</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub></mrow></mrow><mo fence="false">|</mo><mrow><mi>ℎ𝑒𝑎𝑑</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Coloneqq e\mid{\color[rgb]{1,0,1}\mathtt{a}}[{\color[rgb]{1,0,1}\mathtt{e}}]\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mathbin{\mathtt{op}}{\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid\mathit{head}({\color[rgb]{1,0,1}\mathcal{I}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Pt0.A1.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex110.m1" class="ltx_Math" alttext="\displaystyle\text{(index sequence term)}\quad{\color[rgb]{1,0,1}\mathcal{I}}" display="inline" intent=":literal"><semantics><mrow><mtext>(index sequence term)</mtext><mspace style="width:1em;" width="1em"></mspace><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{(index sequence term)}\quad{\color[rgb]{1,0,1}\mathcal{I}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex110.m2" class="ltx_Math" alttext="\displaystyle\Coloneqq\iota_{a}\mid\mathsf{nil}\mid{\color[rgb]{1,0,1}\mathtt{e}}\cdot{\color[rgb]{1,0,1}\mathcal{I}}\mid{\color[rgb]{1,0,1}\mathcal{I}}\cdot{\color[rgb]{1,0,1}\mathtt{e}}\mid\mathit{tail}({\color[rgb]{1,0,1}\mathcal{I}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>⩴</mo><mrow><mrow><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mi>𝗇𝗂𝗅</mi><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mrow><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi></mrow><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>𝑡𝑎𝑖𝑙</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Coloneqq\iota_{a}\mid\mathsf{nil}\mid{\color[rgb]{1,0,1}\mathtt{e}}\cdot{\color[rgb]{1,0,1}\mathcal{I}}\mid{\color[rgb]{1,0,1}\mathcal{I}}\cdot{\color[rgb]{1,0,1}\mathtt{e}}\mid\mathit{tail}({\color[rgb]{1,0,1}\mathcal{I}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Pt0.A1.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex111.m1" class="ltx_Math" alttext="\displaystyle\text{(formula)}\quad{\color[rgb]{1,0,1}\mathcal{B}}" display="inline" intent=":literal"><semantics><mrow><mtext>(formula)</mtext><mspace style="width:1em;" width="1em"></mspace><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℬ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{(formula)}\quad{\color[rgb]{1,0,1}\mathcal{B}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex111.m2" class="ltx_Math" alttext="\displaystyle\Coloneqq\mathbf{true}\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}={\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}\leq{\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid{\color[rgb]{1,0,1}\mathtt{e}}\in{\color[rgb]{1,0,1}\mathcal{I}}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩴</mo><mi>𝐭𝐫𝐮𝐞</mi></mrow><mo fence="false">|</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub><mo>=</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub></mrow><mo fence="false">|</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub><mo>≤</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub></mrow><mo fence="false">|</mo><mrow><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mo>∈</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Coloneqq\mathbf{true}\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}={\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid{\color[rgb]{1,0,1}\mathtt{e}}_{1}\leq{\color[rgb]{1,0,1}\mathtt{e}}_{2}\mid{\color[rgb]{1,0,1}\mathtt{e}}\in{\color[rgb]{1,0,1}\mathcal{I}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Pt0.A1.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex112.m1" class="ltx_Math" alttext="\displaystyle\mid{\color[rgb]{1,0,1}\mathcal{B}}_{1}\land{\color[rgb]{1,0,1}\mathcal{B}}_{2}\mid\neg{\color[rgb]{1,0,1}\mathcal{B}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∣</mo><mrow><msub><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℬ</mi><mn>1</mn></msub><mo>∧</mo><msub><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℬ</mi><mn>2</mn></msub></mrow><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">¬</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℬ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mid{\color[rgb]{1,0,1}\mathcal{B}}_{1}\land{\color[rgb]{1,0,1}\mathcal{B}}_{2}\mid\neg{\color[rgb]{1,0,1}\mathcal{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Pt0.A1.SS1.p2.2" class="ltx_p">Here <math id="Pt0.A1.SS1.p2.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="Pt0.A1.SS1.p2.m2" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> are array variable and expression that are used in the syntax of source or target language, respectively.
The term <math id="Pt0.A1.SS1.p2.m3" class="ltx_Math" alttext="\iota_{a}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\iota_{a}</annotation></semantics></math> represents the <em id="Pt0.A1.SS1.p2.2.1" class="ltx_emph ltx_font_italic">sequence</em> of indices of an array variable <math id="Pt0.A1.SS1.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>; intuitively it represents the access pattern of the array <math id="Pt0.A1.SS1.p2.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.
The constant <math id="Pt0.A1.SS1.p2.m6" class="ltx_Math" alttext="\mathsf{nil}" display="inline" intent=":literal"><semantics><mi>𝗇𝗂𝗅</mi><annotation encoding="application/x-tex">\mathsf{nil}</annotation></semantics></math> represents the empty list; and <math id="Pt0.A1.SS1.p2.m7" class="ltx_Math" alttext="{\color[rgb]{1,0,1}\mathtt{e}}\cdot{\color[rgb]{1,0,1}\mathcal{I}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{1,0,1}\mathtt{e}}\cdot{\color[rgb]{1,0,1}\mathcal{I}}</annotation></semantics></math> and <math id="Pt0.A1.SS1.p2.m8" class="ltx_Math" alttext="{\color[rgb]{1,0,1}\mathcal{I}}\cdot{\color[rgb]{1,0,1}\mathtt{e}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{1,0,1}\mathcal{I}}\cdot{\color[rgb]{1,0,1}\mathtt{e}}</annotation></semantics></math> respectively represent concatenating an integer <math id="Pt0.A1.SS1.p2.m9" class="ltx_Math" alttext="{\color[rgb]{1,0,1}\mathtt{e}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><annotation encoding="application/x-tex">{\color[rgb]{1,0,1}\mathtt{e}}</annotation></semantics></math> to the head and the tail of the list <math id="Pt0.A1.SS1.p2.m10" class="ltx_Math" alttext="{\color[rgb]{1,0,1}\mathcal{I}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF00FF;" class="ltx_font_mathcaligraphic" mathcolor="#FF00FF">ℐ</mi><annotation encoding="application/x-tex">{\color[rgb]{1,0,1}\mathcal{I}}</annotation></semantics></math>.
As expected, the operations <math id="Pt0.A1.SS1.p2.m11" class="ltx_Math" alttext="\mathit{head}" display="inline" intent=":literal"><semantics><mi>ℎ𝑒𝑎𝑑</mi><annotation encoding="application/x-tex">\mathit{head}</annotation></semantics></math> and <math id="Pt0.A1.SS1.p2.m12" class="ltx_Math" alttext="\mathit{tail}" display="inline" intent=":literal"><semantics><mi>𝑡𝑎𝑖𝑙</mi><annotation encoding="application/x-tex">\mathit{tail}</annotation></semantics></math> returns the head and tail of a sequence.
The intuitive meaning for the rest of the constructors should be clear; see below for their formal interpretation.</p>
</div>
<div id="Pt0.A1.SS1.p3" class="ltx_para">
<p id="Pt0.A1.SS1.p3.1" class="ltx_p">We now define the semantics.
We first give the interpretation of terms.
As expected, array terms are interpreted as a partial map from integers to integers, integer terms are interpreted as integers and index set terms are interpreted as set of integers.
The semantics depends on three parameters <math id="Pt0.A1.SS1.p3.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, <math id="Pt0.A1.SS1.p3.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="Pt0.A1.SS1.p3.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>.
Recall that <math id="Pt0.A1.SS1.p3.m4" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> is a finite map from array variables to integer sequence whose elements are pairwise distinct.
It is used to give the meaning of <math id="Pt0.A1.SS1.p3.m5" class="ltx_Math" alttext="\iota_{a}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\iota_{a}</annotation></semantics></math>.</p>
</div>
<div id="Pt0.A1.SS1.p4" class="ltx_para">
<table id="Pt0.A1.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Pt0.A1.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex113.m1" class="ltx_Math" alttext="\displaystyle\llbracket a\rrbracket_{R,H,\Theta}(m)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟦</mo><mi>a</mi><mo stretchy="false">⟧</mo></mrow><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\llbracket a\rrbracket_{R,H,\Theta}(m)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex113.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\text{def}}}{{=}}H(a,m)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mtext>def</mtext></mover><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\text{def}}}{{=}}H(a,m)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Pt0.A1.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Pt0.A1.Ex114.m1" class="ltx_math_unparsed" alttext="\displaystyle\llbracket{\color[rgb]{1,0,1}\mathtt{a}}\{{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mapsto{\color[rgb]{1,0,1}\mathtt{e}}_{2}\}\rrbracket_{R,H,\Theta}(m)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟦</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚊</mi><mrow><mo stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">⟧</mo></mrow><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\llbracket{\color[rgb]{1,0,1}\mathtt{a}}\{{\color[rgb]{1,0,1}\mathtt{e}}_{1}\mapsto{\color[rgb]{1,0,1}\mathtt{e}}_{2}\}\rrbracket_{R,H,\Theta}(m)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Pt0.A1.Ex114.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\text{def}}}{{=}}\begin{cases}\llbracket{\color[rgb]{1,0,1}\mathtt{e}}_{2}\rrbracket_{R,H,\Theta}&amp;\text{if $\llbracket{\color[rgb]{1,0,1}\mathtt{e}}_{1}\rrbracket_{R,H,\Theta}=m$}\\
\llbracket{\color[rgb]{1,0,1}\mathtt{a}}\rrbracket_{R,H,\Theta}(m)&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mtext>def</mtext></mover><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msub><mrow><mo stretchy="false">⟦</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>2</mn></msub><mo stretchy="false">⟧</mo></mrow><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><msub><mrow><mo stretchy="false">⟦</mo><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚎</mi><mn>1</mn></msub><mo stretchy="false">⟧</mo></mrow><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mo>=</mo><mi>m</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mrow><mo stretchy="false">⟦</mo><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝚊</mi><mo stretchy="false">⟧</mo></mrow><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\text{def}}}{{=}}\begin{cases}\llbracket{\color[rgb]{1,0,1}\mathtt{e}}_{2}\rrbracket_{R,H,\Theta}&amp;\text{if $\llbracket{\color[rgb]{1,0,1}\mathtt{e}}_{1}\rrbracket_{R,H,\Theta}=m$}\\
\llbracket{\color[rgb]{1,0,1}\mathtt{a}}\rrbracket_{R,H,\Theta}(m)&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
