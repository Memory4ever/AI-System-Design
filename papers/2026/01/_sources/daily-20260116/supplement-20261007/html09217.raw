<span class="ltx_td ltx_align_left ltx_eqn_cell"><span id="S3.Ex51.2.1" class="ltx_text ltx_inline-block" style="width:0.0pt;--ltx-fg-color:#0000FF;">// <math id="S3.Ex51.m1" class="ltx_math_unparsed" alttext="\Gamma^{\sharp};\iota_{\mathit{in}}=(x+2)\cdots(N-1)\land\iota_{\mathit{out}}=0\cdots(x-1)\land b_{0}=in[x+1]\land x\neq N-1" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathvariant="normal">Γ</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathvariant="normal">♯</mi></msup><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">;</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑖𝑛</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋯</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">ι</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝑜𝑢𝑡</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋯</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">b</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">0</mn></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∧</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">≠</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">N</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><annotation encoding="application/x-tex">\Gamma^{\sharp};\iota_{\mathit{in}}=(x+2)\cdots(N-1)\land\iota_{\mathit{out}}=0\cdots(x-1)\land b_{0}=in[x+1]\land x\neq N-1</annotation></semantics></math></span></span>
