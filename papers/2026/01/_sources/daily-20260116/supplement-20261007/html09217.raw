8" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="21.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F9.sf2.pic1.m40" class="ltx_Math" alttext="1{,}870" display="inline" intent=":literal"><semantics><mn mathsize="0.500em">1,870</mn><annotation encoding="application/x-tex">1{,}870</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 201.35 67.18)"><foreignObject style="--ltx-fo-width:2.12em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.13em;font-size:7.36pt;" height="5.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="21.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F9.sf2.pic1.m41" class="ltx_Math" alttext="1{,}880" display="inline" intent=":literal"><semantics><mn mathsize="0.500em">1,880</mn><annotation encoding="application/x-tex">1{,}880</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 228.8 46.31)"><foreignObject style="--ltx-fo-width:2.12em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.13em;font-size:7.36pt;" height="5.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="21.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F9.sf2.pic1.m42" class="ltx_Math" alttext="1{,}250" display="inline" intent=":literal"><semantics><mn mathsize="0.500em">1,250</mn><annotation encoding="application/x-tex">1{,}250</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 256.26 170.56)"><foreignObject style="--ltx-fo-width:2.12em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.13em;f