</div></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="S2.F4.14" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_bottom" style="width:120.8pt;">
<p id="S2.F4.14.1" class="ltx_p" style="width:120.8pt;"><span id="S2.F4.14.1.1" class="ltx_text ltx_inline-block" style="width:120.8pt;"><span id="S2.F4.14.1.1.1" class="ltx_text"><math id="S2.F4.m14" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\langle R,H,s\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}{\begin{array}[]{@{}c@{}}\langle R,H,[s]_{K}\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>s</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">⇓</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mrow><mo stretchy="false">[</mo><mi>s</mi><mo stretchy="false">]</mo></mrow><mi>K</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">⇓</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\langle R,H,s\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}{\begin{array}[]{@{}c@{}}\langle R,H,[s]_{K}\rangle\Downarrow\langle R^{\prime},H^{\prime}\rangle\end{array}}</annotation></semantics></math></span> </span></p>
<p id="S2.F4.14.2" class="ltx_p" style="width:120.8pt;"><span id="S2.F4.14.2.1" class="ltx_text">(<span id="S2.F4.14.2.1.1" class="ltx_text ltx_font_smallcaps">R-CallKer</span>)</span></p>
</div></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Reduction rules for the source language.</figcaption>
</figure>
<figure id="S2.F5" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="S2.F5.1" class="ltx_p ltx_figure_panel"><span id="S2.F5.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S2.F5.1.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S2.F5.1.1.1.1" class="ltx_text"><math id="S2.F5.m1" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}S(a)=n\cdot\widetilde{m}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,S,x:={a}.read()\rangle\Downarrow\langle R\{x\mapsto n\},S\{a\mapsto\widetilde{m}\}\rangle\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable><mtr><mtd><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>m</mi><mo>~</mo></mover></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mo stretchy="false">⟨</mo><mi>R</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mo stretchy="false">(</mo><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo stretchy="false">⇓</mo><mo stretchy="false">⟨</mo><mi>R</mi><mo stretchy="false">{</mo><mi>x</mi><mo stretchy="false">↦</mo><mi>n</mi><mo stretchy="false">}</mo><mo>,</mo><mi>S</mi><mo stretchy="false">{</mo><mi>a</mi><mo stretchy="false">↦</mo><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo stretchy="false">}</mo><mo stretchy="false">⟩</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}S(a)=n\cdot\widetilde{m}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,S,x:={a}.read()\rangle\Downarrow\langle R\{x\mapsto n\},S\{a\mapsto\widetilde{m}\}\rangle\end{array}}</annotation></semantics></math></span> </span> <span id="S2.F5.1.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S2.F5.1.1.2.1" class="ltx_text ltx_font_smallcaps">R-Read</span>)</span></span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S2.F5.2" class="ltx_p ltx_figure_panel"><span id="S2.F5.2.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S2.F5.2.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S2.F5.2.1.1.1" class="ltx_text"><math id="S2.F5.m2" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,S,{a}.write(x)\rangle\Downarrow\langle R,S\{a\mapsto S(a)\cdot R(x)\}\rangle\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mphantom></mphantom><mtable><mtr><mtd><mrow><mo stretchy="false">⟨</mo><mi>R</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>w</mi><mi>r</mi><mi>i</mi><mi>t</mi><mi>e</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo><mo stretchy="false">⇓</mo><mo stretchy="false">⟨</mo><mi>R</mi><mo>,</mo><mi>S</mi><mo stretchy="false">{</mo><mi>a</mi><mo stretchy="false">↦</mo><mi>S</mi><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>R</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">}</mo><mo stretchy="false">⟩</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\end{array}}{\begin{array}[]{@{}c@{}}\langle R,S,{a}.write(x)\rangle\Downarrow\langle R,S\{a\mapsto S(a)\cdot R(x)\}\rangle\end{array}}</annotation></semantics></math></span> </span> <span id="S2.F5.2.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;">(<span id="S2.F5.2.1.2.1" class="ltx_text ltx_font_smallcaps">R-Write</span>)</span></span></p></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Reduction rules for the stream operations in the target language.</figcaption>
</figure>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p">The reduction relation for the source language is defined by the rules in Figure <a href="#S2.F4" title="Figure 4 ‣ 2.2 Operational Semantics ‣ 2 Language ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, and the rules are mostly standard.
We only explain points that may need clarification.
In rule <span id="S2.SS2.p2.1.1" class="ltx_text ltx_font_smallcaps">R-Op</span>, <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="\llbracket\mathtt{op}\rrbracket" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟦</mo><mi>𝚘𝚙</mi><mo stretchy="false">⟧</mo></mrow><annotation encoding="application/x-tex">\llbracket\mathtt{op}\rrbracket</annotation></semantics></math> denotes the mathematical function represented by <math id="S2.SS2.p2.m2" class="ltx_Math" alttext="\mathtt{op}" display="inline" intent=":literal"><semantics><mi>𝚘𝚙</mi><annotation encoding="application/x-tex">\mathtt{op}</annotation></semantics></math>.
The loop expression <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="\mathbf{for}(x:=e;x\neq m;x:=x+n)e" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐟𝐨𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>≠</mo><mi>m</mi></mrow><mo>,</mo><mrow><mi>x</mi><mo>:=</mo><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\mathbf{for}(x:=e;x\neq m;x:=x+n)e</annotation></semantics></math> first executes the initialization statement <math id="S2.SS2.p2.m4" class="ltx_Math" alttext="x:=e" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">x:=e</annotation></semantics></math>, which is executed only once, and then checks the condition <math id="S2.SS2.p2.m5" class="ltx_Math" alttext="x\neq m" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≠</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">x\neq m</annotation></semantics></math>.
If the condition does not hold, the for-loop terminates as expressed by <span id="S2.SS2.p2.1.2" class="ltx_text ltx_font_smallcaps">R-ForExit</span>.
Otherwise, the statement <math id="S2.SS2.p2.m6" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> inside the body of the for-loop is executed, and the loop continues with <math id="S2.SS2.p2.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> incremented by <math id="S2.SS2.p2.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> as defined by <span id="S2.SS2.p2.1.3" class="ltx_text ltx_font_smallcaps">R-ForLoop</span>.
We note that the variable <math id="S2.SS2.p2.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is not local to the for-loop. (In fact, all variables in the program are global variables.)
The rule <span id="S2.SS2.p2.1.4" class="ltx_text ltx_font_smallcaps">R-CallKer</span> just says that <math id="S2.SS2.p2.m10" class="ltx_Math" alttext="[" display="inline" intent=":literal"><semantics><mo stretchy="false">[</mo><annotation encoding="application/x-tex">[</annotation></semantics></math> and <math id="S2.SS2.p2.m11" class="ltx_math_unparsed" alttext="]_{K}" display="inline" intent=":literal"><semantics><msub><mo stretchy="false">]</mo><mi>K</mi></msub><annotation encoding="application/x-tex">]_{K}</annotation></semantics></math> do not affect the reduction.</p>
</div>
<div id="S2.SS2.p3" class="ltx_para">
<p id="S2.SS2.p3.1" class="ltx_p">The reduction rules for the stream operations in the target language are given in Figure <a href="#S2.F5" title="Figure 5 ‣ 2.2 Operational Semantics ‣ 2 Language ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
Here the state takes a <em id="S2.SS2.p3.1.1" class="ltx_emph ltx_font_italic">stream pool</em> <math id="S2.SS2.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> instead of a heap.
A stream pool is a finite map from array variables to (possibly empty) integer sequences.
We write <math id="S2.SS2.p3.m2" class="ltx_Math" alttext="\widetilde{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{m}</annotation></semantics></math> for an integer sequence and <math id="S2.SS2.p3.m3" class="ltx_Math" alttext="n\cdot\widetilde{m}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>m</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">n\cdot\widetilde{m}</annotation></semantics></math> (resp. <math id="S2.SS2.p3.m4" class="ltx_Math" alttext="\widetilde{m}\cdot n" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\widetilde{m}\cdot n</annotation></semantics></math>) for the sequence obtained by adding <math id="S2.SS2.p3.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> to the head (resp. end) of <math id="S2.SS2.p3.m6" class="ltx_Math" alttext="\widetilde{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{m}</annotation></semantics></math>.
The rule <span id="S2.SS2.p3.1.2" class="ltx_text ltx_font_smallcaps">R-Read</span> pops an integer from the head of a stream, and assigns it to <math id="S2.SS2.p3.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> (if the stream is empty, the reduction is stuck), and <span id="S2.SS2.p3.1.3" class="ltx_text ltx_font_smallcaps">R-Write</span> adds the value assigned to <math id="S2.SS2.p3.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> to the end of the sequence.
The remaining rules are identical to those of the source language, and are therefore omitted.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Formalization of Translation</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">This section defines the translation for inserting buffering commands and replacing array accesses with stream operations.
The translation relation is defined by using a kind of relational Hoare logic.
The source and target languages for the translation are the language defined in Section <a href="#S2" title="2 Language ‣ Relational Hoare Logic for High-Level Synthesis of Hardware Accelerators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Translation Relation</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">The set of types, ranged over by <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, is given by:</p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\displaystyle\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\displaystyle\tau</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex19.m2" class="ltx_Math" alttext="\displaystyle::=\mathbf{int}\mid\mathbf{buf}\mid\mathbf{rarray}\mid\mathbf{warray}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>:=</mo><mi>𝐢𝐧𝐭</mi></mrow></mrow><mo fence="false">|</mo><mrow><mi>𝐛𝐮𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle::=\mathbf{int}\mid\mathbf{buf}\mid\mathbf{rarray}\mid\mathbf{warray}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">Here, <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{int}" display="inline" intent=":literal"><semantics><mi>𝐢𝐧𝐭</mi><annotation encoding="application/x-tex">\mathbf{int}</annotation></semantics></math> is the type of integer expressions, and <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\mathbf{buf}" display="inline" intent=":literal"><semantics><mi>𝐛𝐮𝐟</mi><annotation encoding="application/x-tex">\mathbf{buf}</annotation></semantics></math> is the type of buffer variables;
a variable of type <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="\mathbf{buf}" display="inline" intent=":literal"><semantics><mi>𝐛𝐮𝐟</mi><annotation encoding="application/x-tex">\mathbf{buf}</annotation></semantics></math> is also used to store an integer, but only occurs in the target of the translation.
The types <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="\mathbf{rarray}" display="inline" intent=":literal"><semantics><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi><annotation encoding="application/x-tex">\mathbf{rarray}</annotation></semantics></math> and <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="\mathbf{warray}" display="inline" intent=":literal"><semantics><mi>𝐰𝐚𝐫𝐫𝐚𝐲</mi><annotation encoding="application/x-tex">\mathbf{warray}</annotation></semantics></math> respectively describe read- and write-only arrays.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">The translation relation is of the form <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\Gamma\vdash\{\mathcal{B}\}s\Longrightarrow t\{\mathcal{B}^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mrow><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">⟹</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma\vdash\{\mathcal{B}\}s\Longrightarrow t\{\mathcal{B}^{\prime}\}</annotation></semantics></math>, where
(i) <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> is a type environment of the form <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="x_{1}\mathbin{:}\tau_{1},\ldots,x_{n}\mathbin{:}\tau_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msub><mi>τ</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>x</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">:</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x_{1}\mathbin{:}\tau_{1},\ldots,x_{n}\mathbin{:}\tau_{n}</annotation></semantics></math>;
(ii) <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> are source and target programs respectively;
and
(iii) <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> and <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="\mathcal{B}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{B}^{\prime}</annotation></semantics></math> are respectively the pre- and post-conditions;
i.e., <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> (<math id="S3.SS1.p2.m9" class="ltx_Math" alttext="\mathcal{B}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{B}^{\prime}</annotation></semantics></math>, resp.) describes a (relational) property that holds for
the states of the source and target programs before (after, resp.) the executions of <math id="S3.SS1.p2.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and <math id="S3.SS1.p2.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
We will also introduce an auxiliary relation of the form <math id="S3.SS1.p2.m12" class="ltx_math_unparsed" alttext="\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0em">∙</mo><mo lspace="0em" stretchy="false">⟹</mo><mi>t</mi><mrow><mo stretchy="false">{</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma\vdash\{\mathcal{B}\}\bullet\Longrightarrow t\{\mathcal{B}^{\prime}\}</annotation></semantics></math>, which
means that <math id="S3.SS1.p2.m13" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> may be inserted in the place where <math id="S3.SS1.p2.m14" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> holds; <math id="S3.SS1.p2.m15" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math> may be regarded as
a skip command.</p>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">For example, we have:</p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex20.m1" class="ltx_math_unparsed" alttext="\displaystyle x\mathbin{:}\mathbf{int},a\mathbin{:}\mathbf{rarray},b\mathbin{:}\mathbf{buf}\vdash\{b=a[1]\}x:=a[1]\Longrightarrow x:=b\{x=a[1]\}." display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi><mo>,</mo><mi>a</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi><mo>,</mo><mi>b</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐛𝐮𝐟</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mi>x</mi><mo>:=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟹</mo><mi>x</mi><mo>:=</mo><mi>b</mi><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle x\mathbin{:}\mathbf{int},a\mathbin{:}\mathbf{rarray},b\mathbin{:}\mathbf{buf}\vdash\{b=a[1]\}x:=a[1]\Longrightarrow x:=b\{x=a[1]\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p3.2" class="ltx_p">It means that if <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="b=a[1]" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=a[1]</annotation></semantics></math> holds, i.e., the value of <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> is stored in <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>
(which serves as a buffer),
then we can replace <math id="S3.SS1.p3.m4" class="ltx_Math" alttext="x:=a[1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=a[1]</annotation></semantics></math> in the source program with <math id="S3.SS1.p3.m5" class="ltx_Math" alttext="x:=b" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">x:=b</annotation></semantics></math>, to avoid reading <math id="S3.SS1.p3.m6" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> again.
Specifying relational properties of programs using pre- and post-conditions is in the style of relational Hoare logic.
In the above example, the pre-condition expresses a relational property:
<math id="S3.SS1.p3.m7" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> refers to the value of <math id="S3.SS1.p3.m8" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> in the target program, while <math id="S3.SS1.p3.m9" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> refers to the value of
<math id="S3.SS1.p3.m10" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> in the source program.</p>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">Each array <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in the source program <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is converted to a stream (of the same name <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>) in the target program <math id="S3.SS1.p4.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
For each array variable <math id="S3.SS1.p4.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, <math id="S3.SS1.p4.m6" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> may refer to the special variable <math id="S3.SS1.p4.m7" class="ltx_Math" alttext="\iota_{a}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\iota_{a}</annotation></semantics></math>,
which denotes a <em id="S3.SS1.p4.1.1" class="ltx_emph ltx_font_italic">sequence</em> of indices of <math id="S3.SS1.p4.m8" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>,
indicating the order in which elements are stored in the stream <math id="S3.SS1.p4.m9" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in the target program.
For instance, <math id="S3.SS1.p4.m10" class="ltx_Math" alttext="\iota_{a}=1\cdot 3\cdot 5" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}=1\cdot 3\cdot 5</annotation></semantics></math>
means that the values of <math id="S3.SS1.p4.m11" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math>, <math id="S3.SS1.p4.m12" class="ltx_Math" alttext="a[3]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[3]</annotation></semantics></math> and <math id="S3.SS1.p4.m13" class="ltx_Math" alttext="a[5]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>5</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[5]</annotation></semantics></math> are stored in this order in the stream <math id="S3.SS1.p4.m14" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.
As a concrete example, we have:</p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex21.m1" class="ltx_math_unparsed" alttext="\displaystyle\Gamma\vdash\{\iota_{a}=1\cdot J\}x:=a[1]\Longrightarrow b:={a}.read();x:=b\{\iota_{a}=J\land x=b=a[1]\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><mi>x</mi><mo>:=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟹</mo><mi>b</mi><mo>:=</mo><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>r</mi><mi>e</mi><mi>a</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow><mo>;</mo><mi>x</mi><mo>:=</mo><mi>b</mi><mrow><mo stretchy="false">{</mo><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi><mo>∧</mo><mi>x</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>a</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Gamma\vdash\{\iota_{a}=1\cdot J\}x:=a[1]\Longrightarrow b:={a}.read();x:=b\{\iota_{a}=J\land x=b=a[1]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p4.2" class="ltx_p">where <math id="S3.SS1.p4.m15" class="ltx_Math" alttext="\Gamma=x\mathbin{:}\mathbf{int},a\mathbin{:}\mathbf{rarray},b\mathbin{:}\mathbf{buf}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>=</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐢𝐧𝐭</mi></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow><mo>,</mo><mrow><mi>b</mi><mo lspace="0.222em" rspace="0.222em">:</mo><mi>𝐛𝐮𝐟</mi></mrow></mrow><annotation encoding="application/x-tex">\Gamma=x\mathbin{:}\mathbf{int},a\mathbin{:}\mathbf{rarray},b\mathbin{:}\mathbf{buf}</annotation></semantics></math>.
The judgment means that if <math id="S3.SS1.p4.m16" class="ltx_Math" alttext="\iota_{a}=1\cdot J" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}=1\cdot J</annotation></semantics></math> holds,
then the command <math id="S3.SS1.p4.m17" class="ltx_Math" alttext="x:=a[1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>:=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x:=a[1]</annotation></semantics></math> may be replaced with <math id="S3.SS1.p4.m18" class="ltx_Math" alttext="b:={a}.read();x:=b" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>:=</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mrow><mi>x</mi><mo>:=</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">b:={a}.read();x:=b</annotation></semantics></math>,
and <math id="S3.SS1.p4.m19" class="ltx_Math" alttext="\iota_{a}=J\land x=b=a[1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mi>J</mi><mo>∧</mo><mi>x</mi></mrow><mo>=</mo><mi>b</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}=J\land x=b=a[1]</annotation></semantics></math> hold afterwards.
The pre-condition <math id="S3.SS1.p4.m20" class="ltx_Math" alttext="\iota_{a}=1\cdot J" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>J</mi></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}=1\cdot J</annotation></semantics></math> ensures that the value of <math id="S3.SS1.p4.m21" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> is stored in the head of the stream in the target
program; thus, the array read <math id="S3.SS1.p4.m22" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> can safely be replaced with the stream read <math id="S3.SS1.p4.m23" class="ltx_Math" alttext="{a}.read()" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{a}.read()</annotation></semantics></math>, and <math id="S3.SS1.p4.m24" class="ltx_Math" alttext="\iota_{a}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\iota_{a}</annotation></semantics></math> is updated to
<math id="S3.SS1.p4.m25" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> afterwards, as expressed by the post-condition <math id="S3.SS1.p4.m26" class="ltx_Math" alttext="\iota_{a}=J" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo>=</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">\iota_{a}=J</annotation></semantics></math>.
The other post-condition <math id="S3.SS1.p4.m27" class="ltx_Math" alttext="x=b=a[1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>b</mi><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x=b=a[1]</annotation></semantics></math> states that <math id="S3.SS1.p4.m28" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S3.SS1.p4.m29" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> hold the value of <math id="S3.SS1.p4.m30" class="ltx_Math" alttext="a[1]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a[1]</annotation></semantics></math> in the source program.
Note that a sequence of indices refers to a finite sequence, whose elements may include variables or expressions.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Translation Rules</h3>

<figure id="S3.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="S3.F6.1" class="ltx_p ltx_figure_panel"><span id="S3.F6.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;"><span id="S3.F6.1.1.1" class="ltx_text ltx_inline-block" style="width:279.3pt;"><span id="S3.F6.1.1.1.1" class="ltx_text"><math id="S3.F6.m1" class="ltx_Math" alttext="\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma(x)=\mathbf{int}\quad\quad\Gamma(a)=\mathbf{rarray}\\
\Gamma\vdash e:\mathbf{int}\quad\quad\Gamma(b)=\mathbf{buf}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{b=a[e]\land[b/x]\mathcal{B}\}x:=a[e]\Longrightarrow x:=b\{\mathcal{B}\}\end{array}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐢𝐧𝐭</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐫𝐚𝐫𝐫𝐚𝐲</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mi>e</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝐢𝐧𝐭</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐛𝐮𝐟</mi></mrow></mrow></mtd></mtr></mtable><mtable><mtr><mtd><mrow><mi mathvariant="normal">Γ</mi><mo>⊢</mo><mo stretchy="false">{</mo><mi>b</mi><mo>=</mo><mi>a</mi><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo><mo>∧</mo><mo stretchy="false">[</mo><mi>b</mi><mo>/</mo><mi>x</mi><mo stretchy="false">]</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo><mi>x</mi><mo>:=</mo><mi>a</mi><mo stretchy="false">[</mo><mi>e</mi><mo stretchy="false">]</mo><mo stretchy="false">⟹</mo><mi>x</mi><mo>:=</mo><mi>b</mi><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">}</mo></mrow></mtd></mtr></mtable></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\begin{array}[]{@{}c@{}}\Gamma(x)=\mathbf{int}\quad\quad\Gamma(a)=\mathbf{rarray}\\
\Gamma\vdash e:\mathbf{int}\quad\quad\Gamma(b)=\mathbf{buf}\end{array}}{\begin{array}[]{@{}c@{}}\Gamma\vdash\{b=a[e]\land[b/x]\mathcal{B}\}x:=a[e]\Longrightarrow x:=b\{\mathcal{B}\}\end{array}}</annotation></semantics></math></span> </span>
