<tr id="S3.T1.4.1.3" class="ltx_tr">
<td id="S3.T1.4.1.3.1" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m3" class="ltx_Math" alttext="\mathcal{O}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒪</mi><annotation encoding="application/x-tex">\mathcal{O}</annotation></semantics></math></td>
<td id="S3.T1.4.1.3.2" class="ltx_td ltx_align_left" style="padding:1pt 2.0pt;">Current visual observation  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="S3.T1.4.1.3.3" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m4" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math></td>
<td id="S3.T1.4.1.3.4" class="ltx_td ltx_align_left" style="padding:1pt 2.0pt;">Predefined contextual set</td></tr>
<tr id="S3.T1.4.1.4" class="ltx_tr">
<td id="S3.T1.4.1.4.1" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m5" class="ltx_Math" alttext="\mathcal{P}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{i}</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.2" class="ltx_td ltx_align_left" style="padding:1pt 2.0pt;">Action sequence (<a href="#S3.E1" title="In III-A Long-horizon Geometric-prior Skill Selector ‣ III Methodology ‣ Generalizable Geometric Prior and Recurrent Spiking Feature Learning for Humanoid Robot Manipulation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">1</span></a>)  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="S3.T1.4.1.4.3" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math></td>
<td id="S3.T1.4.1.4.4" class="ltx_td ltx_align_left" style="padding:1pt 2.0pt;">Adaptive decay factors (<a href="#S3.E3" title="In III-B Recursive Adaptive Spiking Network ‣ III Methodology ‣ Generalizable Geometric Prior and Recurrent Spiking Feature Learning for Humanoid Robot Manipulation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">3</span></a>)</td></tr>
