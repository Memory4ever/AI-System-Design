<td id="S3.T1.4.1.2.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1pt 2.0pt;"><math id="S3.T1.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math></td>
<td id="S3.T1.4.1.2.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding:1pt 2.0pt;">Generated action plan  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
