<th id="S3.T1.4.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:1pt 2.0pt;"><span id="S3.T1.4.1.1.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Description  <span class="ltx_rule" style="width:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></span></th>
