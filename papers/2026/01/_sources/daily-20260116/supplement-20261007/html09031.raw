<td id="S3.T1.4.1.9.3" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m17" class="ltx_Math" alttext="a_{in}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">a_{in}</annotation></semantics></math></td>
<td id="S3.T1.4.1.9.4" class="ltx_td ltx_align_left" style="padding:1pt 2.0pt;">Initial action prediction (<a href="#S3.E16" title="In III-B Recursive Adaptive Spiking Network ‣ III Methodology ‣ Generalizable Geometric Prior and Recurrent Spiking Feature Learning for Humanoid Robot Manipulation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">16</span></a>)</td></tr>
<tr id="S3.T1.4.1.10" class="ltx_tr">
<td id="S3.T1.4.1.10.1" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><math id="S3.T1.m18" class="ltx_Math" alttext="\Sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Sigma_{k}</annotation></semantics></math></td>
