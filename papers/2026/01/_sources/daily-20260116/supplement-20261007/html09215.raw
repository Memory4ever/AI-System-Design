<td id="S4.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.7.1" class="ltx_text ltx_font_bold">Stra.</span></td>
<td id="S4.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.8.1" class="ltx_text ltx_font_bold">Pers.</span></td>
<td id="S4.T1.2.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.9.1" class="ltx_text ltx_font_bold">Con.</span></td>
<td id="S4.T1.2.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.10.1" class="ltx_text ltx_font_bold">Total</span></td></tr>
<tr id="S4.T1.2.3" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<th id="S4.T1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="11"><span id="S4.T1.2.3.1.1" class="ltx_text ltx_font_bold ltx_font_italic">General Baselines</span></th></tr>
