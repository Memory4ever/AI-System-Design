<td id="S4.T1.2.7.2" class="ltx_td ltx_align_center">89.29</td>
<td id="S4.T1.2.7.3" class="ltx_td ltx_align_center">37.71</td>
<td id="S4.T1.2.7.4" class="ltx_td ltx_align_center">41.46</td>
<td id="S4.T1.2.7.5" class="ltx_td ltx_align_center">64.44</td>
<td id="S4.T1.2.7.6" class="ltx_td ltx_align_center">12.30</td>
