          <a class="row-card__heading glue-link" href=https://research.google/pubs/progressive-photorealistic-simplification/ >
            
              Progressive Photorealistic Simplification
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Adi Rosenthal
                      
