                        <a class="row-card__small-link" href="/people/ishanchatterjee/">
                          Ishan Chatterjee
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Mayur Jagdishbhai Patel
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Pu Wang
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
          <div class="row-card__subheading__item small-text">
            2026
          </div>
          
