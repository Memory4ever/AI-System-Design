<td id="S5.T5.5.1.3.6" class="ltx_td ltx_align_right">3</td></tr>
<tr id="S5.T5.5.1.4" class="ltx_tr">
<td id="S5.T5.5.1.4.1" class="ltx_td ltx_align_right">66.49%</td>
<td id="S5.T5.5.1.4.2" class="ltx_td ltx_align_right">21.67</td>
<td id="S5.T5.5.1.4.3" class="ltx_td ltx_align_right">3</td>
<td id="S5.T5.5.1.4.4" class="ltx_td ltx_align_left">True</td>
<td id="S5.T5.5.1.4.5" class="ltx_td ltx_align_right">26</td>
<td id="S5.T5.5.1.4.6" class="ltx_td ltx_align_right">7</td></tr>
<tr id="S5.T5.5.1.5" class="ltx_tr">
<td id="S5.T5.5.1.5.1" class="ltx_td ltx_align_right">61.31%</td>
<td id="S5.T5.5.1.5.2" class="ltx_td ltx_align_right">21.73</td>
<td id="S5.T5.5.1.5.3" class="ltx_td ltx_align_right">1</td>
<td id="S5.T5.5.1.5.4" class="ltx_td ltx_align_left">False</td>
<td id="S5.T5.5.1.5.5" class="ltx_td ltx_align_right">40</td>
<td id="S5.T5.5.1.5.6" class="ltx_td ltx_align_right">3</td></tr>
<tr id="S5.T5.5.1.6" class="ltx_tr">
<td id="S5.T5.5.1.6.1" class="ltx_td ltx_align_right">58.66%</td>
<td id="S5.T5.5.1.6.2" class="ltx_td ltx_align_right">21.75</td>
<td id="S5.T5.5.1.6.3" class="ltx_td ltx_align_right">1</td>
<td id="S5.T5.5.1.6.4" class="ltx_td ltx_align_left">False</td>
<td id="S5.T5.5.1.6.5" class="ltx_td ltx_align_right">16</td>
<td id="S5.T5.5.1.6.6" class="ltx_td ltx_align_right">3</td></tr>
<tr id="S5.T5.5.1.7" class="ltx_tr">
<td id="S5.T5.5.1.7.1" class="ltx_td ltx_align_right">54.79%</td>
<td id="S5.T5.5.1.7.2" class="ltx_td ltx_align_right">21.78</td>
<td id="S5.T5.5.1.7.3" class="ltx_td ltx_align_right">1</td>
<td id="S5.T5.5.1.7.4" class="ltx_td ltx_align_left">True</td>
<td id="S5.T5.5.1.7.5" class="ltx_td ltx_align_right">98</td>
<td id="S5.T5.5.1.7.6" class="ltx_td ltx_align_right">9</td></tr>
<tr id="S5.T5.5.1.8" class="ltx_tr">
<td id="S5.T5.5.1.8.1" class="ltx_td ltx_align_right ltx_border_bb">47.17%</td>
<td id="S5.T5.5.1.8.2" class="ltx_td ltx_align_right ltx_border_bb">22.84</td>
<td id="S5.T5.5.1.8.3" class="ltx_td ltx_align_right ltx_border_bb">4</td>
<td id="S5.T5.5.1.8.4" class="ltx_td ltx_align_left ltx_border_bb">False</td>
<td id="S5.T5.5.1.8.5" class="ltx_td ltx_align_right ltx_border_bb">31</td>
