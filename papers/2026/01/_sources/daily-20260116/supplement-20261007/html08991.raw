<td id="S5.T5.5.1.2.2" class="ltx_td ltx_align_right ltx_border_t">20.12</td>
<td id="S5.T5.5.1.2.3" class="ltx_td ltx_align_right ltx_border_t">4</td>
<td id="S5.T5.5.1.2.4" class="ltx_td ltx_align_left ltx_border_t">True</td>
<td id="S5.T5.5.1.2.5" class="ltx_td ltx_align_right ltx_border_t">83</td>
<td id="S5.T5.5.1.2.6" class="ltx_td ltx_align_right ltx_border_t">3</td></tr>
<tr id="S5.T5.5.1.3" class="ltx_tr">
<td id="S5.T5.5.1.3.1" class="ltx_td ltx_align_right">73.94%</td>
<td id="S5.T5.5.1.3.2" class="ltx_td ltx_align_right">21.00</td>
<td id="S5.T5.5.1.3.3" class="ltx_td ltx_align_right">4</td>
<td id="S5.T5.5.1.3.4" class="ltx_td ltx_align_left">True</td>
