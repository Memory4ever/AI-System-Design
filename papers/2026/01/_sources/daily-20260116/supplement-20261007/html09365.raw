<span id="A2.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[00:15]</span><span id="A2.I1.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A2.I1.i1.p1.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">B</span><span id="A2.I1.i1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">: hello</span></span>
</span></span>
<span id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"> 
<span id="A2.I1.i2.p1" class="ltx_para">
<span id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[00:29]</span><span id="A2.I1.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A2.I1.i2.p1.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">B</span><span id="A2.I1.i2.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">: I’ve found a child’s room.</span></span>
