<span id="A2.I1.i4.p1.1" class="ltx_p"><span id="A2.I1.i4.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[00:34]</span><span id="A2.I1.i4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A2.I1.i4.p1.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">A</span><span id="A2.I1.i4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">: ’s room too</span></span>
