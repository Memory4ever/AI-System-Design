<td id="S3.T4.2.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:-0.5pt 8.0pt;"><span id="S3.T4.2.2.1.1" class="ltx_text" style="--ltx-bg-color:#F6F6F6;">Skywork-Banana</span></td>
