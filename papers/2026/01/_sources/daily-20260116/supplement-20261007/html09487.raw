<td id="A6.T14.2.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="A6.T14.2.1.1.1" class="ltx_text ltx_font_bold">Element Type</span></td>
<td id="A6.T14.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="A6.T14.2.1.2.1" class="ltx_text ltx_font_bold">Count</span></td>
<td id="A6.T14.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="A6.T14.2.1.3.1" class="ltx_text ltx_font_bold">Avg. Score</span></td>
<td id="A6.T14.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="A6.T14.2.1.4.1" class="ltx_text ltx_font_bold">Min. Score</span></td></tr>
<tr id="A6.T14.2.2" class="ltx_tr">
