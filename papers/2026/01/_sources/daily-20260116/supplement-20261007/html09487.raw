<td id="A6.T14.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">15</td>
<td id="A6.T14.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.78</td>
<td id="A6.T14.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.69</td></tr>
<tr id="A6.T14.2.3" class="ltx_tr">
