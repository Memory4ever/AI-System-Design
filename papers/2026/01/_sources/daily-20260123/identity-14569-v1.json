{"id": "14569", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.14569", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.14569", "prefix": "10.48550", "suffix": "arxiv.2601.14569", "identifiers": [{"identifier": "2601.14569", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.14569"}], "creators": [{"name": "Mathur, Leena", "nameType": "Personal", "givenName": "Leena", "familyName": "Mathur", "affiliation": [], "nameIdentifiers": []}, {"name": "Thumu, Bhaavanaa", "nameType": "Personal", "givenName": "Bhaavanaa", "familyName": "Thumu", "affiliation": [], "nameIdentifiers": []}, {"name": "Kebe, Youssouf", "nameType": "Personal", "givenName": "Youssouf", "familyName": "Kebe", "affiliation": [], "nameIdentifiers": []}, {"name": "Morency, Louis-Philippe", "nameType": "Personal", "givenName": "Louis-Philippe", "familyName": "Morency", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Social Caption: Evaluating Social Understanding in Multimodal Models"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Machine Learning (cs.LG)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T01:10:42Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:12:35Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-06-01T20:36:47Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-06-03T00:10:10Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-08-31T17:23:48Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-09-01T02:25:35Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Social understanding abilities are crucial for multimodal large language models (MLLMs) to interpret human social interactions. We introduce SOCIAL CAPTION, a framework grounded in interaction theory to evaluate social understanding abilities of MLLMs along three dimensions: Social Inference (SI), the ability to make accurate inferences about interactions; Holistic Social Analysis (HSA), the ability to generate comprehensive descriptions of interactions; Directed Social Analysis (DSA), the ability to generate relevant information from interactions. We analyze factors influencing model performance in social understanding, such as scale, architectural design, and spoken context. Experiments with MLLM judges demonstrate a path towards scaling automated evaluation of multimodal social understanding.", "descriptionType": "Abstract"}, {"description": "Accepted to Findings of EMNLP 2026. 26 pages, 10 figures", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.14569", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T02:45:26.000Z", "registered": "2026-