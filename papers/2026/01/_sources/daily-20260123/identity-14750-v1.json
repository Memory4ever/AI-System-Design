{"id": "14750", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.14750", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.14750", "prefix": "10.48550", "suffix": "arxiv.2601.14750", "identifiers": [{"identifier": "2601.14750", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.14750"}], "creators": [{"name": "Wang, Yifan", "nameType": "Personal", "givenName": "Yifan", "familyName": "Wang", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Shiyu", "nameType": "Personal", "givenName": "Shiyu", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Peiming", "nameType": "Personal", "givenName": "Peiming", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Yang, Xiaochen", "nameType": "Personal", "givenName": "Xiaochen", "familyName": "Yang", "affiliation": [], "nameIdentifiers": []}, {"name": "Tang, Yang", "nameType": "Personal", "givenName": "Yang", "familyName": "Tang", "affiliation": [], "nameIdentifiers": []}, {"name": "Wei, Zheng", "nameType": "Personal", "givenName": "Zheng", "familyName": "Wei", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Render-of-Thought: Rendering Textual Chain-of-Thought as Images for Visual Latent Reasoning"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Computer Vision and Pattern Recognition (cs.CV)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T08:09:25Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:28:58Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-01-22T12:09:02Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-01-23T01:37:48Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-04-19T03:33:21Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-04-21T00:58:49Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-05-31T05:30:22Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2026-06-02T00:59:49Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}, {"date": "2026", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "4", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Chain-of-Thought (CoT) prompting has achieved remarkable success in unlocking the reasoning capabilities of Large Language Models (LLMs). Although CoT prompting enhances reasoning, its verbosity imposes substantial computational overhead. Recent works often focus exclusively on outcome alignment and lack supervision on the intermediate reasoning process. These deficiencies obscure the analyzability of the latent reasoning chain. To address these challenges, we introduce Render-of-Thought (RoT), the first framework to reify the reasoning chain by rendering textual steps into images, making the latent rationale explicit and traceable. Specifically, we leverage the vision encoders of existing Vision Language Models (VLMs) as semantic anchors to align the vision embeddings with the textual space. This design ensures plug-and-play implementation without incurring additional pre-training overhead. Extensive experiments on mathematical and logical reasoning benchmarks demonstrate that our method achieves 3-4x token compression and substantial inference acceleration compared to explicit CoT. Furthermore, it maintains competitive performance against other methods, validating the feasibility of this paradigm. Our code is available at https://github.com/TencentBAC/RoT", "descriptionType": "Abstract"}, {"description": "Accepted by ACL 2026 Main Conference", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.14750", "contentUrl": null, "metadataVersion": 3, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T02:54:46.000Z", "registered": "2026-01-22T02:54:47.000Z", "published": "2026", "updated": "2026-06-02T04:58:30.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.14750", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": [" \n           Subjects: \n           \n             Computation and Language (cs.CL) ; Computer Vision and Pattern Recognition (cs.CV) \n          \n           Cite as: \n             arXiv:2601.14750  [cs.CL]  \n         \n         \n             \n           (or  \n               arXiv:2601.14750v1  [cs.CL]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601.14750  \n               \n                    \n                 Focus to learn more \n               \n               \n               \n                                    arXiv-issued DOI via DataCite \n             \n           \n         "], "notice_signals": [], "official_url": "https://arxiv.org/abs/2601.14750v1"}