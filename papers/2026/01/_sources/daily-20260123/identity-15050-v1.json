{"id": "15050", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.15050", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.15050", "prefix": "10.48550", "suffix": "arxiv.2601.15050", "identifiers": [{"identifier": "2601.15050", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.15050"}], "creators": [{"name": "Yan, Zhichao", "nameType": "Personal", "givenName": "Zhichao", "familyName": "Yan", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhao, Yunxiao", "nameType": "Personal", "givenName": "Yunxiao", "familyName": "Zhao", "affiliation": [], "nameIdentifiers": []}, {"name": "Wang, Jiapu", "nameType": "Personal", "givenName": "Jiapu", "familyName": "Wang", "affiliation": [], "nameIdentifiers": []}, {"name": "Chen, Jiaoyan", "nameType": "Personal", "givenName": "Jiaoyan", "familyName": "Chen", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Xiaoli", "nameType": "Personal", "givenName": "Xiaoli", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Ru", "nameType": "Personal", "givenName": "Ru", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Pan, Jeff Z.", "nameType": "Personal", "givenName": "Jeff Z.", "familyName": "Pan", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Beyond Factual Accuracy: Evaluating Global Reasoning Integrity in RAG Systems with LogicScore"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T14:52:03Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:48:24Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-01-22T02:56:54Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-01-23T01:15:31Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-01-30T03:12:31Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-02-02T01:21:20Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-05-08T02:58:22Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2026-05-11T00:30:24Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2026-07-28T10:34:30Z", "dateType": "Submitted", "dateInformation": "v5"}, {"date": "2026-07-29T00:42:58Z", "dateType": "Updated", "dateInformation": "v5"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "5", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Current evaluation methods for Retrieval Augmented Generation (RAG) suffer from \\textit{factual myopia}: they relentlessly emphasize factual accuracy yet neglect global logical integrity in long-form answer generation. This drives models to force unnatural connections, producing factually grounded yet logically incoherent responses with unaddressed gaps, ambiguous links, or redundant premises. To mitigate this, we present \\textsc{LogicScore}, shifting from local, fact-by-fact assessment to rigorous global reasoning scrutiny. Grounded in Horn Rules, our approach integrates a backward verification mechanism to systematically evaluate three key reasoning dimensions: \\textit{Completeness} (logically sound deduction), \\textit{Essentiality} (non-redundancy), and \\textit{Determinateness} (consistent answer entailment). Extensive experiments across three multi-hop QA datasets (HotpotQA, MusiQue, and 2WikiMultiHopQA) and over 20 LLMs (including GPT-5, Gemini-3-Pro, LLaMA3, and task-specific tuned models) reveal a critical capability gap: leading models often achieve high factual accuracy (e.g., 92.85\\% precision for Gemini-3 Pro) but struggle with global reasoning quality (e.g., 35.11\\% Essentiality for Gemini-3 Pro). Our work establishes a robust standard for logical evaluation, highlighting the need to prioritize reasoning coherence alongside factual grounding in LLM development.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.15050", "contentUrl": null, "metadataVersion": 4, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T03:02:01.000Z", "registered": "2026-01-22T03:02:02.000Z", "published": "2026", "updated": "2026-07-29T02:28:52.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.15050", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": [" \n           Subjects: \n           \n             Computation and Language (cs.CL)  \n          \n           Cite as: \n             arXiv:2601.15050  [cs.CL]  \n         \n         \n             \n           (or  \n               arXiv:2601.15050v1  [cs.CL]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601