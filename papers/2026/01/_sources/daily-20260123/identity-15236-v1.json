{"id": "15236", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.15236", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.15236", "prefix": "10.48550", "suffix": "arxiv.2601.15236", "identifiers": [{"identifier": "2601.15236", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.15236"}], "creators": [{"name": "Mukherjee, Anjishnu", "nameType": "Personal", "givenName": "Anjishnu", "familyName": "Mukherjee", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhu, Ziwei", "nameType": "Personal", "givenName": "Ziwei", "familyName": "Zhu", "affiliation": [], "nameIdentifiers": []}, {"name": "Anastasopoulos, Antonios", "nameType": "Personal", "givenName": "Antonios", "familyName": "Anastasopoulos", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "MAPLE: Metadata Conditioned LLM Pretraining for Locale-Aware Question Answering"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T18:20:59Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:58:13Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-08-27T03:36:10Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-08-28T00:23:15Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-08-31T05:43:59Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-09-01T01:36:57Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "Creative Commons Attribution Share Alike 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by-sa/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-sa-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "Large language models can memorize competing locale-specific facts yet fail to select among them when the locale changes, defaulting instead to a single globally dominant answer. We formalize this as localized knowledge disambiguation and introduce LocalNewsQA, an 18,700-item English-news benchmark that pairs the same question across two locales and scores whether a model actually switches its answer when the locale changes. We also introduce MAPLE, a controlled family of decoder-only models pretrained with document-level geographic metadata (source URL, country, and continent) already present in the training corpus, and compare it to metadata-free controls trained on identical data with the same token budget, architecture, and optimization. In controlled experiments at 1B and 3B, with inference-time metadata fixed, pretraining with metadata in MAPLE produces measurable switching and improves accuracy on questions whose correct answer depends on locale. Ablations and external-benchmark evaluations further suggest that locale-conditioned prediction benefits from geographic provenance learned during pretraining and that these benefits strengthen at larger model sizes.", "descriptionType": "Abstract"}, {"description": "Published as a conference paper at EMNLP 2026 (Main)", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.15236", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T03:06:27.000Z", "registered": "2026-01-22T03:06:28.000Z", "published": "2026", "updated": "2026-09-01T05:05:14.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.15236", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": ["         \n           Comments: \n           under review \n         \n \n           Subjects: \n           \n             Computation and Language (cs.CL)  \n          \n           Cite as: \n             arXiv:2601.15236  [cs.CL]  \n         \n         \n             \n           (or  \n               arXiv:2601.15236v1  [cs.CL]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601.15236  \n               \n                    \n                 Focus to learn more \n               \n               \n               \n                                    arXiv-issued DOI via DataCite \n             \n           \n         "], "notice_signals": [], "official_url": "https://arxiv.org/abs/2601.15236v1"}