{"id": "14735", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.14735", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.14735", "prefix": "10.48550", "suffix": "arxiv.2601.14735", "identifiers": [{"identifier": "2601.14735", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.14735"}], "creators": [{"name": "Kollorath, Haseeb Abdullah", "nameType": "Personal", "givenName": "Haseeb Abdullah", "familyName": "Kollorath", "affiliation": [], "nameIdentifiers": []}, {"name": "Jha, Vaibhav", "nameType": "Personal", "givenName": "Vaibhav", "familyName": "Jha", "affiliation": [], "nameIdentifiers": []}, {"name": "Kulkarni, Varad", "nameType": "Personal", "givenName": "Varad", "familyName": "Kulkarni", "affiliation": [], "nameIdentifiers": []}, {"name": "Vinay", "nameType": "Organizational", "affiliation": [], "nameIdentifiers": []}, {"name": "Reddy, Nikhil", "nameType": "Personal", "givenName": "Nikhil", "familyName": "Reddy", "affiliation": [], "nameIdentifiers": []}, {"name": "Eswaran, Anand", "nameType": "Personal", "givenName": "Anand", "familyName": "Eswaran", "affiliation": [], "nameIdentifiers": []}, {"name": "Jayachandran, Praveen", "nameType": "Personal", "givenName": "Praveen", "familyName": "Jayachandran", "affiliation": [], "nameIdentifiers": []}, {"name": "Simmhan, Yogesh", "nameType": "Personal", "givenName": "Yogesh", "familyName": "Simmhan", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "FAME: QoS-aware Async Service Orchestration for Agentic Workflows"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Distributed, Parallel, and Cluster Computing (cs.DC)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T07:46:25Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:27:46Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-01-27T10:56:16Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-01-28T01:46:08Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-08-10T02:51:19Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-08-11T01:25:09Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Agentic workflows built on Large Language Models (LLMs) increasingly rely on external tools, with Model Context Protocol (MCP) services emerging as a common interface for tool discovery and invocation. These workflows are stateful, bursty and can block for minutes to hours while external tools execute. Always-on virtual machines and managed agent runtimes simplify deployment, but can over-provision capacity, bill idle wait time or encounter execution limits for long-running tool calls. We present FAME, a service-oriented middleware that optimizes MCP-enabled agentic workflows through modular service orchestration, explicit state management, MCP service input/output reduction and timeout-safe async invocation for long-running external services. FAME realizes these composite services using FaaS-based agent roles, persists workflow state through agent memory injection, and reduces MCP service overhead using S3 handle passing and tool-output caching. For long-running external MCP tools, FAME checkpoints agent and orchestrator state, suspends execution and resumes from callbacks without billing idle waits. Across 26 short-running service tasks over 10 MCP servers, FAME improves service-level QoS by reducing infrastructure cost by 8-12x relative to virtual machines and 43-106x relative to managed runtimes, while reducing latency by up to 17x, input tokens by up to 88% and total cost by up to 66%. On two long-running MLZero workloads from MLE-Bench, FAME completes all iterations while synchronous AWS Step Functions time out, and is 3.64-4.24x cheaper than AWS Durable Functions at the agent level and 2.67-8.23x cheaper at the orchestrator level.", "descriptionType": "Abstract"}, {"description": "Extended version of paper to appear in the proceedings of the International Conference on Web Services (ICWS), 2026", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.14735", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T02:54:24.000Z", "registered": "2026-01-22T02:54:25.000Z", "published": "2026", "updated": "2026-08-11T04:15:40.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.14735", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": [" \n           Subjects: \n           \n             Distributed, Parallel, and Cluster Computing (cs.DC)  \n          \n           Cite a