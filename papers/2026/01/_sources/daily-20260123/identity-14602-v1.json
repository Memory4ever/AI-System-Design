{"id": "14602", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.14602", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.14602", "prefix": "10.48550", "suffix": "arxiv.2601.14602", "identifiers": [{"identifier": "2601.14602", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.14602"}], "creators": [{"name": "Saha, Oindrila", "nameType": "Personal", "givenName": "Oindrila", "familyName": "Saha", "affiliation": [], "nameIdentifiers": []}, {"name": "Krs, Vojtech", "nameType": "Personal", "givenName": "Vojtech", "familyName": "Krs", "affiliation": [], "nameIdentifiers": []}, {"name": "Mech, Radomir", "nameType": "Personal", "givenName": "Radomir", "familyName": "Mech", "affiliation": [], "nameIdentifiers": []}, {"name": "Maji, Subhransu", "nameType": "Personal", "givenName": "Subhransu", "familyName": "Maji", "affiliation": [], "nameIdentifiers": []}, {"name": "Gadelha, Matheus", "nameType": "Personal", "givenName": "Matheus", "familyName": "Gadelha", "affiliation": [], "nameIdentifiers": []}, {"name": "Blackburn-Matzen, Kevin", "nameType": "Personal", "givenName": "Kevin", "familyName": "Blackburn-Matzen", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "3D Space as a Scratchpad for Editable Text-to-Image Generation"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computer Vision and Pattern Recognition (cs.CV)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T02:40:19Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:15:15Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}, {"date": "2026", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "1", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Recent progress in large language models (LLMs) has shown that reasoning improves when intermediate thoughts are externalized into explicit workspaces, such as chain-of-thought traces or tool-augmented reasoning. Yet, visual language models (VLMs) lack an analogous mechanism for spatial reasoning, limiting their ability to generate images that accurately reflect geometric relations, object identities, and compositional intent. We introduce the concept of a spatial scratchpad -- a 3D reasoning substrate that bridges linguistic intent and image synthesis. Given a text prompt, our framework parses subjects and background elements, instantiates them as editable 3D meshes, and employs agentic scene planning for placement, orientation, and viewpoint selection. The resulting 3D arrangement is rendered back into the image domain with identity-preserving cues, enabling the VLM to generate spatially consistent and visually coherent outputs. Unlike prior 2D layout-based methods, our approach supports intuitive 3D edits that propagate reliably into final images. Empirically, it achieves a 32% improvement in text alignment on GenAI-Bench, demonstrating the benefit of explicit 3D reasoning for precise, controllable image generation. Our results highlight a new paradigm for vision-language models that deliberate not only in language, but also in space. Code and visualizations at https://oindrilasaha.github.io/3DScratchpad/", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.14602", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T02:46:11.000Z", "registered": "2026-01-22T02:46:12.000Z", "published": "2026", "updated": "2026-01-22T02:46:12.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.14602", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": [" \n           Subjects: \n           \n             Computer Vision and Pattern Recognition (cs.CV)  \n          \n           Cite as: \n             arXiv:2601.14602  [cs.CV]  \n         \n         \n             \n           (or  \n               arXiv:2601.14602v1  [cs.CV]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601.14602  \n               \n                    \n                 Focus to learn more \n               \n               \n               \n                                    arXiv-issued DOI via DataCite \n             \n           \n         "], "notice_signals": [], "official_url": "https://arxiv.org/abs/2601.14602v1"}