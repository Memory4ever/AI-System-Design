{"id": "15232", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.15232", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.15232", "prefix": "10.48550", "suffix": "arxiv.2601.15232", "identifiers": [{"identifier": "2601.15232", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.15232"}], "creators": [{"name": "Islam, Niful", "nameType": "Personal", "givenName": "Niful", "familyName": "Islam", "affiliation": [], "nameIdentifiers": []}, {"name": "Ayon, Ragib Shahriar", "nameType": "Personal", "givenName": "Ragib Shahriar", "familyName": "Ayon", "affiliation": [], "nameIdentifiers": []}, {"name": "Thomas, Deepak George", "nameType": "Personal", "givenName": "Deepak George", "familyName": "Thomas", "affiliation": [], "nameIdentifiers": []}, {"name": "Ahmed, Shibbir", "nameType": "Personal", "givenName": "Shibbir", "familyName": "Ahmed", "affiliation": [], "nameIdentifiers": []}, {"name": "Wardat, Mohammad", "nameType": "Personal", "givenName": "Mohammad", "familyName": "Wardat", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "When Agents Fail: A Comprehensive Study of Bugs in LLM Agents with Automated Labeling"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Software Engineering (cs.SE)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T18:13:10Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:57:48Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-04-25T00:03:45Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-04-28T00:13:41Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-08-19T14:55:53Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-08-20T00:53:42Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Large Language Models (LLMs) have revolutionized intelligent application development. While standalone LLMs cannot perform any actions, LLM agents address the limitation by integrating tools. However, debugging LLM agents is difficult and costly, as the field is still in its early stages and the community is underdeveloped. To understand the bugs encountered during agent development, we present the first comprehensive study of bug types, root causes, and effects in LLM agent-based software. We collected and analyzed 1,268 bug-related posts and code snippets from Stack Overflow, GitHub, and Hugging Face forums, focused on LLM agents built with seven widely used LLM frameworks as well as custom implementations. For a deeper analysis, we have also studied the component of the LLM agent where the bug occurred, along with the programming language and framework. This study also investigates the feasibility of automating bug identification. For that, we have built a ReAct agent named BugReAct, equipped with adequate external tools to determine whether it can detect and annotate the bugs in our dataset. According to our study, we found that BugReAct equipped with Gemini 2.5 Flash achieved a remarkable performance in annotating bug characteristics with an average cost of 0.01 USD per post/code snippet.", "descriptionType": "Abstract"}, {"description": "Accepted at ISSRE 2026", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.15232", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T03:06:22.000Z", "registered": "2026-01-22T03:06:23.000Z", "published": "2026", "updated": "2026-08-20T02:19:37.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.15232", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": ["         \n           Comments: \n           A version of this paper has been submitted to ACM Transactions on Software Engineering and Methodology \n         \n \n           Subjects: \n           \n             Software Engineering (cs.SE)  \n          \n           Cite as: \n             arXiv:2601.15232  [cs.SE]  \n         \n         \n             \n           (or  \n               arXiv:2601.15232v1  [cs.SE]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601.15232  \n               \n                    \n                 Focus to learn more \n               \n               \n               \n                                    arXiv-issued DOI via DataCite \n             \n           \n         "], "notice_signals": [], "official_url": "https://arxiv.org/abs/2601.15232v1"}