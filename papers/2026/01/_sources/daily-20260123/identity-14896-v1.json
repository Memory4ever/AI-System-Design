{"id": "14896", "checked": "2026-10-04", "event": "v1", "datacite": {"data": {"id": "10.48550/arxiv.2601.14896", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2601.14896", "prefix": "10.48550", "suffix": "arxiv.2601.14896", "identifiers": [{"identifier": "2601.14896", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2601.14896"}], "creators": [{"name": "Qi, Rui", "nameType": "Personal", "givenName": "Rui", "familyName": "Qi", "affiliation": [], "nameIdentifiers": []}, {"name": "Mo, Fengran", "nameType": "Personal", "givenName": "Fengran", "familyName": "Mo", "affiliation": [], "nameIdentifiers": []}, {"name": "Chen, Yufeng", "nameType": "Personal", "givenName": "Yufeng", "familyName": "Chen", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhang, Xue", "nameType": "Personal", "givenName": "Xue", "familyName": "Zhang", "affiliation": [], "nameIdentifiers": []}, {"name": "Wang, Shuo", "nameType": "Personal", "givenName": "Shuo", "familyName": "Wang", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Hongliang", "nameType": "Personal", "givenName": "Hongliang", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Xu, Jinan", "nameType": "Personal", "givenName": "Jinan", "familyName": "Xu", "affiliation": [], "nameIdentifiers": []}, {"name": "Nie, Jian-Yun", "nameType": "Personal", "givenName": "Jian-Yun", "familyName": "Nie", "affiliation": [], "nameIdentifiers": []}, {"name": "Huang, Kaiyu", "nameType": "Personal", "givenName": "Kaiyu", "familyName": "Huang", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Language-Coupled Reinforcement Learning for Multilingual Retrieval-Augmented Generation"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-01-21T11:32:32Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-01-22T01:39:13Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-04-22T13:29:18Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-04-23T00:51:59Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-07-27T04:19:56Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-07-28T01:12:19Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-01", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Multilingual retrieval-augmented generation (MRAG) requires models to effectively acquire and integrate beneficial external knowledge from multilingual collections. However, most existing studies employ a unitive process where queries of equivalent semantics across different languages are processed through a single-turn retrieval and subsequent optimization. Such a ``one-size-fits-all'' strategy is often suboptimal in multilingual settings, as the models occur to knowledge bias and conflict during the interaction with the search engine. To alleviate the issues, we propose LcRL, a multilingual search-augmented reinforcement learning framework that integrates a language-coupled Group Relative Policy Optimization into the policy and reward models. We adopt the language-coupled group sampling in the rollout module to reduce knowledge bias, and regularize an auxiliary anti-consistency penalty in the reward models to mitigate the knowledge conflict. Experimental results demonstrate that LcRL not only achieves competitive performance but is also appropriate for various practical scenarios such as constrained training data and retrieval over collections encompassing a large number of languages. Our code is available at https://github.com/Cherry-qwq/LcRL-Open.", "descriptionType": "Abstract"}, {"description": "Accepted to ACL 2026 (Findings)", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2601.14896", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-01-22T02:58:16.000Z", "registered": "2026-01-22T02:58:16.000Z", "published": "2026", "updated": "2026-07-28T03:50:52.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2601.14896", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}, "official_metadata": [" \n           Subjects: \n           \n             Computation and Language (cs.CL)  \n          \n           Cite as: \n             arXiv:2601.14896  [cs.CL]  \n         \n         \n             \n           (or  \n               arXiv:2601.14896v1  [cs.CL]  for this version)\n           \n         \n         \n             \n                          https://doi.org/10.48550/arXiv.2601.14896  \n               \n                    \n                 Focus to learn more \n               \n               \n 