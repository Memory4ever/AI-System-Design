{"data":{"id":"10.48550/arxiv.2604.01621","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.01621","prefix":"10.48550","suffix":"arxiv.2604.01621","identifiers":[{"identifier":"2604.01621","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.01621"}],"creators":[{"name":"Li, Wanqian","nameType":"Personal","givenName":"Wanqian","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Jintao","nameType":"Personal","givenName":"Jintao","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Jing, Zongfei","nameType":"Personal","givenName":"Zongfei","familyName":"Jing","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Tianyu","nameType":"Personal","givenName":"Tianyu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Long, Ze","nameType":"Personal","givenName":"Ze","familyName":"Long","affiliation":[],"nameIdentifiers":[]},{"name":"Qiao, Xianjie","nameType":"Personal","givenName":"Xianjie","familyName":"Qiao","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xiaoming","nameType":"Personal","givenName":"Xiaoming","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Dongxu","nameType":"Personal","givenName":"Dongxu","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Duan, Kefeng","nameType":"Personal","givenName":"Kefeng","familyName":"Duan","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, June","nameType":"Personal","givenName":"June","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DWDP: Distributed Weight Data Parallelism for High-Performance LLM Inference on NVL72"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-02T05:00:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-03T00:25:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T14:19:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T01:09:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language model (LLM) inference increasingly depends on multi-GPU execution, yet existing inference parallelization strategies require layer-wise inter-rank synchronization, making end-to-end performance sensitive to workload imbalance. We present DWDP (Distributed Weight Data Parallelism), an inference parallelization strategy that preserves data-parallel execution while offloading MoE weights across peer GPUs and fetching missing experts on demand. By removing collective inter-rank synchronization, DWDP allows each GPU to progress independently. We further address the practical overheads of this design with two optimizations for split-weight management and asynchronous remote-weight prefetch. Implemented in TensorRT-LLM and evaluated with DeepSeek-R1 on GB200 NVL72, DWDP improves end-to-end output TPS/GPU by 8.8% at comparable TPS/user in the 20-100 TPS/user serving range under 8K input sequence length and 1K output sequence length.","descriptionType":"Abstract"},{"description":"Technical Report. 17 pages. 8 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.01621","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-03T01:52:35.000Z","registered":"2026-04-03T01:52:36.000Z","published":"2026","updated":"2026-05-13T03:03:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.01621","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}