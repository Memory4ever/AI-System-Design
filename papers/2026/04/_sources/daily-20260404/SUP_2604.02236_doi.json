{"data":{"id":"10.48550/arxiv.2604.02236","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.02236","prefix":"10.48550","suffix":"arxiv.2604.02236","identifiers":[{"identifier":"2604.02236","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.02236"}],"creators":[{"name":"Zhao, Minda","nameType":"Personal","givenName":"Minda","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Yutong","nameType":"Personal","givenName":"Yutong","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Chufei","nameType":"Personal","givenName":"Chufei","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Gonsalves, Rachel","nameType":"Personal","givenName":"Rachel","familyName":"Gonsalves","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Weiyue","nameType":"Personal","givenName":"Weiyue","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Ruyi","nameType":"Personal","givenName":"Ruyi","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Zhixi","nameType":"Personal","givenName":"Zhixi","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Mengyu","nameType":"Personal","givenName":"Mengyu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Emotions in Prompts Matter? Effects of Emotional Framing on Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-02T16:31:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-03T01:01:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Emotional tone is pervasive in human communication, yet its influence on large language model (LLM) behaviour remains unclear. Here, we examine how first-person emotional framing in user-side queries affect LLM performance across six benchmark domains, including mathematical reasoning, medical question answering, reading comprehension, commonsense reasoning and social inference. Across models and tasks, static emotional prefixes usually produce only small changes in accuracy, suggesting that affective phrasing is typically a mild perturbation rather than a reliable general-purpose intervention. This stability is not uniform: effects are more variable in socially grounded tasks, where emotional context more plausibly interacts with interpersonal reasoning. Additional analyses show that stronger emotional wording induces only modest extra change, and that human-written prefixes reproduce the same qualitative pattern as LLM-generated ones. We then introduce EmotionRL, an adaptive emotional prompting framework that selects emotional framing adaptively for each query. Although no single emotion is consistently beneficial, adaptive selection yields more reliable gains than fixed emotional prompting. Together, these findings show that emotional tone is neither a dominant driver of LLM performance nor irrelevant noise, but a weak and input-dependent signal that can be exploited through adaptive control.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.02236","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-03T02:07:12.000Z","registered":"2026-04-03T02:07:13.000Z","published":"2026","updated":"2026-04-03T02:07:13.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.02236","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}