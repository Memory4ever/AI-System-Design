{"data":{"id":"10.48550/arxiv.2604.02176","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.02176","prefix":"10.48550","suffix":"arxiv.2604.02176","identifiers":[{"identifier":"2604.02176","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.02176"}],"creators":[{"name":"Lu, Hongyuan Adam","nameType":"Personal","givenName":"Hongyuan Adam","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"L., Z.","nameType":"Personal","givenName":"Z.","familyName":"L.","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Victor","nameType":"Personal","givenName":"Victor","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zefan","nameType":"Personal","givenName":"Zefan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Hong, Zhao","nameType":"Personal","givenName":"Zhao","familyName":"Hong","affiliation":[],"nameIdentifiers":[]},{"name":"Xiang, Qiqi","nameType":"Personal","givenName":"Qiqi","familyName":"Xiang","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Bowen","nameType":"Personal","givenName":"Bowen","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Lam, Wai","nameType":"Personal","givenName":"Wai","familyName":"Lam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adam's Law: Textual Frequency Law on Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-02T15:39:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-03T00:57:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T03:28:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T00:24:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-28T15:43:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-30T01:07:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"While textual frequency has been validated as relevant to human cognition in reading speed, its relatedness to Large Language Models (LLMs) is seldom studied. We propose a novel research direction in terms of textual data frequency, which is an understudied topic, to the best of our knowledge. Our framework is composed of three units. First, this paper proposes Textual Frequency Law (TFL), which indicates that frequent textual data should be preferred for LLMs for both prompting and fine-tuning. Since many LLMs are closed-source in their training data, we propose using online resources to estimate the sentence-level frequency. We then utilize an input paraphraser to paraphrase the input into a more frequent textual expression. Next, we propose Textual Frequency Distillation (TFD) by querying LLMs to conduct story completion by further extending the sentences in the datasets, and the resulting corpora are used to adjust the initial estimation. Finally, we propose Curriculum Textual Frequency Training (CTFT) that fine-tunes LLMs in an increasing order of sentence-level frequency. Experiments are conducted on our curated dataset Textual Frequency Paired Dataset (TFPD) on math reasoning, machine translation, commonsense reasoning and agentic tool calling. Results show the effectiveness of our framework.","descriptionType":"Abstract"},{"description":"ACL 2026 Main Conference; The latest version","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.02176","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-03T02:05:42.000Z","registered":"2026-04-03T02:05:43.000Z","published":"2026","updated":"2026-06-30T04:13:03.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.02176","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}