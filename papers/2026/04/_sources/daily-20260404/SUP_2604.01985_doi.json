{"data":{"id":"10.48550/arxiv.2604.01985","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.01985","prefix":"10.48550","suffix":"arxiv.2604.01985","identifiers":[{"identifier":"2604.01985","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.01985"}],"creators":[{"name":"Liu, Yuejiang","nameType":"Personal","givenName":"Yuejiang","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Feng, Fan","nameType":"Personal","givenName":"Fan","familyName":"Feng","affiliation":[],"nameIdentifiers":[]},{"name":"Kong, Lingjing","nameType":"Personal","givenName":"Lingjing","familyName":"Kong","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Weifeng","nameType":"Personal","givenName":"Weifeng","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jinzhou","nameType":"Personal","givenName":"Jinzhou","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Kun","nameType":"Personal","givenName":"Kun","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Murphy, Kevin","nameType":"Personal","givenName":"Kevin","familyName":"Murphy","affiliation":[],"nameIdentifiers":[]},{"name":"Finn, Chelsea","nameType":"Personal","givenName":"Chelsea","familyName":"Finn","affiliation":[],"nameIdentifiers":[]},{"name":"Du, Yilun","nameType":"Personal","givenName":"Yilun","familyName":"Du","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"World Action Verifier: Self-Improving World Models via Forward-Inverse Asymmetry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-02T12:48:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-03T00:46:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-29T16:27:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-01T01:13:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"General-purpose world models promise scalable policy evaluation, optimization, and planning, yet achieving the required level of robustness remains challenging. Unlike policy learning which primarily focuses on optimal actions, a world model needs to be reliable over a vast space of suboptimal actions, which are often underrepresented in action-labeled robot interactions. To address this challenge, we propose World Action Verifier (WAV), a framework that enables world models to identify their own prediction errors and self-improve. The key idea is to decompose action-conditioned state prediction into two independently verifiable factors: state plausibility and action reachability. We show that verifying these factors is significantly more tractable than direct forward prediction due to two underlying asymmetries: the broader availability of action-free data and the lower dimensionality of action-relevant features. Leveraging these asymmetries, we augment a world model with (i) a diverse subgoal generator obtained from video corpora and (ii) a sparse inverse model that infers actions from a subset of state features. By enforcing cycle consistency among proposed subgoals, inferred actions, and forward rollouts, WAV provides an effective verification mechanism in under-explored regimes, where existing methods often fail. Across nine tasks spanning MiniGrid, RoboMimic, and ManiSkill, our method achieves 2x higher sample efficiency while improving downstream policy performance by over 22%.","descriptionType":"Abstract"},{"description":"Project Website: https://world-action-verifier.github.io","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.01985","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-03T02:01:11.000Z","registered":"2026-04-03T02:01:12.000Z","published":"2026","updated":"2026-06-01T02:39:26.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.01985","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}