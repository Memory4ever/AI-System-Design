{"data":{"id":"10.48550/arxiv.2604.02102","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.02102","prefix":"10.48550","suffix":"arxiv.2604.02102","identifiers":[{"identifier":"2604.02102","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.02102"}],"creators":[{"name":"Sun, Haitong","nameType":"Personal","givenName":"Haitong","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"McIntosh, Stephen","nameType":"Personal","givenName":"Stephen","familyName":"McIntosh","affiliation":[],"nameIdentifiers":[]},{"name":"Choi, Kwanghee","nameType":"Personal","givenName":"Kwanghee","familyName":"Choi","affiliation":[],"nameIdentifiers":[]},{"name":"Yeo, Eunjung","nameType":"Personal","givenName":"Eunjung","familyName":"Yeo","affiliation":[],"nameIdentifiers":[]},{"name":"Saito, Daisuke","nameType":"Personal","givenName":"Daisuke","familyName":"Saito","affiliation":[],"nameIdentifiers":[]},{"name":"Minematsu, Nobuaki","nameType":"Personal","givenName":"Nobuaki","familyName":"Minematsu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prosodic ABX: A Language-Agnostic Method for Measuring Prosodic Contrast in Speech Representations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"lang":"en","subject":"Audio and Speech Processing (eess.AS)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-02T14:28:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-03T00:53:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-28T00:24:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-29T01:59:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Speech representations from self-supervised speech models (S3Ms) are known to be sensitive to phonemic contrasts, but their sensitivity to prosodic contrasts has not been directly measured. The ABX discrimination task has been used to measure phonemic contrast in S3M representations via minimal pairs. We introduce prosodic ABX, an extension of this framework to evaluate prosodic contrast with only a handful of examples and no explicit labels. Also, we build and release a dataset of English and Japanese minimal pairs and use it along with a Mandarin dataset to evaluate contrast in English stress, Japanese pitch accent, and Mandarin tone. Finally, we show that model and layer rankings are often preserved across several experimental conditions, making it practical for low-resource settings.","descriptionType":"Abstract"},{"description":"Presented at Interspeech 2026; 6 pages, 4 figures; Supplement: https://stephenmac7.github.io/prosodic-abx/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.02102","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-03T02:03:56.000Z","registered":"2026-04-03T02:03:57.000Z","published":"2026","updated":"2026-09-29T07:03:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.02102","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}