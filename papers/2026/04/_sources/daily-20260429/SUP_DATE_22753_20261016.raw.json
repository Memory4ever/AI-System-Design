{"data":{"id":"10.48550/arxiv.2604.22753","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.22753","prefix":"10.48550","suffix":"arxiv.2604.22753","identifiers":[{"identifier":"2604.22753","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.22753"}],"creators":[{"name":"Li, Sijie","nameType":"Personal","givenName":"Sijie","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shanda","nameType":"Personal","givenName":"Shanda","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Haowei","nameType":"Personal","givenName":"Haowei","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Weiwei","nameType":"Personal","givenName":"Weiwei","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Talwalkar, Ameet","nameType":"Personal","givenName":"Ameet","familyName":"Talwalkar","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Yiming","nameType":"Personal","givenName":"Yiming","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spend Less, Fit Better: Budget-Efficient Scaling Law Fitting via Active Experiment Selection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-24T17:59:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-27T00:52:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-12T03:27:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-13T00:18:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Scaling laws are used to plan multi-million-dollar training runs, but fitting those laws can itself cost millions. In modern large-scale workflows, assembling a sufficiently informative set of pilot experiments is already a major budget-allocation problem rather than a routine preprocessing step. We formulate scaling-law fitting as budget-aware sequential experimental design: given a finite pool of runnable experiments with heterogeneous costs, choose which runs to execute so as to maximize extrapolation accuracy in a high-cost target region. We propose $\\mathrm{SL}^2$ (Scaling Laws, Spend Less), an uncertainty-aware method for sequentially allocating experimental budget toward the runs most useful for target-region extrapolation. Across a diverse benchmark of scaling-law tasks, $\\mathrm{SL}^2$ outperforms classical design-based baselines, and often approaches the performance of fitting on the full experimental set while using only about 10\\% of the total training budget. Our code is available at https://github.com/PlanarG/active-sl.","descriptionType":"Abstract"},{"description":"COLM 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.22753","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-27T01:45:20.000Z","registered":"2026-04-27T01:45:21.000Z","published":"2026","updated":"2026-08-13T02:14:24.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.22753","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}