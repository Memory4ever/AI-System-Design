{"data":{"id":"10.48550/arxiv.2604.22242","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.22242","prefix":"10.48550","suffix":"arxiv.2604.22242","identifiers":[{"identifier":"2604.22242","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.22242"}],"creators":[{"name":"Curtin, Ryan R.","nameType":"Personal","givenName":"Ryan R.","familyName":"Curtin","affiliation":[],"nameIdentifiers":[]},{"name":"Edel, Marcus","nameType":"Personal","givenName":"Marcus","familyName":"Edel","affiliation":[],"nameIdentifiers":[]},{"name":"Sanderson, Conrad","nameType":"Personal","givenName":"Conrad","familyName":"Sanderson","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast GPU Linear Algebra via Compile Time Expression Fusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Mathematical Software (cs.MS)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"G.4; G.1.3; D.2.3; F.2.1","subjectScheme":"ACM"},{"lang":"en","subject":"68N99, 65Y04, 65Y15, 65F45","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-04-24T05:34:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-27T00:19:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-03T02:11:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T00:16:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We describe the Bandicoot GPU linear algebra toolkit for C++, which prioritises ease of use without compromising efficiency. Bandicoot's API aims for compatibility with the popular Armadillo CPU linear algebra library, enabling easy transition for existing CPU-based codebases. Unlike other GPU-focused toolkits, Bandicoot uses template metaprogramming to generate fused GPU kernels directly at compile-time, yielding efficient kernels that can saturate memory bandwidth. This removes the need for run-time overhead or JIT infrastructure. Empirical results show that Bandicoot outperforms (sometimes by considerable margins) commonly-used linear algebra toolkits including PyTorch, TensorFlow, and JAX.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.22242","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-27T01:32:33.000Z","registered":"2026-04-27T01:32:34.000Z","published":"2026","updated":"2026-07-07T05:07:39.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.22242","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}