<td id="A2.T5.1.4.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T5.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#EBEBEB;">224,876</span></td></tr>
