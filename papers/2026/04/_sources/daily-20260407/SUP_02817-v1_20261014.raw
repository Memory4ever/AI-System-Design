<tr id="S4.T4.fig1.3.4" class="ltx_tr">
<th id="S4.T4.fig1.3.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">Segmentation</th>
<td id="S4.T4.fig1.3.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">17.5</td>
<td id="S4.T4.fig1.3.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">27.4</td>
