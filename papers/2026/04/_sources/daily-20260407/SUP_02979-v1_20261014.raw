<td id="S4.F12.fig3.6.8.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.F12.m11" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathsize="0.500em" mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math></td></tr>
