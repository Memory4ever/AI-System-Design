<td id="S4.F12.fig3.6.9.5" class="ltx_td ltx_align_center"><span id="S4.F12.fig3.6.9.5.1" class="ltx_text" style="font-size:50%;">0.6723</span></td>
<td id="S4.F12.fig3.6.9.6" class="ltx_td ltx_align_center"><span id="S4.F12.fig3.6.9.6.1" class="ltx_text" style="font-size:50%;">17.48</span></td></tr>
