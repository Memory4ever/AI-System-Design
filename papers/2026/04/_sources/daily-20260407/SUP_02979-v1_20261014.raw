<td id="S4.F12.fig3.6.9.3" class="ltx_td ltx_align_center"><span id="S4.F12.fig3.6.9.3.1" class="ltx_text" style="font-size:50%;">2.38<math id="S4.F12.m12" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
