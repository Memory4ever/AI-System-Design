</span></figcaption>
<div id="S4.T5.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:496.9pt;height:68.6pt;vertical-align:-30.8pt;"><span class="ltx_transformed_inner" style="transform:translate(70.1pt,-9.7pt) scale(1.39316836040898,1.39316836040898) ;">
<table id="S4.T5.5.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T5.5.1.1" class="ltx_tr">
<th id="S4.T5.5.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T5.5.1.1.1.1" class="ltx_text ltx_font_bold">Methods</span></th>
<th id="S4.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T5.5.1.1.2.1" class="ltx_text ltx_font_bold">ScanRefer</span></th>
<th id="S4.T5.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T5.5.1.1.3.1" class="ltx_text ltx_font_bold">Multi3DRefer</span></th>
