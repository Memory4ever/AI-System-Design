<td id="S4.T9.5.1.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">50.93</td>
<td id="S4.T9.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">35.49</td>
<td id="S4.T9.5.1.3.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">14.01</td>
<td id="S4.T9.5.1.3.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">54.97</td></tr>
<tr id="S4.T9.5.1.4" class="ltx_tr">
<th id="S4.T9.5.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">0.2</th>
<td id="S4.T9.5.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.5.1.4.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">51.35</span></td>
<td id="S4.T9.5.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">51.44</td>
<td id="S4.T9.5.1.4.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.5.1.4.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">35.96</span></td>
<td id="S4.T9.5.1.4.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">14.37</td>
