<tr id="S4.T9.5.1.5" class="ltx_tr">
<th id="S4.T9.5.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">0.3</th>
<td id="S4.T9.5.1.5.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">50.93</td>
<td id="S4.T9.5.1.5.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.5.1.5.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">51.49</span></td>
<td id="S4.T9.5.1.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">35.28</td>
<td id="S4.T9.5.1.5.5" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.5.1.5.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">14.41</span></td>
<td id="S4.T9.5.1.5.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;">55.10</td></tr>
