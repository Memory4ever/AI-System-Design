<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg1.l12.m1" class="ltx_Math" alttext="scale\leftarrow absmax[blockIdx]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">←</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">scale\leftarrow absmax[blockIdx]</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <math id="alg1.l13.m1" class="ltx_math_unparsed" alttext="out[2j]\leftarrow smem\_nf4[qval\gg 4]\times scale" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mi>u</mi><mi>t</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mi>j</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mi>s</mi><mi>m</mi><mi>e</mi><mi>m</mi><mi>_</mi><mi>n</mi><mi>f</mi><mn>4</mn><mrow><mo stretchy="false">[</mo><mi>q</mi><mi>v</mi><mi>a</mi><mi>l</mi><mo>≫</mo><mn>4</mn><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>s</mi><mi>c</mi><mi>a</mi><mi>l</mi><mi>e</mi></mrow><annotation encoding="application/x-tex">out[2j]\leftarrow smem\_nf4[qval\gg 4]\times scale</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <math id="alg1.l14.m1" class="ltx_math_unparsed" alttext="out[2j+1]\leftarrow smem\_nf4[qval" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mi>u</mi><mi>t</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mi>j</mi><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mi>s</mi><mi>m</mi><mi>e</mi><mi>m</mi><mi>_</mi><mi>n</mi><mi>f</mi><mn>4</mn><mrow><mo stretchy="false">[</mo><mi>q</mi><mi>v</mi><mi>a</mi><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">out[2j+1]\leftarrow smem\_nf4[qval</annotation></semantics></math> &amp; <math id="alg1.l14.m2" class="ltx_math_unparsed" alttext="0x0F]\times scale" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mi>x</mi><mn>0</mn><mi>F</mi><mo rspace="0.055em" stretchy="false">]</mo><mo rspace="0.222em">×</mo><mi>s</mi><mi>c</mi><mi>a</mi><mi>l</mi><mi>e</mi></mrow><annotation encoding="application/x-tex">0x0F]\times scale</annotation></semantics></math>

