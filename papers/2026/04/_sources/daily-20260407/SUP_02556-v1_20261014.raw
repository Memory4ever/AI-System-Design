<td id="S6.T2.3.9.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S6.T2.3.9.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2.04<math id="S6.T2.m21" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td></tr>
