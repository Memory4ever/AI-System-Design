<td id="S3.T1.3.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.3.3.2.1" class="ltx_text" style="font-size:80%;">39.8</span></td>
<td id="S3.T1.3.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.3.3.3.1" class="ltx_text" style="font-size:80%;">12983</span></td></tr>
<tr id="S3.T1.3.4" class="ltx_tr">
<td id="S3.T1.3.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="S3.T1.3.4.1.1" class="ltx_text" style="font-size:80%;">4</span></td>
<td id="S3.T1.3.4.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T1.3.4.2.1" class="ltx_text" style="font-size:80%;">39.3</span></td>
