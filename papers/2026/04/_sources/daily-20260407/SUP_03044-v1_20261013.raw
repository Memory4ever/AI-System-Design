<figure id="S3.F8.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2604.03044v1/acc_vs_token_sep_bar_LiveBench.png" id="S3.F8.sf4.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/397;" width="476" height="397" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(d) </span></figcaption>
