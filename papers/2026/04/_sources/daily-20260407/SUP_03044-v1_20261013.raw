<tr id="S2.T1.2.12" class="ltx_tr">
<td id="S2.T1.2.12.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">QK Non-RoPE Dimension (<math id="S2.T1.m5" class="ltx_Math" alttext="d_{\text{nope}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>nope</mtext></msub><annotation encoding="application/x-tex">d_{\text{nope}}</annotation></semantics></math>)</td>
<td id="S2.T1.2.12.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">64</td></tr>
