<td id="S2.T1.2.6.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">Vocabulary Size (<math id="S2.T1.m3" class="ltx_Math" alttext="|V|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|V|</annotation></semantics></math>)</td>
<td id="S2.T1.2.6.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">129K</td></tr>
<tr id="S2.T1.2.7" class="ltx_tr">
