<tr id="S2.T1.2.3" class="ltx_tr">
<td id="S2.T1.2.3.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">Total Layers (<math id="S2.T1.m1" class="ltx_Math" alttext="N_{\text{layers}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>layers</mtext></msub><annotation encoding="application/x-tex">N_{\text{layers}}</annotation></semantics></math>)</td>
