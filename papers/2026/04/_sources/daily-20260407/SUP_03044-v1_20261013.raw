<p id="S3.T3.4.1.6.1.1" class="ltx_p"><span id="S3.T3.4.1.6.1.1.1" class="ltx_text ltx_font_bold">JoyAI-LLM Flash</span></p>
</span></div></td></tr>
<tr id="S3.T3.4.2" class="ltx_tr">
<td id="S3.T3.4.2.1" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">Acc</td>
<td id="S3.T3.4.2.2" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">#Token</td>
<td id="S3.T3.4.2.3" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">Acc</td>
<td id="S3.T3.4.2.4" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">#Token</td>
<td id="S3.T3.4.2.5" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">Acc</td>
