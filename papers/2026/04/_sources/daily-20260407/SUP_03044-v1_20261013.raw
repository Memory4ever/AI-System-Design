<td id="S2.T1.2.10.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">MLA</td></tr>
<tr id="S2.T1.2.11" class="ltx_tr">
<td id="S2.T1.2.11.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">Attention Heads (<math id="S2.T1.m4" class="ltx_Math" alttext="n_{h}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>h</mi></msub><annotation encoding="application/x-tex">n_{h}</annotation></semantics></math>)</td>
