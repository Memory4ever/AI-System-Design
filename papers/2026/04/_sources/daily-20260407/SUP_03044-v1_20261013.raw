<td id="S2.T1.2.7.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">128K</td></tr>
<tr id="S2.T1.2.8" class="ltx_tr">
<td id="S2.T1.2.8.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">Activation Function</td>
<td id="S2.T1.2.8.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">SwiGLU</td></tr>
<tr id="S2.T1.2.9" class="ltx_tr" style="--ltx-bg-color:#EBEBEB;">
<td id="S2.T1.2.9.1" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;" colspan="2"><span id="S2.T1.2.9.1.1" class="ltx_text ltx_font_bold">Attention Mechanism</span></td></tr>
