<td id="S2.T1.2.14.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">Value Dimension (<math id="S2.T1.m7" class="ltx_Math" alttext="d_{v}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>v</mi></msub><annotation encoding="application/x-tex">d_{v}</annotation></semantics></math>)</td>
<td id="S2.T1.2.14.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">128</td></tr>
<tr id="S2.T1.2.15" class="ltx_tr" style="--ltx-bg-color:#EBEBEB;">
<td id="S2.T1.2.15.1" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;" colspan="2"><span id="S2.T1.2.15.1.1" class="ltx_text ltx_font_bold">Mixture-of-Experts</span></td></tr>
<tr id="S2.T1.2.16" class="ltx_tr">
