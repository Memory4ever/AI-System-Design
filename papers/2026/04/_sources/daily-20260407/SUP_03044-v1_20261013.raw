<td id="S2.T1.2.13.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">QK RoPE Dimension (<math id="S2.T1.m6" class="ltx_Math" alttext="d_{\text{rope}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>rope</mtext></msub><annotation encoding="application/x-tex">d_{\text{rope}}</annotation></semantics></math>)</td>
<td id="S2.T1.2.13.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">128</td></tr>
