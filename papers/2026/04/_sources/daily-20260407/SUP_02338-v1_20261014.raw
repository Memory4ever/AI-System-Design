<span id="A7.SS9.pic1.3.1" class="ltx_p"><math id="A7.SS9.pic1.m13" class="ltx_Math" alttext="z\leftarrow{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></mrow><annotation encoding="application/x-tex">z\leftarrow{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x</annotation></semantics></math><span id="A7.SS9.pic1.3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">  <span id="A7.SS9.pic1.3.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// <math id="A7.SS9.pic1.m14" class="ltx_Math" alttext="z\in\mathbb{R}^{B\times T\times d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">z</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">ℝ</mi><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">B</mi><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">T</mi><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">d</mi><mtext style="--ltx-fg-color:#808080;" class="ltx_mathvariant_italic" mathcolor="#808080">o</mtext></msub></mrow></msup></mrow><annotation encoding="application/x-tex">z\in\mathbb{R}^{B\times T\times d_{\text{o}}}</annotation></semantics></math>, frozen computation</span> 
