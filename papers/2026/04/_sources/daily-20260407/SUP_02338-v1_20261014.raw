<span id="A7.SS9.pic1.3.2" class="ltx_p"><math id="A7.SS9.pic1.m15" class="ltx_Math" alttext="\hat{z}\leftarrow{\hat{z}}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{z}\leftarrow{\hat{z}}(x)</annotation></semantics></math><span id="A7.SS9.pic1.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">  <span id="A7.SS9.pic1.3.2.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// <math id="A7.SS9.pic1.m16" class="ltx_Math" alttext="\hat{z}\in\mathbb{R}^{B\times T\times d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">ℝ</mi><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">B</mi><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">T</mi><mo style="--ltx-fg-color:#808080;" lspace="0.222em" mathcolor="#808080" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">d</mi><mtext style="--ltx-fg-color:#808080;