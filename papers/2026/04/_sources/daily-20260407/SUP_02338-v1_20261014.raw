 <math id="A7.SS9.pic1.m20" class="ltx_math_unparsed" alttext="w\leftarrow\mathrm{softmax}\!\left(\frac{(1-\gamma_{r})\cdot\tilde{z}_{1:E}+\gamma_{r}\cdot\tilde{\hat{z}}_{1:E}}{\tau}\right)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mpadded style="width:3.720em;" width="3.720em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">softmax</mi></mpadded><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mover accent="true"><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo s