<td id="A4.T4.5.8.1" class="ltx_td ltx_align_left ltx_border_bbbb"><span id="A4.T4.5.8.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E8F5E0;">Relative Threshold (Ours)</span></td>
<td id="A4.T4.5.8.2" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A4.T4.m19" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="w_{i}(x)\geq\theta\cdot w_{[1]}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">w</mi><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">x</mi><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">≥</mo><mrow><mrow><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">θ</mi><mo style="--ltx-bg-color:#E8F5E0;" lspace="0.222em" mathbackground="#E8F5E0" mathsize="0.900em" rspace="0.222em">⋅</mo><msub><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">w</mi><mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">[</mo><mn style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">1</mn><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">]</mo></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">x</mi><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{i}(x)\geq\theta\cdot w_{[1]}(x)</annotation></semantics></math></td>
<td id="A4.T4.5.8.3" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A4.T4.m20" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="\theta" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></td>
<td id="A4.T4.5.8.4" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="A4.T4.m21" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="O(E)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">O</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.900em">E</mi><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(E)</annotation></semantics></math></td></tr>
