<span id="A7.SS9.pic1.3.4" class="ltx_p"><math id="A7.SS9.pic1.m21" class="ltx_Math" alttext="\mathcal{S}_{\theta}\leftarrow\{i:w_{i}\geq\theta\cdot\max_{j}w_{j}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒮</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\theta}\leftarrow\{i:w_{i}\geq\theta\cdot\max_{j}w_{j}\}</annotation></semantics></math><span id="A7.SS9.pic1.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">  <span id="A7.SS9.pic1.3.4.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// adaptive selection</span> 
<br class="ltx_break"> <math id="A7.SS9.pic1.m22" class="ltx_Math" alttext="\tilde{w}_{i}\leftarrow w_{i}\,/\,{\textstyle\sum_{j\in\mathcal{S}_{\theta}}w_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒮</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{w}_{i}\leftarrow w_{i}\,/\,{\textstyle\sum_{j\in\mathcal{S}_{\theta}}w_{j}}</annotation></semantics></math>  <span id="A7.SS9.pic1.3.4.1.2" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// renormalize</span> 
