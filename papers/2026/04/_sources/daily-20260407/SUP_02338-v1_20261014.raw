</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.62 860.59)"><foreignObject style="--ltx-fo-width:35.17em;--ltx-fo-height:19.82em;--ltx-fo-depth:0em;font-size:10pt;" height="274.22" overflow="visible" transform="matrix(1 0 0 -1 0 274.22)" width="486.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A7.SS9.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:35.17em;">
<span id="A7.SS9.pic1.2.1" class="ltx_p"><span id="A7.SS9.pic1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Input:<span id="A7.SS9.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> <math id="A7.SS9.pic1.m1" class="ltx_Math" alttext="x\in\mathbb{R}^{B\times T\times d_{\text{i}}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mtext></msub></mrow></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{B\times T\times d_{\text{i}}}</annotation></semantics></math>  <span id="A7.SS9.pic1.2.1.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// batch of token sequences</span> 
<br class="ltx_break" style="--ltx-break-space:2.8pt;"></span></span></span>
<span id="A7.SS9.pic1.2.2" class="ltx_p"><span id="A7.SS9.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Parameters:<span id="A7.SS9.pic1.2.2.1.1" class="ltx_text ltx_font_medium"> 
<br class="ltx_break"> <span id="A7.SS9.pic1.2.2.1.1.1" class="ltx_text" style="--ltx-bg-color:#E3ECF4;">Frozen:</span> <math id="A7.SS9.pic1.m2" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}\in\mathbb{R}^{d_{\text{o}}\times d_{\text{i}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mtext></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mtext></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}\in\mathbb{R}^{d_{\text{o}}\times d_{\text{i}}}</annotation></semantics></math>  <span id="A7.SS9.pic1.2.2.1.1.2" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// pretrained linear layer</span> 
<br class="ltx_break"> <span id="A7.SS9.pic1.2.2.1.1.3" class="ltx_text" style="--ltx-bg-color:#FBECDE;">PEFT:</span> <math id="A7.SS9.pic1.m3" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}</annotation></semantics></math>  <span id="A7.SS9.pic1.2.2.1.1.4" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// any PEFT parameters (LoRA, Adapter, etc.)</span> 
<br class="ltx_break"> <span id="A7.SS9.pic1.2.2.1.1.5" class="ltx_text" style="--ltx-bg-color:#FBECDE;">Experts:</span> <math id="A7.SS9.pic1.m4" class="ltx_Math" alttext="\{{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\}_{i=1}^{E}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.110em" minsize="1.110em">{</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.110em" minsize="1.110em">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></msubsup><annotation encoding="application/x-tex">\{{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\}_{i=1}^{E}</annotation></semantics></math>, <math id="A7.SS9.pic1.m5" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math>  <span id="A7.SS9.pic1.2.2.1.1.6" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// expert modulators</span> 
<br class="ltx_break"> <span id="A7.SS9.pic1.2.2.1.1.7" class="ltx_text" style="--ltx-bg-color:#FBECDE;">Shared:</span> <math id="A7.SS9.pic1.m6" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s}\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s}\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math>, <math id="A7.SS9.pic1.m7" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\in\mathbb{R}</annotation></semantics></math>  <span id="A7.SS9.pic1.2.2.1.1.8" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// shared modulator (optional)</span> 
<br class="ltx_break" style="--ltx-break-space:2.8pt;"></span></span></span>
<span id="A7.SS9.pic1.2.3" class="ltx_p"><span id="A7.SS9.pic1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Hyperparameters:<span id="A7.SS9.pic1.2.3.1.1" class="ltx_text ltx_font_medium"> <math id="A7.SS9.pic1.m8" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> (temperature), <math id="A7.SS9.pic1.m9" class="ltx_Math" alttext="\gamma_{r}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><annotation encoding="application/x-tex">\gamma_{r}</annotation></semantics></math> (routing balance), <math id="A7.SS9.pic1.m10" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> (threshold), <math id="A7.SS9.pic1.m11" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, <math id="A7.SS9.pic1.m12" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> (loss weights) 
<br class="ltx_break" style="--ltx-break-space:4.6pt;"></span></span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.62 17.08)"><foreignObject style="--ltx-fo-width:32.53em;--ltx-fo-height:59.25em;--ltx-fo-depth:0.25em;font-size:10pt;" height="823.36" overflow="visible" transform="matrix(1 0 0 -1 0 819.9)" width="450.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
