<span id="A7.SS9.pic1.3.5" class="ltx_p"><math id="A7.SS9.pic1.m23" class="ltx_Math" alttext="\mathcal{P}\leftarrow{\textstyle\sum_{i\in\mathcal{S}_{\theta}}}\tilde{w}_{i}\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒫</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em" stretchy="false">←</mo><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒮</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow></msub><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}\leftarrow{\textstyle\sum_{i\in\mathcal{S}_{\theta}}}\tilde{w}_{i}\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}</annotation></semantics></math><span id="A7.SS9.pic1.3.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">  <span id="A7.SS9.pic1.3.5.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// weighted expert combination</span> 
