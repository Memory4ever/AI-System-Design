<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A2.p3.4" class="ltx_p"><span id="A2.p3.4.1" class="ltx_text">Taking the infimum over <math id="A2.p3.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> yields</span></p>
<table id="A2.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex64.m1" class="ltx_Math" alttext="\big|\mathcal{R}^{*}(U^{(\sigma)}_{\text{MoE}})-\mathcal{R}^{*}(U^{(\sigma)}_{LiME})\big|\leq L_{\max}\cdot\frac{\overline{\varepsilon}}{2\sigma}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>U</mi><mtext>MoE</mtext><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>U</mi><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>max</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mover accent="true"><mi>ε</mi><mo stretchy="true">¯</mo></mover><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big|\mathcal{R}^{*}(U^{(\sigma)}_{\text{MoE}})-\mathcal{R}^{*}(U^{(\sigma)}_{LiME})\big|\leq L_{\max}\cdot\frac{\overline{\varepsilon}}{2\sigma}.</annotation></semantics></math></td>
