mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∥</mo><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\hat{z}}_{1:E}\leftarrow\hat{z}_{[:,:,1:E]}\,/\,\|\hat{z}_{[:,:,1:E]}\|_{\infty}</annotation></semantics></math> 
