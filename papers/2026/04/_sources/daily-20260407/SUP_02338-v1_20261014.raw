<td id="S1.T1.10.13.10" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m54" class="ltx_Math" alttext="d_{i}E+Er(d_{i}+d_{o})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">E</mi></mrow><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">+</mo><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">o</mi></msub></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}E+Er(d_{i}+d_{o})</annotation></semantics></math></td>
<td id="S1.T1.10.13.11" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.13.11.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#B30000;">✗</span></td></tr>
<tr id="S1.T1.10.14" class="ltx_tr">
<td id="S1.T1.10.14.1" class="ltx_td ltx_align_left" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.1.1" class="ltx_text" style="font-size:70%;">MoSLD <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib31" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite></span></td>
<td id="S1.T1.10.14.2" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.2.1" class="ltx_text" style="font-size:70%;">Top-K</span></td>
<td id="S1.T1.10.14.3" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.3.1" class="ltx_text" style="font-size:70%;">Token</span></td>
<td id="S1.T1.10.14.4" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m55" class="ltx_Math" alttext="d_{i}\times E" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">E</mi></mrow><annotation encoding="application/x-tex">d_{i}\times E</annotation></semantics></math></td>
<td id="S1.T1.10.14.5" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.5.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#B30000;">✗</span></td>
<td id="S1.T1.10.14.6" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.6.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#B30000;">✗</span></td>
<td id="S1.T1.10.14.7" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.7.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;">✓</span></td>
<td id="S1.T1.10.14.8" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.8.1" class="ltx_text" style="font-size:70%;">LoRA</span></td>
<td id="S1.T1.10.14.9" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m56" class="ltx_Math" alttext="r(d_{i}+Ed_{o})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">r</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">o</mi></msub></mrow></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(d_{i}+Ed_{o})</annotation></semantics></math></td>
<td id="S1.T1.10.14.10" class="ltx_td ltx_align_center" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m57" class="ltx_Math" alttext="d_{i}E+r(d_{i}+Ed_{o})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">E</mi></mrow><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">r</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">i</mi></msub><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">o</mi></msub></mrow></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}E+r(d_{i}+Ed_{o})</annotation></semantics></math></td>
<td id="S1.T1.10.14.11" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.14.11.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;">✓</span></td></tr>
<tr id="S1.T1.10.15" class="ltx_tr" style="--ltx-bg-color:#E8F5E0;">
<td id="S1.T1.10.15.1" class="ltx_td ltx_align_left ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E8F5E0;">LiME (Ours)</span></td>
<td id="S1.T1.10.15.2" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E8F5E0;">Auto-<math id="S1.T1.m58" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></span></td>
<td id="S1.T1.10.15.3" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E8F5E0;">N-gram</span></td>
<td id="S1.T1.10.15.4" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m59" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="\mathbf{0}" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">𝟎</mn><annotation encoding="application/x-tex">\mathbf{0}</annotation></semantics></math></td>
<td id="S1.T1.10.15.5" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.5.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;--ltx-bg-color:#E8F5E0;">✓</span></td>
<td id="S1.T1.10.15.6" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.6.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;--ltx-bg-color:#E8F5E0;">✓</span></td>
<td id="S1.T1.10.15.7" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.7.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;--ltx-bg-color:#E8F5E0;">✓</span></td>
<td id="S1.T1.10.15.8" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.8.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E8F5E0;">Vector</span></td>
<td id="S1.T1.10.15.9" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m60" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="\mathbf{Ed_{o}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">𝐄𝐝</mi><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">𝐨</mi></msub><annotation encoding="application/x-tex">\mathbf{Ed_{o}}</annotation></semantics></math></td>
<td id="S1.T1.10.15.10" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><math id="S1.T1.m61" class="ltx_Math" style="--ltx-bg-color:#E8F5E0;" alttext="\mathbf{|\phi|+Ed_{o}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">ϕ</mi><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><mo style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">+</mo><msub><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">𝐄𝐝</mi><mi style="--ltx-bg-color:#E8F5E0;" mathbackground="#E8F5E0" mathsize="0.700em">𝐨</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{|\phi|+Ed_{o}}</annotation></semantics></math></td>
<td id="S1.T1.10.15.11" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bbbb ltx_border_t" style="padding:0.4pt 4.0pt;"><span id="S1.T1.10.15.11.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#00B300;--ltx-bg-color:#E8F5E0;">✓</span></td></tr>
</table>
</figure>
<div id="S1.p7" class="ltx_para">
<p id="S1.p7.1" class="ltx_p"><span id="S1.p7.1.1" class="ltx_text ltx_font_bold">Assumption 2:</span> <span id="S1.p7.1.2" class="ltx_text ltx_font_italic">“A learned router is necessary for routing.”</span> Standard MoE learns a router to compute routing weights, increasing computational and parameter costs. However, recent work demonstrates that internal representations of pretrained models contain rich semantic information, enabling tasks like clustering without external models <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Lee et al., 2025</a>; <a href="#bib.bib63" title="" class="ltx_ref">Aharoni and Goldberg, 2020</a>)</cite>. Similarly, PEFT adaptation learns to encode task-relevant features—inputs requiring similar adaptations naturally cluster together <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Gou et al., 2023</a>)</cite>. <span id="S1.p7.1.3" class="ltx_text ltx_font_italic">Together, the frozen pretrained representations and the PEFT adaptation provide sufficient signal for routing, eliminating the need for additional routing parameters (§<a href="#A5" title="Appendix E Motivation for Dual-Use Routing Features ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>)</span>.</p>
</div>
<div id="S1.p8" class="ltx_para">
<p id="S1.p8.1" class="ltx_p">Building on these insights, we present <span id="S1.p8.1.1" class="ltx_text ltx_font_bold">LiME</span> (illustrated in Figure <a href="#S0.F1" title="Figure 1 ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) to address these limitations through two key components: <span id="S1.p8.1.2" class="ltx_text ltx_font_bold">(i) Lightweight experts</span>, a scaling-based approach that mitigates <span id="S1.p8.1.3" class="ltx_text ltx_font_italic">parameter explosion</span> and <span id="S1.p8.1.4" class="ltx_text ltx_font_italic">architecture dependence</span>. Instead of replicating full adapters for each expert, LiME applies expert-specific scaling vectors to rescale a shared PEFT output element-wise. This design substantially reduces expert-specific parameters and is compatible with any PEFT method, rather than being restricted to LoRA-style adapters.
<span id="S1.p8.1.5" class="ltx_text ltx_font_bold">(ii) Zero-parameter routing</span>, which eliminates <span id="S1.p8.1.6" class="ltx_text ltx_font_italic">router overhead</span>. Instead of a learned router, LiME uses the frozen layer output and the PEFT output to compute expert selection probabilities. We take an <math id="S1.p8.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>-dimensional slice from these representations (with <math id="S1.p8.m2" class="ltx_Math" alttext="E\ll d" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>≪</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">E\ll d</annotation></semantics></math>) and map it to a distribution over the <math id="S1.p8.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> experts, without introducing any additional routing parameters.</p>
</div>
<div id="S1.p9" class="ltx_para">
<p id="S1.p9.1" class="ltx_p">Beyond its core design, LiME incorporates mechanisms that address common MoE training challenges: <span id="S1.p9.1.1" class="ltx_text ltx_font_bold">Auto Top-K</span> adaptively selects experts based on routing confidence, activating fewer experts when confident and more when uncertain—this improves over fixed top-k selection by avoiding both wasted computation on irrelevant experts and loss of useful expert combinations. <span id="S1.p9.1.2" class="ltx_text ltx_font_bold">N-gram windowed routing</span> groups adjacent tokens within a fixed window to share routing decisions, encouraging local coherence in expert assignments based on the observation that neighboring tokens often share semantic context <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib66" title="" class="ltx_ref">Zaheer et al., 2020</a>; <a href="#bib.bib67" title="" class="ltx_ref">Beltagy et al., 2020</a>)</cite>. <span id="S1.p9.1.3" class="ltx_text ltx_font_bold">Load balancing losses</span> encourage uniform expert utilization, preventing the expert collapse problem where routing concentrates on few experts while others remain underutilized <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib71" title="" class="ltx_ref">Shazeer et al., 2017</a>; <a href="#bib.bib72" title="" class="ltx_ref">Fedus et al., 2022</a>)</cite>.</p>
</div>
<div id="S1.p10" class="ltx_para">
<p id="S1.p10.1" class="ltx_p">To evaluate multimodal multi-task performance, we compile <span id="S1.p10.1.1" class="ltx_text ltx_font_bold">MMT-47</span>, a unified suite of 47 existing benchmarks spanning text understanding, commonsense reasoning, video understanding, and image understanding. MMT-47 combines these tasks into a single training mixture with task-specific evaluations (details in Appendix <a href="#A12" title="Appendix L Dataset Details ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">L</span></a>).</p>
</div>
<div id="S1.p11" class="ltx_para">
<p id="S1.p11.1" class="ltx_p"><span id="S1.p11.1.1" class="ltx_text ltx_font_bold">Contributions:</span>
(i) <span id="S1.p11.1.2" class="ltx_text ltx_font_bold">LiME</span>, a framework that achieves expert specialization via element-wise rescaling on top of any PEFT method, with zero routing parameters;
(ii) <span id="S1.p11.1.3" class="ltx_text ltx_font_bold">Practical mechanisms</span> including Auto Top-K for adaptive expert selection, n-gram routing for local semantic coherence, and load balancing to prevent expert collapse;
(iii) <span id="S1.p11.1.4" class="ltx_text ltx_font_bold">Theoretical foundations</span> that motivate LiME, including an information-preservation result for scaling experts and an approximation guarantee showing that modulation can match expert-specific PEFT; and
(iv) <span id="S1.p11.1.5" class="ltx_text ltx_font_bold">Extensive evaluation</span> across 47 tasks, showing competitive or superior performance with up to <math id="S1.p11.m1" class="ltx_math_unparsed" alttext="4\times" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">4\times</annotation></semantics></math> fewer parameters and 29% faster training compared to corresponding MoE-PEFT baselines.</p>
</div>
<div id="S1.p12" class="ltx_para">
<p id="S1.p12.1" class="ltx_p"><span id="S1.p12.1.1" class="ltx_text ltx_font_bold">Related Work.</span> We briefly discuss related work, comparing LiME
with existing MoE-PEFT methods in Table <a href="#S1.T1" title="Table 1 ‣ 1 Introduction ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and provide a detailed
literature review in Appendix <a href="#A9" title="Appendix I Extended Related Work ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a>. Broadly, this work connects to
PEFT methods <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib9" title="" class="ltx_ref">Hu et al., 2022</a>; <a href="#bib.bib13" title="" class="ltx_ref">Liu et al., 2024</a>)</cite> and MoE-based
PEFT <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Shi et al., 2025</a>; <a href="#bib.bib4" title="" class="ltx_ref">Dou et al., 2024</a>; <a href="#bib.bib7" title="" class="ltx_ref">Li et al., 2024b</a>)</cite>. Existing MoE-PEFT approaches
replicate adapters per expert, scaling parameters,
requiring learned routers, and restricting applicability to
adapter-based methods. LiME instead modulates a shared PEFT output
with lightweight expert vectors and zero-parameter routing,
enabling compatibility with any PEFT method.</p>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Preliminaries</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">We consider adapting large pre-trained models to multiple downstream tasks across different modalities. Let <math id="S2.p1.m1" class="ltx_Math" alttext="f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}:\mathcal{X}\rightarrow\mathcal{Y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></mrow><annotation encoding="application/x-tex">f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}:\mathcal{X}\rightarrow\mathcal{Y}</annotation></semantics></math> denote a pre-trained model with frozen parameters <math id="S2.p1.m2" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}</annotation></semantics></math>. Given <math id="S2.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> tasks spanning <math id="S2.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> modalities, our goal is to efficiently adapt <math id="S2.p1.m5" class="ltx_Math" alttext="f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi></msub><annotation encoding="application/x-tex">f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}</annotation></semantics></math> while minimizing trainable parameters.</p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p"><span id="S2.p2.1.1" class="ltx_text ltx_font_bold">Parameter-Efficient Fine-Tuning.</span> Rather than updating all parameters, PEFT methods introduce a small set of trainable parameters <math id="S2.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}</annotation></semantics></math> while keeping <math id="S2.p2.m2" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}</annotation></semantics></math> frozen. The adapted output becomes <math id="S2.p2.m3" class="ltx_Math" alttext="h=f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}(x)+g_{{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}}(x)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mrow><msub><mi>f</mi><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h=f_{{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}}(x)+g_{{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}}(x)</annotation></semantics></math>, where <math id="S2.p2.m4" class="ltx_Math" alttext="g_{{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}}(\cdot)</annotation></semantics></math> is a lightweight module—encompassing methods like LoRA, adapters, and prompt tuning. For a linear layer <math id="S2.p2.m5" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}\in\mathbb{R}^{d_{\text{o}}\times d_{\text{i}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mtext>o</mtext></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mtext>i</mtext></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}\in\mathbb{R}^{d_{\text{o}}\times d_{\text{i}}}</annotation></semantics></math>, this simplifies to <math id="S2.p2.m6" class="ltx_Math" alttext="h={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x+{\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x+{\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)</annotation></semantics></math>, where <math id="S2.p2.m7" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math> is the adaptation term. The key benefit is <math id="S2.p2.m8" class="ltx_Math" alttext="|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|\ll|{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><mo stretchy="false">|</mo></mrow><mo>≪</mo><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝚯</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|\ll|{\color[rgb]{0.1172,0.25,1}\mathbf{\Theta}}|</annotation></semantics></math>. However, standard PEFT applies the same adaptation to all inputs, ignoring the diversity of inputs in multi-task settings.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p"><span id="S2.p3.1.1" class="ltx_text ltx_font_bold">Mixture of Experts.</span> MoE addresses this limitation by routing different inputs to specialized experts. Given <math id="S2.p3.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> experts <math id="S2.p3.m2" class="ltx_Math" alttext="\{\mathcal{E}_{1},\ldots,\mathcal{E}_{E}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>E</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{E}_{1},\ldots,\mathcal{E}_{E}\}</annotation></semantics></math> and routing weights <math id="S2.p3.m3" class="ltx_Math" alttext="w(x)\in\Delta^{E-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>E</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">w(x)\in\Delta^{E-1}</annotation></semantics></math>, the output is
<math id="S2.p3.m4" class="ltx_Math" alttext="y=\sum_{i=1}^{E}w_{i}(x)\cdot\mathcal{E}_{i}(x)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo rspace="0.111em">=</mo><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>E</mi></msubsup><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y=\sum_{i=1}^{E}w_{i}(x)\cdot\mathcal{E}_{i}(x)</annotation></semantics></math>.
However, traditional MoE in PEFT requires separate parameters per expert, leading to linear parameter growth and increased data requirements—each expert sees fewer samples as <math id="S2.p3.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> increases, making training less efficient. This motivates our lightweight expert modulation approach.</p>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p"><span id="S2.p4.1.1" class="ltx_text ltx_font_bold">Notation.</span> We denote frozen parameters by <math id="S2.p4.m1" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}</annotation></semantics></math> and trainable parameters by <math id="S2.p4.m2" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}</annotation></semantics></math>. We use <math id="S2.p4.m3" class="ltx_Math" alttext="\odot" display="inline" intent=":literal"><semantics><mo>⊙</mo><annotation encoding="application/x-tex">\odot</annotation></semantics></math> for element-wise multiplication, <math id="S2.p4.m4" class="ltx_math_unparsed" alttext="\|\cdot\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\|\cdot\|</annotation></semantics></math> for <math id="S2.p4.m5" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math> norm, <math id="S2.p4.m6" class="ltx_math_unparsed" alttext="\|\cdot\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{\infty}</annotation></semantics></math> for the max norm, <math id="S2.p4.m7" class="ltx_Math" alttext="[E]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>E</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[E]</annotation></semantics></math> for the set <math id="S2.p4.m8" class="ltx_Math" alttext="\{1,\ldots,E\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>E</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\ldots,E\}</annotation></semantics></math>, and <math id="S2.p4.m9" class="ltx_math_unparsed" alttext="\Delta^{E-1}=\{w\in\mathbb{R}^{E}:w_{i}\geq 0,\sum_{i}w_{i}=1\}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mi>E</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>E</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>w</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn><mo rspace="0em">,</mo><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>w</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta^{E-1}=\{w\in\mathbb{R}^{E}:w_{i}\geq 0,\sum_{i}w_{i}=1\}</annotation></semantics></math> for the probability simplex.</p>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>LiME</h2>

<div id="S3.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.p1.pic1" class="ltx_picture" height="52.03" overflow="visible" version="1.1" viewBox="0 0 477.38 52.03" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,52.03) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0.42 L 0 51.61 C 0 51.84 0.19 52.03 0.42 52.03 L 476.96 52.03 C 477.19 52.03 477.38 51.84 477.38 51.61 L 477.38 0.42 C 477.38 0.19 477.19 0 476.96 0 L 0.42 0 C 0.19 0 0 0.19 0 0.42 Z"></path></g><g style="--ltx-fill-color:#EDF8E8;" fill="#EDF8E8" fill-opacity="1.0"><path style="stroke:none" d="M 0.42 0.42 L 0.42 51.61 L 476.96 51.61 L 476.96 0.42 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 5.95 39.5)"><foreignObject style="--ltx-fo-width:36.37em;--ltx-fo-height:0.63em;--ltx-fo-depth:2.58em;font-size:10pt;" height="44.28" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="503.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.37em;">
<span id="S3.p1.pic1.1.1" class="ltx_p"><span id="S3.p1.pic1.1.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;--ltx-fg-color:#000000;">Core Idea:<span id="S3.p1.pic1.1.1.1.1" class="ltx_text ltx_font_medium"> Instead of replicating PEFT modules for each expert, use a single shared PEFT module and modulate its output with lightweight expert-specific vectors.<span id="S3.p1.pic1.1.1.1.1.1" class="ltx_text"></span></span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">We present LiME in four parts: <span id="S3.p2.1.1" class="ltx_text ltx_font_italic">(i)</span> expert modulation that achieves specialization through lightweight vectors, <span id="S3.p2.1.2" class="ltx_text ltx_font_italic">(ii)</span> zero-parameter routing derived from existing computations, <span id="S3.p2.1.3" class="ltx_text ltx_font_italic">(iii)</span> practical mechanisms including n-gram windowed routing and adaptive expert selection, and <span id="S3.p2.1.4" class="ltx_text ltx_font_italic">(iv)</span> training considerations including load balancing.</p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p"><span id="S3.p3.1.1" class="ltx_text ltx_font_bold">Lightweight Experts.</span> Let <math id="S3.p3.m1" class="ltx_Math" alttext="z={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">z={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math> be the frozen output and <math id="S3.p3.m2" class="ltx_Math" alttext="\hat{z}={\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo>=</mo><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">\hat{z}={\color[rgb]{0.6133,0.1523,1}\mathbf{\delta}}(x)\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math> be the PEFT output. LiME rescales the PEFT output with expert-specific scaling vectors. Let <math id="S3.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math> for <math id="S3.p3.m4" class="ltx_Math" alttext="i\in[E]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>E</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[E]</annotation></semantics></math> be the <math id="S3.p3.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> expert scaling vectors, and let <math id="S3.p3.m6" class="ltx_Math" alttext="w(x)\in\mathbb{R}^{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>E</mi></msup></mrow><annotation encoding="application/x-tex">w(x)\in\mathbb{R}^{E}</annotation></semantics></math> be routing weights (defined below). The scaled output is:</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="h=z+\hat{z}\odot\mathcal{P}(x)" display="block" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mi>z</mi><mo>+</mo><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h=z+\hat{z}\odot\mathcal{P}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<p id="S3.p3.2" class="ltx_p">where <math id="S3.p3.m7" class="ltx_Math" alttext="\mathcal{P}(x)=\sum_{i=1}^{E}w_{i}(x)\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>E</mi></msubsup><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(x)=\sum_{i=1}^{E}w_{i}(x)\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}</annotation></semantics></math> combines expert scaling vectors weighted by routing scores. Optionally, we include a shared scaling vector <math id="S3.p3.m8" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s}\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>s</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s}\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math> with a learnable scalar <math id="S3.p3.m9" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">γ</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}</annotation></semantics></math>:</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="h=z+\hat{z}\odot\mathcal{P}(x)+{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\cdot(\hat{z}\odot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s})" display="block" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mi>z</mi><mo>+</mo><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h=z+\hat{z}\odot\mathcal{P}(x)+{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\cdot(\hat{z}\odot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">A natural question arises: can this lightweight modulation match full expert-specific PEFT, where each expert has its own adapter? We provide a theoretical guarantee:</p>
</div>
<div id="S3.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.p5.pic1" class="ltx_picture" height="123.08" overflow="visible" version="1.1" viewBox="0 0 477.38 123.08" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,123.08) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0.55 L 0 122.53 C 0 122.83 0.25 123.08 0.55 123.08 L 476.82 123.08 C 477.13 123.08 477.38 122.83 477.38 122.53 L 477.38 0.55 C 477.38 0.25 477.13 0 476.82 0 L 0.55 0 C 0.25 0 0 0.25 0 0.55 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 0.55 L 0.55 105.37 L 476.82 105.37 L 476.82 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.47 111.11)"><foreignObject style="--ltx-fo-width:36.13em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="499.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.13em;">
<span id="S3.p5.pic1.1.1" class="ltx_p"><span id="S3.p5.pic1.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FFFFFF;">Theorem 2: LiME Approximates Expert-Specific PEFT</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.47 8.86)"><foreignObject style="--ltx-fo-width:36.13em;--ltx-fo-height:6.63em;--ltx-fo-depth:0.25em;font-size:10pt;" height="95.13" overflow="visible" transform="matrix(1 0 0 -1 0 91.67)" width="499.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p5.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.13em;">
<span id="S3.p5.pic1.2.1" class="ltx_p"><span id="S3.p5.pic1.2.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Let <math id="S3.p5.pic1.m1" class="ltx_Math" alttext="Z_{\text{MoE}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">MoE</mtext></msub><annotation encoding="application/x-tex">Z_{\text{MoE}}</annotation></semantics></math> be the output of expert-specific PEFT (separate <math id="S3.p5.pic1.m2" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}_{e}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}_{e}</annotation></semantics></math> per expert) and <math id="S3.p5.pic1.m3" class="ltx_Math" alttext="Z_{\text{LiME}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">LiME</mtext></msub><annotation encoding="application/x-tex">Z_{\text{LiME}}</annotation></semantics></math> be LiME output (shared <math id="S3.p5.pic1.m4" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}</annotation></semantics></math> with modulators <math id="S3.p5.pic1.m5" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{e}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi></msub><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{e}</annotation></semantics></math>). If the approximation error is bounded by <math id="S3.p5.pic1.m6" class="ltx_Math" alttext="\bar{\varepsilon}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="1.110em">¯</mo></mover><annotation encoding="application/x-tex">\bar{\varepsilon}</annotation></semantics></math>, then:</span></span>
<span id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\bigl|\mathcal{R}^{*}(Z_{\text{LiME}})-\mathcal{R}^{*}(Z_{\text{MoE}})\bigr|\leq\mathcal{O}(\bar{\varepsilon})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000" mathsize="0.900em">ℛ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">Z</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">LiME</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">−</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000" mathsize="0.900em">ℛ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">Z</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">MoE</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000" mathsize="0.900em">𝒪</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">ε</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\bigl|\mathcal{R}^{*}(Z_{\text{LiME}})-\mathcal{R}^{*}(Z_{\text{MoE}})\bigr|\leq\mathcal{O}(\bar{\varepsilon}),</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="S3.p5.pic1.2.2" class="ltx_p"><span id="S3.p5.pic1.2.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">where <math id="S3.p5.pic1.m7" class="ltx_Math" alttext="\mathcal{R}^{*}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℛ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><annotation encoding="application/x-tex">\mathcal{R}^{*}</annotation></semantics></math> is the optimal risk (proof in Appendix <a href="#A2" title="Appendix B Proof of Theorem ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>).</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p">This means LiME can closely approximate full expert-specific PEFT while using fewer parameters: <math id="S3.p6.m1" class="ltx_Math" alttext="|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|+Ed_{o}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>o</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|+Ed_{o}</annotation></semantics></math> instead of <math id="S3.p6.m2" class="ltx_Math" alttext="E\times|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">|</mo><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">ϕ</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">E\times|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}|</annotation></semantics></math>. Since pretrained representations are highly redundant, full expert-specific adapters are often over-parameterized <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib69" title="" class="ltx_ref">Tian et al., 2025</a>)</cite>: much of the adaptation can be expressed by selectively scaling a small subset of useful feature dimensions. Supporting this view, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib68" title="" class="ltx_ref">Luo et al. (2023)</a></cite> show that using only <math id="S3.p6.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>1% of the most important feature dimensions can recover the performance achieved by the full representation. Theorem <a href="#S1" title="1 Introduction ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> motivates this efficient design: by keeping parameter costs low, LiME can scale to more experts without significant parameter growth.</p>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text ltx_font_bold">Zero-Parameter Routing.</span> Standard MoE layers learn a router <math id="S3.p7.m1" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{W}}_{r}\in\mathbb{R}^{d\times E}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐖</mi><mi>r</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>E</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{W}}_{r}\in\mathbb{R}^{d\times E}</annotation></semantics></math> to produce routing weights, adding <math id="S3.p7.m2" class="ltx_Math" alttext="d\times E" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">d\times E</annotation></semantics></math> parameters per layer. LiME removes this cost by computing routing weights directly from representations that are already available in the forward pass.</p>
</div>
<div id="S3.p8" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.p8.pic1" class="ltx_picture" height="101.84" overflow="visible" version="1.1" viewBox="0 0 477.38 101.84" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,101.84) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0.42 L 0 101.43 C 0 101.65 0.19 101.84 0.42 101.84 L 476.96 101.84 C 477.19 101.84 477.38 101.65 477.38 101.43 L 477.38 0.42 C 477.38 0.19 477.19 0 476.96 0 L 0.42 0 C 0.19 0 0 0.19 0 0.42 Z"></path></g><g style="--ltx-fill-color:#EDF8E8;" fill="#EDF8E8" fill-opacity="1.0"><path style="stroke:none" d="M 0.42 0.42 L 0.42 101.43 L 476.96 101.43 L 476.96 0.42 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 5.95 89.32)"><foreignObject style="--ltx-fo-width:36.37em;--ltx-fo-height:0.63em;--ltx-fo-depth:6.18em;font-size:10pt;" height="94.09" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="503.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p8.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.37em;">
<span id="S3.p8.pic1.1.1" class="ltx_p"><span id="S3.p8.pic1.1.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;--ltx-fg-color:#000000;">Key Insight:<span id="S3.p8.pic1.1.1.1.1" class="ltx_text ltx_font_medium"> We reuse existing representations as <em id="S3.p8.pic1.1.1.1.1.1" class="ltx_emph ltx_font_upright">routing features</em>. The frozen output <math id="S3.p8.pic1.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> provides general semantic information, while the PEFT output <math id="S3.p8.pic1.m2" class="ltx_Math" alttext="\hat{z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="1.110em">^</mo></mover><annotation encoding="application/x-tex">\hat{z}</annotation></semantics></math> captures task- and input-dependent corrections. Combining them yields effective routing with </span>zero<span id="S3.p8.pic1.1.1.1.2" class="ltx_text ltx_font_medium"> learned router parameters.<span id="S3.p8.pic1.1.1.1.2.1" class="ltx_text"></span></span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p">This design is motivated by two observations. <span id="S3.p9.1.1" class="ltx_text ltx_font_italic">(i) Forward-pass representations are informative.</span> The frozen layer output <math id="S3.p9.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> captures general semantic information, while the PEFT output <math id="S3.p9.m2" class="ltx_Math" alttext="\hat{z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>z</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{z}</annotation></semantics></math> captures task-specific changes induced by fine-tuning. Inputs that require similar expert processing tend to produce similar patterns in these representations (§<a href="#A6.SS12" title="F.12 Routing Representation Analysis (Figure ). ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.12</span></a>), making them useful signals for expert selection. <span id="S3.p9.1.2" class="ltx_text ltx_font_italic">(ii) A low-dimensional slice is sufficient.</span> Since <math id="S3.p9.m3" class="ltx_Math" alttext="E\ll d" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>≪</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">E\ll d</annotation></semantics></math>, routing only needs a small number of degrees of freedom to choose among <math id="S3.p9.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> experts, and a small slice of these already-computed representations provides enough signal in practice (Appendix <a href="#A5" title="Appendix E Motivation for Dual-Use Routing Features ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>, §<a href="#S4.SS1" title="4.1 Ablation ‣ 4 Experiments ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>).</p>
</div>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p">Formally, we compute routing scores from <math id="S3.p10.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> dimensions of both representations; the specific dimensions are not critical, and we use the first <math id="S3.p10.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> for simplicity (Figure <a href="#S4.F4" title="Figure 4 ‣ 4.1 Ablation ‣ 4 Experiments ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>a):</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_math_unparsed" alttext="w(x)=\mathrm{softmax}\left(\frac{(1-\gamma_{r})\cdot\tilde{z}_{1:E}+\gamma_{r}\cdot\tilde{\hat{z}}_{1:E}}{\tau}\right)." display="block" intent=":literal"><semantics><mrow><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>softmax</mi><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>γ</mi><msub><mrow></mrow><mi>r</mi></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mover accent="true"><mi>z</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo>+</mo><mi>γ</mi><msub><mrow></mrow><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo>~</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub></mrow><mi>τ</mi></mfrac><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w(x)=\mathrm{softmax}\left(\frac{(1-\gamma_{r})\cdot\tilde{z}_{1:E}+\gamma_{r}\cdot\tilde{\hat{z}}_{1:E}}{\tau}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.p10.2" class="ltx_p">Here <math id="S3.p10.m3" class="ltx_math_unparsed" alttext="\tilde{z}_{1:E}=z_{1:E}/\|z_{1:E}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo>=</mo><mi>z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo rspace="0em">/</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{z}_{1:E}=z_{1:E}/\|z_{1:E}\|_{\infty}</annotation></semantics></math> and <math id="S3.p10.m4" class="ltx_math_unparsed" alttext="\tilde{\hat{z}}_{1:E}=\hat{z}_{1:E}/\|\hat{z}_{1:E}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo>~</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo rspace="0em">/</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>E</mi></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\hat{z}}_{1:E}=\hat{z}_{1:E}/\|\hat{z}_{1:E}\|_{\infty}</annotation></semantics></math> are normalized slices, <math id="S3.p10.m5" class="ltx_Math" alttext="\gamma_{r}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>r</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{r}\in[0,1]</annotation></semantics></math> balances frozen and PEFT-modified signals (§<a href="#S4.SS1" title="4.1 Ablation ‣ 4 Experiments ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), and <math id="S3.p10.m6" class="ltx_Math" alttext="\tau&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau&gt;0</annotation></semantics></math> is the temperature (§<a href="#A6.SS7" title="F.7 Routing Temperature 𝜏 (Figure c). ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.7</span></a>). The normalization stabilizes routing across layers and inputs.</p>
</div>
<div id="S3.p11" class="ltx_para">
<p id="S3.p11.1" class="ltx_p"><span id="S3.p11.1.1" class="ltx_text ltx_font_bold">N-gram Windowed Routing.</span> LiME supports different routing granularities. In token-level routing, each token chooses experts independently, resulting in <math id="S3.p11.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> routing decisions for a length-<math id="S3.p11.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> sequence. In sequence-level routing, a single pooled representation is used to make one routing decision for the entire sequence, but this can miss within-sequence variation. We adopt n-gram windowed routing as a middle ground: we partition the sequence into windows of size <math id="S3.p11.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, and all tokens in a window share one routing decision (i.e., <math id="S3.p11.m4" class="ltx_Math" alttext="T/n" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">T/n</annotation></semantics></math> decisions per sequence). This reduces sensitivity to token-level noise and encourages locally consistent expert assignments, since neighboring tokens often form coherent semantic units (§<a href="#A6.SS2" title="F.2 N-gram Window Size (Figure a-b) ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.2</span></a>).</p>
</div>
<div id="S3.p12" class="ltx_para">
<p id="S3.p12.1" class="ltx_p">For causal models, we use the last token of each window as the routing representative. This choice is theoretically motivated:</p>
</div>
<div id="S3.p13" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.p13.pic1" class="ltx_picture" height="138.02" overflow="visible" version="1.1" viewBox="0 0 477.38 138.02" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,138.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0.55 L 0 137.47 C 0 137.78 0.25 138.02 0.55 138.02 L 476.82 138.02 C 477.13 138.02 477.38 137.78 477.38 137.47 L 477.38 0.55 C 477.38 0.25 477.13 0 476.82 0 L 0.55 0 C 0.25 0 0 0.25 0 0.55 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 0.55 L 0.55 120.31 L 476.82 120.31 L 476.82 0.55 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.47 126.06)"><foreignObject style="--ltx-fo-width:36.13em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="499.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p13.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.13em;">
<span id="S3.p13.pic1.1.1" class="ltx_p"><span id="S3.p13.pic1.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FFFFFF;">Theorem 3: Informativeness in Causal N-gram Windows</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.47 8.86)"><foreignObject style="--ltx-fo-width:36.13em;--ltx-fo-height:7.71em;--ltx-fo-depth:0.25em;font-size:10pt;" height="110.07" overflow="visible" transform="matrix(1 0 0 -1 0 106.62)" width="499.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.p13.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.13em;">
<span id="S3.p13.pic1.2.1" class="ltx_p"><span id="S3.p13.pic1.2.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Let <math id="S3.p13.pic1.m1" class="ltx_Math" alttext="h_{1},\ldots,h_{n}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">h_{1},\ldots,h_{n}\in\mathbb{R}^{d}</annotation></semantics></math> be hidden states within an n-gram window under causal attention, and let <math id="S3.p13.pic1.m2" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> denote the task objective. Then the routing informativeness is maximized at the window’s final position:</span></span>
<span id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="I(Y;h_{n})\geq I(Y;h_{n-1})\geq\cdots\geq I(Y;h_{1})" display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">I</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">≥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">I</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">h</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em" rspace="0.1389em">≥</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000" mathsize="0.900em" rspace="0.1389em">⋯</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000" mathsize="0.900em">≥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">I</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">h</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.900em">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I(Y;h_{n})\geq I(Y;h_{n-1})\geq\cdots\geq I(Y;h_{1})</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="S3.p13.pic1.2.2" class="ltx_p"><span id="S3.p13.pic1.2.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">(Full proof in Appendix <a href="#A3" title="Appendix C Proof of Theorem ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>).</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S3.p14" class="ltx_para">
<p id="S3.p14.1" class="ltx_p">Since later positions aggregate more context via causal attention, the last token of each n-gram window captures the most task-relevant information, making it the optimal choice for routing decisions <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib38" title="" class="ltx_ref">Kowsher et al., 2025c</a>)</cite>.</p>
</div>
<div id="S3.p15" class="ltx_para">
<p id="S3.p15.1" class="ltx_p"><span id="S3.p15.1.1" class="ltx_text ltx_font_bold">Auto Top-K.</span> After computing routing weights <math id="S3.p15.m1" class="ltx_Math" alttext="w(x)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(x)</annotation></semantics></math>, we select which experts to activate. The standard approach—fixed top-<math id="S3.p15.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>—always selects exactly <math id="S3.p15.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> experts regardless of the score distribution (§<a href="#A6.SS3" title="F.3 Fixed Top-K Selection (Figure c) ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.3</span></a>). This can be inefficient: when one expert clearly dominates (e.g., 0.52 vs 0.12), selecting additional experts wastes computation; when multiple experts have similar scores (e.g., 0.35 vs 0.34 vs 0.33), restricting to <math id="S3.p15.m4" class="ltx_Math" alttext="k=2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=2</annotation></semantics></math> can discard useful expert combinations. We therefore use an adaptive policy that activates fewer experts when routing is confident and more when it is uncertain. This is consistent with Theorem <a href="#S1" title="1 Introduction ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, which suggests that retaining more experts is beneficial when multiple experts carry comparable task-relevant information. Auto Top-K uses a relative threshold:</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="\mathcal{S}_{\theta}(x)=\left\{i:w_{i}(x)\geq\theta\cdot\max_{j}w_{j}(x)\right\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mi>θ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>w</mi><mi>j</mi></msub></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\theta}(x)=\left\{i:w_{i}(x)\geq\theta\cdot\max_{j}w_{j}(x)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.p15.2" class="ltx_p">where <math id="S3.p15.m5" class="ltx_Math" alttext="\theta\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\theta\in(0,1]</annotation></semantics></math> controls selection aggressiveness. For example, with <math id="S3.p15.m6" class="ltx_Math" alttext="\theta=0.5" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\theta=0.5</annotation></semantics></math>, we keep all experts scoring at least half as high as the best. Selected experts are renormalized as <math id="S3.p15.m7" class="ltx_Math" alttext="\tilde{w}_{i}(x)=w_{i}(x)/\sum_{j\in\mathcal{S}_{\theta}(x)}w_{j}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">/</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{w}_{i}(x)=w_{i}(x)/\sum_{j\in\mathcal{S}_{\theta}(x)}w_{j}(x)</annotation></semantics></math>. See Appendix <a href="#A4" title="Appendix D Expert Selection Strategies ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a> for comparisons with other strategies.</p>
</div>
<div id="S3.p16" class="ltx_para">
<p id="S3.p16.1" class="ltx_p"><span id="S3.p16.1.1" class="ltx_text ltx_font_bold">Layer Formulation.</span> LiME applies to any layer equipped with PEFT (§<a href="#A8" title="Appendix H Algorithm Details ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span></a>). For a frozen linear layer <math id="S3.p16.m1" class="ltx_Math" alttext="{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}</annotation></semantics></math>, the forward pass is:
<span id="S3.p16.1.2" class="ltx_text ltx_font_italic">(1)</span> compute the base output <math id="S3.p16.m2" class="ltx_Math" alttext="z={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#1E40FF;" mathcolor="#1E40FF">𝐖</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">z={\color[rgb]{0.1172,0.25,1}\mathbf{W}}_{0}x</annotation></semantics></math>;
<span id="S3.p16.1.3" class="ltx_text ltx_font_italic">(2)</span> compute the PEFT update <math id="S3.p16.m3" class="ltx_Math" alttext="\hat{z}\in\mathbb{R}^{d_{\text{o}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mtext>o</mtext></msub></msup></mrow><annotation encoding="application/x-tex">\hat{z}\in\mathbb{R}^{d_{\text{o}}}</annotation></semantics></math>;
<span id="S3.p16.1.4" class="ltx_text ltx_font_italic">(3)</span> compute routing weights <math id="S3.p16.m4" class="ltx_Math" alttext="w(x)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(x)</annotation></semantics></math> from <math id="S3.p16.m5" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> and <math id="S3.p16.m6" class="ltx_Math" alttext="\hat{z}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>z</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{z}</annotation></semantics></math>, then select experts <math id="S3.p16.m7" class="ltx_Math" alttext="\mathcal{S}_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\theta}(x)</annotation></semantics></math> and renormalize weights to <math id="S3.p16.m8" class="ltx_Math" alttext="\tilde{w}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>w</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{w}(x)</annotation></semantics></math>;
<span id="S3.p16.1.5" class="ltx_text ltx_font_italic">(4)</span> form the expert modulator
<math id="S3.p16.m9" class="ltx_Math" alttext="\mathcal{P}(x)=\sum_{i\in\mathcal{S}_{\theta}(x)}\tilde{w}_{i}(x)\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(x)=\sum_{i\in\mathcal{S}_{\theta}(x)}\tilde{w}_{i}(x)\cdot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}</annotation></semantics></math>;
and <span id="S3.p16.1.6" class="ltx_text ltx_font_italic">(5)</span> produce the final output: <math id="S3.p16.m10" class="ltx_Math" alttext="h=z+\hat{z}\odot\mathcal{P}(x)+{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\cdot(\hat{z}\odot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>=</mo><mrow><mi>z</mi><mo>+</mo><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h=z+\hat{z}\odot\mathcal{P}(x)+{\color[rgb]{0.6133,0.1523,1}\mathbf{\gamma}}\cdot(\hat{z}\odot{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{s}).</annotation></semantics></math>
Routing granularity (token or window) is chosen based on the task (§<a href="#A6.SS2" title="F.2 N-gram Window Size (Figure a-b) ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.2</span></a>).</p>
</div>
<div id="S3.p17" class="ltx_para">
<p id="S3.p17.1" class="ltx_p"><span id="S3.p17.1.1" class="ltx_text ltx_font_bold">Initialization.</span> Expert modulators are initialized near unity: <math id="S3.p17.m1" class="ltx_Math" alttext="{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\sim\mathcal{U}(1-\sigma,1+\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF">𝐩</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.6133,0.1523,1}\mathbf{p}}_{i}\sim\mathcal{U}(1-\sigma,1+\sigma)</annotation></semantics></math> with <math id="S3.p17.m2" class="ltx_Math" alttext="\sigma=0.1" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\sigma=0.1</annotation></semantics></math>, so LiME starts close to standard PEFT and specialization emerges during training, following <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib33" title="" class="ltx_ref">Kowsher et al. (2025d)</a></cite> (§<a href="#A6.SS9" title="F.9 Expert Modulator Initialization (Figure a) ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.9</span></a>).</p>
</div>
<div id="S3.p18" class="ltx_para">
<p id="S3.p18.1" class="ltx_p"><span id="S3.p18.1.1" class="ltx_text ltx_font_bold">Parameter Count.</span> For a model with <math id="S3.p18.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> LiME layers and <math id="S3.p18.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> experts, let <math id="S3.p18.m3" class="ltx_Math" alttext="|\phi|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\phi|</annotation></semantics></math> denote the PEFT parameters per layer. The total number of trainable parameters is:</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\small|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}_{\text{LiME}}|=L\cdot\Big(\underbrace{|\phi|}_{\text{shared PEFT}}+\underbrace{E\cdot d_{\text{o}}}_{\text{expert modulators}}+\underbrace{d_{\text{o}}+1}_{\text{shared modulator }+\gamma}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><msub><mi style="--ltx-fg-color:#9C27FF;" mathcolor="#9C27FF" mathsize="0.900em">ϕ</mi><mtext mathsize="0.900em">LiME</mtext></msub><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">L</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><munder accentunder="true"><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mi mathsize="0.900em">ϕ</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext mathsize="0.900em">shared PEFT</mtext></munder><mo mathsize="0.900em">+</mo><munder><munder accentunder="true"><mrow><mi mathsize="0.900em">E</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msub><mi mathsize="0.900em">d</mi><mtext mathsize="0.900em">o</mtext></msub></mrow><mo stretchy="true">⏟</mo></munder><mtext mathsize="0.900em">expert modulators</mtext></munder><mo mathsize="0.900em">+</mo><munder><munder accentunder="true"><mrow><msub><mi mathsize="0.900em">d</mi><mtext mathsize="0.900em">o</mtext></msub><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo stretchy="true">⏟</mo></munder><mrow><mtext mathsize="0.900em">shared modulator </mtext><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">γ</mi></mrow></munder></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\small|{\color[rgb]{0.6133,0.1523,1}\mathbf{\phi}}_{\text{LiME}}|=L\cdot\Big(\underbrace{|\phi|}_{\text{shared PEFT}}+\underbrace{E\cdot d_{\text{o}}}_{\text{expert modulators}}+\underbrace{d_{\text{o}}+1}_{\text{shared modulator }+\gamma}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p18.2" class="ltx_p">In contrast, traditional MoE-PEFT requires <math id="S3.p18.m4" class="ltx_Math" alttext="L\cdot E\cdot|\phi|" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi>ϕ</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">L\cdot E\cdot|\phi|</annotation></semantics></math> parameters, which scales linearly with the number of experts. LiME adds only <math id="S3.p18.m5" class="ltx_Math" alttext="E\cdot d_{\text{o}}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>d</mi><mtext>o</mtext></msub></mrow><annotation encoding="application/x-tex">E\cdot d_{\text{o}}</annotation></semantics></math> parameters per layer for expert modulators, independent of the PEFT method.</p>
</div>
<div id="S3.p19" class="ltx_para">
<p id="S3.p19.1" class="ltx_p"><span id="S3.p19.1.1" class="ltx_text ltx_font_bold">Load Balancing.</span> MoE models can suffer from <em id="S3.p19.1.2" class="ltx_emph ltx_font_italic">expert collapse</em>, where routing concentrates on a few experts while others are underutilized. We add auxiliary losses to encourage balanced utilization. Let
<math id="S3.p19.m1" class="ltx_Math" alttext="\bar{p}_{i}=\frac{1}{BT}\sum_{b,t}w_{i}(x_{b,t})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>b</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>b</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{p}_{i}=\frac{1}{BT}\sum_{b,t}w_{i}(x_{b,t})</annotation></semantics></math>
be the mean routing probability of expert <math id="S3.p19.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> over a batch of <math id="S3.p19.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> sequences with <math id="S3.p19.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> tokens (so <math id="S3.p19.m5" class="ltx_Math" alttext="\sum_{i}\bar{p}_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mover accent="true"><mi>p</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}\bar{p}_{i}=1</annotation></semantics></math>). We use two complementary losses: <span id="S3.p19.1.3" class="ltx_text ltx_font_italic">(i) Importance Loss</span>
<math id="S3.p19.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{imp}}=E\sum_{i=1}^{E}\bar{p}_{i}^{2}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>imp</mtext></msub><mo>=</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>E</mi></msubsup><msubsup><mover accent="true"><mi>p</mi><mo>¯</mo></mover><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{imp}}=E\sum_{i=1}^{E}\bar{p}_{i}^{2}-1</annotation></semantics></math>,
and <span id="S3.p19.1.4" class="ltx_text ltx_font_italic">(ii) KL-Uniform Loss</span>
<math id="S3.p19.m7" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{KL}}=D_{\text{KL}}(\bar{p}\,\|\,\mathcal{U})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>KL</mtext></msub><mo>=</mo><msub><mi>D</mi><mtext>KL</mtext></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>p</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0.337em">∥</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{KL}}=D_{\text{KL}}(\bar{p}\,\|\,\mathcal{U})</annotation></semantics></math>,
where <math id="S3.p19.m8" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> is uniform. The total objective is:</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="\mathcal{L}=\mathcal{L}_{\text{task}}+\alpha\,\mathcal{L}_{\text{imp}}+\beta\,\mathcal{L}_{\text{KL}}," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>task</mtext></msub><mo>+</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>imp</mtext></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>KL</mtext></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}=\mathcal{L}_{\text{task}}+\alpha\,\mathcal{L}_{\text{imp}}+\beta\,\mathcal{L}_{\text{KL}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.p19.2" class="ltx_p">where <math id="S3.p19.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="S3.p19.m10" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> control the balancing strength (§<a href="#S4.SS1.SSS0.Px1" title="Load Balancing Coefficient (Figure b-c). ‣ 4.1 Ablation ‣ 4 Experiments ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, §<a href="#A6.SS8" title="F.8 Expert Utilization vs Balance Coefficient (Figure ). ‣ Appendix F More Ablation Study ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.8</span></a>).</p>
</div>
<figure id="S3.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S3.T2.5" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S3.T2.6" class="ltx_text" style="font-size:90%;">Average results across benchmark categories. Highlighted rows show our LiME variants. <span id="S3.T2.6.1" class="ltx_text ltx_font_bold">Bold</span>: best; <span id="S3.T2.6.2" class="ltx_text ltx_underline">underline</span>: second best. #TTP: total trainable parameters. Detailed per-task results in Tables <a href="#A7.T6" title="Table 6 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, <a href="#A7.T7" title="Table 7 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, <a href="#A7.T8" title="Table 8 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, <a href="#A7.T9" title="Table 9 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, <a href="#A7.T10" title="Table 10 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, <a href="#A7.T11" title="Table 11 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, <a href="#A7.T12" title="Table 12 ‣ Appendix G Detailed Results Analysis ‣ Lightweight Mixture of Experts for Efficient Multimodal Multi-task Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>.</span></figcaption>
<div id="S3.T2.7" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:310.5pt;height:105.9pt;vertical-align:-51.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-181.7pt,62.0pt) scale(0.460733471981222,0.460733471981222) ;">
<table id="S3.T2.7.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T2.7.1.1" class="ltx_tr">
<td id="S3.T2.7.1.1.1" class="ltx_td ltx_align_left ltx_border_tttt" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S3.T2.7.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></td>
<td id="S3.T2.7.1.1.2" class="ltx_td ltx_align_center ltx_border_tttt" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S3.T2.7.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">#TTP</span></td>
