<td id="A9.T20.5.5.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="A9.T20.5.5.3.1" class="ltx_inline-block ltx_align_top" style="width:199.2pt;">
<span id="A9.T20.5.5.3.1.1" class="ltx_p"><span id="A9.T20.5.5.3.1.1.1" class="ltx_text" style="font-size:70%;">Qwen2-7B</span></span>
</span></td></tr>
<tr id="A9.T20.5.6" class="ltx_tr">
<td id="A9.T20.5.6.1" class="ltx_td" style="padding-left:4.0pt;padding-right:4.0pt;"></td>
<td id="A9.T20.5.6.2" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A9.T20.5.6.2.1" class="ltx_text" style="font-size:70%;">Target modules</span></td>
