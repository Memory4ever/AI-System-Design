 <math id="A7.SS9.pic1.m17" class="ltx_math_unparsed" alttext="\tilde{z}_{1:E}\leftarrow z_{[:,:,1:E]}\,/\,\|z_{[:,:,1:E]}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><msub><mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><msub><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.085em">/</mo><mo style="--ltx-fg-color:#000000;" lspace="0.085em" mathcolor="#000000" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><msub><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">:</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∥</mo><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{z}_{1:E}\leftarrow z_{[:,:,1:E]}\,/\,\|z_{[:,:,1:E]}\|_{\infty}</annotation></semantics></math>  <span id="A7.SS9.pic1.3.3.2.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;">// normalize first <math id="A7.SS9.pic1.m18" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> dims</span> 
