<td id="A4.T4.5.7.2" class="ltx_td ltx_align_center"><math id="A4.T4.m16" class="ltx_Math" alttext="w_{i}(x)\geq w_{[k]}(x)-\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">w</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">≥</mo><mrow><mrow><msub><mi mathsize="0.900em">w</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em" mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">w_{i}(x)\geq w_{[k]}(x)-\Delta</annotation></semantics></math></td>
<td id="A4.T4.5.7.3" class="ltx_td ltx_align_center"><math id="A4.T4.m17" class="ltx_Math" alttext="k,\Delta" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">k,\Delta</annotation></semantics></math></td>
