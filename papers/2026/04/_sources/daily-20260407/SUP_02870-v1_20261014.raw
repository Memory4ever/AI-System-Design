<span id="S3.F8.3.4.1.1.1.1" class="ltx_p ltx_align_center"><span id="S3.F8.3.4.1.1.1.1.1" class="ltx_text" style="font-size:70%;">Response: “</span><span id="S3.F8.3.4.1.1.1.1.2" class="ltx_text ltx_font_italic" style="font-size:70%;">left</span><span id="S3.F8.3.4.1.1.1.1.3" class="ltx_text" style="font-size:70%;">”</span></span>
