<th id="A1.T3.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="--ltx-bg-color:#EBEBFF;"><span id="A1.T3.3.2.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">Qwen2.5-VL <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">6</a>]</cite></span></th>
