<figure id="A8.F11.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2604.02751v1/images/EDM_conv/GPE_FIR.png" id="A8.F11.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/289;" width="476" height="289" alt="Refer to caption">
