<td id="A1.T12.2.1.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" rowspan="2"><span id="A1.T12.2.1.1.2.1" class="ltx_text">Method</span></td>
<td id="A1.T12.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="5">OCRBench <math id="A1.T12.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A1.T12.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="5">HRBench-4K <math id="A1.T12.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A1.T12.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A1.T12.2.1.1.5.1" class="ltx_text">Avg. <math id="A1.T12.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="A1.T12.2.1.2" class="ltx_tr">
<td id="A1.T12.2.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T12.m4" class="ltx_Math" alttext="\rho_{1}:90\%" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mn>90</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{1}:90\%</annotation></semantics></math></td>
