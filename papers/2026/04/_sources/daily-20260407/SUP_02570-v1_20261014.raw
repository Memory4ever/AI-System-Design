<tr id="A1.T14.fig1.1.1.6" class="ltx_tr">
<td id="A1.T14.fig1.1.1.6.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">50%</td>
<td id="A1.T14.fig1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">28.37</td>
<td id="A1.T14.fig1.1.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">1.66</td>
<td id="A1.T14.fig1.1.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="A1.T14.m6" class="ltx_math_unparsed" alttext="17.1\times" display="inline" intent=":literal"><semantics><mrow><mn>17.1</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">17.1\times</annotation></semantics></math></td></tr>
</table>
</span></div>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A1.T14.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:190.8pt;">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Table 14: </span>Decoding latency on RTX 5090.</figcaption>
<div id="A1.T14.fig2.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:190.8pt;height:62.3pt;vertical-align:-29.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-16.7pt,5.5pt) scale(0.850689600486261,0.850689600486261) ;">
<table id="A1.T14.fig2.1.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T14.fig2.1.1.1" class="ltx_tr">
<td id="A1.T14.fig2.1.1.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><math id="A1.T14.m7" class="ltx_Math" alttext="\rho_{2}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\rho_{2}</annotation></semantics></math></td>
<td id="A1.T14.fig2.1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">W/o per-head</td>
<td id="A1.T14.fig2.1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">WSVD-noQ</td>
<td id="A1.T14.fig2.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">Speedup</td></tr>
<tr id="A1.T14.fig2.1.1.2" class="ltx_tr">
<td id="A1.T14.fig2.1.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">90%</td>
<td id="A1.T14.fig2.1.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">40.40</td>
<td id="A1.T14.fig2.1.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.87</td>
<td id="A1.T14.fig2.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T14.m8" class="ltx_math_unparsed" alttext="21.6\times" display="inline" intent=":literal"><semantics><mrow><mn>21.6</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">21.6\times</annotation></semantics></math></td></tr>
<tr id="A1.T14.fig2.1.1.3" class="ltx_tr">
