<td id="S4.T8.1.1.4.4" class="ltx_td ltx_align_center ltx_border_bb">2.2<math id="S4.SS4.SSS0.Px2.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S4.T8.1.1.4.5" class="ltx_td ltx_align_center ltx_border_bb">2.4<math id="S4.SS4.SSS0.Px2.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
