<td id="S6.T1.2.8.4" class="ltx_td ltx_align_center">49.36</td>
<td id="S6.T1.2.8.5" class="ltx_td ltx_align_center">30.00</td>
<td id="S6.T1.2.8.6" class="ltx_td ltx_align_center">43.00</td>
<td id="S6.T1.2.8.7" class="ltx_td ltx_align_center">34.67</td></tr>
<tr id="S6.T1.2.9" class="ltx_tr">
<th id="S6.T1.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">T2I-R1<sup id="S6.T1.2.9.1.1" class="ltx_sup">∗</sup> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib12" title="" class="ltx_ref">Jiang et al., 2025</a>)</cite></th>
<td id="S6.T1.2.9.2" class="ltx_td ltx_align_center">82.58</td>
