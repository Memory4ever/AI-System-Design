<td id="S6.T1.2.7.7" class="ltx_td ltx_align_center">35.33</td></tr>
<tr id="S6.T1.2.8" class="ltx_tr">
<th id="S6.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Janus-Pro-7B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib3" title="" class="ltx_ref">Chen et al., 2025</a>)</cite></th>
<td id="S6.T1.2.8.2" class="ltx_td ltx_align_center">63.59</td>
