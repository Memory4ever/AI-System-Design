{"data":{"id":"10.48550/arxiv.2604.02751","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.02751","prefix":"10.48550","suffix":"arxiv.2604.02751","identifiers":[{"identifier":"2604.02751","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.02751"}],"creators":[{"name":"Gu, Jing","nameType":"Personal","givenName":"Jing","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Mardani, Morteza","nameType":"Personal","givenName":"Morteza","familyName":"Mardani","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Wonjun","nameType":"Personal","givenName":"Wonjun","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Zou, Dongmian","nameType":"Personal","givenName":"Dongmian","familyName":"Zou","affiliation":[],"nameIdentifiers":[]},{"name":"Lerman, Gilad","nameType":"Personal","givenName":"Gilad","familyName":"Lerman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Latent Diffusability via Fisher Geometry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-03T05:52:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-06T00:24:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-12T19:45:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:08:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-01T05:01:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-02T00:44:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Diffusion models often degrade in latent spaces, yet the formal causes remain poorly understood. We quantify latent-space diffusability via the rate of change of the Minimum Mean Squared Error (MMSE) along the diffusion trajectory. Our framework decomposes this MMSE rate into contributions from Fisher Information (FI) and Fisher Information Rate (FIR). We show that isometric embeddings preserve intrinsic FI and establish quantitative intrinsic-FI bounds for a broader class of bi-Lipschitz encoders with controlled weak volume distortion, whereas FIR is governed by the interplay between encoder and data geometries. Our analysis separates four geometric contributions in local stability bounds for Gaussian-smoothed FIR: dimensional compression, tangential distortion, high-frequency encoder curvature, and curvature of data manifold. Experiments across diverse autoencoding architectures provide qualitative support for the geometric mechanisms identified by the theory and show that empirical FI and FIR track several measures of generation quality and latent-space geometry in the settings tested. We establish FI and FIR as a comprehensive analytical framework for understanding latent diffusability.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.02751","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-06T01:33:40.000Z","registered":"2026-04-06T01:33:40.000Z","published":"2026","updated":"2026-10-02T03:31:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.02751","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}