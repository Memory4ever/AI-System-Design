<th id="S3.T3.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T3.2.1.6.1" class="ltx_text" style="font-size:80%;">Neutral Ban</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T3.2.2" class="ltx_tr">
<th id="S3.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T3.2.2.1.1" class="ltx_text" style="font-size:80%;">Haiku 4.5</span></th>
