<td id="S5.T10.6.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T10.6.4.2.1" class="ltx_text" style="font-size:80%;">0.85</span></td>
<td id="S5.T10.6.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T10.6.4.3.1" class="ltx_text" style="font-size:80%;">75.81</span></td>
<td id="S5.T10.6.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T10.6.4.4.1" class="ltx_text" style="font-size:80%;">76.08</span></td>
<td id="S5.T10.6.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T10.6.4.5.1" class="ltx_text" style="font-size:80%;">20.26</span></td></tr>
