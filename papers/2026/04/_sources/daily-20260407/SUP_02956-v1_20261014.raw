          <math id="algorithm1.m26" class="ltx_Math" alttext="\mathit{CA},~\mathit{CF}\leftarrow\text{Evaluate}(\mathcal{F},\mathcal{D}_{\text{val}})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝐶𝐴</mi><mo mathsize="0.900em" rspace="0.477em">,</mo><mrow><mi mathsize="0.900em">𝐶𝐹</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext mathsize="0.900em">Evaluate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo mathsize="0.900em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mtext mathsize="0.900em">val</mtext></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathit{CA},~\mathit{CF}\leftarrow\text{Evaluate}(\mathcal{F},\mathcal{D}_{\text{val}})</annotation></semantics></math><span id="algorithm1.6.10.2" class="ltx_text" style="font-size:90%;">  
