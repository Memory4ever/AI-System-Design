<span id="S5.T10.6.2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">CoMP w/ UPop <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite></span></span>
</span></span><span id="S5.T10.6.2.1.3" class="ltx_text" style="font-size:80%;"><span id="S5.T10.6.2.1.3.1" class="ltx_text"></span></span></td>
