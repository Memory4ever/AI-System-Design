          <math id="algorithm1.m50" class="ltx_Math" alttext="\bm{M}^{p}\leftarrow\mathbb{I}(\bm{S}^{\prime p}&gt;\theta^{p})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">𝑴</mi><mi mathsize="0.900em">p</mi></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">𝕀</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mi mathsize="0.900em">𝑺</mi><mrow><mo mathsize="0.900em" rspace="0em">′</mo><mphantom></mphantom><mi mathsize="0.900em">p</mi></mrow></msup><mo mathsize="0.900em">&gt;</mo><msup><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">p</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{M}^{p}\leftarrow\mathbb{I}(\bm{S}^{\prime p}&gt;\theta^{p})</annotation></semantics></math><span id="algorithm1.6.29.7" class="ltx_text" style="font-size:90%;">  
</span><span id="algorithm1.6.29.8" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#808080;"># Select parameters to prune with <math id="algorithm1.m51" class="ltx_Math" alttext="\theta^{p}\in\{\theta^{p}_{v},\theta^{p}_{l},\theta^{p}_{c}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.110em" minsize="1.110em">{</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">v</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">l</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">c</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.110em" minsize="1.110em">}</mo></mrow></mrow><annotation encoding="application/x-tex">\theta^{p}\in\{\theta^{p}_{v},\theta^{p}_{l},\theta^{p}_{c}\}</annotation></semantics></math></span>
</div>
<div id="algorithm1.6.30" class="ltx_listingline"><span id="algorithm1.6.30.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.30.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.30.3" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.30.4" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.30.5" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.30.6" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#808080;">27</span></span>
          <span id="algorithm1.6.30.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#808080;"># Decay the mask to <math id="algorithm1.m52" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> in <math id="algorithm1.m53" class="ltx_Math" alttext="5\mathcal{J}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">5</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">𝒥</mi></mrow><annotation encoding="application/x-tex">5\mathcal{J}</annotation></semantics></math> steps; the last <math id="algorithm1.m54" class="ltx_Math" alttext="\mathcal{J}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">𝒥</mi><annotation encoding="application/x-tex">\mathcal{J}</annotation></semantics></math> steps perform recovery only</span>
</div>
<div id="algorithm1.6.31" class="ltx_listingline"><span id="algorithm1.6.31.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.31.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.31.3" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.31.4" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.31.5" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.31.6" class="ltx_text ltx_font_bold" style="font-size:90%;">28</span></span>
          <math id="algorithm1.m55" class="ltx_Math" alttext="\bm{M}^{p}\leftarrow\bm{M}^{p}+(1-i/(5\mathcal{J}))(1-\bm{M}^{p})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.900em">𝑴</mi><mi mathsize="0.900em">p</mi></msup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.900em">𝑴</mi><mi mathsize="0.900em">p</mi></msup><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">i</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">5</mn><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒥</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝑴</mi><mi mathsize="0.900em">p</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{M}^{p}\leftarrow\bm{M}^{p}+(1-i/(5\mathcal{J}))(1-\bm{M}^{p})</annotation></semantics></math>
