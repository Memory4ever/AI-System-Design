<td id="S5.T10.6.3.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T10.6.3.2.1" class="ltx_text" style="font-size:80%;">0.8</span></td>
<td id="S5.T10.6.3.3" class="ltx_td ltx_align_center"><span id="S5.T10.6.3.3.1" class="ltx_text" style="font-size:80%;">79.09</span></td>
<td id="S5.T10.6.3.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T10.6.3.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">79.62</span></td>
