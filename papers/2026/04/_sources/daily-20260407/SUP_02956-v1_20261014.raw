          <span id="algorithm1.6.28.6" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="algorithm1.6.28.7" class="ltx_text" style="font-size:90%;"> </span><em id="algorithm1.6.28.8" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="algorithm1.m49" class="ltx_Math" alttext="i~\%~\mathcal{J}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo lspace="0.310em" mathsize="1.110em">%</mo></mrow><mo lspace="0.310em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒥</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i~\%~\mathcal{J}=0</annotation></semantics></math></em><span id="algorithm1.6.28.9" class="ltx_text" style="font-size:90%;"> </span><span id="algorithm1.6.28.10" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span>
