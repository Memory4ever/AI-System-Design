<td id="S5.T6.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.2.2.1" class="ltx_text" style="font-size:80%;">79.42</span></td>
<td id="S5.T6.6.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T6.6.2.3.1" class="ltx_text" style="font-size:80%;">79.25</span></td>
<td id="S5.T6.6.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.2.4.1" class="ltx_text" style="font-size:80%;">26.50</span></td></tr>
