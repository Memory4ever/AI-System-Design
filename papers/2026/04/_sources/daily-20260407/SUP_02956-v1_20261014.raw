          <math id="algorithm1.m21" class="ltx_Math" alttext="\Theta\leftarrow\{0,0,0,0,0\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Θ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta\leftarrow\{0,0,0,0,0\}</annotation></semantics></math><span id="algorithm1.6.9.2" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m22" class="ltx_Math" alttext="\mathcal{R}\leftarrow\{0,0,0,0,0\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℛ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}\leftarrow\{0,0,0,0,0\}</annotation></semantics></math><span id="algorithm1.6.9.3" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m23" class="ltx_Math" alttext="\mathcal{T}\leftarrow\{0,0,0,0,0\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}\leftarrow\{0,0,0,0,0\}</annotation></semantics></math><span id="algorithm1.6.9.4" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m24" class="ltx_Math" alttext="m\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em" stretchy="false">←</mo><mn mathsize="0.900em">0</mn></mrow><annotation encoding="application/x-tex">m\leftarrow 0</annotation></semantics></math><span id="algorithm1.6.9.5" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m25" class="ltx_Math" alttext="T\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">T</mi><mo mathsize="0.900em" stretchy="false">←</mo><mn mathsize="0.900em">0</mn></mrow><annotation encoding="application/x-tex">T\leftarrow 0</annotation></semantics></math><span id="algorithm1.6.9.6" class="ltx_text" style="font-size:90%;">
</span>
