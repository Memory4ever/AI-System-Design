          <math id="algorithm1.m16" class="ltx_math_unparsed" alttext="\mathcal{F}\leftarrow\mathcal{F}(\cdot|\bm{W},\bm{M}^{p},\theta_{v}^{t},\theta_{l}^{t})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo fence="false" maxsize="0.900em" minsize="0.900em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.900em">𝑾</mi><mo mathsize="0.900em">,</mo><msup><mi mathsize="0.900em">𝑴</mi><mi mathsize="0.900em">p</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">v</mi><mi mathsize="0.900em">t</mi></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\mathcal{F}(\cdot|\bm{W},\bm{M}^{p},\theta_{v}^{t},\theta_{l}^{t})</annotation></semantics></math><span id="algorithm1.6.5.2" class="ltx_text" style="font-size:90%;">
