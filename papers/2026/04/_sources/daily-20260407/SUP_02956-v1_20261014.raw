<td id="S5.T6.6.3.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T6.6.3.3.1" class="ltx_text" style="font-size:80%;">79.62</span></td>
<td id="S5.T6.6.3.4" class="ltx_td ltx_align_center"><span id="S5.T6.6.3.4.1" class="ltx_text" style="font-size:80%;">25.97</span></td></tr>
<tr id="S5.T6.6.4" class="ltx_tr">
<td id="S5.T6.6.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S5.T6.6.4.1.1" class="ltx_text" style="font-size:80%;">360</span></td>
