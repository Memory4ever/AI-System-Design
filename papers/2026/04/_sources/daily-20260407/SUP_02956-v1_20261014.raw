          <span id="algorithm1.6.11.2" class="ltx_text ltx_font_bold" style="font-size:90%;">while</span><span id="algorithm1.6.11.3" class="ltx_text" style="font-size:90%;"> </span><em id="algorithm1.6.11.4" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="algorithm1.m29" class="ltx_Math" alttext="\mathit{CF}&gt;\mathit{TF}" display="inline" intent=":literal"><semantics><mrow><mi>𝐶𝐹</mi><mo>&gt;</mo><mi>𝑇𝐹</mi></mrow><annotation encoding="application/x-tex">\mathit{CF}&gt;\mathit{TF}</annotation></semantics></math></em><span id="algorithm1.6.11.5" class="ltx_text" style="font-size:90%;"> </span><span id="algorithm1.6.11.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
</div>
