            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#808080;">1</span></span>
          <span id="algorithm1.6.4.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#808080;"># Initialize model with parameter masks <math id="algorithm1.m14" class="ltx_Math" alttext="\bm{M}^{p}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">𝑴</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msup><annotation encoding="application/x-tex">\bm{M}^{p}</annotation></semantics></math> and token thresholds <math id="algorithm1.m15" class="ltx_Math" alttext="\theta_{v}^{t},\theta_{l}^{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">v</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">l</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi></msubsup></mrow><annotation encoding="application/x-tex">\theta_{v}^{t},\theta_{l}^{t}</annotation></semantics></math> for pruning</span><span id="algorithm1.6.4.3" class="ltx_text" style="font-size:90%;"> </span>
</div>
