<span id="S4.T1.6.1.4.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Acc.</span></span>
</span></span><span id="S4.T1.6.1.4.1.3" class="ltx_text"></span></span></td>
