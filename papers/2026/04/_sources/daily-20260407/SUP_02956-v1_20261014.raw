          <span id="algorithm1.6.8.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#808080;"># Initialize the MPS module. Elements of <math id="algorithm1.m19" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080" mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> correspond to <math id="algorithm1.m20" class="ltx_Math" alttext="\theta^{p}_{v},\theta^{p}_{l},\theta^{p}_{c},\theta^{t}_{v},\theta^{t}_{l}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">v</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">l</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">c</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">p</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">v</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi></msubsup><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">,</mo><msubsup><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">θ</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">l</mi><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">t</mi></msubsup></mrow><annotation encoding="application/x-tex">\theta^{p}_{v},\theta^{p}_{l},\theta^{p}_{c},\theta^{t}_{v},\theta^{t}_{l}</annotation></semantics></math> in order</span><span id="algorithm1.6.8.3" class="ltx_text" style="font-size:90%;"> </span>
</div>
