</span></span><span id="S4.T1.6.1.1.1.3" class="ltx_text"></span></span></td>
<td id="S4.T1.6.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T1.6.1.2.1" class="ltx_text" style="font-size:80%;"><span id="S4.T1.6.1.2.1.1" class="ltx_text"></span> <span id="S4.T1.6.1.2.1.2" class="ltx_text">
