<th id="A1.T7.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="A1.T7.2.1.1.5.1" class="ltx_text ltx_font_bold">PrepNegQ</span></th></tr>
