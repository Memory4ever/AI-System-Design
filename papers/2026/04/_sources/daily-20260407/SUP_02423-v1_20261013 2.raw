<th id="A1.T7.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">M<math id="A1.T7.m6" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>H</th>
