<th id="A1.T7.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">L<math id="A1.T7.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>M</th>
