<td id="S3.T1.9.22.6" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.22.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#E69664;">1307.72</span></td>
<td id="S3.T1.9.22.7" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.22.7.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00A0DC;">83.18</span></td>
