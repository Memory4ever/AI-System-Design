<td id="S3.T1.9.21.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.21.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#E69664;">54.19</span></td>
<td id="S3.T1.9.21.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">69.11</td>
<td id="S3.T1.9.21.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.21.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00A0DC;">54.07</span></td>
<td id="S3.T1.9.21.5" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.21.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00A0DC;">28.91<sub id="S3.T1.9.21.5.1.1" class="ltx_sub"><span id="S3.T1.9.21.5.1.1.1" class="ltx_text ltx_font_italic">±7.85</span></sub></span></td>
