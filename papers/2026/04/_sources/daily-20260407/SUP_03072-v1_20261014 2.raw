<td id="S3.T1.9.21.8" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.21.8.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#E69664;">0.81</span></td>
<td id="S3.T1.9.21.9" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">0.39</td></tr>
<tr id="S3.T1.9.22" class="ltx_tr">
<th id="S3.T1.9.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.22.1.1" class="ltx_text ltx_font_bold ltx_font_italic">MI-Pruner</span></th>
<td id="S3.T1.9.22.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.22.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00A0DC;">55.78</span></td>
<td id="S3.T1.9.22.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.9.22.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#00A0DC;">69.26</span></td>
<td id="S3.T1.9.22.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:5.0pt;padding-right:5.0pt;">52.63</td>
