<td id="S3.T1.9.20.7" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">80.07</td>
<td id="S3.T1.9.20.8" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">0.78</td>
<td id="S3.T1.9.20.9" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">0.42</td></tr>
