{"data":{"id":"10.48550/arxiv.2604.03072","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.03072","prefix":"10.48550","suffix":"arxiv.2604.03072","identifiers":[{"identifier":"2604.03072","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.03072"}],"creators":[{"name":"Li, Jiameng","nameType":"Personal","givenName":"Jiameng","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Tiulpin, Aleksei","nameType":"Personal","givenName":"Aleksei","familyName":"Tiulpin","affiliation":[],"nameIdentifiers":[]},{"name":"Blaschko, Matthew B.","nameType":"Personal","givenName":"Matthew B.","familyName":"Blaschko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MI-Pruner: Crossmodal Mutual Information-guided Token Pruner for Efficient MLLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-03T14:51:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-06T00:44:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"For multimodal large language models (MLLMs), visual information is relatively sparse compared with text. As a result, research on visual pruning emerges for efficient inference. Current approaches typically measure token importance based on the attention scores in the visual encoder or in the LLM decoder, then select visual tokens with high attention scores while pruning others. In this paper, we pursue a different and more surgical approach. Instead of relying on mechanism-specific signals, we directly compute Mutual Information (MI) between visual and textual features themselves, prior to their interaction. This allows us to explicitly measure crossmodal dependency at the feature levels. Our MI-Pruner is simple, efficient and non-intrusive, requiring no access to internal attention maps or architectural modifications. Experimental results demonstrate that our approach outperforms previous attention-based pruning methods with minimal latency.","descriptionType":"Abstract"},{"description":"9 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.03072","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-06T01:41:18.000Z","registered":"2026-04-06T01:41:18.000Z","published":"2026","updated":"2026-04-06T01:41:18.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.03072","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}