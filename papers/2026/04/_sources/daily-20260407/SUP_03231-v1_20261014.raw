<td id="S4.T2.2.1.12.5" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.12.5.1" class="ltx_text" style="font-size:90%;">84.37</span></td>
<td id="S4.T2.2.1.12.6" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.12.6.1" class="ltx_text" style="font-size:90%;">84.76</span></td>
<td id="S4.T2.2.1.12.7" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.12.7.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
