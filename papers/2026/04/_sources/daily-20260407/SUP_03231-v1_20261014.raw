<td id="S4.T2.2.1.13.3" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.13.3.1" class="ltx_text" style="font-size:90%;">62.41</span></td>
<td id="S4.T2.2.1.13.4" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.13.4.1" class="ltx_text" style="font-size:90%;">66.25</span></td>
<td id="S4.T2.2.1.13.5" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.13.5.1" class="ltx_text" style="font-size:90%;">76.26</span></td>
<td id="S4.T2.2.1.13.6" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.13.6.1" class="ltx_text" style="font-size:90%;">83.31</span></td>
<td id="S4.T2.2.1.13.7" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.13.7.1" class="ltx_text" style="font-size:90%;">53.79 / 68.94</span></td></tr>
<tr id="S4.T2.2.1.14" class="ltx_tr" style="--ltx-bg-color:#D5E8D4;">
