<td id="S4.T2.2.1.14.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">57.24</span></td>
<td id="S4.T2.2.1.14.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">66.94</span></td>
<td id="S4.T2.2.1.14.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">70.75</span></td>
<td id="S4.T2.2.1.14.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">81.84</span></td>
<td id="S4.T2.2.1.14.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">87.83</span></td>
<td id="S4.T2.2.1.14.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T2.2.1.14.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D5E8D4;">58.56/75.94</span></td></tr>
</tbody>
</table>
</span></div>
