<span id="S6.T1.2.3.3.2.1.1.2" class="ltx_tr">
<span id="S6.T1.2.3.3.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1.05pt;padding-bottom:1.05pt;"><math id="S6.T1.m13" class="ltx_Math" alttext="[0.782,\,0.866]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.782</mn><mo>,</mo><mn> 0.866</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.782,\,0.866]</annotation></semantics></math></span></span>
</span></span><span id="S6.T1.2.3.3.2.2" class="ltx_text"></span></span></td>
<td id="S6.T1.2.3.4" class="ltx_td ltx_align_center" style="padding-top:1.05pt;padding-bottom:1.05pt;"><span id="S6.T1.2.3.4.1" class="ltx_text"></span><span id="S6.T1.2.3.4.2" class="ltx_text" style="font-size:80%;"> <span id="S6.T1.2.3.4.2.1" class="ltx_text">
