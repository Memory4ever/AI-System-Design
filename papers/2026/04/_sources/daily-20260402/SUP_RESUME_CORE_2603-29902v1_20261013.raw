</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Human Evaluation on End-to-End Execution.</h3>

<figure id="A2.T11" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A2.T11.7" class="ltx_text" style="font-size:90%;">Table 11</span>: </span><span id="A2.T11.8" class="ltx_text" style="font-size:90%;">Human evaluation results for end-to-end execution. <span id="A2.T11.8.1" class="ltx_text ltx_font_italic"># Inappr.</span> denotes the average count of inappropriate images. Note that fewer <span id="A2.T11.8.2" class="ltx_text ltx_font_italic"># Inappr.</span> images do not imply a higher Success Rate, as malformed tool calls fail to generate any output. <span id="A2.T11.8.3" class="ltx_text ltx_font_italic">MI</span> and <span id="A2.T11.8.4" class="ltx_text ltx_font_italic">FS</span> represent the count of missed images (<math id="A2.T11.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>) and the overall quality score (<math id="A2.T11.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>), respectively.</span></figcaption>
<div id="A2.T11.9" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:172.5pt;height:94.6pt;vertical-align:-45.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-35.2pt,19.3pt) scale(0.710285224035936,0.710285224035936) ;">
<table id="A2.T11.9.1" class="ltx_tabular ltx_align_middle">
<tr id="A2.T11.9.1.1" class="ltx_tr">
<td id="A2.T11.9.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T11.9.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></td>
<td id="A2.T11.9.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T11.9.1.1.2.1" class="ltx_text ltx_font_bold"># Inappr.</span></td>
<td id="A2.T11.9.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T11.9.1.1.3.1" class="ltx_text ltx_font_bold">MI</span> <math id="A2.T11.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A2.T11.9.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T11.9.1.1.4.1" class="ltx_text ltx_font_bold">FS</span> <math id="A2.T11.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
