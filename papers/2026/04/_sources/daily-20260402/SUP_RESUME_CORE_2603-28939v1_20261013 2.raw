oreignobject_content"><span id="A1.F1.pic1.32" class="ltx_text" style="font-size:90%;">TP over features or classes</span></span></span></foreignObject></g></g></g></g><path style="fill:none" d="M 505.41 -279.17 L 327.51 -279.17 C 324.45 -279.17 321.97 -281.65 321.97 -284.7 L 321.97 -325.99 C 321.97 -329.05 324.45 -331.53 327.51 -331.53 L 505.41 -331.53 C 508.47 -331.53 510.95 -329.05 510.95 -325.99 L 510.95 -284.7 C 510.95 -281.65 508.47 -279.17 505.41 -279.17 Z M 321.97 -331.53"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 339.41 -323.8)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 43.13)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 28.26)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 30.68)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.19)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.61)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.54)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:3.17em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.65pt;" height="8.54" overflow="visible" transform="matrix(1 0 0 -1 0 8.54)" width="46.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F1.pic1.33" class="ltx_text ltx_font_bold" style="font-size:90%;">Comm:</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.19)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:9.32em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="119.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F1.pic1.34" class="ltx_text" style="font-size:90%;">Split by classes: none</span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 28.26)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:12.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="154.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F1.pic1.35" class="ltx_text" style="font-size:90%;">Split by features: all-reduce</span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 40.02)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:10.24em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="131.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F1.pic1.36" class="ltx_text" style="font-size:90%;">(on logits partial sums)</span></span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -18.98 L 0 -53.3"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 -53.86)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -104.16 L 0 -138.49"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 -139.04)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -177.55 L 0 -211.88"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 -212.43)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -250.94 L 0 -285.26"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 -285.82)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><g stroke-width="0.4pt"><path style="fill:none" d="M 112.48 0 L 126.26 0"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 307.92 0 L 321.7 0"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 112.48 -79.29 L 126.26 -79.29"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 307.92 -79.29 L 321.7 -79.29"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 112.48 -158.57 L 126.26 -158.57"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 307.92 -158.57 L 321.7 -158.57"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 112.48 -231.96 L 126.26 -231.96"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 307.92 -231.96 L 321.7 -231.96"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 112.48 -305.35 L 126.26 -305.35"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 307.92 -305.35 L 321.7 -305.35"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure A.1: </span>Fully spectral MNIST pipeline annotated with parallelization axes and
communication requirements. DP: data parallelism; TP/CP: tensor/channel parallelism;
FP: frequency-domain sharding; PP: pipeline parallelism. Communication depends on
the chosen sharding strategy (single-device vs multi-device).</figcaption>
</figure>
<section id="A1.S3.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3.1 </span>Input FFT</h4>

<section id="A1.S3.SS1.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S3.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S3.SS1.SSS0.Px1.p1.1" class="ltx_p">Compute <math id="A1.S3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\hat{x}=\mathcal{F}\{x\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{x}=\mathcal{F}\{x\}</annotation></semantics></math> once at the input.</p>
</div>
</section>
<section id="A1.S3.SS1.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A1.S3.SS1.SSS0.Px2.p1.1" class="ltx_p">FFT libraries are typically highly optimized and internally parallelized.
External opportunities include:</p>
<ul id="A1.S3.I1" class="ltx_itemize">
<li id="A1.S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S3.I1.i1.p1" class="ltx_para">
<p id="A1.S3.I1.i1.p1.1" class="ltx_p"><span id="A1.S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Batch parallelism</span>: independent FFT per sample.</p>
</div></li>
<li id="A1.S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S3.I1.i2.p1" class="ltx_para">
<p id="A1.S3.I1.i2.p1.1" class="ltx_p"><span id="A1.S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Channel parallelism</span>: independent FFT per channel (if <math id="A1.S3.I1.i2.p1.m1" class="ltx_Math" alttext="C&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C&gt;1</annotation></semantics></math>).</p>
</div></li>
<li id="A1.S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S3.I1.i3.p1" class="ltx_para">
<p id="A1.S3.I1.i3.p1.1" class="ltx_p"><span id="A1.S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Intra-FFT parallelism</span>: handled by vendor libraries (GPU/CPU).</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.S3.SS1.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Real FFT vs complex FFT.</h6>

<div id="A1.S3.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S3.SS1.SSS0.Px3.p1.1" class="ltx_p">The input is real, so a real FFT (rFFT) could exploit Hermitian symmetry to
save compute/memory <em id="A1.S3.SS1.SSS0.Px3.p1.1.1" class="ltx_emph ltx_font_italic">at the first transform</em>. However, after the first
spectral block, representations become general complex tensors (weights and
mixing break Hermitian symmetry), so rFFT cannot be used internally.</p>
</div>
</section>
</section>
</section>
<section id="A1.S4" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">A.4 </span>DFT in a Parallelizable Form (Two-GPU Example)</h3>

<section id="A1.S4.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.1 </span>Definition of the DFT</h4>

<div id="A1.S4.SS1.p1" class="ltx_para">
<p id="A1.S4.SS1.p1.1" class="ltx_p">Given a length-<math id="A1.S4.SS1.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> sequence <math id="A1.S4.SS1.p1.m2" class="ltx_Math" alttext="x[n]\in\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>∈</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">x[n]\in\mathbb{C}</annotation></semantics></math>, its discrete Fourier transform (DFT) is</p>
<table id="A1.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E1.m1" class="ltx_math_unparsed" alttext="X[k]\;=\;\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\qquad k=0,\dots,N-1," display="block" intent=":literal"><semantics><mrow><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>k</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow><mo rspace="0.391em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover><mi>x</mi><mrow><mo stretchy="false">[</mo><mi>n</mi><mo rspace="0.280em" stretchy="false">]</mo></mrow><msubsup><mi>ω</mi><mi>N</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mo rspace="2.167em">,</mo><mi>k</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi><mo>−</mo><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">X[k]\;=\;\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\qquad k=0,\dots,N-1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.1)</span></td></tr></tbody>
</table>
<p id="A1.S4.SS1.p1.2" class="ltx_p">where <math id="A1.S4.SS1.p1.m3" class="ltx_math_unparsed" alttext="\omega_{N}=e^{-i2\pi/N}" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><msub><mrow></mrow><mi>N</mi></msub><mo>=</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>i</mi><mn>2</mn><mi>π</mi><mo>/</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\omega_{N}=e^{-i2\pi/N}</annotation></semantics></math> is the primitive <math id="A1.S4.SS1.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>-th root of unity.</p>
</div>
<div id="A1.S4.SS1.p2" class="ltx_para">
<p id="A1.S4.SS1.p2.1" class="ltx_p">Equation (<a href="#A1.E1" title="In A.4.1 Definition of the DFT ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>) can be seen as a matrix-vector product:</p>
<table id="A1.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E2.m1" class="ltx_Math" alttext="\mathbf{X}=\mathbf{F}_{N}\,\mathbf{x},\qquad(\mathbf{F}_{N})_{k,n}=\omega_{N}^{nk}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐗</mi><mo>=</mo><mrow><msub><mi>𝐅</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐅</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>=</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{X}=\mathbf{F}_{N}\,\mathbf{x},\qquad(\mathbf{F}_{N})_{k,n}=\omega_{N}^{nk}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.2)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.S4.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.2 </span>Embarrassingly Parallel View (Row Partition)</h4>

<div id="A1.S4.SS2.p1" class="ltx_para">
<p id="A1.S4.SS2.p1.1" class="ltx_p">A first parallelization view follows directly from (<a href="#A1.E2" title="In A.4.1 Definition of the DFT ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>):
each output coefficient <math id="A1.S4.SS2.p1.m1" class="ltx_Math" alttext="X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X[k]</annotation></semantics></math> is an inner product between <math id="A1.S4.SS2.p1.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> and the <math id="A1.S4.SS2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th row
of <math id="A1.S4.SS2.p1.m4" class="ltx_Math" alttext="\mathbf{F}_{N}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>N</mi></msub><annotation encoding="application/x-tex">\mathbf{F}_{N}</annotation></semantics></math>. Therefore, <math id="A1.S4.SS2.p1.m5" class="ltx_Math" alttext="X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X[k]</annotation></semantics></math> can be computed independently across different <math id="A1.S4.SS2.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
<div id="A1.S4.SS2.p2" class="ltx_para">
<p id="A1.S4.SS2.p2.1" class="ltx_p">With two GPUs, we split the output indices into two halves:</p>
<table id="A1.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\mathcal{K}_{0}=\{0,\dots,N/2-1\},\qquad\mathcal{K}_{1}=\{N/2,\dots,N-1\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{K}_{0}=\{0,\dots,N/2-1\},\qquad\mathcal{K}_{1}=\{N/2,\dots,N-1\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS2.p2.2" class="ltx_p">GPU0 computes <math id="A1.S4.SS2.p2.m1" class="ltx_Math" alttext="\{X[k]\}_{k\in\mathcal{K}_{0}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>0</mn></msub></mrow></msub><annotation encoding="application/x-tex">\{X[k]\}_{k\in\mathcal{K}_{0}}</annotation></semantics></math> and GPU1 computes <math id="A1.S4.SS2.p2.m2" class="ltx_Math" alttext="\{X[k]\}_{k\in\mathcal{K}_{1}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>1</mn></msub></mrow></msub><annotation encoding="application/x-tex">\{X[k]\}_{k\in\mathcal{K}_{1}}</annotation></semantics></math>:</p>
<table id="A1.S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E3.m1" class="ltx_Math" alttext="\displaystyle X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X[k]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E3.m2" class="ltx_Math" alttext="\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\quad k\in\mathcal{K}_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\quad k\in\mathcal{K}_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.3)</span></td></tr></tbody>
<tbody id="A1.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E4.m1" class="ltx_Math" alttext="\displaystyle X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X[k]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E4.m2" class="ltx_Math" alttext="\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\quad k\in\mathcal{K}_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk},\quad k\in\mathcal{K}_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.4)</span></td></tr></tbody>
</table>
</div>
<section id="A1.S4.SS2.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Communication cost.</h6>

<div id="A1.S4.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS2.SSS0.Px1.p1.1" class="ltx_p">This decomposition requires both GPUs to access the full input vector <math id="A1.S4.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
In distributed settings, this is equivalent to broadcasting <math id="A1.S4.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> to all devices
(or replicating it), which can be expensive for large <math id="A1.S4.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.S4.SS2.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Key property.</h6>

<div id="A1.S4.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A1.S4.SS2.SSS0.Px2.p1.1" class="ltx_p">Once <math id="A1.S4.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is available on both GPUs, computation is independent across <math id="A1.S4.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>
and no further synchronization is required.</p>
</div>
</section>
</section>
<section id="A1.S4.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.3 </span>Cooley–Tukey Factorization (Compute-Efficient Parallel Form)</h4>

<div id="A1.S4.SS3.p1" class="ltx_para">
<p id="A1.S4.SS3.p1.1" class="ltx_p">In practice, FFT implementations exploit the Cooley–Tukey factorization.
For clarity, assume <math id="A1.S4.SS3.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is even and split the sum into even and odd indices:</p>
<table id="A1.S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\displaystyle X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X[k]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex7.m2" class="ltx_Math" alttext="\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk}=\sum_{m=0}^{N/2-1}x[2m]\;\omega_{N}^{(2m)k}+\sum_{m=0}^{N/2-1}x[2m+1]\;\omega_{N}^{(2m+1)k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mi>N</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n=0}^{N-1}x[n]\;\omega_{N}^{nk}=\sum_{m=0}^{N/2-1}x[2m]\;\omega_{N}^{(2m)k}+\sum_{m=0}^{N/2-1}x[2m+1]\;\omega_{N}^{(2m+1)k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E5.m1" class="ltx_Math" alttext="\displaystyle=\sum_{m=0}^{N/2-1}x_{e}[m]\;\omega_{N/2}^{mk}+\omega_{N}^{k}\sum_{m=0}^{N/2-1}x_{o}[m]\;\omega_{N/2}^{mk}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>x</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ω</mi><mi>N</mi><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>x</mi><mi>o</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{m=0}^{N/2-1}x_{e}[m]\;\omega_{N/2}^{mk}+\omega_{N}^{k}\sum_{m=0}^{N/2-1}x_{o}[m]\;\omega_{N/2}^{mk},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.5)</span></td></tr></tbody>
</table>
<p id="A1.S4.SS3.p1.2" class="ltx_p">where <math id="A1.S4.SS3.p1.m2" class="ltx_Math" alttext="x_{e}[m]=x[2m]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{e}[m]=x[2m]</annotation></semantics></math> and <math id="A1.S4.SS3.p1.m3" class="ltx_Math" alttext="x_{o}[m]=x[2m+1]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mi>o</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{o}[m]=x[2m+1]</annotation></semantics></math>.</p>
</div>
<div id="A1.S4.SS3.p2" class="ltx_para">
<p id="A1.S4.SS3.p2.1" class="ltx_p">Define two length-<math id="A1.S4.SS3.p2.m1" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math> DFTs:</p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="E[k]=\sum_{m=0}^{N/2-1}x_{e}[m]\;\omega_{N/2}^{mk},\qquad O[k]=\sum_{m=0}^{N/2-1}x_{o}[m]\;\omega_{N/2}^{mk}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>x</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>x</mi><mi>o</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mi>ω</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E[k]=\sum_{m=0}^{N/2-1}x_{e}[m]\;\omega_{N/2}^{mk},\qquad O[k]=\sum_{m=0}^{N/2-1}x_{o}[m]\;\omega_{N/2}^{mk}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS3.p2.2" class="ltx_p">Then the DFT is reconstructed by the <em id="A1.S4.SS3.p2.2.1" class="ltx_emph ltx_font_italic">butterfly</em>:</p>
<table id="A1.S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E6.m1" class="ltx_Math" alttext="\displaystyle X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X[k]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E6.m2" class="ltx_Math" alttext="\displaystyle=E[k]+\omega_{N}^{k}O[k]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ω</mi><mi>N</mi><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=E[k]+\omega_{N}^{k}O[k],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.6)</span></td></tr></tbody>
<tbody id="A1.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E7.m1" class="ltx_Math" alttext="\displaystyle X[k+N/2]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>+</mo><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X[k+N/2]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E7.m2" class="ltx_math_unparsed" alttext="\displaystyle=E[k]-\omega_{N}^{k}O[k],\qquad k=0,\dots,N/2-1." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>E</mi><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msubsup><mi>ω</mi><mi>N</mi><mi>k</mi></msubsup><mi>O</mi><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mo rspace="2.167em">,</mo><mi>k</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi><mo>/</mo><mn>2</mn><mo>−</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=E[k]-\omega_{N}^{k}O[k],\qquad k=0,\dots,N/2-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.7)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.S4.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.4 </span>Two-GPU Parallel FFT (Conceptual Schedule)</h4>

<div id="A1.S4.SS4.p1" class="ltx_para">
<p id="A1.S4.SS4.p1.1" class="ltx_p">A compute-efficient two-GPU schedule can be expressed as:</p>
</div>
<section id="A1.S4.SS4.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Step 1 (local FFTs, no communication).</h6>

<div id="A1.S4.SS4.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS4.SSS0.Px1.p1.1" class="ltx_p">GPU0 computes the <math id="A1.S4.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math>-point FFT of the even-indexed subsequence:</p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="E[k]\leftarrow\mathrm{DFT}_{N/2}(x_{e})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msub><mi>DFT</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>e</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">E[k]\leftarrow\mathrm{DFT}_{N/2}(x_{e}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS4.SSS0.Px1.p1.2" class="ltx_p">GPU1 computes the <math id="A1.S4.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math>-point FFT of the odd-indexed subsequence:</p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="O[k]\leftarrow\mathrm{DFT}_{N/2}(x_{o})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msub><mi>DFT</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>o</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O[k]\leftarrow\mathrm{DFT}_{N/2}(x_{o}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS4.SSS0.Px1.p1.3" class="ltx_p">These are independent and fully parallel.</p>
</div>
</section>
<section id="A1.S4.SS4.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Step 2 (butterfly combine, communication required).</h6>

<div id="A1.S4.SS4.SSS0.Px2.p1" class="ltx_para">
<p id="A1.S4.SS4.SSS0.Px2.p1.1" class="ltx_p">To form <math id="A1.S4.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="X[k]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X[k]</annotation></semantics></math> and <math id="A1.S4.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="X[k+N/2]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>+</mo><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X[k+N/2]</annotation></semantics></math>, each GPU needs both <math id="A1.S4.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="E[k]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">E[k]</annotation></semantics></math> and <math id="A1.S4.SS4.SSS0.Px2.p1.m4" class="ltx_Math" alttext="O[k]" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">O[k]</annotation></semantics></math> for the relevant <math id="A1.S4.SS4.SSS0.Px2.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
A simple approach is to exchange half-spectra:
GPU0 sends <math id="A1.S4.SS4.SSS0.Px2.p1.m6" class="ltx_Math" alttext="O[k]" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">O[k]</annotation></semantics></math> (for needed <math id="A1.S4.SS4.SSS0.Px2.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>) to GPU1 and receives <math id="A1.S4.SS4.SSS0.Px2.p1.m8" class="ltx_Math" alttext="E[k]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">E[k]</annotation></semantics></math> (for needed <math id="A1.S4.SS4.SSS0.Px2.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>), then applies
(<a href="#A1.E6" title="In A.4.3 Cooley–Tukey Factorization (Compute-Efficient Parallel Form) ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a>)–(<a href="#A1.E7" title="In A.4.3 Cooley–Tukey Factorization (Compute-Efficient Parallel Form) ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.7</span></a>) locally on its assigned <math id="A1.S4.SS4.SSS0.Px2.p1.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> range.
Equivalently, one can all-gather <math id="A1.S4.SS4.SSS0.Px2.p1.m11" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A1.S4.SS4.SSS0.Px2.p1.m12" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math> across devices.</p>
</div>
</section>
<section id="A1.S4.SS4.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Compute vs communication.</h6>

<div id="A1.S4.SS4.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S4.SS4.SSS0.Px3.p1.1" class="ltx_p">Compared to the row-partition form (<a href="#A1.E3" title="In A.4.2 Embarrassingly Parallel View (Row Partition) ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>)–(<a href="#A1.E4" title="In A.4.2 Embarrassingly Parallel View (Row Partition) ‣ A.4 DFT in a Parallelizable Form (Two-GPU Example) ‣ Appendix A Parallelism in Polar Spectral Operators ‣ Foundations of Polar Linear Algebra A Structured Framework for Radial–Angular Operators" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>),
Cooley–Tukey reduces arithmetic from <math id="A1.S4.SS4.SSS0.Px3.p1.m1" class="ltx_Math" alttext="O(N^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N^{2})</annotation></semantics></math> to <math id="A1.S4.SS4.SSS0.Px3.p1.m2" class="ltx_Math" alttext="O(N\log N)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N\log N)</annotation></semantics></math> but introduces structured
communication at butterfly stages (often implemented as all-to-all or all-gather
patterns depending on the chosen decomposition).</p>
</div>
</section>
</section>
<section id="A1.S4.SS5" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.5 </span>Spectral Convolution on Low Modes</h4>

<section id="A1.S4.SS5.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS5.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS5.SSS0.Px1.p1.1" class="ltx_p">A typical spectral convolution restricted to low-frequency modes applies a
learned weight <math id="A1.S4.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="W_{k}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>k</mi></msub><annotation encoding="application/x-tex">W_{k}</annotation></semantics></math> to each retained mode:</p>
<table id="A1.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\hat{y}_{k}=W_{k}\,\hat{x}_{k},\quad k\in\Omega_{\text{low}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>k</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi mathvariant="normal">Ω</mi><mtext>low</mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{y}_{k}=W_{k}\,\hat{x}_{k},\quad k\in\Omega_{\text{low}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS5.SSS0.Px1.p1.2" class="ltx_p">where <math id="A1.S4.SS5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\Omega_{\text{low}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mtext>low</mtext></msub><annotation encoding="application/x-tex">\Omega_{\text{low}}</annotation></semantics></math> denotes a small subset of <math id="A1.S4.SS5.SSS0.Px1.p1.m3" class="ltx_Math" alttext="(k_{r},k_{\theta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>r</mi></msub><mo>,</mo><msub><mi>k</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k_{r},k_{\theta})</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.S4.SS5.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS5.SSS0.Px2.p1" class="ltx_para">
<p id="A1.S4.SS5.SSS0.Px2.p1.1" class="ltx_p">This is one of the most parallel-friendly operators:</p>
<ul id="A1.S4.I1" class="ltx_itemize">
<li id="A1.S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I1.i1.p1" class="ltx_para">
<p id="A1.S4.I1.i1.p1.1" class="ltx_p"><span id="A1.S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Frequency parallelism</span>: each retained mode is independent.</p>
</div></li>
<li id="A1.S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I1.i2.p1" class="ltx_para">
<p id="A1.S4.I1.i2.p1.1" class="ltx_p"><span id="A1.S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Channel parallelism</span>: weight application is independent across output channels.</p>
</div></li>
<li id="A1.S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I1.i3.p1" class="ltx_para">
<p id="A1.S4.I1.i3.p1.1" class="ltx_p"><span id="A1.S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Batch parallelism</span>: independent across samples.</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.S4.SS5.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Implementation view.</h6>

<div id="A1.S4.SS5.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S4.SS5.SSS0.Px3.p1.1" class="ltx_p">The operation maps to batched (complex) GEMM over channels for each mode, or
equivalently to a fused kernel where <math id="A1.S4.SS5.SSS0.Px3.p1.m1" class="ltx_Math" alttext="(B,k_{r},k_{\theta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><msub><mi>k</mi><mi>r</mi></msub><mo>,</mo><msub><mi>k</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(B,k_{r},k_{\theta})</annotation></semantics></math> index independent tiles.</p>
</div>
</section>
</section>
<section id="A1.S4.SS6" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.6 </span>Residual Path with Learnable Gain <math id="A1.S4.SS6.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></h4>

<section id="A1.S4.SS6.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS6.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS6.SSS0.Px1.p1.1" class="ltx_p">Each block contains a residual combination:</p>
<table id="A1.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\hat{z}\leftarrow\hat{x}+\alpha\,\hat{y}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>z</mi><mo>^</mo></mover><mo stretchy="false">←</mo><mrow><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>+</mo><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{z}\leftarrow\hat{x}+\alpha\,\hat{y}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.S4.SS6.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS6.SSS0.Px2.p1" class="ltx_para">
<p id="A1.S4.SS6.SSS0.Px2.p1.1" class="ltx_p">Elementwise and trivially parallel:</p>
<ul id="A1.S4.I2" class="ltx_itemize">
<li id="A1.S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I2.i1.p1" class="ltx_para">
<p id="A1.S4.I2.i1.p1.1" class="ltx_p"><span id="A1.S4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Batch parallelism</span> and <span id="A1.S4.I2.i1.p1.1.2" class="ltx_text ltx_font_bold">channel parallelism</span>.</p>
</div></li>
<li id="A1.S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I2.i2.p1" class="ltx_para">
<p id="A1.S4.I2.i2.p1.1" class="ltx_p"><span id="A1.S4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Frequency parallelism</span>: independent per coefficient.</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.S4.SS6.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Note on <math id="A1.S4.SS6.SSS0.Px3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> learning.</h6>

<div id="A1.S4.SS6.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S4.SS6.SSS0.Px3.p1.1" class="ltx_p"><math id="A1.S4.SS6.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> affects the effective depth/strength of the residual branch.
From a systems standpoint, it is a scalar (or per-channel scalar) and adds no
meaningful synchronization cost.</p>
</div>
</section>
</section>
<section id="A1.S4.SS7" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.7 </span>Spectral Normalization (RMSNorm-like)</h4>

<section id="A1.S4.SS7.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS7.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS7.SSS0.Px1.p1.1" class="ltx_p">A spectral RMS normalization rescales tensors by a statistic computed across
channels and/or frequencies (depending on the chosen definition).</p>
</div>
</section>
<section id="A1.S4.SS7.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS7.SSS0.Px2.p1" class="ltx_para">
<ul id="A1.S4.I3" class="ltx_itemize">
<li id="A1.S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I3.i1.p1" class="ltx_para">
<p id="A1.S4.I3.i1.p1.1" class="ltx_p"><span id="A1.S4.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">Local parallelism</span>: compute partial sums in parallel.</p>
</div></li>
<li id="A1.S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I3.i2.p1" class="ltx_para">
<p id="A1.S4.I3.i2.p1.1" class="ltx_p"><span id="A1.S4.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Reduction synchronization</span>: requires a reduction (sum/mean) over the
normalized dimension, then a broadcast of the scale factor.</p>
</div></li>
</ul>
<p id="A1.S4.SS7.SSS0.Px2.p1.1" class="ltx_p">This is a common pattern on GPUs: high arithmetic intensity kernels with a
small reduction overhead.</p>
</div>
</section>
</section>
<section id="A1.S4.SS8" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.8 </span>Periodic Spectral Gate Along <math id="A1.S4.SS8.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></h4>

<section id="A1.S4.SS8.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS8.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS8.SSS0.Px1.p1.1" class="ltx_p">The gate is implemented as a circular convolution over angular frequency index:</p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\hat{g}_{k_{\theta}}=\frac{1}{T}\sum_{m=-M}^{M}\hat{W}_{m}\,\hat{z}_{k_{\theta}-m}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><msub><mi>k</mi><mi>θ</mi></msub></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mrow><mo>−</mo><mi>M</mi></mrow></mrow><mi>M</mi></munderover><mrow><msub><mover accent="true"><mi>W</mi><mo>^</mo></mover><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><msub><mi>k</mi><mi>θ</mi></msub><mo>−</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{g}_{k_{\theta}}=\frac{1}{T}\sum_{m=-M}^{M}\hat{W}_{m}\,\hat{z}_{k_{\theta}-m},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS8.SSS0.Px1.p1.2" class="ltx_p">and is applied only to low-frequency quadrants (projection).</p>
</div>
</section>
<section id="A1.S4.SS8.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS8.SSS0.Px2.p1" class="ltx_para">
<ul id="A1.S4.I4" class="ltx_itemize">
<li id="A1.S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I4.i1.p1" class="ltx_para">
<p id="A1.S4.I4.i1.p1.1" class="ltx_p"><span id="A1.S4.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">Batch/channel parallelism</span>: fully independent.</p>
</div></li>
<li id="A1.S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I4.i2.p1" class="ltx_para">
<p id="A1.S4.I4.i2.p1.1" class="ltx_p"><span id="A1.S4.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">Radial parallelism</span>: independent across <math id="A1.S4.I4.i2.p1.m1" class="ltx_Math" alttext="k_{r}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>r</mi></msub><annotation encoding="application/x-tex">k_{r}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I4.i3.p1" class="ltx_para">
<p id="A1.S4.I4.i3.p1.1" class="ltx_p"><span id="A1.S4.I4.i3.p1.1.1" class="ltx_text ltx_font_bold">Angular parallelism</span>: each <math id="A1.S4.I4.i3.p1.m1" class="ltx_Math" alttext="k_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">k_{\theta}</annotation></semantics></math> can be computed in parallel,
with reads from shifted neighbors (regular, cache-friendly access).</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.S4.SS8.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Precomputation.</h6>

<div id="A1.S4.SS8.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S4.SS8.SSS0.Px3.p1.1" class="ltx_p">The gate kernel <math id="A1.S4.SS8.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\hat{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{W}</annotation></semantics></math>, the low-quadrant masks, and the shift indices
are all static for fixed <math id="A1.S4.SS8.SSS0.Px3.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and can be precomputed and stored as buffers,
reducing runtime overhead.</p>
</div>
</section>
<section id="A1.S4.SS8.SSS0.Px4" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Debug-driven metric (energy ratio).</h6>

<div id="A1.S4.SS8.SSS0.Px4.p1" class="ltx_para">
<p id="A1.S4.SS8.SSS0.Px4.p1.1" class="ltx_p">A key diagnostic for stability is the low-mode energy ratio</p>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\rho=\frac{\|\hat{z}_{\text{low}}^{\text{post}}\|}{\|\hat{z}_{\text{low}}^{\text{pre}}\|}," display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">‖</mo><msubsup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mtext>low</mtext><mtext>post</mtext></msubsup><mo stretchy="false">‖</mo></mrow><mrow><mo stretchy="false">‖</mo><msubsup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mtext>low</mtext><mtext>pre</mtext></msubsup><mo stretchy="false">‖</mo></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho=\frac{\|\hat{z}_{\text{low}}^{\text{post}}\|}{\|\hat{z}_{\text{low}}^{\text{pre}}\|},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S4.SS8.SSS0.Px4.p1.2" class="ltx_p">computed for the first block to detect destructive gating. This metric itself
is parallelizable (a small reduction over low modes).</p>
</div>
</section>
</section>
<section id="A1.S4.SS9" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.9 </span>Stacking of Spectral Blocks</h4>

<section id="A1.S4.SS9.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS9.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS9.SSS0.Px1.p1.1" class="ltx_p">Blocks are composed sequentially along depth <math id="A1.S4.SS9.SSS0.Px1.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>:</p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\hat{z}^{(l+1)}=\mathcal{B}^{(l)}(\hat{z}^{(l)})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{z}^{(l+1)}=\mathcal{B}^{(l)}(\hat{z}^{(l)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.S4.SS9.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS9.SSS0.Px2.p1" class="ltx_para">
<ul id="A1.S4.I5" class="ltx_itemize">
<li id="A1.S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I5.i1.p1" class="ltx_para">
<p id="A1.S4.I5.i1.p1.1" class="ltx_p"><span id="A1.S4.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">Within-block parallelism</span> remains high (as described above).</p>
</div></li>
<li id="A1.S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I5.i2.p1" class="ltx_para">
<p id="A1.S4.I5.i2.p1.1" class="ltx_p"><span id="A1.S4.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">Pipeline parallelism</span> is possible across depth: assign different
blocks to different devices and stream micro-batches.</p>
</div></li>
</ul>
</div>
</section>
</section>
<section id="A1.S4.SS10" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4.10 </span>Spectral Feature Pooling and Head</h4>

<section id="A1.S4.SS10.SSS0.Px1" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Operation.</h6>

<div id="A1.S4.SS10.SSS0.Px1.p1" class="ltx_para">
<p id="A1.S4.SS10.SSS0.Px1.p1.1" class="ltx_p">Low quadrants are aggregated into a feature vector <math id="A1.S4.SS10.SSS0.Px1.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> (e.g., mean over selected
modes, concatenation of real/imag statistics), then passed to a real-valued head.
Spectral feature pooling aggregates information from selected low-frequency
quadrants into a compact feature vector. From a parallel computing perspective,
this operation corresponds to a reduction pattern, as partial contributions
computed over disjoint frequency subsets must be combined via sum or mean
operations.</p>
</div>
<div id="A1.S4.SS10.SSS0.Px1.p2" class="ltx_para">
<p id="A1.S4.SS10.SSS0.Px1.p2.1" class="ltx_p">The subsequent classifier head operates on real-valued features and reduces to
a matrix multiplication. This stage naturally supports batch parallelism and
tensor parallelism, either by splitting output classes or by partitioning the
feature dimension, the latter requiring a final reduction across devices.</p>
</div>
</section>
<section id="A1.S4.SS10.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Parallelization.</h6>

<div id="A1.S4.SS10.SSS0.Px2.p1" class="ltx_para">
<ul id="A1.S4.I6" class="ltx_itemize">
<li id="A1.S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I6.i1.p1" class="ltx_para">
<p id="A1.S4.I6.i1.p1.1" class="ltx_p"><span id="A1.S4.I6.i1.p1.1.1" class="ltx_text ltx_font_bold">Batch parallelism</span>: independent features/logits per sample.</p>
</div></li>
<li id="A1.S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I6.i2.p1" class="ltx_para">
<p id="A1.S4.I6.i2.p1.1" class="ltx_p"><span id="A1.S4.I6.i2.p1.1.1" class="ltx_text ltx_font_bold">Reduction pattern</span>: pooling requires reductions over selected modes.</p>
</div></li>
<li id="A1.S4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I6.i3.p1" class="ltx_para">
<p id="A1.S4.I6.i3.p1.1" class="ltx_p"><span id="A1.S4.I6.i3.p1.1.1" class="ltx_text ltx_font_bold">Head parallelism</span>: linear layer maps to GEMM; can use tensor parallelism
by splitting output classes or hidden features.</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.S4.SS10.SSS0.Px3" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">Complex-to-real interface.</h6>

<div id="A1.S4.SS10.SSS0.Px3.p1" class="ltx_para">
<p id="A1.S4.SS10.SSS0.Px3.p1.1" class="ltx_p">If the head is real-valued, complex features can be mapped to real features by:</p>
<ul id="A1.S4.I7" class="ltx_itemize">
<li id="A1.S4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I7.i1.p1" class="ltx_para">
<p id="A1.S4.I7.i1.p1.1" class="ltx_p">concatenating <math id="A1.S4.I7.i1.p1.m1" class="ltx_Math" alttext="\Re(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℜ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Re(\cdot)</annotation></semantics></math> and <math id="A1.S4.I7.i1.p1.m2" class="ltx_Math" alttext="\Im(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℑ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Im(\cdot)</annotation></semantics></math> statistics;</p>
</div></li>
<li id="A1.S4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I7.i2.p1" class="ltx_para">
<p id="A1.S4.I7.i2.p1.1" class="ltx_p">using magnitudes/phases (less common and potentially ill-conditioned);</p>
</div></li>
<li id="A1.S4.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.S4.I7.i3.p1" class="ltx_para">
<p id="A1.S4.I7.i3.p1.1" class="ltx_p">keeping complex head (requires complex support in the target backend).</p>
</div></li>
</ul>
</div>
</section>
</section>
</section>
<section id="A1.S5" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">A.5 </span>Complex Arithmetic: Native vs Real-Imag Decomposition</h3>

<section id="A1.S5.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5.1 </span>Is complex a problem?</h4>

<div id="A1.S5.SS1.p1" class="ltx_para">
<p id="A1.S5.SS1.p1.1" class="ltx_p">Complex tensors are conceptually natural in spectral models. The practical
challenge is hardware support: many accelerators provide limited or no native
complex GEMM.</p>
</div>
</section>
<section id="A1.S5.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5.2 </span>Real-Imag decomposition</h4>

<div id="A1.S5.SS2.p1" class="ltx_para">
<p id="A1.S5.SS2.p1.1" class="ltx_p">Any complex multiplication can be expressed via real arithmetic:</p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="(a+ib)(x+iy)=(ax-by)+i(ay+bx)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(a+ib)(x+iy)=(ax-by)+i(ay+bx),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.S5.SS2.p1.2" class="ltx_p">which maps complex linear layers to coupled real-valued GEMMs plus elementwise
ops. This transformation preserves parallelism and often improves portability
to NPUs/compilers that are optimized for real-valued kernels.</p>
</div>
</section>
</section>
