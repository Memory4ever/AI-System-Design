<div id="Ch1.S10.SSx3.SSS0.Px8.p4" class="ltx_para">
<p id="Ch1.S10.SSx3.SSS0.Px8.p4.1" class="ltx_p">For <math id="Ch1.S10.SSx3.SSS0.Px8.p4.m1" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math>:</p>
<table id="Ch1.Ex83" class="ltx_equationgroup ltx_eqn_table">

<tbody id="Ch1.Ex83X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch1.Ex83X.m2" class="ltx_Math" alttext="\displaystyle(a\otimes a^{-1})[2]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(a\otimes a^{-1})[2]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch1.Ex83X.m3" class="ltx_Math" alttext="\displaystyle=a[0]b[2]+a[1]b[1]+a[2]b[0]+a[3]b[3]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=a[0]b[2]+a[1]b[1]+a[2]b[0]+a[3]b[3]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
