<td id="S7.T17.2.4.4" class="ltx_td ltx_align_center">62</td>
<td id="S7.T17.2.4.5" class="ltx_td ltx_align_center">42</td>
<td id="S7.T17.2.4.6" class="ltx_td ltx_align_center">46</td>
<td id="S7.T17.2.4.7" class="ltx_td ltx_nopad_r ltx_align_center">146</td></tr>
