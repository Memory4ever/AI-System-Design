<td id="S7.T17.2.3.5" class="ltx_td ltx_align_center ltx_border_t">95.30%</td>
<td id="S7.T17.2.3.6" class="ltx_td ltx_align_center ltx_border_t">95.37%</td>
<td id="S7.T17.2.3.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">93.51%</td></tr>
