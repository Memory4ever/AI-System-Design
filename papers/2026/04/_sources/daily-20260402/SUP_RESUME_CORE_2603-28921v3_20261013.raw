<th id="S4.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.2.1.3.1" class="ltx_text ltx_font_bold">85%</span></th>
<th id="S4.T6.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.2.1.4.1" class="ltx_text ltx_font_bold">90%</span></th>
<th id="S4.T6.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.2.1.5.1" class="ltx_text ltx_font_bold">92%</span></th>
<th id="S4.T6.2.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.2.1.6.1" class="ltx_text ltx_font_bold">95%</span></th></tr>
</thead>
