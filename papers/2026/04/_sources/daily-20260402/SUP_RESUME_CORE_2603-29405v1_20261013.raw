<th id="A4.T14.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">CHAIR<sub id="A4.T14.2.1.2.1" class="ltx_sub"><span id="A4.T14.2.1.2.1.1" class="ltx_text ltx_font_italic">S</span></sub> <math id="A4.T14.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
