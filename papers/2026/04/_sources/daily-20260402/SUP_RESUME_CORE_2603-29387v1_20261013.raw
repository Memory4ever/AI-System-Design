<td id="S5.T4.6.1.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><math id="S5.T4.m10" class="ltx_Math" alttext="d=8" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">d=8</annotation></semantics></math></td>
