<div id="S5.T1.6" class="ltx_inline-block ltx_transformed_outer" style="width:496.9pt;height:56.4pt;vertical-align:-25.3pt;"><span class="ltx_transformed_inner" style="transform:translate(31.7pt,-3.6pt) scale(1.1463410856059,1.1463410856059) ;">
