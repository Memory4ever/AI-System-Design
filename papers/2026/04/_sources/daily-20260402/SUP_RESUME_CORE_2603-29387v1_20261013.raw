<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Algorithms</h3>

<figure id="A1.SS1.fig2" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="alg1" class="ltx_float ltx_figure_panel ltx_float_algorithm ltx_minipage ltx_align_center ltx_align_top ltx_framed ltx_framed_top" style="width:243.5pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Sparse Structure Generation</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
              <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input</span>: <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>, <math id="alg1.l1.m2" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
              
</div>
<div id="alg1.l3" class="ltx_listingline">
