<td id="S5.T2.6.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFB3B3;"><span id="S5.T2.6.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFB3B3;">0.240</span></td>
<td id="S5.T2.6.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFB3B3;"><span id="S5.T2.6.1.6.3.1" class="ltx_text" style="--ltx-bg-color:#FFB3B3;">0.611</span></td>
<td id="S5.T2.6.1.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFB3B3;"><span id="S5.T2.6.1.6.4.1" class="ltx_text" style="--ltx-bg-color:#FFB3B3;">20.4</span></td>
