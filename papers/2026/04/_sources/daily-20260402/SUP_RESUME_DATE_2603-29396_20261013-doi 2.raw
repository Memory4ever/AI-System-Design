{"data":{"id":"10.48550/arxiv.2603.29396","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.29396","prefix":"10.48550","suffix":"arxiv.2603.29396","identifiers":[{"identifier":"2603.29396","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.29396"}],"creators":[{"name":"Prins, Zoë","nameType":"Personal","givenName":"Zoë","familyName":"Prins","affiliation":[],"nameIdentifiers":[]},{"name":"Punzo, Samuele","nameType":"Personal","givenName":"Samuele","familyName":"Punzo","affiliation":[],"nameIdentifiers":[]},{"name":"Wildenburg, Frank","nameType":"Personal","givenName":"Frank","familyName":"Wildenburg","affiliation":[],"nameIdentifiers":[]},{"name":"Cinà, Giovanni","nameType":"Personal","givenName":"Giovanni","familyName":"Cinà","affiliation":[],"nameIdentifiers":[]},{"name":"Pezzelle, Sandro","nameType":"Personal","givenName":"Sandro","familyName":"Pezzelle","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is my model perplexed for the right reason? Contrasting LLMs' Benchmark Behavior with Token-Level Perplexity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-31T08:00:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T00:36:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-13T15:14:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-15T01:13:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Standard evaluations of Large language models (LLMs) focus on task performance, offering limited insight into whether correct behavior reflects appropriate underlying mechanisms and risking confirmation bias. We introduce a simple, principled interpretability framework based on token-level perplexity to test whether models rely on linguistically relevant cues. By comparing perplexity distributions over minimal sentence pairs differing in one or a few `pivotal' tokens, our method enables precise, hypothesis-driven analysis without relying on unstable feature-attribution techniques. Experiments on controlled linguistic benchmarks with several open-weight LLMs show that, while linguistically important tokens influence model behavior, they never fully explain perplexity shifts, revealing that models rely on heuristics other than the expected linguistic ones.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.29396","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T02:09:55.000Z","registered":"2026-04-01T02:09:55.000Z","published":"2026","updated":"2026-09-15T04:46:35.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.29396","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}