{"data":{"id":"10.48550/arxiv.2603.29847","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.29847","prefix":"10.48550","suffix":"arxiv.2603.29847","identifiers":[{"identifier":"2603.29847","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.29847"}],"creators":[{"name":"Kabisov, Soslan","nameType":"Personal","givenName":"Soslan","familyName":"Kabisov","affiliation":[],"nameIdentifiers":[]},{"name":"Kirichuk, Vsevolod","nameType":"Personal","givenName":"Vsevolod","familyName":"Kirichuk","affiliation":[],"nameIdentifiers":[]},{"name":"Volkov, Andrey","nameType":"Personal","givenName":"Andrey","familyName":"Volkov","affiliation":[],"nameIdentifiers":[]},{"name":"Savrasov, Gennadii","nameType":"Personal","givenName":"Gennadii","familyName":"Savrasov","affiliation":[],"nameIdentifiers":[]},{"name":"Barannikov, Marina","nameType":"Personal","givenName":"Marina","familyName":"Barannikov","affiliation":[],"nameIdentifiers":[]},{"name":"Konushin, Anton","nameType":"Personal","givenName":"Anton","familyName":"Konushin","affiliation":[],"nameIdentifiers":[]},{"name":"Kuznetsov, Andrey","nameType":"Personal","givenName":"Andrey","familyName":"Kuznetsov","affiliation":[],"nameIdentifiers":[]},{"name":"Zhemchuzhnikov, Dmitrii","nameType":"Personal","givenName":"Dmitrii","familyName":"Zhemchuzhnikov","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CADReasoner: Iterative Program Editing for CAD Reverse Engineering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Graphics (cs.GR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-18T10:27:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T01:02:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-06T20:55:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-08T00:13:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Computer-Aided Design (CAD) powers modern engineering, yet producing high-quality parts still demands substantial expert effort. Many AI systems tackle CAD reverse engineering, but most are single-pass and miss fine geometric details. In contrast, human engineers compare the input shape with the reconstruction and iteratively modify the design based on remaining discrepancies. Agent-based methods mimic this loop with frozen VLMs, but weak 3D grounding of current foundation models limits reliability and efficiency. We introduce CADReasoner, a model trained to iteratively refine its prediction using geometric discrepancy between the input and the predicted shape. The model outputs a runnable CadQuery Python program whose rendered mesh is fed back at the next step. CADReasoner fuses multi-view renders and point clouds as complementary modalities. To bridge the realism gap, we propose a scan-simulation protocol applied during both training and evaluation. Across DeepCAD, Fusion 360, and MCB benchmarks, CADReasoner attains state-of-the-art results on clean and scan-sim tracks.","descriptionType":"Abstract"},{"description":"Accepted to Findings of CVPR 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.29847","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T02:20:36.000Z","registered":"2026-04-01T02:20:37.000Z","published":"2026","updated":"2026-10-08T03:06:37.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.29847","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}