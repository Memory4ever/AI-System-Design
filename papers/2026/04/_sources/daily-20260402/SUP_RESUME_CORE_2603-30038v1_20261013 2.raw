<td id="S2.T1.11.7.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.6pt 2.5pt;"><span id="S2.T1.11.7.1.1" class="ltx_text" style="font-size:70%;">3D impl.</span></td>
<td id="S2.T1.11.7.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.6pt 2.5pt;"><math id="S2.T1.m42" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
