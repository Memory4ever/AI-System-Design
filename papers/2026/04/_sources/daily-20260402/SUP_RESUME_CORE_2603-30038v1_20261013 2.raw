<td id="S2.T1.11.6.2" class="ltx_td ltx_align_center" style="padding:0.6pt 2.5pt;"><math id="S2.T1.m35" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
