<td id="S2.T1.11.5.5" class="ltx_td ltx_align_center" style="padding:0.6pt 2.5pt;"><math id="S2.T1.m31" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00" mathsize="0.700em">√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
