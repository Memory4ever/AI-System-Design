<td id="S3.T2.6.1.3.6" class="ltx_td ltx_align_center"><span id="S3.T2.6.1.3.6.1" class="ltx_text ltx_font_bold">100</span></td>
<td id="S3.T2.6.1.3.7" class="ltx_td ltx_align_center">78.8</td>
