<tr id="S3.T2.6.1.2" class="ltx_tr">
<td id="S3.T2.6.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">VADv2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">1</a>]</cite></td>
