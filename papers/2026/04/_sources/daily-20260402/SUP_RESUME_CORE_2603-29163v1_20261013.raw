<td id="S3.T2.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">DAC <math id="S3.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T2.6.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">TTC <math id="S3.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
