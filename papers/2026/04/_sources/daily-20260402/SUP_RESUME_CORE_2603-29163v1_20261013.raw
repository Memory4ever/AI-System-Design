<tr id="S3.T2.6.1.5" class="ltx_tr">
<td id="S3.T2.6.1.5.1" class="ltx_td ltx_align_left ltx_border_r">PARA-Drive <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">31</a>]</cite></td>
<td id="S3.T2.6.1.5.2" class="ltx_td ltx_align_center ltx_border_r">ResNet-34</td>
<td id="S3.T2.6.1.5.3" class="ltx_td ltx_align_center">97.9</td>
<td id="S3.T2.6.1.5.4" class="ltx_td ltx_align_center">92.4</td>
<td id="S3.T2.6.1.5.5" class="ltx_td ltx_align_center">93.0</td>
<td id="S3.T2.6.1.5.6" class="ltx_td ltx_align_center">99.8</td>
<td id="S3.T2.6.1.5.7" class="ltx_td ltx_align_center">79.3</td>
<td id="S3.T2.6.1.5.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S3.T2.6.1.5.8.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">84.0</span></td></tr>
<tr id="S3.T2.6.1.6" class="ltx_tr">
<td id="S3.T2.6.1.6.1" class="ltx_td ltx_align_left ltx_border_r">DRAMA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">35</a>]</cite></td>
