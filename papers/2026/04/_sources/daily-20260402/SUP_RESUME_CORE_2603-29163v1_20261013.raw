<tr id="S3.T2.6.1.4" class="ltx_tr">
<td id="S3.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_border_r">Transfuser <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">2</a>]</cite></td>
