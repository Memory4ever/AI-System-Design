<div id="S3.T1.6.1.1.12.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:45.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:45.4pt;transform:translate(-19.3pt,-19.3pt) rotate(-90deg) ;">
