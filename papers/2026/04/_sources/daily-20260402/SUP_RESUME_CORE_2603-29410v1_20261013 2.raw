<td id="S3.T2.6.1.7.15" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#DCEDFB;padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T2.6.1.7.15.1" class="ltx_text" style="--ltx-bg-color:#DCEDFB;">95.72</span></td>
<td id="S3.T2.6.1.7.16" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#DCEDFB;padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T2.6.1.7.16.1" class="ltx_text" style="--ltx-bg-color:#DCEDFB;">55.19</span></td>
<td id="S3.T2.6.1.7.17" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#DCEDFB;padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T2.6.1.7.17.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DCEDFB;">61.35</span></td></tr>
