<div id="S3.T1.6.1.1.2.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:48.1pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:48.1pt;transform:translate(-20.6pt,-20.6pt) rotate(-90deg) ;">
