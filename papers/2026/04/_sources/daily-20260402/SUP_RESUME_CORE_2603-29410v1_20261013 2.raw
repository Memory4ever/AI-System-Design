</span></div></th>
<th id="S3.T1.6.1.1.14" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">
<div id="S3.T1.6.1.1.14.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:45.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:45.9pt;transform:translate(-19.5pt,-19.5pt) rotate(-90deg) ;">
<p id="S3.T1.6.1.1.14.1.1" class="ltx_p">Stanf.Cars</p>
