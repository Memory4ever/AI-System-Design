<span id="S3.T1.3.1.38.15.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S3.T1.3.1.38.15.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.3.1.38.15.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFB3B3;">1.938</span></span>
</span></td>
