<td id="S6.T2.3.3.5" class="ltx_td ltx_align_center"><span id="S6.T2.3.3.5.1" class="ltx_text" style="font-size:90%;">153.5</span></td></tr>
<tr id="S6.T2.3.4" class="ltx_tr">
<td id="S6.T2.3.4.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S6.T2.3.4.1.1" class="ltx_text" style="font-size:90%;">BlendedMVS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">53</a>]</cite></span></td>
