</span></td>
<td id="S3.T1.3.1.38.8" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="--ltx-bg-color:#FFB3B3;">
<span id="S3.T1.3.1.38.8.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S3.T1.3.1.38.8.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.3.1.38.8.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFB3B3;">0.091</span></span>
</span></td>
<td id="S3.T1.3.1.38.9" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="--ltx-bg-color:#FFD9B3;">
<span id="S3.T1.3.1.38.9.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S3.T1.3.1.38.9.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.3.1.38.9.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFD9B3;">3.282</span></span>
</span></td>
<td id="S3.T1.3.1.38.10" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFB3B3;">
<span id="S3.T1.3.1.38.10.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S3.T1.3.1.38.10.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.3.1.38.10.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFB3B3;">0.922</span></span>
</span></td>
<td id="S3.T1.3.1.38.11" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="--ltx-bg-color:#FFB3B3;">
<span id="S3.T1.3.1.38.11.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
