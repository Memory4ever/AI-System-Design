<td id="S6.T2.3.4.4" class="ltx_td ltx_align_center"><span id="S6.T2.3.4.4.1" class="ltx_text" style="font-size:90%;">450</span></td>
<td id="S6.T2.3.4.5" class="ltx_td ltx_align_center"><span id="S6.T2.3.4.5.1" class="ltx_text" style="font-size:90%;">232.5</span></td></tr>
<tr id="S6.T2.3.5" class="ltx_tr">
