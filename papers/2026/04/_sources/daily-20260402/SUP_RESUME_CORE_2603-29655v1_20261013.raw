<th id="S4.T7.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T7.6.1.2.1" class="ltx_text" style="font-size:90%;">FID<math id="S4.T7.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="S4.T7.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S4.T7.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T7.6.2" class="ltx_tr">
<th id="S4.T7.6.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T7.6.2.1.1" class="ltx_text" style="font-size:90%;">MoMask</span></th>
<td id="S4.T7.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T7.6.2.2.1" class="ltx_text" style="font-size:90%;">14.889<math id="S4.T7.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T7.6.2.2.1.1" class="ltx_text" style="font-size:78%;">.038</span></span></td>
<td id="S4.T7.6.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T7.6.2.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="S4.T7.6.3" class="ltx_tr">
<th id="S4.T7.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T7.6.3.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DynMask</span></th>
<td id="S4.T7.6.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#DDEBFF;"><span id="S4.T7.6.3.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#DDEBFF;">11.543<math id="S4.T7.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#DDEBFF;" mathbackground="#DDEBFF" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T7.6.3.2.1.1" class="ltx_text" style="font-size:78%;">.040</span></span></td>
