            <span id="alg1.l1.3" class="ltx_text" style="font-size:90%;">Token sequence </span><math id="alg1.l1.m1" class="ltx_Math" alttext="\mathbf{z}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝐳</mi><annotation encoding="application/x-tex">\mathbf{z}</annotation></semantics></math><span id="alg1.l1.4" class="ltx_text" style="font-size:90%;">, text condition </span><math id="alg1.l1.m2" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math><span id="alg1.l1.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text" style="font-size:90%;">Compute token embeddings </span><math id="alg1.l2.m1" class="ltx_Math" alttext="\mathbf{x}_{t}\leftarrow\mathrm{Embed}(z_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">Embed</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}\leftarrow\mathrm{Embed}(z_{t})</annotation></semantics></math><span id="alg1.l2.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg1.l3.3" class="ltx_text" style="font-size:90%;">Compute velocity </span><math id="alg1.l3.m1" class="ltx_Math" alttext="\mathbf{v}_{t}\leftarrow\mathbf{x}_{t}-\mathbf{x}_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝐯</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">𝐱</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}_{t}\leftarrow\mathbf{x}_{t}-\mathbf{x}_{t-1}</annotation></semantics></math><span id="alg1.l3.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
