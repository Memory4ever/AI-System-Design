<td id="S4.T5.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.6.2.2.1" class="ltx_text" style="font-size:90%;">0.077<math id="S4.T5.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S4.T5.6.2.2.1.1" class="ltx_text" style="font-size:78%;">.002</span></span></td>
