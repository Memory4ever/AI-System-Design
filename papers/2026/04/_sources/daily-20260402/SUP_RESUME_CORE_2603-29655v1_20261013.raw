            <span id="alg2.l3.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l3.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l3.m1" class="ltx_Math" alttext="s=1,\ldots,S" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">S</mi></mrow><annotation encoding="application/x-tex">s=1,\ldots,S</annotation></semantics></math><span id="alg2.l3.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l3.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l3.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg2.l4.3" class="ltx_text" style="font-size:90%;">  Compute or update MSD </span><math id="alg2.l4.m1" class="ltx_Math" alttext="\bm{\phi}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_bold-italic" mathsize="0.900em" mathvariant="bold-italic">ϕ</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">\bm{\phi}_{t}</annotation></semantics></math><span id="alg2.l4.4" class="ltx_text" style="font-size:90%;"> from the current decoded sequence
</span>
</div>
