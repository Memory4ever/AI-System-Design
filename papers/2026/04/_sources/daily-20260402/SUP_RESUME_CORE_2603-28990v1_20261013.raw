<th id="S4.T5.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S4.T5.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (min)</th></tr>
