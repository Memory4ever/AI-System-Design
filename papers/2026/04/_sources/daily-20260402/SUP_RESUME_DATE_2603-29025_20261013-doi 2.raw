{"data":{"id":"10.48550/arxiv.2603.29025","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.29025","prefix":"10.48550","suffix":"arxiv.2603.29025","identifiers":[{"identifier":"2603.29025","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.29025"}],"creators":[{"name":"Li, Yubo","nameType":"Personal","givenName":"Yubo","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Lu","nameType":"Personal","givenName":"Lu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Tianchong","nameType":"Personal","givenName":"Tianchong","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Krishnan, Ramayya","nameType":"Personal","givenName":"Ramayya","familyName":"Krishnan","affiliation":[],"nameIdentifiers":[]},{"name":"Padman, Rema","nameType":"Personal","givenName":"Rema","familyName":"Padman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Model Says Walk: Measuring whether LLMs Condition on Hidden Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-30T21:36:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T00:10:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-22T12:02:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:47:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-09T17:28:54Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-10T01:09:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-26T23:07:54Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-29T01:08:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Asked whether to walk or drive to a car wash 50 m away, most language models say walk, forgetting that the car has to be there. Such failures are usually measured by accuracy on questions where the hidden constraint applies. We show that this is misleading: a model can answer these questions correctly without reasoning about the constraint at all, simply by favoring the cautious option. We instead ask whether a model's decision changes when the constraint is removed. We test this at three levels of control: log-probability sweeps on open-weight models, a 500-prompt stress test, and CORE, a new human-validated benchmark of minimal constraint-present/constraint-absent pairs. The picture is consistent. The constraint nudges decisions rather than governing them. Models still miss presence constraints like the car wash, yet elsewhere they apply constraints that are not there. As a result, standard accuracy flatters all ten models we evaluate and reorders their ranking, and prompting fixes that look effective largely vanish under paired scoring. Claims about hidden-constraint reasoning need paired evidence.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.29025","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T02:01:11.000Z","registered":"2026-04-01T02:01:12.000Z","published":"2026","updated":"2026-09-29T07:03:41.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.29025","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}