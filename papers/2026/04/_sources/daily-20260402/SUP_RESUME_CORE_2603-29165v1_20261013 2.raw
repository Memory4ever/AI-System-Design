<td id="S4.T4.5.1.5.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:1.75pt 5.0pt;"><span id="S4.T4.5.1.5.7.1" class="ltx_text ltx_font_bold">71.6</span></td></tr>
