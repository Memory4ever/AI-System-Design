<th id="S2.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Core Operations</th>
<td id="S2.T1.2.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">SVD, CP, Tucker</span></td>
<td id="S2.T1.2.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DAE8FC;"><span id="S2.T1.2.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#DAE8FC;">Integer Mapping</span></td>
