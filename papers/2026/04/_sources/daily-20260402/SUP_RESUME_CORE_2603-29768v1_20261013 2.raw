<th id="S2.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.1.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Low-Rank Decomposition</span></th>
