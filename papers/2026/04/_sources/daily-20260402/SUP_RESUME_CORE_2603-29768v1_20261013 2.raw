<td id="S2.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Matrix Factorization</span></td>
<td id="S2.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#DAE8FC;"><span id="S2.T1.2.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#DAE8FC;">Precision Reduction</span></td>
<td id="S2.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Redundancy Removal</span></td>
<td id="S2.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#DAE8FC;"><span id="S2.T1.2.1.2.5.1" class="ltx_text" style="--ltx-bg-color:#DAE8FC;">Trajectory Representation</span></td>
<td id="S2.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.2.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Behavior Mimicry</span></td></tr>
<tr id="S2.T1.2.1.3" class="ltx_tr">
<th id="S2.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Sparsity Type</th>
<td id="S2.T1.2.1.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Structured</span></td>
<td id="S2.T1.2.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DAE8FC;"><span id="S2.T1.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#DAE8FC;">Dense</span></td>
<td id="S2.T1.2.1.3.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Unstructured or Structured</span></td>
<td id="S2.T1.2.1.3.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DAE8FC;"><span id="S2.T1.2.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#DAE8FC;">Continuous</span></td>
<td id="S2.T1.2.1.3.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFFFC7;"><span id="S2.T1.2.1.3.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFC7;">Dense</span></td></tr>
