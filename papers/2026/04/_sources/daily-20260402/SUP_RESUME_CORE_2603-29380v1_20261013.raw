<section id="A1.SSx5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">A.5 Summation and Term-wise Bounds</h3>

<div id="A1.SSx5.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.p1.1" class="ltx_p">Let</p>
<table id="A1.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex79.m1" class="ltx_Math" alttext="F(t):=\sum_{m=\tau}^{t}\mathbb{E}[\epsilon_{i,i}(m)^{2}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(t):=\sum_{m=\tau}^{t}\mathbb{E}[\epsilon_{i,i}(m)^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.p2.1" class="ltx_p">We now bound each term.</p>
</div>
<section id="A1.SSx5.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term C1 (Telescoping)</h4>

<div id="A1.SSx5.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px1.p1.1" class="ltx_p">Using boundedness of <math id="A1.SSx5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="H(m)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(m)</annotation></semantics></math> and <math id="A1.SSx5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="H^{*}(m)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(m)</annotation></semantics></math> (from compactness + smoothness via A1–A2),</p>
<table id="A1.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex80.m1" class="ltx_Math" alttext="\epsilon_{i,i}(m)^{2}\leq C." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mi>C</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{i,i}(m)^{2}\leq C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px1.p2.1" class="ltx_p">Thus,</p>
<table id="A1.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex81.m1" class="ltx_Math" alttext="\sum\frac{1}{2b(m)}(\epsilon^{2}(m)-\epsilon^{2}(m+1))\leq\frac{C}{b(t)}=O(t^{\nu})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mi>C</mi><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mi>ν</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum\frac{1}{2b(m)}(\epsilon^{2}(m)-\epsilon^{2}(m+1))\leq\frac{C}{b(t)}=O(t^{\nu}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SSx5.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term C2 (Noise cross term)</h4>

<div id="A1.SSx5.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px2.p1.1" class="ltx_p">Using independence of <math id="A1.SSx5.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\eta(m)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(m)</annotation></semantics></math> from the past and <math id="A1.SSx5.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\mathbb{E}[\eta_{i}^{2}-1]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>η</mi><mi>i</mi><mn>2</mn></msubsup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\eta_{i}^{2}-1]=0</annotation></semantics></math>,</p>
<table id="A1.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex82.m1" class="ltx_Math" alttext="\mathbb{E}[\epsilon_{i,i}(m)\xi_{i}(m)]\leq\sqrt{\mathbb{E}[\epsilon_{i,i}(m)^{2}]}\sqrt{\mathbb{E}[\xi_{i}(m)^{2}]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\epsilon_{i,i}(m)\xi_{i}(m)]\leq\sqrt{\mathbb{E}[\epsilon_{i,i}(m)^{2}]}\sqrt{\mathbb{E}[\xi_{i}(m)^{2}]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px2.p2.1" class="ltx_p">By Lemma 2,</p>
<table id="A1.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex83.m1" class="ltx_Math" alttext="\mathbb{E}[\xi_{i}(m)^{2}]\leq C." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>C</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\xi_{i}(m)^{2}]\leq C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px2.p3.1" class="ltx_p">Hence,</p>
<table id="A1.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex84.m1" class="ltx_Math" alttext="\sum\mathbb{E}[\epsilon_{i,i}(m)\xi_{i}(m)]\leq C_{2}\sqrt{F(t)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϵ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum\mathbb{E}[\epsilon_{i,i}(m)\xi_{i}(m)]\leq C_{2}\sqrt{F(t)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SSx5.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term C3 (Drift term)</h4>

<div id="A1.SSx5.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px3.p1.1" class="ltx_p">By Lipschitz continuity of the Hessian (Lemma 1),</p>
<table id="A1.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex85.m1" class="ltx_Math" alttext="\|\Delta_{i}(m)\|\leq L_{H}\|\theta(m+1)-\theta(m)\|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Delta_{i}(m)\|\leq L_{H}\|\theta(m+1)-\theta(m)\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px3.p2.1" class="ltx_p">From the update and boundedness of <math id="A1.SSx5.SSS0.Px3.p2.m1" class="ltx_Math" alttext="M(m)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(m)</annotation></semantics></math> (A4) and <math id="A1.SSx5.SSS0.Px3.p2.m2" class="ltx_Math" alttext="z(m)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">z(m)</annotation></semantics></math> (Lemma 2),</p>
<table id="A1.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex86.m1" class="ltx_Math" alttext="\|\theta(m+1)-\theta(m)\|\leq Ca(m)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\theta(m+1)-\theta(m)\|\leq Ca(m).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px3.p3" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px3.p3.1" class="ltx_p">Thus,</p>
<table id="A1.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex87.m1" class="ltx_Math" alttext="\|\Delta_{i}(m)\|\leq Ca(m)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Delta_{i}(m)\|\leq Ca(m).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px3.p4" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px3.p4.1" class="ltx_p">Applying Cauchy–Schwarz,</p>
<table id="A1.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex88.m1" class="ltx_Math" alttext="\sum\frac{\epsilon(m)\Delta(m)}{b(m)}\leq C_{3}\sqrt{F(t)}\sqrt{\sum\left(\frac{a(m)}{b(m)}\right)^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mfrac><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mo movablelimits="false" rspace="0em">∑</mo><msup><mrow><mo>(</mo><mfrac><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum\frac{\epsilon(m)\Delta(m)}{b(m)}\leq C_{3}\sqrt{F(t)}\sqrt{\sum\left(\frac{a(m)}{b(m)}\right)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SSx5.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term C4 (Variance term)</h4>

<div id="A1.SSx5.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px4.p1.1" class="ltx_p">Using <math id="A1.SSx5.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\mathbb{E}[(\eta_{i}^{2}-1)^{2}]=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>η</mi><mi>i</mi><mn>2</mn></msubsup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[(\eta_{i}^{2}-1)^{2}]=2</annotation></semantics></math> and Lemma 2,</p>
<table id="A1.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex89.m1" class="ltx_Math" alttext="\mathbb{E}[\xi_{i}(m)^{2}]\leq C." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mi>C</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\xi_{i}(m)^{2}]\leq C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px4.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px4.p2.1" class="ltx_p">Thus,</p>
<table id="A1.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex90.m1" class="ltx_Math" alttext="\sum b(m)\mathbb{E}[\xi_{i}(m)^{2}]\leq C_{4}\sum b(m)=O(t^{1-\nu})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum b(m)\mathbb{E}[\xi_{i}(m)^{2}]\leq C_{4}\sum b(m)=O(t^{1-\nu}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SSx5.SSS0.Px5" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term C5 (Drift squared)</h4>

<div id="A1.SSx5.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px5.p1.1" class="ltx_p">Using Lipschitz Hessian and parameter increment bound,</p>
<table id="A1.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex91.m1" class="ltx_Math" alttext="\Delta_{i}(m)^{2}\leq Ca(m)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{i}(m)^{2}\leq Ca(m)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx5.SSS0.Px5.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx5.SSS0.Px5.p2.1" class="ltx_p">Hence,</p>
<table id="A1.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex92.m1" class="ltx_Math" alttext="\sum\frac{1}{b(m)}\mathbb{E}[\Delta_{i}(m)^{2}]\leq C_{5}\sum\frac{a(m)^{2}}{b(m)}=O(t^{1-(2\sigma-\nu)})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mrow><mfrac><mn>1</mn><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mfrac><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum\frac{1}{b(m)}\mathbb{E}[\Delta_{i}(m)^{2}]\leq C_{5}\sum\frac{a(m)^{2}}{b(m)}=O(t^{1-(2\sigma-\nu)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A1.SSx6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">A.6 Combining All Terms and Detailed Resolution</h3>

<div id="A1.SSx6.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx6.p1.1" class="ltx_p">From the bounds obtained for the five terms, we have:</p>
<table id="A1.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex93.m1" class="ltx_Math" alttext="\displaystyle F(t)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex93.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{C_{1}}{b(t)}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum_{m=\tau}^{t}\left(\frac{a(m)}{b(m)}\right)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>1</mn></msub><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{C_{1}}{b(t)}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum_{m=\tau}^{t}\left(\frac{a(m)}{b(m)}\right)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E11.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+C_{4}\sum_{m=\tau}^{t}b(m)+C_{5}\sum_{m=\tau}^{t}\frac{a(m)^{2}}{b(m)}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>C</mi><mn>4</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+C_{4}\sum_{m=\tau}^{t}b(m)+C_{5}\sum_{m=\tau}^{t}\frac{a(m)^{2}}{b(m)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SSx6.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx6.p2.1" class="ltx_p">Using the step-sizes:</p>
<table id="A1.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex94.m1" class="ltx_Math" alttext="a(t)=(1+t)^{-\sigma},\quad b(t)=(1+t)^{-\nu},\quad 0&lt;\nu&lt;\sigma&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>σ</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>ν</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mn>0</mn><mo>&lt;</mo><mi>ν</mi><mo>&lt;</mo><mi>σ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a(t)=(1+t)^{-\sigma},\quad b(t)=(1+t)^{-\nu},\quad 0&lt;\nu&lt;\sigma&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SSx6.p2.2" class="ltx_p">in <a href="#A1.E11" title="In A.6 Combining All Terms and Detailed Resolution ‣ Appendix A Appendix: Finite-Time Analysis of NSF1 and GSF1 ‣ Finite-time analysis of Multi-timescale Stochastic Optimization Algorithms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, we get,</p>
</div>
<div id="A1.SSx6.p3" class="ltx_para ltx_noindent">
<table id="A1.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex95.m1" class="ltx_Math" alttext="\displaystyle F(t)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex95.m2" class="ltx_Math" alttext="\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex96.m1" class="ltx_math_unparsed" alttext="\displaystyle+C_{4}\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}+C_{5}\sum\limits_{t=\tau}^{t}(1+t)^{(\nu-2\sigma)}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>C</mi><mn>4</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+C_{4}\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}+C_{5}\sum\limits_{t=\tau}^{t}(1+t)^{(\nu-2\sigma)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx6.p4" class="ltx_para ltx_noindent">
<p id="A1.SSx6.p4.1" class="ltx_p">Now observe that,</p>
</div>
<div id="A1.SSx6.p5" class="ltx_para ltx_noindent">
<table id="A1.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex97.m1" class="ltx_Math" alttext="0&lt;\nu&lt;\sigma&lt;1\implies(1+t)^{2\nu}&lt;(1+t)^{2\sigma}\implies(1+t)^{\nu}&lt;(1+t)^{2\sigma-\nu}\implies(1+t)^{\nu-2\sigma}&lt;(1+t)^{-v}." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mi>ν</mi><mo>&lt;</mo><mi>σ</mi><mo>&lt;</mo><mn>1</mn><mo stretchy="false">⟹</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msup><mo>&lt;</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></msup><mo stretchy="false">⟹</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup><mo>&lt;</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">⟹</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>ν</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow></msup><mo>&lt;</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>v</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;\nu&lt;\sigma&lt;1\implies(1+t)^{2\nu}&lt;(1+t)^{2\sigma}\implies(1+t)^{\nu}&lt;(1+t)^{2\sigma-\nu}\implies(1+t)^{\nu-2\sigma}&lt;(1+t)^{-v}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx6.p6" class="ltx_para ltx_noindent">
<p id="A1.SSx6.p6.1" class="ltx_p">Using this, we obtain,</p>
</div>
<div id="A1.SSx6.p7" class="ltx_para ltx_noindent">
<table id="A1.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex98.m1" class="ltx_Math" alttext="\displaystyle F(t)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex98.m2" class="ltx_Math" alttext="\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex99.m1" class="ltx_math_unparsed" alttext="\displaystyle+(C_{4}+C_{5})\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+(C_{4}+C_{5})\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx6.p8" class="ltx_para ltx_noindent">
<p id="A1.SSx6.p8.1" class="ltx_p">Observe the term, <math id="A1.SSx6.p8.m1" class="ltx_Math" alttext="\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}</annotation></semantics></math>
<math id="A1.SSx6.p8.m2" class="ltx_Math" alttext="\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}=\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{2(\sigma-\nu)}}" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}=\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{2(\sigma-\nu)}}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Let <math id="A1.SSx6.p8.m3" class="ltx_Math" alttext="n=2(\sigma-\nu)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n=2(\sigma-\nu)</annotation></semantics></math>, then <math id="A1.SSx6.p8.m4" class="ltx_Math" alttext="n&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n&gt;0</annotation></semantics></math> as <math id="A1.SSx6.p8.m5" class="ltx_Math" alttext="\sigma&gt;\nu" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>&gt;</mo><mi>ν</mi></mrow><annotation encoding="application/x-tex">\sigma&gt;\nu</annotation></semantics></math>.

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m6" class="ltx_Math" alttext="\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{n}}\leq\sum\limits_{t=0}^{t-\tau}\frac{1}{(1+t)^{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{n}}\leq\sum\limits_{t=0}^{t-\tau}\frac{1}{(1+t)^{n}},</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx6.p8.m7" class="ltx_Math" alttext="\sum\limits_{t=0}^{t-\tau}\frac{1}{(1+t)^{n}}\leq\int_{0}^{t-\tau}\frac{1}{(1+t)^{n}}dt=[\frac{(1+t)^{1-n}}{1-n}]_{0}^{t-\tau}=[\frac{(1+t-\tau)^{1-n}-1}{1-n}]" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">[</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></mfrac><mo stretchy="false">]</mo></mrow><mn>0</mn><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{t=0}^{t-\tau}\frac{1}{(1+t)^{n}}\leq\int_{0}^{t-\tau}\frac{1}{(1+t)^{n}}dt=[\frac{(1+t)^{1-n}}{1-n}]_{0}^{t-\tau}=[\frac{(1+t-\tau)^{1-n}-1}{1-n}]</annotation></semantics></math>

<br class="ltx_break">Assuming <math id="A1.SSx6.p8.m8" class="ltx_Math" alttext="1-n&gt;0\implies 2(\sigma-\nu)&lt;1\implies(\sigma-\nu)&lt;\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow><mo>&gt;</mo><mn>0</mn><mo stretchy="false">⟹</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn><mo stretchy="false">⟹</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">1-n&gt;0\implies 2(\sigma-\nu)&lt;1\implies(\sigma-\nu)&lt;\frac{1}{2}</annotation></semantics></math>, we get,

<br class="ltx_break"><math id="A1.SSx6.p8.m9" class="ltx_Math" alttext="\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{n}}\leq[\frac{(1+t-\tau)^{1-n}}{1-n}]" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac></mrow><mo>≤</mo><mrow><mo stretchy="false">[</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><mi>n</mi></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{t=\tau}^{t}\frac{1}{(1+t)^{n}}\leq[\frac{(1+t-\tau)^{1-n}}{1-n}]</annotation></semantics></math>,

<br class="ltx_break">Finally we get,
<math id="A1.SSx6.p8.m10" class="ltx_Math" alttext="\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}\leq[\frac{(1+t-\tau)^{1-2(\sigma-\nu)}}{1-2(\sigma-\nu)}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ν</mi><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>≤</mo><mrow><mo stretchy="false">[</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum\limits_{t=\tau}^{t}(1+t)^{2(\nu-\sigma)}\leq[\frac{(1+t-\tau)^{1-2(\sigma-\nu)}}{1-2(\sigma-\nu)}].</annotation></semantics></math>

<br class="ltx_break">Substituting this back in <a href="#A1.E11" title="In A.6 Combining All Terms and Detailed Resolution ‣ Appendix A Appendix: Finite-Time Analysis of NSF1 and GSF1 ‣ Finite-time analysis of Multi-timescale Stochastic Optimization Algorithms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, we get,</p>
<table id="A1.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex100.m1" class="ltx_Math" alttext="\displaystyle F(t)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex100.m2" class="ltx_Math" alttext="\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-\nu)}}{1-2(\sigma-\nu)}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{1}(1+t)^{\nu}+C_{2}\sqrt{F(t)}+C_{3}\sqrt{F(t)}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-\nu)}}{1-2(\sigma-\nu)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex101.m1" class="ltx_math_unparsed" alttext="\displaystyle+(C_{4}+C_{5})\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+(C_{4}+C_{5})\sum\limits_{t=\tau}^{t}(1+t)^{-\nu}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<br class="ltx_break">
<p id="A1.SSx6.p8.2" class="ltx_p">Let, 
<br class="ltx_break"><math id="A1.SSx6.p8.m11" class="ltx_Math" alttext="A(t)\coloneq C_{1}(1+t)^{\nu}+(C_{4}+C_{5})(\sum\limits_{m=\tau}^{t}(1+m)^{-\nu})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>ν</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A(t)\coloneq C_{1}(1+t)^{\nu}+(C_{4}+C_{5})(\sum\limits_{m=\tau}^{t}(1+m)^{-\nu})</annotation></semantics></math>,

<br class="ltx_break"><math id="A1.SSx6.p8.m12" class="ltx_Math" alttext="H(t)\coloneq[C_{2}+C_{3}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-v)}}{1-2(\sigma-\nu)}}]^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></msqrt></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">H(t)\coloneq[C_{2}+C_{3}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-v)}}{1-2(\sigma-\nu)}}]^{2}</annotation></semantics></math> ,and <math id="A1.SSx6.p8.m13" class="ltx_Math" alttext="B\coloneq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≔</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">B\coloneq\frac{1}{2}</annotation></semantics></math>.

<br class="ltx_break">
<br class="ltx_break">Then can then be rewritten as ,

<br class="ltx_break"><math id="A1.SSx6.p8.m14" class="ltx_Math" alttext="F(t)\leq A(t)+2B\sqrt{H(t)}\sqrt{F(t)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)\leq A(t)+2B\sqrt{H(t)}\sqrt{F(t)},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m15" class="ltx_Math" alttext="F(t)-2B\sqrt{H(t)}\sqrt{F(t)}\leq A(t)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)-2B\sqrt{H(t)}\sqrt{F(t)}\leq A(t),</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m16" class="ltx_Math" alttext="F(t)-2B\sqrt{H(t)}\sqrt{F(t)}+B^{2}H(t)\leq A(t)+B^{2}H(t)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>+</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)-2B\sqrt{H(t)}\sqrt{F(t)}+B^{2}H(t)\leq A(t)+B^{2}H(t),</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m17" class="ltx_Math" alttext="\sqrt{F(t)}-B\sqrt{H(t)}\leq\sqrt{A(t)}+\sqrt{B^{2}H(t)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>−</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><msqrt><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sqrt{F(t)}-B\sqrt{H(t)}\leq\sqrt{A(t)}+\sqrt{B^{2}H(t)},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m18" class="ltx_Math" alttext="\sqrt{F(t)}\leq\sqrt{A(t)}+2\sqrt{B^{2}H(t)}," display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>≤</mo><mrow><msqrt><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sqrt{F(t)}\leq\sqrt{A(t)}+2\sqrt{B^{2}H(t)},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m19" class="ltx_Math" alttext="F(t)\leq 2A(t)+4B^{2}H(t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(t)\leq 2A(t)+4B^{2}H(t).</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Therefore,
<math id="A1.SSx6.p8.m20" class="ltx_Math" alttext="F(t)\leq 2C_{1}(1+t)^{\nu}+2(C_{4}+C_{5})(\frac{(1+t-\tau)^{1-\nu}}{1-\nu})+[C_{2}+C_{3}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-v)}}{1-2(\sigma-\nu)}}]^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></msqrt></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq 2C_{1}(1+t)^{\nu}+2(C_{4}+C_{5})(\frac{(1+t-\tau)^{1-\nu}}{1-\nu})+[C_{2}+C_{3}\sqrt{\frac{(1+t-\tau)^{1-2(\sigma-v)}}{1-2(\sigma-\nu)}}]^{2}</annotation></semantics></math>

<br class="ltx_break">Now,

<br class="ltx_break"><math id="A1.SSx6.p8.m21" class="ltx_Math" alttext="F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}((1+t-\tau)^{1-\nu})+C_{2}^{2}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{1-2(\sigma-v)}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{\frac{1-2(\sigma-\nu)}{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><msubsup><mi>C</mi><mn>3</mn><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}((1+t-\tau)^{1-\nu})+C_{2}^{2}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{1-2(\sigma-v)}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{\frac{1-2(\sigma-\nu)}{2}},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m22" class="ltx_Math" alttext="F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+C_{2}^{2}(1+t-\tau)^{1-2(\sigma-v)}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{({1-2(\sigma-v)})}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{\frac{1-2(\sigma-\nu)}{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup></mrow><mo>+</mo><mrow><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>C</mi><mn>3</mn><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+C_{2}^{2}(1+t-\tau)^{1-2(\sigma-v)}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{({1-2(\sigma-v)})}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{\frac{1-2(\sigma-\nu)}{2}},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m23" class="ltx_Math" alttext="F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+C_{2}^{2}(1+t-\tau)^{1-2(\sigma-v)}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{({1-2(\sigma-v)})}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{1-2(\sigma-\nu)}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup></mrow><mo>+</mo><mrow><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>C</mi><mn>3</mn><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+C_{2}^{2}(1+t-\tau)^{1-2(\sigma-v)}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}(1+t-\tau)^{({1-2(\sigma-v)})}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}(1+t-\tau)^{1-2(\sigma-\nu)},</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx6.p8.m24" class="ltx_Math" alttext="F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+[C_{2}^{2}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}](1+t-\tau)^{1-2(\sigma-\nu)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>ν</mi></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>+</mo><msub><mi>C</mi><mn>5</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mfrac><msubsup><mi>C</mi><mn>3</mn><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>3</mn></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mfrac></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq 2C_{1}(1+t)^{\nu}+\frac{2(C_{4}+C_{5})}{1-\nu}(1+t-\tau)^{1-\nu}+[C_{2}^{2}+\frac{C_{3}^{2}}{1-2(\sigma-\nu)}+\frac{2C_{2}C_{3}}{\sqrt{1-2(\sigma-\nu)}}](1+t-\tau)^{1-2(\sigma-\nu)}</annotation></semantics></math>.</p>
</div>
<section id="A1.SSx6.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Final Result</h4>

<div id="A1.SSx6.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx6.SSS0.Px1.p1.1" class="ltx_p">Therefore,</p>
<table id="A1.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex102.m1" class="ltx_Math" alttext="F(t)=O(t^{\nu})+O(t^{1-\nu})+O(t^{1-2(\sigma-\nu)})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mi>ν</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(t)=O(t^{\nu})+O(t^{1-\nu})+O(t^{1-2(\sigma-\nu)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx6.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx6.SSS0.Px1.p2.1" class="ltx_p">which matches the bound stated in Theorem 1.</p>
</div>
</section>
</section>
<section id="A1.SSx7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">A.7 Proof of Theorem 2: Gradient Convergence for NSF1</h3>

<div id="A1.SSx7.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p1.1" class="ltx_p">We now derive a finite-time bound on</p>
<table id="A1.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex103.m1" class="ltx_Math" alttext="G(t):=\sum_{m=\tau}^{t}\mathbb{E}\|\nabla J(\theta(m))\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G(t):=\sum_{m=\tau}^{t}\mathbb{E}\|\nabla J(\theta(m))\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p2.1" class="ltx_p">From Lipschitz continuity of the gradient (Lemma 1),</p>
<table id="A1.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex104.m1" class="ltx_math_unparsed" alttext="J(\theta(m+1))\leq J(\theta(m))+\nabla J(\theta(m))^{T}(\theta(m+1)-\theta(m))+\frac{L_{G}}{2}\|\theta(m+1)-\theta(m)\|^{2}." display="block" intent=":literal"><semantics><mrow><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mo rspace="0.167em">∇</mo><mi>J</mi><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mfrac><msub><mi>L</mi><mi>G</mi></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0.167em">∥</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">J(\theta(m+1))\leq J(\theta(m))+\nabla J(\theta(m))^{T}(\theta(m+1)-\theta(m))+\frac{L_{G}}{2}\|\theta(m+1)-\theta(m)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p3" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p3.1" class="ltx_p">From the update:</p>
<table id="A1.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex105.m1" class="ltx_Math" alttext="\theta(m+1)=\theta(m)-a(m)M(m)z(m)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta(m+1)=\theta(m)-a(m)M(m)z(m),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p4" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p4.1" class="ltx_p">we get:</p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex106.m1" class="ltx_Math" alttext="\displaystyle J(\theta(m+1))" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J(\theta(m+1))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex106.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq J(\theta(m))-a(m)\nabla J(\theta(m))^{T}M(m)z(m)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>J</mi><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq J(\theta(m))-a(m)\nabla J(\theta(m))^{T}M(m)z(m)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex107.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{L_{G}}{2}a(m)^{2}\|M(m)z(m)\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>L</mi><mi>G</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{L_{G}}{2}a(m)^{2}\|M(m)z(m)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p5" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p5.1" class="ltx_p">We write:</p>
<table id="A1.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex108.m1" class="ltx_math_unparsed" alttext="M(m)z(m)=M^{*}(m)\nabla J(\theta(m))+(M(m)-M^{*}(m))z(m)+M^{*}(m)(z(m)-\nabla J(\theta(m)))." display="block" intent=":literal"><semantics><mrow><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M(m)z(m)=M^{*}(m)\nabla J(\theta(m))+(M(m)-M^{*}(m))z(m)+M^{*}(m)(z(m)-\nabla J(\theta(m))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p6" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p6.1" class="ltx_p">Substituting:</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex109.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla J^{T}Mz" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>J</mi><msup><mrow></mrow><mi>T</mi></msup><mi>M</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle\nabla J^{T}Mz</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex109.m2" class="ltx_math_unparsed" alttext="\displaystyle=\nabla J^{T}M^{*}\nabla J+\nabla J^{T}(M-M^{*})z" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo rspace="0.167em">∇</mo><msup><mi>J</mi><mi>T</mi></msup><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>J</mi><mo>+</mo><mo rspace="0.167em">∇</mo><msup><mi>J</mi><mi>T</mi></msup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\nabla J^{T}M^{*}\nabla J+\nabla J^{T}(M-M^{*})z</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex110.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\nabla J^{T}M^{*}(z-\nabla J)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo rspace="0.167em">∇</mo><msup><mi>J</mi><mi>T</mi></msup><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>−</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\nabla J^{T}M^{*}(z-\nabla J).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p7" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p7.1" class="ltx_p">Since <math id="A1.SSx7.p7.m1" class="ltx_Math" alttext="M^{*}(m)" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M^{*}(m)</annotation></semantics></math> is uniformly positive definite (A4),</p>
<table id="A1.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex111.m1" class="ltx_math_unparsed" alttext="\nabla J(\theta(m))^{T}M^{*}(m)\nabla J(\theta(m))\geq\lambda_{c}\|\nabla J(\theta(m))\|^{2}." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>J</mi><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≥</mo><msub><mi>λ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\nabla J(\theta(m))^{T}M^{*}(m)\nabla J(\theta(m))\geq\lambda_{c}\|\nabla J(\theta(m))\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p8" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p8.1" class="ltx_p">Substitute into recursion, thus,</p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex112.m1" class="ltx_Math" alttext="\displaystyle J(\theta(m+1))" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J(\theta(m+1))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex112.m2" class="ltx_Math" alttext="\displaystyle\leq J(\theta(m))-a(m)\lambda_{c}\|\nabla J(\theta(m))\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq J(\theta(m))-a(m)\lambda_{c}\|\nabla J(\theta(m))\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex113.m1" class="ltx_Math" alttext="\displaystyle\quad+a(m)\|\nabla J(\theta(m))\|\|(M-M^{*})z\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+a(m)\|\nabla J(\theta(m))\|\|(M-M^{*})z\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex114.m1" class="ltx_Math" alttext="\displaystyle\quad+a(m)\|\nabla J(\theta(m))\|\|M^{*}(z-\nabla J)\|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+a(m)\|\nabla J(\theta(m))\|\|M^{*}(z-\nabla J)\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{L_{G}}{2}a(m)^{2}\|M(m)z(m)\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>L</mi><mi>G</mi></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{L_{G}}{2}a(m)^{2}\|M(m)z(m)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p9" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p9.1" class="ltx_p">Taking expectation and rearranging terms, we get,</p>
</div>
<div id="A1.SSx7.p10" class="ltx_para ltx_noindent">
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex115.m1" class="ltx_Math" alttext="\displaystyle\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex115.m2" class="ltx_Math" alttext="\displaystyle\sum\limits_{m=\tau}^{t}E[\frac{1}{a(m)\lambda_{c}}(J(\theta(m))-J(\theta(m+1)))]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>c</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum\limits_{m=\tau}^{t}E[\frac{1}{a(m)\lambda_{c}}(J(\theta(m))-J(\theta(m+1)))]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex116.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m)),-[M(m)-M^{*}(m)]z(m)\rangle]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac></mstyle><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m)),-[M(m)-M^{*}(m)]z(m)\rangle]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m)),-[M^{*}(m)][z(m)-z^{*}(m)]\rangle]+\sum\limits_{m=\tau}^{t}E[\frac{La(m)}{2\lambda_{c}}||M(m)z(m)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac></mstyle><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">[</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>z</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>c</mi></msub></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m)),-[M^{*}(m)][z(m)-z^{*}(m)]\rangle]+\sum\limits_{m=\tau}^{t}E[\frac{La(m)}{2\lambda_{c}}||M(m)z(m)||^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx7.p11" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p11.1" class="ltx_p">Now bounding each of the term in the RHS, we get,</p>
</div>
<div id="A1.SSx7.p12" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p12.1" class="ltx_p"><span id="A1.SSx7.p12.1.1" class="ltx_text ltx_underline ltx_font_bold">Term 1:-</span>

<br class="ltx_break"><math id="A1.SSx7.p12.m1" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[\frac{J(\theta(m)-J(\theta(m+1)}{a(m)\lambda_{c}}]" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>c</mi></msub></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[\frac{J(\theta(m)-J(\theta(m+1)}{a(m)\lambda_{c}}]</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m2" class="ltx_Math" alttext="=\frac{1}{\lambda_{c}}E[\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">=\frac{1}{\lambda_{c}}E[\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}]</annotation></semantics></math>.

<br class="ltx_break">
<br class="ltx_break">Now consider,
<math id="A1.SSx7.p12.m3" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m4" class="ltx_Math" alttext="=\frac{J(\theta(\tau))-J(\theta(\tau+1))}{a(\tau)}+\frac{J(\theta(\tau+1))-J(\theta(\tau+2))}{a(\tau+1)}+...+\frac{J(\theta(t))-J(\theta(t+1))}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mfrac><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">=\frac{J(\theta(\tau))-J(\theta(\tau+1))}{a(\tau)}+\frac{J(\theta(\tau+1))-J(\theta(\tau+2))}{a(\tau+1)}+...+\frac{J(\theta(t))-J(\theta(t+1))}{a(t)}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m5" class="ltx_Math" alttext="=\frac{J(\theta(\tau))}{a(\tau)}+J(\theta(\tau+1))[\frac{1}{a(\tau+1)}-\frac{1}{a(\tau)}]+...+J(\theta(t))[\frac{1}{a(t)}-\frac{1}{a(t-1)}]-\frac{J(\theta(t+1)}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">=\frac{J(\theta(\tau))}{a(\tau)}+J(\theta(\tau+1))[\frac{1}{a(\tau+1)}-\frac{1}{a(\tau)}]+...+J(\theta(t))[\frac{1}{a(t)}-\frac{1}{a(t-1)}]-\frac{J(\theta(t+1)}{a(t)}</annotation></semantics></math>,

<br class="ltx_break"><math id="A1.SSx7.p12.m6" class="ltx_Math" alttext="=\frac{J(\theta(\tau))}{a(\tau)}+\sum\limits_{m=\tau}^{t}J(\theta(m))[\frac{1}{a(m)}-\frac{1}{a(m-1}]-\frac{J(\theta(t+1)}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">=\frac{J(\theta(\tau))}{a(\tau)}+\sum\limits_{m=\tau}^{t}J(\theta(m))[\frac{1}{a(m)}-\frac{1}{a(m-1}]-\frac{J(\theta(t+1)}{a(t)}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m7" class="ltx_Math" alttext="\leq R[\frac{1}{a(\tau)}+\frac{1}{a(\tau+1)}-\frac{1}{a(\tau)}+\frac{1}{a(\tau+2)}-\frac{1}{a(\tau+1)}+...+\frac{1}{a(t)}-\frac{1}{a(t+1)}+\frac{1}{a(t)}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq R[\frac{1}{a(\tau)}+\frac{1}{a(\tau+1)}-\frac{1}{a(\tau)}+\frac{1}{a(\tau+2)}-\frac{1}{a(\tau+1)}+...+\frac{1}{a(t)}-\frac{1}{a(t+1)}+\frac{1}{a(t)}]</annotation></semantics></math>

<br class="ltx_break">(using <math id="A1.SSx7.p12.m8" class="ltx_math_unparsed" alttext="|J(\theta(m)|\leq R" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">|J(\theta(m)|\leq R</annotation></semantics></math>, from continuity of J and compactness of parameter space.)

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m9" class="ltx_Math" alttext="=\frac{2R}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">=\frac{2R}{a(t)}</annotation></semantics></math>.

<br class="ltx_break">Therefore, <math id="A1.SSx7.p12.m10" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}\leq\frac{2R}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}\frac{J(\theta(m)-J(\theta(m+1)}{a(m)}\leq\frac{2R}{a(t)}</annotation></semantics></math>.

<br class="ltx_break">
<br class="ltx_break">Thus,
<math id="A1.SSx7.p12.m11" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[\frac{J(\theta(m)-J(\theta(m+1)}{a(m)\lambda_{c}}]\leq\frac{C_{1}}{a(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>c</mi></msub></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><msub><mi>C</mi><mn>1</mn></msub><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[\frac{J(\theta(m)-J(\theta(m+1)}{a(m)\lambda_{c}}]\leq\frac{C_{1}}{a(t)}</annotation></semantics></math>,

<br class="ltx_break">where <math id="A1.SSx7.p12.m12" class="ltx_Math" alttext="C_{1}=\frac{2R}{\lambda_{c}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><msub><mi>λ</mi><mi>c</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">C_{1}=\frac{2R}{\lambda_{c}}</annotation></semantics></math>.

<br class="ltx_break"><span id="A1.SSx7.p12.1.2" class="ltx_text ltx_underline ltx_font_bold">Term 2:-</span>

<br class="ltx_break"><math id="A1.SSx7.p12.m13" class="ltx_math_unparsed" alttext="\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m),-[M(m)-M^{*}(m)]z(m)\rangle]" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mi>E</mi><mrow><mo stretchy="false">[</mo><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[\frac{1}{\lambda_{c}}\langle\nabla J(\theta(m),-[M(m)-M^{*}(m)]z(m)\rangle]</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m14" class="ltx_math_unparsed" alttext="=\sum\limits_{m=\tau}^{t}\frac{1}{\lambda_{c}}E[\langle\nabla J(\theta(m),-[M(m)-M^{*}(m)]z(m)\rangle]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mi>E</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>M</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">=\sum\limits_{m=\tau}^{t}\frac{1}{\lambda_{c}}E[\langle\nabla J(\theta(m),-[M(m)-M^{*}(m)]z(m)\rangle]</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m15" class="ltx_Math" alttext="\leq\frac{1}{\lambda_{c}}\sum\limits_{m=\tau}^{t}\sqrt{E[||\nabla J(\theta(m))||^{2}]}\sqrt{E[||[M(m)-M^{*}(m)]z(m)||^{2}]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><msqrt><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{1}{\lambda_{c}}\sum\limits_{m=\tau}^{t}\sqrt{E[||\nabla J(\theta(m))||^{2}]}\sqrt{E[||[M(m)-M^{*}(m)]z(m)||^{2}]}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m16" class="ltx_Math" alttext="\leq\frac{1}{\lambda_{c}}\sum\limits_{m=\tau}^{t}\sqrt{E[||\nabla J(\theta(m))||^{2}]}\sqrt{E[||M(m)-M^{*}(m)||^{2}_{2}||z(m)||^{2}]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mn>1</mn><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><msqrt><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{1}{\lambda_{c}}\sum\limits_{m=\tau}^{t}\sqrt{E[||\nabla J(\theta(m))||^{2}]}\sqrt{E[||M(m)-M^{*}(m)||^{2}_{2}||z(m)||^{2}]}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m17" class="ltx_Math" alttext="\leq\frac{C_{G}}{\lambda_{c}}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}_{2}]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><msub><mi>C</mi><mi>G</mi></msub><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{C_{G}}{\lambda_{c}}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}_{2}]}</annotation></semantics></math>,

