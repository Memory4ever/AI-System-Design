<br class="ltx_break">where <math id="A1.SSx7.p12.m27" class="ltx_Math" alttext="C_{3}=\frac{C_{H}}{\lambda_{c}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><mfrac><msub><mi>C</mi><mi>H</mi></msub><msub><mi>λ</mi><mi>c</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">C_{3}=\frac{C_{H}}{\lambda_{c}}</annotation></semantics></math>.

<br class="ltx_break"><span id="A1.SSx7.p12.1.4" class="ltx_text ltx_underline ltx_font_bold">Term 4:-</span>

<br class="ltx_break"><math id="A1.SSx7.p12.m28" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[\frac{La(m)}{\lambda_{c}}||M(m)z(m)||^{2}]" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[\frac{La(m)}{\lambda_{c}}||M(m)z(m)||^{2}]</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m29" class="ltx_Math" alttext="=\frac{L}{\lambda_{c}}\sum\limits_{m=\tau}^{t}E[a(m)||M(m)z(m)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mi>L</mi><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">=\frac{L}{\lambda_{c}}\sum\limits_{m=\tau}^{t}E[a(m)||M(m)z(m)||^{2}]</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m30" class="ltx_Math" alttext="=\frac{L}{\lambda_{c}}\sum\limits_{m=\tau}^{t}a(m)E[||M(m)z(m)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mi>L</mi><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">=\frac{L}{\lambda_{c}}\sum\limits_{m=\tau}^{t}a(m)E[||M(m)z(m)||^{2}]</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m31" class="ltx_Math" alttext="\leq\frac{L}{\lambda_{c}}\sum\limits a(m)E[||M(m)||_{F}^{2}||z(m)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mi>L</mi><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{L}{\lambda_{c}}\sum\limits a(m)E[||M(m)||_{F}^{2}||z(m)||^{2}]</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m32" class="ltx_Math" alttext="\leq\frac{LC_{H}C_{G}}{\lambda_{c}}\sum\limits_{m=\tau}^{t}a(m)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>G</mi></msub></mrow><msub><mi>λ</mi><mi>c</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq\frac{LC_{H}C_{G}}{\lambda_{c}}\sum\limits_{m=\tau}^{t}a(m)</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m33" class="ltx_Math" alttext="=C_{4}\sum\limits_{m=\tau}^{t}a(m)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">=C_{4}\sum\limits_{m=\tau}^{t}a(m)</annotation></semantics></math>.

<br class="ltx_break">where, <math id="A1.SSx7.p12.m34" class="ltx_Math" alttext="C_{4}=\frac{LC_{H}C_{G}}{\lambda_{c}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>=</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>G</mi></msub></mrow><msub><mi>λ</mi><mi>c</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">C_{4}=\frac{LC_{H}C_{G}}{\lambda_{c}}</annotation></semantics></math>.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A1.SSx7.p13" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p13.1" class="ltx_p">Combining all the bounds obtained, we get,

<br class="ltx_break"><math id="A1.SSx7.p13.m1" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq\frac{C_{1}}{a(t)}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><msub><mi>C</mi><mn>1</mn></msub><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq\frac{C_{1}}{a(t)}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m2" class="ltx_Math" alttext="C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+C_{4}\sum\limits_{m=\tau}^{t}a(m)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+C_{4}\sum\limits_{m=\tau}^{t}a(m)</annotation></semantics></math>.

<br class="ltx_break">
<br class="ltx_break">Now substituting <math id="A1.SSx7.p13.m3" class="ltx_Math" alttext="a(t)=\frac{1}{(1+t)^{\sigma}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">a(t)=\frac{1}{(1+t)^{\sigma}}</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m4" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]=C_{1}(1+t)^{\sigma}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mo>+</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]=C_{1}(1+t)^{\sigma}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m5" class="ltx_Math" alttext="C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+C_{4}\sum\limits_{m=\tau}^{t}(1+m)^{-\sigma}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>σ</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+C_{4}\sum\limits_{m=\tau}^{t}(1+m)^{-\sigma}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Using the bound obtained while proving Theorem 1,

<br class="ltx_break"><math id="A1.SSx7.p13.m6" class="ltx_Math" alttext="\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq C_{1}(1+t)^{\sigma}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+" display="inline" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mo>+</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]\leq C_{1}(1+t)^{\sigma}+C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}+</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m7" class="ltx_Math" alttext="C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+\frac{C_{4}}{1-\sigma}(1+t-\tau)^{\sigma}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mfrac><msub><mi>C</mi><mn>4</mn></msub><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow></mrow><annotation encoding="application/x-tex">C_{3}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}+\frac{C_{4}}{1-\sigma}(1+t-\tau)^{\sigma}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Now dividing both the sides with <math id="A1.SSx7.p13.m8" class="ltx_Math" alttext="1+t-\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">1+t-\tau</annotation></semantics></math>, we get,

<br class="ltx_break"><math id="A1.SSx7.p13.m9" class="ltx_Math" alttext="\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}\leq\frac{C_{1}(1+t)^{\sigma}}{1+t-\tau}+C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>≤</mo><mrow><mfrac><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>+</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}\leq\frac{C_{1}(1+t)^{\sigma}}{1+t-\tau}+C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m10" class="ltx_Math" alttext="C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}+\frac{C_{4}}{(1-\sigma)(1+t-\tau)}(1+t-\tau)^{1-\sigma}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow><mo>+</mo><mrow><mfrac><msub><mi>C</mi><mn>4</mn></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}+\frac{C_{4}}{(1-\sigma)(1+t-\tau)}(1+t-\tau)^{1-\sigma}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Let <math id="A1.SSx7.p13.m11" class="ltx_Math" alttext="F(t)\coloneq\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(t)\coloneq\frac{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}{1+t-\tau},</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m12" class="ltx_Math" alttext="A(t)\coloneq\frac{C_{1}(1+t)^{\sigma}}{1+t-\tau}+\frac{C_{4}}{(1-\sigma)(1+t-\tau)}(1+t-\tau)^{1-\sigma}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mfrac><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>+</mo><mrow><mfrac><msub><mi>C</mi><mn>4</mn></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A(t)\coloneq\frac{C_{1}(1+t)^{\sigma}}{1+t-\tau}+\frac{C_{4}}{(1-\sigma)(1+t-\tau)}(1+t-\tau)^{1-\sigma},</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p13.m13" class="ltx_Math" alttext="Z(t)\coloneq[C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}]^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z(t)\coloneq[C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}]^{2},</annotation></semantics></math> and <math id="A1.SSx7.p13.m14" class="ltx_Math" alttext="B=\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">B=\frac{1}{2}</annotation></semantics></math>.

<br class="ltx_break">The above inequality can then be written as,

<br class="ltx_break"><math id="A1.SSx7.p13.m15" class="ltx_Math" alttext="F(t)\leq A(t)+2B\sqrt{F(t)}\sqrt{Z(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq A(t)+2B\sqrt{F(t)}\sqrt{Z(t)}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p13.m16" class="ltx_Math" alttext="(\sqrt{F(t)}-\sqrt{Z(t)})^{2}\leq A(t)+Z(t)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>−</mo><msqrt><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(\sqrt{F(t)}-\sqrt{Z(t)})^{2}\leq A(t)+Z(t)</annotation></semantics></math>,

<br class="ltx_break"></p>
</div>
<div id="A1.SSx7.p14" class="ltx_para ltx_noindent">
<p id="A1.SSx7.p14.1" class="ltx_p">Now using, if <math id="A1.SSx7.p14.m1" class="ltx_Math" alttext="a\leq b+c" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≤</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">a\leq b+c</annotation></semantics></math> and <math id="A1.SSx7.p14.m2" class="ltx_Math" alttext="a,b,c&gt;0\implies\sqrt{a}\leq\sqrt{b}+\sqrt{c}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">⟹</mo><msqrt><mi>a</mi></msqrt><mo>≤</mo><mrow><msqrt><mi>b</mi></msqrt><mo>+</mo><msqrt><mi>c</mi></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">a,b,c&gt;0\implies\sqrt{a}\leq\sqrt{b}+\sqrt{c}</annotation></semantics></math>, we get,

<br class="ltx_break"><math id="A1.SSx7.p14.m3" class="ltx_Math" alttext="\sqrt{F(t)}\leq\sqrt{A(t)}+2\sqrt{Z(t)}," display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>≤</mo><mrow><msqrt><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sqrt{F(t)}\leq\sqrt{A(t)}+2\sqrt{Z(t)},</annotation></semantics></math>

<br class="ltx_break">Using <math id="A1.SSx7.p14.m4" class="ltx_Math" alttext="a\leq(b+c)\implies a^{2}\leq 2(b^{2}+c^{2})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟹</mo><msup><mi>a</mi><mn>2</mn></msup><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo>+</mo><msup><mi>c</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\leq(b+c)\implies a^{2}\leq 2(b^{2}+c^{2})</annotation></semantics></math>, we get,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p14.m5" class="ltx_Math" alttext="F(t)\leq 2A(t)+8Z(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq 2A(t)+8Z(t)</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p14.m6" class="ltx_Math" alttext="F(t)\leq\frac{2C_{1}(1+t)^{\sigma}}{(1+t-\sigma)}+\frac{2C_{4}(1+t-\tau)^{1-\sigma}}{(1-\sigma)(1+t-\tau)}+8[C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}]^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></msqrt></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq\frac{2C_{1}(1+t)^{\sigma}}{(1+t-\sigma)}+\frac{2C_{4}(1+t-\tau)^{1-\sigma}}{(1-\sigma)(1+t-\tau)}+8[C_{2}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}}+C_{3}\sqrt{\frac{\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}}]^{2}</annotation></semantics></math>,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p14.m7" class="ltx_Math" alttext="F(t)\leq\frac{2C_{1}(1+t)^{\sigma}}{(1+t-\sigma)}+\frac{2C_{4}(1+t-\tau)^{1-\sigma}}{(1-\sigma)(1+t-\tau)}+\frac{16C_{2}^{2}\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}+\frac{16C_{2}^{2}\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>σ</mi></msup></mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>σ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq\frac{2C_{1}(1+t)^{\sigma}}{(1+t-\sigma)}+\frac{2C_{4}(1+t-\tau)^{1-\sigma}}{(1-\sigma)(1+t-\tau)}+\frac{16C_{2}^{2}\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}]}{1+t-\tau}+\frac{16C_{2}^{2}\sum\limits_{m=\tau}^{t}E[||z(m)-z^{*}(m)||^{2}]}{1+t-\tau}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">Now using the bounds on the gradient and hessian updates,

<br class="ltx_break"><math id="A1.SSx7.p14.m8" class="ltx_Math" alttext="F(t)\leq\mathcal{O}(t^{\sigma-1})+\mathcal{O}(t^{-\sigma})+\mathcal{O}(t^{\nu-1})+\mathcal{O}(t^{-\nu})+\mathcal{O}(t^{-2(\sigma-\nu)})+\mathcal{O}(t^{\alpha-1})+\mathcal{O}(t^{-\alpha})+\mathcal{O}(t^{-2(\sigma-\alpha)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mi>σ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>σ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mi>ν</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq\mathcal{O}(t^{\sigma-1})+\mathcal{O}(t^{-\sigma})+\mathcal{O}(t^{\nu-1})+\mathcal{O}(t^{-\nu})+\mathcal{O}(t^{-2(\sigma-\nu)})+\mathcal{O}(t^{\alpha-1})+\mathcal{O}(t^{-\alpha})+\mathcal{O}(t^{-2(\sigma-\alpha)})</annotation></semantics></math>

<br class="ltx_break">Using the condition on the step-sizes, we get,
<math id="A1.SSx7.p14.m9" class="ltx_Math" alttext="-\nu&gt;-\alpha&gt;-\sigma" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>ν</mi></mrow><mo>&gt;</mo><mrow><mo>−</mo><mi>α</mi></mrow><mo>&gt;</mo><mrow><mo>−</mo><mi>σ</mi></mrow></mrow><annotation encoding="application/x-tex">-\nu&gt;-\alpha&gt;-\sigma</annotation></semantics></math>, <math id="A1.SSx7.p14.m10" class="ltx_Math" alttext="\nu-1&gt;\alpha-1&gt;\sigma-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>−</mo><mn>1</mn></mrow><mo>&gt;</mo><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow><mo>&gt;</mo><mrow><mi>σ</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\nu-1&gt;\alpha-1&gt;\sigma-1</annotation></semantics></math>, and <math id="A1.SSx7.p14.m11" class="ltx_Math" alttext="-2(\sigma-\alpha)&gt;-2(\alpha-\nu)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>ν</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">-2(\sigma-\alpha)&gt;-2(\alpha-\nu)</annotation></semantics></math> therefore,

<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p14.m12" class="ltx_Math" alttext="F(t)\leq\mathcal{O}(t^{\sigma-1})+\mathcal{O}(t^{-\nu})+\mathcal{O}(t^{-2(\sigma-\alpha)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mi>σ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)\leq\mathcal{O}(t^{\sigma-1})+\mathcal{O}(t^{-\nu})+\mathcal{O}(t^{-2(\sigma-\alpha)})</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">Now using the fact that, <math id="A1.SSx7.p14.m13" class="ltx_Math" alttext="\min\limits_{0\leq m\leq T}a(m)\leq\frac{\sum\limits_{m=0}^{T}a(m))}{T+1}" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>min</mi><mrow><mn>0</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">\min\limits_{0\leq m\leq T}a(m)\leq\frac{\sum\limits_{m=0}^{T}a(m))}{T+1}</annotation></semantics></math>

<br class="ltx_break"><math id="A1.SSx7.p14.m14" class="ltx_Math" alttext="\min\limits_{0\leq t\leq T}E[||\nabla J(\theta(t))||^{2}]\leq\frac{\sum\limits_{m=0}^{T}E[||\nabla J(\theta(t))||^{2}]}{1+T}" display="inline" intent=":literal"><semantics><mrow><mrow><munder><mi>min</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><mstyle displaystyle="false"><munderover><mo maxsize="0.700em" minsize="0.700em" movablelimits="false" stretchy="true">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>T</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\min\limits_{0\leq t\leq T}E[||\nabla J(\theta(t))||^{2}]\leq\frac{\sum\limits_{m=0}^{T}E[||\nabla J(\theta(t))||^{2}]}{1+T}</annotation></semantics></math>

<br class="ltx_break">
<br class="ltx_break">And then using the bound obtained above proves Theorem 2,

<br class="ltx_break"></p>
<table id="A1.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex118.m1" class="ltx_Math" alttext="\min\limits_{0\leq t\leq T}E[||\nabla J(\theta(t))||^{2}]\leq\mathcal{O}(T^{\sigma-1})+\mathcal{O}(T^{-\nu})+\mathcal{O}(T^{-2(\sigma-\alpha)})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>T</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mi>σ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mi>ν</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min\limits_{0\leq t\leq T}E[||\nabla J(\theta(t))||^{2}]\leq\mathcal{O}(T^{\sigma-1})+\mathcal{O}(T^{-\nu})+\mathcal{O}(T^{-2(\sigma-\alpha)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<br class="ltx_break">
<br class="ltx_break">
</div>
</section>
<section id="A1.SSx8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">A.8 Proof of theorem 3: Gradient estimation error</h3>

<div id="A1.SSx8.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx8.p1.1" class="ltx_p">The proof structure of Theorem 3 is quite similar to that of Theorem 1, so we will mention just the major steps involved.

<br class="ltx_break">Define</p>
<table id="A1.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex119.m1" class="ltx_Math" alttext="\epsilon(m)=||z(m)-z^{*}(m)||," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon(m)=||z(m)-z^{*}(m)||,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SSx8.p1.2" class="ltx_p">where <math id="A1.SSx8.p1.m1" class="ltx_Math" alttext="z^{*}(m)=\nabla J(\theta(m))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z^{*}(m)=\nabla J(\theta(m))</annotation></semantics></math>.

<br class="ltx_break">From the update,</p>
</div>
<div id="A1.SSx8.p2" class="ltx_para ltx_noindent">
<table id="A1.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex120.m1" class="ltx_Math" alttext="z(m+1)=z(m)+b(m)\left[\frac{\eta_{i}(m)}{\beta}h(X_{m})-z(m)\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mfrac><mrow><msub><mi>η</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">z(m+1)=z(m)+b(m)\left[\frac{\eta_{i}(m)}{\beta}h(X_{m})-z(m)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SSx8.p2.1" class="ltx_p">The recursive relation of error is,</p>
</div>
<div id="A1.SSx8.p3" class="ltx_para ltx_noindent">
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex121.m1" class="ltx_Math" alttext="\displaystyle\epsilon(m)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon(m)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex121.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{2b(m)}\big(\epsilon(m)^{2}-\epsilon(m+1)^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2b(m)}\big(\epsilon(m)^{2}-\epsilon(m+1)^{2}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex122.m1" class="ltx_Math" alttext="\displaystyle\quad+\langle\epsilon(m),\xi(m)\rangle+\frac{1}{b(m)}\langle\epsilon(m),\Delta(m)\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\langle\epsilon(m),\xi(m)\rangle+\frac{1}{b(m)}\langle\epsilon(m),\Delta(m)\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex123.m1" class="ltx_Math" alttext="\displaystyle\quad+b(m)||\xi(m)||^{2}+\frac{1}{b(m)}||\Delta(m)||^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+b(m)||\xi(m)||^{2}+\frac{1}{b(m)}||\Delta(m)||^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx8.p4" class="ltx_para ltx_noindent">
<p id="A1.SSx8.p4.1" class="ltx_p">where, <math id="A1.SSx8.p4.m1" class="ltx_Math" alttext="\xi(m)=\frac{\eta_{i}(m)}{\beta}h(X_{m})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>η</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi(m)=\frac{\eta_{i}(m)}{\beta}h(X_{m})</annotation></semantics></math> and
<math id="A1.SSx8.p4.m2" class="ltx_Math" alttext="\Delta(m)=z^{*}(m)-z^{*}(m+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta(m)=z^{*}(m)-z^{*}(m+1)</annotation></semantics></math>.</p>
</div>
<div id="A1.SSx8.p5" class="ltx_para ltx_noindent">
<p id="A1.SSx8.p5.1" class="ltx_p">Let <math id="A1.SSx8.p5.m1" class="ltx_Math" alttext="F(t)=\sum\limits_{k=\tau}^{t}E[\epsilon(m)^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(t)=\sum\limits_{k=\tau}^{t}E[\epsilon(m)^{2}]</annotation></semantics></math>.
Now bounding all the terms on the RHS, we get the relation,</p>
</div>
<div id="A1.SSx8.p6" class="ltx_para ltx_noindent">
<table id="A1.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex124.m1" class="ltx_Math" alttext="\displaystyle F(t)\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F(t)\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex124.m2" class="ltx_Math" alttext="\displaystyle\frac{C_{1}}{2a(m)}+C_{2}\sqrt{F(t)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{C_{1}}{2a(m)}+C_{2}\sqrt{F(t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex125.m1" class="ltx_Math" alttext="\displaystyle+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{k=\tau}^{t}\frac{a(k)^{2}}{b(k)^{2}}}+C4(\sum\limits_{k=\tau}^{t}b(k)\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></msqrt></mrow></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+C_{3}\sqrt{F(t)}\sqrt{\sum\limits_{k=\tau}^{t}\frac{a(k)^{2}}{b(k)^{2}}}+C4(\sum\limits_{k=\tau}^{t}b(k)\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex126.m1" class="ltx_Math" alttext="\displaystyle+C_{5}(\sum\limits_{k=\tau}^{t}\frac{a(k)^{2}}{b(k)}\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+C_{5}(\sum\limits_{k=\tau}^{t}\frac{a(k)^{2}}{b(k)}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx8.p7" class="ltx_para ltx_noindent">
<p id="A1.SSx8.p7.1" class="ltx_p">Using the step-size <math id="A1.SSx8.p7.m1" class="ltx_Math" alttext="a(m)=\frac{1}{(1+m)^{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">a(m)=\frac{1}{(1+m)^{\alpha}}</annotation></semantics></math> and
<math id="A1.SSx8.p7.m2" class="ltx_Math" alttext="b(m)=\frac{1}{(1+m)^{\beta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mi>β</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">b(m)=\frac{1}{(1+m)^{\beta}}</annotation></semantics></math>,

<br class="ltx_break">where <math id="A1.SSx8.p7.m3" class="ltx_Math" alttext="0&lt;\alpha&lt;\beta&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>α</mi><mo>&lt;</mo><mi>β</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\alpha&lt;\beta&lt;1</annotation></semantics></math> and applying algebra similar to Theorem 1 we get,</p>
</div>
<div id="A1.SSx8.p8" class="ltx_para ltx_noindent">
<table id="A1.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex127.m1" class="ltx_Math" alttext="F(t)\leq\mathcal{O}(t^{\beta})+\mathcal{O}(t^{1-\beta})+\mathcal{O}(t^{1-2(\alpha-\beta)})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mi>β</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(t)\leq\mathcal{O}(t^{\beta})+\mathcal{O}(t^{1-\beta})+\mathcal{O}(t^{1-2(\alpha-\beta)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SSx9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">A.9 Proof of Theorem 4: Gradient Convergence for GSF1</h3>

<div id="A1.SSx9.p1" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p1.1" class="ltx_p">The proof structure of this theorem is also quite similar to Theorem 4, so here also we will be mentioning just the main steps involved.

<br class="ltx_break">We now derive a finite-time bound on</p>
<table id="A1.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex128.m1" class="ltx_Math" alttext="G(t):=\sum_{m=\tau}^{t}\mathbb{E}\|\nabla J(\theta(m))\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G(t):=\sum_{m=\tau}^{t}\mathbb{E}\|\nabla J(\theta(m))\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SSx9.p1.2" class="ltx_p">for GSF1.</p>
</div>
<div id="A1.SSx9.p2" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p2.1" class="ltx_p">From Lipschitz continuity of the gradient (Lemma 1),</p>
<table id="A1.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex129.m1" class="ltx_math_unparsed" alttext="J(\theta(m+1))\leq J(\theta(m))+\nabla J(\theta(m))^{T}(\theta(m+1)-\theta(m))+\frac{L_{G}}{2}\|\theta(m+1)-\theta(m)\|^{2}." display="block" intent=":literal"><semantics><mrow><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mo rspace="0.167em">∇</mo><mi>J</mi><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mfrac><msub><mi>L</mi><mi>G</mi></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0.167em">∥</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">J(\theta(m+1))\leq J(\theta(m))+\nabla J(\theta(m))^{T}(\theta(m+1)-\theta(m))+\frac{L_{G}}{2}\|\theta(m+1)-\theta(m)\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx9.p3" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p3.1" class="ltx_p">From the update:</p>
<table id="A1.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex130.m1" class="ltx_Math" alttext="\theta(m+1)=\theta(m)-a(m)z(m)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta(m+1)=\theta(m)-a(m)z(m),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<br class="ltx_break">
<p id="A1.SSx9.p3.2" class="ltx_p">Using Lipschitz continuity and update rule we get following relation,</p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex131.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo>≤</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex131.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m=\tau}^{t}E[\frac{J(\theta(k)-J(\theta(k+1)}{a(k)}]+\sum_{m=\tau}^{t}E[\langle\nabla J(\theta(k),z^{*}(k)-z(k)\rangle]]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[\frac{J(\theta(k)-J(\theta(k+1)}{a(k)}]+\sum_{m=\tau}^{t}E[\langle\nabla J(\theta(k),z^{*}(k)-z(k)\rangle]]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex132.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{m=\tau}^{t}E[\frac{L}{2}a(k)||z(k)||^{2}]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{m=\tau}^{t}E[\frac{L}{2}a(k)||z(k)||^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx9.p4" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p4.1" class="ltx_p">Bounding each term on the RHS, we get,

<br class="ltx_break"></p>
</div>
<div id="A1.SSx9.p5" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p5.1" class="ltx_p"><span id="A1.SSx9.p5.1.1" class="ltx_text ltx_underline ltx_font_bold">Term 1:-</span>
This is similar to the Term 1 of Theorem 2, using the telescopic sum argument, we get the bound.</p>
<table id="A1.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex133.m1" class="ltx_Math" alttext="\sum_{m=\tau}^{t}E[\frac{J(\theta(k)-J(\theta(k+1)}{a(k)}]\leq\frac{2C_{1}}{a(t)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mfrac><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{m=\tau}^{t}E[\frac{J(\theta(k)-J(\theta(k+1)}{a(k)}]\leq\frac{2C_{1}}{a(t)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx9.p6" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p6.1" class="ltx_p"><span id="A1.SSx9.p6.1.1" class="ltx_text ltx_underline ltx_font_bold">Term 2:-</span>

<br class="ltx_break"></p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex134.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m=\tau}^{t}E[\langle\nabla J(\theta(k),z^{*}(k)-z(k)\rangle]]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">⟨</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msup><mi>z</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[\langle\nabla J(\theta(k),z^{*}(k)-z(k)\rangle]]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex134.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{m=\tau}^{t}\sqrt{E||\nabla(J(\theta(k)||^{2}}*\sqrt{E||z^{*}(k)-z(k)||^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><msqrt><mrow><mi>E</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>∇</mo><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow><mo lspace="0.222em" rspace="0.222em">∗</mo><msqrt><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{m=\tau}^{t}\sqrt{E||\nabla(J(\theta(k)||^{2}}*\sqrt{E||z^{*}(k)-z(k)||^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex135.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\sum_{m=\tau}^{t}E||\nabla(J(\theta(k)||^{2}}\sqrt{\sum_{m=\tau}^{t}E||z^{*}(k)+z(k)||^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>E</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>∇</mo><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\sum_{m=\tau}^{t}E||\nabla(J(\theta(k)||^{2}}\sqrt{\sum_{m=\tau}^{t}E||z^{*}(k)+z(k)||^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx9.p7" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p7.1" class="ltx_p"><span id="A1.SSx9.p7.1.1" class="ltx_text ltx_underline ltx_font_bold">Term 3:-</span>

<br class="ltx_break">Using the boundedness of the gradient estimate, we get,</p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex136.m1" class="ltx_Math" alttext="\displaystyle\sum_{m=\tau}^{t}E[\frac{L}{2}a(k)||z(k)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[\frac{L}{2}a(k)||z(k)||^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex136.m2" class="ltx_Math" alttext="\displaystyle=\sum_{m=\tau}^{t}\frac{L}{2}a(k)E[||z(k)||^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{m=\tau}^{t}\frac{L}{2}a(k)E[||z(k)||^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex137.m1" class="ltx_Math" alttext="\displaystyle\leq C_{3}\sum_{m=\tau}^{t}a(k)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{3}\sum_{m=\tau}^{t}a(k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<br class="ltx_break">
<p id="A1.SSx9.p7.2" class="ltx_p">Now combining all the bounds obtained and applying steps similar to Theorem 2, we get,</p>
<table id="A1.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex138.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo>≤</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex138.m2" class="ltx_Math" alttext="\displaystyle 2C_{1}(1+t)^{\alpha}+\sqrt{\sum_{m=\tau}^{t}E||\nabla(J(\theta(k)||^{2}}\sqrt{\sum_{m=\tau}^{t}E||z^{*}(k)+z(k)||^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mrow><mo>+</mo><mrow><msqrt><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>E</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>∇</mo><mo stretchy="false">(</mo><mi>J</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2C_{1}(1+t)^{\alpha}+\sqrt{\sum_{m=\tau}^{t}E||\nabla(J(\theta(k)||^{2}}\sqrt{\sum_{m=\tau}^{t}E||z^{*}(k)+z(k)||^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex139.m1" class="ltx_Math" alttext="\displaystyle C_{3}\frac{(1+t-\tau)^{1-\alpha}}{1-\alpha}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msup><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{3}\frac{(1+t-\tau)^{1-\alpha}}{1-\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SSx9.p8" class="ltx_para ltx_noindent">
<p id="A1.SSx9.p8.1" class="ltx_p">Using completing the sum argument as done in Theorem 2, we get,</p>
<table id="A1.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex140.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq\mathcal{O}(t^{\alpha-1})+\mathcal{O}(t^{-\beta})+\mathcal{O}(t^{-2(\alpha-\beta)})." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover></mstyle><mi>E</mi><mrow><mo stretchy="false">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo>≤</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{m=\tau}^{t}E[||\nabla J(\theta(k)||^{2}]\leq\mathcal{O}(t^{\alpha-1})+\mathcal{O}(t^{-\beta})+\mathcal{O}(t^{-2(\alpha-\beta)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
