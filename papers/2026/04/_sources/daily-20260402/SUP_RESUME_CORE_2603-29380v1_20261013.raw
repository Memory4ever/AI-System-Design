<br class="ltx_break">
<br class="ltx_break"><math id="A1.SSx7.p12.m18" class="ltx_Math" alttext="=C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}_{2}]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>J</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mi>τ</mi></mrow><mi>t</mi></munderover><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">=C_{2}\sqrt{\sum\limits_{m=\tau}^{t}E[||\nabla J(\theta(m))||^{2}]}\sqrt{\sum\limits_{m=\tau}^{t}E[||M(m)-M^{*}(m)||^{2}_{2}]}</annotation></semantics></math>,

