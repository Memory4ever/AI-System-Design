<th id="Pt0.A2.T1.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="Pt0.A2.T1.4.1.4.1" class="ltx_text ltx_font_bold">Baseline to match</span></th>
