<td id="Pt0.A2.T1.4.3.2" class="ltx_td ltx_align_center ltx_border_t">5</td>
<td id="Pt0.A2.T1.4.3.3" class="ltx_td ltx_align_center ltx_border_t">88.2</td>
<td id="Pt0.A2.T1.4.3.4" class="ltx_td ltx_align_center ltx_border_t">25.9</td>
<td id="Pt0.A2.T1.4.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="Pt0.A2.T1.m6" class="ltx_Math" alttext="{&gt;}400^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><msup><mn>400</mn><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">{&gt;}400^{\dagger}</annotation></semantics></math></td>
<td id="Pt0.A2.T1.4.3.6" class="ltx_td ltx_align_center ltx_border_t">82.0</td>
<td id="Pt0.A2.T1.4.3.7" class="ltx_td ltx_align_center ltx_border_t">3.2<math id="Pt0.A2.T1.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
<tr id="Pt0.A2.T1.4.4" class="ltx_tr">
<td id="Pt0.A2.T1.4.4.1" class="ltx_td ltx_align_left">6</td>
<td id="Pt0.A2.T1.4.4.2" class="ltx_td ltx_align_center">5</td>
<td id="Pt0.A2.T1.4.4.3" class="ltx_td ltx_align_center">42.3</td>
<td id="Pt0.A2.T1.4.4.4" class="ltx_td ltx_align_center">25.9</td>
<td id="Pt0.A2.T1.4.4.5" class="ltx_td ltx_align_center">320</td>
