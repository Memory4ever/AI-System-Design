<td id="S6.T3.4.14.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T3.4.14.4.1" class="ltx_text ltx_font_bold">29.4</span></td>
