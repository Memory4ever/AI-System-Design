<td id="Pt0.A3.T1.8.3.3" class="ltx_td ltx_align_center">4–5</td>
<td id="Pt0.A3.T1.8.3.4" class="ltx_td ltx_align_center">6%</td>
<td id="Pt0.A3.T1.8.3.5" class="ltx_td ltx_align_center">25%</td>
<td id="Pt0.A3.T1.8.3.6" class="ltx_td ltx_align_left">lake entry (55%), wrong path (17%)</td></tr>
