<td id="S6.T1.1.1.3.3" class="ltx_td ltx_align_center" style="padding:0.2pt 4.0pt;"><span id="S6.T1.1.1.3.3.1" class="ltx_text" style="font-size:80%;">41.0</span></td>
<td id="S6.T1.1.1.3.4" class="ltx_td ltx_align_center" style="padding:0.2pt 4.0pt;"><span id="S6.T1.1.1.3.4.1" class="ltx_text" style="font-size:80%;">21.4</span></td>
