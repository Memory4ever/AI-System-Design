<tr id="Pt0.A1.T1.4.7" class="ltx_tr">
<th id="Pt0.A1.T1.4.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Denoising steps (<math id="Pt0.A1.T1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>)</th>
<td id="Pt0.A1.T1.4.7.2" class="ltx_td ltx_align_center">40</td>
<td id="Pt0.A1.T1.4.7.3" class="ltx_td ltx_align_center">8 (step-distilled)</td></tr>
