<td id="Pt0.A3.T1.8.4.3" class="ltx_td ltx_align_center">3–7</td>
<td id="Pt0.A3.T1.8.4.4" class="ltx_td ltx_align_center">69%</td>
<td id="Pt0.A3.T1.8.4.5" class="ltx_td ltx_align_center">100%</td>
<td id="Pt0.A3.T1.8.4.6" class="ltx_td ltx_align_left">lake entry (50%), gift mvmt. (25%)</td></tr>
