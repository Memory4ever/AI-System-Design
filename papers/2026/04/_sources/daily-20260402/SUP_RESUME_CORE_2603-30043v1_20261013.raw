<td id="S6.T1.1.1.4.2" class="ltx_td ltx_align_center" style="padding:0.2pt 4.0pt;"><span id="S6.T1.1.1.4.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#808080;">92.0</span></td>
<td id="S6.T1.1.1.4.3" class="ltx_td ltx_align_center" style="padding:0.2pt 4.0pt;"><span id="S6.T1.1.1.4.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#808080;">51.3</span></td>
<td id="S6.T1.1.1.4.4" class="ltx_td ltx_align_center" style="padding:0.2pt 4.0pt;"><span id="S6.T1.1.1.4.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#808080;">21.4</span></td>
