<th id="S6.T1.1.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding:0.2pt 4.0pt;"><math id="S6.SS1.m4" class="ltx_Math" alttext="10\times 10" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">10</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mn mathsize="0.800em">10</mn></mrow><annotation encoding="application/x-tex">10\times 10</annotation></semantics></math></th></tr>
