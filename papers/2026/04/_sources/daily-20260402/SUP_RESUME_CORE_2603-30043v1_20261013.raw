<td id="Pt0.A1.T1.4.5.3" class="ltx_td ltx_align_center">6.0</td></tr>
<tr id="Pt0.A1.T1.4.6" class="ltx_tr">
<th id="Pt0.A1.T1.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Scheduler</th>
