<td id="Pt0.A1.T1.4.4.2" class="ltx_td ltx_align_center">16</td>
<td id="Pt0.A1.T1.4.4.3" class="ltx_td ltx_align_center">24</td></tr>
<tr id="Pt0.A1.T1.4.5" class="ltx_tr">
