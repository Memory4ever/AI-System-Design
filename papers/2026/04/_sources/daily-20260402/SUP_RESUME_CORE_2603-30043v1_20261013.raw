<td id="Pt0.A1.T1.4.2.3" class="ltx_td ltx_align_center ltx_border_t">480p (<math id="Pt0.A1.T1.m2" class="ltx_Math" alttext="848\times 480" display="inline" intent=":literal"><semantics><mrow><mn>848</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>480</mn></mrow><annotation encoding="application/x-tex">848\times 480</annotation></semantics></math>)</td></tr>
