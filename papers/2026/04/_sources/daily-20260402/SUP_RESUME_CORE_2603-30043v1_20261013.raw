<td id="Pt0.A3.T1.8.5.4" class="ltx_td ltx_align_center">29%</td>
<td id="Pt0.A3.T1.8.5.5" class="ltx_td ltx_align_center">100%</td>
<td id="Pt0.A3.T1.8.5.6" class="ltx_td ltx_align_left">gift movement (80%)</td></tr>
