<td id="S11.T9.6.1.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">51.3</td>
<td id="S11.T9.6.1.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;">52.6</td>
