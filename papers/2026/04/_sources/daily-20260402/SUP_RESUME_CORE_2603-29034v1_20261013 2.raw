<th id="S11.T9.6.1.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S11.T9.6.1.6.1.1" class="ltx_text ltx_font_smallcaps">Snp</span><span id="S11.T9.6.1.6.1.2" class="ltx_text ltx_font_bold">: Uniform</span></th>
