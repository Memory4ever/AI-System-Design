<td id="S8.T4.9.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;" colspan="3"><span id="S8.T4.9.1.1.2.1" class="ltx_text" style="font-size:90%;">CelebA</span></td></tr>
