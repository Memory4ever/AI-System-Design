<tr id="S11.T9.6.1.8" class="ltx_tr">
<th id="S11.T9.6.1.8.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S11.T9.6.1.8.1.1" class="ltx_text ltx_font_smallcaps">Snp</span><span id="S11.T9.6.1.8.1.2" class="ltx_text ltx_font_bold">: Spectrum (10 layers)</span></th>
<td id="S11.T9.6.1.8.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.8pt;padding-right:1.8pt;">64.1 <math id="S11.T9.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
