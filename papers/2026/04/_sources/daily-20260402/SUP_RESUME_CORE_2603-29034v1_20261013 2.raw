<th id="S3.T2.8.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.8.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S3.T2.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.8.1.1.3.1" class="ltx_text ltx_font_bold">Mean PSNR</span></th></tr>
