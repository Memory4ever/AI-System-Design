<tr id="S3.T2.8.1.5" class="ltx_tr">
<td id="S3.T2.8.1.5.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t" rowspan="3"><span id="S3.T2.8.1.5.1.1" class="ltx_text">Denoising</span></td>
