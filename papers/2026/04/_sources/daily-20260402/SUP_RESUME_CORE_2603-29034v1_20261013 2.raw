<td id="S3.T1.10.1.10.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S3.T1.10.1.10.4.1" class="ltx_text ltx_font_bold">79.3</span></td></tr>
