<th id="S3.T1.10.1.10.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:1.8pt;padding-right:1.8pt;"><span id="S3.T1.10.1.10.1.1" class="ltx_text ltx_font_smallcaps">Snp</span><span id="S3.T1.10.1.10.1.2" class="ltx_text ltx_font_bold">: Uniform</span></th>
