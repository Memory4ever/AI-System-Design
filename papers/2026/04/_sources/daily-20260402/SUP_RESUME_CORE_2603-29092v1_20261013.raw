</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              
              
            <span id="alg1.l14.2" class="ltx_text" style="font-size:90%;">   </span><math id="alg1.l14.m1" class="ltx_Math" alttext="\hat{\Gamma}\leftarrow\textsc{NominalTrajectory}(\tau,x_{0},m)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">NominalTrajectory</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">τ</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">x</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">m</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\Gamma}\leftarrow\textsc{NominalTrajectory}(\tau,x_{0},m)</annotation></semantics></math><span id="alg1.l14.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
