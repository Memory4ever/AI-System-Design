</span></td></tr>
<tr id="S5.T2.4.5" class="ltx_tr">
<th id="S5.T2.4.5.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:0.45pt 5.0pt;"><span id="S5.T2.4.5.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Drop<span id="S5.T2.4.5.1.1.1" class="ltx_text ltx_font_serif">-only</span></span></th>
