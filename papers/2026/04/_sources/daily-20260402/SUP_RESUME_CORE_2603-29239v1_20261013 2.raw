<td id="S5.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.2pt 3.0pt;"><span id="S5.T2.5.2.4.1" class="ltx_text" style="font-size:70%;">-0.8151</span></td></tr>
