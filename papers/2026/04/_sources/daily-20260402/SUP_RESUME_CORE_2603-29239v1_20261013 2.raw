<td id="S2.F10.3.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:0.85pt 1.0pt;"><math id="S2.F10.m7" class="ltx_Math" alttext="N=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">N</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><annotation encoding="application/x-tex">N=1</annotation></semantics></math></td>
