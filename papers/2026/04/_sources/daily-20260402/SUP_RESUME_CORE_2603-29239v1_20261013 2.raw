<span id="S4.F20.3.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:22.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:22.5pt;transform:translate(-7.8pt,-7.8pt) rotate(-90deg) ;">
<span id="S4.F20.3.2.1.1.1.1" class="ltx_p"><span id="S4.F20.3.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Bird</span></span>
</span></span></span></th>
<td id="S4.F20.3.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -2.0pt;padding:0.5pt 1.0pt;"><img src="2603.29239v1/images/mg_tune/bird/0.01.jpg" id="S4.F20.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:131/131;" width="131" height="131" alt="Refer to caption"></td>
<td id="S4.F20.3.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -2.0pt;padding:0.5pt 1.0pt;"><img src="2603.29239v1/images/mg_tune/bird/0.02.jpg" id="S4.F20.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:131/131;" width="131" height="131" alt="Refer to caption"></td>
<td id="S4.F20.3.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -2.0pt;padding:0.5pt 1.0pt;"><img src="2603.29239v1/images/mg_tune/bird/0.05.jpg" id="S4.F20.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:131/131;" width="131" height="131" alt="Refer to caption"></td>
<td id="S4.F20.3.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -2.0pt;padding:0.5pt 1.0pt;"><img src="2603.29239v1/images/mg_tune/bird/0.1.jpg" id="S4.F20.g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:131/131;" width="131" height="131" alt="Refer to caption"></td>
<td id="S4.F20.3.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -2.0pt;padding:0.5pt 1.0pt;"><img src="2603.29239v1/images/mg_tune/bird/0.2.jpg" id="S4.F20.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:131/131;" width="131" height="131" alt="Refer to caption"></td></tr>
