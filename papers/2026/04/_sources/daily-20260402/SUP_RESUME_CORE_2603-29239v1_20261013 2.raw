<td id="S5.F9.3.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:1pt 1.0pt;"><img src="2603.29239v1/images/DiT_jpeg/race_car.jpg" id="S5.F9.g8" class="ltx_graphics ltx_img_square" style="aspect-ratio:124/124;" width="124" height="124" alt="Refer to caption"></td>
