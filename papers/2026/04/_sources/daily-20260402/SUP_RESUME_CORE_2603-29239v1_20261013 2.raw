<td id="S5.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-0.2pt 3.0pt;"><span id="S5.T2.5.2.2.1" class="ltx_text" style="font-size:70%;">0.165 / 0.678 / 0.364</span></td>
