{"data":{"id":"10.48550/arxiv.2603.29768","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.29768","prefix":"10.48550","suffix":"arxiv.2603.29768","identifiers":[{"identifier":"2603.29768","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.29768"}],"creators":[{"name":"Liao, Jing-Xiao","nameType":"Personal","givenName":"Jing-Xiao","familyName":"Liao","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Haoran","nameType":"Personal","givenName":"Haoran","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Tao","nameType":"Personal","givenName":"Tao","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Lyu, Daoming","nameType":"Personal","givenName":"Daoming","familyName":"Lyu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yi","nameType":"Personal","givenName":"Yi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Chengjun","nameType":"Personal","givenName":"Chengjun","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Feng-Lei","nameType":"Personal","givenName":"Feng-Lei","familyName":"Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Big2Small: A Unifying Neural Network Framework for Model Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-31T14:09:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T00:58:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"With the development of foundational models, model compression has become a critical requirement. Various model compression approaches have been proposed such as low-rank decomposition, pruning, quantization, ergodic dynamic systems, and knowledge distillation, which are based on different heuristics. To elevate the field from fragmentation to a principled discipline, we construct a unifying mathematical framework for model compression grounded in measure theory. We further demonstrate that each model compression technique is mathematically equivalent to a neural network subject to a regularization. Building upon this mathematical and structural equivalence, we propose an experimentally-verified data-free model compression framework, termed \\textit{Big2Small}, which translates Implicit Neural Representations (INRs) from data domain to the domain of network parameters. \\textit{Big2Small} trains compact INRs to encode the weights of larger models and reconstruct the weights during inference. To enhance reconstruction fidelity, we introduce Outlier-Aware Preprocessing to handle extreme weight values and a Frequency-Aware Loss function to preserve high-frequency details. Experiments on image classification and segmentation demonstrate that \\textit{Big2Small} achieves competitive accuracy and compression ratios compared to state-of-the-art baselines.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.29768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T02:18:44.000Z","registered":"2026-04-01T02:18:45.000Z","published":"2026","updated":"2026-04-01T02:18:45.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.29768","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}