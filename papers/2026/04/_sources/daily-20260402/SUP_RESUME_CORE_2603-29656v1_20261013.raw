<td id="S4.T1.14.1.7.7" class="ltx_td ltx_align_center" style="padding:0.65pt 3.4pt;"><span id="S4.T1.14.1.7.7.1" class="ltx_text" style="font-size:80%;">35.8</span></td></tr>
<tr id="S4.T1.14.1.8" class="ltx_tr" style="--ltx-bg-color:#F5F5F5;">
<th id="S4.T1.14.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.65pt 3.4pt;" colspan="7"><span id="S4.T1.14.1.8.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Non-LLM Baselines</span></th></tr>
