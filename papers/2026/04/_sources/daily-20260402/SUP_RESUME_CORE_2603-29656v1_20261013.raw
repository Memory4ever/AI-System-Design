<td id="S4.T2.9.7.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.85pt 5.7pt;"><span id="S4.T2.9.7.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#E6E6FF;">48.5</span></td>
