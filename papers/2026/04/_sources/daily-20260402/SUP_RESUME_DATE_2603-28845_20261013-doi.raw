{"data":{"id":"10.48550/arxiv.2603.28845","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.28845","prefix":"10.48550","suffix":"arxiv.2603.28845","identifiers":[{"identifier":"2603.28845","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.28845"}],"creators":[{"name":"Ichikawa, Yuma","nameType":"Personal","givenName":"Yuma","familyName":"Ichikawa","affiliation":[],"nameIdentifiers":[]},{"name":"Kimura, Keiji","nameType":"Personal","givenName":"Keiji","familyName":"Kimura","affiliation":[],"nameIdentifiers":[]},{"name":"Yoshida, Akihiro","nameType":"Personal","givenName":"Akihiro","familyName":"Yoshida","affiliation":[],"nameIdentifiers":[]},{"name":"Fujimoto, Yudai","nameType":"Personal","givenName":"Yudai","familyName":"Fujimoto","affiliation":[],"nameIdentifiers":[]},{"name":"Tokura, Hiroki","nameType":"Personal","givenName":"Hiroki","familyName":"Tokura","affiliation":[],"nameIdentifiers":[]},{"name":"Arai, Yamato","nameType":"Personal","givenName":"Yamato","familyName":"Arai","affiliation":[],"nameIdentifiers":[]},{"name":"Ishii, Yoshiyuki","nameType":"Personal","givenName":"Yoshiyuki","familyName":"Ishii","affiliation":[],"nameIdentifiers":[]},{"name":"Kawakami, Yusei","nameType":"Personal","givenName":"Yusei","familyName":"Kawakami","affiliation":[],"nameIdentifiers":[]},{"name":"Shikada, Genki","nameType":"Personal","givenName":"Genki","familyName":"Shikada","affiliation":[],"nameIdentifiers":[]},{"name":"Jacquemond, Achille","nameType":"Personal","givenName":"Achille","familyName":"Jacquemond","affiliation":[],"nameIdentifiers":[]},{"name":"Fujisawa, Yoshihiko","nameType":"Personal","givenName":"Yoshihiko","familyName":"Fujisawa","affiliation":[],"nameIdentifiers":[]},{"name":"Fujisawa, Katsuki","nameType":"Personal","givenName":"Katsuki","familyName":"Fujisawa","affiliation":[],"nameIdentifiers":[]},{"name":"Honda, Takumi","nameType":"Personal","givenName":"Takumi","familyName":"Honda","affiliation":[],"nameIdentifiers":[]},{"name":"Sakai, Akira","nameType":"Personal","givenName":"Akira","familyName":"Sakai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OneComp: One-Line Revolution for Generative AI Model Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computational Engineering, Finance, and Science (cs.CE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-30T17:43:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T00:01:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Deploying foundation models is increasingly constrained by memory footprint, latency, and hardware costs. Post-training compression can mitigate these bottlenecks by reducing the precision of model parameters without significantly degrading performance; however, its practical implementation remains challenging as practitioners navigate a fragmented landscape of quantization algorithms, precision budgets, data-driven calibration strategies, and hardware-dependent execution regimes. We present OneComp, an open-source compression framework that transforms this expert workflow into a reproducible, resource-adaptive pipeline. Given a model identifier and available hardware, OneComp automatically inspects the model, plans mixed-precision assignments, and executes progressive quantization stages, ranging from layer-wise compression to block-wise refinement and global refinement. A key architectural choice is treating the first quantized checkpoint as a deployable pivot, ensuring that each subsequent stage improves the same model and that quality increases as more compute is invested. By converting state-of-the-art compression research into an extensible, open-source, hardware-aware pipeline, OneComp bridges the gap between algorithmic innovation and production-grade model deployment.","descriptionType":"Abstract"},{"description":"31 pages, 6 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.28845","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T01:56:58.000Z","registered":"2026-04-01T01:56:59.000Z","published":"2026","updated":"2026-04-01T01:56:59.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.28845","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}