<tr id="A7.T4.5.1" class="ltx_tr">
<th id="A7.T4.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A7.T4.5.1.1.1" class="ltx_text ltx_font_bold">Parameter</span></th>
<th id="A7.T4.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A7.T4.5.1.2.1" class="ltx_text ltx_font_bold">Value</span></th>
<th id="A7.T4.5.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A7.T4.5.1.3.1" class="ltx_text ltx_font_bold">Description</span></th></tr>
