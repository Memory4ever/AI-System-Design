<tbody class="ltx_tbody">
<tr id="A7.T4.5.2" class="ltx_tr">
<td id="A7.T4.5.2.1" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T4.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></td>
<td id="A7.T4.5.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A7.T4.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></td>
