<td id="A7.T4.5.4.1" class="ltx_td ltx_align_left"><math id="A7.T4.m5" class="ltx_Math" alttext="d_{\mathrm{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>model</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{model}}</annotation></semantics></math></td>
<td id="A7.T4.5.4.2" class="ltx_td ltx_align_left"><math id="A7.T4.m6" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn>128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math></td>
<td id="A7.T4.5.4.3" class="ltx_td ltx_nopad_r ltx_align_left">Residual stream dimension</td></tr>
<tr id="A7.T4.5.5" class="ltx_tr">
