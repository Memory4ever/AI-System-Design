<td id="A7.T10.5.7.2" class="ltx_td ltx_align_left"><math id="A7.T10.m5" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn>0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
