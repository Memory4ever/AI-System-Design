<td id="A7.T10.5.12.2" class="ltx_td ltx_align_left"><math id="A7.T10.m8" class="ltx_Math" alttext="2\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-4}</annotation></semantics></math></td>
<td id="A7.T10.5.12.3" class="ltx_td ltx_nopad_r ltx_align_left">—</td></tr>
