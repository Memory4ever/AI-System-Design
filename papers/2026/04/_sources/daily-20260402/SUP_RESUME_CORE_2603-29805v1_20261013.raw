</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
              <math id="alg1.l10.m1" class="ltx_Math" alttext="C\leftarrow\mathrm{SampleCovariance}(\text{loss\_buffer})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo stretchy="false">←</mo><mrow><mi>SampleCovariance</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>loss_buffer</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\leftarrow\mathrm{SampleCovariance}(\text{loss\_buffer})</annotation></semantics></math> {<math id="alg1.l10.m2" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> matrix}

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
              <math id="alg1.l11.m1" class="ltx_Math" alttext="\{\lambda_{k}\}\leftarrow\mathrm{Eigenvalues}(C)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>λ</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mi>Eigenvalues</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\lambda_{k}\}\leftarrow\mathrm{Eigenvalues}(C)</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
              <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathrm{SHC}(t)\leftarrow\mathrm{Var}(\{\lambda_{k}\})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>λ</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SHC}(t)\leftarrow\mathrm{Var}(\{\lambda_{k}\})</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
              <math id="alg1.l13.m1" class="ltx_Math" alttext="\mathrm{PR}(t)\leftarrow\dfrac{\left(\sum_{k}\lambda_{k}\right)^{2}}{\sum_{k}\lambda_{k}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>PR</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>k</mi></msub><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mrow><msub><mo>∑</mo><mi>k</mi></msub><msubsup><mi>λ</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\mathrm{PR}(t)\leftarrow\dfrac{\left(\sum_{k}\lambda_{k}\right)^{2}}{\sum_{k}\lambda_{k}^{2}}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
              <span id="alg1.l14.3" class="ltx_text ltx_font_bold">optional:</span> store top eigenvectors for interpretability

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
             <span id="alg1.l15.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
            <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
           <span id="alg1.l17.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l17.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
           <span id="alg1.l18.3" class="ltx_text ltx_font_bold">return</span>  <math id="alg1.l18.m1" class="ltx_Math" alttext="\mathrm{SHC}(t)" display="inline" intent=":literal"><semantics><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SHC}(t)</annotation></semantics></math>, <math id="alg1.l18.m2" class="ltx_Math" alttext="\mathrm{PR}(t)" display="inline" intent=":literal"><semantics><mrow><mi>PR</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{PR}(t)</annotation></semantics></math> over training

</div>
</div>
</figure>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p">When computing the (dynamical) 2RDM the cost per update step is <math id="A1.p2.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> forward passes for a probe set of size <math id="A1.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. For a window of size <math id="A1.p2.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> the covariance computation costs <math id="A1.p2.m4" class="ltx_Math" alttext="O(n^{2}m)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(n^{2}m)</annotation></semantics></math>, with the SHC and PR simply being operations on the trace of this matrix. For eigenvector attribution, this adds a factor of <math id="A1.p2.m5" class="ltx_Math" alttext="O(n^{3})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(n^{3})</annotation></semantics></math> to the computation. The decomposition need not be run at every update, and can be set to be computed only when the SHC spikes, drastically decreasing the computation cost. Here the number of parameters of the model only factors into the computation through the initial forward passes.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Probe Set Choice</h3>

<div id="A1.SS1.p1" class="ltx_para">
<p id="A1.SS1.p1.1" class="ltx_p">While optimal selection of probe samples is an open problem and is discussed in-depth in other sections, there is practical guidance to be offered. There are two straightforward ways to select probe sets depending on the exact problem and the compute resource being studied. First, one can simply select a subset at random from the dataset (in general, one should select data from either the test set, or mix of the train and test set). If the subset is sufficiently large, it will cover a large amount of emerging behaviour, and the data clusters can be found on the fly using the eigenvectors of the loss covariance. The other option is to pick the probe set according to some predefined categories. While this does introduce bias, it allows more targeted observations for behaviours of interest, especially when one is looking at how behaviours that are OOD from the training data change. For the tasks examined in this work, we found a probe set size between 100-500 to provide sufficient resolution.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Parameter Choices For the dynamical 2RDM</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">When computing the 2RDM, there are two main choices of parameter to select. First is the <span id="A1.SS2.p1.1.1" class="ltx_text ltx_font_bold">window size</span>, which is the number of per-sample loss vectors to be maintained and used for the 2RDM computation. Second is the <span id="A1.SS2.p1.1.2" class="ltx_text ltx_font_bold">update frequency</span>, which is the number of training updates between 2RDM computations.</p>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p">When selecting the window size for the dynamical 2RDM we found that a size of 20 produced consistent results, and furthermore we found that increasing the window size effectively delayed the spike in the SHC but increased its magnitude. This is shown for induction heads in figure <a href="#A1.F12" title="Figure 12 ‣ A.2 Parameter Choices For the dynamical 2RDM ‣ Appendix A Using the 2RDM in Practice ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>. One can consider the window size as a tradeoff between the temporal accuracy and noise. A small window will detect at a finer temporal resolution but with more noise in the covariance estimation.</p>
</div>
<div id="A1.SS2.p3" class="ltx_para">
<p id="A1.SS2.p3.1" class="ltx_p">In fact, under mild assumptions there is an exact scaling law for the window size <math id="A1.SS2.p3.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>. Suppose a transition occurs over some timescale <math id="A1.SS2.p3.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> and during that period the per-sample loss vector evolves linearly like <math id="A1.SS2.p3.m3" class="ltx_Math" alttext="\ell(t)\approx\ell_{0}+vt" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(t)\approx\ell_{0}+vt</annotation></semantics></math> where <math id="A1.SS2.p3.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is the velocity vector and <math id="A1.SS2.p3.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is the time within the window. Consider a trailing window <math id="A1.SS2.p3.m6" class="ltx_Math" alttext="[t-W,t]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>W</mi></mrow><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t-W,t]</annotation></semantics></math> that lies within the transition region. The loss vectors in this window are approximately uniformly distributed along the line segment from <math id="A1.SS2.p3.m7" class="ltx_Math" alttext="\ell_{0}+v(t-w)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><mo>+</mo><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{0}+v(t-w)</annotation></semantics></math> to <math id="A1.SS2.p3.m8" class="ltx_Math" alttext="\ell_{0}+vt" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><mo>+</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\ell_{0}+vt</annotation></semantics></math>. The covariance of uniformly spaced points along a line segment of length <math id="A1.SS2.p3.m9" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is</p>
<table id="A1.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E8.m1" class="ltx_Math" alttext="C=\frac{W^{2}}{12}vv^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mfrac><msup><mi>W</mi><mn>2</mn></msup><mn>12</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C=\frac{W^{2}}{12}vv^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p">This is rank 1 with a single nonzero eigenvalue <math id="A1.SS2.p4.m1" class="ltx_Math" alttext="\lambda_{1}=\frac{W^{2}}{12}\|v\|^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mrow><mfrac><msup><mi>W</mi><mn>2</mn></msup><mn>12</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\lambda_{1}=\frac{W^{2}}{12}\|v\|^{2}</annotation></semantics></math>. The SHC for a rank-1 matrix with <math id="A1.SS2.p4.m2" class="ltx_Math" alttext="n-1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n-1</annotation></semantics></math> zero eigenvalues is</p>
<table id="A1.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E9.m1" class="ltx_Math" alttext="=\lambda_{1}^{2}\frac{n-1}{n^{2}}" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>λ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">=\lambda_{1}^{2}\frac{n-1}{n^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<table id="A1.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E10.m1" class="ltx_Math" alttext="=\frac{n-1}{n^{2}}\frac{W^{4}}{144}\|v\|^{4}" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>W</mi><mn>4</mn></msup><mn>144</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">=\frac{n-1}{n^{2}}\frac{W^{4}}{144}\|v\|^{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p4.2" class="ltx_p">We get from this that the magnitude scales with the window size like <math id="A1.SS2.p4.m3" class="ltx_Math" alttext="W^{4}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mn>4</mn></msup><annotation encoding="application/x-tex">W^{4}</annotation></semantics></math>, so doubling the window size increases the spike magnitude by a factor of 16. For the shift, the SHC at time <math id="A1.SS2.p4.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> becomes large when the window <math id="A1.SS2.p4.m5" class="ltx_Math" alttext="[t-W,t]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>W</mi></mrow><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t-W,t]</annotation></semantics></math> overlaps substantially with the transition. The peak occurs roughly when the window is centered on the steepest part of the transition, which means <math id="A1.SS2.p4.m6" class="ltx_Math" alttext="t\approx t^{*}+\frac{W}{2}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≈</mo><mrow><msup><mi>t</mi><mo>∗</mo></msup><mo>+</mo><mfrac><mi>W</mi><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">t\approx t^{*}+\frac{W}{2}</annotation></semantics></math> for a trailing window. So the delay grows linearly with W. Notice that this is effectively exactly what is seen in figure <a href="#A1.F12" title="Figure 12 ‣ A.2 Parameter Choices For the dynamical 2RDM ‣ Appendix A Using the 2RDM in Practice ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>.</p>
</div>
<div id="A1.SS2.p5" class="ltx_para">
<p id="A1.SS2.p5.1" class="ltx_p">This linear-trajectory regime holds when <math id="A1.SS2.p5.m1" class="ltx_Math" alttext="W&lt;\tau" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>&lt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">W&lt;\tau</annotation></semantics></math> (the window is smaller than the transition timescale). When <math id="A1.SS2.p5.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> exceeds <math id="A1.SS2.p5.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, the window extends past the transition into the flat pre- or post-transition regime, and those flat samples dilute the signal. So there’s actually a non-monotonic relationship. The SHC grows as <math id="A1.SS2.p5.m4" class="ltx_Math" alttext="W^{4}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mn>4</mn></msup><annotation encoding="application/x-tex">W^{4}</annotation></semantics></math> for small windows, peaks around <math id="A1.SS2.p5.m5" class="ltx_Math" alttext="W\sim\tau" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∼</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">W\sim\tau</annotation></semantics></math>, then decreases for <math id="A1.SS2.p5.m6" class="ltx_Math" alttext="W\gg\tau" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>≫</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">W\gg\tau</annotation></semantics></math> as dilution dominates.</p>
</div>
<figure id="A1.F12" class="ltx_figure"><img src="2603.29805v1/figures/shc_traces_shc_only.png" id="A1.F12.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/241;" width="471" height="241" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F12.3" class="ltx_text" style="font-size:90%;">Figure 12</span>: </span><span id="A1.F12.4" class="ltx_text" style="font-size:90%;">SHC spike location and magnitude.</span></figcaption>
</figure>
<div id="A1.SS2.p6" class="ltx_para">
<p id="A1.SS2.p6.1" class="ltx_p">When selecting the update frequency, which we will denote <math id="A1.SS2.p6.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, one generally wants that <math id="A1.SS2.p6.m2" class="ltx_Math" alttext="u&lt;W" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>&lt;</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">u&lt;W</annotation></semantics></math>. The argument for this is straightforward. The SHC spike has a temporal width of roughly <math id="A1.SS2.p6.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> (from when the transition enters the window to when it exits). If you’re evaluating every <math id="A1.SS2.p6.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> steps, you get approximately <math id="A1.SS2.p6.m5" class="ltx_Math" alttext="W/u" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>/</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">W/u</annotation></semantics></math> chances to observe the spike. If <math id="A1.SS2.p6.m6" class="ltx_Math" alttext="W/u\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo>/</mo><mi>u</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">W/u\geq 1</annotation></semantics></math>, at least one evaluation falls within the spike and you see it. If <math id="A1.SS2.p6.m7" class="ltx_Math" alttext="W/u&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo>/</mo><mi>u</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">W/u&lt;1</annotation></semantics></math>, you might miss it entirely within the window. However, even if <math id="A1.SS2.p6.m8" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is taken to be very large, one will still detect that something has changed, however the temporal resolution is lost, meaning that transitions can get blended together even if they were separate events.</p>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Sampling Method</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p">In almost all the experiments, we use the dynamical 2RDM. However, in emergent misalignment we use the 2RDM with Gaussian sampling. In general, one should use the 2RDM unless they are concerned with changes very early in training before there is enough samples to compute the dynamical 2RDM. We do note however that it is possible in principle to blend the two by Gaussian sampling early and then blending the samples in over a window, transitioning into dynamical sampling. That is, once you have enough steps for the window to start producing trajectory covariances (step <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> onward), you have a region where both estimates exist, and can blend them according to:</p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<table id="A1.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E11.m1" class="ltx_Math" alttext="C(t)=(1-w(t))\,C_{\text{gauss}}(t)\;+\;w(t)\,C_{\text{traj}}(t)" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mtext>gauss</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mtext>traj</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C(t)=(1-w(t))\,C_{\text{gauss}}(t)\;+\;w(t)\,C_{\text{traj}}(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p">where <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="w(t)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(t)</annotation></semantics></math> ramps smoothly from 0 to 1 over a few window-lengths. A natural choice is <math id="A1.SS3.p3.m2" class="ltx_Math" alttext="w(t)=\min(1,\;(t-W)/W)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w(t)=\min(1,\;(t-W)/W)</annotation></semantics></math>, giving you one full window-width of blending.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>The Cumulant Expansion</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">The theoretical motivation for looking at the covariance of the loss comes from the fact that it is related to the second cumulant in the expansion of the free energy for a model. That is, letting <math id="A2.p1.m1" class="ltx_math_unparsed" alttext="p(w|x_{1:n})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(w|x_{1:n})</annotation></semantics></math> be distribution over some compact space of model parameters <math id="A2.p1.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> given datapoints <math id="A2.p1.m3" class="ltx_math_unparsed" alttext="x_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:n}</annotation></semantics></math>, the tempered partition function <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">47</a>]</cite> is then:</p>
<table id="A2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E12.m1" class="ltx_math_unparsed" alttext="Z(\beta,x_{1:n})=\int e^{-n\beta L_{n}(w,x_{1:n})}\rho(w)dw" display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><mo>∫</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>n</mi><mi>β</mi><mi>L</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msup><mi>ρ</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>w</mi></mrow><annotation encoding="application/x-tex">Z(\beta,x_{1:n})=\int e^{-n\beta L_{n}(w,x_{1:n})}\rho(w)dw</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A2.p1.2" class="ltx_p">which gives the free energy as <math id="A2.p1.m4" class="ltx_math_unparsed" alttext="\log Z(\beta,x_{1:n})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log Z(\beta,x_{1:n})</annotation></semantics></math>. Note that here we assume that the loss <math id="A2.p1.m5" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is bounded and that <math id="A2.p1.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is compact.</p>
</div>
<div id="A2.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma B.1</span></span><span id="A2.Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Weight-Space Cluster Expansion)<span id="A2.Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma1.p1" class="ltx_para">
<p id="A2.Thmlemma1.p1.1" class="ltx_p"><span id="A2.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmlemma1.p1.m1" class="ltx_math_unparsed" alttext="Z(\beta,x_{1:n})=\mathbb{E}_{w\sim\rho}\!\left[\prod_{i=1}^{n}e^{-\beta\,l(x_{i},w)}\right]" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>w</mi><mo>∼</mo><mi>ρ</mi></mrow></msub><mrow><mo>[</mo><msubsup><mo lspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">Z(\beta,x_{1:n})=\mathbb{E}_{w\sim\rho}\!\left[\prod_{i=1}^{n}e^{-\beta\,l(x_{i},w)}\right]</annotation></semantics></math> be the partition function, and consider a distribution <math id="A2.Thmlemma1.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> about a point <math id="A2.Thmlemma1.p1.m3" class="ltx_Math" alttext="w_{0}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mn>0</mn></msub><annotation encoding="application/x-tex">w_{0}</annotation></semantics></math>. Then</span></p>
<table id="A2.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E13.m1" class="ltx_math_unparsed" alttext="\log Z(\beta,x_{1:n})=-\beta\sum_{i=1}^{n}\mathbb{E}_{w}[l_{i}]+\frac{\beta^{2}}{2}\sum_{i,j}C_{w}(x_{i},x_{j})-\frac{\beta^{3}}{6}\sum_{i,j,k}\chi_{3}^{(w)}(l_{i},l_{j},l_{k})+\cdots" display="block" intent=":literal"><semantics><mrow><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>β</mi><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>𝔼</mi><mi>w</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>l</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mfrac><msup><mi>β</mi><mn>2</mn></msup><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msub><mi>C</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><msup><mi>β</mi><mn>3</mn></msup><mn>6</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow></munder><msubsup><mi>χ</mi><mn>3</mn><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mi>i</mi></msub><mo>,</mo><msub><mi>l</mi><mi>j</mi></msub><mo>,</mo><msub><mi>l</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\log Z(\beta,x_{1:n})=-\beta\sum_{i=1}^{n}\mathbb{E}_{w}[l_{i}]+\frac{\beta^{2}}{2}\sum_{i,j}C_{w}(x_{i},x_{j})-\frac{\beta^{3}}{6}\sum_{i,j,k}\chi_{3}^{(w)}(l_{i},l_{j},l_{k})+\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A2.Thmlemma1.p1.2" class="ltx_p"><span id="A2.Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmlemma1.p1.m4" class="ltx_Math" alttext="l_{i}=l(x_{i},w)" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{i}=l(x_{i},w)</annotation></semantics></math> and the sums run over all (ordered) tuples, and each cumulant is computed over <math id="A2.Thmlemma1.p1.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p2" class="ltx_para">
<p id="A2.p2.1" class="ltx_p"><span id="A2.p2.1.1" class="ltx_text">Writing <math id="A2.p2.m1" class="ltx_math_unparsed" alttext="nL_{n}(x_{1:n},w)=\sum_{i=1}^{n}l(x_{i},w)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><msub><mi>L</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mi>l</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">nL_{n}(x_{1:n},w)=\sum_{i=1}^{n}l(x_{i},w)</annotation></semantics></math>, the partition function becomes</span></p>
<table id="A2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E14.m1" class="ltx_math_unparsed" alttext="Z(\beta,x_{1:n})=\mathbb{E}_{w\sim\rho}\!\left[\prod_{i=1}^{n}e^{-\beta\,l(x_{i},w)}\right]" display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>w</mi><mo>∼</mo><mi>ρ</mi></mrow></msub><mrow><mo>[</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">Z(\beta,x_{1:n})=\mathbb{E}_{w\sim\rho}\!\left[\prod_{i=1}^{n}e^{-\beta\,l(x_{i},w)}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.p2.2" class="ltx_p"><span id="A2.p2.2.1" class="ltx_text">The logarithm of this expectation is, by definition, the cumulant generating function of the random vector <math id="A2.p2.m2" class="ltx_math_unparsed" alttext="(l(x_{1},w),\ldots,l(x_{1:n},w))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>l</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l(x_{1},w),\ldots,l(x_{1:n},w))</annotation></semantics></math> under the prior measure <math id="A2.p2.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, evaluated at <math id="A2.p2.m4" class="ltx_Math" alttext="t_{i}=-\beta" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>−</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">t_{i}=-\beta</annotation></semantics></math> for all <math id="A2.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. By the standard multivariate cumulant expansion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">28</a>]</cite>, this gives</span></p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_Math" alttext="\log Z=\sum_{a=1}^{\infty}\frac{(-\beta)^{a}}{a!}\sum_{i_{1},\ldots,i_{a}}\chi_{a}^{(w)}(l_{i_{1}},\ldots,l_{i_{a}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>Z</mi></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mrow><mi>a</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>i</mi><mi>a</mi></msub></mrow></munder><mrow><msubsup><mi>χ</mi><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><msub><mi>i</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>l</mi><msub><mi>i</mi><mi>a</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\log Z=\sum_{a=1}^{\infty}\frac{(-\beta)^{a}}{a!}\sum_{i_{1},\ldots,i_{a}}\chi_{a}^{(w)}(l_{i_{1}},\ldots,l_{i_{a}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A2.p2.3" class="ltx_p"><span id="A2.p2.3.1" class="ltx_text">Expanding the first few terms yields (<a href="#A2.E13" title="In Lemma B.1 (Weight-Space Cluster Expansion). ‣ Appendix B The Cumulant Expansion ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>).
∎</span></p>
</div>
</div>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">One can see that this is just the standard cumulant expansion from statistical physics. The choice of quantum chemistry as the analog is to highlight the basis selection problem in any sort of phase transition detection method. Note as well that for the Gaussian 2RDM the theoretical relationship with the cumulant expansion is straightforward by localization of the Gaussian distribution in a local minima. For the dynamical 2RDM this relationship is slightly less straightforward, but can still be reasonably justified by something like the effective exploration of a minima.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Theoretical Properties of the 2RDM</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>2RDM Decomposition</h3>

<div id="A3.Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition C.1</span></span><span id="A3.Thmproposition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition1.p1" class="ltx_para">
<p id="A3.Thmproposition1.p1.1" class="ltx_p"><span id="A3.Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmproposition1.p1.m1" class="ltx_Math" alttext="\rho_{\theta^{0}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><annotation encoding="application/x-tex">\rho_{\theta^{0}}</annotation></semantics></math> be a distribution about <math id="A3.Thmproposition1.p1.m2" class="ltx_Math" alttext="\theta^{0}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\theta^{0}</annotation></semantics></math>. The loss covariance under <math id="A3.Thmproposition1.p1.m3" class="ltx_Math" alttext="\rho_{\theta^{0}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><annotation encoding="application/x-tex">\rho_{\theta^{0}}</annotation></semantics></math> is approximated to leading order</span></p>
<table id="A3.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E16.m1" class="ltx_Math" alttext="C\approx G\,\Sigma_{\theta^{0}}\,G^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>≈</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C\approx G\,\Sigma_{\theta^{0}}\,G^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition1.p1.2" class="ltx_p"><span id="A3.Thmproposition1.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E17.m1" class="ltx_Math" alttext="\Sigma_{\theta^{0}}=\mathrm{Cov}[\delta\theta]=\mathbb{E}[(\delta\theta-\mathbb{E}[\delta\theta])(\delta\theta-\mathbb{E}[\delta\theta])^{\top}]" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><mo>=</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta^{0}}=\mathrm{Cov}[\delta\theta]=\mathbb{E}[(\delta\theta-\mathbb{E}[\delta\theta])(\delta\theta-\mathbb{E}[\delta\theta])^{\top}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition1.p1.3" class="ltx_p"><span id="A3.Thmproposition1.p1.3.1" class="ltx_text ltx_font_italic">is the covariance of the distribution and <math id="A3.Thmproposition1.p1.m4" class="ltx_Math" alttext="G\in\mathbb{R}^{n\times p}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">G\in\mathbb{R}^{n\times p}</annotation></semantics></math> is the Jacobian matrix with rows <math id="A3.Thmproposition1.p1.m5" class="ltx_Math" alttext="g_{i}^{\top}=\nabla_{\theta}\ell(x_{i})^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">g_{i}^{\top}=\nabla_{\theta}\ell(x_{i})^{\top}</annotation></semantics></math> for <math id="A3.Thmproposition1.p1.m6" class="ltx_Math" alttext="\text{Dim}(\theta)=p" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic">Dim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\text{Dim}(\theta)=p</annotation></semantics></math> with <math id="A3.Thmproposition1.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples.</span></p>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p"><span id="A3.SS1.p1.1.1" class="ltx_text">First we linearize around <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="\theta^{0}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\theta^{0}</annotation></semantics></math> to first order:</span></p>
<table id="A3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E18.m1" class="ltx_Math" alttext="\ell_{\theta}(x_{i})\approx\ell_{\theta^{0}}(x_{i})+g_{i}^{\top}\delta\theta" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><msup><mi>θ</mi><mn>0</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{\theta}(x_{i})\approx\ell_{\theta^{0}}(x_{i})+g_{i}^{\top}\delta\theta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p"><span id="A3.SS1.p1.2.1" class="ltx_text">so then by the error propagation formula</span></p>
<table id="A3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E19.m1" class="ltx_Math" alttext="C_{ij}=\operatorname{Cov}_{\theta}[\ell(x_{i}),\ell(x_{j})]\approx g_{i}^{\top}\,\Sigma_{\theta}\,g_{j}" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>Cov</mi><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≈</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">C_{ij}=\operatorname{Cov}_{\theta}[\ell(x_{i}),\ell(x_{j})]\approx g_{i}^{\top}\,\Sigma_{\theta}\,g_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.3" class="ltx_p"><span id="A3.SS1.p1.3.1" class="ltx_text">and thus</span></p>
<table id="A3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E20.m1" class="ltx_Math" alttext="C\approx G\,\Sigma_{\theta}\,G^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>≈</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C\approx G\,\Sigma_{\theta}\,G^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.4" class="ltx_p"><span id="A3.SS1.p1.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p">This result can be used to give the following straightforward results:</p>
</div>
<div id="A3.Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary C.1</span></span><span id="A3.Thmcorollary1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmcorollary1.p1" class="ltx_para">
<p id="A3.Thmcorollary1.p1.1" class="ltx_p"><span id="A3.Thmcorollary1.p1.1.1" class="ltx_text ltx_font_italic">If the distribution about <math id="A3.Thmcorollary1.p1.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is given by <math id="A3.Thmcorollary1.p1.m2" class="ltx_Math" alttext="\theta+\varepsilon" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>+</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\theta+\varepsilon</annotation></semantics></math> with <math id="A3.Thmcorollary1.p1.m3" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> sampled according to the normal distribution <math id="A3.Thmcorollary1.p1.m4" class="ltx_Math" alttext="\varepsilon\sim\mathcal{N}(0,\sigma^{2}I)" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\sim\mathcal{N}(0,\sigma^{2}I)</annotation></semantics></math>, then</span></p>
<table id="A3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E21.m1" class="ltx_Math" alttext="C_{\mathcal{N}}=\sigma^{2}GG^{T}" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mi>T</mi></msup></mrow></mrow><annotation encoding="application/x-tex">C_{\mathcal{N}}=\sigma^{2}GG^{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p">In the following suppose we have a training trajectory that is a continuous path <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> from initialization to some fixed endpoint.</p>
</div>
<div id="A3.Thmcorollary2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmcorollary2.2" class="ltx_text ltx_font_bold">Corollary C.2</span></span><span id="A3.Thmcorollary2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmcorollary2.p1" class="ltx_para">
<p id="A3.Thmcorollary2.p1.1" class="ltx_p"><span id="A3.Thmcorollary2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmcorollary2.p1.m1" class="ltx_Math" alttext="\rho_{T}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\rho_{T}</annotation></semantics></math> be a distribution defined over a training window of size <math id="A3.Thmcorollary2.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> like <math id="A3.Thmcorollary2.p1.m3" class="ltx_Math" alttext="[t-T/2,\;t+T/2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>t</mi><mo>−</mo><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t-T/2,\;t+T/2]</annotation></semantics></math>. The loss covariance under <math id="A3.Thmcorollary2.p1.m4" class="ltx_Math" alttext="\rho_{T}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\rho_{T}</annotation></semantics></math> is approximated to leading order</span></p>
<table id="A3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E22.m1" class="ltx_Math" alttext="C\approx G\,\Sigma_{\theta}\,G^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>≈</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C\approx G\,\Sigma_{\theta}\,G^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p4" class="ltx_para">
<p id="A3.SS1.p4.1" class="ltx_p">Both of the above results hold straightforwardly. Note that this approximation is good when the dynamics are approximately linear over the window, which is always the case for a small enough window.</p>
</div>
<div id="A3.SS1.p5" class="ltx_para">
<p id="A3.SS1.p5.1" class="ltx_p">Here we introduce the idea of the <span id="A3.SS1.p5.1.1" class="ltx_text ltx_font_bold">empirical Fisher information matrix</span>. For a finite probe set <math id="A3.SS1.p5.m1" class="ltx_Math" alttext="\{x_{i}\}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">\{x_{i}\}_{i=1}^{n}</annotation></semantics></math>, the empirical Fisher is</p>
</div>
<div id="A3.SS1.p6" class="ltx_para">
<table id="A3.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E23.m1" class="ltx_Math" alttext="\hat{F}(\theta)_{ab}=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{i})}{\partial\theta_{b}}=\frac{1}{n}G^{\top}G" display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>a</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>b</mi></msub></mrow></mfrac></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{F}(\theta)_{ab}=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{i})}{\partial\theta_{b}}=\frac{1}{n}G^{\top}G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p7" class="ltx_para">
<p id="A3.SS1.p7.1" class="ltx_p">Combining this with the corollary <a href="#A3.Thmcorollary1" title="Corollary C.1. ‣ C.1 2RDM Decomposition ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> we get the following result:</p>
</div>
<div id="A3.Thmcorollary3" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmcorollary3.2" class="ltx_text ltx_font_bold">Corollary C.3</span></span><span id="A3.Thmcorollary3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmcorollary3.p1" class="ltx_para">
<p id="A3.Thmcorollary3.p1.1" class="ltx_p"><span id="A3.Thmcorollary3.p1.1.1" class="ltx_text ltx_font_italic">Up to scale by a constant factor, the matrices <math id="A3.Thmcorollary3.p1.m1" class="ltx_Math" alttext="C_{\mathcal{N}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{\mathcal{N}}(\theta)</annotation></semantics></math> and <math id="A3.Thmcorollary3.p1.m2" class="ltx_Math" alttext="\hat{F}(\theta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{F}(\theta)</annotation></semantics></math> share the same non-zero eigenvalues.</span></p>
</div>
</div>
<div id="A3.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p8" class="ltx_para">
<p id="A3.SS1.p8.1" class="ltx_p"><span id="A3.SS1.p8.1.1" class="ltx_text">This follows straightforwardly from the spectral property of products.
∎</span></p>
</div>
</div>
<div id="A3.SS1.p9" class="ltx_para">
<p id="A3.SS1.p9.1" class="ltx_p">Using a similar method we can generalize this beyond the normal distribution:</p>
</div>
<div id="A3.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma1.p1" class="ltx_para">
<p id="A3.Thmlemma1.p1.1" class="ltx_p"><span id="A3.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmlemma1.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math> the covariance of the sampling distribution <math id="A3.Thmlemma1.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> about <math id="A3.Thmlemma1.p1.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. Then <math id="A3.Thmlemma1.p1.m4" class="ltx_Math" alttext="C_{\rho}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>ρ</mi></msub><annotation encoding="application/x-tex">C_{\rho}</annotation></semantics></math> shares the same non-zero eigenvalues (up to scale) as <math id="A3.Thmlemma1.p1.m5" class="ltx_Math" alttext="n\hat{F}(\theta)\Sigma_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">n\hat{F}(\theta)\Sigma_{\theta}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p10" class="ltx_para">
<p id="A3.SS1.p10.1" class="ltx_p"><span id="A3.SS1.p10.1.1" class="ltx_text">Set <math id="A3.SS1.p10.m1" class="ltx_Math" alttext="M=G\Sigma_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">M=G\Sigma_{\theta}</annotation></semantics></math> (which is <math id="A3.SS1.p10.m2" class="ltx_Math" alttext="n\times p" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n\times p</annotation></semantics></math>) and <math id="A3.SS1.p10.m3" class="ltx_Math" alttext="N=G^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">N=G^{\top}</annotation></semantics></math> (which is <math id="A3.SS1.p10.m4" class="ltx_Math" alttext="p\times n" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">p\times n</annotation></semantics></math>). Then:</span></p>
<table id="A3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E24.m1" class="ltx_Math" alttext="MN=G\Sigma_{\theta}G^{\top}=C\qquad(n\times n)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>=</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mi>C</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">MN=G\Sigma_{\theta}G^{\top}=C\qquad(n\times n)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<table id="A3.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E25.m1" class="ltx_Math" alttext="NM=G^{\top}G\Sigma_{\theta}=n\hat{F}\Sigma_{\theta}\qquad(p\times p)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>=</mo><mrow><msup><mi>G</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">NM=G^{\top}G\Sigma_{\theta}=n\hat{F}\Sigma_{\theta}\qquad(p\times p)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p10.2" class="ltx_p"><span id="A3.SS1.p10.2.1" class="ltx_text">So by the spectral property of products, <math id="A3.SS1.p10.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and <math id="A3.SS1.p10.m6" class="ltx_Math" alttext="n\hat{F}\Sigma_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">n\hat{F}\Sigma_{\theta}</annotation></semantics></math> share all their nonzero eigenvalues.
∎</span></p>
</div>
</div>
<div id="A3.SS1.p11" class="ltx_para">
<p id="A3.SS1.p11.1" class="ltx_p">Now one can get a more fine-grained decomposition of this using SVD.</p>
</div>
<div id="A3.Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition C.2</span></span><span id="A3.Thmproposition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition2.p1" class="ltx_para">
<p id="A3.Thmproposition2.p1.1" class="ltx_p"><span id="A3.Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">One gets a decomposition of <math id="A3.Thmproposition2.p1.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> as</span></p>
<table id="A3.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E26.m1" class="ltx_Math" alttext="C=U_{G}\,S_{G}\,\tilde{\Sigma}\,S_{G}\,U_{G}^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C=U_{G}\,S_{G}\,\tilde{\Sigma}\,S_{G}\,U_{G}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition2.p1.2" class="ltx_p"><span id="A3.Thmproposition2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmproposition2.p1.m2" class="ltx_Math" alttext="S_{G}\in\mathbb{R}^{r_{G}\times r_{G}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>G</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mi>G</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>r</mi><mi>G</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">S_{G}\in\mathbb{R}^{r_{G}\times r_{G}}</annotation></semantics></math>, <math id="A3.Thmproposition2.p1.m3" class="ltx_Math" alttext="V_{G}\in\mathbb{R}^{p\times r_{G}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>G</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>r</mi><mi>G</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">V_{G}\in\mathbb{R}^{p\times r_{G}}</annotation></semantics></math>, and <math id="A3.Thmproposition2.p1.m4" class="ltx_Math" alttext="r_{G}=\operatorname{rank}(G)\leq\min(n,p)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>G</mi></msub><mo>=</mo><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{G}=\operatorname{rank}(G)\leq\min(n,p)</annotation></semantics></math> and <math id="A3.Thmproposition2.p1.m5" class="ltx_Math" alttext="\tilde{\Sigma}=V_{G}^{\top}\Sigma_{\theta}V_{G}\in\mathbb{R}^{r_{G}\times r_{G}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo>=</mo><mrow><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>G</mi></msub></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mi>G</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>r</mi><mi>G</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}=V_{G}^{\top}\Sigma_{\theta}V_{G}\in\mathbb{R}^{r_{G}\times r_{G}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p12" class="ltx_para">
<p id="A3.SS1.p12.1" class="ltx_p"><span id="A3.SS1.p12.1.1" class="ltx_text">Writing <math id="A3.SS1.p12.m1" class="ltx_Math" alttext="G=U_{G}\,S_{G}\,V_{G}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">G=U_{G}\,S_{G}\,V_{G}^{\top}</annotation></semantics></math> so then</span></p>
<table id="A3.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E27.m1" class="ltx_Math" alttext="C=U_{G}\,S_{G}\,V_{G}^{\top}\,\Sigma_{\theta}\,V_{G}\,S_{G}\,U_{G}^{\top}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C=U_{G}\,S_{G}\,V_{G}^{\top}\,\Sigma_{\theta}\,V_{G}\,S_{G}\,U_{G}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p12.2" class="ltx_p"><span id="A3.SS1.p12.2.1" class="ltx_text">and then setting <math id="A3.SS1.p12.m2" class="ltx_Math" alttext="\tilde{\Sigma}=V_{G}^{\top}\Sigma_{\theta}V_{G}\in\mathbb{R}^{r_{G}\times r_{G}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo>=</mo><mrow><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>G</mi></msub></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mi>G</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>r</mi><mi>G</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}=V_{G}^{\top}\Sigma_{\theta}V_{G}\in\mathbb{R}^{r_{G}\times r_{G}}</annotation></semantics></math> we get the result.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>2-RDM for Phase Transitions</h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">Here we show that the SHC is an early warning signal at leading
order for any second-order phase transition as it detects critical slowing down<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">38</a>]</cite>. We start with the Gaussian 2RDM as this admits a particularly clean result:</p>
</div>
<div id="A3.Thmproposition3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition3.2" class="ltx_text ltx_font_bold">Proposition C.3</span></span><span id="A3.Thmproposition3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition3.p1" class="ltx_para">
<p id="A3.Thmproposition3.p1.1" class="ltx_p"><span id="A3.Thmproposition3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmproposition3.p1.m1" class="ltx_Math" alttext="C^{\sigma}=\sigma^{2}GG^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>σ</mi></msup><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C^{\sigma}=\sigma^{2}GG^{\top}</annotation></semantics></math> be the Gaussian <math id="A3.Thmproposition3.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>RDM for <math id="A3.Thmproposition3.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> probe samples, with <math id="A3.Thmproposition3.p1.m4" class="ltx_Math" alttext="G\in\mathbb{R}^{n\times p}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">G\in\mathbb{R}^{n\times p}</annotation></semantics></math>. Let</span></p>
<table id="A3.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E28.m1" class="ltx_Math" alttext="\mathbf{s}=(s_{1},\dots,s_{r},0,\dots,0)\in\mathbb{R}^{n}" display="block" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mi>r</mi></msub><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{s}=(s_{1},\dots,s_{r},0,\dots,0)\in\mathbb{R}^{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition3.p1.2" class="ltx_p"><span id="A3.Thmproposition3.p1.2.1" class="ltx_text ltx_font_italic">be the padded vector of eigenvalues of <math id="A3.Thmproposition3.p1.m5" class="ltx_Math" alttext="GG^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">GG^{\top}</annotation></semantics></math> (equivalently, the squared singular values of <math id="A3.Thmproposition3.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>). Then</span></p>
<table id="A3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E29.m1" class="ltx_Math" alttext="\operatorname{SHC}(C^{\sigma})=\operatorname{Var}(\lambda(C^{\sigma}))=\sigma^{4}\operatorname{Var}(\mathbf{s})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>σ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>σ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{SHC}(C^{\sigma})=\operatorname{Var}(\lambda(C^{\sigma}))=\sigma^{4}\operatorname{Var}(\mathbf{s}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition3.p1.3" class="ltx_p"><span id="A3.Thmproposition3.p1.3.1" class="ltx_text ltx_font_italic">which is Schur-convex in <math id="A3.Thmproposition3.p1.m7" class="ltx_Math" alttext="\mathbf{s}" display="inline" intent=":literal"><semantics><mi>𝐬</mi><annotation encoding="application/x-tex">\mathbf{s}</annotation></semantics></math>. In particular, if <math id="A3.Thmproposition3.p1.m8" class="ltx_Math" alttext="\mathbf{s}(t_{2})" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}(t_{2})</annotation></semantics></math> majorizes <math id="A3.Thmproposition3.p1.m9" class="ltx_Math" alttext="\mathbf{s}(t_{1})" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}(t_{1})</annotation></semantics></math> with equal trace, then</span></p>
<table id="A3.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E30.m1" class="ltx_Math" alttext="\operatorname{SHC}(t_{2})\geq\operatorname{SHC}(t_{1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{SHC}(t_{2})\geq\operatorname{SHC}(t_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A3.Thmproposition3.p1.4" class="ltx_p"><span id="A3.Thmproposition3.p1.4.1" class="ltx_text ltx_font_italic">with strict inequality unless the spectra differ only by permutation.</span></p>
</div>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text">The eigenvalues of <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="C^{\sigma}=\sigma^{2}GG^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>σ</mi></msup><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C^{\sigma}=\sigma^{2}GG^{\top}</annotation></semantics></math> are <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="\lambda_{i}=\sigma^{2}s_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i}=\sigma^{2}s_{i}</annotation></semantics></math>, so</span></p>
<table id="A3.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E31.m1" class="ltx_Math" alttext="\operatorname{SHC}(C^{\sigma})=\operatorname{Var}(\lambda)=\operatorname{Var}(\sigma^{2}\mathbf{s})=\sigma^{4}\operatorname{Var}(\mathbf{s})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>SHC</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>σ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐬</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{SHC}(C^{\sigma})=\operatorname{Var}(\lambda)=\operatorname{Var}(\sigma^{2}\mathbf{s})=\sigma^{4}\operatorname{Var}(\mathbf{s}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p"><span id="A3.SS2.p2.2.1" class="ltx_text">Since</span></p>
<table id="A3.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E32.m1" class="ltx_Math" alttext="\operatorname{Var}(\mathbf{s})=\frac{1}{n}\sum_{i}s_{i}^{2}-\frac{1}{n^{2}}\left(\sum_{i}s_{i}\right)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><msubsup><mi>s</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>i</mi></munder><msub><mi>s</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}(\mathbf{s})=\frac{1}{n}\sum_{i}s_{i}^{2}-\frac{1}{n^{2}}\left(\sum_{i}s_{i}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p"><span id="A3.SS2.p2.3.1" class="ltx_text">it is (up to an additive constant under fixed trace) a symmetric convex function of <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="\mathbf{s}" display="inline" intent=":literal"><semantics><mi>𝐬</mi><annotation encoding="application/x-tex">\mathbf{s}</annotation></semantics></math>, hence Schur-convex. The majorization claim follows.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p3" class="ltx_para">
<p id="A3.SS2.p3.1" class="ltx_p">The argument requires only the first-order factorisation
<math id="A3.SS2.p3.m1" class="ltx_Math" alttext="C\approx G\Sigma_{\theta}G^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>≈</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C\approx G\Sigma_{\theta}G^{\top}</annotation></semantics></math> and the defining property of critical
slowing down.</p>
</div>
<div id="A3.Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition C.1</span></span><span id="A3.Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Critical slowing down along a direction)<span id="A3.Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmdefinition1.p1" class="ltx_para">
<p id="A3.Thmdefinition1.p1.1" class="ltx_p">We say that training exhibits critical slowing down along a
parameter-space direction <math id="A3.Thmdefinition1.p1.m1" class="ltx_Math" alttext="v\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">v\in\mathbb{R}^{p}</annotation></semantics></math> on an interval
<math id="A3.Thmdefinition1.p1.m2" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math> if the directional dynamical variance</p>
<table id="A3.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E33.m1" class="ltx_Math" alttext="\sigma_{v}^{2}(t)\;:=\;v^{\top}\Sigma_{\theta}(t)\,v" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">:=</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma_{v}^{2}(t)\;:=\;v^{\top}\Sigma_{\theta}(t)\,v</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A3.Thmdefinition1.p1.2" class="ltx_p">is monotonically increasing (and diverging) on <math id="A3.Thmdefinition1.p1.m3" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math>, where <math id="A3.Thmdefinition1.p1.m4" class="ltx_Math" alttext="t^{*}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">t^{*}</annotation></semantics></math> is the
transition time.</p>
</div>
</div>
<div id="A3.Thmproposition4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition4.2" class="ltx_text ltx_font_bold">Proposition C.4</span></span><span id="A3.Thmproposition4.3" class="ltx_text ltx_font_bold"> </span>(First-order early warning)<span id="A3.Thmproposition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition4.p1" class="ltx_para">
<p id="A3.Thmproposition4.p1.1" class="ltx_p"><span id="A3.Thmproposition4.p1.1.1" class="ltx_text ltx_font_italic">Suppose training exhibits critical slowing down along direction <math id="A3.Thmproposition4.p1.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> on
<math id="A3.Thmproposition4.p1.m2" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math> in the sense of Definition <a href="#A3.Thmdefinition1" title="Definition C.1 (Critical slowing down along a direction). ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>. Suppose further
that:</span></p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p"><span id="A3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">The probe set couples to </span><math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math><span id="A3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">: the response vector
</span><math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="u_{v}:=Gv\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>v</mi></msub><mo>:=</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">u_{v}:=Gv\in\mathbb{R}^{n}</annotation></semantics></math><span id="A3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> satisfies </span><math id="A3.I1.i1.p1.m3" class="ltx_Math" alttext="u_{v}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>v</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{v}\neq 0</annotation></semantics></math><span id="A3.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> and is not
proportional to </span><math id="A3.I1.i1.p1.m4" class="ltx_Math" alttext="\mathbf{1}" display="inline" intent=":literal"><semantics><mn>𝟏</mn><annotation encoding="application/x-tex">\mathbf{1}</annotation></semantics></math><span id="A3.I1.i1.p1.1.5" class="ltx_text ltx_font_italic"> (i.e., not all samples respond
identically to perturbations along </span><math id="A3.I1.i1.p1.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math><span id="A3.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p"><span id="A3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The remaining dynamical variances are bounded: the eigenvalues of
</span><math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}(t)</annotation></semantics></math><span id="A3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> orthogonal to </span><math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math><span id="A3.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> are uniformly bounded on
</span><math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math><span id="A3.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="A3.Thmproposition4.p1.2" class="ltx_p"><span id="A3.Thmproposition4.p1.2.1" class="ltx_text ltx_font_italic">Then the SHC <math id="A3.Thmproposition4.p1.m3" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C(t)))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C(t)))</annotation></semantics></math> is strictly
increasing on <math id="A3.Thmproposition4.p1.m4" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p4" class="ltx_para">
<p id="A3.SS2.p4.1" class="ltx_p"><span id="A3.SS2.p4.1.1" class="ltx_text">Decompose the dynamical covariance as</span></p>
<table id="A3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex1.m1" class="ltx_Math" alttext="\Sigma_{\theta}(t)=\sigma_{v}^{2}(t)\,vv^{\top}+\Sigma_{\perp}(t)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}(t)=\sigma_{v}^{2}(t)\,vv^{\top}+\Sigma_{\perp}(t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p4.2" class="ltx_p"><span id="A3.SS2.p4.2.1" class="ltx_text">where <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\Sigma_{\perp}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\perp}(t)</annotation></semantics></math> is the component orthogonal to <math id="A3.SS2.p4.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>.
Under the first-order approximation, the loss covariance decomposes as</span></p>
<table id="A3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex2.m1" class="ltx_Math" alttext="C(t)\approx\sigma_{v}^{2}(t)\,u_{v}u_{v}^{\top}+G\,\Sigma_{\perp}(t)\,G^{\top}=:\sigma_{v}^{2}(t)\,u_{v}u_{v}^{\top}+C_{\perp}(t)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C(t)\approx\sigma_{v}^{2}(t)\,u_{v}u_{v}^{\top}+G\,\Sigma_{\perp}(t)\,G^{\top}=:\sigma_{v}^{2}(t)\,u_{v}u_{v}^{\top}+C_{\perp}(t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p4.3" class="ltx_p"><span id="A3.SS2.p4.3.1" class="ltx_text">where <math id="A3.SS2.p4.m3" class="ltx_Math" alttext="u_{v}=Gv" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>v</mi></msub><mo>=</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">u_{v}=Gv</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p5" class="ltx_para">
<p id="A3.SS2.p5.1" class="ltx_p"><span id="A3.SS2.p5.1.1" class="ltx_text">The eigenvalue variance of a symmetric matrix <math id="A3.SS2.p5.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> satisfies</span></p>
<table id="A3.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E34.m1" class="ltx_Math" alttext="\mathrm{Var}(\lambda(A))=\frac{1}{n}\|A\|_{F}^{2}-\frac{1}{n^{2}}(\operatorname{tr}A)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(A))=\frac{1}{n}\|A\|_{F}^{2}-\frac{1}{n^{2}}(\operatorname{tr}A)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.2" class="ltx_p"><span id="A3.SS2.p5.2.1" class="ltx_text">Writing <math id="A3.SS2.p5.m2" class="ltx_Math" alttext="R=u_{v}u_{v}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><msub><mi>u</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">R=u_{v}u_{v}^{\top}</annotation></semantics></math> and <math id="A3.SS2.p5.m3" class="ltx_Math" alttext="\alpha(t)=\sigma_{v}^{2}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha(t)=\sigma_{v}^{2}(t)</annotation></semantics></math>, we have
<math id="A3.SS2.p5.m4" class="ltx_Math" alttext="C(t)=\alpha(t)R+C_{\perp}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C(t)=\alpha(t)R+C_{\perp}(t)</annotation></semantics></math>. Expanding:</span></p>
<table id="A3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle\|C(t)\|_{F}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|C(t)\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m2" class="ltx_Math" alttext="\displaystyle=\alpha^{2}\|R\|_{F}^{2}+2\alpha\langle R,C_{\perp}\rangle_{F}+\|C_{\perp}\|_{F}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>R</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha^{2}\|R\|_{F}^{2}+2\alpha\langle R,C_{\perp}\rangle_{F}+\|C_{\perp}\|_{F}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle(\operatorname{tr}C(t))^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle(\operatorname{tr}C(t))^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m2" class="ltx_Math" alttext="\displaystyle=\alpha^{2}(\operatorname{tr}R)^{2}+2\alpha\,\operatorname{tr}(R)\operatorname{tr}(C_{\perp})+(\operatorname{tr}C_{\perp})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha^{2}(\operatorname{tr}R)^{2}+2\alpha\,\operatorname{tr}(R)\operatorname{tr}(C_{\perp})+(\operatorname{tr}C_{\perp})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p5.3" class="ltx_p"><span id="A3.SS2.p5.3.1" class="ltx_text">Since <math id="A3.SS2.p5.m5" class="ltx_Math" alttext="R=u_{v}u_{v}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><msub><mi>u</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">R=u_{v}u_{v}^{\top}</annotation></semantics></math> is rank one,
<math id="A3.SS2.p5.m6" class="ltx_Math" alttext="\|R\|_{F}^{2}=\|u_{v}\|^{4}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>R</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>=</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\|R\|_{F}^{2}=\|u_{v}\|^{4}</annotation></semantics></math> and <math id="A3.SS2.p5.m7" class="ltx_Math" alttext="(\operatorname{tr}R)^{2}=\|u_{v}\|^{4}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">(\operatorname{tr}R)^{2}=\|u_{v}\|^{4}</annotation></semantics></math>.
Hence the <math id="A3.SS2.p5.m8" class="ltx_Math" alttext="\alpha^{2}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\alpha^{2}</annotation></semantics></math> terms in (<a href="#A3.E35" title="In Proof. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>)
and (<a href="#A3.E36" title="In Proof. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) contribute</span></p>
<table id="A3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex3.m1" class="ltx_Math" alttext="\frac{\alpha^{2}}{n}\|u_{v}\|^{4}-\frac{\alpha^{2}}{n^{2}}\|u_{v}\|^{4}=\frac{\alpha^{2}}{n}\|u_{v}\|^{4}\!\left(1-\frac{1}{n}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>α</mi><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><mo>−</mo><mrow><mfrac><msup><mi>α</mi><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mi>α</mi><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\alpha^{2}}{n}\|u_{v}\|^{4}-\frac{\alpha^{2}}{n^{2}}\|u_{v}\|^{4}=\frac{\alpha^{2}}{n}\|u_{v}\|^{4}\!\left(1-\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p5.4" class="ltx_p"><span id="A3.SS2.p5.4.1" class="ltx_text">to <math id="A3.SS2.p5.m9" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C))</annotation></semantics></math>, and the cross terms contribute</span></p>
<table id="A3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex4.m1" class="ltx_Math" alttext="\frac{2\alpha}{n}\langle R,C_{\perp}\rangle_{F}-\frac{2\alpha}{n^{2}}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})=\frac{2\alpha}{n}\!\left(\langle R,C_{\perp}\rangle_{F}-\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub></mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{2\alpha}{n}\langle R,C_{\perp}\rangle_{F}-\frac{2\alpha}{n^{2}}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})=\frac{2\alpha}{n}\!\left(\langle R,C_{\perp}\rangle_{F}-\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p5.5" class="ltx_p"><span id="A3.SS2.p5.5.1" class="ltx_text">Thus</span></p>
<table id="A3.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E37.m1" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C))=\underbrace{\frac{\alpha^{2}}{n}\|u_{v}\|^{4}\!\left(1-\frac{1}{n}\right)}_{T_{1}(\alpha)}+\underbrace{\frac{2\alpha}{n}\!\left(\langle R,C_{\perp}\rangle_{F}-\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})\right)}_{T_{2}(\alpha)}+\underbrace{\mathrm{Var}(\lambda(C_{\perp}))}_{T_{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mfrac><msup><mi>α</mi><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><msub><mi>T</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><msub><mi>T</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>T</mi><mn>3</mn></msub></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C))=\underbrace{\frac{\alpha^{2}}{n}\|u_{v}\|^{4}\!\left(1-\frac{1}{n}\right)}_{T_{1}(\alpha)}+\underbrace{\frac{2\alpha}{n}\!\left(\langle R,C_{\perp}\rangle_{F}-\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})\right)}_{T_{2}(\alpha)}+\underbrace{\mathrm{Var}(\lambda(C_{\perp}))}_{T_{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p6" class="ltx_para">
<p id="A3.SS2.p6.1" class="ltx_p"><span id="A3.SS2.p6.1.1" class="ltx_text">Now we analyze the monotonicity in <math id="A3.SS2.p6.m1" class="ltx_Math" alttext="\alpha=\sigma_{v}^{2}(t)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=\sigma_{v}^{2}(t)</annotation></semantics></math>, which is
increasing by assumption.</span></p>
<ul id="A3.I2" class="ltx_itemize">
<li id="A3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i1.p1" class="ltx_para">
<p id="A3.I2.i1.p1.1" class="ltx_p"><span id="A3.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Term <math id="A3.I2.i1.p1.m1" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>:</span> This is <math id="A3.I2.i1.p1.m2" class="ltx_Math" alttext="\frac{n-1}{n^{2}}\|u_{v}\|^{4}\cdot\alpha^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><mo rspace="0.222em">⋅</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\frac{n-1}{n^{2}}\|u_{v}\|^{4}\cdot\alpha^{2}</annotation></semantics></math>,
which is strictly increasing in <math id="A3.I2.i1.p1.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> for <math id="A3.I2.i1.p1.m4" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math> and <math id="A3.I2.i1.p1.m5" class="ltx_Math" alttext="u_{v}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>v</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{v}\neq 0</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i2.p1" class="ltx_para">
<p id="A3.I2.i2.p1.1" class="ltx_p"><span id="A3.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Term <math id="A3.I2.i2.p1.m1" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math>:</span> Note that
<math id="A3.I2.i2.p1.m2" class="ltx_Math" alttext="\langle R,C_{\perp}\rangle_{F}=u_{v}^{\top}C_{\perp}u_{v}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>R</mi><mo>,</mo><msub><mi>C</mi><mo>⟂</mo></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle R,C_{\perp}\rangle_{F}=u_{v}^{\top}C_{\perp}u_{v}\geq 0</annotation></semantics></math> since
<math id="A3.I2.i2.p1.m3" class="ltx_Math" alttext="C_{\perp}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>⟂</mo></msub><annotation encoding="application/x-tex">C_{\perp}</annotation></semantics></math> is positive semidefinite. Also
<math id="A3.I2.i2.p1.m4" class="ltx_Math" alttext="\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})=\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n}\operatorname{tr}(R)\operatorname{tr}(C_{\perp})=\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})</annotation></semantics></math>.
This term is linear in <math id="A3.I2.i2.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> with a coefficient that is bounded
(since <math id="A3.I2.i2.p1.m6" class="ltx_Math" alttext="C_{\perp}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>⟂</mo></msub><annotation encoding="application/x-tex">C_{\perp}</annotation></semantics></math> is bounded).</p>
</div></li>
<li id="A3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i3.p1" class="ltx_para">
<p id="A3.I2.i3.p1.1" class="ltx_p"><span id="A3.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Term <math id="A3.I2.i3.p1.m1" class="ltx_Math" alttext="T_{3}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>3</mn></msub><annotation encoding="application/x-tex">T_{3}</annotation></semantics></math>:</span> Since the eigenvalues of <math id="A3.I2.i3.p1.m2" class="ltx_Math" alttext="\Sigma_{\perp}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\perp}(t)</annotation></semantics></math> are
bounded by assumption, <math id="A3.I2.i3.p1.m3" class="ltx_Math" alttext="T_{3}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>3</mn></msub><annotation encoding="application/x-tex">T_{3}</annotation></semantics></math> is bounded on <math id="A3.I2.i3.p1.m4" class="ltx_Math" alttext="[t_{0},t^{*}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t_{0},t^{*}]</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A3.SS2.p7" class="ltx_para">
<p id="A3.SS2.p7.1" class="ltx_p"><span id="A3.SS2.p7.1.1" class="ltx_text">Since <math id="A3.SS2.p7.m1" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math> grows as <math id="A3.SS2.p7.m2" class="ltx_Math" alttext="\alpha^{2}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\alpha^{2}</annotation></semantics></math>, <math id="A3.SS2.p7.m3" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math> grows at most as <math id="A3.SS2.p7.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, and
<math id="A3.SS2.p7.m5" class="ltx_Math" alttext="T_{3}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>3</mn></msub><annotation encoding="application/x-tex">T_{3}</annotation></semantics></math> is bounded, the derivative</span></p>
<table id="A3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex5.m1" class="ltx_Math" alttext="\frac{d}{d\alpha}\mathrm{Var}(\lambda(C))=\frac{2(n-1)}{n^{2}}\|u_{v}\|^{4}\,\alpha+\frac{2}{n}\!\left(u_{v}^{\top}C_{\perp}u_{v}-\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})\right)" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub></mrow><mo>−</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{d\alpha}\mathrm{Var}(\lambda(C))=\frac{2(n-1)}{n^{2}}\|u_{v}\|^{4}\,\alpha+\frac{2}{n}\!\left(u_{v}^{\top}C_{\perp}u_{v}-\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p7.2" class="ltx_p"><span id="A3.SS2.p7.2.1" class="ltx_text">is strictly positive for all sufficiently large <math id="A3.SS2.p7.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, and in
particular is positive once</span></p>
<table id="A3.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E38.m1" class="ltx_Math" alttext="\alpha&gt;\frac{\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})-u_{v}^{\top}C_{\perp}u_{v}}{\frac{n-1}{n}\|u_{v}\|^{4}}" display="block" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mfrac><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub></mrow></mrow><mrow><mfrac><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha&gt;\frac{\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})-u_{v}^{\top}C_{\perp}u_{v}}{\frac{n-1}{n}\|u_{v}\|^{4}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p7.3" class="ltx_p"><span id="A3.SS2.p7.3.1" class="ltx_text">(with the right-hand side being non-positive whenever
<math id="A3.SS2.p7.m7" class="ltx_Math" alttext="u_{v}^{\top}C_{\perp}u_{v}\geq\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>v</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub></mrow><mo>≥</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>u</mi><mi>v</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mo>⟂</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{v}^{\top}C_{\perp}u_{v}\geq\frac{\|u_{v}\|^{2}}{n}\operatorname{tr}(C_{\perp})</annotation></semantics></math>,
which holds when <math id="A3.SS2.p7.m8" class="ltx_Math" alttext="u_{v}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>v</mi></msub><annotation encoding="application/x-tex">u_{v}</annotation></semantics></math> is not concentrated in the null space of <math id="A3.SS2.p7.m9" class="ltx_Math" alttext="C_{\perp}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>⟂</mo></msub><annotation encoding="application/x-tex">C_{\perp}</annotation></semantics></math>).</span></p>
</div>
<div id="A3.SS2.p8" class="ltx_para">
<p id="A3.SS2.p8.1" class="ltx_p"><span id="A3.SS2.p8.1.1" class="ltx_text">In the regime relevant to critical slowing down, <math id="A3.SS2.p8.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is
growing without bound (or at least growing large relative to the bounded
background), so the <math id="A3.SS2.p8.m2" class="ltx_Math" alttext="\alpha^{2}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\alpha^{2}</annotation></semantics></math> term dominates. More precisely: since
<math id="A3.SS2.p8.m3" class="ltx_Math" alttext="\sigma_{v}^{2}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{v}^{2}(t)</annotation></semantics></math> is monotonically increasing and unbounded as <math id="A3.SS2.p8.m4" class="ltx_Math" alttext="t\to t^{*}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>t</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">t\to t^{*}</annotation></semantics></math>
(the hallmark of critical slowing down), while <math id="A3.SS2.p8.m5" class="ltx_Math" alttext="C_{\perp}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>⟂</mo></msub><annotation encoding="application/x-tex">C_{\perp}</annotation></semantics></math> remains bounded,
there exists <math id="A3.SS2.p8.m6" class="ltx_Math" alttext="t_{1}\in[t_{0},t^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t_{1}\in[t_{0},t^{*})</annotation></semantics></math> such that the derivative is strictly
positive on <math id="A3.SS2.p8.m7" class="ltx_Math" alttext="[t_{1},t^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[t_{1},t^{*})</annotation></semantics></math>. Hence <math id="A3.SS2.p8.m8" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C(t)))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C(t)))</annotation></semantics></math> is strictly
increasing on <math id="A3.SS2.p8.m9" class="ltx_Math" alttext="[t_{1},t^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[t_{1},t^{*})</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p9" class="ltx_para">
<p id="A3.SS2.p9.1" class="ltx_p"><span id="A3.SS2.p9.1.1" class="ltx_text">If additionally <math id="A3.SS2.p9.m1" class="ltx_Math" alttext="u_{v}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>v</mi></msub><annotation encoding="application/x-tex">u_{v}</annotation></semantics></math> is not proportional to <math id="A3.SS2.p9.m2" class="ltx_Math" alttext="\mathbf{1}" display="inline" intent=":literal"><semantics><mn>𝟏</mn><annotation encoding="application/x-tex">\mathbf{1}</annotation></semantics></math> (so the
response is not uniform across samples), then even at moderate <math id="A3.SS2.p9.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>
the condition (<a href="#A3.E38" title="In Proof. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) is typically satisfied, and the
SHC begins increasing early in the approach to the critical point.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p10" class="ltx_para">
<p id="A3.SS2.p10.1" class="ltx_p">Now we examine how the 2RDM decomposes along dynamics. Consider the loss fluctuation on sample <math id="A3.SS2.p10.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is <math id="A3.SS2.p10.m2" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}</annotation></semantics></math>. Adding the centered second order correction gives:</p>
<table id="A3.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E39.m1" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}+\frac{1}{2}\!\left(\delta\theta_{t}^{\top}H_{i}\,\delta\theta_{t}-\operatorname{tr}(H_{i}\Sigma_{\theta})\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}+\frac{1}{2}\!\left(\delta\theta_{t}^{\top}H_{i}\,\delta\theta_{t}-\operatorname{tr}(H_{i}\Sigma_{\theta})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p10.2" class="ltx_p">Define <math id="A3.SS2.p10.m3" class="ltx_Math" alttext="q_{i}(\delta\theta)=\frac{1}{2}(\delta\theta^{\top}H_{i}\,\delta\theta-\operatorname{tr}(H_{i}\Sigma_{\theta}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>−</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{i}(\delta\theta)=\frac{1}{2}(\delta\theta^{\top}H_{i}\,\delta\theta-\operatorname{tr}(H_{i}\Sigma_{\theta}))</annotation></semantics></math>, the centered quadratic response of sample <math id="A3.SS2.p10.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. The covariance becomes:</p>
<table id="A3.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E40.m1" class="ltx_Math" alttext="C_{ij}\approx C_{ij}^{(1)}+g_{i}^{\top}\!\operatorname{Cov}_{\mathcal{W}}\!\big[\delta\theta_{t},\;q_{j}(\delta\theta_{t})\big]+\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;\delta\theta_{t}\big]^{\top}g_{j}+\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;q_{j}(\delta\theta_{t})\big]" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≈</mo><mrow><msubsup><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>Cov</mi><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>q</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><msub><mi>Cov</mi><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub><mo>⁡</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><msub><mi>Cov</mi><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>q</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{ij}\approx C_{ij}^{(1)}+g_{i}^{\top}\!\operatorname{Cov}_{\mathcal{W}}\!\big[\delta\theta_{t},\;q_{j}(\delta\theta_{t})\big]+\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;\delta\theta_{t}\big]^{\top}g_{j}+\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;q_{j}(\delta\theta_{t})\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p10.3" class="ltx_p">which means the quadratic contribution is</p>
<table id="A3.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E41.m1" class="ltx_Math" alttext="\Delta_{ij}=\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;q_{j}(\delta\theta_{t})\big]=\frac{1}{4}\operatorname{Cov}_{\mathcal{W}}\!\big[\delta\theta_{t}^{\top}H_{i}\,\delta\theta_{t},\;\delta\theta_{t}^{\top}H_{j}\,\delta\theta_{t}\big]" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>Cov</mi><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>q</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>Cov</mi><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{ij}=\operatorname{Cov}_{\mathcal{W}}\!\big[q_{i}(\delta\theta_{t}),\;q_{j}(\delta\theta_{t})\big]=\frac{1}{4}\operatorname{Cov}_{\mathcal{W}}\!\big[\delta\theta_{t}^{\top}H_{i}\,\delta\theta_{t},\;\delta\theta_{t}^{\top}H_{j}\,\delta\theta_{t}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p10.4" class="ltx_p">Now if the fluctuations are approximately gaussian, by Isserlis’ theorem</p>
<table id="A3.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E42.m1" class="ltx_Math" alttext="\Delta_{ij}\approx\frac{1}{2}\operatorname{tr}(H_{i}\,\Sigma_{\theta}\,H_{j}\,\Sigma_{\theta})" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≈</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{ij}\approx\frac{1}{2}\operatorname{tr}(H_{i}\,\Sigma_{\theta}\,H_{j}\,\Sigma_{\theta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p10.5" class="ltx_p">where the cross terms are dropped under the Gaussian assumption.</p>
</div>
<div id="A3.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma C.2</span></span><span id="A3.Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma2.p1" class="ltx_para">
<p id="A3.Thmlemma2.p1.1" class="ltx_p"><span id="A3.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">If we have that the dynamical covariance is rank 1 so <math id="A3.Thmlemma2.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}=\sigma^{2}vv^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}=\sigma^{2}vv^{\top}</annotation></semantics></math> then <math id="A3.Thmlemma2.p1.m2" class="ltx_Math" alttext="\langle C^{(1)},\Delta\rangle_{F}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle C^{(1)},\Delta\rangle_{F}\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p11" class="ltx_para">
<p id="A3.SS2.p11.1" class="ltx_p"><span id="A3.SS2.p11.1.1" class="ltx_text">If <math id="A3.SS2.p11.m1" class="ltx_Math" alttext="\Sigma_{\theta}=\sigma^{2}vv^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}=\sigma^{2}vv^{\top}</annotation></semantics></math> then we must have that <math id="A3.SS2.p11.m2" class="ltx_Math" alttext="C^{(1)_{ij}}=\sigma^{2}(g_{i}^{\top}v)(g_{j}^{\top}v)" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><msub><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msup><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C^{(1)_{ij}}=\sigma^{2}(g_{i}^{\top}v)(g_{j}^{\top}v)</annotation></semantics></math>. Now setting <math id="A3.SS2.p11.m3" class="ltx_Math" alttext="a_{i}=g_{i}^{\top}v" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">a_{i}=g_{i}^{\top}v</annotation></semantics></math>. Now substituting into equation <a href="#A3.E42" title="In C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a> we get</span></p>
<table id="A3.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E43.m1" class="ltx_Math" alttext="\Delta_{ij}\approx\frac{\sigma^{4}}{2}\operatorname{tr}(H_{i}\,vv^{\top}\,H_{j}\,vv^{\top})" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≈</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{ij}\approx\frac{\sigma^{4}}{2}\operatorname{tr}(H_{i}\,vv^{\top}\,H_{j}\,vv^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p11.2" class="ltx_p"><span id="A3.SS2.p11.2.1" class="ltx_text">then by the cyclic property of the trace</span></p>
<table id="A3.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E44.m1" class="ltx_Math" alttext="=\sigma^{4}(vH_{i}v^{\top})(vH_{j}v^{\top})" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>σ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">=\sigma^{4}(vH_{i}v^{\top})(vH_{j}v^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p11.3" class="ltx_p"><span id="A3.SS2.p11.3.1" class="ltx_text">now setting <math id="A3.SS2.p11.m4" class="ltx_Math" alttext="(vH_{i}v^{\top})=b_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">(vH_{i}v^{\top})=b_{i}</annotation></semantics></math> we get</span></p>
<table id="A3.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E45.m1" class="ltx_Math" alttext="\Delta_{ij}\approx\frac{\sigma^{4}}{2}b_{i}b_{j}" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≈</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{ij}\approx\frac{\sigma^{4}}{2}b_{i}b_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p11.4" class="ltx_p"><span id="A3.SS2.p11.4.1" class="ltx_text">so then</span></p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\langle C^{(1)},\Delta\rangle_{F}=\sum_{ij}\sigma^{2}a_{i}a_{j}(\frac{\sigma^{4}}{2}b_{i}b_{j})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\langle C^{(1)},\Delta\rangle_{F}=\sum_{ij}\sigma^{2}a_{i}a_{j}(\frac{\sigma^{4}}{2}b_{i}b_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<table id="A3.E47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E47.m1" class="ltx_Math" alttext="=\frac{\sigma^{6}}{2}(\sum_{i}a_{i}b_{i})^{2}" display="block" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>6</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">=\frac{\sigma^{6}}{2}(\sum_{i}a_{i}b_{i})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p11.5" class="ltx_p"><span id="A3.SS2.p11.5.1" class="ltx_text">so <math id="A3.SS2.p11.m5" class="ltx_Math" alttext="\langle C^{(1)},\Delta\rangle_{F}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle C^{(1)},\Delta\rangle_{F}\geq 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p12" class="ltx_para">
<p id="A3.SS2.p12.1" class="ltx_p">We now give the following theorem:</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose the dynamical covariance is rank one, <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}=\sigma^{2}vv^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}=\sigma^{2}vv^{\top}</annotation></semantics></math>,
so that <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="C^{(1)}_{ij}=\sigma^{2}a_{i}a_{j}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">C^{(1)}_{ij}=\sigma^{2}a_{i}a_{j}</annotation></semantics></math> and
<math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\Delta_{ij}=\frac{\sigma^{4}}{2}b_{i}b_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{ij}=\frac{\sigma^{4}}{2}b_{i}b_{j}</annotation></semantics></math> with
<math id="A3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="a_{i}=g_{i}^{\top}v" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">a_{i}=g_{i}^{\top}v</annotation></semantics></math> and <math id="A3.Thmtheorem1.p1.m5" class="ltx_Math" alttext="b_{i}=v^{\top}H_{i}v" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">b_{i}=v^{\top}H_{i}v</annotation></semantics></math>. If the per-sample Hessians are heterogeneous (<math id="A3.Thmtheorem1.p1.m6" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> is not a scalar multiple of <math id="A3.Thmtheorem1.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>) and</span></p>
<table id="A3.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E48.m1" class="ltx_Math" alttext="\cos^{2}\theta_{a,b}\;\geq\;\frac{1}{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>θ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub></mrow><mo rspace="0.558em">≥</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\cos^{2}\theta_{a,b}\;\geq\;\frac{1}{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p1.2" class="ltx_p"><span id="A3.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\theta_{a,b}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{a,b}</annotation></semantics></math> is the angle between <math id="A3.Thmtheorem1.p1.m9" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.Thmtheorem1.p1.m10" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> in <math id="A3.Thmtheorem1.p1.m11" class="ltx_Math" alttext="\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{n}</annotation></semantics></math>,
then the curvature correction <math id="A3.Thmtheorem1.p1.m12" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> strictly increases the variance of
the eigenvalue spectrum:
<math id="A3.Thmtheorem1.p1.m13" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C))&gt;\mathrm{Var}(\lambda(C^{(1)}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C))&gt;\mathrm{Var}(\lambda(C^{(1)}))</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p13" class="ltx_para">
<p id="A3.SS2.p13.1" class="ltx_p"><span id="A3.SS2.p13.1.1" class="ltx_text">Since both <math id="A3.SS2.p13.m1" class="ltx_Math" alttext="C^{(1)}=\sigma^{2}aa^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">C^{(1)}=\sigma^{2}aa^{\top}</annotation></semantics></math> and
<math id="A3.SS2.p13.m2" class="ltx_Math" alttext="\Delta=\frac{\sigma^{4}}{2}bb^{\top}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Delta=\frac{\sigma^{4}}{2}bb^{\top}</annotation></semantics></math> are rank one,
we can compute every term in the variance-change identity explicitly.
Recall that for a symmetric <math id="A3.SS2.p13.m3" class="ltx_Math" alttext="A\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{n\times n}</annotation></semantics></math>,</span></p>
<table id="A3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex6.m1" class="ltx_Math" alttext="\mathrm{Var}(\lambda(A))=\frac{1}{n}\|A\|_{F}^{2}-\frac{1}{n^{2}}(\operatorname{tr}A)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(A))=\frac{1}{n}\|A\|_{F}^{2}-\frac{1}{n^{2}}(\operatorname{tr}A)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.2" class="ltx_p"><span id="A3.SS2.p13.2.1" class="ltx_text">Since <math id="A3.SS2.p13.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> is positive semidefinite, adding it to <math id="A3.SS2.p13.m5" class="ltx_Math" alttext="C^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">C^{(1)}</annotation></semantics></math> increases <math id="A3.SS2.p13.m6" class="ltx_Math" alttext="\|C\|_{F}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mi>C</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|C\|_{F}^{2}</annotation></semantics></math> by at least <math id="A3.SS2.p13.m7" class="ltx_Math" alttext="2\langle C^{(1)},\Delta\rangle_{F}+\|\Delta\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">2\langle C^{(1)},\Delta\rangle_{F}+\|\Delta\|_{F}^{2}</annotation></semantics></math>, while <math id="A3.SS2.p13.m8" class="ltx_Math" alttext="(\operatorname{tr}C)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">(\operatorname{tr}C)^{2}</annotation></semantics></math> increases by <math id="A3.SS2.p13.m9" class="ltx_Math" alttext="2\operatorname{tr}(C^{(1)})\operatorname{tr}(\Delta)+(\operatorname{tr}\Delta)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">2\operatorname{tr}(C^{(1)})\operatorname{tr}(\Delta)+(\operatorname{tr}\Delta)^{2}</annotation></semantics></math>. That is, taking <math id="A3.SS2.p13.m10" class="ltx_Math" alttext="C=C^{(1)}+\Delta" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">C=C^{(1)}+\Delta</annotation></semantics></math>, then</span></p>
<table id="A3.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E49.m1" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C))-\mathrm{Var}(\lambda(C^{(1)}))=\frac{2}{n}\langle C^{(1)},\Delta\rangle_{F}+\frac{1}{n}\|\Delta\|_{F}^{2}-\frac{2}{n^{2}}\operatorname{tr}(C^{(1)})\operatorname{tr}(\Delta)-\frac{1}{n^{2}}(\operatorname{tr}\Delta)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>2</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mo>−</mo><mrow><mfrac><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C))-\mathrm{Var}(\lambda(C^{(1)}))=\frac{2}{n}\langle C^{(1)},\Delta\rangle_{F}+\frac{1}{n}\|\Delta\|_{F}^{2}-\frac{2}{n^{2}}\operatorname{tr}(C^{(1)})\operatorname{tr}(\Delta)-\frac{1}{n^{2}}(\operatorname{tr}\Delta)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p13.3" class="ltx_p"><span id="A3.SS2.p13.3.1" class="ltx_text">We now substitute the rank-one forms. Write
<math id="A3.SS2.p13.m11" class="ltx_Math" alttext="\|a\|^{2}=\sum_{i}a_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|a\|^{2}=\sum_{i}a_{i}^{2}</annotation></semantics></math>, <math id="A3.SS2.p13.m12" class="ltx_Math" alttext="\|b\|^{2}=\sum_{i}b_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|b\|^{2}=\sum_{i}b_{i}^{2}</annotation></semantics></math>, and
<math id="A3.SS2.p13.m13" class="ltx_Math" alttext="(a\cdot b)=\sum_{i}a_{i}b_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">(a\cdot b)=\sum_{i}a_{i}b_{i}</annotation></semantics></math>. Then:</span></p>
<table id="A3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex7.m1" class="ltx_Math" alttext="\displaystyle\langle C^{(1)},\Delta\rangle_{F}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\langle C^{(1)},\Delta\rangle_{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex7.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}\sigma^{2}a_{i}a_{j}\cdot\tfrac{\sigma^{4}}{2}b_{i}b_{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}\sigma^{2}a_{i}a_{j}\cdot\tfrac{\sigma^{4}}{2}b_{i}b_{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex7.m3" class="ltx_Math" alttext="\displaystyle=\tfrac{\sigma^{6}}{2}(a\cdot b)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>6</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tfrac{\sigma^{6}}{2}(a\cdot b)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex8.m1" class="ltx_Math" alttext="\displaystyle\|\Delta\|_{F}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|\Delta\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex8.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i,j}\bigl(\tfrac{\sigma^{4}}{2}\bigr)^{2}b_{i}^{2}b_{j}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i,j}\bigl(\tfrac{\sigma^{4}}{2}\bigr)^{2}b_{i}^{2}b_{j}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex8.m3" class="ltx_Math" alttext="\displaystyle=\tfrac{\sigma^{8}}{4}\|b\|^{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>8</mn></msup><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tfrac{\sigma^{8}}{4}\|b\|^{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\operatorname{tr}(C^{(1)})" display="inline" intent=":literal"><semantics><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{tr}(C^{(1)})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex9.m2" class="ltx_Math" alttext="\displaystyle=\sigma^{2}\|a\|^{2},\qquad\operatorname{tr}(\Delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma^{2}\|a\|^{2},\qquad\operatorname{tr}(\Delta)</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex9.m3" class="ltx_Math" alttext="\displaystyle=\tfrac{\sigma^{4}}{2}\|b\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>4</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tfrac{\sigma^{4}}{2}\|b\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.4" class="ltx_p"><span id="A3.SS2.p13.4.1" class="ltx_text">Substituting into (<a href="#A3.E49" title="In Proof. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>):</span></p>
<table id="A3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\lambda(C))-\mathrm{Var}(\lambda(C^{(1)}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\lambda(C))-\mathrm{Var}(\lambda(C^{(1)}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex10.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{6}}{n}(a\cdot b)^{2}+\frac{\sigma^{8}}{4n}\|b\|^{4}-\frac{\sigma^{6}}{n^{2}}\|a\|^{2}\|b\|^{2}-\frac{\sigma^{8}}{4n^{2}}\|b\|^{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>6</mn></msup><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>8</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>6</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>8</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma^{6}}{n}(a\cdot b)^{2}+\frac{\sigma^{8}}{4n}\|b\|^{4}-\frac{\sigma^{6}}{n^{2}}\|a\|^{2}\|b\|^{2}-\frac{\sigma^{8}}{4n^{2}}\|b\|^{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E50.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{6}}{n}\|a\|^{2}\|b\|^{2}\!\left(\cos^{2}\theta_{a,b}-\frac{1}{n}\right)+\frac{\sigma^{8}}{4n}\|b\|^{4}\!\left(1-\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>6</mn></msup><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>θ</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>8</mn></msup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>b</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma^{6}}{n}\|a\|^{2}\|b\|^{2}\!\left(\cos^{2}\theta_{a,b}-\frac{1}{n}\right)+\frac{\sigma^{8}}{4n}\|b\|^{4}\!\left(1-\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p13.5" class="ltx_p"><span id="A3.SS2.p13.5.1" class="ltx_text">The second term is strictly positive for <math id="A3.SS2.p13.m14" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math> whenever <math id="A3.SS2.p13.m15" class="ltx_Math" alttext="b\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b\neq 0</annotation></semantics></math>
(guaranteed by Hessian heterogeneity).
The first term is non-negative by the
assumption (<a href="#A3.E48" title="In Theorem C.1. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>).
Hence the full expression is strictly positive.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p14" class="ltx_para">
<p id="A3.SS2.p14.1" class="ltx_p">We now show that this rank 1 case allows for an interpretable decomposition:</p>
</div>
<div id="A3.Thmproposition5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition5.2" class="ltx_text ltx_font_bold">Proposition C.5</span></span><span id="A3.Thmproposition5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition5.p1" class="ltx_para">
<p id="A3.Thmproposition5.p1.1" class="ltx_p"><span id="A3.Thmproposition5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmproposition5.p1.m1" class="ltx_Math" alttext="S_{1},\dots S_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S_{1},\dots S_{k}</annotation></semantics></math> be sets of samples of interest and let <math id="A3.Thmproposition5.p1.m2" class="ltx_Math" alttext="G_{a}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>a</mi></msub><annotation encoding="application/x-tex">G_{a}</annotation></semantics></math> denote the submatrix of <math id="A3.Thmproposition5.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with rows indexed by <math id="A3.Thmproposition5.p1.m4" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math> then the following hold</span></p>
<ol id="A3.I3" class="ltx_enumerate">
<li id="A3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I3.i1.p1" class="ltx_para">
<p id="A3.I3.i1.p1.1" class="ltx_p"><span id="A3.I3.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Each diagonal block is a 2-RDM.</span><span id="A3.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> </span><math id="A3.I3.i1.p1.m1" class="ltx_Math" alttext="C_{S_{a},S_{a}}=G_{a}\Sigma_{\theta}G_{a}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo>=</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mi>a</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C_{S_{a},S_{a}}=G_{a}\Sigma_{\theta}G_{a}^{\top}</annotation></semantics></math><span id="A3.I3.i1.p1.1.3" class="ltx_text ltx_font_italic"> has the same form as the full 2-RDM with the same dynamical covariance </span><math id="A3.I3.i1.p1.m2" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math><span id="A3.I3.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I3.i2.p1" class="ltx_para">
<p id="A3.I3.i2.p1.1" class="ltx_p"><span id="A3.I3.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Selective coupling restores rank-1 structure.</span><span id="A3.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> Suppose </span><math id="A3.I3.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math><span id="A3.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> has spectral decomposition </span><math id="A3.I3.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{\theta}=\sum_{k}\sigma_{k}^{2}\,v_{k}v_{k}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}=\sum_{k}\sigma_{k}^{2}\,v_{k}v_{k}^{\top}</annotation></semantics></math><span id="A3.I3.i2.p1.1.4" class="ltx_text ltx_font_italic"> and group </span><math id="A3.I3.i2.p1.m3" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math><span id="A3.I3.i2.p1.1.5" class="ltx_text ltx_font_italic"> is selectively coupled to direction </span><math id="A3.I3.i2.p1.m4" class="ltx_Math" alttext="v_{k_{a}}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub><annotation encoding="application/x-tex">v_{k_{a}}</annotation></semantics></math><span id="A3.I3.i2.p1.1.6" class="ltx_text ltx_font_italic">, i.e., </span><math id="A3.I3.i2.p1.m5" class="ltx_Math" alttext="G_{a}v_{j}\approx 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">G_{a}v_{j}\approx 0</annotation></semantics></math><span id="A3.I3.i2.p1.1.7" class="ltx_text ltx_font_italic"> for </span><math id="A3.I3.i2.p1.m6" class="ltx_Math" alttext="j\neq k_{a}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msub><mi>k</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">j\neq k_{a}</annotation></semantics></math><span id="A3.I3.i2.p1.1.8" class="ltx_text ltx_font_italic">. Then</span></p>
<table id="A3.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E51.m1" class="ltx_Math" alttext="C_{S_{a},S_{a}}\approx\sigma_{k_{a}}^{2}\,(G_{a}v_{k_{a}})(G_{a}v_{k_{a}})^{\top}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo>≈</mo><mrow><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{S_{a},S_{a}}\approx\sigma_{k_{a}}^{2}\,(G_{a}v_{k_{a}})(G_{a}v_{k_{a}})^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A3.I3.i2.p1.2" class="ltx_p"><span id="A3.I3.i2.p1.2.1" class="ltx_text ltx_font_italic">which is rank-1.</span></p>
</div></li>
<li id="A3.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A3.I3.i3.p1" class="ltx_para">
<p id="A3.I3.i3.p1.1" class="ltx_p"><span id="A3.I3.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">The alignment condition holds within each block.</span><span id="A3.I3.i3.p1.1.2" class="ltx_text ltx_font_italic"> When (2) holds, let </span><math id="A3.I3.i3.p1.m1" class="ltx_Math" alttext="a_{i}^{(a)}=g_{i}^{\top}v_{k_{a}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">a_{i}^{(a)}=g_{i}^{\top}v_{k_{a}}</annotation></semantics></math><span id="A3.I3.i3.p1.1.3" class="ltx_text ltx_font_italic"> and
</span><math id="A3.I3.i3.p1.m2" class="ltx_Math" alttext="b_{i}^{(a)}=v_{k_{a}}^{\top}H_{i}v_{k_{a}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">b_{i}^{(a)}=v_{k_{a}}^{\top}H_{i}v_{k_{a}}</annotation></semantics></math><span id="A3.I3.i3.p1.1.4" class="ltx_text ltx_font_italic"> for </span><math id="A3.I3.i3.p1.m3" class="ltx_Math" alttext="i\in S_{a}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">i\in S_{a}</annotation></semantics></math><span id="A3.I3.i3.p1.1.5" class="ltx_text ltx_font_italic">.
If  </span><math id="A3.I3.i3.p1.m4" class="ltx_Math" alttext="\cos^{2}\theta_{a^{(a)},b^{(a)}}\geq 1/|S_{a}|" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>θ</mi><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></msup></mrow></msub></mrow><mo>≥</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">|</mo><msub><mi>S</mi><mi>a</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\cos^{2}\theta_{a^{(a)},b^{(a)}}\geq 1/|S_{a}|</annotation></semantics></math><span id="A3.I3.i3.p1.1.6" class="ltx_text ltx_font_italic">,
then Theorem </span><a href="#A3.Thmtheorem1" title="Theorem C.1. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">C.1</span></a><span id="A3.I3.i3.p1.1.7" class="ltx_text ltx_font_italic"> applies to the per-block spectral
heat capacity </span><math id="A3.I3.i3.p1.m5" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C_{S_{a},S_{a}}))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C_{S_{a},S_{a}}))</annotation></semantics></math><span id="A3.I3.i3.p1.1.8" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A3.SS2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p15" class="ltx_para">
<p id="A3.SS2.p15.1" class="ltx_p"><span id="A3.SS2.p15.1.1" class="ltx_text">Statement (1) is immediate from the factorization: <math id="A3.SS2.p15.m1" class="ltx_Math" alttext="C_{S_{a},S_{a}}=G_{a}\Sigma_{\theta}G_{a}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo>=</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>G</mi><mi>a</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C_{S_{a},S_{a}}=G_{a}\Sigma_{\theta}G_{a}^{\top}</annotation></semantics></math> is a product of a matrix, a positive semidefinite covariance, and its transpose, which is the defining form of the 2-RDM.</span></p>
</div>
<div id="A3.SS2.p16" class="ltx_para">
<p id="A3.SS2.p16.1" class="ltx_p"><span id="A3.SS2.p16.1.1" class="ltx_text">For (2), substituting the spectral decomposition of <math id="A3.SS2.p16.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math> gives</span></p>
<table id="A3.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E52.m1" class="ltx_Math" alttext="C_{S_{a},S_{a}}=\sum_{k}\sigma_{k}^{2}\,(G_{a}v_{k})(G_{a}v_{k})^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{S_{a},S_{a}}=\sum_{k}\sigma_{k}^{2}\,(G_{a}v_{k})(G_{a}v_{k})^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p16.2" class="ltx_p"><span id="A3.SS2.p16.2.1" class="ltx_text">Under the selective coupling condition <math id="A3.SS2.p16.m2" class="ltx_Math" alttext="G_{a}v_{j}\approx 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">G_{a}v_{j}\approx 0</annotation></semantics></math> for <math id="A3.SS2.p16.m3" class="ltx_Math" alttext="j\neq k_{a}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msub><mi>k</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">j\neq k_{a}</annotation></semantics></math>, all terms except <math id="A3.SS2.p16.m4" class="ltx_Math" alttext="k=k_{a}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><msub><mi>k</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">k=k_{a}</annotation></semantics></math> vanish, yielding the rank-1 approximation.</span></p>
</div>
<div id="A3.SS2.p17" class="ltx_para">
<p id="A3.SS2.p17.1" class="ltx_p"><span id="A3.SS2.p17.1.1" class="ltx_text">For (3), we apply the rank-1 alignment identity within the block. Under the rank-1 condition on <math id="A3.SS2.p17.m1" class="ltx_Math" alttext="C_{S_{a},S_{a}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><annotation encoding="application/x-tex">C_{S_{a},S_{a}}</annotation></semantics></math>, the effective dynamical covariance restricted to group <math id="A3.SS2.p17.m2" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math> is <math id="A3.SS2.p17.m3" class="ltx_Math" alttext="\Sigma_{\theta}^{(a)}\approx\sigma_{k_{a}}^{2}v_{k_{a}}v_{k_{a}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≈</mo><mrow><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}^{(a)}\approx\sigma_{k_{a}}^{2}v_{k_{a}}v_{k_{a}}^{\top}</annotation></semantics></math>. Setting <math id="A3.SS2.p17.m4" class="ltx_Math" alttext="a_{i}=g_{i}^{\top}v_{k_{a}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">a_{i}=g_{i}^{\top}v_{k_{a}}</annotation></semantics></math> for <math id="A3.SS2.p17.m5" class="ltx_Math" alttext="i\in S_{a}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">i\in S_{a}</annotation></semantics></math> and <math id="A3.SS2.p17.m6" class="ltx_Math" alttext="b_{i}=v_{k_{a}}^{\top}H_{i}v_{k_{a}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">b_{i}=v_{k_{a}}^{\top}H_{i}v_{k_{a}}</annotation></semantics></math>, the first-order and curvature contributions within the block are</span></p>
<table id="A3.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E53.m1" class="ltx_math_unparsed" alttext="C^{(1)}_{ij}=\sigma_{k_{a}}^{2}\,a_{i}\,a_{j},\qquad\Delta_{ij}=\frac{\sigma_{k_{a}}^{4}}{2}\,b_{i}\,b_{j},\qquad i,j\in S_{a}." display="block" intent=":literal"><semantics><mrow><mi>C</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>σ</mi><msub><mrow></mrow><msub><mi>k</mi><mi>a</mi></msub></msub><msup><mrow></mrow><mn>2</mn></msup><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mi>a</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="2.167em">,</mo><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mfrac><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>4</mn></msubsup><mn>2</mn></mfrac><mi>b</mi><msub><mrow></mrow><mi>i</mi></msub><mi>b</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="2.167em">,</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>∈</mo><mi>S</mi><msub><mrow></mrow><mi>a</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C^{(1)}_{ij}=\sigma_{k_{a}}^{2}\,a_{i}\,a_{j},\qquad\Delta_{ij}=\frac{\sigma_{k_{a}}^{4}}{2}\,b_{i}\,b_{j},\qquad i,j\in S_{a}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p17.2" class="ltx_p"><span id="A3.SS2.p17.2.1" class="ltx_text">The Frobenius inner product is then</span></p>
<table id="A3.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E54.m1" class="ltx_Math" alttext="\langle C^{(1)}_{S_{a}},\Delta_{S_{a}}\rangle_{F}=\sum_{i,j\in S_{a}}\sigma_{k_{a}}^{2}\,a_{i}\,a_{j}\cdot\frac{\sigma_{k_{a}}^{4}}{2}\,b_{i}\,b_{j}=\frac{\sigma_{k_{a}}^{6}}{2}\left(\sum_{i\in S_{a}}a_{i}\,b_{i}\right)^{2}\geq 0," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>C</mi><msub><mi>S</mi><mi>a</mi></msub><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><msub><mi>S</mi><mi>a</mi></msub></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>F</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></munder><mrow><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>4</mn></msubsup><mn>2</mn></mfrac></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo>=</mo><mrow><mfrac><msubsup><mi>σ</mi><msub><mi>k</mi><mi>a</mi></msub><mn>6</mn></msubsup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></munder><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\langle C^{(1)}_{S_{a}},\Delta_{S_{a}}\rangle_{F}=\sum_{i,j\in S_{a}}\sigma_{k_{a}}^{2}\,a_{i}\,a_{j}\cdot\frac{\sigma_{k_{a}}^{4}}{2}\,b_{i}\,b_{j}=\frac{\sigma_{k_{a}}^{6}}{2}\left(\sum_{i\in S_{a}}a_{i}\,b_{i}\right)^{2}\geq 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p17.3" class="ltx_p"><span id="A3.SS2.p17.3.1" class="ltx_text">which holds as an identity. Theorem <a href="#A3.Thmtheorem1" title="Theorem C.1. ‣ C.2 2-RDM for Phase Transitions ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> then applies within the block, guaranteeing that Hessian heterogeneity among the samples in <math id="A3.SS2.p17.m7" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math> increases <math id="A3.SS2.p17.m8" class="ltx_Math" alttext="\mathrm{Var}(\lambda(C_{S_{a},S_{a}}))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\lambda(C_{S_{a},S_{a}}))</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p18" class="ltx_para">
<p id="A3.SS2.p18.1" class="ltx_p">The selective coupling condition <math id="A3.SS2.p18.m1" class="ltx_Math" alttext="G_{a}v_{j}\approx 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">G_{a}v_{j}\approx 0</annotation></semantics></math> for <math id="A3.SS2.p18.m2" class="ltx_Math" alttext="j\neq k_{a}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msub><mi>k</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">j\neq k_{a}</annotation></semantics></math> has a concrete interpretation: the gradients of samples in group <math id="A3.SS2.p18.m3" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math> have large projections onto parameter-space direction <math id="A3.SS2.p18.m4" class="ltx_Math" alttext="v_{k_{a}}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><msub><mi>k</mi><mi>a</mi></msub></msub><annotation encoding="application/x-tex">v_{k_{a}}</annotation></semantics></math> but small projections onto other dynamically active directions. When this holds across all groups, the off-diagonal blocks <math id="A3.SS2.p18.m5" class="ltx_Math" alttext="C_{S_{a},S_{b}}\approx 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>b</mi></msub></mrow></msub><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{S_{a},S_{b}}\approx 0</annotation></semantics></math> are small and the full 2-RDM is approximately block-diagonal. Each block inherits rank-1 dynamics even when the full matrix has higher rank, and the theoretical guarantees apply within each block independently. It is known that training dynamics are usually low rank<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">25</a>]</cite> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">36</a>]</cite> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib50" title="" class="ltx_ref">51</a>]</cite>, meaning that such a decomposition likely exists in most cases. We can see concrete effects of this decomposition in the experiments of sections <a href="#S3.SS3" title="3.3 Grokking Modular Arithmetic ‣ 3 Experimental Results ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> and <a href="#S3.SS4" title="3.4 Emergent Misalignment ‣ 3 Experimental Results ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>, where the effect of the SHC is largely distinct on different subsets. Grokking is particularly striking, as it shows how the training samples and the testing samples pick up on seemingly independent signals.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Interpreting the Decomposition</h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">Here we will explain what this decomposition tells us, focusing on the case where <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math> comes from the trajectory as in corollary <a href="#A3.Thmcorollary2" title="Corollary C.2. ‣ C.1 2RDM Decomposition ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>. Recall the empirical Fisher</p>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<table id="A3.E55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E55.m1" class="ltx_Math" alttext="\hat{F}(\theta)_{ab}=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{i})}{\partial\theta_{b}}=\frac{1}{n}G^{\top}G" display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>a</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>b</mi></msub></mrow></mfrac></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{F}(\theta)_{ab}=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{i})}{\partial\theta_{b}}=\frac{1}{n}G^{\top}G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p3" class="ltx_para">
<p id="A3.SS3.p3.1" class="ltx_p">where <math id="A3.SS3.p3.m1" class="ltx_Math" alttext="G\in\mathbb{R}^{n\times p}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">G\in\mathbb{R}^{n\times p}</annotation></semantics></math> is the Jacobian matrix with rows <math id="A3.SS3.p3.m2" class="ltx_Math" alttext="g_{i}^{\top}=\nabla_{\theta}\ell(x_{i})^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">g_{i}^{\top}=\nabla_{\theta}\ell(x_{i})^{\top}</annotation></semantics></math>. The empirical FIM effectively encodes the loss landscape geometry as determined by the finite set of samples. Now take the SVD of <math id="A3.SS3.p3.m3" class="ltx_Math" alttext="G=U_{G}\,S_{G}\,V_{G}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">G=U_{G}\,S_{G}\,V_{G}^{\top}</annotation></semantics></math>. Starting with the right singular vectors, the columns of <math id="A3.SS3.p3.m4" class="ltx_Math" alttext="V_{G}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>G</mi></msub><annotation encoding="application/x-tex">V_{G}</annotation></semantics></math> are vectors in <math id="A3.SS3.p3.m5" class="ltx_Math" alttext="\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>p</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{p}</annotation></semantics></math> — they have one component per parameter. <math id="A3.SS3.p3.m6" class="ltx_Math" alttext="V_{G}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>G</mi></msub><annotation encoding="application/x-tex">V_{G}</annotation></semantics></math> diagonalizes the (unnormalized) FIM <math id="A3.SS3.p3.m7" class="ltx_Math" alttext="G^{\top}G\in\mathbb{R}^{p\times p}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">G^{\top}G\in\mathbb{R}^{p\times p}</annotation></semantics></math>:</p>
</div>
<div id="A3.SS3.p4" class="ltx_para">
<table id="A3.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E56.m1" class="ltx_Math" alttext="G^{\top}G=V_{G}\,S_{G}^{2}\,V_{G}^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>=</mo><mrow><msub><mi>V</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>S</mi><mi>G</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">G^{\top}G=V_{G}\,S_{G}^{2}\,V_{G}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p5" class="ltx_para">
<p id="A3.SS3.p5.1" class="ltx_p">Its eigenvectors <math id="A3.SS3.p5.m1" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math> of the empirical FIM are directions in parameter space along which the collection of per-sample gradients has coherent variation.</p>
</div>
<div id="A3.SS3.p6" class="ltx_para">
<p id="A3.SS3.p6.1" class="ltx_p">For the left singular vectors, the columns of <math id="A3.SS3.p6.m1" class="ltx_Math" alttext="U_{G}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>G</mi></msub><annotation encoding="application/x-tex">U_{G}</annotation></semantics></math> are vectors in <math id="A3.SS3.p6.m2" class="ltx_Math" alttext="\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{n}</annotation></semantics></math> so they have one component per sample and <math id="A3.SS3.p6.m3" class="ltx_Math" alttext="U_{G}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>G</mi></msub><annotation encoding="application/x-tex">U_{G}</annotation></semantics></math> diagonalizes <math id="A3.SS3.p6.m4" class="ltx_Math" alttext="GG^{\top}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">GG^{\top}\in\mathbb{R}^{n\times n}</annotation></semantics></math>:</p>
<table id="A3.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E57.m1" class="ltx_Math" alttext="GG^{\top}=U_{G}\,S_{G}^{2}\,U_{G}^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>S</mi><mi>G</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">GG^{\top}=U_{G}\,S_{G}^{2}\,U_{G}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p7" class="ltx_para">
<p id="A3.SS3.p7.1" class="ltx_p">This matrix lives in sample space which can be seen from <math id="A3.SS3.p7.m1" class="ltx_Math" alttext="(GG^{\top})_{ij}=g_{i}^{\top}g_{j}=\sum_{a=1}^{p}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{j})}{\partial\theta_{a}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>j</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></msubsup><mrow><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>a</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mi>a</mi></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">(GG^{\top})_{ij}=g_{i}^{\top}g_{j}=\sum_{a=1}^{p}\frac{\partial\ell(x_{i})}{\partial\theta_{a}}\frac{\partial\ell(x_{j})}{\partial\theta_{a}}</annotation></semantics></math>, the inner product between the loss gradients of samples <math id="A3.SS3.p7.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="A3.SS3.p7.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. Its eigenvectors <math id="A3.SS3.p7.m4" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> identify patterns across samples.</p>
</div>
<div id="A3.SS3.p8" class="ltx_para">
<p id="A3.SS3.p8.1" class="ltx_p">The defining relationship <math id="A3.SS3.p8.m1" class="ltx_Math" alttext="Gv_{k}=\sigma_{k}u_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Gv_{k}=\sigma_{k}u_{k}</annotation></semantics></math> says: if you take the parameter-space direction <math id="A3.SS3.p8.m2" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math> and compute each sample’s directional derivative along it, you get:</p>
</div>
<div id="A3.SS3.p9" class="ltx_para">
<table id="A3.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E58.m1" class="ltx_Math" alttext="\left(Gv_{k}\right)_{i}=g_{i}^{\top}v_{k}=\nabla_{\theta}\ell(x_{i})^{\top}v_{k}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left(Gv_{k}\right)_{i}=g_{i}^{\top}v_{k}=\nabla_{\theta}\ell(x_{i})^{\top}v_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p10" class="ltx_para">
<p id="A3.SS3.p10.1" class="ltx_p">This is a vector in <math id="A3.SS3.p10.m1" class="ltx_Math" alttext="\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{n}</annotation></semantics></math> giving the sensitivity of each sample’s loss to a perturbation along <math id="A3.SS3.p10.m2" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math>. The SVD tells you this equals <math id="A3.SS3.p10.m3" class="ltx_Math" alttext="\sigma_{k}u_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\sigma_{k}u_{k}</annotation></semantics></math>, which is the response pattern across samples is given by <math id="A3.SS3.p10.m4" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>, scaled by <math id="A3.SS3.p10.m5" class="ltx_Math" alttext="\sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\sigma_{k}</annotation></semantics></math>. So <math id="A3.SS3.p10.m6" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math> is the parameter direction, <math id="A3.SS3.p10.m7" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> is the corresponding sample-space response pattern, and <math id="A3.SS3.p10.m8" class="ltx_Math" alttext="\sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\sigma_{k}</annotation></semantics></math> is the strength of the coupling between them.</p>
</div>
<div id="A3.SS3.p11" class="ltx_para">
<p id="A3.SS3.p11.1" class="ltx_p">Now to understand the impact of the dynamics, consider the matrix <math id="A3.SS3.p11.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math>. We know that Within a time window <math id="A3.SS3.p11.m2" class="ltx_Math" alttext="[t-T/2,\,t+T/2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>t</mi><mo>−</mo><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t-T/2,\,t+T/2]</annotation></semantics></math>, the parameters trace out some trajectory <math id="A3.SS3.p11.m3" class="ltx_Math" alttext="\theta_{t}=\bar{\theta}+\delta\theta_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>t</mi></msub><mo>=</mo><mrow><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{t}=\bar{\theta}+\delta\theta_{t}</annotation></semantics></math>. The matrix <math id="A3.SS3.p11.m4" class="ltx_Math" alttext="\Sigma_{\theta}\in\mathbb{R}^{p\times p}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}\in\mathbb{R}^{p\times p}</annotation></semantics></math> is the covariance of these deviations:</p>
</div>
<div id="A3.SS3.p12" class="ltx_para">
<table id="A3.E59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E59.m1" class="ltx_Math" alttext="(\Sigma_{\theta})_{ab}=\text{Cov}_{w}[\delta\theta_{a},\,\delta\theta_{b}]" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo>=</mo><mrow><msub><mtext>Cov</mtext><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>a</mi></msub></mrow><mo rspace="0.337em">,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>b</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\Sigma_{\theta})_{ab}=\text{Cov}_{w}[\delta\theta_{a},\,\delta\theta_{b}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p13" class="ltx_para">
<p id="A3.SS3.p13.1" class="ltx_p">This is a complete description of how training explores parameter space during the window. Which directions it moves along, how far, and with what correlations. But it’s a <math id="A3.SS3.p13.m1" class="ltx_Math" alttext="p\times p" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">p\times p</annotation></semantics></math> object, which is enormous and mostly irrelevant, because not all parameter directions affect the loss on your probe samples. The columns of <math id="A3.SS3.p13.m2" class="ltx_Math" alttext="V_{G}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>G</mi></msub><annotation encoding="application/x-tex">V_{G}</annotation></semantics></math> are exactly the parameter directions that matter for distinguishing between samples (as we established). The projection <math id="A3.SS3.p13.m3" class="ltx_Math" alttext="V_{G}^{\top}\delta\theta_{t}\in\mathbb{R}^{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>V</mi><mi>G</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">V_{G}^{\top}\delta\theta_{t}\in\mathbb{R}^{r}</annotation></semantics></math> extracts the components of the parameter motion along these directions, discarding everything else. So <math id="A3.SS3.p13.m4" class="ltx_Math" alttext="\tilde{\Sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Sigma}</annotation></semantics></math> is the covariance of training dynamics restricted to the directions that matter on the loss landscape.</p>
</div>
<div id="A3.SS3.p14" class="ltx_para">
<p id="A3.SS3.p14.1" class="ltx_p">The factorization <math id="A3.SS3.p14.m1" class="ltx_Math" alttext="C=U_{G}S_{G}\tilde{\Sigma}S_{G}U_{G}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msub><mi>U</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mi>G</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">C=U_{G}S_{G}\tilde{\Sigma}S_{G}U_{G}^{\top}</annotation></semantics></math> makes this coupling explicit. The eigenvalues of <math id="A3.SS3.p14.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> are the eigenvalues of the <math id="A3.SS3.p14.m3" class="ltx_Math" alttext="r\times r" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r\times r</annotation></semantics></math> matrix <math id="A3.SS3.p14.m4" class="ltx_Math" alttext="S_{G}\tilde{\Sigma}S_{G}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>G</mi></msub></mrow><annotation encoding="application/x-tex">S_{G}\tilde{\Sigma}S_{G}</annotation></semantics></math>, which is a product of three things:</p>
<ul id="A3.I4" class="ltx_itemize">
<li id="A3.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I4.i1.p1" class="ltx_para">
<p id="A3.I4.i1.p1.1" class="ltx_p"><math id="A3.I4.i1.p1.m1" class="ltx_Math" alttext="S_{G}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>G</mi></msub><annotation encoding="application/x-tex">S_{G}</annotation></semantics></math> on the left: weight each direction by how strongly the landscape differentiates samples along it</p>
</div></li>
<li id="A3.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I4.i2.p1" class="ltx_para">
<p id="A3.I4.i2.p1.1" class="ltx_p"><math id="A3.I4.i2.p1.m1" class="ltx_Math" alttext="\tilde{\Sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Sigma}</annotation></semantics></math> in the middle: how much training actually explores each direction and the correlations between directions</p>
</div></li>
<li id="A3.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I4.i3.p1" class="ltx_para">
<p id="A3.I4.i3.p1.1" class="ltx_p"><math id="A3.I4.i3.p1.m1" class="ltx_Math" alttext="S_{G}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>G</mi></msub><annotation encoding="application/x-tex">S_{G}</annotation></semantics></math> on the right: weight again by landscape sensitivity</p>
</div></li>
</ul>
</div>
<div id="A3.SS3.p15" class="ltx_para">
<p id="A3.SS3.p15.1" class="ltx_p">So a mode <math id="A3.SS3.p15.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> contributes to the loss covariance in proportion to <math id="A3.SS3.p15.m2" class="ltx_Math" alttext="\sigma_{k}^{2}\tilde{\Sigma}_{kk}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\sigma_{k}^{2}\tilde{\Sigma}_{kk}</annotation></semantics></math> (roughly, ignoring off-diagonal terms in <math id="A3.SS3.p15.m3" class="ltx_Math" alttext="\tilde{\Sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Sigma}</annotation></semantics></math>)</p>
</div>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Sensitivity of the SHC</h3>

<div id="A3.SS4.p1" class="ltx_para">
<p id="A3.SS4.p1.1" class="ltx_p">Suppose only <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> of your <math id="A3.SS4.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> probe samples are involved in an emerging transition. The active samples develop correlated loss fluctuations of scale <math id="A3.SS4.p1.m3" class="ltx_Math" alttext="\sigma^{2}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\sigma^{2}</annotation></semantics></math>, while the remaining <math id="A3.SS4.p1.m4" class="ltx_Math" alttext="n-k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n-k</annotation></semantics></math> samples have fluctuations at some background level <math id="A3.SS4.p1.m5" class="ltx_Math" alttext="\epsilon^{2}\approx 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϵ</mi><mn>2</mn></msup><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon^{2}\approx 0</annotation></semantics></math>. In the cleanest case, the <math id="A3.SS4.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> active samples move coherently, producing one large eigenvalue <math id="A3.SS4.p1.m7" class="ltx_Math" alttext="\lambda_{1}\sim k\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\lambda_{1}\sim k\sigma^{2}</annotation></semantics></math> with the remaining eigenvalues near zero. The global SHC scales like:</p>
</div>
<div id="A3.SS4.p2" class="ltx_para">
<table id="A3.E60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E60.m1" class="ltx_Math" alttext="\text{Var}(\lambda)\approx\frac{(k\sigma^{2})^{2}}{n}=\frac{k^{2}\sigma^{4}}{n}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mi>n</mi></mfrac><mo>=</mo><mfrac><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>4</mn></msup></mrow><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">\text{Var}(\lambda)\approx\frac{(k\sigma^{2})^{2}}{n}=\frac{k^{2}\sigma^{4}}{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.p3" class="ltx_para">
<p id="A3.SS4.p3.1" class="ltx_p">One can then see that if all <math id="A3.SS4.p3.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples are involved in the transition one gets <math id="A3.SS4.p3.m2" class="ltx_Math" alttext="\text{Var}(\lambda)\sim n\sigma^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\text{Var}(\lambda)\sim n\sigma^{4}</annotation></semantics></math>, meaning that there is a dilution for a subset of size <math id="A3.SS4.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> like <math id="A3.SS4.p3.m4" class="ltx_Math" alttext="(k/n)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">(k/n)^{2}</annotation></semantics></math>. This is problematic for small subsets.</p>
</div>
<div id="A3.SS4.p4" class="ltx_para">
<p id="A3.SS4.p4.1" class="ltx_p">One can use eigenvector localization as a companion diagnostic. Rather than only tracking the scalar <math id="A3.SS4.p4.m1" class="ltx_Math" alttext="\text{Var}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Var}(\lambda)</annotation></semantics></math>, track the inverse participation ratio (IPR) of each eigenvector:</p>
</div>
<div id="A3.SS4.p5" class="ltx_para">
<table id="A3.E61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E61.m1" class="ltx_Math" alttext="\text{IPR}(v_{k})=\sum_{i=1}^{n}v_{k}(i)^{4}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>IPR</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{IPR}(v_{k})=\sum_{i=1}^{n}v_{k}(i)^{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS4.p6" class="ltx_para">
<p id="A3.SS4.p6.1" class="ltx_p">This measures how localized the eigenvector is on a set of samples. A delocalized eigenvector (uniform over all samples) has <math id="A3.SS4.p6.m1" class="ltx_Math" alttext="\text{IPR}=1/n" display="inline" intent=":literal"><semantics><mrow><mtext>IPR</mtext><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\text{IPR}=1/n</annotation></semantics></math>; one concentrated on a single sample has <math id="A3.SS4.p6.m2" class="ltx_Math" alttext="\text{IPR}=1" display="inline" intent=":literal"><semantics><mrow><mtext>IPR</mtext><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\text{IPR}=1</annotation></semantics></math>. An eigenvector localized on <math id="A3.SS4.p6.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> samples has <math id="A3.SS4.p6.m4" class="ltx_Math" alttext="\text{IPR}\sim 1/k" display="inline" intent=":literal"><semantics><mrow><mtext>IPR</mtext><mo>∼</mo><mrow><mn>1</mn><mo>/</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">\text{IPR}\sim 1/k</annotation></semantics></math>. One can then track the top eigenvalues of <math id="A3.SS4.p6.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and their IPRs. A growing eigenvalue with high IPR is a localized transition in progress. This sidesteps the dilution problem because you’re looking at individual eigenvalues rather than a global summary statistic. Once you identify that eigenvector <math id="A3.SS4.p6.m6" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math> is localized (high IPR), you can extract its support as the set <math id="A3.SS4.p6.m7" class="ltx_Math" alttext="S_{k}=\{i:|v_{k}(i)|^{2}&gt;\tau\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>&gt;</mo><mi>τ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S_{k}=\{i:|v_{k}(i)|^{2}&gt;\tau\}</annotation></semantics></math> for some threshold <math id="A3.SS4.p6.m8" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. This allows one to work solely with the the principal submatrix <math id="A3.SS4.p6.m9" class="ltx_Math" alttext="C_{S_{k},S_{k}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><msub><mi>S</mi><mi>k</mi></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub></mrow></msub><annotation encoding="application/x-tex">C_{S_{k},S_{k}}</annotation></semantics></math>. These restricted diagnostics see the transition at full strength because you’ve removed the diluting samples. Note however that the exact selection of the initial <math id="A3.SS4.p6.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> probe set must be in some way sufficient to capture the transitions you care about. Selecting this probe set is an important avenue for future research.</p>
</div>
</section>
<section id="A3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.5 </span>Relationship with Quantum Chemistry</h3>

<div id="A3.SS5.p1" class="ltx_para">
<p id="A3.SS5.p1.1" class="ltx_p">In fact, this problem is effectively identical to the problem of basis selection in quantum chemistry <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">8</a>]</cite> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">41</a>]</cite>. In quantum chemistry, you’re projecting a Hamiltonian that lives in an infinite-dimensional Hilbert space onto a finite basis set. The eigenvalues of the resulting matrix approximate the true spectrum, but only insofar as the basis spans the subspace where the relevant physics lives. If you’re studying a bond-breaking event and your basis lacks the orbitals involved in that bond, you simply can’t see the break. Not because it isn’t happening, but because your representation doesn’t resolve it.</p>
</div>
<div id="A3.SS5.p2" class="ltx_para">
<p id="A3.SS5.p2.1" class="ltx_p">Complete Active Space Self-Consistent Field methods are designed to handle situations like bond breaking with strong electron interactions. They admit a basis selection problem which is very similar to the basis selection problem for the loss covariance (the 2RDM in the language used through the rest of the paper, changed to avoid confusion with the 2RDM in quantum chemistry). In complete active space methods, you recognize that most orbitals are either always occupied or always empty so the interesting multiconfigurational physics happens in a small “active space” of partially occupied orbitals. You partition into inactive, active, and virtual orbitals, and only treat correlations within the active space exactly.</p>
</div>
<div id="A3.SS5.p3" class="ltx_para">
<p id="A3.SS5.p3.1" class="ltx_p">The restricted spectral diagnostics approach described previously is doing something very similar. You identify which samples are participating in the current transition (the active space), freeze out the inactive samples, and compute your diagnostics on the active submatrix. The eigenvector (inverse) PR for example is playing the role of natural orbital occupation numbers as it tells you which samples belong in the active space.</p>
</div>
<div id="A3.SS5.p4" class="ltx_para">
<p id="A3.SS5.p4.1" class="ltx_p">In quantum chemistry, decades of research has produced systematic basis set hierarchies such as STO-3G, 6-31G*, cc-pVDZ, cc-pVTZ, and so on <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">8</a>]</cite>, where each level adds specific types of functions (polarization, diffuse, core-correlation) to resolve specific physics. You choose the basis to match the phenomenon you’re studying.</p>
</div>
<div id="A3.SS5.p5" class="ltx_para">
<p id="A3.SS5.p5.1" class="ltx_p">This suggests that probe set design should be similarly principled. Rather than picking <math id="A3.SS5.p5.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> random samples, you’d want something like:</p>
</div>
<div id="A3.SS5.p6" class="ltx_para">
<ul id="A3.I5" class="ltx_itemize">
<li id="A3.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I5.i1.p1" class="ltx_para">
<p id="A3.I5.i1.p1.1" class="ltx_p">A <span id="A3.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">core set</span> that uniformly samples the data distribution, which is the analog of a minimal basis. This captures global transitions that affect the whole distribution.</p>
</div></li>
<li id="A3.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I5.i2.p1" class="ltx_para">
<p id="A3.I5.i2.p1.1" class="ltx_p"><span id="A3.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">Task Specific</span> sets if you have knowledge of what it is you wish to detect.</p>
</div></li>
<li id="A3.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I5.i3.p1" class="ltx_para">
<p id="A3.I5.i3.p1.1" class="ltx_p"><span id="A3.I5.i3.p1.1.1" class="ltx_text ltx_font_bold">Polarization samples</span> that sit near natural categorical boundaries or are ambiguous, the analog of polarization functions that resolve how orbitals deform in the presence of neighbors. These would be most sensitive to the fine-grained transitions that refine category boundaries.</p>
</div></li>
<li id="A3.I5.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I5.i4.p1" class="ltx_para">
<p id="A3.I5.i4.p1.1" class="ltx_p"><span id="A3.I5.i4.p1.1.1" class="ltx_text ltx_font_bold">Diffuse Samples</span> from the tails of the distribution or near out-of-distribution regions (adversarial examples, for instance),</p>
</div></li>
</ul>
</div>
<div id="A3.SS5.p7" class="ltx_para">
<p id="A3.SS5.p7.1" class="ltx_p">The exact method for selecting these samples is itself an important practical problem and is an important direction for future work.</p>
</div>
</section>
<section id="A3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.6 </span>Relationship with POLCA</h3>

<div id="A3.SS6.p1" class="ltx_para">
<p id="A3.SS6.p1.1" class="ltx_p">The work here is related to the POLCA method introduced in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">16</a>]</cite>. Let <math id="A3.SS6.p1.m1" class="ltx_Math" alttext="\{b_{k}\}_{k=1}^{d}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>b</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><annotation encoding="application/x-tex">\{b_{k}\}_{k=1}^{d}</annotation></semantics></math> be an orthonormal basis for a <math id="A3.SS6.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional subspace of parameter space
(e.g., the POLCA basis of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">16</a>]</cite>), and let
<math id="A3.SS6.p1.m3" class="ltx_Math" alttext="B=[b_{1},\ldots,b_{d}]\in\mathbb{R}^{p\times d}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">B=[b_{1},\ldots,b_{d}]\in\mathbb{R}^{p\times d}</annotation></semantics></math> be the corresponding basis matrix.
Define the gradient projection matrix <math id="A3.SS6.p1.m4" class="ltx_Math" alttext="M\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M\in\mathbb{R}^{n\times d}</annotation></semantics></math> by</p>
<table id="A3.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E62.m1" class="ltx_Math" alttext="M_{ik}\;=\;\langle b_{k},\,\nabla_{\theta}\ell(x_{i})\rangle\;=\;g_{i}^{\top}b_{k}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>b</mi><mi>k</mi></msub><mo rspace="0.337em">,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi mathvariant="normal">ℓ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.280em" stretchy="false">⟩</mo></mrow><mo rspace="0.558em">=</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">M_{ik}\;=\;\langle b_{k},\,\nabla_{\theta}\ell(x_{i})\rangle\;=\;g_{i}^{\top}b_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A3.SS6.p1.2" class="ltx_p">and the projected dynamical covariance <math id="A3.SS6.p1.m5" class="ltx_Math" alttext="\widetilde{\Sigma}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{\Sigma}\in\mathbb{R}^{d\times d}</annotation></semantics></math> by</p>
<table id="A3.E63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E63.m1" class="ltx_Math" alttext="\widetilde{\Sigma}_{kl}\;=\;\operatorname{Cov}_{w}\!\bigl[\langle b_{k},\delta\theta\rangle,\;\langle b_{l},\delta\theta\rangle\bigr]\;=\;b_{k}^{\top}\Sigma_{\theta}\,b_{l}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>Cov</mi><mi>w</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>b</mi><mi>k</mi></msub><mo>,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo rspace="0.447em">,</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>b</mi><mi>l</mi></msub><mo>,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>l</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{\Sigma}_{kl}\;=\;\operatorname{Cov}_{w}\!\bigl[\langle b_{k},\delta\theta\rangle,\;\langle b_{l},\delta\theta\rangle\bigr]\;=\;b_{k}^{\top}\Sigma_{\theta}\,b_{l},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
</table>
<p id="A3.SS6.p1.3" class="ltx_p">where <math id="A3.SS6.p1.m6" class="ltx_Math" alttext="\Sigma_{\theta}=\operatorname{Cov}_{w}[\delta\theta_{t}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><mo>=</mo><mrow><msub><mi>Cov</mi><mi>w</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\theta}=\operatorname{Cov}_{w}[\delta\theta_{t}]</annotation></semantics></math> is the parameter covariance within a training window <math id="A3.SS6.p1.m7" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>. Under the first-order linearization
<math id="A3.SS6.p1.m8" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}</annotation></semantics></math> and the low-rank training subspace
assumption <math id="A3.SS6.p1.m9" class="ltx_Math" alttext="\delta\theta_{t}\approx\sum_{k}\delta\alpha_{k}(t)\,b_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo rspace="0.111em">≈</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\theta_{t}\approx\sum_{k}\delta\alpha_{k}(t)\,b_{k}</annotation></semantics></math>.</p>
</div>
<div id="A3.Thmproposition6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmproposition6.2" class="ltx_text ltx_font_bold">Proposition C.6</span></span><span id="A3.Thmproposition6.3" class="ltx_text ltx_font_bold"> </span>(Loss covariance as a contraction of the POLCA decomposition)<span id="A3.Thmproposition6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmproposition6.p1" class="ltx_para">
<p id="A3.Thmproposition6.p1.1" class="ltx_p"><span id="A3.Thmproposition6.p1.1.1" class="ltx_text ltx_font_italic">The following hold:</span></p>
<ol id="A3.I6" class="ltx_enumerate">
<li id="A3.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I6.i1.p1" class="ltx_para">
<p id="A3.I6.i1.p1.1" class="ltx_p"><span id="A3.I6.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">POLCA as a component of the loss fluctuation.</span><span id="A3.I6.i1.p1.1.2" class="ltx_text ltx_font_italic">
The first-order POLCA value</span><span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                      <span class="ltx_tag ltx_tag_note">3</span>
                      
                      
                      
                    This corresponds to Equation (2) of
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">16</a>]</cite>, prior to the second-order Hessian correction of their
Equation (7). The two are empirically near-identical; see their Appendix I.</span></span></span><span id="A3.I6.i1.p1.1.3" class="ltx_text ltx_font_italic">
for sample </span><math id="A3.I6.i1.p1.m1" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math><span id="A3.I6.i1.p1.1.4" class="ltx_text ltx_font_italic"> along direction </span><math id="A3.I6.i1.p1.m2" class="ltx_Math" alttext="b_{k}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>k</mi></msub><annotation encoding="application/x-tex">b_{k}</annotation></semantics></math><span id="A3.I6.i1.p1.1.5" class="ltx_text ltx_font_italic"> at step </span><math id="A3.I6.i1.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A3.I6.i1.p1.1.6" class="ltx_text ltx_font_italic"> is</span></p>
<table id="A3.E64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E64.m1" class="ltx_Math" alttext="\mathrm{POLCA}^{(1)}(x_{i},b_{k};\,t)\;=\;M_{ik}(t)\;\delta\alpha_{k}(t)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>POLCA</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub><mo>,</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{POLCA}^{(1)}(x_{i},b_{k};\,t)\;=\;M_{ik}(t)\;\delta\alpha_{k}(t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
</table>
<p id="A3.I6.i1.p1.2" class="ltx_p"><span id="A3.I6.i1.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="A3.I6.i1.p1.m4" class="ltx_Math" alttext="\delta\alpha_{k}(t)=\langle b_{k},\theta_{t+1}-\theta_{t}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>b</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>θ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\alpha_{k}(t)=\langle b_{k},\theta_{t+1}-\theta_{t}\rangle</annotation></semantics></math><span id="A3.I6.i1.p1.2.2" class="ltx_text ltx_font_italic"> is the parameter step
projected onto direction </span><math id="A3.I6.i1.p1.m5" class="ltx_Math" alttext="b_{k}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>k</mi></msub><annotation encoding="application/x-tex">b_{k}</annotation></semantics></math><span id="A3.I6.i1.p1.2.3" class="ltx_text ltx_font_italic">. The total loss fluctuation decomposes as</span></p>
<table id="A3.E65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E65.m1" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\;\approx\;\sum_{k=1}^{d}M_{ik}(t)\;\delta\alpha_{k}(t)\;=\;\sum_{k=1}^{d}\mathrm{POLCA}^{(1)}(x_{i},b_{k};\,t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.391em">≈</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.391em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msup><mi>POLCA</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\;\approx\;\sum_{k=1}^{d}M_{ik}(t)\;\delta\alpha_{k}(t)\;=\;\sum_{k=1}^{d}\mathrm{POLCA}^{(1)}(x_{i},b_{k};\,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
</div></li>
<li id="A3.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I6.i2.p1" class="ltx_para">
<p id="A3.I6.i2.p1.1" class="ltx_p"><span id="A3.I6.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Loss covariance from POLCA projections.</span><span id="A3.I6.i2.p1.1.2" class="ltx_text ltx_font_italic">
The loss covariance factorizes as</span></p>
<table id="A3.E66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E66.m1" class="ltx_Math" alttext="\boxed{C\;=\;M\,\widetilde{\Sigma}\,M^{\top},}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mrow><mi>C</mi><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi>M</mi><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mo>⊤</mo></msup></mrow></mrow><mo>,</mo></mrow></menclose><annotation encoding="application/x-tex">\boxed{C\;=\;M\,\widetilde{\Sigma}\,M^{\top},}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
<p id="A3.I6.i2.p1.2" class="ltx_p"><span id="A3.I6.i2.p1.2.1" class="ltx_text ltx_font_italic">i.e., </span><math id="A3.I6.i2.p1.m1" class="ltx_Math" alttext="C_{ij}=\sum_{k,l=1}^{d}M_{ik}\,\widetilde{\Sigma}_{kl}\,M_{jl}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{ij}=\sum_{k,l=1}^{d}M_{ik}\,\widetilde{\Sigma}_{kl}\,M_{jl}</annotation></semantics></math><span id="A3.I6.i2.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A3.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A3.I6.i3.p1" class="ltx_para">
<p id="A3.I6.i3.p1.1" class="ltx_p"><span id="A3.I6.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Diagonal–off-diagonal decomposition.</span><span id="A3.I6.i3.p1.1.2" class="ltx_text ltx_font_italic">
Let </span><math id="A3.I6.i3.p1.m1" class="ltx_Math" alttext="m_{k}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">m_{k}\in\mathbb{R}^{n}</annotation></semantics></math><span id="A3.I6.i3.p1.1.3" class="ltx_text ltx_font_italic"> denote the </span><math id="A3.I6.i3.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="A3.I6.i3.p1.1.4" class="ltx_text ltx_font_italic">-th column of </span><math id="A3.I6.i3.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="A3.I6.i3.p1.1.5" class="ltx_text ltx_font_italic"> (the vector of gradient projections
of all samples onto direction </span><math id="A3.I6.i3.p1.m4" class="ltx_Math" alttext="b_{k}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>k</mi></msub><annotation encoding="application/x-tex">b_{k}</annotation></semantics></math><span id="A3.I6.i3.p1.1.6" class="ltx_text ltx_font_italic">). Then</span></p>
<table id="A3.E67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E67.m1" class="ltx_Math" alttext="C\;=\;\underbrace{\sum_{k=1}^{d}\widetilde{\Sigma}_{kk}\;m_{k}\,m_{k}^{\top}}_{\displaystyle C^{\mathrm{diag}}}\;+\;\underbrace{\sum_{k\neq l}\widetilde{\Sigma}_{kl}\;m_{k}\,m_{l}^{\top}}_{\displaystyle C^{\mathrm{cross}}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0.558em" rspace="0.391em">=</mo><mrow><munder><munder accentunder="true"><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>m</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="true">⏟</mo></munder><msup><mi>C</mi><mi mathsize="1.400em">diag</mi></msup></munder><mo rspace="0.335em">+</mo><munder><munder accentunder="true"><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow></munder><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>m</mi><mi>l</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="true">⏟</mo></munder><msup><mi>C</mi><mi mathsize="1.400em">cross</mi></msup></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C\;=\;\underbrace{\sum_{k=1}^{d}\widetilde{\Sigma}_{kk}\;m_{k}\,m_{k}^{\top}}_{\displaystyle C^{\mathrm{diag}}}\;+\;\underbrace{\sum_{k\neq l}\widetilde{\Sigma}_{kl}\;m_{k}\,m_{l}^{\top}}_{\displaystyle C^{\mathrm{cross}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
</table>
<p id="A3.I6.i3.p1.2" class="ltx_p"><span id="A3.I6.i3.p1.2.1" class="ltx_text ltx_font_italic">The term </span><math id="A3.I6.i3.p1.m5" class="ltx_Math" alttext="C^{\mathrm{diag}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>diag</mi></msup><annotation encoding="application/x-tex">C^{\mathrm{diag}}</annotation></semantics></math><span id="A3.I6.i3.p1.2.2" class="ltx_text ltx_font_italic"> is a sum of rank-one contributions, one per basis direction,
each weighted by the dynamical variance </span><math id="A3.I6.i3.p1.m6" class="ltx_Math" alttext="\widetilde{\Sigma}_{kk}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\Sigma}_{kk}</annotation></semantics></math><span id="A3.I6.i3.p1.2.3" class="ltx_text ltx_font_italic"> along that direction.
The term </span><math id="A3.I6.i3.p1.m7" class="ltx_Math" alttext="C^{\mathrm{cross}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>cross</mi></msup><annotation encoding="application/x-tex">C^{\mathrm{cross}}</annotation></semantics></math><span id="A3.I6.i3.p1.2.4" class="ltx_text ltx_font_italic"> encodes the dynamical coupling between distinct basis
directions.</span></p>
</div></li>
<li id="A3.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A3.I6.i4.p1" class="ltx_para">
<p id="A3.I6.i4.p1.1" class="ltx_p"><span id="A3.I6.i4.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">POLCA captures the diagonal part.</span><span id="A3.I6.i4.p1.1.2" class="ltx_text ltx_font_italic">
POLCA clustering on direction </span><math id="A3.I6.i4.p1.m1" class="ltx_Math" alttext="b_{k}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>k</mi></msub><annotation encoding="application/x-tex">b_{k}</annotation></semantics></math><span id="A3.I6.i4.p1.1.3" class="ltx_text ltx_font_italic"> groups samples by similarity of their projected loss
trajectories </span><math id="A3.I6.i4.p1.m2" class="ltx_Math" alttext="\{M_{ik}(t)\,\delta\alpha_{k}(t)\}_{t}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mi>t</mi></msub><annotation encoding="application/x-tex">\{M_{ik}(t)\,\delta\alpha_{k}(t)\}_{t}</annotation></semantics></math><span id="A3.I6.i4.p1.1.4" class="ltx_text ltx_font_italic">. Since </span><math id="A3.I6.i4.p1.m3" class="ltx_Math" alttext="\delta\alpha_{k}(t)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\alpha_{k}(t)</annotation></semantics></math><span id="A3.I6.i4.p1.1.5" class="ltx_text ltx_font_italic"> is common
to all samples, this is equivalent to grouping by the gradient projection vector </span><math id="A3.I6.i4.p1.m4" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math><span id="A3.I6.i4.p1.1.6" class="ltx_text ltx_font_italic">.
The sample-space structure accessible to per-direction POLCA analysis is therefore
</span><math id="A3.I6.i4.p1.m5" class="ltx_Math" alttext="\{m_{k}m_{k}^{\top}\}_{k=1}^{d}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>m</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><annotation encoding="application/x-tex">\{m_{k}m_{k}^{\top}\}_{k=1}^{d}</annotation></semantics></math><span id="A3.I6.i4.p1.1.7" class="ltx_text ltx_font_italic">, the diagonal part </span><math id="A3.I6.i4.p1.m6" class="ltx_Math" alttext="C^{\mathrm{diag}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>diag</mi></msup><annotation encoding="application/x-tex">C^{\mathrm{diag}}</annotation></semantics></math><span id="A3.I6.i4.p1.1.8" class="ltx_text ltx_font_italic"> (up to the scalar
weights </span><math id="A3.I6.i4.p1.m7" class="ltx_Math" alttext="\widetilde{\Sigma}_{kk}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\Sigma}_{kk}</annotation></semantics></math><span id="A3.I6.i4.p1.1.9" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="A3.I6.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A3.I6.i5.p1" class="ltx_para">
<p id="A3.I6.i5.p1.1" class="ltx_p"><span id="A3.I6.i5.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Equivalence condition.</span><span id="A3.I6.i5.p1.1.2" class="ltx_text ltx_font_italic">
</span><math id="A3.I6.i5.p1.m1" class="ltx_Math" alttext="C^{\mathrm{cross}}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>cross</mi></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C^{\mathrm{cross}}=0</annotation></semantics></math><span id="A3.I6.i5.p1.1.3" class="ltx_text ltx_font_italic"> (so that </span><math id="A3.I6.i5.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math><span id="A3.I6.i5.p1.1.4" class="ltx_text ltx_font_italic"> is fully reconstructible from POLCA’s per-direction data) if and only if </span><math id="A3.I6.i5.p1.m3" class="ltx_Math" alttext="\widetilde{\Sigma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\Sigma}</annotation></semantics></math><span id="A3.I6.i5.p1.1.5" class="ltx_text ltx_font_italic"> is diagonal in the basis </span><math id="A3.I6.i5.p1.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="A3.I6.i5.p1.1.6" class="ltx_text ltx_font_italic">, i.e., the projected training dynamics along distinct basis directions are uncorrelated within the window.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A3.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS6.p2" class="ltx_para">
<p id="A3.SS6.p2.1" class="ltx_p"><span id="A3.SS6.p2.1.1" class="ltx_text">Under the linearization <math id="A3.SS6.p2.m1" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\approx g_{i}^{\top}\delta\theta_{t}</annotation></semantics></math> and the subspace assumption <math id="A3.SS6.p2.m2" class="ltx_Math" alttext="\delta\theta_{t}\approx B\,\delta\alpha_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>t</mi></msub></mrow><mo>≈</mo><mrow><mi>B</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\delta\theta_{t}\approx B\,\delta\alpha_{t}</annotation></semantics></math>, we have
<math id="A3.SS6.p2.m3" class="ltx_Math" alttext="\delta\ell_{t}(x_{i})\approx g_{i}^{\top}B\,\delta\alpha_{t}=\sum_{k}M_{ik}\,\delta\alpha_{k}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msubsup><mi>g</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\ell_{t}(x_{i})\approx g_{i}^{\top}B\,\delta\alpha_{t}=\sum_{k}M_{ik}\,\delta\alpha_{k}(t)</annotation></semantics></math>,
which gives (<a href="#A3.E64" title="In item 1 ‣ Proposition C.6 (Loss covariance as a contraction of the POLCA decomposition). ‣ C.6 Relationship with POLCA ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">64</span></a>)–(<a href="#A3.E65" title="In item 1 ‣ Proposition C.6 (Loss covariance as a contraction of the POLCA decomposition). ‣ C.6 Relationship with POLCA ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">65</span></a>). For the covariance:</span></p>
<table id="A3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex11.m1" class="ltx_Math" alttext="\displaystyle C_{ij}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle C_{ij}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex11.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Cov}_{w}[\delta\ell(x_{i}),\,\delta\ell(x_{j})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Cov</mi><mi>w</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Cov}_{w}[\delta\ell(x_{i}),\,\delta\ell(x_{j})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex12.m1" class="ltx_Math" alttext="\displaystyle\approx\operatorname{Cov}_{w}\!\Bigl[\sum_{k}M_{ik}\,\delta\alpha_{k},\;\;\sum_{l}M_{jl}\,\delta\alpha_{l}\Bigr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>Cov</mi><mi>w</mi></msub><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow></mrow><mo rspace="0.727em">,</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>l</mi></munder></mstyle><mrow><msub><mi>M</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>l</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\operatorname{Cov}_{w}\!\Bigl[\sum_{k}M_{ik}\,\delta\alpha_{k},\;\;\sum_{l}M_{jl}\,\delta\alpha_{l}\Bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex13.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k,l}M_{ik}\,M_{jl}\,\operatorname{Cov}_{w}[\delta\alpha_{k},\delta\alpha_{l}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>Cov</mi><mi>w</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k,l}M_{ik}\,M_{jl}\,\operatorname{Cov}_{w}[\delta\alpha_{k},\delta\alpha_{l}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E68.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k,l}M_{ik}\,\widetilde{\Sigma}_{kl}\,M_{jl}\;=\;(M\widetilde{\Sigma}M^{\top})_{ij}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder></mstyle><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mrow><mo rspace="0.558em">=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k,l}M_{ik}\,\widetilde{\Sigma}_{kl}\,M_{jl}\;=\;(M\widetilde{\Sigma}M^{\top})_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
<p id="A3.SS6.p2.2" class="ltx_p"><span id="A3.SS6.p2.2.1" class="ltx_text">where in the third line <math id="A3.SS6.p2.m4" class="ltx_Math" alttext="M_{ik}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">M_{ik}</annotation></semantics></math> and <math id="A3.SS6.p2.m5" class="ltx_Math" alttext="M_{jl}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">M_{jl}</annotation></semantics></math> are treated as approximately constant within the window (evaluated at <math id="A3.SS6.p2.m6" class="ltx_Math" alttext="\bar{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\theta}</annotation></semantics></math>). Equation (<a href="#A3.E67" title="In item 3 ‣ Proposition C.6 (Loss covariance as a contraction of the POLCA decomposition). ‣ C.6 Relationship with POLCA ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">67</span></a>) follows by separating the <math id="A3.SS6.p2.m7" class="ltx_Math" alttext="k=l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k=l</annotation></semantics></math> and <math id="A3.SS6.p2.m8" class="ltx_Math" alttext="k\neq l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k\neq l</annotation></semantics></math> terms. Parts (iv) and (v) are immediate from (<a href="#A3.E67" title="In item 3 ‣ Proposition C.6 (Loss covariance as a contraction of the POLCA decomposition). ‣ C.6 Relationship with POLCA ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">67</span></a>).
∎</span></p>
</div>
</div>
<div id="A3.SS6.p3" class="ltx_para">
<p id="A3.SS6.p3.1" class="ltx_p">The reason to split the proposition into the distinct statement is it makes it clear that POLCA gives you something akin to natural orbitals <math id="A3.SS6.p3.m1" class="ltx_Math" alttext="\{m_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{m_{k}\}</annotation></semantics></math> and the diagonal occupation numbers <math id="A3.SS6.p3.m2" class="ltx_Math" alttext="\{\widetilde{\Sigma}_{kk}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\widetilde{\Sigma}_{kk}\}</annotation></semantics></math>, which together reconstruct <math id="A3.SS6.p3.m3" class="ltx_Math" alttext="C^{\text{diag}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mtext>diag</mtext></msup><annotation encoding="application/x-tex">C^{\text{diag}}</annotation></semantics></math>, where <math id="A3.SS6.p3.m4" class="ltx_Math" alttext="C^{\text{diag}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mtext>diag</mtext></msup><annotation encoding="application/x-tex">C^{\text{diag}}</annotation></semantics></math> is effectively the 1RDM. Concretely, POLCA can detect that along direction <math id="A3.SS6.p3.m5" class="ltx_Math" alttext="b_{k}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>k</mi></msub><annotation encoding="application/x-tex">b_{k}</annotation></semantics></math>, samples in cluster <math id="A3.SS6.p3.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> undergo a breakthrough at step <math id="A3.SS6.p3.m7" class="ltx_Math" alttext="t^{*}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">t^{*}</annotation></semantics></math>. The loss covariance can additionally detect that samples in cluster <math id="A3.SS6.p3.m8" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and cluster <math id="A3.SS6.p3.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> enter a trade-off relationship at step <math id="A3.SS6.p3.m10" class="ltx_Math" alttext="t^{*}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">t^{*}</annotation></semantics></math> even when this trade-off is not attributable to any single parameter direction but arises from the correlated motion across multiple directions. This is analogous to how the 2-body reduced density matrix captures correlations beyond the mean-field (Hartree-Fock) approximation, which in the quantum setting includes entanglement. In the present setting, these are correlations between the stochastic motions along distinct parameter-space directions.</p>
</div>
<div id="A3.SS6.p4" class="ltx_para">
<p id="A3.SS6.p4.1" class="ltx_p">However, there is an interesting contrast with the normal quantum chemistry use of the 1RDM. In quantum chemistry, the 1RDM is cheap (trace out most of the system) and the 2RDM is expensive (exponentially large Hilbert space). Here the cost structure is inverted. The 1RDM requires you use gradient information while the 2RDM is gradient free.</p>
</div>
</section>
<section id="A3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.7 </span>Relationship with the LLC</h3>

<div id="A3.SS7.p1" class="ltx_para">
<p id="A3.SS7.p1.1" class="ltx_p">Here we describe the relationship with the empirical local learning coefficient of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">23</a>]</cite>, which has a complementary relationship with the 2RDM in the cumulant expansion picture. The empirical estimator of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">23</a>]</cite> can be written as</p>
<table id="A3.E69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E69.m1" class="ltx_Math" alttext="\hat{\lambda}\approx\beta\sum_{i}\left(\mathbb{E}_{\theta}[\ell_{i}]-\ell_{i}(\theta^{*})\right)" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>≈</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>i</mi></munder><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}\approx\beta\sum_{i}\left(\mathbb{E}_{\theta}[\ell_{i}]-\ell_{i}(\theta^{*})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
<p id="A3.SS7.p1.2" class="ltx_p">where <math id="A3.SS7.p1.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is sampled about a point <math id="A3.SS7.p1.m2" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> according to some local distribution. Now, recall the first cumulant <math id="A3.SS7.p1.m3" class="ltx_math_unparsed" alttext="-\beta\sum_{i}\mathbb{E}_{\theta}[\ell_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>β</mi><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>𝔼</mi><mi>θ</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">-\beta\sum_{i}\mathbb{E}_{\theta}[\ell_{i}]</annotation></semantics></math>. The LLC estimator is essentially measuring the shift in this first cumulant relative to the point estimate <math id="A3.SS7.p1.m4" class="ltx_Math" alttext="\ell_{i}(\theta^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell_{i}(\theta^{*})</annotation></semantics></math>. Furthermore, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">23</a>]</cite> they note that the value of <math id="A3.SS7.p1.m5" class="ltx_Math" alttext="\mathbb{E}_{\theta}[\sum_{i}\ell_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mo lspace="0em">∑</mo><mi>i</mi></msub><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\theta}[\sum_{i}\ell_{i}]</annotation></semantics></math> is a good estimator of the widely applicable Bayesian information criterion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">48</a>]</cite>. The cumulant expansion makes it clear why this is. Observing</p>
</div>
<div id="A3.SS7.p2" class="ltx_para">
<table id="A3.E70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E70.m1" class="ltx_math_unparsed" alttext="\log Z(\beta,x_{1:n})=-\beta\sum_{i=1}^{n}\mathbb{E}_{\theta}[l_{i}]+\frac{\beta^{2}}{2}\sum_{i,j}C_{\theta}(x_{i},x_{j})-\frac{\beta^{3}}{6}\sum_{i,j,k}\chi^{3}_{(\theta)}(l_{i},l_{j},l_{k})+\cdots" display="block" intent=":literal"><semantics><mrow><mi>log</mi><mi>Z</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>β</mi><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>𝔼</mi><mi>θ</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>l</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mfrac><msup><mi>β</mi><mn>2</mn></msup><mn>2</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msub><mi>C</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><msup><mi>β</mi><mn>3</mn></msup><mn>6</mn></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow></munder><msubsup><mi>χ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mi>i</mi></msub><mo>,</mo><msub><mi>l</mi><mi>j</mi></msub><mo>,</mo><msub><mi>l</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\log Z(\beta,x_{1:n})=-\beta\sum_{i=1}^{n}\mathbb{E}_{\theta}[l_{i}]+\frac{\beta^{2}}{2}\sum_{i,j}C_{\theta}(x_{i},x_{j})-\frac{\beta^{3}}{6}\sum_{i,j,k}\chi^{3}_{(\theta)}(l_{i},l_{j},l_{k})+\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A3.SS7.p2.1" class="ltx_p">so then</p>
<table id="A3.E71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E71.m1" class="ltx_math_unparsed" alttext="\frac{\partial\log Z(\beta,x_{1:n})}{\partial\beta}=\sum_{i=1}^{n}\mathbb{E}_{\theta}[l_{i}]+\beta\sum_{i,j}C_{\theta}(x_{i},x_{j})-\dots" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo rspace="0.167em">∂</mo><mi>log</mi><mi>Z</mi><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>∂</mo><mi>β</mi></mrow></mfrac><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>𝔼</mi><mi>θ</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>l</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>β</mi><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msub><mi>C</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">\frac{\partial\log Z(\beta,x_{1:n})}{\partial\beta}=\sum_{i=1}^{n}\mathbb{E}_{\theta}[l_{i}]+\beta\sum_{i,j}C_{\theta}(x_{i},x_{j})-\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
</table>
<p id="A3.SS7.p2.2" class="ltx_p">then for small <math id="A3.SS7.p2.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, the free energy expansion is dominated by the first cumulant. In general, one takes <math id="A3.SS7.p2.m2" class="ltx_Math" alttext="\beta=\frac{1}{\log n}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\beta=\frac{1}{\log n}</annotation></semantics></math>. The estimator in equation <a href="#A3.E69" title="In C.7 Relationship with the LLC ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">69</span></a> is then designed to extract the entropic contribution.</p>
</div>
<div id="A3.SS7.p3" class="ltx_para">
<p id="A3.SS7.p3.1" class="ltx_p">This relationship does suggest that one can compute the LLC dynamically, similar to the 2RDM. While we did not perform extensive investigation of this, we compared computing such a dynamical LLC on the induction heads task and compared it with the LLC computed via <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">45</a>]</cite>, as can be seen in figure <a href="#A3.F13" title="Figure 13 ‣ C.7 Relationship with the LLC ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>. We find that it generally agrees during transitions, though after it seems to diverge slightly. This is too be expected however due to the difference in sampling being the most pronounced away from transitions. However, the trajectory-based LLC is cheap to compute, and effectively free if computing the 2RDM, making it an appealing method. Furthermore, it is likely possible to compute this directly off the training samples, which would be much more computationally efficient.</p>
</div>
<figure id="A3.F13" class="ltx_figure"><img src="2603.29805v1/figures/dynamic_llc_vs_llc.png" id="A3.F13.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/234;" width="471" height="234" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F13.3" class="ltx_text" style="font-size:90%;">Figure 13</span>: </span><span id="A3.F13.4" class="ltx_text" style="font-size:90%;">Dynamical LLC vs. the LLC computed via <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">45</a>]</cite></span></figcaption>
</figure>
</section>
<section id="A3.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.8 </span>Relationship with the Loss Kernel</h3>

<div id="A3.SS8.p1" class="ltx_para">
<p id="A3.SS8.p1.1" class="ltx_p">The relationship with the loss kernel of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite> is rather straightforward. The loss kernel is effectively the a modified Gaussian 2RDM with where one weights the parameters by their loss. That is, one samples about <math id="A3.SS8.p1.m1" class="ltx_Math" alttext="\theta^{0}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\theta^{0}</annotation></semantics></math> according to</p>
<table id="A3.E72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E72.m1" class="ltx_Math" alttext="e^{-\beta L_{n}(\theta)}\mathcal{N}(\theta|\theta^{0},\sigma^{2}I)" display="block" intent=":literal"><semantics><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>θ</mi><mn>0</mn></msup><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e^{-\beta L_{n}(\theta)}\mathcal{N}(\theta|\theta^{0},\sigma^{2}I)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
</table>
<p id="A3.SS8.p1.2" class="ltx_p">and is theoretically motivated by the singular fluctuation of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">47</a>]</cite>. Another way to state this is that the 2RDM coincides with the loss kernel when the parameter distribution is given by the tempered Bayesian posterior (on the probe set). However, our analysis is focused on discovering concrete observables from these objects, and can be largely considered as unveiling hidden usefulness in this class of objects. That being said, validation for studying such objects is already seen in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">24</a>]</cite>.</p>
</div>
</section>
<section id="A3.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.9 </span>Trajectory Sampling vs. Local Perturbation Sampling</h3>

<section id="A3.SS9.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.9.1 </span>Trajectory Based Sampling</h4>

<div id="A3.SS9.SSS1.p1" class="ltx_para">
<p id="A3.SS9.SSS1.p1.1" class="ltx_p">The trajectory-based approach constructs the covariance by recording per-sample losses at checkpoints along the actual training path. Its primary advantage is computational efficiency: since training is already generating a sequence of parameter configurations, the only additional cost is a forward pass on the probe set at each checkpoint. If the probe set is relatively small, this can be negligible relative to the training step itself. That is, one has an extra forward pass on <math id="A3.SS9.SSS1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples per checkpoint. Over a window of <math id="A3.SS9.SSS1.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> checkpoints, you accumulate <math id="A3.SS9.SSS1.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> samples of the loss vector <math id="A3.SS9.SSS1.p1.m4" class="ltx_Math" alttext="\ell_{t}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\ell_{t}\in\mathbb{R}^{n}</annotation></semantics></math>, and the <math id="A3.SS9.SSS1.p1.m5" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> covariance costs <math id="A3.SS9.SSS1.p1.m6" class="ltx_Math" alttext="O(Tn^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(Tn^{2})</annotation></semantics></math> to estimate.</p>
</div>
<div id="A3.SS9.SSS1.p2" class="ltx_para">
<p id="A3.SS9.SSS1.p2.1" class="ltx_p">Trajectory based sampling also suffers considerably less from the curse of dimensionality in an important way. The trajectory generates samples from a distribution supported on a submanifold of parameter space that is being explored by the optimizer. The tangent space of this submanifold at any point is spanned by the loss gradients (plus higher-order corrections from momentum, Adam’s preconditioner, etc.). The covariance <math id="A3.SS9.SSS1.p2.m1" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math> is the covariance of a distribution on this submanifold, so it has rank at most equal to the dimension of the submanifold. Think of the trajectory as performing importance sampling over parameter-space directions, where the importance weights are determined by behaviour of the dynamics on the loss landscape itself. Directions with large gradient components get sampled proportionally more because the optimizer moves along them. Directions with zero gradient are never sampled because the optimizer ignores them. In essence, the trajectory based sampling method is simply more efficient.</p>
</div>
<div id="A3.SS9.SSS1.p3" class="ltx_para">
<p id="A3.SS9.SSS1.p3.1" class="ltx_p">The biggest disadvantage is that it introduces lag. The trajectory samples are temporally correlated, so the effective sample size for covariance estimation is reduced by a factor of the autocorrelation time <math id="A3.SS9.SSS1.p3.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. When new directions become relevant at a transition, the optimizer takes several steps to begin exploring them, so <math id="A3.SS9.SSS1.p3.m2" class="ltx_Math" alttext="\Sigma_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\theta}</annotation></semantics></math> underweights newly opened directions for a brief period. This lag is typically short (on the order of <math id="A3.SS9.SSS1.p3.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>), but it means the trajectory-based covariance is not an instantaneous snapshot of the landscape. The method requires a window of training steps, introducing a window-size hyperparameter that trades temporal resolution against statistical quality. Another thing to note which is either an advantage or disadvantage depending on perspective is that using trajectory based sampling implicitly encodes the behaviours of the optimizers meaning that phase transitions in the optimizer will show up, which may not reflect behavioural changes. An example of this is actually in the NESS behaviour shown in section <a href="#S3.SS3" title="3.3 Grokking Modular Arithmetic ‣ 3 Experimental Results ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>.</p>
</div>
</section>
<section id="A3.SS9.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.9.2 </span>Local Perturbation Sampling</h4>

<div id="A3.SS9.SSS2.p1" class="ltx_para">
<p id="A3.SS9.SSS2.p1.1" class="ltx_p">Local sampling constructs the covariance by drawing perturbations around a fixed configuration and evaluating per-sample losses at each perturbed point. Its main advantage is that it provides a clean, instantaneous snapshot of the loss geometry at a single checkpoint, with no temporal smearing and no dependence on optimizer state. In the isotropic case <math id="A3.SS9.SSS2.p1.m1" class="ltx_Math" alttext="\varepsilon\sim\mathcal{N}(0,\sigma^{2}I)" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\sim\mathcal{N}(0,\sigma^{2}I)</annotation></semantics></math>, the result is proportional to the Gram matrix <math id="A3.SS9.SSS2.p1.m2" class="ltx_Math" alttext="GG^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">GG^{\top}</annotation></semantics></math>, which is the sample-space representation of the empirical Fisher. This makes local sampling well-suited for post-hoc analysis of pretrained models, where no training trajectory is available, and for any setting where one wants to disentangle landscape geometry from optimizer dynamics.</p>
</div>
<div id="A3.SS9.SSS2.p2" class="ltx_para">
<p id="A3.SS9.SSS2.p2.1" class="ltx_p">Local sampling also avoids the lag problem: because perturbations are isotropic, all directions are probed equally, so newly relevant directions are detected immediately without waiting for the optimizer to discover them. The samples are independent, so there is no autocorrelation penalty, and no window-size hyperparameter is needed. In principle, one can also use non-isotropic sampling distributions tailored to specific questions, as the trajectory based sampling is effectively an extreme version of this.</p>
</div>
<div id="A3.SS9.SSS2.p3" class="ltx_para">
<p id="A3.SS9.SSS2.p3.1" class="ltx_p">The critical disadvantage is computational cost, driven by the curse of dimensionality. Isotropic perturbations in <math id="A3.SS9.SSS2.p3.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-dimensional parameter space waste a fraction <math id="A3.SS9.SSS2.p3.m2" class="ltx_Math" alttext="1-r_{\text{eff}}/p" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>r</mi><mtext>eff</mtext></msub><mo>/</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">1-r_{\text{eff}}/p</annotation></semantics></math> (<math id="A3.SS9.SSS2.p3.m3" class="ltx_Math" alttext="r_{\text{eff}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mtext>eff</mtext></msub><annotation encoding="application/x-tex">r_{\text{eff}}</annotation></semantics></math> is the effective rank of the Jacobian) of their energy on directions orthogonal to the gradient subspace, so the signal-to-noise ratio for estimating the relevant covariance structure is suppressed by a factor of <math id="A3.SS9.SSS2.p3.m4" class="ltx_Math" alttext="r_{\text{eff}}/p" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mtext>eff</mtext></msub><mo>/</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">r_{\text{eff}}/p</annotation></semantics></math>. Recovering equivalent statistical quality to the trajectory method requires <math id="A3.SS9.SSS2.p3.m5" class="ltx_Math" alttext="O(p/r_{\text{eff}})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>/</mo><msub><mi>r</mi><mtext>eff</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(p/r_{\text{eff}})</annotation></semantics></math> times more sample. For large models, this makes isotropic local sampling effectively intractable.</p>
</div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>First vs. Second Order Phase Transitions</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">Here we give an informal discussion of first vs. second order transitions and their impact on learning. An in-depth formal analysis is left for a future work, however the intuitive picture we believe can be insightful.</p>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">Classically, critical slowing down works as an early warning signal for second order transitions<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">38</a>]</cite>. As the system approaches the critical point, the curvature changes smoothly and vanishes, so the effective restoring force in the potential well weakens, producing critical slowing down, rising autocorrelation, and diverging variance. What’s happening microscopically in the potential energy landscape is that the energy surface is gradually reshaping in a way that makes more configurations accessible near the transition. If we consider instead the free energy <math id="A4.p2.m1" class="ltx_Math" alttext="F=L-S_{c}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mi>L</mi><mo>−</mo><msub><mi>S</mi><mi>c</mi></msub></mrow></mrow><annotation encoding="application/x-tex">F=L-S_{c}</annotation></semantics></math> (where <math id="A4.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is the loss/potential and <math id="A4.p2.m3" class="ltx_Math" alttext="S_{c}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>c</mi></msub><annotation encoding="application/x-tex">S_{c}</annotation></semantics></math> is the configurational entropy) instead of the potential energy, one can say that both energy and entropy conspire to smoothly flatten the free energy landscape.</p>
</div>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p">For first order transitions, this is different. The first derivative of the free energy with respect to temperature is the entropy, so a first order transition is by definition a discontinuous change in the entropy of the system. The system doesn’t gradually expand its exploration of configuration space. It’s sampling one set of microstates, and then abruptly switches to sampling a completely different set. The entropy change is the difference in the logarithm of the accessible phase space volume between these two basins, and that difference is released all at once. This means there’s no progressive broadening of fluctuations to detect. Right up until the transition, the system is exploring the same region of configuration space it always was. The metastable basin hasn’t changed shape in any dramatic way. The system’s local statistical behavior reflects the curvature and geometry of the basin it’s currently in, and that basin remains well-defined.</p>
</div>
<div id="A4.p4" class="ltx_para">
<p id="A4.p4.1" class="ltx_p">One particular type of first order transition is nucleation<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">18</a>]</cite>, where the system has a barrier in the free energy whose peak corresponds to the formation of a critical nucleus, which then rapidly grows in size. While this is technically a first order transition, it is in principle possible to detect the formation of the critical nucleus before the rapid growth stage and suppress it but this is simply very hard in practice due to physical constraints.</p>
</div>
<div id="A4.p5" class="ltx_para">
<p id="A4.p5.1" class="ltx_p">Most of the known transitions in deep learning are more like first order transitions. There is potentially a sampling bias reason for this. Since first order transitions tend to correspond to sudden capability jumps, they are easy to notice in evaluation metrics and then investigate internally. A second-order transition, by contrast, would show up as a smooth change in performance but with anomalous scaling or divergent fluctuations near the critical point which are things you’d only see if you were specifically looking for them with the right probes. However, it is worth noting that the river valley landscape effect <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib43" title="" class="ltx_ref">49</a>]</cite> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib44" title="" class="ltx_ref">27</a>]</cite> is effectively a nucleation-like first order phase transition. We have seen though that the SHC spikes for such first order transitions (silent alignment) meaning it spikes before the rapid growth of the nucleus. Furthermore, one can see from the equations in appendix <a href="#A3.SS3" title="C.3 Interpreting the Decomposition ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a> that it is in principle possible to do attribution along parameter directions and subsequently lock out these updates. While this is promising, there is an important caveat to this.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Maxwell’s Demon in Deep Learning</h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">Consider that we train some network on some task, and we observe a spike in the SHC for an undesirable behaviour, then go in and freeze out the corresponding parameters which were trying to learn the behaviour. Now, one might hope that this is sufficient to lock out the behaviour from forming, but this need not be the case. Indeed, it is known that near initialization random features have nonzero alignment with the target and are therefore useful for the task <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">12</a>]</cite>. Then, the first random feature to become aligned with the target and enter the amplification phase will be detected by the SHC and the corresponding per-sample gradient vector gives the corresponding paramters. If we lock out those parameters, the next closest random feature will then show up, then the next, then the next. In a small network, we might be able to perform this iteratively, but in a sufficiently large network this becomes computationally restrictive, as the parameter attribution is computationally burdensome, and would need to be repeated. In essence, one needs to behave as Maxwell’s demon <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib46" title="" class="ltx_ref">43</a>]</cite>. This indicates that instead of simply ablating out each feature, one needs to change the data distribution so those features simply are not beneficial for minimizing the loss, which is in some sense similar to changing to composition of a chemical reaction to increase the free energy barrier one needs to overcome to create the critical nucleus.</p>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Deep Linear Networks</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Setup and Notation</h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Deep linear networks (DLNs) are among the simplest toy models of deep learning. A depth-<math id="A5.SS1.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> DLN with parameters <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="\theta=(W_{1},\ldots,W_{L})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=(W_{1},\ldots,W_{L})</annotation></semantics></math> defines a function whose value on an input <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, sampled from a data distribution <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, is given by</p>
<table id="A5.E73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E73.m1" class="ltx_math_unparsed" alttext="f_{\theta}(x)=W_{L}W_{L-1}\cdots W_{1}x." display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>W</mi><mi>L</mi></msub><msub><mi>W</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>W</mi><mn>1</mn></msub><mi>x</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\theta}(x)=W_{L}W_{L-1}\cdots W_{1}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.2" class="ltx_p">Although the realized function <math id="A5.SS1.p1.m5" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math> is linear in the input space, its dependence on the parameters is multilinear in the layer weights. Consequently, the optimization problem is nonconvex in parameter space, even though the target function itself is linear. In a teacher-student regression setting, one fixes a teacher matrix <math id="A5.SS1.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and minimizes the quadratic loss</p>
<table id="A5.E74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E74.m1" class="ltx_Math" alttext="\mathcal{L}(\theta)=\frac{1}{2}\,\mathbb{E}\left[\lVert f_{\theta}(x)-Tx\rVert_{2}^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mrow><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)=\frac{1}{2}\,\mathbb{E}\left[\lVert f_{\theta}(x)-Tx\rVert_{2}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.3" class="ltx_p">It is useful to introduce the input covariance and input-output covariance:</p>
<table id="A5.E75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E75.m1" class="ltx_Math" alttext="\Sigma_{x}=\mathbb{E}[xx^{\top}],\qquad\Sigma_{yx}=\mathbb{E}[yx^{\top}]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>x</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Sigma_{x}=\mathbb{E}[xx^{\top}],\qquad\Sigma_{yx}=\mathbb{E}[yx^{\top}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.4" class="ltx_p">where <math id="A5.SS1.p1.m7" class="ltx_Math" alttext="y=Tx" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">y=Tx</annotation></semantics></math> is the teacher output, so that <math id="A5.SS1.p1.m8" class="ltx_Math" alttext="\Sigma_{yx}=T\Sigma_{x}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>x</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{yx}=T\Sigma_{x}</annotation></semantics></math>. Writing the singular value decomposition of the target map as</p>
<table id="A5.E76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E76.m1" class="ltx_Math" alttext="T=U\,\operatorname{diag}(s_{1},\ldots,s_{r})\,V^{\top},\qquad s_{1}\geq\cdots\geq s_{r}&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mi>U</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>V</mi><mo>⊤</mo></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>s</mi><mi>r</mi></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T=U\,\operatorname{diag}(s_{1},\ldots,s_{r})\,V^{\top},\qquad s_{1}\geq\cdots\geq s_{r}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.5" class="ltx_p">provides a useful basis for analyzing the learning dynamics mode by mode.</p>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>The Silent Alignment Effect</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">Assuming whitened inputs, training from small initialization in a two-layer deep linear network exhibits two qualitatively distinct phases: an early alignment phase followed by a fitting (or spectral learning) phase. During the alignment phase, the kernel eigendirections align with the teacher direction, while the network output and loss vary only weakly. This alignment occurs on a timescale of order</p>
<table id="A5.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex14.m1" class="ltx_Math" alttext="t_{\mathrm{align}}=O\!\left(\frac{1}{\eta s}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mi>align</mi></msub><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t_{\mathrm{align}}=O\!\left(\frac{1}{\eta s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.2" class="ltx_p">where <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is the teacher singular value. Substantial fitting occurs later, on a longer timescale</p>
<table id="A5.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex15.m1" class="ltx_Math" alttext="t_{\mathrm{fit}}=O\!\left(\frac{1}{\eta s}\log\!\frac{s}{\sigma^{2}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mi>fit</mi></msub><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mfrac><mi>s</mi><msup><mi>σ</mi><mn>2</mn></msup></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t_{\mathrm{fit}}=O\!\left(\frac{1}{\eta s}\log\!\frac{s}{\sigma^{2}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.3" class="ltx_p">where <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> is the initialization scale. The separation</p>
<table id="A5.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex16.m1" class="ltx_Math" alttext="t_{\mathrm{align}}\ll t_{\mathrm{fit}}" display="block" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>align</mi></msub><mo>≪</mo><msub><mi>t</mi><mi>fit</mi></msub></mrow><annotation encoding="application/x-tex">t_{\mathrm{align}}\ll t_{\mathrm{fit}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.4" class="ltx_p">for small <math id="A5.SS2.p1.m3" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> is the silent alignment effect.</p>
</div>
<div id="A5.SS2.p2" class="ltx_para">
<p id="A5.SS2.p2.1" class="ltx_p">For simplicity, consider a two-layer DLN with scalar output</p>
<table id="A5.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex17.m1" class="ltx_Math" alttext="f(\theta,x)=a^{\top}Wx,\qquad y(x)=s\,\beta^{\top}x," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>a</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>β</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f(\theta,x)=a^{\top}Wx,\qquad y(x)=s\,\beta^{\top}x,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.2" class="ltx_p">with whitened inputs. At early times, the gradient flow dynamics satisfy</p>
<table id="A5.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex18.m1" class="ltx_Math" alttext="\frac{d}{dt}a=\eta s\,W\beta+O(\sigma^{3}),\qquad\frac{d}{dt}W=\eta s\,a\beta^{\top}+O(\sigma^{3})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>=</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo>=</mo><mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{d}{dt}a=\eta s\,W\beta+O(\sigma^{3}),\qquad\frac{d}{dt}W=\eta s\,a\beta^{\top}+O(\sigma^{3}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.3" class="ltx_p">The neural tangent kernel is</p>
<table id="A5.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex19.m1" class="ltx_Math" alttext="K(x,x^{\prime};t)=x^{\top}M(t)x^{\prime},\qquad M(t):=W(t)^{\top}W(t)+\|a(t)\|^{2}I." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K(x,x^{\prime};t)=x^{\top}M(t)x^{\prime},\qquad M(t):=W(t)^{\top}W(t)+\|a(t)\|^{2}I.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.4" class="ltx_p">To distinguish kernel alignment from function fitting, define</p>
<table id="A5.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex20.m1" class="ltx_Math" alttext="q(t):=\frac{1}{2}\,\beta^{\top}M(t)\beta,\qquad r(t):=a(t)^{\top}W(t)\beta." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>β</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q(t):=\frac{1}{2}\,\beta^{\top}M(t)\beta,\qquad r(t):=a(t)^{\top}W(t)\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p2.5" class="ltx_p">Here <math id="A5.SS2.p2.m1" class="ltx_Math" alttext="q(t)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(t)</annotation></semantics></math> measures the strength of the NTK in the teacher direction <math id="A5.SS2.p2.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, whereas <math id="A5.SS2.p2.m3" class="ltx_Math" alttext="r(t)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(t)</annotation></semantics></math> measures the component of the learned predictor along that same mode.</p>
</div>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p">At leading order, these quantities obey</p>
<table id="A5.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex21.m1" class="ltx_Math" alttext="\dot{q}=2\eta s\,r,\qquad\dot{r}=2\eta s\,q." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>q</mi><mo>˙</mo></mover><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{q}=2\eta s\,r,\qquad\dot{r}=2\eta s\,q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.2" class="ltx_p">If <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="r(0)\approx 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r(0)\approx 0</annotation></semantics></math>, then</p>
<table id="A5.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex22.m1" class="ltx_Math" alttext="q(t)=q_{0}\cosh(2\eta st),\qquad r(t)=q_{0}\sinh(2\eta st)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q(t)=q_{0}\cosh(2\eta st),\qquad r(t)=q_{0}\sinh(2\eta st),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.3" class="ltx_p">with <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="q_{0}=O(\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{0}=O(\sigma^{2})</annotation></semantics></math>. Thus, during the early phase, the kernel develops a rank-one spike in the teacher direction:</p>
<table id="A5.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex23.m1" class="ltx_Math" alttext="K(x,x^{\prime};t)\approx c(t)\,x^{\top}x^{\prime}+d(t)\,(x^{\top}\beta)(x^{\prime\top}\beta)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo>+</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">K(x,x^{\prime};t)\approx c(t)\,x^{\top}x^{\prime}+d(t)\,(x^{\top}\beta)(x^{\prime\top}\beta),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.4" class="ltx_p">where <math id="A5.SS2.p3.m3" class="ltx_Math" alttext="d(t)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(t)</annotation></semantics></math> grows exponentially like <math id="A5.SS2.p3.m4" class="ltx_Math" alttext="e^{2\eta st}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><annotation encoding="application/x-tex">e^{2\eta st}</annotation></semantics></math>. This means that the eigendirections of the NTK align to the task on the timescale</p>
<table id="A5.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex24.m1" class="ltx_Math" alttext="t_{\mathrm{align}}=O\!\left(\frac{1}{\eta s}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mi>align</mi></msub><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t_{\mathrm{align}}=O\!\left(\frac{1}{\eta s}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p">By contrast, fitting requires the teacher-mode coefficient to become order <math id="A5.SS2.p4.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>. Since initially</p>
<table id="A5.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex25.m1" class="ltx_Math" alttext="r(t)=O(\sigma^{2}e^{2\eta st})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r(t)=O(\sigma^{2}e^{2\eta st}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p4.2" class="ltx_p">this occurs only when</p>
<table id="A5.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex26.m1" class="ltx_Math" alttext="\sigma^{2}e^{2\eta st_{\mathrm{fit}}}=O(s)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>fit</mi></msub></mrow></msup></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sigma^{2}e^{2\eta st_{\mathrm{fit}}}=O(s),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p4.3" class="ltx_p">that is,</p>
<table id="A5.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex27.m1" class="ltx_Math" alttext="t_{\mathrm{fit}}=O\!\left(\frac{1}{\eta s}\log\!\frac{s}{\sigma^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mi>fit</mi></msub><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mfrac><mi>s</mi><msup><mi>σ</mi><mn>2</mn></msup></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t_{\mathrm{fit}}=O\!\left(\frac{1}{\eta s}\log\!\frac{s}{\sigma^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p4.4" class="ltx_p">After alignment, the effective predictor <math id="A5.SS2.p4.m2" class="ltx_Math" alttext="u(t)=W(t)^{\top}a(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u(t)=W(t)^{\top}a(t)</annotation></semantics></math> is approximately parallel to <math id="A5.SS2.p4.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, so that</p>
<table id="A5.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex28.m1" class="ltx_Math" alttext="f(x,t)\approx r(t)\beta^{\top}x." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(x,t)\approx r(t)\beta^{\top}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p4.5" class="ltx_p">During the alignment timescale, however, one still has <math id="A5.SS2.p4.m4" class="ltx_Math" alttext="r(t)=O(\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r(t)=O(\sigma^{2})</annotation></semantics></math>, hence the network output remains small and the loss barely changes. This is why the alignment is silent.</p>
</div>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p">A convenient observable for this effect is the normalized kernel-label overlap</p>
<table id="A5.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex29.m1" class="ltx_Math" alttext="A(t)=\frac{y^{\top}K(t)y}{\|K(t)\|_{F}\,\|y\|_{2}^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msup><mi>y</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A(t)=\frac{y^{\top}K(t)y}{\|K(t)\|_{F}\,\|y\|_{2}^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p5.2" class="ltx_p">which tracks how strongly the kernel has aligned to the target direction independently of its overall scale.</p>
</div>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p">When the whitened-input assumption is relaxed, data anisotropy introduces multiple competing directions and timescales. In that setting, the kernel can continue to realign while the loss is already decreasing, so the clean separation between alignment and fitting can break down.</p>
</div>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Comparison With Other Methods</h2>

<div id="A6.p1" class="ltx_para">
<p id="A6.p1.1" class="ltx_p">Here we compare the 2RDM (more specifically the SHC) with the LLC of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">23</a>]</cite> and the gradient norm, as the grad norm was suggested as an early detection signal in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">3</a>]</cite>. We note here that the sampling frequency is lowered here (from 10 to 50 steps), decreasing the temporal resolution of the SHC. There is an important distinction between what the LLC is designed to do and what the SHC is designed to do. As discussed in appendix <a href="#A3.SS7" title="C.7 Relationship with the LLC ‣ Appendix C Theoretical Properties of the 2RDM ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a>, the LLC is meant to capture the entropic component of the free energy, which is like the total volume of accessible parameter space near the current configuration. As one moves towards a place in the basin where the curvature becomes anisotropic, the SHC will detect this, while the LLC still gives a similar value since you are within the same basin, changing after the transition. Fundamentally, the LLC is meant to measure something different about the loss landscape, and is a complementary measure. This is particularly apparent in the induction heads case in figure <a href="#A6.F14" title="Figure 14 ‣ Appendix F Comparison With Other Methods ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>, where the SHC spikes before the increase in the LLC. For other transitions, like grokking, the LLC and SHC both pick up on the loss structure change, which can be seen by comparing figures <a href="#A6.F16" title="Figure 16 ‣ Appendix F Comparison With Other Methods ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> and <a href="#A6.F15" title="Figure 15 ‣ Appendix F Comparison With Other Methods ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>. One should suspect that both would detect the change in the loss. Interestingly the minima between the two spikes in the SHC aligns with the inflection point of the LLC, and the inflection of the gradient norm.</p>
</div>
<figure id="A6.F14" class="ltx_figure"><img src="2603.29805v1/figures/combined_grad_shc_llc.png" id="A6.F14.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/234;" width="471" height="234" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A6.F14.3" class="ltx_text" style="font-size:90%;">Figure 14</span>: </span><span id="A6.F14.4" class="ltx_text" style="font-size:90%;">LLC, SHC, and grad norm compared with induction head scores.</span></figcaption>
</figure>
<figure id="A6.F15" class="ltx_figure"><img src="2603.29805v1/figures/diag_combined_shc_grad_llc.png" id="A6.F15.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/234;" width="471" height="234" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A6.F15.3" class="ltx_text" style="font-size:90%;">Figure 15</span>: </span><span id="A6.F15.4" class="ltx_text" style="font-size:90%;">LLC, SHC, and grad norm compared with accuracy on grokking.</span></figcaption>
</figure>
<figure id="A6.F16" class="ltx_figure"><img src="2603.29805v1/figures/diag_loss_vs_llc.png" id="A6.F16.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/233;" width="471" height="233" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A6.F16.3" class="ltx_text" style="font-size:90%;">Figure 16</span>: </span><span id="A6.F16.4" class="ltx_text" style="font-size:90%;">Loss on Grokking vs. LLC</span></figcaption>
</figure>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Experiment Details</h2>

<section id="A7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.1 </span>Deep Linear Networks</h3>

<div id="A7.SS1.p1" class="ltx_para">
<p id="A7.SS1.p1.1" class="ltx_p">We train a deep linear network of depth <math id="A7.SS1.p1.m1" class="ltx_Math" alttext="L=5" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">L=5</annotation></semantics></math> with input and output dimensions <math id="A7.SS1.p1.m2" class="ltx_Math" alttext="d_{\mathrm{in}}=d_{\mathrm{out}}=3" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>in</mi></msub><mo>=</mo><msub><mi>d</mi><mi>out</mi></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d_{\mathrm{in}}=d_{\mathrm{out}}=3</annotation></semantics></math>. The network composes <math id="A7.SS1.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> linear layers <math id="A7.SS1.p1.m4" class="ltx_Math" alttext="W_{1},W_{2},\ldots,W_{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">W_{1},W_{2},\ldots,W_{L}</annotation></semantics></math> to compute <math id="A7.SS1.p1.m5" class="ltx_math_unparsed" alttext="f_{\theta}(x)=W_{L}W_{L-1}\cdots W_{1}x" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>W</mi><mi>L</mi></msub><msub><mi>W</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>W</mi><mn>1</mn></msub><mi>x</mi></mrow><annotation encoding="application/x-tex">f_{\theta}(x)=W_{L}W_{L-1}\cdots W_{1}x</annotation></semantics></math>, and is trained on <math id="A7.SS1.p1.m6" class="ltx_Math" alttext="n=400" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">n=400</annotation></semantics></math> samples drawn from a rank-<math id="A7.SS1.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> teacher with <math id="A7.SS1.p1.m8" class="ltx_Math" alttext="k=3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k=3</annotation></semantics></math> nonzero singular values. The teacher’s singular values are spaced logarithmically between <math id="A7.SS1.p1.m9" class="ltx_Math" alttext="s_{\max}/r" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>max</mi></msub><mo>/</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">s_{\max}/r</annotation></semantics></math> and <math id="A7.SS1.p1.m10" class="ltx_Math" alttext="s_{\max}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>max</mi></msub><annotation encoding="application/x-tex">s_{\max}</annotation></semantics></math>, with maximum singular value <math id="A7.SS1.p1.m11" class="ltx_Math" alttext="s_{\max}=5.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>max</mi></msub><mo>=</mo><mn>5.0</mn></mrow><annotation encoding="application/x-tex">s_{\max}=5.0</annotation></semantics></math> and spread ratio <math id="A7.SS1.p1.m12" class="ltx_Math" alttext="r=7.0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>7.0</mn></mrow><annotation encoding="application/x-tex">r=7.0</annotation></semantics></math>, producing a well-separated spectrum that induces sequential learning of singular components.</p>
</div>
<div id="A7.SS1.p2" class="ltx_para">
<p id="A7.SS1.p2.1" class="ltx_p">All weight matrices are initialized as <math id="A7.SS1.p2.m1" class="ltx_Math" alttext="W_{\ell}=\alpha\cdot I+\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>I</mi></mrow><mo>+</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">W_{\ell}=\alpha\cdot I+\epsilon</annotation></semantics></math> with scale <math id="A7.SS1.p2.m2" class="ltx_Math" alttext="\alpha=10^{-4}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\alpha=10^{-4}</annotation></semantics></math>, placing the network in the saddle-to-saddle regime where training proceeds through a sequence of sharp transitions as each singular value emerges from the origin <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">37</a>]</cite> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">15</a>]</cite>. We use full-batch gradient descent with learning rate <math id="A7.SS1.p2.m3" class="ltx_Math" alttext="\eta=0.05" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\eta=0.05</annotation></semantics></math> for <math id="A7.SS1.p2.m4" class="ltx_Math" alttext="60{,}000" display="inline" intent=":literal"><semantics><mn>60,000</mn><annotation encoding="application/x-tex">60{,}000</annotation></semantics></math> gradient steps, logging every <math id="A7.SS1.p2.m5" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math> steps. No mini-batching is employed (batch size equals the full training set), so all stochasticity arises from the dynamics themselves rather than gradient noise.</p>
</div>
<div id="A7.SS1.p3" class="ltx_para">
<p id="A7.SS1.p3.1" class="ltx_p">To compute the loss covariance matrix <math id="A7.SS1.p3.m1" class="ltx_Math" alttext="C(t)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(t)</annotation></semantics></math> and its derived diagnostics, we evaluate the per-sample loss on a fixed probe set of <math id="A7.SS1.p3.m2" class="ltx_Math" alttext="n_{\mathrm{probe}}=100" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>probe</mi></msub><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">n_{\mathrm{probe}}=100</annotation></semantics></math> samples every <math id="A7.SS1.p3.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> training steps within each measurement window. The top <math id="A7.SS1.p3.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> spectral modes are tracked for alignment analysis. In general, we run experiments over 30 various random seeds, however when individual experiments are used for analysis we use the random seed of 42 for reproducibility.</p>
</div>
<div id="A7.SS1.p4" class="ltx_para">
<p id="A7.SS1.p4.1" class="ltx_p">Table <a href="#A7.T2" title="Table 2 ‣ G.1 Deep Linear Networks ‣ Appendix G Experiment Details ‣ From Density Matrices to Phase Transitions in Deep Learning: Spectral Early Warnings and Interpretability" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> summarizes the full configuration.</p>
</div>
<figure id="A7.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A7.T2.3" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="A7.T2.4" class="ltx_text" style="font-size:90%;">Hyperparameters for the deep linear network experiments.</span></figcaption>
<table id="A7.T2.5" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A7.T2.5.1" class="ltx_tr">
<td id="A7.T2.5.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A7.T2.5.1.1.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A7.T2.5.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A7.T2.5.1.2.1" class="ltx_text ltx_font_bold">Value</span></td>
<td id="A7.T2.5.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt"><span id="A7.T2.5.1.3.1" class="ltx_text ltx_font_bold">Description</span></td></tr>
<tr id="A7.T2.5.2" class="ltx_tr">
<td id="A7.T2.5.2.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3"><span id="A7.T2.5.2.1.1" class="ltx_text ltx_font_italic">Architecture</span></td></tr>
<tr id="A7.T2.5.3" class="ltx_tr">
<td id="A7.T2.5.3.1" class="ltx_td ltx_align_left"><math id="A7.T2.m1" class="ltx_Math" alttext="d_{\mathrm{in}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>in</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{in}}</annotation></semantics></math>, <math id="A7.T2.m2" class="ltx_Math" alttext="d_{\mathrm{out}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>out</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{out}}</annotation></semantics></math></td>
<td id="A7.T2.5.3.2" class="ltx_td ltx_align_left"><math id="A7.T2.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td>
<td id="A7.T2.5.3.3" class="ltx_td ltx_nopad_r ltx_align_left">Input / output dimension</td></tr>
<tr id="A7.T2.5.4" class="ltx_tr">
<td id="A7.T2.5.4.1" class="ltx_td ltx_align_left"><math id="A7.T2.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></td>
<td id="A7.T2.5.4.2" class="ltx_td ltx_align_left"><math id="A7.T2.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math></td>
<td id="A7.T2.5.4.3" class="ltx_td ltx_nopad_r ltx_align_left">Number of linear layers</td></tr>
<tr id="A7.T2.5.5" class="ltx_tr">
<td id="A7.T2.5.5.1" class="ltx_td ltx_align_left"><math id="A7.T2.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></td>
<td id="A7.T2.5.5.2" class="ltx_td ltx_align_left"><math id="A7.T2.m7" class="ltx_Math" alttext="10^{-4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><annotation encoding="application/x-tex">10^{-4}</annotation></semantics></math></td>
<td id="A7.T2.5.5.3" class="ltx_td ltx_nopad_r ltx_align_left">Initialization scale</td></tr>
<tr id="A7.T2.5.6" class="ltx_tr">
<td id="A7.T2.5.6.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3"><span id="A7.T2.5.6.1.1" class="ltx_text ltx_font_italic">Training</span></td></tr>
<tr id="A7.T2.5.7" class="ltx_tr">
<td id="A7.T2.5.7.1" class="ltx_td ltx_align_left">Learning rate <math id="A7.T2.m8" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math></td>
<td id="A7.T2.5.7.2" class="ltx_td ltx_align_left"><math id="A7.T2.m9" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn>0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math></td>
<td id="A7.T2.5.7.3" class="ltx_td ltx_nopad_r ltx_align_left">Fixed step size</td></tr>
<tr id="A7.T2.5.8" class="ltx_tr">
<td id="A7.T2.5.8.1" class="ltx_td ltx_align_left">Training steps</td>
