<td id="A7.T10.5.14.3" class="ltx_td ltx_nopad_r ltx_align_left">Effective batch <math id="A7.T10.m11" class="ltx_Math" alttext="=16" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">=16</annotation></semantics></math></td></tr>
