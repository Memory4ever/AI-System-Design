<td id="A7.T10.5.15.2" class="ltx_td ltx_align_left"><math id="A7.T10.m12" class="ltx_Math" alttext="512" display="inline" intent=":literal"><semantics><mn>512</mn><annotation encoding="application/x-tex">512</annotation></semantics></math></td>
