<th id="S4.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span class="ltx_inline-block"><svg id="S4.T3.pic1" class="ltx_picture" height="17.03" overflow="visible" style="vertical-align:-0.61px" version="1.1" viewBox="0 0 98.43 17.03" width="98.43"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,17.03) matrix(1 0 0 -1 0 0) translate(0,3.59)"><g style="--ltx-stroke-color:#F2F2FF;--ltx-fill-color:#F2F2FF;--ltx-fg-color:#F2F2FF;" color="#F2F2FF" fill="#F2F2FF" stroke="#F2F2FF"><path style="stroke:none" d="M 0 0 M 0 0 L 0 9.84 L 98.43 9.84 L 98.43 0 Z M 98.43 9.84"></path></g><g style="--ltx-stroke-color:#A6A6FF;--ltx-fill-color:#A6A6FF;--ltx-fg-color:#A6A6FF;" color="#A6A6FF" fill="#A6A6FF" stroke="#A6A6FF"><path style="stroke:none" d="M 0 0 M 0 0 L 0 9.84 L 98.43 9.84 L 98.43 0 Z M 98.43 9.84"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 36.39 1.56)"><foreignObject style="--ltx-fo-width:2.32em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.05em;font-size:7.97pt;" height="7.8" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="25.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.T3.pic1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000000;">100%</span></span></span></foreignObject></g></g></svg></span></th>
