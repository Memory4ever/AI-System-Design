<td id="A1.T1.5.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t"><span id="A1.T1.5.2.7.1" class="ltx_text" style="font-size:90%;">224</span></td></tr>
