<td id="S3.T2.2.4.1" class="ltx_td ltx_align_left">V1.1<math id="S3.T2.m3" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></td>
