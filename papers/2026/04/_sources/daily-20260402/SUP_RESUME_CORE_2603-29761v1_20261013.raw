</figure>
<figure id="S3.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span>Training data scales.</figcaption>
<table id="S3.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S3.T3.2.1" class="ltx_tr">
<th id="S3.T3.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S3.T3.2.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<th id="S3.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.2.1" class="ltx_text ltx_font_bold">Games</span></th>
<th id="S3.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.3.1" class="ltx_text ltx_font_bold">Sequences</span></th>
<th id="S3.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.2.1.4.1" class="ltx_text ltx_font_bold">Tokens</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T3.2.2" class="ltx_tr">
<th id="S3.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Scale 1 (V1 series)</th>
<td id="S3.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T3.m1" class="ltx_Math" alttext="{\sim}10" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">{\sim}10</annotation></semantics></math> M</td>
<td id="S3.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T3.m2" class="ltx_Math" alttext="{\sim}20" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">{\sim}20</annotation></semantics></math> M</td>
<td id="S3.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T3.m3" class="ltx_Math" alttext="{\sim}1.4" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>1.4</mn></mrow><annotation encoding="application/x-tex">{\sim}1.4</annotation></semantics></math> B</td></tr>
<tr id="S3.T3.2.3" class="ltx_tr">
<th id="S3.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Scale 2 (V2.2)</th>
<td id="S3.T3.2.3.2" class="ltx_td ltx_align_center"><math id="S3.T3.m4" class="ltx_Math" alttext="{\sim}50" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>50</mn></mrow><annotation encoding="application/x-tex">{\sim}50</annotation></semantics></math> M</td>
<td id="S3.T3.2.3.3" class="ltx_td ltx_align_center"><math id="S3.T3.m5" class="ltx_Math" alttext="{\sim}100" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">{\sim}100</annotation></semantics></math> M</td>
<td id="S3.T3.2.3.4" class="ltx_td ltx_align_center"><math id="S3.T3.m6" class="ltx_Math" alttext="{\sim}7" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">{\sim}7</annotation></semantics></math> B</td></tr>
<tr id="S3.T3.2.4" class="ltx_tr">
<th id="S3.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Scale 3 (V2.3)</th>
<td id="S3.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T3.m7" class="ltx_Math" alttext="{\sim}100" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">{\sim}100</annotation></semantics></math> M</td>
<td id="S3.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T3.m8" class="ltx_Math" alttext="{\sim}150" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>150</mn></mrow><annotation encoding="application/x-tex">{\sim}150</annotation></semantics></math> M</td>
<td id="S3.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T3.m9" class="ltx_Math" alttext="{\sim}14" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>14</mn></mrow><annotation encoding="application/x-tex">{\sim}14</annotation></semantics></math> B</td></tr>
