<td id="S3.T2.2.3.2" class="ltx_td ltx_align_center">28 M</td>
<td id="S3.T2.2.3.3" class="ltx_td ltx_align_center">10 M all-Elo</td>
<td id="S3.T2.2.3.4" class="ltx_td ltx_align_center">Linear</td>
<td id="S3.T2.2.3.5" class="ltx_td ltx_align_center">1.13%</td>
