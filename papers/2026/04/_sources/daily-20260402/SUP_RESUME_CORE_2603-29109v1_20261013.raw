              <math id="alg1.l24.m1" class="ltx_Math" alttext="P^{\prime}\leftarrow\textsc{ApplyPatch}(P,\ell_{j},\delta_{j})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ApplyPatch</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo>,</mo><msub><mi>δ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\prime}\leftarrow\textsc{ApplyPatch}(P,\ell_{j},\delta_{j})</annotation></semantics></math>

