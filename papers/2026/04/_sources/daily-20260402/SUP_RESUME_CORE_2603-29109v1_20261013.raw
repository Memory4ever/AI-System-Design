            <math id="alg1.l3.m1" class="ltx_Math" alttext="\mathit{baseline}\leftarrow\textsc{RerunTests}(P,\mathcal{T})" display="inline" intent=":literal"><semantics><mrow><mi>𝑏𝑎𝑠𝑒𝑙𝑖𝑛𝑒</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">RerunTests</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathit{baseline}\leftarrow\textsc{RerunTests}(P,\mathcal{T})</annotation></semantics></math>

</div>
