            <span id="alg1.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="\mathcal{T}^{-}_{\mathit{obs}}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>𝑜𝑏𝑠</mi><mo>−</mo></msubsup><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}^{-}_{\mathit{obs}}=\emptyset</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">then</span>

