            <math id="alg1.l4.m1" class="ltx_Math" alttext="\mathcal{T}^{-}_{\mathit{obs}}\leftarrow\mathit{baseline}.\mathit{failed}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>𝑜𝑏𝑠</mi><mo>−</mo></msubsup><mo stretchy="false">←</mo><mi>𝑏𝑎𝑠𝑒𝑙𝑖𝑛𝑒</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mi>𝑓𝑎𝑖𝑙𝑒𝑑</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}^{-}_{\mathit{obs}}\leftarrow\mathit{baseline}.\mathit{failed}</annotation></semantics></math>

