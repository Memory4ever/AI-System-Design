<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">(c) </span><span id="S6.T8.st3.3" class="ltx_text ltx_font_bold">LaBSE</span></figcaption>
<div id="S6.T8.st3.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:114.7pt;vertical-align:-52.7pt;"><span class="ltx_transformed_inner" style="transform:translate(80.3pt,-26.7pt) scale(1.87096470955839,1.87096470955839) ;">
<table id="S6.T8.st3.4.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S6.T8.st3.4.1.1" class="ltx_tr">
<th id="S6.T8.st3.4.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt">
<span id="S6.T8.st3.4.1.1.1.1" class="ltx_text ltx_font_bold">Data</span></th>
<th id="S6.T8.st3.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T8.st3.4.1.1.2.1" class="ltx_text ltx_font_bold">Base</span></th>
<th id="S6.T8.st3.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T8.st3.4.1.1.3.1" class="ltx_text ltx_font_bold">P1</span></th>
<th id="S6.T8.st3.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T8.st3.4.1.1.4.1" class="ltx_text ltx_font_bold">P2</span></th>
<th id="S6.T8.st3.4.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T8.st3.4.1.1.5.1" class="ltx_text ltx_font_bold">P3</span></th></tr>
</thead>
