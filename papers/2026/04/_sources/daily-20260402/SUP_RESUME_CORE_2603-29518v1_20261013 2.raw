<tr id="S6.T9.10.1.3" class="ltx_tr">
<th id="S6.T9.10.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="S6.T9.10.1.3.1.1" class="ltx_text ltx_font_bold">ViG</span></th>
<td id="S6.T9.10.1.3.2" class="ltx_td ltx_align_center"><span id="S6.T9.10.1.3.2.1" class="ltx_text ltx_font_bold">0.80</span></td>
