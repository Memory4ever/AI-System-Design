<td id="S6.T9.10.1.4.2" class="ltx_td ltx_align_center"><span id="S6.T9.10.1.4.2.1" class="ltx_text ltx_font_bold">0.94</span></td>
<td id="S6.T9.10.1.4.3" class="ltx_td ltx_align_center">0.91</td>
<td id="S6.T9.10.1.4.4" class="ltx_td ltx_align_center">0.91</td>
