<tr id="S4.T6.12.1.4.2.1.1" class="ltx_tr">
<td id="S4.T6.12.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T6.12.1.4.2.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">inform</span> ( <span id="S4.T6.12.1.4.2.1.1.1.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">name</span> = Wildwood ; <span id="S4.T6.12.1.4.2.1.1.1.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#800080;">near</span> = Café Rouge ; <span id="S4.T6.12.1.4.2.1.1.1.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF00FF;">customer rating</span> = low ; <span id="S4.T6.12.1.4.2.1.1.1.5" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF8000;">eatType</span> = restaurant ) +</td></tr>
