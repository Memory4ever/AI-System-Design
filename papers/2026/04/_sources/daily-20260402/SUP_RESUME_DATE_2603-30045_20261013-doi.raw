{"data":{"id":"10.48550/arxiv.2603.30045","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.30045","prefix":"10.48550","suffix":"arxiv.2603.30045","identifiers":[{"identifier":"2603.30045","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.30045"}],"creators":[{"name":"Liu, Yuheng","nameType":"Personal","givenName":"Yuheng","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Xin","nameType":"Personal","givenName":"Xin","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xinke","nameType":"Personal","givenName":"Xinke","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Baihan","nameType":"Personal","givenName":"Baihan","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Chen","nameType":"Personal","givenName":"Chen","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Sunkavalli, Kalyan","nameType":"Personal","givenName":"Kalyan","familyName":"Sunkavalli","affiliation":[],"nameIdentifiers":[]},{"name":"Hold-Geoffroy, Yannick","nameType":"Personal","givenName":"Yannick","familyName":"Hold-Geoffroy","affiliation":[],"nameIdentifiers":[]},{"name":"Tan, Hao","nameType":"Personal","givenName":"Hao","familyName":"Tan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Kai","nameType":"Personal","givenName":"Kai","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Xiaohui","nameType":"Personal","givenName":"Xiaohui","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Zifan","nameType":"Personal","givenName":"Zifan","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yiwei","nameType":"Personal","givenName":"Yiwei","familyName":"Hu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniRoam: World Wandering via Long-Horizon Panoramic Video Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-31T17:59:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-01T01:12:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Modeling scenes using video generation models has garnered growing research interest in recent years. However, most existing approaches rely on perspective video models that synthesize only limited observations of a scene, leading to issues of completeness and global consistency. We propose OmniRoam, a controllable panoramic video generation framework that exploits the rich per-frame scene coverage and inherent long-term spatial and temporal consistency of panoramic representation, enabling long-horizon scene wandering. Our framework begins with a preview stage, where a trajectory-controlled video generation model creates a quick overview of the scene from a given input image or video. Then, in the refine stage, this video is temporally extended and spatially upsampled to produce long-range, high-resolution videos, thus enabling high-fidelity world wandering. To train our model, we introduce two panoramic video datasets that incorporate both synthetic and real-world captured videos. Experiments show that our framework consistently outperforms state-of-the-art methods in terms of visual quality, controllability, and long-term scene consistency, both qualitatively and quantitatively. We further showcase several extensions of this framework, including real-time video generation and 3D reconstruction. Code is available at https://github.com/yuhengliu02/OmniRoam.","descriptionType":"Abstract"},{"description":"Code is available at https://github.com/yuhengliu02/OmniRoam","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.30045","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-01T02:25:17.000Z","registered":"2026-04-01T02:25:18.000Z","published":"2026","updated":"2026-04-01T02:25:18.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.30045","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}