<td id="A3.T6.2.4.2" class="ltx_td ltx_align_left">8</td></tr>
<tr id="A3.T6.2.5" class="ltx_tr">
<td id="A3.T6.2.5.1" class="ltx_td ltx_align_left">Network architecture</td>
