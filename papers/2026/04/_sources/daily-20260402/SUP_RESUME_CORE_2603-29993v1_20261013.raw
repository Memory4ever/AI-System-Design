<span id="S7.F5.pic1.9.3" class="ltx_p"><span id="S7.F5.pic1.9.3.1" class="ltx_text" style="font-size:70%;">(public ref.)</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;--ltx-fg-color:#7373FF;" color="#7373FF" fill="#7373FF" stroke="#7373FF"><path style="stroke:none" d="M 307.09 0 M 307.09 0 L 307.09 23.43 L 334.65 23.43 L 334.65 0 Z M 334.65 23.43"></path></g><g style="--ltx-stroke-color:#FF7373;--ltx-fill-color:#FF7373;--ltx-fg-color:#FF7373;" color="#FF7373" fill="#FF7373" stroke="#FF7373"><path style="stroke:none" d="M 342.52 0 M 342.52 0 L 342.52 0 L 370.08 0 L 370.08 0 Z M 370.08 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 283.46 -20.62)"><foreignObject style="--ltx-fo-width:10em;--ltx-fo-height:0.49em;--ltx-fo-depth:1.38em;font-size:10pt;" height="25.75" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="138.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
