</figure>
<figure id="S7.F5" class="ltx_figure"><span class="ltx_inline-block"><svg id="S7.F5.pic1" class="ltx_picture ltx_centering" height="257.59" overflow="visible" version="1.1" viewBox="0 0 480.06 257.59" width="480.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,257.59) matrix(1 0 0 -1 0 0) translate(54.59,0) translate(0,52.56)"><g stroke-width="0.4pt"><path style="fill:none" d="M 0 0 L 425.2 0"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 0 0 L 0 204.72"></path></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9" stroke-width="0.2pt"><path style="fill:none" d="M 0 0 L 425.2 0"></path></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.85 -3.57)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="15.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S7.F5.pic1.1" class="ltx_text" style="font-size:80%;">0.0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9" stroke-width="0.2pt"><path style="fill:none" d="M 0 39.37 L 425.2 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.85 35.8)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="15.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S7.F5.pic1.2" class="ltx_text" style="font-size:80%;">0.2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9" stroke-width="0.2pt"><path style="fill:none" d="M 0 78.74 L 425.2 78.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.85 75.17)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="15.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S7.F5.pic1.3" class="ltx_text" style="font-size:80%;">0.4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9" stroke-width="0.2pt"><path style="fill:none" d="M 0 118.11 L 425.2 118.11"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.85 114.54)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="15.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S7.F5.pic1.4" class="ltx_text" style="font-size:80%;">0.6</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9" stroke-width="0.2pt"><path style="fill:none" d="M 0 157.48 L 425.2 157.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.85 153.91)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;fon