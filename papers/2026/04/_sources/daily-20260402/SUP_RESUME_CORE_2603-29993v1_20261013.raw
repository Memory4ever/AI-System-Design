<span id="S7.F5.pic1.8.3" class="ltx_p"><span id="S7.F5.pic1.8.3.1" class="ltx_text" style="font-size:70%;">(public ref.)</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;--ltx-fg-color:#7373FF;" color="#7373FF" fill="#7373FF" stroke="#7373FF"><path style="stroke:none" d="M 173.23 0 M 173.23 0 L 173.23 196.65 L 200.79 196.65 L 200.79 0 Z M 200.79 196.65"></path></g><g style="--ltx-stroke-color:#FF7373;--ltx-fill-color:#FF7373;--ltx-fg-color:#FF7373;" color="#FF7373" fill="#FF7373" stroke="#FF7373"><path style="stroke:none" d="M 208.66 0 M 208.66 0 L 208.66 0 L 236.22 0 L 236.22 0 Z M 236.22 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 161.42 -12.32)"><foreignObject style="--ltx-fo-width:7.85em;--ltx-fo-height:0.49em;--ltx-fo-depth:2.58em;font-size:10pt;" height="42.36" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="108.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
