<td id="A2.T1.2.6.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t">250</td>
<td id="A2.T1.2.6.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">
<span id="A2.T1.2.6.3.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T1.2.6.3.1.1" class="ltx_p ltx_align_left">af doi broiz oos thag plown</span>
</span></td>
