<td id="S6.T13.2.5.5" class="ltx_td ltx_align_center">59</td>
<td id="S6.T13.2.5.6" class="ltx_td ltx_align_center">56</td>
<td id="S6.T13.2.5.7" class="ltx_td ltx_nopad_r ltx_align_center">148</td></tr>
