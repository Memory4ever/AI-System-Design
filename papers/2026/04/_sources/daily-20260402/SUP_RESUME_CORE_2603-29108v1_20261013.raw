<td id="A4.T7.8.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">73.3<sub id="A4.T7.8.4.3.1" class="ltx_sub"><span id="A4.T7.8.4.3.1.1" class="ltx_text ltx_font_italic">±0.1</span></sub></td>
<td id="A4.T7.8.4.4" class="ltx_td ltx_align_center ltx_border_t">78.94<sub id="A4.T7.8.4.4.1" class="ltx_sub"><span id="A4.T7.8.4.4.1.1" class="ltx_text ltx_font_italic">±0.87</span></sub></td>
