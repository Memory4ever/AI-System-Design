<td id="A4.T7.8.4.6" class="ltx_td ltx_align_center ltx_border_t">68.53<sub id="A4.T7.8.4.6.1" class="ltx_sub"><span id="A4.T7.8.4.6.1.1" class="ltx_text ltx_font_italic">±1.24</span></sub></td>
<td id="A4.T7.8.4.7" class="ltx_td ltx_align_center ltx_border_t">124.6<sub id="A4.T7.8.4.7.1" class="ltx_sub"><span id="A4.T7.8.4.7.1.1" class="ltx_text ltx_font_italic">±1.2</span></sub></td></tr>
<tr id="A4.T7.8.5" class="ltx_tr">
