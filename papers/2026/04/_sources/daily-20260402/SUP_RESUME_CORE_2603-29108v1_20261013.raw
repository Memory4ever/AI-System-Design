<td id="S3.T1.2.5.3" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m24" class="ltx_Math" alttext="5.62\text{\times}{10}^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>5.62</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.62\text{\times}{10}^{-3}</annotation></semantics></math></td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m25" class="ltx_Math" alttext="1.39\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>1.39</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.39\text{\times}{10}^{-1}</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<th id="S3.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">CG-3</th>
<td id="S3.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m26" class="ltx_Math" alttext="1.05\text{\times}{10}^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>1.05</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.05\text{\times}{10}^{-3}</annotation></semantics></math></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m27" class="ltx_Math" alttext="7.49\text{\times}{10}^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>7.49</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.49\text{\times}{10}^{-2}</annotation></semantics></math></td>
<td id="S3.T1.2.6.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m28" class="ltx_Math" alttext="3.02\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>3.02</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3.02\text{\times}{10}^{-1}</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.7" class="ltx_tr">
<th id="S3.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">CG-5</th>
<td id="S3.T1.2.7.2" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m29" class="ltx_Math" alttext="6.31\text{\times}{10}^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>6.31</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">6.31\text{\times}{10}^{-4}</annotation></semantics></math></td>
<td id="S3.T1.2.7.3" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m30" class="ltx_Math" alttext="7.74\text{\times}{10}^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>7.74</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.74\text{\times}{10}^{-3}</annotation></semantics></math></td>
<td id="S3.T1.2.7.4" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m31" class="ltx_Math" alttext="1.96\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>1.96</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.96\text{\times}{10}^{-1}</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.8" class="ltx_tr">
<th id="S3.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">CG-10</th>
<td id="S3.T1.2.8.2" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m32" class="ltx_Math" alttext="6.31\text{\times}{10}^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>6.31</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">6.31\text{\times}{10}^{-4}</annotation></semantics></math></td>
<td id="S3.T1.2.8.3" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m33" class="ltx_Math" alttext="8.68\text{\times}{10}^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>8.68</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8.68\text{\times}{10}^{-4}</annotation></semantics></math></td>
<td id="S3.T1.2.8.4" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m34" class="ltx_Math" alttext="7.75\text{\times}{10}^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>7.75</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.75\text{\times}{10}^{-2}</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.9" class="ltx_tr">
<th id="S3.T1.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Identity (<math id="S3.T1.m35" class="ltx_Math" alttext="{\bm{H}}={\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑯</mi><mo>=</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">{\bm{H}}={\bm{I}}</annotation></semantics></math>)</th>
<td id="S3.T1.2.9.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m36" class="ltx_Math" alttext="1.69\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>1.69</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.69\text{\times}{10}^{-1}</annotation></semantics></math></td>
<td id="S3.T1.2.9.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m37" class="ltx_Math" alttext="3.91\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>3.91</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3.91\text{\times}{10}^{-1}</annotation></semantics></math></td>
<td id="S3.T1.2.9.4" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m38" class="ltx_Math" alttext="4.93\text{\times}{10}^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>4.93</mn><mtext>×</mtext><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">4.93\text{\times}{10}^{-1}</annotation></semantics></math></td></tr>
