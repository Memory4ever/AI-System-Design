<th id="S4.T3.4.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:10.0pt;padding-right:10.0pt;">20</th>
<th id="S4.T3.4.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;">10</th>
