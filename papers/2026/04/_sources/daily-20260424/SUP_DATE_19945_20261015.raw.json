{"data":{"id":"10.48550/arxiv.2604.19945","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.19945","prefix":"10.48550","suffix":"arxiv.2604.19945","identifiers":[{"identifier":"2604.19945","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.19945"}],"creators":[{"name":"Dong, Qihua","nameType":"Personal","givenName":"Qihua","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Sahin, Gozde","nameType":"Personal","givenName":"Gozde","familyName":"Sahin","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Pei","nameType":"Personal","givenName":"Pei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Zhaowei","nameType":"Personal","givenName":"Zhaowei","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Shrestha, Robik","nameType":"Personal","givenName":"Robik","familyName":"Shrestha","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Hao","nameType":"Personal","givenName":"Hao","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Modolo, Davide","nameType":"Personal","givenName":"Davide","familyName":"Modolo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visual Reasoning through Tool-supervised Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-21T19:48:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-23T00:07:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"In this paper, we investigate the problem of how to effectively master tool-use to solve complex visual reasoning tasks for Multimodal Large Language Models. To achieve that, we propose a novel Tool-supervised Reinforcement Learning (ToolsRL) framework, with direct tool supervision for more effective tool-use learning. We focus on a series of simple, native, and interpretable visual tools, including zoom-in, rotate, flip, and draw point/line, whose tool supervision is easy to collect. A reinforcement learning curriculum is developed, where the first stage is solely optimized by a set of well motivated tool-specific rewards, and the second stage is trained with the accuracy targeted rewards while allowing calling tools. In this way, tool calling capability is mastered before using tools to complete visual reasoning tasks, avoiding the potential optimization conflict among those heterogeneous tasks. Our experiments have shown that the tool-supervised curriculum training is efficient and ToolsRL can achieve strong tool-use capabilities for complex visual reasoning tasks.","descriptionType":"Abstract"},{"description":"Accepted to CVPR 2026 Findings. 17 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.19945","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-23T01:53:49.000Z","registered":"2026-04-23T01:53:50.000Z","published":"2026","updated":"2026-04-23T01:53:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.19945","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}