{"data":{"id":"10.48550/arxiv.2604.04783","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.04783","prefix":"10.48550","suffix":"arxiv.2604.04783","identifiers":[{"identifier":"2604.04783","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.04783"}],"creators":[{"name":"Chen, Guoci","nameType":"Personal","givenName":"Guoci","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Xiurui","nameType":"Personal","givenName":"Xiurui","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Qiao","nameType":"Personal","givenName":"Qiao","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Mao, Bo","nameType":"Personal","givenName":"Bo","familyName":"Mao","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Congming","nameType":"Personal","givenName":"Congming","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Huan, Chengying","nameType":"Personal","givenName":"Chengying","familyName":"Huan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Mingzhe","nameType":"Personal","givenName":"Mingzhe","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jie","nameType":"Personal","givenName":"Jie","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GPU Acceleration of TFHE-Based High-Precision Nonlinear Layers for Encrypted LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Cryptography and Security (cs.CR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-06T15:54:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:35:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Deploying large language models (LLMs) as cloud services raises privacy concerns as inference may leak sensitive data. Fully Homomorphic Encryption (FHE) allows computation on encrypted data, but current FHE methods struggle with efficient and precise nonlinear function evaluation. Specifically, CKKS-based approaches require high-degree polynomial approximations, which are costly when target precision increases. Alternatively, TFHE's Programmable Bootstrapping (PBS) outperforms CKKS by offering exact lookup-table evaluation. But it lacks high-precision implementations of LLM nonlinear layers and underutilizes GPU resources.\n We propose \\emph{TIGER}, the first GPU-accelerated framework for high-precision TFHE-based nonlinear LLM layer evaluation. TIGER offers: (1) GPU-optimized WoP-PBS method combined with numerical algorithms to surpass native lookup-table precision limits on nonlinear functions; (2) high-precision and efficient implementations of key nonlinear layers, enabling practical encrypted inference; (3) batch-driven design exploiting inter-input parallelism to boost GPU efficiency. TIGER achieves 7.17$\\times$, 16.68$\\times$, and 17.05$\\times$ speedups over a CPU baseline for GELU, Softmax, and LayerNorm, respectively.","descriptionType":"Abstract"},{"description":"11 pages, 7 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.04783","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T03:13:38.000Z","registered":"2026-04-07T03:13:38.000Z","published":"2026","updated":"2026-04-07T03:13:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.04783","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}