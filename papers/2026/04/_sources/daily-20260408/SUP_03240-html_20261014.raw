<tbody class="ltx_tbody">
<tr id="S3.T3.5.1.2" class="ltx_tr">
<th id="S3.T3.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="S3.T3.5.1.2.1.1" class="ltx_text"><math id="S3.T3.m5" class="ltx_Math" alttext="e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">e_{i}</annotation></semantics></math></span></th>
<th id="S3.T3.5.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S3.T3.m6" class="ltx_Math" alttext="\det(\mathbf{L}_{Y})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐋</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\det(\mathbf{L}_{Y})</annotation></semantics></math></th>
<td id="S3.T3.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.7396</td>
<td id="S3.T3.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.2664</td>
