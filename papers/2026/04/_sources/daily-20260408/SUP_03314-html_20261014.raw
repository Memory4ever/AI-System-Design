<th id="A1.T8.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Value</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T8.5.2" class="ltx_tr">
