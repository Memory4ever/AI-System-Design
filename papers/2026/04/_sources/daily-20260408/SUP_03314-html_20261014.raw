<tr id="A1.T9.5.4" class="ltx_tr">
<th id="A1.T9.5.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Scaling <math id="A1.T9.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></th>
<td id="A1.T9.5.4.2" class="ltx_td ltx_align_center">0.1</td></tr>
