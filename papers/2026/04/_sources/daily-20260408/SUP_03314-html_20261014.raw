<td id="A1.T8.5.2.2" class="ltx_td ltx_align_center ltx_border_t">16</td></tr>
<tr id="A1.T8.5.3" class="ltx_tr">
<th id="A1.T8.5.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Scaling <math id="A1.T8.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></th>
<td id="A1.T8.5.3.2" class="ltx_td ltx_align_center">8</td></tr>
<tr id="A1.T8.5.4" class="ltx_tr">
<th id="A1.T8.5.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Scaling <math id="A1.T8.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></th>
<td id="A1.T8.5.4.2" class="ltx_td ltx_align_center">0.1</td></tr>
<tr id="A1.T8.5.5" class="ltx_tr">
<th id="A1.T8.5.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Optimizer</th>
<td id="A1.T8.5.5.2" class="ltx_td ltx_align_center">Adam</td></tr>
<tr id="A1.T8.5.6" class="ltx_tr">
<th id="A1.T8.5.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">LR Adapter</th>
<td id="A1.T8.5.6.2" class="ltx_td ltx_align_center"><math id="A1.T8.m4" class="ltx_Math" alttext="5\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-6}</annotation></semantics></math></td></tr>
<tr id="A1.T8.5.7" class="ltx_tr">
<th id="A1.T8.5.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">LR MLP</th>
<td id="A1.T8.5.7.2" class="ltx_td ltx_align_center"><math id="A1.T8.m5" class="ltx_Math" alttext="4\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">4\times 10^{-6}</annotation></semantics></math></td></tr>
