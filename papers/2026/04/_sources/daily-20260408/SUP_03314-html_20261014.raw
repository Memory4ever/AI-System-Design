<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.2 </span>Audio-Visual Segmentation (AVS)</h4>

<figure id="A1.T9" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A1.T9.3" class="ltx_text" style="font-size:90%;">Table 9</span>: </span><span id="A1.T9.4" class="ltx_text" style="font-size:90%;">Training settings for Audio-Visual Segmentation</span></figcaption>
<table id="A1.T9.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
