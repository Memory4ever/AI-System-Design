<tr id="S4.T3.5.2" class="ltx_tr">
<th id="S4.T3.5.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column">Ratio</th>
<th id="S4.T3.5.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">val</th>
