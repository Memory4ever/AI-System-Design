</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.5.4" class="ltx_tr">
<td id="S4.T3.5.4.1" class="ltx_td ltx_align_center ltx_border_t">TransVG <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Deng et al., 2021</a>)</cite></td>
<td id="S4.T3.5.4.2" class="ltx_td ltx_align_center ltx_border_t">100%</td>
<td id="S4.T3.5.4.3" class="ltx_td ltx_align_center ltx_border_t">81.0</td>
