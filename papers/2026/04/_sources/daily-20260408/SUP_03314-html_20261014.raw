<tbody class="ltx_tbody">
<tr id="S3.T1.5.4" class="ltx_tr">
<td id="S3.T1.5.4.1" class="ltx_td ltx_align_center ltx_border_t">LoRA(r=16)</td>
<td id="S3.T1.5.4.2" class="ltx_td ltx_align_center ltx_border_t">28.0</td>
<td id="S3.T1.5.4.3" class="ltx_td ltx_align_center ltx_border_t">223.4</td>
<td id="S3.T1.5.4.4" class="ltx_td ltx_align_center ltx_border_t">12.5%</td>
<td id="S3.T1.5.4.5" class="ltx_td ltx_align_center ltx_border_t">88.7</td>
<td id="S3.T1.5.4.6" class="ltx_td ltx_align_center ltx_border_t">90.5</td>
<td id="S3.T1.5.4.7" class="ltx_td ltx_align_center ltx_border_t">86.0</td>
