<span id="S4.T6.p1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.p1.1.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Color</span></span>
<span id="S4.T6.p1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.p1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Position</span></span>
<span id="S4.T6.p1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T6.p1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Color Attr.</span></span></span>
</span>
<span class="ltx_tbody">
<span id="S4.T6.p1.1.1.1.1.2" class="ltx_tr">
<span id="S4.T6.p1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">w/o aug.</span>
<span id="S4.T6.p1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.81</span>
<span id="S4.T6.p1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.58</span>
<span id="S4.T6.p1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.50</span></span>
<span id="S4.T6.p1.1.1.1.1.3" class="ltx_tr">
<span id="S4.T6.p1.1.1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">+ Self-critique</span>
<span id="S4.T6.p1.1.1.1.1.3.2" class="ltx_td ltx_align_center">0.84</span>
