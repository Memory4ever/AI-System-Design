{"data":{"id":"10.48550/arxiv.2604.03632","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.03632","prefix":"10.48550","suffix":"arxiv.2604.03632","identifiers":[{"identifier":"2604.03632","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.03632"}],"creators":[{"name":"Pan, Ruwei","nameType":"Personal","givenName":"Ruwei","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Jiangshuai","nameType":"Personal","givenName":"Jiangshuai","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Qisheng","nameType":"Personal","givenName":"Qisheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Yueheng","nameType":"Personal","givenName":"Yueheng","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Linhao","nameType":"Personal","givenName":"Linhao","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Zixiong","nameType":"Personal","givenName":"Zixiong","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yakun","nameType":"Personal","givenName":"Yakun","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Lu","nameType":"Personal","givenName":"Lu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Hongyu","nameType":"Personal","givenName":"Hongyu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Persistent Cross-Attempt State Optimization for Repository-Level Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-04T08:03:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T00:24:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large language models (LLMs) have achieved substantial progress in repository-level code generation. However, solving the same repository-level task often requires multiple attempts, while existing methods still optimize each attempt in isolation and do not preserve or reuse task-specific state across attempts. In this paper, we propose LiveCoder, a novel framework for repository-level code generation based on cross-attempt knowledge optimization. LiveCoder maintains persistent task-specific state from prior attempts to guide subsequent generation. This state includes success knowledge, which captures reusable signals from previously strong repositories, failure knowledge, which records unsuccessful outcomes and their diagnostic signals, and a historical-best repository, which preserves the strongest result found so far and prevents regression. These components collectively transform repeated repository generation into a persistent, knowledge-driven optimization process. We evaluate LiveCoder using four frontier LLMs on two representative repository-level code generation benchmarks. Extensive experimental results demonstrate the effectiveness and efficiency of LiveCoder, improving the functional score by up to 22.94 percentage points, increasing repository reuse to 81.58%, and reducing cost by up to 53.63% on RAL-Bench while maintaining broadly stable non-functional quality.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.03632","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T02:45:54.000Z","registered":"2026-04-07T02:45:55.000Z","published":"2026","updated":"2026-04-07T02:45:55.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.03632","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}