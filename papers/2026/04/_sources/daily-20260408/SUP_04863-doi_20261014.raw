{"data":{"id":"10.48550/arxiv.2604.04863","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.04863","prefix":"10.48550","suffix":"arxiv.2604.04863","identifiers":[{"identifier":"2604.04863","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.04863"}],"creators":[{"name":"Nguyen, Tuan Dung","nameType":"Personal","givenName":"Tuan Dung","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Ho, Minh Khoi","nameType":"Personal","givenName":"Minh Khoi","familyName":"Ho","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Qi","nameType":"Personal","givenName":"Qi","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Yutong","nameType":"Personal","givenName":"Yutong","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Cam-Tu, Nguyen","nameType":"Personal","givenName":"Nguyen","familyName":"Cam-Tu","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Minh Khoi","nameType":"Personal","givenName":"Minh Khoi","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Dang Huy Pham","nameType":"Personal","givenName":"Dang Huy Pham","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Hengel, Anton van den","nameType":"Personal","givenName":"Anton van den","familyName":"Hengel","affiliation":[],"nameIdentifiers":[]},{"name":"Verjans, Johan W.","nameType":"Personal","givenName":"Johan W.","familyName":"Verjans","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Phi Le","nameType":"Personal","givenName":"Phi Le","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Phan, Vu Minh Hieu","nameType":"Personal","givenName":"Vu Minh Hieu","familyName":"Phan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond the Global Scores: Fine-Grained Token Grounding as a Robust Detector of LVLM Hallucinations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-06T17:07:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:40:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large vision-language models (LVLMs) achieve strong performance on visual reasoning tasks but remain highly susceptible to hallucination. Existing detection methods predominantly rely on coarse, whole-image measures of how an object token relates to the input image. This global strategy is limited: hallucinated tokens may exhibit weak but widely scattered correlations across many local regions, which aggregate into deceptively high overall relevance, thus evading the current global hallucination detectors. We begin with a simple yet critical observation: a faithful object token must be strongly grounded in a specific image region. Building on this insight, we introduce a patch-level hallucination detection framework that examines fine-grained token-level interactions across model layers. Our analysis uncovers two characteristic signatures of hallucinated tokens: (i) they yield diffuse, non-localized attention patterns, in contrast to the compact, well-focused attention seen in faithful tokens; and (ii) they fail to exhibit meaningful semantic alignment with any visual region. Guided by these findings, we develop a lightweight and interpretable detection method that leverages patch-level statistical features, combined with hidden-layer representations. Our approach achieves up to 90% accuracy in token-level hallucination detection, demonstrating the superiority of fine-grained structural analysis for detecting hallucinations.","descriptionType":"Abstract"},{"description":"Accepted at CVPR2026 Main Track","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.04863","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T03:15:31.000Z","registered":"2026-04-07T03:15:32.000Z","published":"2026","updated":"2026-04-07T03:15:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.04863","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}