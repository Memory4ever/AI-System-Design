6em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="39.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.17" class="ltx_text" style="font-size:70%;">Memory</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#E8E8E8;" fill="#E8E8E8" stroke="#4D4D4D" stroke-width="0.6pt"><path d="M 52.94 -200.79 L 17.93 -200.79 C 15.64 -200.79 13.78 -202.65 13.78 -204.94 L 13.78 -216.32 C 13.78 -218.61 15.64 -220.47 17.93 -220.47 L 52.94 -220.47 C 55.23 -220.47 57.09 -218.61 57.09 -216.32 L 57.09 -204.94 C 57.09 -202.65 55.23 -200.79 52.94 -200.79 Z M 13.78 -220.47"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.6pt" transform="matrix(1.0 0.0 0.0 1.0 23.52 -213.01)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.15em;font-size:9.06pt;" height="8.53" overflow="visible" transform="matrix(1 0 0 -1 0 6.65)" width="23.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.18" class="ltx_text ltx_font_bold" style="font-size:70%;">SQL</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#E8E8E8;" fill="#E8E8E8" stroke="#4D4D4D" stroke-width="0.6pt"><path d="M 107.04 -200.79 L 70.12 -200.79 C 67.83 -200.79 65.97 -202.65 65.97 -204.94 L 65.97 -216.32 C 65.97 -218.61 67.83 -220.47 70.12 -220.47 L 107.04 -220.47 C 109.34 -220.47 111.19 -218.61 111.19 -216.32 L 111.19 -204.94 C 111.19 -202.65 109.34 -200.79 107.04 -200.79 Z M 65.97 -220.47"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.6pt" transform="matrix(1.0 0.0 0.0 1.0 70.58 -213.95)"><foreignObject style="--ltx-fo-width:2.95em;--ltx-fo-height:0.53em;--ltx-fo-depth:0em;font-size:9.06pt;" 