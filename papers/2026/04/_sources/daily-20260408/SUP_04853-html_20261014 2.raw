<td id="S0.T1.5.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S0.T1.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Result</span></td></tr>
