<td id="S5.T4.3.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.55pt 5.0pt;"><span id="S5.T4.3.4.3.1" class="ltx_text" style="font-size:90%;">24.3</span></td>
