<tr id="S6.T4.5.1.3" class="ltx_tr">
<td id="S6.T4.5.1.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.4pt 5.0pt;">
<span id="S6.T4.5.1.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:17.1pt;">
<span id="S6.T4.5.1.3.1.1.1" class="ltx_p ltx_align_center"><span id="S6.T4.5.1.3.1.1.1.1" class="ltx_text" style="font-size:70%;">BF16</span></span>
</span></td>
<td id="S6.T4.5.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 5.0pt;">
<span id="S6.T4.5.1.3.2.1" class="ltx_inline-block ltx_align_top">
