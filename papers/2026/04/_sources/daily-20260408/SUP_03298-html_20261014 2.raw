              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.7.34.1" class="ltx_text ltx_font_bold" style="font-size:70%;">25</span></span>
            <span id="alg2.7.34.2" class="ltx_text ltx_font_bold" style="font-size:70%;">for</span><span id="alg2.7.34.3" class="ltx_text" style="font-size:70%;"> </span><em id="alg2.7.34.4" class="ltx_emph ltx_font_italic" style="font-size:70%;"><math id="alg2.m31" class="ltx_Math" alttext="i\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 0</annotation></semantics></math> <span id="alg2.7.34.4.1" class="ltx_text ltx_font_bold">to</span> <math id="alg2.m32" class="ltx_Math" alttext="total\_length/2-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">total\_length/2-1</annotation></semantics></math></em><span id="alg2.7.34.5" class="ltx_text" style="font-size:70%;"> </span><span id="alg2.7.34.6" class="ltx_text ltx_font_bold" style="font-size:70%;">do</span>
</div>
<div id="alg2.7.35" class="ltx_listingline"><span id="alg2.7.35.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg2.7.35.2" class="ltx_text" style="font-size:70%;">   </span>
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.7.35.3" class="ltx_text ltx_font_bold" style="font-size:70%;">26</span></span>
            <math id="alg2.m33" class="ltx_Math" alttext="output\_data\leftarrow normalized\_bytes[i]\mid(normalized\_bytes[i+total\_length/2]\texttt{ &lt;&lt; }8)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi></mrow><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mi mathsize="0.700em">i</mi><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">+</mo><mrow><mrow><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">h</mi></mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.700em">2</mn></mrow></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.700em"> &lt;&lt; </mtext><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">8</mn></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">output\_data\leftarrow normalized\_bytes[i]\mid(normalized\_bytes[i+total\_length/2]\texttt{ &lt;&lt; }8)</annotation></semantics></math><span id="alg2.7.35.4" class="ltx_text" style="font-size:70%;"> </span>
</div>
<div id="alg2.7.36" class="ltx_listingline"><span id="alg2.7.36.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg2.7.36.2" class="ltx_text" style="font-size:70%;">   </span>
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.7.36.3" class="ltx_text ltx_font_bold" style="font-size:70%;">27</span></span>
            <span id="alg2.7.36.4" class="ltx_text" style="font-size:70%;">Append </span><math id="alg2.m34" class="ltx_Math" alttext="output\_data" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi></mrow><annotation encoding="application/x-tex">output\_data</annotation></semantics></math><span id="alg2.7.36.5" class="ltx_text" style="font-size:70%;"> to </span><math id="alg2.m35" class="ltx_Math" alttext="byte\_stream" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">m</mi></mrow><annotation encoding="application/x-tex">byte\_stream</annotation></semantics></math><span id="alg2.7.36.6" class="ltx_text" style="font-size:70%;"> </span>
</div>
<div id="alg2.7.37" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.7.37.1" class="ltx_text ltx_font_bold" style="font-size:70%;">28</span></span>
            <span id="alg2.7.37.2" class="ltx_text" style="font-size:70%;">end for</span>
</div>
<div id="alg2.7.38" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.7.38.1" class="ltx_text ltx_font_bold" style="font-size:70%;">29</span></span>
            <span id="alg2.7.38.2" class="ltx_text ltx_font_bold" style="font-size:70%;">return</span><span id="alg2.7.38.3" class="ltx_text" style="font-size:70%;"> </span><math id="alg2.m36" class="ltx_Math" alttext="byte\_stream" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">m</mi></mrow><annotation encoding="application/x-tex">byte\_stream</annotation></semantics></math><span id="alg2.7.38.4" class="ltx_text" style="font-size:70%;"> </span>
</div>
<div id="alg2.7.39" class="ltx_listingline"><span id="alg2.7.39.1" class="ltx_text" style="font-size:70%;">
</span>
</div>
</div>
</figure>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">To achieve both extreme compression and high performance for tensor blocks under strict hardware alignment constraints, we introduce an iterative bit-packing algorithm. The core of this method, as shown in the pseudocode (Algorithm <a href="#alg2" title="In V-B Bit-Width Quantization with Hierarchical Halving Bit-Packing ‣ V Optimizations of ENEC ‣ ENEC: A Lossless AI Model Compression Method Enabling Fast Inference on Ascend NPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), lies in lane folding and byte normalization. The algorithm begins with a block of <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> elements (where <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is a power of two), each of 16-bit width but retaining only the least significant <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> bits. It iterates until the effective bit width of each element is reduced to 8 bits. In each iteration, the block is treated as a sequence of logical lanes. The folding step logically left-shifts each element in the lower half by <math id="S5.SS2.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> bits and performs an element-wise Or operation with the corresponding element in the upper half (Lines 9-11). This merges two <math id="S5.SS2.p2.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>-bit payloads into a single physical storage location, resulting in a new block of <math id="S5.SS2.p2.m6" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math> elements, each with an effective width of <math id="S5.SS2.p2.m7" class="ltx_Math" alttext="2a" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">2a</annotation></semantics></math> bits (Line 12).</p>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">When the folding operation causes the effective bit width to exceed the 8-bit byte boundary, <span id="S5.SS2.p3.1.1" class="ltx_text ltx_font_italic">byte normalization</span> is triggered. As the folding is iterative, this effective bit width grows with each iteration, potentially surpassing 8 bits multiple times. The data is then split into (i) the lower 8 bits, forming a storable byte, and (ii) the remaining bits, which are treated as overflow. All overflow segments are collected into a new sub-block and processed recursively by the same algorithm (Lines 14-21). Then, by appending zero bytes to the end of the byte stream, the total length is aligned upward to the nearest multiple of 2 (Lines 23-26). The normalized bytes are consolidated in a final folding pass to form the output stream (Lines 28-32). The bit-unpacking process is precisely the inverse of the bit-packing process.</p>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">Consequently, <span id="S5.SS2.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">as illustrated in Figure <a href="#S4.F5" title="Fig. 5 ‣ IV-B Basic Design of ENEC ‣ IV Architecture Analysis and Basic Design ‣ ENEC: A Lossless AI Model Compression Method Enabling Fast Inference on Ascend NPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>,</span> the least significant <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> bits are truncated and compressed via hierarchical halving bit-packing. For groups needing more than <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> bits, the higher <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="(n-m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-m)</annotation></semantics></math> bits are collected into a 32 KB buffer. Once full, these bits are compressed by hierarchical halving bit-packing, and the buffer is then cleared. During decompression, an inverse <span id="S5.SS2.p4.1.2" class="ltx_text ltx_font_typewriter">Gather</span> operation redistributes the decompressed higher <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="(n-m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-m)</annotation></semantics></math> bits to their original positions. The original values are reconstructed by performing vectorized Or operation with the decompressed lower <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> bits.</p>
</div>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS3.6" class="ltx_text">V-C</span> </span><span id="S5.SS3.7" class="ltx_text ltx_font_italic">Vectorized Branch-Free Integer Transformation</span></h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">In the basic design, the exponent mapping relies on the slow gather API, based on the observation 5 in Section <a href="#S3" title="III Data Analysis of AI Model Weights ‣ ENEC: A Lossless AI Model Compression Method Enabling Fast Inference on Ascend NPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">III</span></a>, we adopt the linear mapping function <math id="S5.SS3.p1.m1" class="ltx_Math" alttext="f(x)=b-x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>b</mi><mo>−</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=b-x</annotation></semantics></math> as the core transformation scheme to optimize this process. As shown in Figure <a href="#S5.F7" title="Fig. 7 ‣ V-C Vectorized Branch-Free Integer Transformation ‣ V Optimizations of ENEC ‣ ENEC: A Lossless AI Model Compression Method Enabling Fast Inference on Ascend NPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, <math id="S5.SS3.p1.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> is a linear mapping parameter determined by the data distribution characteristics. When the input value is greater than the parameter <math id="S5.SS3.p1.m3" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>, the mapping result is negative. This approach cleverly utilizes the properties of two’s complement representation to handle negative values. Due to the use of bit-width quantization and the need to ensure correct decoding, an additional bit is required in the higher bit position to determine whether the value is negative: for positive values, the <math id="S5.SS3.p1.m4" class="ltx_Math" alttext="(n+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+1)</annotation></semantics></math>-th bit must be 0, and the mapping range is <math id="S5.SS3.p1.m5" class="ltx_Math" alttext="[0,2^{n}-1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><msup><mn>2</mn><mi>n</mi></msup><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,2^{n}-1]</annotation></semantics></math>; for negative values, the <math id="S5.SS3.p1.m6" class="ltx_Math" alttext="(n+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+1)</annotation></semantics></math>-th bit must be 1, and the mapping range is <math id="S5.SS3.p1.m7" class="ltx_Math" alttext="[2^{n},2^{n+1}-1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msup><mn>2</mn><mi>n</mi></msup><mo>,</mo><mrow><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2^{n},2^{n+1}-1]</annotation></semantics></math>. This approach enables the replacement of irregular memory access operations with efficient computation.</p>
</div>
<figure id="S5.F7" class="ltx_figure"><object type="image/svg+xml" data="2604.03298v1/chapter4_linearMap_cropped.svg" id="S5.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/203;" width="476" height="203"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F7.3" class="ltx_text" style="font-size:90%;">Fig. 7</span>: </span><span id="S5.F7.4" class="ltx_text" style="font-size:90%;">Vectorized branch-free integer transformation.</span></figcaption>
</figure>
<div id="S5.SS3.p2" class="ltx_para">
<p id="S5.SS3.p2.1" class="ltx_p"><span id="S5.SS3.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The implementation of this mapping primarily consists of three stages. First, a vector addition unit subtracts the preset parameter <math id="S5.SS3.p2.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> from all input elements simultaneously, shifting the center of the data distribution close to zero. Then, a vector multiplication unit inverts the intermediate results to achieve the mathematical transformation <math id="S5.SS3.p2.m2" class="ltx_Math" alttext="b-x" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">b-x</annotation></semantics></math>. For example, with <math id="S5.SS3.p2.m3" class="ltx_Math" alttext="b=123" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">123</mn></mrow><annotation encoding="application/x-tex">b=123</annotation></semantics></math>, an input <math id="S5.SS3.p2.m4" class="ltx_Math" alttext="x=125" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">125</mn></mrow><annotation encoding="application/x-tex">x=125</annotation></semantics></math> is transformed to <math id="S5.SS3.p2.m5" class="ltx_Math" alttext="123-125=-2" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">123</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">125</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></mrow><annotation encoding="application/x-tex">123-125=-2</annotation></semantics></math>, while an input <math id="S5.SS3.p2.m6" class="ltx_Math" alttext="x=122" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">122</mn></mrow><annotation encoding="application/x-tex">x=122</annotation></semantics></math> becomes <math id="S5.SS3.p2.m7" class="ltx_Math" alttext="123-122=1" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">123</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">122</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">123-122=1</annotation></semantics></math>. This combined operation ensures that high-frequency values in the input data are mapped to smaller output values. Finally, we use shift operations to implement modulo <math id="S5.SS3.p2.m8" class="ltx_Math" alttext="2^{n+1}" display="inline" intent=":literal"><semantics><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><annotation encoding="application/x-tex">2^{n+1}</annotation></semantics></math> and clear higher-bit information, restricting all output values to the predefined range <math id="S5.SS3.p2.m9" class="ltx_Math" alttext="[0,2^{n+1}-1]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,2^{n+1}-1]</annotation></semantics></math>. Negative values <math id="S5.SS3.p2.m10" class="ltx_Math" alttext="-c" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mrow><annotation encoding="application/x-tex">-c</annotation></semantics></math> are converted to <math id="S5.SS3.p2.m11" class="ltx_Math" alttext="2^{n+1}-c" display="inline" intent=":literal"><semantics><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mrow><annotation encoding="application/x-tex">2^{n+1}-c</annotation></semantics></math> to achieve a wrapping effect. For instance, in the case where <math id="S5.SS3.p2.m12" class="ltx_Math" alttext="n=5" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn></mrow><annotation encoding="application/x-tex">n=5</annotation></semantics></math>, the previous intermediate result of <math id="S5.SS3.p2.m13" class="ltx_Math" alttext="-2" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><annotation encoding="application/x-tex">-2</annotation></semantics></math> is converted to <math id="S5.SS3.p2.m14" class="ltx_Math" alttext="2^{6}-2=62" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">62</mn></mrow><annotation encoding="application/x-tex">2^{6}-2=62</annotation></semantics></math>, while the positive result of <math id="S5.SS3.p2.m15" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> remains unchanged. This approach ensures computational efficiency while maintaining injectivity, fully leveraging the vectorized computing capabilities of Ascend NPUs and avoiding inefficient branching operations.
</span></p>
</div>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS4.6" class="ltx_text">V-D</span> </span><span id="S5.SS4.7" class="ltx_text ltx_font_italic">Intra-Segment Dependency Decoupled Scan
</span></h3>

<div id="S5.SS4.p1" class="ltx_para">
<p id="S5.SS4.p1.1" class="ltx_p">The prefix sum (or scan) is a fundamental parallel primitive. However, its straightforward implementation on modern SIMD architectures, such as Ascend NPUs, is often hindered by stringent hardware constraints. The target operation is to compute the global prefix sum of all elements in an <math id="S5.SS4.p1.m1" class="ltx_Math" alttext="N\times M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\times M</annotation></semantics></math> tensor (where <math id="S5.SS4.p1.m2" class="ltx_Math" alttext="M=16" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">M=16</annotation></semantics></math>), which is logically treated as a flattened 1D array. The primary bottleneck lies in the Ascend NPUs’ memory model, particularly the 32-byte alignment requirement for operands in AscendC. Given that the data type used here is half-precision floating-point (<span id="S5.SS4.p1.1.1" class="ltx_text ltx_font_typewriter">half</span>, 2 bytes), each row of <math id="S5.SS4.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> elements in the tensor exactly occupies 32 bytes. Architectural constraints prohibit direct SIMD computation between elements residing within the same 32-byte memory segment. This effectively “locks” the direct intra-row prefix sum computation (e.g., <math id="S5.SS4.p1.m4" class="ltx_Math" alttext="\text{row}[i]\mathrel{+}=\text{row}[i-1]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>row</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo rspace="0.056em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">+</mo><mphantom></mphantom><mo>=</mo><mrow><mtext>row</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{row}[i]\mathrel{+}=\text{row}[i-1]</annotation></semantics></math>), as it requires operations between adjacent elements within a single hardware-indivisible block.</p>
</div>
<figure id="S5.F8" class="ltx_figure"><img src="2604.03298v1/prefix_final_cropped.png" id="S5.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/261;" width="476" height="261" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F8.4" class="ltx_text" style="font-size:90%;">Fig. 8</span>: </span><span id="S5.F8.5" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Prefix sum process. This figure illustrates the step-by-step implementation of the prefix sum algorithm, using an <math id="S5.F8.m3" class="ltx_Math" alttext="8\times 8" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow><annotation encoding="application/x-tex">8\times 8</annotation></semantics></math> binary local tensor <math id="S5.F8.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> as a working example.</span></figcaption>
</figure>
<div id="S5.SS4.p2" class="ltx_para">
<p id="S5.SS4.p2.1" class="ltx_p">To decouple this forbidden intra-segment dependency, we propose the <span id="S5.SS4.p2.1.1" class="ltx_text ltx_font_italic">Intra-Segment Dependency Decoupled Scan (IDD-Scan)</span>, a multi-stage algorithm that transforms the computation-bound problem into a series of hardware-friendly operations. The workflow of IDD-Scan is detailed below and illustrated in Figure <a href="#S5.F8" title="Fig. 8 ‣ V-D Intra-Segment Dependency Decoupled Scan ‣ V Optimizations of ENEC ‣ ENEC: A Lossless AI Model Compression Method Enabling Fast Inference on Ascend NPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>.</p>
</div>
<div id="S5.SS4.p3" class="ltx_para">
<p id="S5.SS4.p3.1" class="ltx_p"><span id="S5.SS4.p3.1.1" class="ltx_text ltx_font_bold">Stage 1: Intra-Row Scan via Matrix Transposition.</span>
IDD-Scan first computes the prefix sum for each row by transforming it. The local <math id="S5.SS4.p3.m1" class="ltx_Math" alttext="N\times M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\times M</annotation></semantics></math> tensor is transposed into an <math id="S5.SS4.p3.m2" class="ltx_Math" alttext="M\times N" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">M\times N</annotation></semantics></math> matrix. This distributes each original row’s elements across <math id="S5.SS4.p3.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> new rows, converting intra-row dependencies into inter-row ones. A parallel prefix sum is then performed on each of the <math id="S5.SS4.p3.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> columns using vectorized additions in <math id="S5.SS4.p3.m5" class="ltx_Math" alttext="\log_{2}(M)" display="inline" intent=":literal"><semantics><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log_{2}(M)</annotation></semantics></math> steps. The matrix is transposed back to its original <math id="S5.SS4.p3.m6" class="ltx_Math" alttext="N\times M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\times M</annotation></semantics></math> orientation, resulting in an intermediate matrix <math id="S5.SS4.p3.m7" class="ltx_Math" alttext="\mathbf{R}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">\mathbf{R}</annotation></semantics></math> where each row contains its correct local prefix sum.</p>
</div>
<div id="S5.SS4.p4" class="ltx_para">
<p id="S5.SS4.p4.1" class="ltx_p"><span id="S5.SS4.p4.1.1" class="ltx_text ltx_font_bold">Stage 2: Inter-Row Propagation and Final Update.</span>
The intermediate matrix <math id="S5.SS4.p4.m1" class="ltx_Math" alttext="\mathbf{R}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">\mathbf{R}</annotation></semantics></math> contains row-local sums but lacks <span id="S5.SS4.p4.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">exclusive cumulative offsets</span> from previous rows. A temporary copy <math id="S5.SS4.p4.m2" class="ltx_Math" alttext="\mathbf{C}" display="inline" intent=":literal"><semantics><mi>𝐂</mi><annotation encoding="application/x-tex">\mathbf{C}</annotation></semantics></math> of <math id="S5.SS4.p4.m3" class="ltx_Math" alttext="\mathbf{R}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">\mathbf{R}</annotation></semantics></math> is created. A hierarchical scan is performed on <math id="S5.SS4.p4.m4" class="ltx_Math" alttext="\mathbf{C}" display="inline" intent=":literal"><semantics><mi>𝐂</mi><annotation encoding="application/x-tex">\mathbf{C}</annotation></semantics></math>’s rows in <math id="S5.SS4.p4.m5" class="ltx_Math" alttext="\log_{2}(N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log_{2}(N)</annotation></semantics></math> steps: at step <math id="S5.SS4.p4.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, each row <math id="S5.SS4.p4.m7" class="ltx_Math" alttext="\mathbf{C}[i]" display="inline" intent=":literal"><semantics><mrow><mi>𝐂</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{C}[i]</annotation></semantics></math> adds values from row <math id="S5.SS4.p4.m8" class="ltx_Math" alttext="\mathbf{C}[i-2^{k}]" display="inline" intent=":literal"><semantics><mrow><mi>𝐂</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>−</mo><msup><mn>2</mn><mi>k</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{C}[i-2^{k}]</annotation></semantics></math> element-wise. After completion, the last column of <math id="S5.SS4.p4.m9" class="ltx_Math" alttext="\mathbf{C}" display="inline" intent=":literal"><semantics><mi>𝐂</mi><annotation encoding="application/x-tex">\mathbf{C}</annotation></semantics></math> holds the <span id="S5.SS4.p4.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">inclusive cumulative offsets</span> for all rows. <span id="S5.SS4.p4.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">Subsequently, the exclusive cumulative offsets are derived from the inclusive cumulative offsets by removing the bottom element and adding a zero element at the top.</span> This <math id="S5.SS4.p4.m10" class="ltx_Math" alttext="N\times 1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N\times 1</annotation></semantics></math> vector is broadcast across all columns to form an offset matrix. The final result is obtained by adding offset matrix element-wise to the saved matrix <math id="S5.SS4.p4.m11" class="ltx_Math" alttext="\mathbf{R}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">\mathbf{R}</annotation></semantics></math>.</p>
</div>
<figure id="S5.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S5.T2.3" class="ltx_text" style="font-size:90%;">TABLE II</span>: </span><span id="S5.T2.4" class="ltx_text" style="font-size:90%;">Compression ratio results on different datasets.</span></figcaption>
<div id="S5.T2.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:276.0pt;height:67.3pt;vertical-align:-32.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-163.2pt,39.8pt) scale(0.458226978242686,0.458226978242686) ;">
<table id="S5.T2.5.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S5.T2.5.1.1" class="ltx_tr">
<th id="S5.T2.5.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" rowspan="2"><span id="S5.T2.5.1.1.1.1" class="ltx_text ltx_font_bold">Arch</span></th>
<th id="S5.T2.5.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" rowspan="2"><span id="S5.T2.5.1.1.2.1" class="ltx_text ltx_font_bold">Compressors</span></th>
<td id="S5.T2.5.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="5"><span id="S5.T2.5.1.1.3.1" class="ltx_text ltx_font_bold">BF16</span></td>
<td id="S5.T2.5.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="2"><span id="S5.T2.5.1.1.4.1" class="ltx_text ltx_font_bold">FP16</span></td>
<td id="S5.T2.5.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="3"><span id="S5.T2.5.1.1.5.1" class="ltx_text ltx_font_bold">FP32</span></td></tr>
<tr id="S5.T2.5.1.2" class="ltx_tr">
<td id="S5.T2.5.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Falcon</td>
<td id="S5.T2.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Qwen3-8B</td>
<td id="S5.T2.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">DeepSeek</td>
<td id="S5.T2.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Qwen3-32B</td>
<td id="S5.T2.5.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Llama</td>
<td id="S5.T2.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Mistral</td>
