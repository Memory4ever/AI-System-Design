            <math id="algorithm1.m32" class="ltx_Math" alttext="\textit{best}[T]\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic">best</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\textit{best}[T]\leftarrow</annotation></semantics></math> tree with highest projection ranks and earliest positions;
</div>
<div id="algorithm1.4.36" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.36.1" class="ltx_text ltx_font_bold">32</span></span>
            end if
</div>
<div id="algorithm1.4.37" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.37.1" class="ltx_text ltx_font_bold">33</span></span>
            end foreach
</div>
<div id="algorithm1.4.38" class="ltx_listingline"><span id="algorithm1.4.38.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.38.2" class="ltx_text ltx_font_typewriter">Select best across traces (prefer primary) </span>
</div>
<div id="algorithm1.4.39" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.39.1" class="ltx_text ltx_font_bold">34</span></span>
            <span id="algorithm1.4.39.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.39.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m33" class="ltx_Math" alttext="T_{\mathrm{primary}}\in\textit{best}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>primary</mi></msub><mo>∈</mo><mtext class="ltx_mathvariant_italic">best</mtext></mrow><annotation encoding="application/x-tex">T_{\mathrm{primary}}\in\textit{best}</annotation></semantics></math></em> <span id="algorithm1.4.39.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.40" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.40.1" class="ltx_text ltx_font_bold">35</span></span>
            <span id="algorithm1.4.40.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m34" class="ltx_Math" alttext="\textit{best}[T_{\mathrm{primary}}]" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">best</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>T</mi><mi>primary</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\textit{best}[T_{\mathrm{primary}}]</annotation></semantics></math>;
</div>
<div id="algorithm1.4.41" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.41.1" class="ltx_text ltx_font_bold">36</span></span>
            <span id="algorithm1.4.41.2" class="ltx_text ltx_font_bold">else if</span> <em id="algorithm1.4.41.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m35" class="ltx_Math" alttext="\exists\,T\in T_{\mathrm{alt}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.337em">∃</mo><mi>T</mi></mrow><mo>∈</mo><msub><mi>T</mi><mi>alt</mi></msub></mrow><annotation encoding="application/x-tex">\exists\,T\in T_{\mathrm{alt}}</annotation></semantics></math> s.t. <math id="algorithm1.m36" class="ltx_Math" alttext="T\in\textit{best}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><mtext class="ltx_mathvariant_italic">best</mtext></mrow><annotation encoding="application/x-tex">T\in\textit{best}</annotation></semantics></math></em> <span id="algorithm1.4.41.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.42" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.42.1" class="ltx_text ltx_font_bold">37</span></span>
            <span id="algorithm1.4.42.2" class="ltx_text ltx_font_bold">return</span> tree with highest projection ranks and earliest positions among <math id="algorithm1.m37" class="ltx_Math" alttext="\textit{best}[T_{\mathrm{alt}}]" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">best</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>T</mi><mi>alt</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\textit{best}[T_{\mathrm{alt}}]</annotation></semantics></math>;
</div>
<div id="algorithm1.4.43" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.43.1" class="ltx_text ltx_font_bold">38</span></span>
            <span id="algorithm1.4.43.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algorithm1.4.44" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.44.1" class="ltx_text ltx_font_bold">39</span></span>
            <span id="algorithm1.4.44.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m38" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math>;
</div>
<div id="algorithm1.4.45" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.45.1" class="ltx_text ltx_font_bold">40</span></span>
