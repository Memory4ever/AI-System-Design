{"data":{"id":"10.48550/arxiv.2604.04750","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.04750","prefix":"10.48550","suffix":"arxiv.2604.04750","identifiers":[{"identifier":"2604.04750","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.04750"}],"creators":[{"name":"Mo, Zhiwen","nameType":"Personal","givenName":"Zhiwen","familyName":"Mo","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Guoyu","nameType":"Personal","givenName":"Guoyu","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Hao Mark","nameType":"Personal","givenName":"Hao Mark","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Yu","nameType":"Personal","givenName":"Yu","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Zhengju","nameType":"Personal","givenName":"Zhengju","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qianzhou","nameType":"Personal","givenName":"Qianzhou","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Lei","nameType":"Personal","givenName":"Lei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liang, Shuang","nameType":"Personal","givenName":"Shuang","familyName":"Liang","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Lingxiao","nameType":"Personal","givenName":"Lingxiao","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Xianqi","nameType":"Personal","givenName":"Xianqi","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yuxiao","nameType":"Personal","givenName":"Yuxiao","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Luk, Wayne","nameType":"Personal","givenName":"Wayne","familyName":"Luk","affiliation":[],"nameIdentifiers":[]},{"name":"Xue, Jilong","nameType":"Personal","givenName":"Jilong","familyName":"Xue","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Hongxiang","nameType":"Personal","givenName":"Hongxiang","familyName":"Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DeepStack: Facilitating Co-Design Exploration of 3D DRAM-Stacked Accelerators for Distributed LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-06T15:16:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:33:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T14:13:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:56:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-21T13:51:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-24T00:44:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-11T14:11:13Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-14T00:51:01Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Advances in hybrid bonding and packaging have driven growing interest in 3D DRAM-stacked AI accelerators. As large language models (LLMs) scale to hundreds of billions or trillions of parameters, distributed inference across multiple 3D chips has become essential for AI serving. This trend makes cross-stack co-design critical because system-level parallelization and scheduling choices are tightly coupled with hardware characteristics such as memory organization, interconnects, and thermal constraints. We present DeepStack, an accurate performance model and efficient design space exploration (DSE) framework for distributed 3D-stacked LLM inference. At the hardware level, DeepStack captures transaction-aware memory bandwidth, bank activation constraints, buffering limitations, and thermal and power behavior. At the system level, it incorporates comprehensive parallelization strategies and execution scheduling. Through a dual-stage network abstraction and tile-level compute-communication overlap modeling, DeepStack achieves up to 100,000x faster evaluation than state-of-the-art simulators at comparable accuracy. We cross-validate DeepStack against our in-house 3D designs, an NS-3 backend with 2.12% error, and vLLM serving on eight B200 GPUs with 12.92% error. Combined with hierarchical search, DeepStack efficiently explores about 2.5 x 10^14 design points spanning the number of stacked DRAM layers, DRAM vertical connectivity, interconnects, compute-memory allocation, and distributed scheduling under thermal and area constraints. A search-space ablation shows that restricted DSE baselines can miss up to 9.5x modeled throughput. Beyond modeling and DSE, DeepStack derives design implications for distributed 3D AI systems and guides performance optimization across the stack. Source code and artifacts are available at https://github.com/tile-ai/DeepStack/tree/ae.","descriptionType":"Abstract"},{"description":"MICRO version with three AE badges","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.04750","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T03:12:51.000Z","registered":"2026-04-07T03:12:51.000Z","published":"2026","updated":"2026-09-14T02:20:15.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.04750","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}