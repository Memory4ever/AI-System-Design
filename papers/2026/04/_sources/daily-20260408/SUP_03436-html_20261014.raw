<th id="A5.T4.8.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-bottom: 4.0pt;">52496</th>
<th id="A5.T4.8.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding-bottom: 4.0pt;"><math id="A5.T4.m8" class="ltx_Math" alttext="+0.493" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>0.493</mn></mrow><annotation encoding="application/x-tex">+0.493</annotation></semantics></math></th>
