<td id="S10.T9.7.5.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 4.0pt;"><span id="S10.T9.7.5.6.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">90</span></td>
