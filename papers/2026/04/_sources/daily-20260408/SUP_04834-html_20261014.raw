<span id="S5.T4.8.1.1.1" class="ltx_text ltx_phantom" style="--ltx-bg-color:#62BC7A;"><span style="visibility:hidden">xx</span></span> <math id="S5.T4.m5" class="ltx_Math" alttext="\geq 90" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>90</mn></mrow><annotation encoding="application/x-tex">\geq 90</annotation></semantics></math> (<span id="S5.T4.8.1.1.2" class="ltx_text ltx_font_bold">Best</span>)  
