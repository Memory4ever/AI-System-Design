<th id="S3.T1.3.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">PPL</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.3.2" class="ltx_tr">
<th id="S3.T1.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Standard</th>
<td id="S3.T1.3.2.2" class="ltx_td ltx_align_right ltx_border_t">826,433</td>
<td id="S3.T1.3.2.3" class="ltx_td ltx_align_right ltx_border_t">100%</td>
<td id="S3.T1.3.2.4" class="ltx_td ltx_align_right ltx_border_t">1.81</td>
<td id="S3.T1.3.2.5" class="ltx_td ltx_align_right ltx_border_t">6.1</td></tr>
<tr id="S3.T1.3.3" class="ltx_tr">
<th id="S3.T1.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DCT 2<math id="S3.T1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></th>
<td id="S3.T1.3.3.2" class="ltx_td ltx_align_right">433,217</td>
