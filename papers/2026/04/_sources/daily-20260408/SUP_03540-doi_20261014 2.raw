{"data":{"id":"10.48550/arxiv.2604.03540","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.03540","prefix":"10.48550","suffix":"arxiv.2604.03540","identifiers":[{"identifier":"2604.03540","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.03540"}],"creators":[{"name":"Gao, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Shen, Yedong","nameType":"Personal","givenName":"Yedong","familyName":"Shen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shiqi","nameType":"Personal","givenName":"Shiqi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Wenhao","nameType":"Personal","givenName":"Wenhao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Duan, Yifan","nameType":"Personal","givenName":"Yifan","familyName":"Duan","affiliation":[],"nameIdentifiers":[]},{"name":"pan, Jia","nameType":"Personal","givenName":"Jia","familyName":"pan","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Jiajia","nameType":"Personal","givenName":"Jiajia","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Deng, Jiajun","nameType":"Personal","givenName":"Jiajun","familyName":"Deng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yanyong","nameType":"Personal","givenName":"Yanyong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Drift-Based Policy Optimization: Native One-Step Policy Learning for Online Robot Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-04T01:32:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T00:15:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T15:51:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T01:03:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-21T12:50:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-22T00:55:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-29T02:29:15Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-01T00:19:39Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Diffusion policies effectively model multimodal action distributions for robotic manipulation, but their iterative denoising requires tens to hundreds of network function evaluations (NFEs) for each control prediction, limiting their applicability to high-frequency closed-loop control and online reinforcement learning (RL). We present a two-stage framework for native one-step generative policies that transfers iterative refinement from inference to training. First, Drift-Based Policy (DBP) uses a fixed-point drifting objective to internalize corrective dynamics into the model parameters, producing multimodal action chunks with a single network evaluation by design. Second, Drift-Based Policy Optimization (DBPO) augments the pretrained backbone with a stochastic interface that provides exact conditional rollout likelihoods for PPO-style on-policy updates while preserving 1-NFE deployment. On the 12-task Diffusion Policy suite, DBP improves the average success rate from 0.79 to 0.83 while reducing inference from 100 NFEs to 1. Across 37 point-cloud manipulation tasks, DBP achieves an average success rate of 88.4%, surpassing the leading 1-NFE baseline OMP at 82.3%. DBPO further improves pretrained one-step policies through stable online fine-tuning on RoboMimic and D4RL. On a physical dual-arm UR5 platform, DBP achieves 123/150 successes (82%) with an average end-to-end latency of 9.5 ms, compared with MP1's 89/150 successes (59%) under the same setup. Code is available at https://github.com/YuxuanGao0822/DBPO.","descriptionType":"Abstract"},{"description":"Accepted at the 34th ACM International Conference on Multimedia","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.03540","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T02:43:46.000Z","registered":"2026-04-07T02:43:46.000Z","published":"2026","updated":"2026-09-01T05:09:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.03540","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}