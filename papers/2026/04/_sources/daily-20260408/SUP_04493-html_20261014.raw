</span></td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.3pt;padding-right:4.3pt;">
<span id="S3.T1.2.4.5.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.2.4.5.1.1" class="ltx_p"><math id="S3.T1.m20" class="ltx_Math" alttext="6.52" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">6.52</mn><annotation encoding="application/x-tex">6.52</annotation></semantics></math></span>
</span></td>
