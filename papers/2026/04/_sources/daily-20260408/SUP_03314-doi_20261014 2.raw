{"data":{"id":"10.48550/arxiv.2604.03314","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.03314","prefix":"10.48550","suffix":"arxiv.2604.03314","identifiers":[{"identifier":"2604.03314","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.03314"}],"creators":[{"name":"Suharitdamrong, Wish","nameType":"Personal","givenName":"Wish","familyName":"Suharitdamrong","affiliation":[],"nameIdentifiers":[]},{"name":"Alex, Tony","nameType":"Personal","givenName":"Tony","familyName":"Alex","affiliation":[],"nameIdentifiers":[]},{"name":"Awais, Muhammad","nameType":"Personal","givenName":"Muhammad","familyName":"Awais","affiliation":[],"nameIdentifiers":[]},{"name":"Atito, Sara","nameType":"Personal","givenName":"Sara","familyName":"Atito","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CoLA: Cross-Modal Low-rank Adaptation for Multimodal Downstream Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-01T01:37:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T00:02:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-24T11:13:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-25T00:48:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-13T16:02:38Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-14T00:58:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Foundation models have revolutionized AI, but adapting them efficiently for multimodal tasks, particularly in dual-stream architectures composed of unimodal encoders, such as DINO and BERT, remains a significant challenge. ParameterEfficient Fine-Tuning (PEFT) methods like LowRank Adaptation (LoRA) enable lightweight adaptation, yet they operate in isolation within each modality, limiting their ability in capturing cross-modal interactions. In this paper, we take a step in bridging this gap with Cross-Modal LowRank Adaptation (CoLA), a novel PEFT framework that extends LoRA by introducing a dedicated inter-modal adaptation pathway alongside the standard intra-modal one. This dual-path design enables CoLA to adapt unimodal foundation models to multimodal tasks effectively, without interference between modality-specific and crossmodal learning. We evaluate CoLA across a range of vision-language (RefCOCO, RefCOCO+, RefCOCOg) and audio-visual (AVE, AVS) benchmarks, where it consistently outperforms LORA, achieving a relative gain of around 3% and 2%, respectively, while maintaining parameter efficiency. Notably, CoLA enables the first multitask PEFT framework for visual grounding, bridging a key gap in efficient multimodal adaptation. Code is available at https://github.com/peterwisu/CoLA","descriptionType":"Abstract"},{"description":"Accepted by ICML 2026, 17 pages, 6 Figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.03314","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T02:38:26.000Z","registered":"2026-04-07T02:38:26.000Z","published":"2026","updated":"2026-08-14T02:25:58.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.03314","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}