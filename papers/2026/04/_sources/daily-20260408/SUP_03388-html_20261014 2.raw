               <math id="alg1.l23.m1" class="ltx_Math" alttext="\boldsymbol{\Lambda}_{t+1}=\boldsymbol{\Lambda}_{t}-\eta_{\text{polar}}\nabla_{\boldsymbol{\Lambda}}\mathcal{L}_{t}^{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚲</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>𝚲</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mtext>polar</mtext></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝚲</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>t</mi><mtext>ELBO</mtext></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Lambda}_{t+1}=\boldsymbol{\Lambda}_{t}-\eta_{\text{polar}}\nabla_{\boldsymbol{\Lambda}}\mathcal{L}_{t}^{\text{ELBO}}</annotation></semantics></math>

