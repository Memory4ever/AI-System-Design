               <math id="alg1.l22.m1" class="ltx_Math" alttext="\mathbf{V}_{t+1}=\mathbf{V}_{t}-\eta_{\text{polar}}\boldsymbol{\Gamma}(\mathbf{V}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐕</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>𝐕</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mtext>polar</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝚪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐕</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{V}_{t+1}=\mathbf{V}_{t}-\eta_{\text{polar}}\boldsymbol{\Gamma}(\mathbf{V}_{t})</annotation></semantics></math>

