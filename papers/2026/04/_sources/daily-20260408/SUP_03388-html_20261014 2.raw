<br class="ltx_break"><span id="A3.T3.7.1" class="ltx_text ltx_font_bold">Configuration:</span> LoRA rank = 8, batch size = 4, dataset = ARC-E, LoRA targets = [<span id="A3.T3.7.2" class="ltx_text ltx_font_typewriter">q_proj</span>, <span id="A3.T3.7.3" class="ltx_text ltx_font_typewriter">v_proj</span>].</span></figcaption>
