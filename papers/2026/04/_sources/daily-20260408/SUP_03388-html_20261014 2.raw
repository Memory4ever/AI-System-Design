<td id="S4.T1.8.1.39.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T1.8.1.39.4.1" class="ltx_text ltx_underline" style="font-size:70%;">0.33<sub id="S4.T1.8.1.39.4.1.1" class="ltx_sub"><span id="S4.T1.8.1.39.4.1.1.1" class="ltx_text ltx_font_italic">±0.02</span></sub></span></td>
<td id="S4.T1.8.1.39.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T1.8.1.39.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.53<sub id="S4.T1.8.1.39.5.1.1" class="ltx_sub"><span id="S4.T1.8.1.39.5.1.1.1" class="ltx_text ltx_font_italic">±0.02</span></sub></span></td>
