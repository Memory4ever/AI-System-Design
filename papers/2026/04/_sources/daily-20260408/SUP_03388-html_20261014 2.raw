<td id="A3.T7.6.2.2" class="ltx_td ltx_align_center ltx_border_t">69.50</td>
<td id="A3.T7.6.2.3" class="ltx_td ltx_align_center ltx_border_t">61.23</td>
<td id="A3.T7.6.2.4" class="ltx_td ltx_align_center ltx_border_t">8.27</td></tr>
<tr id="A3.T7.6.3" class="ltx_tr">
<th id="A3.T7.6.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">50</th>
<td id="A3.T7.6.3.2" class="ltx_td ltx_align_center">50.71</td>
<td id="A3.T7.6.3.3" class="ltx_td ltx_align_center">50.97</td>
<td id="A3.T7.6.3.4" class="ltx_td ltx_align_center">0.26</td></tr>
<tr id="A3.T7.6.4" class="ltx_tr">
<th id="A3.T7.6.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">100</th>
