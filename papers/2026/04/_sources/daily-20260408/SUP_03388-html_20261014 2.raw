<td id="S4.T1.8.1.38.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T1.8.1.38.11.1" class="ltx_text" style="font-size:70%;">1.27<sub id="S4.T1.8.1.38.11.1.1" class="ltx_sub"><span id="S4.T1.8.1.38.11.1.1.1" class="ltx_text ltx_font_italic">±0.05</span></sub></span></td></tr>
<tr id="S4.T1.8.1.39" class="ltx_tr">
