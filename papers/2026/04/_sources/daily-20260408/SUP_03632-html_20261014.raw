<td id="S4.T3.2.17.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBF1FA;padding:0.55pt 4.0pt;"><span id="S4.T3.2.17.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#4D58EA;--ltx-bg-color:#EBF1FA;">92.10<span id="S4.T3.2.17.2.1.1" class="ltx_text ltx_font_medium" style="font-size:78%;--ltx-fg-color:#808080;"> (+22.94)</span></span></td>
