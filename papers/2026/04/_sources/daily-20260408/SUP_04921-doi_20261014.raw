{"data":{"id":"10.48550/arxiv.2604.04921","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.04921","prefix":"10.48550","suffix":"arxiv.2604.04921","identifiers":[{"identifier":"2604.04921","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.04921"}],"creators":[{"name":"Mao, Weian","nameType":"Personal","givenName":"Weian","familyName":"Mao","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Xi","nameType":"Personal","givenName":"Xi","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Wei","nameType":"Personal","givenName":"Wei","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Yuxin","nameType":"Personal","givenName":"Yuxin","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Tianfu","nameType":"Personal","givenName":"Tianfu","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhuang, Bohan","nameType":"Personal","givenName":"Bohan","familyName":"Zhuang","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Song","nameType":"Personal","givenName":"Song","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Yukang","nameType":"Personal","givenName":"Yukang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TriAttention: Efficient Long Reasoning with Trigonometric KV Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-06T17:58:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:42:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Extended reasoning in large language models (LLMs) creates severe KV cache memory bottlenecks. Leading KV cache compression methods estimate KV importance using attention scores from recent post-RoPE queries. However, queries rotate with position during RoPE, making representative queries very few, leading to poor top-key selection and unstable reasoning. To avoid this issue, we turn to the pre-RoPE space, where we observe that Q and K vectors are highly concentrated around fixed non-zero centers and remain stable across positions -- Q/K concentration. We show that this concentration causes queries to preferentially attend to keys at specific distances (e.g., nearest keys), with the centers determining which distances are preferred via a trigonometric series. Based on this, we propose TriAttention to estimate key importance by leveraging these centers. Via the trigonometric series, we use the distance preference characterized by these centers to score keys according to their positions, and also leverage Q/K norms as an additional signal for importance estimation. On AIME25 with 32K-token generation, TriAttention matches Full Attention reasoning accuracy while achieving 2.5x higher throughput or 10.7x KV memory reduction, whereas leading baselines achieve only about half the accuracy at the same efficiency. TriAttention enables OpenClaw deployment on a single consumer GPU, where long context would otherwise cause out-of-memory with Full Attention.","descriptionType":"Abstract"},{"description":"Code is available at https://github.com/WeianMao/triattention","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.04921","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T03:16:53.000Z","registered":"2026-04-07T03:16:54.000Z","published":"2026","updated":"2026-04-07T03:16:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.04921","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}