<section id="Pt0.A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix 0.D </span>More Experiments Results</h2>

<figure id="Pt0.A4.T6" class="ltx_table">

<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="Pt0.A4.T6.4" class="ltx_text" style="font-size:90%;">Table 6</span>: </span><span id="Pt0.A4.T6.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Quantitative comparison on ImageNet <math id="Pt0.A4.T6.m2" class="ltx_Math" alttext="\mathbf{256\times 256}" display="inline" intent=":literal"><semantics><mrow><mn>𝟐𝟓𝟔</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>𝟐𝟓𝟔</mn></mrow><annotation encoding="application/x-tex">\mathbf{256\times 256}</annotation></semantics></math> on SiT-XL.</span></figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Pt0.A4.T6.st1" class="ltx_table ltx_figure_panel ltx_align_center">
<figcaption class="ltx_caption ltx_centering" style="font-size:70%;"><span class="ltx_tag ltx_tag_table"><span id="Pt0.A4.T6.st1.5" class="ltx_text" style="font-size:129%;">(a)</span> </span><span id="Pt0.A4.T6.st1.6" class="ltx_text" style="font-size:129%;">Results with 50 denoising steps.</span></figcaption>
<table id="Pt0.A4.T6.st1.7" class="ltx_tabular ltx_centering ltx_align_middle">
