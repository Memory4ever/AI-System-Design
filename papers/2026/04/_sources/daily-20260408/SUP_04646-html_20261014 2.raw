<td id="Pt0.A3.T4.6.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.3.6.1" class="ltx_text" style="font-size:80%;">17.05</span></td></tr>
<tr id="Pt0.A3.T4.6.4" class="ltx_tr">
<td id="Pt0.A3.T4.6.4.1" class="ltx_td ltx_align_left" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.4.1.1" class="ltx_text" style="font-size:80%;">Euler<sup id="Pt0.A3.T4.6.4.1.1.1" class="ltx_sup">†</sup></span></td>
<td id="Pt0.A3.T4.6.4.2" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.4.2.1" class="ltx_text" style="font-size:80%;">77</span></td>
<td id="Pt0.A3.T4.6.4.3" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.4.3.1" class="ltx_text" style="font-size:80%;">3.83</span></td>
<td id="Pt0.A3.T4.6.4.4" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.4.4.1" class="ltx_text" style="font-size:80%;">3.76</span></td>
<td id="Pt0.A3.T4.6.4.5" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="Pt0.A3.T4.6.4.5.1" class="ltx_text" style="font-size:80%;">9.11</span></td>
