<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.5" class="ltx_text ltx_font_smallcaps">Overall Sampling Pipeline with FDS</span></figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="alg2.l1.3" class="ltx_text ltx_font_bold">Input:</span> initial state <math id="alg2.l1.m1" class="ltx_Math" alttext="x_{t_{0}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msub><mi>t</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">x_{t_{0}}</annotation></semantics></math>, time grid <math id="alg2.l1.m2" class="ltx_Math" alttext="0=t_{0}&lt;t_{1}&lt;\cdots&lt;t_{T}=1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub><mo>&lt;</mo><msub><mi>t</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>t</mi><mi>T</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0=t_{0}&lt;t_{1}&lt;\cdots&lt;t_{T}=1</annotation></semantics></math>, flow model <math id="alg2.l1.m3" class="ltx_Math" alttext="u_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">u_{\theta}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          <span id="alg2.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l2.m1" class="ltx_Math" alttext="k=0,1,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,1,\dots,T-1</annotation></semantics></math> <span id="alg2.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            <math id="alg2.l3.m1" class="ltx_Math" alttext="\tilde{x}_{t_{k}}\leftarrow\operatorname{Refine}(x_{t_{k}},t_{k};u_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">←</mo><mrow><mi>Refine</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>u</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{x}_{t_{k}}\leftarrow\operatorname{Refine}(x_{t_{k}},t_{k};u_{\theta})</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <math id="alg2.l4.m1" class="ltx_Math" alttext="x_{t_{k+1}}\leftarrow\operatorname{SolverStep}(\tilde{x}_{t_{k}},t_{k},t_{k+1};u_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">←</mo><mrow><mi>SolverStep</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>u</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t_{k+1}}\leftarrow\operatorname{SolverStep}(\tilde{x}_{t_{k}},t_{k},t_{k+1};u_{\theta})</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
