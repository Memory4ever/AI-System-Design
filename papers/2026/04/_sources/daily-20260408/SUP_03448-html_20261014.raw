<td id="S3.T2.16.2.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S3.T2.16.2.2.1" class="ltx_text" style="font-size:90%;">49.94 <math id="S3.T2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 13.39</span></td></tr>
