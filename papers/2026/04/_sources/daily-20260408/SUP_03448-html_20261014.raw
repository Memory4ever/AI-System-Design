<th id="S3.T2.16.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.16.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Latency (s)</span></th></tr>
</thead>
