<td id="S3.T2.16.3.2" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T2.16.3.2.1" class="ltx_text" style="font-size:90%;">46.01 <math id="S3.T2.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 11.74</span></td></tr>
