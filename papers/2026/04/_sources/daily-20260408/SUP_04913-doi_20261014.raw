{"data":{"id":"10.48550/arxiv.2604.04913","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.04913","prefix":"10.48550","suffix":"arxiv.2604.04913","identifiers":[{"identifier":"2604.04913","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.04913"}],"creators":[{"name":"Kerssies, Tommie","nameType":"Personal","givenName":"Tommie","familyName":"Kerssies","affiliation":[],"nameIdentifiers":[]},{"name":"Berton, Gabriele","nameType":"Personal","givenName":"Gabriele","familyName":"Berton","affiliation":[],"nameIdentifiers":[]},{"name":"He, Ju","nameType":"Personal","givenName":"Ju","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Qihang","nameType":"Personal","givenName":"Qihang","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Wufei","nameType":"Personal","givenName":"Wufei","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"de Geus, Daan","nameType":"Personal","givenName":"Daan","familyName":"de Geus","affiliation":[],"nameIdentifiers":[]},{"name":"Dubbelman, Gijs","nameType":"Personal","givenName":"Gijs","familyName":"Dubbelman","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Liang-Chieh","nameType":"Personal","givenName":"Liang-Chieh","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Frame is Worth One Token: Efficient Generative World Modeling with Delta Tokens"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-06T17:55:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T01:42:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Anticipating diverse future states is a central challenge in video world modeling. Discriminative world models produce a deterministic prediction that implicitly averages over possible futures, while existing generative world models remain computationally expensive. Recent work demonstrates that predicting the future in the feature space of a vision foundation model (VFM), rather than a latent space optimized for pixel reconstruction, requires significantly fewer world model parameters. However, most such approaches remain discriminative. In this work, we introduce DeltaTok, a tokenizer that encodes the VFM feature difference between consecutive frames into a single continuous \"delta\" token, and DeltaWorld, a generative world model operating on these tokens to efficiently generate diverse plausible futures. Delta tokens reduce video from a three-dimensional spatio-temporal representation to a one-dimensional temporal sequence, for example yielding a 1,024x token reduction with 512x512 frames. This compact representation enables tractable multi-hypothesis training, where many futures are generated in parallel and only the best is supervised. At inference, this leads to diverse predictions in a single forward pass. Experiments on dense forecasting tasks demonstrate that DeltaWorld forecasts futures that more closely align with real-world outcomes, while having over 35x fewer parameters and using 2,000x fewer FLOPs than existing generative world models. Code and weights: https://deltatok.github.io.","descriptionType":"Abstract"},{"description":"CVPR 2026. Code and weights: https://deltatok.github.io","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.04913","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-07T03:16:42.000Z","registered":"2026-04-07T03:16:43.000Z","published":"2026","updated":"2026-04-07T03:16:43.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.04913","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}