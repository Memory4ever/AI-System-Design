<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.742</td>
<td id="S4.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.689</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<th id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Contrastive</th>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center">0.828</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center">0.796</td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center">0.759</td>
<td id="S4.T2.2.3.5" class="ltx_td ltx_align_center">0.705</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<th id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Autoregressive</th>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center">0.835</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center">0.802</td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center">0.768</td>
<td id="S4.T2.2.4.5" class="ltx_td ltx_align_center">0.712</td></tr>
