<span id="A4.T2.4.54.2.1.1" class="ltx_p ltx_align_left"><span id="A4.T2.4.54.2.1.1.1" class="ltx_text" style="font-size:50%;">Recognize functional groups via atom bonding arrangements.</span></span>
</span></td></tr>
<tr id="A4.T2.4.55" class="ltx_tr">
<td id="A4.T2.4.55.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.6pt 1.5pt;">
