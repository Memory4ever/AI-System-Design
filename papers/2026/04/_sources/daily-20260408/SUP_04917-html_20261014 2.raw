<td id="A3.T1.1.5.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A3.T1.1.5.2.1" class="ltx_text" style="font-size:90%;">128</span></td></tr>
<tr id="A3.T1.1.6" class="ltx_tr">
