<span id="A4.T2.3.61.1.1.1" class="ltx_p ltx_align_left"><span id="A4.T2.3.61.1.1.1.1" class="ltx_text" style="font-size:50%;">Associate Visual Elements With Meaning</span></span>
</span></td>
<td id="A4.T2.3.61.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.6pt 1.5pt;">
<span id="A4.T2.3.61.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T2.3.61.2.1.1" class="ltx_p ltx_align_left"><span id="A4.T2.3.61.2.1.1.1" class="ltx_text" style="font-size:50%;">Link objects to real-world usage to infer setting themes.</span></span>
</span></td></tr>
<tr id="A4.T2.3.62" class="ltx_tr">
<td id="A4.T2.3.62.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.6pt 1.5pt;">
