<td id="A1.T3.3.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:0.7pt 4.0pt;" colspan="3"><span id="A1.T3.3.2.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Single-ground-truth datasets</span></td></tr>
