<span id="A4.SSx1.p2.1.2.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.SSx1.p2.1.2.2.1.1" class="ltx_p ltx_align_left"><span id="A4.SSx1.p2.1.2.2.1.1.1" class="ltx_text" style="font-size:70%;">Extract general principles from specific instances.</span></span>
</span></td></tr>
<tr id="A4.SSx1.p2.1.3" class="ltx_tr">
<td id="A4.SSx1.p2.1.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:-0.4pt 2.0pt;">
