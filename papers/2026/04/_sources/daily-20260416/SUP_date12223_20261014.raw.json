{"data":{"id":"10.48550/arxiv.2604.12223","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12223","prefix":"10.48550","suffix":"arxiv.2604.12223","identifiers":[{"identifier":"2604.12223","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12223"}],"creators":[{"name":"Gao, Jiechao","nameType":"Personal","givenName":"Jiechao","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Yadav, Rohan Kumar","nameType":"Personal","givenName":"Rohan Kumar","familyName":"Yadav","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yuangang","nameType":"Personal","givenName":"Yuangang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Yuandong","nameType":"Personal","givenName":"Yuandong","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Jie","nameType":"Personal","givenName":"Jie","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Ying","nameType":"Personal","givenName":"Ying","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Lepech, Michael","nameType":"Personal","givenName":"Michael","familyName":"Lepech","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Guided Semantic Bootstrapping for Interpretable Text Classification with Tsetlin Machines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T03:02:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-15T00:21:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Pretrained language models (PLMs) like BERT provide strong semantic representations but are costly and opaque, while symbolic models such as the Tsetlin Machine (TM) offer transparency but lack semantic generalization. We propose a semantic bootstrapping framework that transfers LLM knowledge into symbolic form, combining interpretability with semantic capacity. Given a class label, an LLM generates sub-intents that guide synthetic data creation through a three-stage curriculum (seed, core, enriched), expanding semantic diversity. A Non-Negated TM (NTM) learns from these examples to extract high-confidence literals as interpretable semantic cues. Injecting these cues into real data enables a TM to align clause logic with LLM-inferred semantics. Our method requires no embeddings or runtime LLM calls, yet equips symbolic models with pretrained semantic priors. Across multiple text classification tasks, it improves interpretability and accuracy over vanilla TM, achieving performance comparable to BERT while remaining fully symbolic and efficient.","descriptionType":"Abstract"},{"description":"Accepted to Findings of the Association for Computational Linguistics (ACL 2026)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12223","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-15T01:58:32.000Z","registered":"2026-04-15T01:58:33.000Z","published":"2026","updated":"2026-04-15T01:58:33.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.12223","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}