{"data":{"id":"10.48550/arxiv.2604.12666","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12666","prefix":"10.48550","suffix":"arxiv.2604.12666","identifiers":[{"identifier":"2604.12666","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12666"}],"creators":[{"name":"Peng, Chuang","nameType":"Personal","givenName":"Chuang","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Wei","nameType":"Personal","givenName":"Wei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tao, Renshuai","nameType":"Personal","givenName":"Renshuai","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xinhao","nameType":"Personal","givenName":"Xinhao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Jian","nameType":"Personal","givenName":"Jian","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Imitation to Discrimination: Progressive Curriculum Learning for Robust Web Navigation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T12:37:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-15T00:50:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Text-based web agents offer computational efficiency for autonomous web navigation, yet developing robust agents remains challenging due to the noisy and heterogeneous nature of real-world HTML. Standard Supervised Fine-Tuning (SFT) approaches fail in two critical dimensions: they lack discrimination capabilities to reject plausible but incorrect elements in densely populated pages, and exhibit limited generalization to unseen website layouts. To address these challenges, we introduce the Triton dataset (590k instances) and a progressive training curriculum. Triton is constructed via Structural-Semantic Hard Negative Mining, which explicitly mines topologically similar distractors, and a Dual-Agent Consensus pipeline that synthesizes diverse cross-domain tasks with strict verification. Building upon this foundation, our progressive curriculum produces three models: Triton-SFT-32B for basic imitation, Triton-ORPO-32B for robust discrimination via Odds Ratio Preference Optimization, and Triton-GRPO-32B for long-horizon consistency through Group Relative Policy Optimization. Empirical evaluation on Mind2Web demonstrates that Triton-GRPO-32B achieves state-of-the-art performance among open-source models with 58.7% Step Success Rate, surpassing GPT-4.5 (42.4%) and Claude-4.5 (41.4%) by over 16%, validating that specialized data curriculum outweighs raw parameter scale for web navigation.","descriptionType":"Abstract"},{"description":"17 pages, 10 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12666","contentUrl":null,"metadataVersion":0,"schemaVersion":