{"data":{"id":"10.48550/arxiv.2604.12379","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12379","prefix":"10.48550","suffix":"arxiv.2604.12379","identifiers":[{"identifier":"2604.12379","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12379"}],"creators":[{"name":"Li, Yuangang","nameType":"Personal","givenName":"Yuangang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Justin Tian Jin","nameType":"Personal","givenName":"Justin Tian Jin","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Ethan","nameType":"Personal","givenName":"Ethan","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Hong, David","nameType":"Personal","givenName":"David","familyName":"Hong","affiliation":[],"nameIdentifiers":[]},{"name":"Ahmed, Iftekhar","nameType":"Personal","givenName":"Iftekhar","familyName":"Ahmed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Output Correctness: Benchmarking and Evaluating Large Language Model Reasoning in Coding Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T07:12:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-15T00:32:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-27T23:16:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-31T00:14:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large language models (LLMs) increasingly rely on explicit reasoning to solve coding tasks, yet evaluating the quality of this reasoning remains challenging. Existing reasoning evaluators are not designed for coding, and current benchmarks focus primarily on code generation, leaving other coding tasks largely unexplored. We introduce CodeRQ-Bench, the first benchmark for evaluating LLM reasoning quality across three coding task categories: generation, summarization, and classification. Using this benchmark, we analyze 1,069 mismatch cases from existing evaluators, identify five recurring limitations, and derive four design insights for reasoning evaluation in coding tasks. Guided by these insights, we propose VERA, a two-stage evaluator that combines evidence-grounded verification with ambiguity-aware score correction. Experiments on CodeRQ-Bench show that VERA consistently outperforms strong baselines across four datasets, improving AUCROC by up to 0.26 and AUPRC by up to 0.21. We release CodeRQ-Bench at https://github.com/MrLYG/CodeRQ-Bench, supporting future investigations.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12379","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-15T02:02:13.000Z","registered":"2026-04-15T02:02:13.000Z","published":"2026","updated":"2026-08-31T02:23:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.12379","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}