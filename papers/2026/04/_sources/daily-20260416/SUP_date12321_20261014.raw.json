{"data":{"id":"10.48550/arxiv.2604.12321","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12321","prefix":"10.48550","suffix":"arxiv.2604.12321","identifiers":[{"identifier":"2604.12321","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12321"}],"creators":[{"name":"Li, Boyang","nameType":"Personal","givenName":"Boyang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Shou, Hongzhe","nameType":"Personal","givenName":"Hongzhe","familyName":"Shou","affiliation":[],"nameIdentifiers":[]},{"name":"Liang, Yuanyuan","nameType":"Personal","givenName":"Yuanyuan","familyName":"Liang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jingbin","nameType":"Personal","givenName":"Jingbin","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Fang","nameType":"Personal","givenName":"Fang","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToxiTrace: Gradient-Aligned Training for Explainable Chinese Toxicity Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T05:54:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-15T00:29:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Existing Chinese toxic content detection methods mainly target sentence-level classification but often fail to provide readable and contiguous toxic evidence spans. We propose \\textbf{ToxiTrace}, an explainability-oriented method for BERT-style encoders with three components: (1) \\textbf{CuSA}, which refines encoder-derived saliency cues into fine-grained toxic spans with lightweight LLM guidance; (2) \\textbf{GCLoss}, a gradient-constrained objective that concentrates token-level saliency on toxic evidence while suppressing irrelevant activations; and (3) \\textbf{ARCL}, which constructs sample-specific contrastive reasoning pairs to sharpen the semantic boundary between toxic and non-toxic content. Experiments show that ToxiTrace improves classification accuracy and toxic span extraction while preserving efficient encoder-based inference and producing more coherent, human-readable explanations. We have released the model at https://huggingface.co/ArdLi/ToxiTrace.","descriptionType":"Abstract"},{"description":"Accepted to ACL 2026 Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12321","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-15T02:00:48.000Z","registered":"2026-04-15T02:00:49.000Z","published":"2026","updated":"2026-04-15T02:00:49.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data