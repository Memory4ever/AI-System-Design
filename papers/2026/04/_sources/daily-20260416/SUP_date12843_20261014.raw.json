{"data":{"id":"10.48550/arxiv.2604.12843","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12843","prefix":"10.48550","suffix":"arxiv.2604.12843","identifiers":[{"identifier":"2604.12843","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12843"}],"creators":[{"name":"Habba, Eliya","nameType":"Personal","givenName":"Eliya","familyName":"Habba","affiliation":[],"nameIdentifiers":[]},{"name":"Itzhak, Itay","nameType":"Personal","givenName":"Itay","familyName":"Itzhak","affiliation":[],"nameIdentifiers":[]},{"name":"Yehudai, Asaf","nameType":"Personal","givenName":"Asaf","familyName":"Yehudai","affiliation":[],"nameIdentifiers":[]},{"name":"Perlitz, Yotam","nameType":"Personal","givenName":"Yotam","familyName":"Perlitz","affiliation":[],"nameIdentifiers":[]},{"name":"Bandel, Elron","nameType":"Personal","givenName":"Elron","familyName":"Bandel","affiliation":[],"nameIdentifiers":[]},{"name":"Shmueli-Scheuer, Michal","nameType":"Personal","givenName":"Michal","familyName":"Shmueli-Scheuer","affiliation":[],"nameIdentifiers":[]},{"name":"Choshen, Leshem","nameType":"Personal","givenName":"Leshem","familyName":"Choshen","affiliation":[],"nameIdentifiers":[]},{"name":"Stanovsky, Gabriel","nameType":"Personal","givenName":"Gabriel","familyName":"Stanovsky","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Growing Pains: Extensible and Efficient LLM Benchmarking Via Fixed Parameter Calibration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T15:01:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-15T01:00:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-15T05:42:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-16T00:29:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-09T14:28:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-11T01:07:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The rapid release of both language models and benchmarks makes it increasingly costly to evaluate every model on every dataset. In practice, models are often evaluated on different samples, making scores difficult to compare across studies. To address this, we propose a framework based on multidimensional Item Response Theory (IRT) that uses anchor items to calibrate new benchmarks to the evaluation suite while holding previously calibrated item parameters fixed. Our approach supports a realistic evaluation setting in which datasets are introduced over time and models are evaluated only on the datasets available at the time of evaluation, while a fixed anchor set for each dataset is used so that results from different evaluation periods can be compared directly. In large-scale experiments on more than 400 models, our framework predicts full-evaluation performance within 2-3 percentage points using only 100 anchor questions per dataset, with Spearman $ρ\\geq 0.9$ for ranking preservation preservation. This shows that benchmark suites can grow over time while preserving score comparability, since adding a new dataset requires running existing models only on that dataset's anchors. Code and data are available at: https://eliyahabba.github.io/growing-pains/","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12843","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-15T02:13:15.000Z","registered":"2026-04-15T02:13:16.000Z","published":"2026","updated":"2026-08-11T04:19:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.12843","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}