{"data":{"id":"10.48550/arxiv.2604.12372","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.12372","prefix":"10.48550","suffix":"arxiv.2604.12372","identifiers":[{"identifier":"2604.12372","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.12372"}],"creators":[{"name":"Chakrabarty, Sayak","nameType":"Personal","givenName":"Sayak","familyName":"Chakrabarty","affiliation":[],"nameIdentifiers":[]},{"name":"Pal, Souradip","nameType":"Personal","givenName":"Souradip","familyName":"Pal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is Sliding Window All You Need? An Open Framework for Long-Sequence Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"H.3.3","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-04-14T06:59:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-19T00:32:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/rev-ai70456.2026.11622311","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Long interaction histories are central to modern recommender systems, yet training with long sequences is often dismissed as impractical under realistic memory and latency budgets. This work demonstrates that it is not only practical but also effective-at academic scale. We release a complete, end-to-end framework that implements industrial-style long-sequence training with sliding windows, including all data processing, training, and evaluation scripts. Beyond reproducing prior gains, we contribute two capabilities missing from earlier reports: (i) a runtime-aware ablation study that quantifies the accuracy-compute frontier across windowing regimes and strides, and (ii) a novel k-shift embedding layer that enables million-scale vocabularies on commodity GPUs with negligible accuracy loss. Our implementation trains reliably on modest university clusters while delivering competitive retrieval quality (e.g., up to +6.04% MRR and +6.34% Recall@10 on Retailrocket) with $\\sim 4 \\times $ training-time overheads. By packaging a robust pipeline, reporting training time costs, and introducing an embedding mechanism tailored for low-resource settings, we transform long-sequence training from a closed, industrial technique into a practical, open, and extensible methodology for the community.","descriptionType":"Abstract"},{"description":"8 pages, 2 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.12372","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-04-15T02:02:02.000Z","registered":"2026-04-15T02:02:03.000Z","published":"2026","updated":"2026-08-19T02:27:17.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.12372","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1109/rev-ai70456.2026.11622311","type":"dois"}]}}}}