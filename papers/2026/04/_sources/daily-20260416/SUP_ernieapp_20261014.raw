h":"src/sections/Showcases.tsx:309:7",className:"container mx-auto max-w-6xl px-6 lg:px-12",children:c.jsx("div",{"code-path":"src/sections/Showcases.tsx:310:9",className:`transition-all duration-500 ${M?"translate-y-0 opacity-100":"translate-y-8 opacity-0"}`,children:c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:313:11",ref:r,className:"relative overflow-hidden rounded-2xl border border-gray-200 bg-white select-none",style:{cursor:"grab"},onMouseEnter:()=>{ae.current=!0},onMouseLeave:()=>{ae.current=!1,be.current=!1,r.current&&(r.current.style.cursor="grab")},onMouseDown:tt,onTouchStart:_e,children:[c.jsx("div",{"code-path":"src/sections/Showcases.tsx:327:13",className:"py-4 flex flex-col",style:{gap:ns},children:Oe.map((N,_)=>D(N,_))}),c.jsx("div",{"code-path":"src/sections/Showcases.tsx:332:13",className:"relative h-1 bg-gray-100 mx-4 mb-3 rounded-full overflow-hidden",children:c.jsx("div",{"code-path":"src/sections/Showcases.tsx:333:15",ref:g,className:"absolute h-full rounded-full bg-gray-300",style:{width:"15%",left:"0%",transition:"none"}})})]})})}),c.jsx("div",{"code-path":"src/sections/Showcases.tsx:344:7",className:"container mx-auto max-w-6xl px-6 lg:px-12 mt-3",children:c.jsx("p",{"code-path":"src/sections/Showcases.tsx:345:9",className:"text-xs text-gray-400",children:y?"以上图片仅用于展示模型生成效果，不代表任何商业用途或立场。模型支持非商业个人二次创作。":"The images above are shown solely to demonstrate model capabilities and do not imply any commercial use or endorsement. The model is intended for non-commercial personal derivative creation."})}),c.jsx("div",{"code-path":"src/sections/Showcases.tsx:353:7",className:"container mx-auto max-w-6xl px-6 lg:px-12",children:c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:354:9",className:"mt-12 space-y-4",children:[c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:355:11",children:[c.jsx("h3",{"code-path":"src/sections/Showcases.tsx:356:13",className:"text-lg font-bold text-baidu-dark mb-1",children:y?"海报与设计排版":"Posters and Design Layouts"}),c.jsx("p",{"code-path":"src/sections/Showcases.tsx:357:13",className:"text-baidu-gray leading-relaxed",children:y?c.jsxs(c.Fragment,{children:["ERNIE-Image 在",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:359:32",className:"text-baidu-dark",children:"海报和版式要求高的图像"}),"上表现出色，能把视觉焦点、标题排版、辅助文字和整体构图融为一体。很多开源模型可以生成「像海报的图」，但排版和版式经不住细看；ERNIE-Image 的输出则更接近可直接使用的设计稿。"]}):c.jsxs(c.Fragment,{children:["ERNIE-Image excels at ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:361:41",className:"text-baidu-dark",children:"posters and other layout-critical images"}),', combining strong visual focal points with reliable title placement, supporting text, and overall composition. Where many open weights models can produce a "poster-like" image but fall apart on typography or layout control, ERNIE-Image gets much closer to a usable design draft.']})})]}),c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:366:11",children:[c.jsx("h3",{"code-path":"src/sections/Showcases.tsx:367:13",className:"text-lg font-bold text-baidu-dark mb-1",children:y?"动漫与分镜":"Anime and Storyboards"}),c.jsx("p",{"code-path":"src/sections/Showcases.tsx:368:13",className:"text-baidu-gray leading-relaxed",children:y?c.jsxs(c.Fragment,{children:["ERNIE-Image 在",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:370:32",className:"text-baidu-dark",children:"动漫风格和分镜式生成"}),"方面很有优势。动漫的难点不只是画好角色，还要处理好表情、动作、场景转换和画格编排。ERNIE-Image 生成的结果更接近完整的动漫页面，而不是一张张零散的插画，很适合叙事类的视觉创作。"]}):c.jsxs(c.Fragment,{children:["ERNIE-Image handles ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:372:39",className:"text-baidu-dark",children:"anime-style and storyboard generation"})," well — the challenge here goes beyond drawing appealing characters to maintaining expressions, action clarity, scene transitions, and panel-level organization. Its outputs read more like actual manga pages than disconnected illustrations, making it a good fit for narrative visual content."]})})]}),c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:377:11",children:[c.jsx("h3",{"code-path":"src/sections/Showcases.tsx:378:13",className:"text-lg font-bold text-baidu-dark mb-1",children:y?"多格视觉表达":"Multi-panel Visual Expression"}),c.jsx("p",{"code-path":"src/sections/Showcases.tsx:379:13",className:"text-baidu-gray leading-relaxed",children:y?c.jsxs(c.Fragment,{children:["除了单张图片，ERNIE-Image 还能做",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:381:41",className:"text-baidu-dark",children:"多图组合和序列化表达"}),"——多格构图、表情包式图组、情绪连贯的组图等等。在需要节奏感、递进关系或重复视觉元素的场景下，这种跨格的一致性尤其有用。"]}):c.jsxs(c.Fragment,{children:["Beyond single images, ERNIE-Image can produce ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:383:65",className:"text-baidu-dark",children:"grouped and sequential visuals"})," — multi-panel compositions, meme-style image sets, and emotionally coherent grouped outputs. This cross-frame consistency is valuable when a task calls for pacing, progression, or repeated visual motifs rather than one isolated image."]})})]}),c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:388:11",children:[c.jsx("h3",{"code-path":"src/sections/Showcases.tsx:389:13",className:"text-lg font-bold text-baidu-dark mb-1",children:y?"多语言文字渲染":"Multilingual Text Rendering"}),c.jsx("p",{"code-path":"src/sections/Showcases.tsx:390:13",className:"text-baidu-gray leading-relaxed",children:y?c.jsxs(c.Fragment,{children:["ERNIE-Image 擅长在视觉复杂的图像中",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:392:42",className:"text-baidu-dark",children:"生成清晰、准确的多语言文字"}),"，",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:392:101",className:"text-baidu-dark",children:"中英文"}),"均可胜任——无论是密集段落、排版敏感的标题、标注文字、动漫对白还是海报文案。文字质量往往决定了一张图「看起来还行」和「真正能用」之间的差距，而这恰恰是 ERNIE-Image 最突出的能力之一。"]}):c.jsxs(c.Fragment,{children:["ERNIE-Image is especially good at ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:394:53",className:"text-baidu-dark",children:"rendering readable, faithful multilingual text"})," ","in visually complex images — both ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:394:183",className:"text-baidu-dark",children:"Chinese and English"}),", covering dense paragraphs, layout-sensitive titles, callout annotations, anime dialogue, and poster copy. In practice, text quality often decides whether an image is merely plausible or genuinely usable, which is what makes this one of the model's most consequential capabilities."]})})]}),c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:399:11",children:[c.jsx("h3",{"code-path":"src/sections/Showcases.tsx:400:13",className:"text-lg font-bold text-baidu-dark mb-1",children:y?"风格化与电影感美学":"Stylized and Film-like Aesthetics"}),c.jsx("p",{"code-path":"src/sections/Showcases.tsx:401:13",className:"text-baidu-gray leading-relaxed",children:y?c.jsxs(c.Fragment,{children:["除了干净的平面图形，ERNIE-Image 也擅长",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:403:44",className:"text-baidu-dark",children:"风格化的视觉表达"}),"——柔和的电影色调、胶片颗粒感、以情绪驱动的画面氛围。当下许多图像模型的输出趋于同质化的高饱和「AI 感」，ERNIE-Image 则覆盖了更宽的美学光谱，风格辨识度更高。"]}):c.jsxs(c.Fragment,{children:["Beyond clean graphic outputs, ERNIE-Image handles ",c.jsx("strong",{"code-path":"src/sections/Showcases.tsx:405:69",className:"text-baidu-dark",children:"distinctive stylized aesthetics"}),' well — softer cinematic tones, film-like grain, and mood-driven visual expression. Many strong image models converge toward a similar high-saturation "AI look"; ERNIE-Image covers a broader aesthetic range with more recognizable stylistic character.']})})]})]})}),u&&c.jsxs("div",{"code-path":"src/sections/Showcases.tsx:412:9",className:"fixed inset-0 z-50 flex items-center justify-center bg-black/95 cursor-pointer",onClick:()=>b(null),children:[c.jsx("button",{"code-path":"src/sections/Showcases.tsx:416:11",className:"absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20",onClick:()=>b(null),children:c.jsx(ss,{"code-path":"src/sectio