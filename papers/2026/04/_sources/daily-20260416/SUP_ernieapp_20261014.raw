,className:"mt-3 max-h-[24rem] overflow-y-auto pr-1",children:c.jsx("p",{"code-path":"src/sections/PEModel.tsx:426:19",className:"whitespace-pre-line text-sm leading-relaxed text-baidu-dark",children:g.prompt})})]})]})]})]})]})}const Ib=[{name:"ERNIE-Image",description:"Main model on HuggingFace",url:"https://huggingface.co/Baidu/ERNIE-Image",icon:rp,color:"bg-baidu-red"},{name:"ERNIE-Image-Turbo",description:"Fast 8-step distilled version",url:"https://huggingface.co/Baidu/ERNIE-Image-Turbo",icon:yp,color:"bg-baidu-blue"},{name:"Prompt Gallery",description:"Browse curated generation examples",url:"https://ernieimageprompt.com",icon:bp,color:"bg-green-600"}];function Zb(){const u=Z.useRef(null),[b,p]=Z.useState(!1),g=$a()==="zh";return Z.useEffect(()=>{const M=new IntersectionObserver(([z])=>{z.isIntersecting&&(p(!0),M.disconnect())},{threshold:.1});return u.current&&M.observe(u.current),()=>M.disconnect()},[]),c.jsxs("section",{"code-path":"src/sections/Conclusion.tsx:54:5",id:"conclusion",ref:u,className:"py-16 bg-white",children:[c.jsxs("div",{"code-path":"src/sections/Conclusion.tsx:59:7",className:"container mx-auto max-w-6xl px-6 lg:px-12",children:[c.jsxs("div",{"code-path":"src/sections/Conclusion.tsx:61:9",className:`mb-12 transition-all duration-700 ${b?"opacity-100 translate-y-0":"opacity-0 translate-y-8"}`,children:[c.jsx("h2",{"code-path":"src/sections/Conclusion.tsx:66:11",className:"text-3xl font-bold text-baidu-dark mb-6",children:g?"5. 结语":"5. Conclusion"}),c.jsx("p",{"code-path":"src/sections/Conclusion.tsx:67:11",className:"text-baidu-gray leading-relaxed",children:g?"ERNIE-Image 证明了一个紧凑的 8B 模型，完全可以在开源文生图领域做到顶尖水平，同时保持实际可用性。从本文的示例和评测来看，模型在文字渲染、复杂指令遵循、结构化视觉完整性和多样风格图像生成方面均表现突出，在海报、动漫、多格排版等对画面质量和可控性都有高要求的场景中尤为好用。我们希望开源的 ERNIE-Image 和 ERNIE-Image-Turbo 权重，能为研究、开发和创意应用提供一个扎实的起点。":"ERNIE-Image shows that a compact 8B model can rival much larger open weights text-to-image systems while staying practical for real-world use. Across the examples and benchmarks in this blog, the model demonstrates particular strengths in text rendering, complex instruction following, structured visual integrity, and stylistically diverse image generation. These capabilities matter most for high-value tasks like posters, anime, multi-panel layouts, and other scenarios where both visual quality and controllability count. We hope the released ERNIE-Image and ERNIE-Image-Turbo checkpoints serve as a useful open foundation for research, development, and creative applications."})]}),c.jsxs("div",{"code-path":"src/sections/Conclusion.tsx:76:9",className:`transition-all duration-700 delay-300 ${b?"opacity-100 translate-y-0":"opacity-0 translate-y-8"}`,children:[c.jsx("h3",{"code-path":"src/sections/Conclusion.tsx:81:11",className:"text-xl font-bold text-baidu-dark mb-6",children:g?"开始使用 ERNIE-Image":"Get Started with ERNIE-Image"}),c.jsx("div",{"code-path":"src/sections/Conclusion.tsx:85:11",className:"grid md:grid-cols-3 gap-4",children:Ib.map((M,z)=>c.jsx("a",{"code-path":"src/sections/Conclusion.tsx:87:15",href:M.url,target:"_blank",rel:"noopener noreferrer",className:`group p-5 bg-gray-50 rounded-xl border border-gray-100
