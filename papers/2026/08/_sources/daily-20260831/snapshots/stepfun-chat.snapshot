><script>self.__next_f.push([1,"6:[\"$\",\"$L28\",null,{\"blogPosts\":[{\"slug\":\"nextstep1\",\"title\":\"Meet NextStep-1: A New Leap in Autoregressive Image Generation\",\"description\":\"Check out our latest, most versatile and powerful autoregressive image generation model that rivals the state-of-the-art diffusion-based systems.\",\"date\":\"2025-08-15\",\"path\":\"/research/en/nextstep1\",\"img\":\"\"},{\"slug\":\"nextstep1\",\"title\":\"Meet NextStep-1: A New Leap in Autoregressive Image Generation\",\"description\":\"Check out our latest, most versatile and powerful autoregressive image generation model that rivals the state-of-the-art diffusion-based systems.\",\"date\":\"2025-08-15\",\"path\":\"/research/zh/nextstep1\",\"img\":\"\"},{\"slug\":\"stepfun-prover-preview\",\"title\":\"StepFun-Prover Preview: Let's Think and Verify Step by Step\",\"description\":\"StepFun-Prover Preview is a large language model designed for formal theorem proving through tool-integrated reasoning.\",\"date\":\"2025-08-13\",\"path\":\"/research/en/stepfun-prover-preview\",\"img\":\"\"},{\"slug\":\"stepfun-prover-preview\",\"title\":\"StepFun-Prover Preview: Let's Think and Verify Step by Step\",\"description\":\"StepFun-Prover Preview is a large language model designed for formal theorem proving through tool-integrated reasoning.\",\"date\":\"2025-08-13\",\"path\":\"/research/zh/stepfun-prover-preview\",\"img\":\"\"},{\"slug\":\"step3\",\"title\":\"Step3: Cost-Effective Multimodal Intelligence\",\"description\":\"Step3 is our cutting-edge multimodal reasoning model—built on a Mixture-of-Experts architecture with 321B total parameters and 38B active. It is designed end-to-end to minimize decoding costs while delivering top-tier performance in vision–language reasoning. Through the co-design of Multi-Matrix Factorization Attention (MFA) and Attention-FFN Disaggregation (AFD), Step3 maintains exceptional efficiency across both flagship and low-end accelerators.\",\"date\":\"2025-07-31\",\"path\":\"/research/en/step3\",\"img\":\"\"},{\"slug\":\"stepmesh\",\"title\":\"StepMesh: A Communication Library for Attention-FFN Disaggregation\",\"description\":\"This article delves into the technical details and design choices of StepMesh, sharing our insights and considerations regarding the communication requirements for AF Separation systems.\",\"date\":\"2025-07-31\",\"path\":\"/research/en/stepmesh\",\"img\":\"\"},{\"slug\":\"step3\",\"title\":\"Step3: Cost-Effective Multimodal Intelligence\",\"description\":\"Step3 is our cutting-edge multimodal reasoning model—built on a Mixture-of-Experts architecture with 321B total parameters and 38B active. It is designed end-to-end to minimize decoding costs while delivering top-tier performance in vision–language reasoning. Through the co-design of Multi-Matrix Factorization Attention (MFA) and Attention-FFN Disaggregation (AFD), Step3 maintains exceptional efficiency across both flagship and low-end accelerators.\",\"date\":\"2025-07-31\",\"path\":\"/research/zh/step3\",\"img\":\"\"},{\"slug\":\"stepmesh\",\"title\":\"StepMesh：面向 AF 分离系统的通信库\",\"description\":\"本文针对StepMesh详细展开一些技术细节和选型讨论，分享我们对AF分离系统在通信层面的需求思考和观察。\",\"date\":\"2025-07-31\",\"path\":\"/research/zh/stepmesh\",\"img\":\"\"},{\"slug\":\"step-audio2\",\"title\":\"Step-Audio 2: Breakthrough in End-to-End Speech Modeling Technology\",\"description\":\"Step-Audio 2 is an end-to-end multimodal large language model engineered for industrial applications. This model innovatively integrates a latent space audio encoder with audio reinforcement learning. It captures paralinguistic information and vocal style features while adopting a CoT-reinforcement learning optimization strategy. Step-Audio 2 delivers high-performance dialogue capabilities across diverse scenarios. Experimental results confirm state-of-the-art (SOTA) performance on multiple audio comprehension and dialogue benchmarks.\",\"date\":\"2025-07-24\",\"path\":\"/research/en/step-audio2\",\"img\":\"\"},{\"slug\":\"step-audio2\",\"title\":\"Step-Audio 2：端到端语音大模型技术阶跃式突破\",\"description\":\"Step-Audio 2是一款面向工业级应用的端到端多模态大语言模型。该模型创新性地结合了隐空间音频编码器和音频强化学习技术。模型能够有效捕捉副语言信息和说话风格特征，并采用思维链（COT）推理与强化学习相结合的优化策略，Step-Audio 2实现了跨场景的高表现力语音对话能力。实验结果表明，该模型在多个理解与对话任务上均达到了当前最先进（SOTA）水平。\",\"date\":\"2025-07-24\",\"path\":\"/research/zh/step-audio2\",\"img\":\"\"},{\"slug\":\"discrete-distribution-networks\",\"title\":\"Discrete Distribution Networks：A Novel Generative Model with Simple Principles and Unique Properties\",\"description\":\"Discrete Distribution Networks (DDN) is a novel generative model that adopts a simple yet fundamentally different approach to mainstream generative models for modeling target distributions.\",\"date\":\"2025-05-30\",\"path\":\"/research/en/discrete-distribution-networks\",\"img\":\"\"},{\"slug\":\"open-reasoner-zero\",\"title\":\"Open-Reasoner-Zero: An Open Source Approach to Scaling Up Reinforcement Learning on the Base Model\",\"description\":\"In this blog, we introduce Open-Reasoner-Zero, the first open source implementation of large-scale reasoning-oriented RL training on the base model focusing on scalability, simplicity and accessibility.\",\"date\":\"2025-05-30\",\"path\":\"/research/en/open-reasoner-zero\",\"img\":\"\"},{\"slug\":\"discrete-distribution-networks\",\"title\":\"Discrete Distribution Networks：A Novel Generative Model with Simple Principles and Unique Properties\",\"description\":\"Discrete Distribution Networks (DDN) is a novel generative model that adopts a simple yet fundamentally different approach to mainstream generative models for modeling target distributions.\",\"date\":\"2025-05-30\",\"path\":\"/research/zh/discrete-distribution-networks\",\"img\":\"\"},{\"slug\":\"open-reasoner-zero\",\"title\":\"Open-Reasoner-Zero: An Open Source Approach to Scaling Up Reinforcement Learning on the Base Model\",\"description\":\"In this blog, we introduce Open-Reasoner-Zero, the first open source implementation of large-scale reasoning-oriented RL training on the base model focusing on scalability, simplicity and accessibility.\",\"date\":\"2025-05-30\",\"path\":\"/research/zh/open-reasoner-zero\",\"img\":\"\"}]}]\n"])</script><script>self.__next_f.push([1,"b:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Research | 阶跃AI\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Welcome to StepFun Research, where StepFun shares its explorations and achievements in technology.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"阶跃AI，智能助手，AI，个人效率助手，知识获取，信息查询，语言学习，创意写作，代码编写，工作，学习，生活，解决问题，发现，理解，世界\"}],[\"$\",\"meta\",\"3\",{\"name\":\"mobile-web-app-capable\",\"content\":\"yes\"}],[\"$\",\"meta\",\"4\",{\"name\":\"apple-mobile-web-app-title\",\"content\":\"阶跃AI\"}],[\"$\",\"link\",\"5\",{\"href\":\"/img/pwd-icon.png\",\"media\":\"$undefined\",\"rel\":\"apple-touch-startup-image\"}],[\"$\",\"meta\",\"6\",{\"name\":\"apple-mobile-web-app-status-bar-style\",\"content\":\"default\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"阶跃AI\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"阶跃AI是一个聪明可靠的个人效率助手，可以帮你获取知识、查询信息、学习语言、创意写作、编写代码，在工作、学习、生活等各种场景下帮你解决问题。带你发现和理解世界~\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:url\",\"content\":\"https://chat.stepfun.com\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"阶跃AI\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image\",\"content\":\"https://chat.stepfun.com/img/opengraph-image.png\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"阶跃AI\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"阶跃AI是一个聪明可靠的个人效率助手，可以帮你获取