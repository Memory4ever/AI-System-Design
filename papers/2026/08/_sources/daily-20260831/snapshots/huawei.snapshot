"/scientific_research",[],"688bfdb4-cd26-4b4f-babf-479b33ee09f0",{"type":15,"value":30,"id":35},{"name":31,"name_en":32,"link":33,"items":34},"最新资讯","NEWS","/news",[],"16c7b1f9-39d8-43f0-923f-f4b2f65b0493",{"type":15,"value":37,"id":42},{"name":38,"name_en":39,"link":40,"items":41},"关于我们","ABOUT","/about",[],"814a160a-742d-44d4-a678-5cc0f578ee63",{"type":15,"value":44,"id":49},{"name":45,"name_en":46,"link":47,"items":48},"加入我们","RECRUITMENT","/recruitment",[],"c7c5b06c-5286-47a5-ad98-d075854d9f22",[51,74,99],{"type":52,"value":53,"id":73},"footer_link",{"name":54,"name_en":55,"items":56},"关于华为","About Huawei",[57,61,65,69],{"name":58,"name_en":59,"link":60},"华为官网","Huawei official website","https://www.huawei.com/",{"name":62,"name_en":63,"link":64},"公司简介","Company Profile","https://www.huawei.com/cn/corporate-information",{"name":66,"name_en":67,"link":68},"华为开源","Huawei Open Source","https://www.huawei.com/cn/open-source",{"name":70,"name_en":71,"link":72},"创新与知识产权","Innovation and Intellectual Property","https://www.huawei.com/cn/ipr","f8416c12-414e-4e8c-b84a-316102b0c402",{"type":52,"value":75,"id":98},{"name":45,"name_en":76,"items":77},"Join us",[78,82,86,90,94],{"name":79,"name_en":80,"link":81},"招聘网站","Recruitment website","https://career.huawei.com/reccampportal/portal5/index.html",{"name":83,"name_en":84,"link":85},"天才少年","topminds","https://career.huawei.com/reccampportal/portal5/topminds.html",{"name":87,"name_en":88,"link":89},"校园招聘","Campus Recruitment","https://career.huawei.com/reccampportal/portal5/campus-recruitment.html",{"name":91,"name_en":92,"link":93},"社会招聘","Social Recruitment","https://career.huawei.com/reccampportal/portal5/social-recruitment.html",{"name":95,"name_en":96,"link":97},"博士后","Postdoctoral Fellow","https://career.huawei.com/reccampportal/portal5/postdoc.html","96c6b0d8-3ca6-45f7-a667-e3e3b33075a6",{"type":52,"value":100,"id":108},{"name":101,"name_en":102,"items":103},"合作生态","Collaborative Ecosystem",[104],{"name":105,"name_en":106,"link":107},"黄大年茶思屋","Huang Danian Tea House","https://www.chaspark.com/#/home","824de8f8-ad4a-4e2b-8376-ff2ce537ca43",[110,121],{"type":111,"value":112,"id":120},"wechat_content",{"name":113,"name_en":113,"qrcode_img":114},"Noah_ark_lab",{"url":115,"full_url":116,"width":117,"height":117,"alt":118,"is_dark":119},"/backend_static/media/images/NuoYaGongZhongHaoErWeiMa.original.format-webp.webp","http://example.com/backend_static/media/images/NuoYaGongZhongHaoErWeiMa.original.format-webp.webp",258,"诺亚公众号二维码",false,"95fbeeeb-b367-4873-a8aa-074b9d04bfde",{"type":122,"value":123,"id":125},"email_content",{"name":124,"name_en":124,"email":124},"noahlab1@huawei.com","ae78c99d-8d24-4ec0-9fda-ac14de31840b",{"url":115,"full_url":116,"width":117,"height":117,"alt":118},"\u003Cdiv>\r\n\u003Cspan>版权所有 © 华为技术有限公司 1998-2026。保留一切权利。\u003C/span>\r\n\u003Cspan style=\"margin: 0 10px;\">|\u003C/span>\r\n\u003Ca target=\"_blank\" href=\"/news/7\">法律声明\u003C/a>\r\n\u003C/div>","\u003Cdiv>\r\n\u003Cspan>Copyright © Huawei Technologies Co., Ltd. 1998-2026. All rights reserved. \u003C/span>\r\n\u003Cspan style=\"margin: 0 10px;\">|\u003C/span>\r\n\u003Ca target=\"_blank\" href=\"/en/news/116\">Legal Notice\u003C/a>\r\n\u003C/div>","Huawei Noah's Ark Lab - Building An Intelligent World","Huawei Noah's Ark Lab - Building An Intelligent World. Bring digital to every person, home and organization for a fully connected, intelligent world.",{"meta":132,"items":133},{"total_count":6},[134],{"id":135,"meta":136,"title":17,"banner":144,"information":157,"research":223,"paper_layout":295,"recruitment":323},3,{"type":137,"detail_url":138,"html_url":139,"slug":17,"show_in_menus":119,"seo_title":140,"search_description":141,"first_published_at":142,"alias_of":139,"locale":143},"home.HomePage","http://www.noahlab.com.hk/wt_app/api/v2/pages/3/",null,"华为诺亚方舟实验室官网 - Huawei Noah's Ark Lab","","2026-02-09T17:14:24.591000+08:00","zh-hans",[145],{"type":146,"value":147,"id":156},"banner",{"description":148,"link_name":149,"link_url":40,"image":150},"把数字世界带入每个人、每个家庭、每个组织，构建万物互联的智能世界","了解我们",{"url":151,"full_url":152,"width":153,"height":154,"alt":155,"is_dark":119},"/backend_static/media/images/banner_12x_wIUonP0.original.format-webp.webp","http://example.com/backend_static/media/images/banner_12x_wIUonP0.original.format-webp.webp",5120,1200,"banner_1@2x","45e2020c-2b10-4e19-94b1-71ae92e8ee8c",[158,172,186,200,211],{"type":159,"value":160,"id":171},"information",{"title":161,"description":162,"type":163,"link_url":164,"image":139,"big_image":165},"让AI自主推进一项研究：华为诺亚方舟实验室发布ScienceFlow！","给出一套清晰的固定流程，Agent执行起来并不难，可一旦涉及“回头探索与自主纠偏”，Agent往往就卡住了——而这，恰恰是它难以自主推进一项研究的关键瓶颈。科学研究从来不是一条从起点直达终点的直线。\r\nScienceFlow的思路，是让研究形成一个能自我运转的闭环：“执行—验证—保存—转向”。它给 Agent 配备了一个随时可存档、可回滚的科研工作区。Agent不再只是死板地单向往前冲，而是能根据验证结果自主决策：是继续深入，还是退回某个历史步骤、重新换条路走。","技术发布","https://www.noahlab.com.hk/news/212",{"url":166,"full_url":167,"width":168,"height":169,"alt":170,"is_dark":119},"/backend_static/media/images/a_12x_hJOVFjo.original.format-webp.webp","http://example.com/backend_static/media/images/a_12x_hJOVFjo.original.format-webp.webp",2120,868,"a_1@2x","eab190a5-4d54-48d4-a360-79eceb1eb714",{"type":159,"value":173,"id":185},{"title":174,"description":175,"type":176,"link_url":177,"image":178,"big_image":139},"华为发布业界首个扩散语言模型Agent，部分场景提速8倍！","扩散大语言模型（DLLMs）作为自回归（AR）解码的高效替代方案，其对智能体多步决策的影响尚未充分探索。核心问题：生成范式改变而框架与监督不变时，扩散主干是否会改变规划、工具使用行为并提升端到端效率？\r\n实验显示，相同工作流与微调条件下，DLLM智能体精度与AR相当，但速度快30%以上（部分场景超8倍），交互轮次和工具调用更少，规划命中率更高、回溯更少。","项目发布","https://mp.weixin.qq.com/s/keYKEu91oUiVuW9cXqXABA",{"url":179,"full_url":180,"width":181,"height":182,"alt":183,"is_dark":184},"/backend_static/media/images/102x.original.format-webp.webp","http://example.com/backend_static/media/images/102x.original.format-webp.webp",640,408,"10@2x",true,"8da1b244-2318-4899-9c6b-82954c21fdaa",{"type":159,"value":187,"id":199},{"title":188,"description":189,"type":190,"link_url":191,"image":192,"big_image":198},"大模型驱动的MIP求解器智能调优新范式","近日，华为诺亚方舟实验室与香港中文大学（深圳）数据科学学院于天舒老师团队在混合整数规划（MIP）求解器自动调优方向取得重要成果。该研究提出了一种基于大模型推理能力的求解器实例化自动调优方法GRIMIP，在权威MIP榜单测试中，该方法达到了SOTA级性能。在已完成的华为云天筹AI求解器内部适配验证中，该方法调优得到的参数配置相较默认参数提速39.4%，相较当前内部求解器调优工具生成的参数配置进一步提速16.67%。目前，该能力已被纳入下一代天筹调优工具特性规划。","论文发表","https://www.noahlab.com.hk/news/210",{"url":193,"full_url":194,"width":195,"height":196,"alt":197,"is_dark":119},"/backend_static/media/images/ScreenShot_20260627170554.original.format-webp.webp","http://example.com/backend_static/media/images/ScreenShot_20260627170554.original.format-webp.webp",489,252,"ScreenShot_20260627170554",{"url":193,"full_url":194,"width":195,"height":196,"alt":197,"is_dark":119},"e191a8fb-94f4-46a5-b475-dfb4d72f6119",{"type":159,"value":201,"id":210},{"title":202,"description":203,"type":190,"link_url":204,"image":205,"big_image":139},"把大模型装进口袋：PocketLLM提出元网络压缩范式，实现10+倍极限无损压缩","大语言模型参数量已达千亿级，如何在保持性能的前提下部署到手机等端侧设备，成为 AI 落地关键。传统量化剪枝在 4-bit 后易出现精度崩塌。AAAI 2026 论文《PocketLLM》提出基于元网络的极限压缩方法，通过离散隐空间重构权重，实现 10–16 倍压缩且性能几乎无损。","https://mp.weixin.qq.com/s/zVtGa-X7lJSmgBVcboJuaw",{"url":206,"full_url":207,"width":208,"height":169,"alt":209,"is_dark":119},"/backend_static/media/images/xin_22x.original.format-webp.webp","http://example.com/backend_static/media/images/xin_22x.original.format-webp.webp",1040,"xin_22x","373c49cf-200c-4def-81c1-34ec5218baa2",{"type":159,"value":212,"id":222},{"title":213,"description":214,"type":190,"link_url":215,"image":216,"big_image":139},"轻如螳螂，稳如磐石：Mantis实现轻量又可靠的时序分类基础模型","针对时序分类领域基础模型不足的问题，我们提出基于 ViT 架构的时序分类基础模型 Mantis。该模型采用对比学习预训练，结合轻量化适配器，高效建模跨通道依赖。实验表明，Mantis 在多个基准上零样本性能优异，平均精度超现有 SOTA 模型 1.5% 以上。","https://mp.weixin.qq.com/s/5xT8OIoo_A8QHBwVshZIJg",{"url":217,"full_url":218,"width":219,"height":220,"alt":221,"is_dark":119},"/backend_static/media/images/TuPian10.original.format-webp.webp","http://example.com/backend_static/media/images/TuPian10.original.format-webp.webp",385,402,"图片10","fd511d54-9ba2-4bf7-8fb0-6afb97e04843",[224,237,247,256,265,274,286],{"type":225,"value":226,"id":236},"research",{"title":227,"description":228,"link_url":229,"image":230},"模型架构及优化","构建下一代通用人工智能的基石模型结构和优化算法体系，推动AI到AGI的范式跃迁。",5,{"url":231,"full_url":232,"width":233,"height":234,"alt":235,"is_dark":119},"/backend_static/media/images/0012x.original.format-webp.webp","http://example.com/backend_static/media/images/0012x.original.format-webp.webp",772,1400,"001@2x","25a5e873-c537-4390-a42d-24db975da411",{"type":225,"value":238,"id":246},{"title":239,"description":240,"link_url":241,"image":242},"时序AI","深耕时序分析前沿技术领域，以“用时序智能赋能产业升级”为使命，构建全域时序智能分析生态。",13,{"url":243,"full_url":244,"width":233,"height":245,"alt":239,"is_dark":119},"/backend_static/media/images/2.original.format-webp.webp","http://example.com/backend_static/media/images/2.original.format-webp.webp",1332,"34c3daac-6f8d-4c1d-9b62-152101e5c7f6",{"type":225,"value":248,"id":255},{"title":249,"description":250,"link_url":251,"image":252},"优化智能","致力于在复杂产业及行业场景下实现AI使能的优化决策，推动工业设计范式从“单点优化”向“全局智能决策”跨越，构建数据驱动、自主演进的设计闭环。我们将持续跟进基于AI/LLM的前沿学习研究，深入探索建模求解一体化、长链协同优化、自动算法设计等核心技术，着力破解当前芯片设计EDA与AI求解器在设计空间探索、组合优化、图计算等关键领域中的难题，系统构建面向未来的核心技术竞争力。",14,{"url":253,"full_url":254,"width":233,"height":245,"alt":249,"is_dark":119},"/backend_static/media/images/3.original.format-webp.webp","http://example.com/backend_static/media/images/3.original.format-webp.webp","c2a88016-93ac-46c2-b1bc-39f3488b3286",{"type":225,"value":257,"id":264},{"title":258,"description":259,"link_url":260,"image":261},"行业智能","聚焦行业智能核心技术，以“重塑行业范式，定义智能生产力”为使命，聚焦于深度融合学习优化、大模型及Agent 等前沿技术，构建“感知-决策-执行”一体化的行业大脑。通过技术深挖金融、交通、医疗、煤矿等领域的沉淀价值，攻克复杂场景下的生产质量及效率瓶颈，致力于把AI从“实验室精品”升级为“工业标品”。",15,{"url":262,"full_url":263,"width":233,"height":245,"alt":258,"is_dark":119},"/backend_static/media/images/4.original.format-webp.webp","http://example.com/backend_static/media/images/4.original.format-webp.webp","11557b06-9054-4a8f-abf7-da4c7ebf805b",{"type":225,"value":266,"id":273},{"title":267,"description":268,"link_url":269,"image":270},"终端智能","致力于打造全场景智能终端系统，以高能效AI计算成像、多传感模态表征生成技术为核心，提升终端设备的感知能力与交互体验。",16,{"url":271,"full_url":272,"width":233,"height":245,"alt":267,"is_dark":119},"/backend_static/media/images/6.original.format-webp.webp","http://example.com/backend_static/media/images/6.original.format-webp.webp","fb045fc9-a389-4c35-abc9-a61d9d1f5de6",{"type":225,"value":275,"id":285},{"title":276,"description":277,"link_url":278,"image":279},"智感融合","致力于构建融合多模态感知能力的科学发现智能体系统，以“多元感知融合赋能认知升级，加速自主科学探索范式革新”为使命。",17,{"url":280,"full_url":281,"width":282,"height":283,"alt":284,"is_dark":119},"/backend_static/media/images/ScreenShot_20260131160303.original.format-webp.webp","http://example.com/backend_static/media/images/ScreenShot_20260131160303.original.format-webp.webp",380,693,"ScreenShot_20260131160303","272d70f7-3e94-42f8-a60d-65abab8a4aae",{"type":225,"value":287,"id":294},{"title":288,"description":289,"link_url":290,"image":291},"物理智能","团队致力于攻克AI从\"虚拟世界\"走向\"物理实体\"的核心瓶颈，以赋予机器类人的感知、决策与行动能力为使命，聚焦三大核心愿景：打造实现高层逻辑推理与底层毫秒级精细动作无缝协同的高灵巧、高可靠物理规划及策略模型；构建打破传统预设规则、能够理解并预测物理规律、实现复杂动态环境中自主进化的物理常识\"世界模型\"；以及推动以产业场景为牵引、持续打磨\"能部署、能迭代、能演化\"的物理智能技术体系，加速技术从实验室走向真实世界的通用物理智能产业闭环。",18,{"url":292,"full_url":293,"width":233,"height":245,"alt":288,"is_dark":119},"/backend_static/media/images/7.original.format-webp.webp","http://example.com/backend_static/media/images/7.original.format-webp.webp","95bc5a3e-6022-48d8-9198-637a6a459d8b",[296,312],{"type":297,"value":298,"id":311},"paper_layout",{"link":299,"title":300,"description":301,"thumb_image":302,"meeting":308,"tags":309},"https://arxiv.org/abs/2508.02583","把“数学因果关系”教给大模型，让它更会解难题","为弥补 LLM 在复杂数学推理上的不足，提出因果知识增强的两阶段框架 CAMA。第一阶段从数学 CoT 语料抽取知识点，预训练并结合下游反馈微调数学因果图 MCG；第二阶段针对新问题匹配 MCG 知识子图，指导 LLM 推理求解。该框架在多项竞赛数据集上，有效提升了主流大模型的数学推理能力。",{"url":303,"full_url":304,"width":305,"height":306,"alt":307,"is_dark":119},"/backend_static/media/images/ScreenShot_20260131160031.original.format-webp.webp","http://example.com/backend_static/media/images/ScreenShot_20260131160031.original.format-webp.webp",506,422,"ScreenShot_20260131160031","AAAI 2026",[310],"因果AI","71f3b17a-f259-4fcd-885c-ea1e5852cad8",{"type":297,"value":313,"id":322},{"link":314,"title":202,"description":315,"thumb_image":316,"meeting":308,"tags":320},"https://arxiv.org/abs/2511.17637","大语言模型参数量迈入千亿级后，在手机、端侧等资源受限设备的部署成为 AI 落地核心难题，传统量化、剪枝技术突破 4-bit 阈值易出现严重精度崩塌。AAAI 2026 入选论文《PocketLLM》提出元网络基极限压缩方案，通过在离散隐空间重构权重，在 10-16 倍压缩比下，实现了模型性能几乎无损的效果，为端侧部署提供了新解法。",{"url":317,"full_url":318,"width":208,"height":169,"alt":319,"is_dark":119},"/backend_static/media/images/xin_52x.original.format-webp.webp","http://example.com/backend_static/media/images/xin_52x.original.format-webp.webp","xin_52x",[321],"AI模型架构","8dcb4c64-f8ca-473f-a449-b138df47da50",[324],{"type":325,"value":326,"id":342},"recruitment",{"title":327,"description":328,"link_name":329,"link_url":47,"bg_image":330,"image":336},"加入我们，一起了解诺亚最新动态","加入我们，与一流的科学家、工程师用技术创造更美好的世界！","了解详情",{"url":331,"full_url":332,"width":333,"height":334,"alt":335,"is_dark":119},"/backend_static/media/images/BeiJing2x.original.format-webp.webp","http://example.com/backend_static/media/images/BeiJing2x.original.format-webp.webp",3840,1100,"背景@2x",{"url":337,"full_url":338,"width":339,"height":340,"alt":341,"is_dark":119},"/backend_static/media/images/MengBan2x.original.format-webp.webp","http://example.com/backend_static/media/images/MengBan2x.original.format-webp.webp",1552,800,"蒙版@2x","668cdb1a-5830-4e15-9ca5-1fc1574b2bc7",["Reactive",344],{"$si18n:cached-locale-configs":345,"$si18n:resolved-locale":141,"$sdevice":350,"$stoasts":351},{"zh-CN":346,"en":348},{"fallbacks":347,"cacheable":184},[],{"fallbacks":349,"cacheable":184},[],{"isMobile":119},[],["Set"],["ShallowReactive",354],{"$f1nYBj0cKvyIZzFJiW7MfQ73UmxHt_ZiWh_aUsr9RMyg":-1,"$fifoImc3lESUteAx05maS9Hx7bAiWeukkPwDaZj7IrrQ":-1}]</script></body></html>