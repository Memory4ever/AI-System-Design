<script>window._ROUTER_DATA = {"loaderData":{"layout":{"footer_config":[{"titleZh":"模型成果","titleEn":"Models","content":[{"labelZh":"Seed2.1","labelEn":"Seed2.1","linkZh":"\u002Fzh\u002Fseed2_1","linkEn":"\u002Fen\u002Fseed2_1"},{"labelZh":"Seedance 2.5","labelEn":"Seedance 2.5","linkZh":"\u002Fzh\u002Fseedance2_5","linkEn":"\u002Fen\u002Fseedance2_5"},{"labelZh":"Seedream 5.0 Pro","labelEn":"Seedream 5.0 Pro","linkZh":"\u002Fzh\u002Fseedream5_0_pro","linkEn":"\u002Fen\u002Fseedream5_0_pro"},{"labelZh":"SeedRealtime","labelEn":"SeedRealtime","linkZh":"\u002Fzh\u002FSeedRealtime","linkEn":"\u002Fen\u002FSeedRealtime"},{"labelZh":"Seed Audio 1.0","labelEn":"Seed Audio 1.0","linkZh":"\u002Fzh\u002Fseedaudio1_0","linkEn":"\u002Fen\u002Fseedaudio1_0"},{"labelZh":"Seed GR-RL","labelEn":"Seed GR-RL","linkZh":"\u002Fzh\u002Fgr_rl","linkEn":"\u002Fen\u002Fgr_rl"}]},{"titleZh":"研究团队","titleEn":"Teams","content":[{"labelZh":"LLM","labelEn":"LLM","linkZh":"\u002Fzh\u002Fdirection\u002Fllm","linkEn":"\u002Fen\u002Fdirection\u002Fllm"},{"labelZh":"Infrastructures","labelEn":"Infrastructures","linkZh":"\u002Fzh\u002Fdirection\u002Finfrastructures","linkEn":"\u002Fen\u002Fdirection\u002Finfrastructures"},{"labelZh":"Vision","labelEn":"Vision","linkZh":"\u002Fzh\u002Fdirection\u002Fvision","linkEn":"\u002Fen\u002Fdirection\u002Fvision"},{"labelZh":"Speech","labelEn":"Speech","linkZh":"\u002Fzh\u002Fdirection\u002Fspeech","linkEn":"\u002Fen\u002Fdirection\u002Fspeech"},{"labelZh":"Multimodal Interaction\n& World Model","labelEn":"Multimodal Interaction\n& World Model","linkZh":"\u002Fzh\u002Fdirection\u002Fmultimodal","linkEn":"\u002Fen\u002Fdirection\u002Fmultimodal"},{"labelZh":"AI for Science","labelEn":"AI for Science","linkZh":"\u002Fzh\u002Fdirection\u002Fai_for_science","linkEn":"\u002Fen\u002Fdirection\u002Fai_for_science"},{"labelZh":"Robotics","labelEn":"Robotics","linkZh":"\u002Fzh\u002Fdirection\u002Frobotics","linkEn":"\u002Fen\u002Fdirection\u002Frobotics"},{"labelZh":"Responsible AI","labelEn":"Responsible AI","linkZh":"\u002Fzh\u002Fdirection\u002Fresponsible_ai","linkEn":"\u002Fen\u002Fdirection\u002Fresponsible_ai"}]},{"titleEn":"Learn More","titleZh":"了解更多","content":[{"labelZh":"博客","labelEn":"Blog","linkZh":"\u002Fzh\u002Fblog","linkEn":"\u002Fen\u002Fblog"},{"labelZh":"Seed Edge","labelEn":"Seed Edge","linkZh":"\u002Fzh\u002Fseed-edge","linkEn":"\u002Fen\u002Fseed-edge"},{"labelZh":"Seed STEM 科学家计划","labelEn":"Seed STEM Fellows Program","linkZh":"\u002Fzh\u002Fseedstem","linkEn":"\u002Fen\u002Fseedstem"},{"labelZh":"校园招聘","labelEn":"Seed Campus Recruitment","linkZh":"\u002Fzh\u002Fseedearlycareer","linkEn":"\u002Fen\u002Fseedearlycareer"}]}]},"(locale$)\u002Flayout":null,"(locale$)\u002Fpage":{"publication":[{"ArticleMeta":{"ID":300,"ArticleID":300,"ArticleType":1,"Author":"Seed Speech Team","Status":2,"PublishDate":1753286400000,"ResearchArea":[{"ResearchAreaID":6,"ResearchAreaName":"Speech&Audio","ResearchAreaNameZh":""}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fpdf\u002F2507.17527"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F3bnsnmdgr4uos.mp4"}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1775098256000,"IsPinned":true,"ContentType":0,"PinTab":[1,8],"WorkingTeam":[{"ID":264,"Name":"Speech","NameZh":"Speech"}],"IsTrending":false,"IsTeamSelect":false,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"Seed LiveInterpret 2.0: End-to-end Simultaneous Speech-to-speech Translation with Your Voice","Abstract":"Simultaneous Interpretation (SI) represents one of the most daunting frontiers in the translation industry, with product-level automatic systems long plagued by intractable challenges: subpar transcription and translation quality, lack of real-time speech generation, multi-speaker confusion, and translated speech inflation, especially in long-form discourses. In this study, we introduce Seed-LiveInterpret 2.0, an end-to-end SI model that delivers high-fidelity, ultra-low-latency speech-to-speech generation with voice cloning capabilities. As a fully operational product-level solution, Seed-LiveInterpret 2.0 tackles these challenges head-on through our novel duplex speech-to-speech understanding-generating framework. Experimental results demonstrate that through large-scale pretraining and reinforcement learning, the model achieves a significantly better balance between translation accuracy and latency, validated by human interpreters to exceed 70% correctness in complex scenarios. Notably, Seed-LiveInterpret 2.0 outperforms commercial SI solutions by significant margins in translation quality, while slashing the average latency of cloned speech from nearly 10 seconds to a near-real-time 3 seconds, which is around a near 70% reduction that drastically enhances practical usability.","TitleKey":"seed-liveinterpret-2-0-end-to-end-simultaneous-speech-to-speech-translation-with-your-voice","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F4og2ymgrg3b0f.png","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":297,"ArticleID":297,"ArticleType":1,"Author":"Seed Robotics Team","Status":2,"PublishDate":1753027200000,"ResearchArea":[{"ResearchAreaID":7,"ResearchAreaName":"Robotics","ResearchAreaNameZh":""}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fpdf\u002F2507.15493"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":""}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1775098256000,"IsPinned":true,"ContentType":0,"PinTab":[1,10],"WorkingTeam":[{"ID":268,"Name":"Robotics","NameZh":"Robotics"}],"IsTrending":false,"IsTeamSelect":true,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"GR-3 Technical Report","Abstract":"We report our recent progress towards building generalist robot policies, the development of GR-3. GR-3 is a large-scale vision-language-action (VLA) model. It showcases exceptional capabilities in generalizing to novel objects, environments, and instructions involving abstract concepts. Furthermore, it can be efficiently fine-tuned with minimal human trajectory data, enabling rapid and cost-effective adaptation to new settings. GR-3 also excels in handling long-horizon and dexterous tasks, including those requiring bi-manual manipulation and mobile movement, showcasing robust and reliable performance. These capabilities are achieved through a multi-faceted training recipe that includes co-training with web-scale vision-language data, efficient fine-tuning from human trajectory data collected via VR devices, and effective imitation learning with robot trajectory data. In addition, we introduce ByteMini, a versatile bi-manual mobile robot designed with exceptional flexibility and reliability, capable of accomplishing a wide range of tasks when integrated with GR-3. Through extensive real-world experiments, we show GR-3 surpasses the state-of-the-art baseline method, π0, on a wide variety of challenging tasks. We hope GR-3 can serve as a step towards building generalist robots capable of assisting humans in daily life.","TitleKey":"gr-3-technical-report","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":258,"ArticleID":258,"ArticleType":1,"Author":"Seed Vision Team","Status":2,"PublishDate":1749611286000,"ResearchArea":[{"ResearchAreaID":4,"ResearchAreaName":"Computer Vision","ResearchAreaNameZh":""}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fpdf\u002F2506.09113"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F3bnsnmbrd8otl.mp4"}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1776951842000,"IsPinned":true,"ContentType":0,"PinTab":[1,7],"WorkingTeam":[{"ID":263,"Name":"Vision","NameZh":"Vision"}],"IsTrending":false,"IsTeamSelect":false,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"Seedance 1.0: Exploring the Boundaries of Video Generation Models","Abstract":"Notable advances in diffusion modeling have propelled rapid improvements in video generation, yet current foundational model still confront critical challenges in synergistically balancing prompt following, motion plausibility, and visual quality. In this report, we introduce Seedance 1.0, a high-performance and inference-efficient video foundation generation model that integrates several core technical improvements: (i) multi-source data curation augmented with precision and meaningful video captioning, enabling comprehensive learning across diverse scenarios; (ii) an efficient pre-training paradigm that enables multiple features or functions such as interleaved multimodal positional encoding, native multi-shot generation capacity, and multi-task modeling; (iii) carefully-designed post-training optimization leveraging fine-grained supervised fine-tuning, video-specific RLHF with multi-dimensional reward mechanisms for considerable performance improvements; (iv) excellent model acceleration achieving 10× inference speedup through multi- stage distillation strategies and system-level optimizations. Seedance 1.0 can generate a 5-second video at 1080p resolution only with 41.4 seconds. Compared to state-of-the-art video generation models, Seedance 1.0 stands out with high-quality and fast video generation with superior spatiotemporal fluidity with structural stability, precise instruction adherence in complex multi-subject contexts, native multi-shot narrative coherence with consistent subject representation, and ultra-fast inference.","TitleKey":"seedance-1-0-exploring-the-boundaries-of-video-generation-models","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F4og2ymgrg2m4v.png","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":257,"ArticleID":257,"ArticleType":1,"Author":"Peng Wang, Yichun Shi, Xiaochen Lian, Zhonghua Zhai, Xin Xia, Xuefeng Xiao, Weilin Huang, Jianchao Yang","Status":2,"PublishDate":1749052800000,"ResearchArea":[{"ResearchAreaID":4,"ResearchAreaName":"Computer Vision","ResearchAreaNameZh":""}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fabs\u002F2506.05083"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":""}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1776951842000,"IsPinned":true,"ContentType":0,"PinTab":[1,7],"WorkingTeam":[{"ID":263,"Name":"Vision","NameZh":"Vision"}],"IsTrending":false,"IsTeamSelect":false,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"SeedEdit 3.0: Fast and High-Quality Generative Image Editing","Abstract":"We introduce SeedEdit 3.0, in companion with our T2I model Seedream 3.0, which significantly improves over our previous SeedEdit versions in both aspects of edit instruction following and image content (e.g., ID\u002FIP) preservation on real image inputs. Additional to model upgrading with T2I, in this report, we present several key improvements. First, we develop an enhanced data curation pipeline with a meta-info paradigm and meta-info embedding strategy that help mix images from multiple data sources. This allows us to scale editing data effectively, and meta information is helpfult to connect VLM with diffusion model more closely. Second, we introduce a joint learning pipeline for computing a diffusion loss and reward losses. Finally, we evaluate SeedEdit 3.0 on our testing benchmarks, for real\u002Fsynthetic image editing, where it achieves a best trade-off between multiple aspects, yielding a high usability rate of 56.1%, compared to SeedEdit 1.6 (38.4%), GPT4o (37.1%) and Gemini 2.0 (30.3%).","TitleKey":"seededit-3-0-fast-and-high-quality-generative-image-editing","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F4og2ymgrg1ybu.png","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":240,"ArticleID":240,"ArticleType":1,"Author":"Yunshui Li, Yiyuan Ma, Shen Yan, Chaoyi Zhang, Jing Liu, Jianqiao Lu, Ziwen Xu, Mengzhao Chen, Minrui Wang, Shiyi Zhan, Jin Ma, Xunhao Lai, Deyi Liu, Yao Luo, Xingyan Bin, Hongbin Ren, Mingji Han, Wenhao Hao, Bairen Yi, LingJun Liu, Bole Ma, Xiaoying Jia, Xun Zhou, Siyuan Qiao, Liang Xiang, Yonghui Wu","Status":2,"PublishDate":1747411200000,"ResearchArea":[{"ResearchAreaID":50,"ResearchAreaName":"LLM","ResearchAreaNameZh":"LLM"}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fabs\u002F2505.12082"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":""}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1775098256000,"IsPinned":true,"ContentType":0,"PinTab":[1,5],"WorkingTeam":[{"ID":262,"Name":"LLM","NameZh":"LLM"}],"IsTrending":true,"IsTeamSelect":true,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"Model Merging in Pre-training of Large Language Models","Abstract":"Model merging has emerged as a promising technique for enhancing large language models, though its application in large-scale pre-training remains relatively unexplored. In this paper, we present a comprehensive investigation of model merging techniques during the pre-training process. Through extensive experiments with both dense and Mixture-of-Experts (MoE) architectures ranging from millions to over 100 billion parameters, we demonstrate that merging checkpoints trained with constant learning rates not only achieves significant performance improvements but also enables accurate prediction of annealing behavior. These improvements lead to both more efficient model development and significantly lower training costs. Our detailed ablation studies on merging strategies and hyperparameters provide new insights into the underlying mechanisms while uncovering novel applications. Through comprehensive experimental analysis, we offer the open-source community practical pre-training guidelines for effective model merging.","TitleKey":"model-merging-in-pre-training-of-large-language-models","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F4og2ymb9di71p.png","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":236,"ArticleID":236,"ArticleType":1,"Author":"Seed Multimodal Team","Status":2,"PublishDate":1747065600000,"ResearchArea":[{"ResearchAreaID":50,"ResearchAreaName":"LLM","ResearchAreaNameZh":"LLM"}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fabs\u002F2505.07062"},{"ExternalLinkType":2,"Link":""},{"ExternalLinkType":3,"Link":""},{"ExternalLinkType":4,"Link":""}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1776951478000,"IsPinned":true,"ContentType":0,"PinTab":[1,9],"WorkingTeam":[{"ID":265,"Name":"Multimodal","NameZh":"Multimodal"}],"IsTrending":true,"IsTeamSelect":true,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"Seed1.5-VL Technical Report","Abstract":"We present Seed1.5-VL, a vision-language foundation model designed to advance general-purpose multimodal understanding and reasoning. Seed1.5-VL is composed with a 532M-parameter vision encoder and a Mixture-of-Experts (MoE) LLM of 20B active parameters. Despite its relatively compact architecture, it delivers strong performance across a wide spectrum of public VLM benchmarks and internal evaluation suites, achieving the state-of-the-art performance on 38 out of 60 public benchmarks. Moreover, in agent-centric tasks such as GUI control and gameplay, Seed1.5-VL outperforms leading multimodal systems, including OpenAI CUA and Claude 3.7. Beyond visual and video understanding, it also demonstrates strong reasoning abilities, making it particularly effective for multimodal reasoning challenges such as visual puzzles. We believe these capabilities will empower broader applications across diverse tasks. In this report, we mainly provide a comprehensive review of our experiences in building Seed1.5-VL across model design, data construction, and training at various stages, hoping that this report can inspire further research. Seed1.5-VL is now accessible at this https URL (Volcano Engine Model ID: doubao-1-5-thinking-vision-pro-250428)","TitleKey":"seed1-5-vl-technical-report","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Flapzild-tss\u002FljhwZthlaukjlkulzlp\u002Fuser-upload\u002F4og2ymb4wy0pm.png","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}},{"ArticleMeta":{"ID":710,"ArticleID":1764067591629,"ArticleType":1,"Author":"Xiang Li, Yixiao Chen, Bohao Li, Haoxiang Chen, Fengcheng Wu, Ji Chen, Weiluo Ren","Status":2,"PublishDate":1741881600000,"ResearchArea":[{"ResearchAreaID":85,"ResearchAreaName":" Strongly Correlated Electrons","ResearchAreaNameZh":" Strongly Correlated Electrons"}],"Cover":"","Thumbnail":"","ExternalLinks":[{"ExternalLinkType":1,"Link":"https:\u002F\u002Farxiv.org\u002Fabs\u002F2503.11756"}],"Journal":"arXiv","EditorEmail":"","UpdateTime":1775098256000,"IsPinned":true,"ContentType":0,"PinTab":[1,11],"WorkingTeam":[{"ID":269,"Name":"AI for Science","NameZh":"AI for Science"}],"IsTrending":false,"IsTeamSelect":false,"StatusEn":2,"StatusZh":1},"ArticleSubContentEn":{"Title":"Deep Learning Sheds Light on Integer and Fractional Topological Insulators","Abstract":"Electronic topological phases of matter, characterized by robust boundary states derived from topologically nontrivial bulk states, are pivotal for next-generation electronic devices. However, understanding their complex quantum phases, especially at larger scales and fractional fillings with strong electron correlations, has long posed a formidable computational challenge. Here, we employ a deep learning framework to express the many-body wavefunction of topological states in twisted MoTe2 systems, where diverse topological states are observed. Leveraging neural networks, we demonstrate the ability to identify and characterize topological phases, including the integer and fractional Chern insulators as well as the Z2 topological insulators. Our deep learning approach significantly outperforms traditional methods, not only in computational efficiency but also in accuracy, enabling us to study larger systems and differentiate between competing phases such as fractional Chern insulators and charge density waves. Our predictions align closely with experimental observations, highlighting the potential of deep learning techniques to explore the rich landscape of topological and strongly correlated phenomena.","TitleKey":"deep-learning-sheds-light-on-integer-and-fractional-topological-insulators","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""},"ArticleSubContentZh":{"Title":"","Abstract":"","TitleKey":"","Cover":"","Thumbnail":"","VideoLink":"","BannerImage":"","MobileCover":"","HomeCover":"","HomeMobileCover":"","HomeMiniCover":"","HomeColorMode":0,"ShortTitle":"","ImageTitle":""}}],"blog":[{"ArticleMeta":{"ID":21,"ArticleID":21,"ArticleType":2,"Status":2,"PublishDate":178590208100